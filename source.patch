+//! Sensor UART transport, mirroring `link.rs`'s role for Frozen: every send goes through
+//! [`SensorAudit::check`] first, and the wire framing is entirely
+//! `opensleep::common::codec::PacketCodec` / `opensleep::sensor::{SensorCommand, SensorPacket}` --
+//! nothing here reimplements packet encoding or decoding. Generic over the underlying I/O so the
+//! same code runs against a real serial port, `tokio::io::duplex` mocks in tests, and the mock
+//! Sensor device used for `--dry-run`. Reuses [`LoggingIo`] unmodified, exactly as Frozen's own
+//! equivalent transport (`link.rs`) does, so raw-byte capture and the opt-in `--raw-serial-log`
+//! debug lines work identically.
+
+use std::time::Duration;
+
+use futures_util::{SinkExt, StreamExt};
+use opensleep::common::codec::PacketCodec;
+use opensleep::common::serial::create_port;
+use opensleep::sensor::{SensorCommand, SensorPacket};
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio_serial::SerialStream;
+use tokio_util::codec::Framed;
+
+use crate::io_logging::LoggingIo;
+use crate::sensor_safety::{ProbeMode, SensorAudit, SensorProbeAction, SensorSafetyViolation};
+
+/// Hard ceiling on a single write completing -- see `link.rs::WRITE_TIMEOUT`'s doc comment for why
+/// this exists at all (a stuck/disconnected UART must never hang this binary forever).
+const WRITE_TIMEOUT: Duration = Duration::from_secs(3);
+
+#[derive(Debug)]
+pub enum PacketOutcome {
+    Received(SensorPacket),
+    TimedOut,
+    Closed,
+}
+
+#[derive(Debug)]
+pub enum LinkError {
+    Safety(SensorSafetyViolation),
+    WriteIo(std::io::Error),
+    ReadIo(std::io::Error),
+}
+
+impl std::fmt::Display for LinkError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            LinkError::Safety(v) => write!(f, "{v}"),
+            LinkError::WriteIo(e) => write!(f, "write failed: {e}"),
+            LinkError::ReadIo(e) => write!(f, "read failed: {e}"),
+        }
+    }
+}
+impl std::error::Error for LinkError {}
+
+pub struct SensorLink<T> {
+    framed: Framed<LoggingIo<T>, PacketCodec<SensorPacket>>,
+}
+
+impl SensorLink<SerialStream> {
+    /// Opens the real Sensor UART at `baud` (8N1, no flow control -- matching stock OpenSleep's
+    /// `create_port`), retaining every raw RX/TX byte chunk in `capture` -- used to
+    /// compute candidate-frame-start statistics independent of what `PacketCodec` itself consumed.
+    pub fn open_capturing(
+        port: &str,
+        baud: u32,
+        capture: crate::io_logging::RawIoCapture,
+        raw_log_enabled: bool,
+    ) -> Result<Self, opensleep::common::serial::SerialError> {
+        let raw = create_port(port, baud)?;
+        log::info!("Sensor UART opened: {port} @ {baud} baud, 8N1, no flow control");
+        Ok(Self::wrap_capturing_with_raw_log(raw, "Sensor", capture, raw_log_enabled))
+    }
+}
+
+impl<T: AsyncRead + AsyncWrite + Unpin> SensorLink<T> {
+    pub fn wrap(inner: T, label: &'static str) -> Self {
+        Self { framed: Framed::new(LoggingIo::new(inner, label), PacketCodec::new()) }
+    }
+
+    pub fn wrap_capturing(inner: T, label: &'static str, capture: crate::io_logging::RawIoCapture) -> Self {
+        Self { framed: Framed::new(LoggingIo::with_capture(inner, label, capture), PacketCodec::new()) }
+    }
+
+    pub fn wrap_capturing_with_raw_log(
+        inner: T,
+        label: &'static str,
+        capture: crate::io_logging::RawIoCapture,
+        raw_log_enabled: bool,
+    ) -> Self {
+        Self {
+            framed: Framed::new(
+                LoggingIo::with_capture(inner, label, capture).with_raw_log_enabled(raw_log_enabled),
+                PacketCodec::new(),
+            ),
+        }
+    }
+
+    /// Checks `action` against `mode`'s whitelist, and only if it passes, serializes and transmits
+    /// it (bounded by [`WRITE_TIMEOUT`]), then waits up to `wait` for one decoded response packet.
+    pub async fn send(
+        &mut self,
+        audit: &mut SensorAudit,
+        mode: ProbeMode,
+        action: SensorProbeAction,
+        firmware_mode_confirmed: bool,
+        wait: Duration,
+    ) -> Result<PacketOutcome, LinkError> {
+        audit.check(mode, action, firmware_mode_confirmed).map_err(LinkError::Safety)?;
+        let cmd = action.to_command();
+        log::info!("-> {} ({:?})", action.name(), cmd);
+        Self::write_one(&mut self.framed, cmd).await?;
+        audit.record_sent(action);
+        Self::await_one(&mut self.framed, wait).await
+    }
+
+    /// Waits up to `wait` for the next decoded packet without sending anything -- the only
+    /// operation `--passive` mode (and the post-discovery observe phase) ever performs.
+    pub async fn recv(&mut self, wait: Duration) -> Result<PacketOutcome, LinkError> {
+        Self::await_one(&mut self.framed, wait).await
+    }
+
+    async fn write_one(
+        framed: &mut Framed<LoggingIo<T>, PacketCodec<SensorPacket>>,
+        cmd: SensorCommand,
+    ) -> Result<(), LinkError> {
+        match tokio::time::timeout(WRITE_TIMEOUT, framed.send(cmd)).await {
+            Ok(Ok(())) => Ok(()),
+            Ok(Err(e)) => Err(LinkError::WriteIo(e)),
+            Err(_elapsed) => Err(LinkError::WriteIo(std::io::Error::new(
+                std::io::ErrorKind::TimedOut,
+                format!("write did not complete within {WRITE_TIMEOUT:?}"),
+            ))),
+        }
+    }
+
+    async fn await_one(
+        framed: &mut Framed<LoggingIo<T>, PacketCodec<SensorPacket>>,
+        wait: Duration,
+    ) -> Result<PacketOutcome, LinkError> {
+        match tokio::time::timeout(wait, framed.next()).await {
+            Ok(Some(Ok(pkt))) => {
+                log::info!("<- decoded: {pkt:?}");
+                Ok(PacketOutcome::Received(pkt))
+            }
+            Ok(Some(Err(e))) => {
+                log::warn!("Sensor UART read error: {e}");
+                Err(LinkError::ReadIo(e))
+            }
+            Ok(None) => {
+                log::warn!("Sensor port closed");
+                Ok(PacketOutcome::Closed)
+            }
+            Err(_elapsed) => Ok(PacketOutcome::TimedOut),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bytes::{Buf, BytesMut};
+    use tokio::io::DuplexStream;
+
+    fn pong_frame(in_firmware: bool) -> Vec<u8> {
+        let code: u8 = if in_firmware { 0b0100_0110 } else { 0b0100_0010 };
+        opensleep::common::codec::command(vec![0x81, 0x00, code])
+    }
+
+    fn spawn_fake_sensor(mut device_side: DuplexStream, script: Vec<(u8, Vec<u8>)>) -> tokio::task::JoinHandle<Vec<u8>> {
+        tokio::spawn(async move {
+            use tokio::io::{AsyncReadExt, AsyncWriteExt};
+            let mut seen_opcodes = Vec::new();
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+
+            'script: for (want_opcode, response) in script {
+                loop {
+                    if acc.len() >= 2 {
+                        let len = acc[1] as usize;
+                        let total = 1 + 1 + len + 2;
+                        if acc.len() >= total {
+                            let opcode = acc[2];
+                            seen_opcodes.push(opcode);
+                            acc.advance(total);
+                            if opcode == want_opcode {
+                                let _ = device_side.write_all(&response).await;
+                                continue 'script;
+                            }
+                            continue;
+                        }
+                    }
+                    let n = match device_side.read(&mut read_buf).await {
+                        Ok(0) | Err(_) => break 'script,
+                        Ok(n) => n,
+                    };
+                    acc.extend_from_slice(&read_buf[..n]);
+                }
+            }
+            seen_opcodes
+        })
+    }
+
+    #[tokio::test]
+    async fn ping_round_trips_over_the_real_wire_framing() {
+        let (client, device) = tokio::io::duplex(4096);
+        let device_task = spawn_fake_sensor(device, vec![(0x01, pong_frame(true))]);
+
+        let mut link = SensorLink::wrap(client, "test");
+        let mut audit = SensorAudit::new();
+        let outcome = link
+            .send(&mut audit, ProbeMode::Ping, SensorProbeAction::Ping, false, Duration::from_secs(1))
+            .await
+            .unwrap();
+
+        match outcome {
+            PacketOutcome::Received(SensorPacket::Pong(true)) => {}
+            other => panic!("unexpected outcome: {other:?}"),
+        }
+        assert_eq!(audit.sensor_uart_writes, 1);
+        drop(link);
+        assert_eq!(device_task.await.unwrap(), vec![0x01]);
+    }
+
+    #[tokio::test]
+    async fn safety_violation_is_returned_before_any_bytes_are_written() {
+        let (client, device) = tokio::io::duplex(4096);
+        let device_task = spawn_fake_sensor(device, vec![]);
+
+        let mut link = SensorLink::wrap(client, "test");
+        let mut audit = SensorAudit::new();
+        let err = link
+            .send(&mut audit, ProbeMode::Ping, SensorProbeAction::JumpToFirmware, false, Duration::from_millis(50))
+            .await;
+        assert!(matches!(err, Err(LinkError::Safety(_))));
+        assert_eq!(audit.sensor_uart_writes, 0);
+
+        drop(link);
+        device_task.abort();
+    }
+
+    #[tokio::test]
+    async fn recv_never_writes_anything() {
+        use tokio::io::AsyncReadExt;
+
+        // `device` is kept alive (not spawned into a task) so it never sees EOF from the peer
+        // closing -- otherwise `recv`'s timeout would race a spurious `Closed` outcome instead of
+        // genuinely proving nothing was written.
+        let (client, mut device) = tokio::io::duplex(4096);
+        let mut link = SensorLink::wrap(client, "test");
+        let outcome = link.recv(Duration::from_millis(50)).await.unwrap();
+        assert!(matches!(outcome, PacketOutcome::TimedOut));
+
+        let mut buf = [0u8; 16];
+        let read = tokio::time::timeout(Duration::from_millis(10), device.read(&mut buf)).await;
+        assert!(read.is_err(), "recv() must never write any bytes to the wire");
+    }
+
+    #[tokio::test]
+    async fn no_response_times_out_without_panicking() {
+        let (client, _device) = tokio::io::duplex(4096);
+        let mut link = SensorLink::wrap(client, "test");
+        let mut audit = SensorAudit::new();
+        let outcome = link
+            .send(&mut audit, ProbeMode::Ping, SensorProbeAction::Ping, false, Duration::from_millis(50))
+            .await
+            .unwrap();
+        assert!(matches!(outcome, PacketOutcome::TimedOut));
+    }
+}
