+
+    // ---- 24: machine evidence and operator observations remain separate. ----
+
+    #[tokio::test]
+    async fn operator_observations_field_is_never_used_by_this_mode() {
+        let (report, _code) = run(&args(true)).await;
+        // frozen-prime-test uses its own, distinctly-typed prime_operator_observations field --
+        // the shared operator_observations field (used by frozen-cool-test) always stays None.
+        assert!(report.operator_observations.is_none());
+    }
+
+    // ---- 25: writing Prime alone (plus ack, plus pump voltage, plus "done") cannot produce a
+    // PASS without water-movement/reservoir-level evidence. ----
+
+    #[tokio::test]
+    async fn overall_result_is_inconclusive_not_pass_from_command_and_pumps_alone() {
+        // dry-run against the shared mock: Prime is sent and acked, pump telemetry and "done" are
+        // observed (see mock.rs), but stdin isn't a TTY so no operator observations exist and the
+        // mock never emits a reservoir-transition message -- exactly the "insufficient evidence"
+        // case the spec requires INCONCLUSIVE for for, not PASS.
+        let mut a = args(true);
+        a.duration_seconds = 10;
+        let (report, _code) = run(&a).await;
+        let pr = report.prime_results.expect("prime_results must be set");
+        assert_eq!(pr.prime_command_transmitted, Verdict::Pass);
+        assert_ne!(pr.overall_result, Verdict::Pass, "must never PASS from command/ack/pump/done alone");
+        assert_eq!(pr.overall_result, Verdict::Inconclusive);
+        assert!(!report.overall_pass);
+    }
+
+    /// A fake device identical in spirit to the shared mock's Prime handling, but which also
+    /// emits `"FW: water empty -> full"` shortly after priming starts -- the one kind of firmware
+    /// evidence this binary treats as sufficient, on its own, to prove water circulation.
+    fn spawn_device_with_reservoir_transition_evidence(mut device_side: tokio::io::DuplexStream) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut primed = false;
+            let mut post_prime_ticks = 0u32;
+            let mut count: u8 = 0;
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        let mut frames: Vec<Vec<u8>> = Vec::new();
+                        match opcode {
+                            0x01 => frames.push(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x04 => frames.push(opensleep::common::codec::command(vec![0x84])),
+                            0x10 => frames.push(opensleep::common::codec::command(vec![0x90, 0x00])),
+                            0x40 if payload.len() == 5 => frames.push(opensleep::common::codec::command(vec![
+                                0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                            ])),
+                            0x52 => {
+                                primed = true;
+                                frames.push(opensleep::common::codec::command(vec![0xD2, 0x00]));
+                            }
+                            0x41 => {
+                                count = count.wrapping_add(1);
+                                frames.push(opensleep::common::codec::command(vec![
+                                    0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, count,
+                                ]));
+                                if primed {
+                                    post_prime_ticks += 1;
+                                    if post_prime_ticks == 1 {
+                                        let mut p = vec![0x07u8, 0x00];
+                                        p.extend_from_slice(b"FW: water empty -> full");
+                                        frames.push(opensleep::common::codec::command(p));
+                                    }
+                                }
+                            }
+                            _ => {}
+                        }
+                        for f in frames {
+                            if device_side.write_all(&f).await.is_err() {
+                                return;
+                            }
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
+
+    #[tokio::test]
+    async fn direct_firmware_circulation_evidence_produces_overall_pass() {
+        let (client, device) = tokio::io::duplex(8192);
+        let device_task = spawn_device_with_reservoir_transition_evidence(device);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+        let capture: crate::io_logging::RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+
+        let mut a = args(false);
+        a.duration_seconds = 6;
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, &capture).await;
+
+        assert!(!report.reservoir_transition_messages.is_empty());
+        let pr = report.prime_results.expect("prime_results must be set");
+        assert_eq!(pr.overall_result, Verdict::Pass);
+        assert!(report.overall_pass);
+
+        drop(link);
+        device_task.abort();
+    }
+
+    // ---- 26: dry-run performs no hardware writes. ----
+
+    #[tokio::test]
+    async fn dry_run_never_touches_real_devices() {
+        let (report, _code) = run(&args(true)).await;
+        assert!(report.dry_run);
+        assert_eq!(report.prime_command_count, 1);
+        assert_eq!(report.enabled_target_command_count, 0);
+    }
+
+    // ---- 27-28: Prime-command count exactly one; enabled-target count always zero (see also
+    // dry_run_sends_prime_exactly_once / dry_run_never_enables_a_target above). ----
+
+    #[tokio::test]
+    async fn rejected_command_count_is_zero_on_a_clean_run() {
+        let (report, _code) = run(&args(true)).await;
+        assert_eq!(report.rejected_command_count, 0);
+    }
+
+    // ---- Helper-function unit tests (parsing/classification logic). ----
+
+    #[test]
+    fn pump_telemetry_parses_voltage_and_current() {
+        assert_eq!(
+            parse_pump_telemetry("FW: pump[left] slow @ 6.030475V 0.169202A"),
+            Some(("left", Some(6.030475), Some(0.169202)))
+        );
+        assert_eq!(
+            parse_pump_telemetry("FW: pump[right] slow @ 6.044009V 0.161510A"),
+            Some(("right", Some(6.044009), Some(0.161510)))
+        );
+    }
+
+    #[test]
+    fn pump_telemetry_ignores_unrelated_messages() {
+        assert_eq!(parse_pump_telemetry("FW: [priming] start"), None);
+    }
+
+    #[test]
+    fn pump_fault_message_is_detected_narrowly() {
+        assert!(is_pump_fault_message("FW: pump[left] fault"));
+        assert!(!is_pump_fault_message("FW: pump[left] slow @ 6.03V 0.17A"));
+    }
+
+    #[test]
+    fn solenoid_and_valve_messages_are_detected() {
+        assert!(is_solenoid_or_valve_message("FW: solenoid[left] open"));
+        assert!(is_solenoid_or_valve_message("FW: valve stuck"));
+        assert!(!is_solenoid_or_valve_message("FW: pump[left] slow @ 6.03V 0.17A"));
+    }
+
+    #[test]
+    fn reservoir_transition_messages_are_detected() {
+        assert!(is_reservoir_transition_message("FW: water empty -> full"));
+        assert!(is_reservoir_transition_message("FW: water full -> empty"));
+        assert!(!is_reservoir_transition_message("FW: [capwater] sensor unavailable"));
+    }
+
+    #[test]
+    fn priming_stage_text_strips_the_known_prefix() {
+        assert_eq!(priming_stage_text("FW: [priming] done"), Some("done"));
+        assert_eq!(priming_stage_text("FW: [priming] done because empty"), Some("done because empty"));
+        assert_eq!(priming_stage_text("FW: pump[left] slow @ 6.03V 0.17A"), None);
+    }
+
+    #[test]
+    fn flash_locked_is_excluded_from_the_generic_fault_scan() {
+        assert!(!is_generic_fault_message("FW: flash locked"));
+        assert!(is_generic_fault_message("FW: overcurrent shutdown"));
+    }
+
+    #[test]
+    fn temperature_update_constructor_used_by_this_suite_is_well_formed() {
+        let u = TemperatureUpdate { left_temp: 2450, right_temp: 2460, heatsink_temp: 2600, error: 9, count: 1 };
+        assert!(evaluate_temperatures(u.left_temp, u.right_temp, u.heatsink_temp).is_ok());
+    }
+}
