+    /// A fake device replaying the exact real-hardware timing that caused a live incident: during
+    /// baseline collection it behaves like any other constant-reading device, but once the
+    /// selected side is enabled it stops answering `GetTemperatures` synchronously and instead
+    /// pushes a fixed schedule of unsolicited packets at wall-clock offsets from the moment
+    /// enabling was acknowledged -- t=0.1s pump, t=0.2s a PID-style message, t=1.8s TEC current,
+    /// t=2.0s `"safe, unlocking"` (the exact instant the old, single 2s `STALE_TELEMETRY_LIMIT`
+    /// clock would have fired), t=5.0s more `Message` traffic, t=9.5s a valid `TemperatureUpdate`.
+    fn spawn_device_replaying_the_incident_timing(mut device_side: tokio::io::DuplexStream) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+        fn message_frame(text: &str) -> Vec<u8> {
+            let mut p = vec![0x07u8, 0x00];
+            p.extend_from_slice(text.as_bytes());
+            opensleep::common::codec::command(p)
+        }
+
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut enabled = false;
+            let mut count: u8 = 0;
+            let mut active_start: Option<tokio::time::Instant> = None;
+            let schedule: Vec<(u64, Vec<u8>)> = vec![
+                (100, message_frame("FW: pump[left] slow @ 6.030475V 0.169202A")),
+                (200, message_frame("FW: pid[left] 25.250000 -1.000000")),
+                (1800, message_frame("FW: tec[left] current: 11.364773 A")),
+                (2000, message_frame("FW: tec[left] safe, unlocking")),
+                (5000, message_frame("FW: pump[left] default @ 9.000000V 0.200000A")),
+                (9500, opensleep::common::codec::command(vec![0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, 200])),
+            ];
+            let mut next_idx = 0usize;
+
+            loop {
+                let sleep_deadline = match active_start {
+                    Some(t0) if next_idx < schedule.len() => Some(t0 + Duration::from_millis(schedule[next_idx].0)),
+                    _ => None,
+                };
+                tokio::select! {
+                    _ = async {
+                        match sleep_deadline {
+                            Some(d) => tokio::time::sleep_until(d).await,
+                            None => std::future::pending::<()>().await,
+                        }
+                    } => {
+                        let (_, frame) = &schedule[next_idx];
+                        if device_side.write_all(frame).await.is_err() {
+                            break;
+                        }
+                        next_idx += 1;
+                        continue;
+                    }
+                    res = device_side.read(&mut read_buf) => {
+                        match res {
+                            Ok(0) | Err(_) => break,
+                            Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                        }
+                    }
+                }
+
+                loop {
+                    if acc.len() < 2 {
+                        break;
+                    }
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() < total {
+                        break;
+                    }
+                    let opcode = acc[2];
+                    let payload = acc[2..2 + len].to_vec();
+                    acc.advance(total);
+                    let response = match opcode {
+                        0x01 => Some(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                        0x41 if !enabled => {
+                            count = count.wrapping_add(1);
+                            Some(opensleep::common::codec::command(vec![
+                                0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, count,
+                            ]))
+                        }
+                        0x41 => None, // once enabled, only the scheduled pushes above answer
+                        0x40 if payload.len() == 5 => {
+                            if payload[2] == 1 && !enabled {
+                                enabled = true;
+                                active_start = Some(tokio::time::Instant::now());
+                            }
+                            Some(opensleep::common::codec::command(vec![
+                                0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                            ]))
+                        }
+                        _ => None,
+                    };
+                    if let Some(resp) = response
+                        && device_side.write_all(&resp).await.is_err()
+                    {
+                        return;
+                    }
+                }
+            }
+        })
+    }
