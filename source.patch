+    /// A fake device that reports the baseline-consistent constant reading (matching every other
+    /// baseline-phase device in this file) until the selected side's target is enabled, then
+    /// immediately reports a reading well below any plausible computed target -- used to prove the
+    /// active loop's `TARGET_STABLE_CONFIRM_WINDOW` actually gates the stop (item 3): a single
+    /// tick at/below target must not by itself end the test.
+    fn spawn_device_that_reaches_target_once_enabled(mut device_side: tokio::io::DuplexStream) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut enabled = false;
+            let mut count: u8 = 0;
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        let response = match opcode {
+                            0x01 => Some(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x41 => {
+                                count = count.wrapping_add(1);
+                                let left: u16 = if enabled { 2200 } else { 2450 };
+                                Some(opensleep::common::codec::command(vec![
+                                    0x41,
+                                    (left >> 8) as u8,
+                                    left as u8,
+                                    0x09,
+                                    0xA4,
+                                    0x0A,
+                                    0x28,
+                                    9,
+                                    count,
+                                ]))
+                            }
+                            0x40 if payload.len() == 5 => {
+                                enabled = payload[2] == 1;
+                                Some(opensleep::common::codec::command(vec![
+                                    0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                                ]))
+                            }
+                            _ => None,
+                        };
+                        if let Some(resp) = response
+                            && device_side.write_all(&resp).await.is_err()
+                        {
+                            break;
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
+
