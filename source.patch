+                                                    log::error!("firmware-authoritative (both): Frozen reported the left side's enabled target lost");
+                                                    stop_reason = StopReason::EnabledLeftTargetStateLost;
+                                                }
+                                                BedSide::Right => {
+                                                    log::error!("firmware-authoritative (both): Frozen reported the right side's enabled target lost");
+                                                    stop_reason = StopReason::EnabledRightTargetStateLost;
+                                                }
+                                            }
+                                            telemetry_ok = false;
+                                            break 'fa_active;
+                                        }
+                                    }
+                                    other => {
+                                        stats.record(&other);
+                                    }
+                                }
+                            }
