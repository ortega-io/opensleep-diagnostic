new file mode 100644
index 0000000..a34ef24
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/transport.rs
@@ -0,0 +1,129 @@
+//! Generic send/receive plumbing shared by the Frozen and Sensor phases, built on top of
+//! OpenSleep's existing `PacketCodec` and `CommandTrait` (no protocol framing is reimplemented
+//! here). Generic over the underlying I/O so the exact same code path is exercised against real
+//! serial ports and against `tokio::io::duplex` mock transports in tests.
+
+use std::fmt::Debug;
+use std::time::Duration;
+
+use futures_util::{SinkExt, StreamExt};
+use opensleep::common::codec::{CommandTrait, PacketCodec};
+use opensleep::common::packet::{HardwareInfo, Packet};
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio_util::codec::Framed;
+
+use crate::safety::{SafetyAudit, SafetyViolation};
+
+#[derive(Debug)]
+pub enum ExchangeOutcome<P> {
+    Received(P),
+    TimedOut,
+    Closed,
+}
+
+#[derive(Debug)]
+pub enum ExchangeError {
+    Safety(SafetyViolation),
+    Io(std::io::Error),
+}
+
+impl std::fmt::Display for ExchangeError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            ExchangeError::Safety(v) => write!(f, "{v}"),
+            ExchangeError::Io(e) => write!(f, "{e}"),
+        }
+    }
+}
+
+/// Sends `cmd` (after a mandatory whitelist check against `audit`) and waits up to `wait` for a
+/// decoded response packet.
+pub async fn send_and_await<T, P, C>(
+    framed: &mut Framed<T, PacketCodec<P>>,
+    audit: &mut SafetyAudit,
+    cmd: C,
+    wait: Duration,
+) -> Result<ExchangeOutcome<P>, ExchangeError>
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: Packet + Debug,
+    C: CommandTrait + Debug,
+{
+    let frame = audit.check(&cmd).map_err(ExchangeError::Safety)?;
+    log::info!("-> {cmd:?} ({} bytes: {:02X?})", frame.len(), frame);
+
+    framed.send(cmd).await.map_err(ExchangeError::Io)?;
+
+    match tokio::time::timeout(wait, framed.next()).await {
+        Ok(Some(Ok(pkt))) => {
+            log::info!("<- decoded: {pkt:?}");
+            Ok(ExchangeOutcome::Received(pkt))
+        }
+        Ok(Some(Err(e))) => {
+            log::warn!("packet decode/IO error while waiting for response: {e}");
+            Err(ExchangeError::Io(e))
+        }
+        Ok(None) => {
+            log::warn!("port closed while waiting for response");
+            Ok(ExchangeOutcome::Closed)
+        }
+        Err(_elapsed) => {
+            log::warn!("timed out after {wait:?} waiting for a response");
+            Ok(ExchangeOutcome::TimedOut)
+        }
+    }
+}
+
+/// Implemented locally for the two shared-library packet types so Ping/Pong handling can be
+/// written once and reused by both the Frozen and Sensor phases.
+pub trait PongPacket {
+    /// `Some(in_firmware)` if this packet is a Pong, matching
+    /// `common::serial::DeviceMode::from_pong`'s convention.
+    fn as_pong(&self) -> Option<bool>;
+}
+
+pub trait HasHardwareInfo {
+    fn as_hardware_info(&self) -> Option<&HardwareInfo>;
+}
+
+mod impls {
+    use super::{HasHardwareInfo, PongPacket};
+    use opensleep::frozen::FrozenPacket;
+    use opensleep::sensor::SensorPacket;
+
+    impl PongPacket for FrozenPacket {
+        fn as_pong(&self) -> Option<bool> {
+            match self {
+                FrozenPacket::Pong(in_firmware) => Some(*in_firmware),
+                _ => None,
+            }
+        }
+    }
+
+    impl HasHardwareInfo for FrozenPacket {
+        fn as_hardware_info(&self) -> Option<&opensleep::common::packet::HardwareInfo> {
+            match self {
+                FrozenPacket::HardwareInfo(hw) => Some(hw),
+                _ => None,
+            }
+        }
+    }
+
+    impl PongPacket for SensorPacket {
+        fn as_pong(&self) -> Option<bool> {
+            match self {
+                SensorPacket::Pong(in_firmware) => Some(*in_firmware),
+                _ => None,
+            }
+        }
+    }
+
+    impl HasHardwareInfo for SensorPacket {
+        fn as_hardware_info(&self) -> Option<&opensleep::common::packet::HardwareInfo> {
+            match self {
+                SensorPacket::HardwareInfo(hw) => Some(hw),
+                _ => None,
+            }
+        }
+    }
+}
