new file mode 100644
index 0000000..b1e378b
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/i2c.rs
@@ -0,0 +1,1375 @@
+//! I2C access, generic over an [`I2cPort`] trait so the exact same probe/reset code runs against
+//! the real `/dev/i2c-1` bus, a scripted mock in tests, and the always-succeeding mock used by
+//! `--dry-run`.
+//!
+//! This module never writes to 0x53 (the LED controller) and never performs any I2C write other
+//! than: (a) the four fixed reset-expander register writes mirroring
+//! `opensleep::reset::ResetController::reset_subsystems`, gated behind an explicit reset request;
+//! (b) the single fixed "assert reset" write (`reg 0x02 <- 0xFF`) used by safe-stop and
+//! `emergency-stop`; (c) the narrow, read-modify-write single-bit operations used by
+//! `frozen-prime-opensleep-init --release-frozen-only` ([`pulse_frozen_reset_bit`]/
+//! [`assert_frozen_reset_bit_only`]), which only ever touch bit 1 of registers 0x02 (output) and,
+//! for [`pulse_frozen_reset_bit`] only, 0x06 (direction/config) -- and never write 0x07 at all; and
+//! (d) the narrow, read-modify-write bit-0 operations used by `sensor-probe
+//! --enable-suspected-sensor-line`/`--restore-suspected-sensor-line`
+//! ([`configure_suspected_sensor_enable_high`]/[`restore_suspected_sensor_bit`]), gated behind an
+//! explicit, opt-in experimental flag and never implied by any other `sensor-probe` mode -- these
+//! only ever touch bit 0 of registers 0x02/0x06, are never a pulse, never drive bit 0 low, and
+//! never write 0x07; and (e) the narrow, read-modify-write bits-0-and-1 operations used by
+//! `sensor-probe --combined-narrow-subsystem-init`
+//! ([`configure_combined_narrow_subsystem_init`]), gated behind its own explicit, opt-in flag --
+//! these only ever touch bits 0/1 of registers 0x02/0x06, reproduce bit 1's already-proven
+//! assert/hold/release pulse exactly, never drive bit 0 low, and never write 0x07 or 0x03. No
+//! other register, on `0x20` or any other address, is ever written.
+
+use std::time::Duration;
+use tokio::time::{Instant, sleep};
+
+pub const RESET_EXPANDER_ADDR: u8 = 0x20;
+pub const LED_CONTROLLER_ADDR: u8 = 0x53;
+
+const REG_CONFIG_PORT_0: u8 = 0x06;
+const REG_CONFIG_PORT_1: u8 = 0x07;
+const REG_OUTPUT_PORT_0: u8 = 0x02;
+const PORT_0_CONFIG: u8 = 0b1111_1100;
+const PORT_1_CONFIG: u8 = 0b0011_0001;
+const OUTPUT_RESET: u8 = 0b1111_1111;
+const OUTPUT_ENABLED: u8 = 0b1111_1101;
+/// Bit 1 of register 0x02 -- the Frozen reset bit. Real hardware evidence: this is the one bit
+/// that must change to release Frozen from reset; changing the other output/config registers as
+/// well (as the full reset sequence above does) breaks the filled-reservoir indicator, which lives
+/// on the same expander. See [`pulse_frozen_reset_bit`]'s doc comment.
+pub const FROZEN_RESET_BIT: u8 = 0b0000_0010;
+/// How long to hold bit 1 asserted (high) during [`pulse_frozen_reset_bit`] before releasing it
+/// again. Real hardware evidence: a read that merely clears bit 1 from whatever it already reads as
+/// (e.g. already `0xFD`, already released) produces no edge and Frozen never responds -- the known
+/// working sequence is a low->high->low pulse, not a one-shot clear.
+pub const PULSE_SETTLE: Duration = Duration::from_millis(100);
+
+/// Abstraction over a register-addressed I2C device, so the reset-expander logic can run
+/// unmodified against real hardware, `MockI2c`, or (for `--dry-run`) `MockI2c` configured to
+/// always succeed without ever opening `/dev/i2c-1`.
+pub trait I2cPort {
+    fn read_byte(&mut self, addr: u8) -> Result<u8, I2cIoError>;
+    /// Reads a *specific* register's current value (a combined write-then-read transaction on real
+    /// hardware), unlike [`Self::read_byte`] (a plain read at the device's current internal
+    /// pointer, used only for simple presence-probing where the exact register doesn't matter).
+    /// Needed for read-modify-write operations like [`pulse_frozen_reset_bit`], which must know the
+    /// *current* value of register 0x02 before computing a new one.
+    fn read_reg(&mut self, addr: u8, reg: u8) -> Result<u8, I2cIoError>;
+    fn write_reg(&mut self, addr: u8, reg: u8, value: u8) -> Result<(), I2cIoError>;
+}
+
+#[derive(Debug, Clone)]
+pub struct I2cIoError {
+    pub os_error: Option<i32>,
+    pub message: String,
+}
+
+impl std::fmt::Display for I2cIoError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}", self.message)
+    }
+}
+impl std::error::Error for I2cIoError {}
+
+pub struct RealI2c {
+    dev: linux_embedded_hal::I2cdev,
+}
+
+impl RealI2c {
+    pub fn open(path: &str) -> Result<Self, I2cIoError> {
+        linux_embedded_hal::I2cdev::new(path)
+            .map(|dev| Self { dev })
+            .map_err(|e| I2cIoError {
+                os_error: None,
+                message: e.to_string(),
+            })
+    }
+}
+
+fn map_linux_i2c_err(e: linux_embedded_hal::I2CError) -> I2cIoError {
+    use linux_embedded_hal::i2cdev::linux::LinuxI2CError;
+    let os_error = match e.inner() {
+        LinuxI2CError::Errno(errno) => Some(*errno),
+        LinuxI2CError::Io(io_err) => io_err.raw_os_error(),
+    };
+    I2cIoError {
+        os_error,
+        message: e.to_string(),
+    }
+}
+
+impl I2cPort for RealI2c {
+    fn read_byte(&mut self, addr: u8) -> Result<u8, I2cIoError> {
+        use embedded_hal::i2c::I2c;
+        let mut buf = [0u8; 1];
+        self.dev.read(addr, &mut buf).map(|()| buf[0]).map_err(map_linux_i2c_err)
+    }
+
+    fn read_reg(&mut self, addr: u8, reg: u8) -> Result<u8, I2cIoError> {
+        use embedded_hal::i2c::I2c;
+        let mut buf = [0u8; 1];
+        self.dev.write_read(addr, &[reg], &mut buf).map(|()| buf[0]).map_err(map_linux_i2c_err)
+    }
+
+    fn write_reg(&mut self, addr: u8, reg: u8, value: u8) -> Result<(), I2cIoError> {
+        use embedded_hal::i2c::I2c;
+        self.dev.write(addr, &[reg, value]).map_err(map_linux_i2c_err)
+    }
+}
+
+/// Scriptable mock used both by tests and by `--dry-run` (constructed via
+/// [`MockI2c::always_succeed`], which never fails a read or write, mirroring "no I2C writes are
+/// actually performed, but every one is logged and reported").
+#[derive(Debug, Clone, Default)]
+pub struct MockI2c {
+    pub reads: std::collections::HashMap<u8, Result<u8, i32>>,
+    /// Stateful per-`(address, register)` storage for [`I2cPort::read_reg`], seeded via
+    /// [`MockI2c::always_succeed`] and updated by every [`I2cPort::write_reg`] -- unlike
+    /// [`Self::reads`] (a fixed table used only by [`I2cPort::read_byte`] for simple presence
+    /// probing), this reflects writes, so a read-modify-write caller (like
+    /// `pulse_frozen_reset_bit`) sees its own write reflected in a subsequent read, exactly as real
+    /// hardware would.
+    pub reg_state: std::collections::HashMap<(u8, u8), u8>,
+    pub writes: Vec<(u8, u8, u8)>,
+    pub fail_all_writes: bool,
+    pub fail_reg_reads: bool,
+    pub is_dry_run: bool,
+}
+
+impl MockI2c {
+    pub fn always_succeed() -> Self {
+        let mut reads = std::collections::HashMap::new();
+        reads.insert(RESET_EXPANDER_ADDR, Ok(0x19));
+        // Mirrors confirmed hardware evidence: 0x53 (LED controller) is absent (ENXIO) on this
+        // Hub revision. --dry-run reports this exactly like a real run would.
+        reads.insert(LED_CONTROLLER_ADDR, Err(6) /* ENXIO */);
+        let mut reg_state = std::collections::HashMap::new();
+        // Real hardware evidence: after a normal Hub reboot, Frozen is held in reset -- register
+        // 0x02 reads 0xFF (every output bit, including bit 1, asserted).
+        reg_state.insert((RESET_EXPANDER_ADDR, 0x02), 0xFF);
+        // PCAL6416A power-on-reset default: every pin configured as an input (register 0x06 =
+        // 0xFF) until something explicitly configures it as an output -- real-hardware evidence
+        // this default is why a pulse on the *output* latch alone (register 0x02) produced no
+        // physical edge and no response from Frozen: bit 1 was never actually driven.
+        reg_state.insert((RESET_EXPANDER_ADDR, 0x06), 0xFF);
+        Self {
+            reads,
+            reg_state,
+            writes: Vec::new(),
+            fail_all_writes: false,
+            fail_reg_reads: false,
+            is_dry_run: true,
+        }
+    }
+}
+
+impl I2cPort for MockI2c {
+    fn read_byte(&mut self, addr: u8) -> Result<u8, I2cIoError> {
+        match self.reads.get(&addr) {
+            Some(Ok(v)) => Ok(*v),
+            Some(Err(errno)) => Err(I2cIoError {
+                os_error: Some(*errno),
+                message: std::io::Error::from_raw_os_error(*errno).to_string(),
+            }),
+            None => Err(I2cIoError {
+                os_error: Some(6),
+                message: "mock: no address configured (ENXIO)".to_string(),
+            }),
+        }
+    }
+
+    fn read_reg(&mut self, addr: u8, reg: u8) -> Result<u8, I2cIoError> {
+        if self.fail_reg_reads {
+            return Err(I2cIoError {
+                os_error: Some(5),
+                message: "mock: forced register read failure (EIO)".to_string(),
+            });
+        }
+        self.reg_state.get(&(addr, reg)).copied().ok_or_else(|| I2cIoError {
+            os_error: Some(6),
+            message: "mock: no (address, register) configured (ENXIO)".to_string(),
+        })
+    }
+
+    fn write_reg(&mut self, addr: u8, reg: u8, value: u8) -> Result<(), I2cIoError> {
+        self.writes.push((addr, reg, value));
+        if self.fail_all_writes {
+            return Err(I2cIoError {
+                os_error: Some(5),
+                message: "mock: forced write failure (EIO)".to_string(),
+            });
+        }
+        self.reg_state.insert((addr, reg), value);
+        if self.is_dry_run {
+            log::info!("[DRY-RUN] would write I2C 0x{addr:02X} reg=0x{reg:02X} value=0x{value:02X}");
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone)]
+pub struct ProbeResult {
+    pub address: u8,
+    pub success: bool,
+    pub value: Option<u8>,
+    pub os_error: Option<i32>,
+}
+
+impl ProbeResult {
+    pub fn describe(&self) -> String {
+        if self.success {
+            format!(
+                "0x{:02X} probe: success (byte = 0x{:02X})",
+                self.address,
+                self.value.unwrap_or(0)
+            )
+        } else {
+            let errno_desc = self
+                .os_error
+                .map(|e| std::io::Error::from_raw_os_error(e).to_string())
+                .unwrap_or_else(|| "unknown error".to_string());
+            format!(
+                "0x{:02X} probe: failed (errno {:?}: {errno_desc})",
+                self.address, self.os_error
+            )
+        }
+    }
+}
+
+/// Read-only one-byte probe: never a write.
+pub fn probe_address<P: I2cPort>(dev: &mut P, addr: u8) -> ProbeResult {
+    match dev.read_byte(addr) {
+        Ok(value) => ProbeResult {
+            address: addr,
+            success: true,
+            value: Some(value),
+            os_error: None,
+        },
+        Err(e) => ProbeResult {
+            address: addr,
+            success: false,
+            value: None,
+            os_error: e.os_error,
+        },
+    }
+}
