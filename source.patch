@@ -0,0 +1,135 @@
+//! `emergency-stop`: an independent, fast, best-effort command. Disables both sides and asserts
+//! `0x20` subsystem reset, then exits. Requires no configuration, MQTT, Sensor, or LED access, and
+//! works even if Frozen is unresponsive (the disable sends are best-effort; only the I2C reset
+//! assertion is required for success).
+
+use std::time::Duration;
+
+use opensleep::common::packet::BedSide;
+use tokio::io::{AsyncRead, AsyncWrite};
+
+use crate::cli::EmergencyArgs;
+use crate::i2c::{I2cPort, MockI2c, RealI2c, assert_reset};
+use crate::link::FrozenLink;
+use crate::mock::mock_frozen_link_pair;
+use crate::safety::{AuditedTransport, FrozenAction, Mode};
+
+const DISABLE_WAIT: Duration = Duration::from_millis(500);
+
+pub async fn run(args: &EmergencyArgs) -> u8 {
+    log::warn!("emergency-stop: disabling both sides and asserting subsystem reset");
+
+    if args.dry_run {
+        let mut i2c = MockI2c::always_succeed();
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "dry-run");
+        let code = run_core(Some(&mut link), &mut i2c).await;
+        drop(link);
+        task.abort();
+        return code;
+    }
+
+    let mut link = match FrozenLink::<tokio_serial::SerialStream>::open(&args.frozen_port) {
+        Ok(l) => Some(l),
+        Err(e) => {
+            log::error!("emergency-stop: could not open Frozen UART {}: {e} (continuing to I2C reset)", args.frozen_port);
+            None
+        }
+    };
+
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("emergency-stop: FAILED to open I2C device {}: {e}", args.i2c_device);
+            log::error!("================================================================");
+            log::error!(" COULD NOT CONFIRM SUBSYSTEM RESET. DISCONNECT HUB POWER IMMEDIATELY.");
+            log::error!("================================================================");
+            return 2;
+        }
+    };
+
+    run_core(link.as_mut(), &mut i2c).await
+}
+
+async fn run_core<T, P>(mut link: Option<&mut FrozenLink<T>>, i2c: &mut P) -> u8
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let mut audit = AuditedTransport::new(Mode::EmergencyStop);
+
+    if let Some(link) = link.as_deref_mut() {
+        for side in [BedSide::Left, BedSide::Right] {
+            match link.send(&mut audit, FrozenAction::safety_off(side), DISABLE_WAIT).await {
+                Ok(_) => log::info!("emergency-stop: disable sent for {side:?}"),
+                Err(e) => log::error!("emergency-stop: disable for {side:?} failed: {e}"),
+            }
+        }
+    } else {
+        log::warn!("emergency-stop: no Frozen UART link available; proceeding to I2C reset anyway");
+    }
+
+    let step = assert_reset(i2c).await;
+    if step.success {
+        log::warn!("emergency-stop: subsystem reset asserted (0x20 reg 0x02 <- 0xFF)");
+        0
+    } else {
+        log::error!("emergency-stop: FAILED to assert subsystem reset: errno {:?}", step.os_error);
+        log::error!("================================================================");
+        log::error!(" COULD NOT CONFIRM SUBSYSTEM RESET. DISCONNECT HUB POWER IMMEDIATELY.");
+        log::error!("================================================================");
+        1
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::cli::EmergencyArgs;
+
+    #[tokio::test]
+    async fn emergency_stop_dry_run_succeeds_without_touching_real_devices() {
+        let args = EmergencyArgs {
+            i2c_device: "/dev/i2c-1".into(),
+            frozen_port: "/dev/ttyS1".into(),
+            verbose: false,
+            dry_run: true,
+        };
+        let code = run(&args).await;
+        assert_eq!(code, 0);
+    }
+
+    #[tokio::test]
+    async fn emergency_stop_works_with_no_uart_link_at_all() {
+        let mut i2c = MockI2c::always_succeed();
+        let code = run_core::<tokio::io::DuplexStream, _>(None, &mut i2c).await;
+        assert_eq!(code, 0);
+        assert_eq!(i2c.writes, vec![(0x20, 0x02, 0xFF)]);
+    }
+
+    #[tokio::test]
+    async fn emergency_stop_returns_nonzero_when_reset_cannot_be_confirmed() {
+        let mut i2c = MockI2c {
+            fail_all_writes: true,
+            is_dry_run: false,
+            ..MockI2c::always_succeed()
+        };
+        let code = run_core::<tokio::io::DuplexStream, _>(None, &mut i2c).await;
+        assert_ne!(code, 0);
+    }
+
+    #[tokio::test]
+    async fn emergency_stop_only_ever_sends_the_two_disable_actions() {
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+        run_core(Some(&mut link), &mut i2c).await;
+        drop(link);
+        task.abort();
+        // Whitelist enforcement already covered directly in safety::tests, this just proves the
+        // emergency path never tries anything else via a live AuditedTransport.
+        let mut audit = AuditedTransport::new(Mode::EmergencyStop);
+        assert!(audit.check(&FrozenAction::safety_off(BedSide::Left)).is_ok());
+        assert!(audit.check(&FrozenAction::ping()).is_err());
+    }
+}
