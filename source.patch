+    ct.left_target_c = (side == BedSide::Left).then(|| crate::telemetry::centideg_to_celsius(target_centideg));
+    ct.right_target_c = (side == BedSide::Right).then(|| crate::telemetry::centideg_to_celsius(target_centideg));
+    ct.left_target_confirmed = side == BedSide::Left && we_enabled_side;
+    ct.right_target_confirmed = side == BedSide::Right && we_enabled_side;
+    ct.left_change_c = if side == BedSide::Left { ct.selected_side_temperature_change_c } else { None };
+    ct.right_change_c = if side == BedSide::Right { ct.selected_side_temperature_change_c } else { None };
+    ct.left_pump_command_observed = side == BedSide::Left && pump_command_observed;
+    ct.right_pump_command_observed = side == BedSide::Right && pump_command_observed;
+    ct.left_pump_current_observed = side == BedSide::Left && pump_current_observed;
+    ct.right_pump_current_observed = side == BedSide::Right && pump_current_observed;
+    ct.left_tec_activity_observed = side == BedSide::Left && tec_activity_seen;
+    ct.right_tec_activity_observed = side == BedSide::Right && tec_activity_seen;
+    ct.left_tec_safety_passed = side == BedSide::Left && explicit_firmware_safety_passed;
+    ct.right_tec_safety_passed = side == BedSide::Right && explicit_firmware_safety_passed;
+    ct.left_tec_fault_observed = side == BedSide::Left && explicit_firmware_fault_observed;
+    ct.right_tec_fault_observed = side == BedSide::Right && explicit_firmware_fault_observed;
+    if side == BedSide::Left {
+        ct.left_tec_current_first_a = tec_current_first_a;
+        ct.left_tec_current_min_a = tec_current_min_a;
+        ct.left_tec_current_max_a = tec_current_max_a;
+        ct.left_tec_current_last_a = tec_current_last_a;
+        ct.left_tec_current_sample_count = tec_current_samples;
+    } else {
+        ct.right_tec_current_first_a = tec_current_first_a;
+        ct.right_tec_current_min_a = tec_current_min_a;
+        ct.right_tec_current_max_a = tec_current_max_a;
+        ct.right_tec_current_last_a = tec_current_last_a;
+        ct.right_tec_current_sample_count = tec_current_samples;
+    }
+    ct.temperature_reads_failed = temperature_reads_failed;
+    ct.temperature_reads_total = temperature_reads_total;
+    ct.temperature_read_failure_ratio = match (temperature_reads_failed, temperature_reads_total) {
+        (Some(failed), Some(total)) if total > 0 => Some(failed as f64 / total as f64),
+        _ => None,
+    };
+    ct.top_fan_activity_observed = top_fan_activity_observed;
+    ct.top_fan_latest_duty = top_fan_latest_duty;
+    ct.top_fan_latest_rpm = top_fan_latest_rpm;
+    ct.top_fan_max_rpm = top_fan_max_rpm;
+    ct.bottom_fan_activity_observed = bottom_fan_activity_observed;
+    ct.bottom_fan_latest_duty = bottom_fan_latest_duty;
+    ct.bottom_fan_latest_rpm = bottom_fan_latest_rpm;
+    ct.bottom_fan_max_rpm = bottom_fan_max_rpm;
+    ct.telemetry_warning_count = telemetry_warning_count;
+    // This mode has no watchdog-style stop condition at all -- see FA_COMMUNICATION_SILENCE_LIMIT.
+    ct.telemetry_watchdog_triggered = false;
+    ct.communication_loss_observed = matches!(stop_reason, StopReason::FatalUartError | StopReason::CommunicationSilenceExceeded);
+    ct.operator_abort_observed = stop_reason == StopReason::OperatorAbort;
+    ct.both_targets_shutdown_confirmed = shutdown.both_confirmed_disabled;
+    ct.selected_pump_shutdown_observed = match side {
+        BedSide::Left => shutdown.left_pump_shutdown_observed,
+        BedSide::Right => shutdown.right_pump_shutdown_observed,
+    };
+    ct.selected_tec_shutdown_observed = match side {
+        BedSide::Left => shutdown.left_tec_shutdown_observed,
+        BedSide::Right => shutdown.right_tec_shutdown_observed,
+    };
+    ct.left_pump_shutdown_observed = shutdown.left_pump_shutdown_observed;
+    ct.right_pump_shutdown_observed = shutdown.right_pump_shutdown_observed;
+    ct.left_tec_shutdown_observed = shutdown.left_tec_shutdown_observed;
+    ct.right_tec_shutdown_observed = shutdown.right_tec_shutdown_observed;
+    ct.shutdown_verified = shutdown.verified();
+    ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+    ct.independent_guard_activated = matches!(stop_reason, StopReason::IndependentGuardFired);
+    ct.actual_active_duration_seconds = active_start.elapsed().as_secs_f64();
+    ct.stop_reason = stop_reason.to_string();
+    ct.stop_reason_code = stop_reason_code(stop_reason).to_string();
+    ct.compat_get_temperature_14byte_frames = *compat_get_temperature_14byte_frames;
+    ct.compat_heartbeat_9byte_frames = *compat_heartbeat_9byte_frames;
+    ct.compat_opcode_0x54_frames = *compat_opcode_0x54_frames;
+    ct.compat_opcode_0x55_frames = *compat_opcode_0x55_frames;
+
+    let exit_code = if overall_pass {
+        0
+    } else if !shutdown.verified() {
+        21
+    } else {
+        1
+    };
+    finish(
+        args, dry_run, &*audit, &*stats, std::mem::take(samples), cr, ct, stop_reason, overall_pass, exit_code,
+        expander_value, led, true, true,
+    )
+}
+
+/// Item 4-6: `--side both`'s own preflight and observation phase. Always firmware-authoritative
+/// (see `run()`'s own refusal when `--side both` is requested without `--firmware-authoritative`,
+/// since the legacy loop's per-tick host-side heuristics don't generalize to two independently
+/// progressing sides). Duplicates `run_core`'s preflight/baseline steps rather than deeply
+/// generalizing that already-tested single-side function -- a deliberate scoping decision, not a
+/// missed refactor: the two sequences diverge starting at target calculation (one shared or two
+/// independent targets) and diverge completely at enable (two back-to-back sends and a two-sided
+/// confirmation, item 4 steps 5-10), so a shared implementation would need its own side-count
+/// branching at nearly every step anyway.
+#[allow(clippy::too_many_arguments)]
+async fn run_core_dual_side<T, P>(
+    args: &CoolTestArgs,
+    i2c: &mut P,
+    link: &mut FrozenLink<T>,
+    dry_run: bool,
+    operator_abort_rx_override: Option<mpsc::UnboundedReceiver<String>>,
+    capture: Option<RawIoCapture>,
+    spawn_guard: bool,
+    requested_duration: Duration,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let mut audit = AuditedTransport::new(Mode::cool_test_both());
+    let mut stats = PacketStats::default();
+    let mut samples: Vec<TemperatureSampleJson> = Vec::new();
+    let mut cr = ComponentResults::default();
+    let mut ct = CoolTestResults {
+        selected_side: "both".to_string(),
+        requested_side_mode: "both".to_string(),
+        requested_duration_seconds: requested_duration.as_secs(),
+        startup_mode: STARTUP_MODE_LABEL.to_string(),
+        control_authority: "firmware".to_string(),
+        ..Default::default()
+    };
+
+    let led = probe_address(i2c, crate::i2c::LED_CONTROLLER_ADDR);
+    if !led.success {
+        log::info!("LED controller unavailable; continuing diagnostic ({})", led.describe());
+    }
+
+    let startup = crate::frozen_startup::start_frozen_narrow(i2c, link, &mut audit).await;
+    let expander_value = startup.pulse.assert_output_step.original;
+
+    if !startup.pulse.fully_verified() {
+        log::error!("refusing to run active test: register 0x02/0x06 pulse did not verify");
+        ct.stop_reason = StopReason::PreflightRefused.to_string();
+        ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 20,
+            expander_value, &led, false, false,
+        );
+    }
+    if !startup.ping_ok || !startup.frozen_reached_firmware {
+        log::error!("refusing to run active test: Frozen did not reach application firmware");
+        let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused).await;
+        cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+        ct.shutdown_verified = shutdown.verified();
+        ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+        ct.stop_reason = StopReason::PreflightRefused.to_string();
+        ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 20,
+            expander_value, &led, true, startup.frozen_reached_firmware,
+        );
+    }
+
+    // Item 4 steps 2-3: disable both, confirm both disabled from the acks.
+    let mut left_enabled_after_disable = None;
+    let mut right_enabled_after_disable = None;
+    for s in [BedSide::Left, BedSide::Right] {
+        match link.send(&mut audit, FrozenAction::safety_off(s), COMMAND_TIMEOUT).await {
+            Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((side, t)))) => match side {
+                BedSide::Left => left_enabled_after_disable = Some(t.enabled),
+                BedSide::Right => right_enabled_after_disable = Some(t.enabled),
+            },
+            Ok(_) => {}
+            Err(e) => log::error!("safety-off for {s:?} failed: {e}"),
+        }
+    }
+    if left_enabled_after_disable == Some(true) || right_enabled_after_disable == Some(true) {
+        log::error!("refusing to run active test: an enabled target is still active after safety-off");
+        let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused).await;
+        cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+        ct.shutdown_verified = shutdown.verified();
+        ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+        ct.stop_reason = StopReason::PreflightRefused.to_string();
+        ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+            expander_value, &led, true, true,
+        );
+    }
+
+    // Item 4 step 4: baseline collection -- requires a valid reading for *both* sides in the same
+    // sample (is_valid_baseline_reading checked for both BedSide::Left and BedSide::Right),
+    // stricter than the single-side path's one-side check, since both sides need a trustworthy
+    // baseline before either target can be calculated.
+    let baseline_start = Instant::now();
+    let mut baseline_samples: Vec<TemperatureSample> = Vec::new();
+    let mut baseline_synchronous_decoded: usize = 0;
+    let mut baseline_unsolicited_decoded: usize = 0;
+    let mut baseline_duplicates_discarded: usize = 0;
+    let mut baseline_invalid_discarded: usize = 0;
+    let mut compat_get_temperature_14byte_frames: u64 = 0;
+    let mut compat_heartbeat_9byte_frames: u64 = 0;
+    let mut compat_opcode_0x54_frames: u64 = 0;
+    let mut compat_opcode_0x55_frames: u64 = 0;
+    let mut compat_scanner = CompatFrameScanner::new();
+    let mut raw_scan_checkpoint: usize = capture.as_ref().and_then(|c| c.lock().ok()).map(|c| c.len()).unwrap_or(0);
+
+    let mut baseline_interrupted: Option<StopReason> = None;
+    'baseline: while baseline_should_continue(baseline_samples.len(), baseline_start.elapsed()) {
+        if let Err(e) = link.send_only(&mut audit, FrozenAction::get_temperatures()).await {
+            log::error!("failed to send GetTemperatures during baseline collection: {e}");
+            stats.record_timeout();
+        }
+
+        let tick_start_index = baseline_samples.len();
+        let mut tick_candidates: Vec<TemperatureSample> = Vec::new();
+
+        let drain_deadline = Instant::now() + TICK_DRAIN_WINDOW;
+        loop {
+            let remaining = drain_deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            tokio::select! {
+                biased;
+                reason = wait_for_termination_signal() => {
+                    baseline_interrupted = Some(reason);
+                    break 'baseline;
+                }
+                outcome = link.recv(remaining) => {
+                    match outcome {
+                        Ok(PacketOutcome::Received(pkt)) => {
+                            stats.record(&pkt);
+                            let elapsed_ms = baseline_start.elapsed().as_millis() as u64;
+                            match pkt {
+                                FrozenPacket::TemperatureUpdate(u) => {
+                                    let sample = sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u);
+                                    samples.push((&sample).into());
+                                    tick_candidates.push(sample);
+                                }
+                                FrozenPacket::GetTemperature(g) => {
+                                    let sample = sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g);
+                                    samples.push((&sample).into());
+                                    tick_candidates.push(sample);
+                                }
+                                _ => {}
+                            }
+                        }
+                        Ok(PacketOutcome::TimedOut) => break,
+                        Ok(PacketOutcome::Closed) => break,
+                        Err(e) => {
+                            log::debug!("baseline collection: {e}");
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+
+        if let Some(capture) = &capture {
+            let new_events = crate::io_logging::events_since(capture, &mut raw_scan_checkpoint);
+            for event in new_events.iter().filter(|e| e.direction == "rx") {
+                if let Some(bytes) = crate::io_logging::hex_to_bytes(&event.hex) {
+                    compat_scanner.feed(&bytes);
+                }
+            }
+            for frame in compat_scanner.drain_frames() {
+                match frame.opcode {
+                    crate::frozen_compat::GET_TEMPERATURE_OPCODE => {
+                        if let Some(g) = crate::frozen_compat::decode_get_temperature_14byte(&frame.payload) {
+                            compat_get_temperature_14byte_frames += 1;
+                            let elapsed_ms = baseline_start.elapsed().as_millis() as u64;
+                            let sample =
+                                sample_from_get_temperature_compat14(elapsed_ms, jiff::Timestamp::now().to_string(), &g);
+                            samples.push((&sample).into());
+                            tick_candidates.push(sample);
+                        }
+                    }
+                    crate::frozen_compat::HEARTBEAT_OPCODE
+                        if frame.payload.len() == crate::frozen_compat::HEARTBEAT_OBSERVED_COMPAT_SIZE =>
+                    {
+                        compat_heartbeat_9byte_frames += 1;
+                    }
+                    0x54 => compat_opcode_0x54_frames += 1,
+                    0x55 => compat_opcode_0x55_frames += 1,
+                    _ => {}
+                }
+            }
+        }
+
+        for candidate in tick_candidates {
+            if !(is_valid_baseline_reading(BedSide::Left, &candidate) && is_valid_baseline_reading(BedSide::Right, &candidate)) {
+                baseline_invalid_discarded += 1;
+                continue;
+            }
+            if is_duplicate_within_tick(&baseline_samples[tick_start_index..], &candidate) {
+                baseline_duplicates_discarded += 1;
+                continue;
+            }
+            match candidate.source {
+                SampleSource::Unsolicited => baseline_unsolicited_decoded += 1,
+                SampleSource::Solicited | SampleSource::SolicitedCompat14Byte => baseline_synchronous_decoded += 1,
+            }
+            baseline_samples.push(candidate);
+        }
+    }
+
+    if let Some(reason) = baseline_interrupted {
+        log::error!("baseline collection interrupted: {reason}");
+        let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, reason).await;
+        cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+        ct.shutdown_verified = shutdown.verified();
+        ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+        ct.stop_reason = reason.to_string();
+        ct.stop_reason_code = stop_reason_code(reason).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, reason, false, 30, expander_value, &led, true, true,
+        );
+    }
+
+    let baseline_collection_duration = baseline_start.elapsed();
+    ct.baseline_samples_requested = BASELINE_MIN_SAMPLES;
+    ct.baseline_synchronous_samples_decoded = baseline_synchronous_decoded;
+    ct.baseline_unsolicited_samples_decoded = baseline_unsolicited_decoded;
+    ct.baseline_duplicate_samples_discarded = baseline_duplicates_discarded;
+    ct.baseline_invalid_samples_discarded = baseline_invalid_discarded;
+    ct.baseline_collection_duration_seconds = baseline_collection_duration.as_secs_f64();
+    ct.compat_get_temperature_14byte_frames = compat_get_temperature_14byte_frames;
+    ct.compat_heartbeat_9byte_frames = compat_heartbeat_9byte_frames;
+    ct.compat_opcode_0x54_frames = compat_opcode_0x54_frames;
+    ct.compat_opcode_0x55_frames = compat_opcode_0x55_frames;
+
+    // Item 4 step 5: calculate and validate both targets. FrozenAction::enable_cooling performs
+    // the same protocol-representable-range and target-below-baseline validation used by the
+    // single-side path, run here once per side against that side's own baseline.
+    let left_baseline = match validate_baseline(&baseline_samples, BedSide::Left) {
+        Some(b) => b,
+        None => {
+            log::error!("refusing to run active test: left baseline temperature did not pass validation");
+            let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused).await;
+            cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+            ct.shutdown_verified = shutdown.verified();
+            ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+            ct.stop_reason = StopReason::PreflightRefused.to_string();
+            ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+                expander_value, &led, true, true,
+            );
+        }
+    };
+    let right_baseline = match validate_baseline(&baseline_samples, BedSide::Right) {
+        Some(b) => b,
+        None => {
+            log::error!("refusing to run active test: right baseline temperature did not pass validation");
+            let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused).await;
+            cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+            ct.shutdown_verified = shutdown.verified();
+            ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+            ct.stop_reason = StopReason::PreflightRefused.to_string();
+            ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+                expander_value, &led, true, true,
+            );
+        }
+    };
+    if let Some(last) = baseline_samples.last() {
+        ct.baseline_left_c = last.left_water_c;
+        ct.baseline_right_c = last.right_water_c;
+        ct.baseline_heatsink_c = last.heatsink_c;
+    }
+    ct.baseline_left_range_c = baseline_range_c(&baseline_samples, |s| s.raw_left);
+    ct.baseline_right_range_c = baseline_range_c(&baseline_samples, |s| s.raw_right);
+    ct.baseline_heatsink_range_c = baseline_range_c(&baseline_samples, |s| s.raw_heatsink);
+
+    // Item 3: --target-c sends the exact same absolute target to both sides (validated below
+    // against each side's own baseline independently); --delta-c applies the same delta
+    // independently to each side's own baseline, so the two resulting targets may differ slightly.
+    let (left_delta_centideg, right_delta_centideg) = match args.target_c {
+        Some(target_c) => {
+            let target_centideg = (target_c * 100.0).round() as i32;
+            (i32::from(left_baseline as u16) - target_centideg, i32::from(right_baseline as u16) - target_centideg)
+        }
+        None => {
+            let d = (args.delta_c.unwrap_or(DEFAULT_DELTA_C) * 100.0).round() as i32;
+            (d, d)
+        }
+    };
+    // The backward-compatible single requested_delta_c field has no per-side slot -- populated
+    // from the left side's resulting delta; left_target_c/right_target_c below are the
+    // authoritative per-side numbers for a `--side both` run.
+    ct.requested_delta_c = f64::from(left_delta_centideg) / 100.0;
+
+    for (label, delta_centideg) in [("left", left_delta_centideg), ("right", right_delta_centideg)] {
+        if delta_centideg > LARGE_DELTA_CONFIRMATION_THRESHOLD_CENTIDEG && !args.confirm_large_temperature_delta {
+            log::error!(
+                "refusing to run active test: requested {label} delta {:.2}C exceeds {:.2}C and requires \
+                 --confirm-large-temperature-delta",
+                f64::from(delta_centideg) / 100.0,
+                f64::from(LARGE_DELTA_CONFIRMATION_THRESHOLD_CENTIDEG) / 100.0
+            );
+            let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused).await;
+            cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+            ct.shutdown_verified = shutdown.verified();
+            ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+            ct.stop_reason = StopReason::PreflightRefused.to_string();
+            ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+                expander_value, &led, true, true,
+            );
+        }
+    }
+
+    let left_action = match FrozenAction::enable_cooling(BedSide::Left, left_baseline as u16, left_delta_centideg) {
+        Ok(a) => a,
+        Err(e) => {
+            log::error!("refusing to run active test: left target: {e}");
+            let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused).await;
+            cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+            ct.shutdown_verified = shutdown.verified();
+            ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+            ct.stop_reason = StopReason::PreflightRefused.to_string();
+            ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+                expander_value, &led, true, true,
+            );
+        }
+    };
+    let right_action = match FrozenAction::enable_cooling(BedSide::Right, right_baseline as u16, right_delta_centideg) {
+        Ok(a) => a,
+        Err(e) => {
+            log::error!("refusing to run active test: right target: {e}");
+            let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused).await;
+            cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+            ct.shutdown_verified = shutdown.verified();
+            ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+            ct.stop_reason = StopReason::PreflightRefused.to_string();
+            ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+                expander_value, &led, true, true,
+            );
+        }
+    };
+    let left_target_centideg = left_action.target_centideg().unwrap_or(0);
+    let right_target_centideg = right_action.target_centideg().unwrap_or(0);
+    ct.left_target_c = Some(f64::from(left_target_centideg) / 100.0);
+    ct.right_target_c = Some(f64::from(right_target_centideg) / 100.0);
+
+    // Item 4 step 6.
+    print_proposed_dual_targets(
+        left_baseline, right_baseline, left_target_centideg, right_target_centideg, args.delta_c, args.target_c,
+        requested_duration,
+    );
+
+    let mut operator_abort_rx = match operator_abort_rx_override {
+        Some(rx) => Some(rx),
+        None => spawn_operator_abort_watcher(),
+    };
+
+    // Item 4 step 7: arm the independent guard BEFORE sending the first enable command -- it must
+    // already be watching before either side goes active.
+    let mut guard_handle: Option<crate::guard::GuardHandle> = None;
+    if spawn_guard {
+        let arm_seconds = requested_duration.as_secs_f64() + FA_GUARD_GRACE.as_secs_f64();
+        match crate::guard::spawn(
+            &args.frozen_port, &args.i2c_device, true, true, arm_seconds, FA_GUARD_HEARTBEAT_TIMEOUT.as_secs_f64(),
+        ) {
+            Ok(h) => {
+                log::info!("firmware-authoritative (both): independent shutdown guard armed for {arm_seconds:.0}s");
+                ct.independent_guard_armed = true;
+                ct.independent_guard_deadline_seconds = Some(arm_seconds);
+                guard_handle = Some(h);
+            }
+            Err(e) => log::error!("firmware-authoritative (both): failed to spawn independent shutdown guard: {e}"),
+        }
+    } else {
+        log::info!("firmware-authoritative (both): independent shutdown guard not spawned (--dry-run or disabled)");
+    }
+
+    eprintln!(
+        "--firmware-authoritative --side both: Frozen firmware now owns pump sequencing, TEC ramping, \
+         PID control, solenoid control, fan control, current safety, thermal regulation, and target \
+         maintenance for BOTH sides. This binary observes and enforces only the requested duration and \
+         a small, closed set of explicit safety/communication conditions."
+    );
+    eprintln!(
+        "If you observe a leak, a burning smell, or abnormal noise, type ABORT and press Enter (or \
+         press Ctrl+C) to stop immediately."
+    );
+
+    // Item 4 steps 8-9: send left, then right, back-to-back -- no unrelated polling interleaved
+    // between the two writes.
+    let active_start = Instant::now();
+    let enable_send_start = Instant::now();
+    let left_send_result = link.send(&mut audit, left_action, COMMAND_TIMEOUT).await;
+    let time_between_enable_writes = enable_send_start.elapsed();
+    let right_send_result = link.send(&mut audit, right_action, COMMAND_TIMEOUT).await;
+    log::info!(
+        "firmware-authoritative (both): left enable sent; right enable sent {time_between_enable_writes:?} later"
+    );
+    cr.frozen_command_accepted = match (&left_send_result, &right_send_result) {
+        (Ok(_), Ok(_)) => Verdict::Pass,
+        _ => Verdict::Fail,
+    };
+
+    // Item 4 step 10: require the *exact* enabled TargetUpdate confirmation for both sides, not
+    // merely "some reply arrived" -- same discipline as the single-side FA confirm loop. Each
+    // send's own reply may already be that side's confirming TargetUpdate (the normal case, no
+    // stray pre-enable telemetry queued ahead of it); anything else observed is pre-enable
+    // telemetry, recorded but never actioned as active-phase state.
+    let mut left_enabled_at: Option<Instant> = None;
+    let mut right_enabled_at: Option<Instant> = None;
+    let confirm_start = Instant::now();
+    for send_result in [&left_send_result, &right_send_result] {
+        match send_result {
+            Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((BedSide::Left, t)))) if t.enabled => {
+                left_enabled_at.get_or_insert(Instant::now());
+            }
+            Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((BedSide::Right, t)))) if t.enabled => {
+                right_enabled_at.get_or_insert(Instant::now());
+            }
+            Ok(PacketOutcome::Received(pkt)) => {
+                log::info!("firmware-authoritative (both): pre-enable telemetry (recorded, not actioned): {pkt:?}");
+                stats.record(pkt);
+            }
+            _ => {}
+        }
+    }
+    if (left_enabled_at.is_none() || right_enabled_at.is_none()) && left_send_result.is_ok() && right_send_result.is_ok() {
+        let confirm_deadline = Instant::now() + COMMAND_TIMEOUT;
+        while left_enabled_at.is_none() || right_enabled_at.is_none() {
+            let remaining = confirm_deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            match link.recv(remaining).await {
+                Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((BedSide::Left, t)))) if t.enabled => {
+                    stats.record(&FrozenPacket::TargetUpdate((BedSide::Left, t)));
+                    left_enabled_at.get_or_insert(Instant::now());
+                }
+                Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((BedSide::Right, t)))) if t.enabled => {
+                    stats.record(&FrozenPacket::TargetUpdate((BedSide::Right, t)));
+                    right_enabled_at.get_or_insert(Instant::now());
+                }
+                Ok(PacketOutcome::Received(pkt)) => {
+                    log::info!("firmware-authoritative (both): pre-enable telemetry (recorded, not actioned): {pkt:?}");
+                    stats.record(&pkt);
+                }
+                Ok(PacketOutcome::TimedOut) => break,
+                Ok(PacketOutcome::Closed) => break,
+                Err(_) => break,
+            }
+        }
+    }
+    log::info!(
+        "firmware-authoritative (both): left confirmed={} right confirmed={}; {:?} between confirmation \
+         wait starting and both resolving",
+        left_enabled_at.is_some(), right_enabled_at.is_some(), confirm_start.elapsed()
+    );
+    ct.left_target_confirmed = left_enabled_at.is_some();
+    ct.right_target_confirmed = right_enabled_at.is_some();
+
+    let both_confirmed = left_enabled_at.is_some() && right_enabled_at.is_some();
+    let mut stop_reason = StopReason::Normal;
+    let mut telemetry_ok = true;
+    if !both_confirmed {
+        // Never continue with one side active: a partial enable is itself a shutdown trigger, and
+        // the active-observation block below is skipped entirely (both_confirmed stays false).
+        stop_reason = StopReason::PartialDualSideEnable;
+        telemetry_ok = false;
+        log::error!(
+            "firmware-authoritative (both): only one of the two requested sides confirmed enabled -- \
