+    }
+
+    #[test]
+    fn overall_verdict_is_inconclusive_when_actuators_are_unverified_but_nothing_failed() {
+        let cr = ComponentResults {
+            frozen_command_accepted: Verdict::Pass,
+            pump_operation: Verdict::Unverified,
+            fan_operation: Verdict::Unverified,
+            tec_cooling_operation: Verdict::Unverified,
+            telemetry_remained_valid: Verdict::Pass,
+            emergency_shutdown: Verdict::Pass,
+            overall_selected_side_result: Verdict::Unknown,
+        };
+        assert_eq!(overall_verdict(&cr), Verdict::Inconclusive);
+    }
+
+    #[test]
+    fn overall_verdict_does_not_pass_from_command_acceptance_alone() {
+        // Guards item 7 of the safety spec correction: accepting the enable command must never by
+        // itself be enough to call the TEC/pump PASS.
+        let cr = ComponentResults {
+            frozen_command_accepted: Verdict::Pass,
+            pump_operation: Verdict::Unknown,
+            fan_operation: Verdict::Unknown,
+            tec_cooling_operation: Verdict::Unknown,
+            telemetry_remained_valid: Verdict::Pass,
+            emergency_shutdown: Verdict::Pass,
+            overall_selected_side_result: Verdict::Unknown,
+        };
+        assert_ne!(overall_verdict(&cr), Verdict::Pass);
+    }
+
+    #[tokio::test]
+    async fn termination_signal_future_does_not_resolve_spuriously() {
+        // Real SIGTERM/SIGINT delivery to a shared `cargo test` process is not exercised here
+        // (it would be process-global and could interfere with concurrently running tests); this
+        // proves the future only resolves on an actual signal, not on its own or on a timer.
+        let result = tokio::time::timeout(Duration::from_millis(150), wait_for_termination_signal()).await;
+        assert!(result.is_err(), "must not resolve without a real signal");
+    }
+
+    #[tokio::test]
+    async fn active_phase_stops_at_duration_expired_and_still_runs_safe_stop() {
+        let mut a = args(Side::Left, true);
+        a.duration_seconds = 1;
+        let (report, _) = run(&a).await;
+        assert!(report.stop_reason.contains("duration") || report.stop_reason == StopReason::DurationExpired.to_string());
+        assert!(report.safe_stop.is_some());
+        assert!(report.safe_stop.unwrap().i2c_reset_asserted);
+    }
+
+    /// A fake device that answers Ping/JumpToFirmware/SetTargetTemperature plausibly, and for
+    /// GetTemperatures requests either pushes an unsolicited TemperatureUpdate (0x41) -- while
+    /// `pushes_remaining > 0` -- or goes silent, simulating telemetry loss for the value this
+    /// binary actually relies on for safety monitoring.
+    fn spawn_device_that_goes_silent_during_active_phase(
+        mut device_side: tokio::io::DuplexStream,
+        pushes_remaining: usize,
+    ) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut pushes_remaining = pushes_remaining;
+            let mut count: u8 = 0;
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        let response = match opcode {
+                            0x01 => Some(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x41 => {
+                                if pushes_remaining > 0 {
+                                    pushes_remaining -= 1;
+                                    count = count.wrapping_add(1);
+                                    Some(opensleep::common::codec::command(vec![
+                                        0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, count,
+                                    ]))
+                                } else {
+                                    None // goes silent: simulates telemetry loss
+                                }
+                            }
+                            0x40 if payload.len() == 5 => Some(opensleep::common::codec::command(vec![
+                                0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                            ])),
+                            _ => None,
+                        };
+                        if let Some(resp) = response
+                            && device_side.write_all(&resp).await.is_err()
+                        {
+                            break;
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
+
+    #[tokio::test]
+    async fn stale_telemetry_during_active_phase_triggers_safe_stop() {
+        let (client, device) = tokio::io::duplex(8192);
+        let device_task = spawn_device_that_goes_silent_during_active_phase(device, 6);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+
+        let mut a = args(Side::Left, false);
+        a.duration_seconds = 10; // long enough that only staleness (not duration) ends the run
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, None).await;
+
+        assert_eq!(report.stop_reason, StopReason::TelemetryStale.to_string());
+        assert!(report.safe_stop.unwrap().i2c_reset_asserted);
+
+        drop(link);
+        device_task.abort();
+    }
+
+    /// A fake device that acks Ping/JumpToFirmware, always pushes an unsolicited
+    /// TemperatureUpdate for every GetTemperatures request (so staleness never fires), acks the
+    /// enable command with a TargetUpdate(enabled=true), and then -- once `disable_after` further
+    /// GetTemperatures requests have gone by -- proactively pushes an unsolicited
+    /// TargetUpdate(enabled=false) for the given side, simulating Frozen disabling the channel on
+    /// its own.
+    fn spawn_device_that_disables_target_unexpectedly(
+        mut device_side: tokio::io::DuplexStream,
+        side_byte: u8,
+        disable_after: usize,
+    ) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut temp_requests: usize = 0;
+            let mut count: u8 = 0;
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        let mut frames: Vec<Vec<u8>> = Vec::new();
+                        match opcode {
+                            0x01 => frames.push(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x41 => {
+                                temp_requests += 1;
+                                count = count.wrapping_add(1);
+                                frames.push(opensleep::common::codec::command(vec![
+                                    0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, count,
+                                ]));
+                                if temp_requests >= disable_after {
+                                    frames.push(opensleep::common::codec::command(vec![
+                                        0xC0, 0x00, side_byte, 0x00, 0x00, 0x00,
+                                    ]));
+                                }
+                            }
+                            0x40 if payload.len() == 5 => frames.push(opensleep::common::codec::command(vec![
+                                0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                            ])),
+                            _ => {}
+                        }
+                        for f in frames {
+                            if device_side.write_all(&f).await.is_err() {
+                                return;
+                            }
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
+
+    #[tokio::test]
+    async fn frozen_disabling_the_target_unexpectedly_triggers_safe_stop() {
+        let (client, device) = tokio::io::duplex(8192);
+        let device_task = spawn_device_that_disables_target_unexpectedly(device, 0x00, 3);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+
+        let mut a = args(Side::Left, false);
+        a.duration_seconds = 10;
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, None).await;
+
+        assert_eq!(report.stop_reason, StopReason::TargetDisabledUnexpectedly.to_string());
+        assert!(report.safe_stop.unwrap().i2c_reset_asserted);
+
+        drop(link);
+        device_task.abort();
+    }
+
+    /// A fake device that acks Ping/JumpToFirmware/enable and always pushes an unsolicited
+    /// TemperatureUpdate, and additionally pushes a fixed `Message` on every GetTemperatures
+    /// request after preflight (`messages_after` counts every 0x41 request, so preflight baseline
+    /// requests are included in the count -- tests pick a generous `messages_after` to land the
+    /// message during the active phase).
+    fn spawn_device_with_a_message(
+        mut device_side: tokio::io::DuplexStream,
+        message: &'static str,
+        messages_after: usize,
+    ) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut temp_requests: usize = 0;
+            let mut count: u8 = 0;
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        let mut frames: Vec<Vec<u8>> = Vec::new();
+                        match opcode {
+                            0x01 => frames.push(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x41 => {
+                                temp_requests += 1;
+                                count = count.wrapping_add(1);
+                                frames.push(opensleep::common::codec::command(vec![
+                                    0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, count,
+                                ]));
+                                if temp_requests >= messages_after {
+                                    let mut p = vec![0x07u8, 0x00];
+                                    p.extend_from_slice(message.as_bytes());
+                                    frames.push(opensleep::common::codec::command(p));
+                                }
+                            }
+                            0x40 if payload.len() == 5 => frames.push(opensleep::common::codec::command(vec![
+                                0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                            ])),
+                            _ => {}
+                        }
+                        for f in frames {
+                            if device_side.write_all(&f).await.is_err() {
+                                return;
+                            }
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
+
+    #[tokio::test]
+    async fn tec_locked_message_triggers_safe_stop() {
+        let (client, device) = tokio::io::duplex(8192);
+        let device_task = spawn_device_with_a_message(device, "FW: tec[left] locked", 3);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+
+        let mut a = args(Side::Left, false);
+        a.duration_seconds = 10;
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, None).await;
+
+        assert_eq!(report.stop_reason, StopReason::TecLocked.to_string());
+
+        drop(link);
+        device_task.abort();
+    }
+
+    #[tokio::test]
+    async fn flash_locked_message_does_not_trigger_safe_stop() {
+        let (client, device) = tokio::io::duplex(8192);
+        // Sent on essentially every tick (messages_after=1); if this were mistaken for a fault
+        // the run would abort almost immediately instead of running its full duration.
+        let device_task = spawn_device_with_a_message(device, "FW: flash locked", 1);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+
+        let mut a = args(Side::Left, false);
+        a.duration_seconds = 2;
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, None).await;
+
+        assert_eq!(report.stop_reason, StopReason::DurationExpired.to_string());
+
+        drop(link);
+        device_task.abort();
+    }
+
+    #[tokio::test]
+    async fn generic_fault_message_triggers_safe_stop_after_the_grace_period() {
+        let (client, device) = tokio::io::duplex(8192);
+        // messages_after chosen generously so the message lands well after FAULT_KEYWORD_GRACE
+        // (2s) has elapsed from the start of the active phase.
+        let device_task = spawn_device_with_a_message(device, "FW: pump[left] overcurrent shutdown", 6);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+
+        let mut a = args(Side::Left, false);
+        a.duration_seconds = 15;
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, None).await;
+
+        assert_eq!(report.stop_reason, StopReason::FirmwareFaultMessage.to_string());
+
+        drop(link);
+        device_task.abort();
+    }
+
+    #[tokio::test]
+    async fn operator_reported_leak_aborts_the_active_phase() {
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+        let (tx, rx) = mpsc::unbounded_channel();
+        // Send after a short delay so it lands during the active phase, not before.
+        tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_millis(500)).await;
+            let _ = tx.send("LEAK".to_string());
+        });
+
+        let mut a = args(Side::Left, false);
+        a.duration_seconds = 10;
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, Some(rx)).await;
+
+        assert_eq!(report.stop_reason, StopReason::OperatorAbort.to_string());
+        assert!(report.safe_stop.unwrap().i2c_reset_asserted);
+
+        drop(link);
+        task.abort();
+    }
+
+    #[tokio::test]
+    async fn unrecognized_operator_input_does_not_abort() {
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+        let (tx, rx) = mpsc::unbounded_channel();
+        tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_millis(200)).await;
+            let _ = tx.send("hello".to_string());
+        });
+
+        let mut a = args(Side::Left, false);
+        // Comfortably above STALE_TELEMETRY_LIMIT (2s) so ordinary scheduling jitter around the
+        // per-tick drain window can't race the duration check against a false staleness abort.
+        a.duration_seconds = 6;
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, Some(rx)).await;
+
+        assert_eq!(report.stop_reason, StopReason::DurationExpired.to_string());
+
+        drop(link);
+        task.abort();
+    }
+}
