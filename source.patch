+// ---------------------------------------------------------------------------------------------
+// --dry-run: identical control flow, against a mocked Sensor device instead of real hardware.
+// ---------------------------------------------------------------------------------------------
+
+async fn run_dry(args: &SensorProbeArgs, mode: ProbeMode) -> (SensorProbeReport, u8) {
+    let mut audit = SensorAudit::new();
+    let mut outcome = ModeOutcome::default();
+
+    match mode {
+        ProbeMode::Passive => {
+            let (client, device) = tokio::io::duplex(4096);
+            let _ = spawn_mock_sensor_device_firmware(device);
+            let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+            let mut link = SensorLink::wrap_capturing(client, "dry-run-115200", cap.clone());
+            outcome.firmware_baud_opened = true;
+            let tally = listen_and_tally(&mut link, Duration::from_millis(200)).await;
+            let (bytes, found) = tally_raw_capture(&cap);
+            let mut json = tally.finalize(found);
+            json.bytes_received = bytes;
+            outcome.passive_115200 = Some(json);
+
+            let (client2, device2) = tokio::io::duplex(4096);
+            let _ = spawn_mock_sensor_device_silent(device2);
+            let cap2: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+            let mut link2 = SensorLink::wrap_capturing(client2, "dry-run-38400", cap2.clone());
+            outcome.bootloader_baud_opened = true;
+            let tally2 = listen_and_tally(&mut link2, Duration::from_millis(200)).await;
+            let (bytes2, found2) = tally_raw_capture(&cap2);
+            let mut json2 = tally2.finalize(found2);
+            json2.bytes_received = bytes2;
+            outcome.passive_38400 = Some(json2);
+
+            outcome.overall_result = passive_result(&outcome).to_string();
+        }
+        ProbeMode::Ping => {
+            let (client, device) = tokio::io::duplex(4096);
+            let _ = spawn_mock_sensor_device_firmware(device);
+            let mut link = SensorLink::wrap(client, "dry-run");
+            outcome.firmware_baud_opened = true;
+            let r = try_ping(&mut link, &mut audit, ProbeMode::Ping, false, 3).await;
+            outcome.firmware_ping_response = Some(matches!(r, Some(true)));
+            outcome.firmware_mode_confirmed = outcome.firmware_ping_response == Some(true);
+            outcome.overall_result = if outcome.firmware_mode_confirmed { "communicating_firmware" } else { "uart_silent" }.to_string();
+        }
+        ProbeMode::Discover => {
+            let (client, device) = tokio::io::duplex(4096);
+            let _ = spawn_mock_sensor_device_firmware(device);
+            let mut link = SensorLink::wrap(client, "dry-run");
+            outcome.firmware_baud_opened = true;
+            let r = try_ping(&mut link, &mut audit, ProbeMode::Discover, false, 3).await;
+            outcome.firmware_ping_response = Some(matches!(r, Some(true)));
+            outcome.firmware_mode_confirmed = outcome.firmware_ping_response == Some(true);
+
+            if outcome.firmware_mode_confirmed {
+                if args.query_info {
+                    if let Some(SensorPacket::HardwareInfo(hw)) = send_and_wait_for(
+                        &mut link,
+                        &mut audit,
+                        ProbeMode::Discover,
+                        SensorProbeAction::GetHardwareInfo,
+                        true,
+                        Duration::from_secs(1),
+                        |p| matches!(p, SensorPacket::HardwareInfo(_)),
+                    )
+                    .await
+                    {
+                        outcome.hardware_info = Some(hw.to_string());
+                    }
+                    if let Some(SensorPacket::GetFirmware(v)) = send_and_wait_for(
+                        &mut link,
+                        &mut audit,
+                        ProbeMode::Discover,
+                        SensorProbeAction::GetFirmwareHash,
+                        true,
+                        Duration::from_secs(1),
+                        |p| matches!(p, SensorPacket::GetFirmware(_)),
+                    )
+                    .await
+                    {
+                        outcome.firmware_info = Some(format!("firmware hash response value: {v}"));
+                    }
+                }
+                let observe = listen_and_tally(&mut link, Duration::from_millis(200)).await;
+                outcome.active_probe = Some(observe.finalize(0));
+                outcome.overall_result = "communicating_firmware".to_string();
+            } else {
+                outcome.overall_result = "uart_silent".to_string();
+            }
+        }
+    }
+
+    finish(args, mode, true, outcome, audit)
+}
