+//! Everything that can cut an active phase short. `StopReason` is the vocabulary every abort path
+//! (Ctrl+C, SIGTERM/SIGHUP, timeout, communication/telemetry error, panic, ...) reduces to before
+//! `safe_stop::run_safe_stop` runs and the report is written.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+pub static PANIC_OCCURRED: AtomicBool = AtomicBool::new(false);
+
+/// Installs a panic hook that logs the panic and flips [`PANIC_OCCURRED`]. This does not itself
+/// perform the (async, I2C/UART-touching) safe-stop -- that cannot safely happen inside a
+/// synchronous panic hook. Instead, the risky per-tick polling loop in `cool_test.rs` runs inside
+/// its own `tokio::spawn`ed task; if it panics, `JoinHandle::await` yields `Err` with
+/// `JoinError::is_panic()`, and the *outer*, unpanicked task runs safe-stop -- this is the
+/// practical form of "panic hook where practical" for an async binary.
+pub fn install_panic_hook() {
+    let default_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(move |info| {
+        PANIC_OCCURRED.store(true, Ordering::SeqCst);
+        log::error!("PANIC: {info}");
+        default_hook(info);
+    }));
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[allow(dead_code)] // DecodeFailure/FatalStatus/UnknownNonzeroStatus: see their doc comments below
+pub enum StopReason {
+    Normal,
+    CtrlC,
+    Sigterm,
+    Sighup,
+    DurationExpired,
+    UartWriteFailure,
+    UartReadFailure,
+    TelemetryLost,
+    /// `frozen-cool-test`'s original single-clock staleness check (2s, refreshed only by
+    /// `TemperatureUpdate`) -- no longer produced by that file's own active loop (see
+    /// `cool_test::TemperatureWatchdogExpired`/`TemperatureStartupGraceExpired`, which replace it
+    /// with two clocks and real-hardware-evidenced limits; a live capture showed this firmware
+    /// pushes unsolicited `TemperatureUpdate` only about once every ~10 seconds, so the 2s limit
+    /// fired on every single active-phase run regardless of any actual fault). Kept in the
+    /// vocabulary (still produced by `frozen-prime-test`) rather than removed.
+    TelemetryStale,
+    /// No successfully-decoded packet of *any* kind (`TemperatureUpdate`, `GetTemperature`,
+    /// `Message`, `TargetUpdate`, ...) for longer than `cool_test::ANY_VALID_RX_LIMIT` -- a
+    /// silence *timeout*, distinct from a genuine I/O error (`UartWriteFailure`/`UartReadFailure`)
+    /// or the link closing outright (`TelemetryLost`), which the transport itself reports
+    /// immediately rather than after a grace period.
+    CommunicationWatchdogExpired,
+    /// A valid temperature sample (synchronous `GetTemperature` reply, either byte shape, or
+    /// unsolicited `TemperatureUpdate`) had already been seen at least once during the active
+    /// phase, but none arrived for longer than `cool_test::TEMPERATURE_FRESHNESS_LIMIT`. See that
+    /// constant's doc comment for the real-hardware evidence behind its value.
+    TemperatureWatchdogExpired,
+    /// No valid temperature sample arrived at all within `cool_test::ACTIVE_STARTUP_GRACE` of the
+    /// active phase starting -- distinct from `TemperatureWatchdogExpired`, whose clock only
+    /// starts once a first sample has actually been seen.
+    TemperatureStartupGraceExpired,
+    /// Named in the safety spec but not constructed by this build: `PacketCodec::decode` (reused
+    /// unmodified from `opensleep`) never surfaces a per-frame decode error to callers of
+    /// `Framed::next()` -- it swallows bad-checksum/unparseable frames internally via
+    /// `log::error!`/`continue` (see `telemetry.rs`'s `PacketStats` doc comment). Kept in the
+    /// vocabulary, rather than removed, so a future revision that does expose decode errors has
+    /// a place to report them without inventing new meaning at that point.
+    DecodeFailure,
+    /// Same situation as `DecodeFailure`: no reliably-evidenced fault/status field is exposed by
+    /// the reused packet types (`HardwareInfo`'s CBOR status byte is checked and discarded inside
+    /// `parse_hardware_info`, never returned to callers). See PROTOCOL_AUDIT.md.
+    FatalStatus,
+    UnknownNonzeroStatus,
+    ImplausibleTemperatureChange,
+    HeatsinkLimitExceeded,
+    TemperatureRangeExceeded,
+    Panic,
+    PreflightRefused,
+    /// The selected side's pump was still reported off / at 0.000000V more than
+    /// `cool_test::PUMP_CONFIRM_GRACE` after the enable command was accepted -- evidence-gated:
+    /// only fires when a firmware pump message for our side was actually observed reporting
+    /// zero voltage, never merely from the absence of a message. See `cool_test::parse_pump_report`.
+    PumpNotConfirmedRunning,
+    /// A firmware message reported the selected TEC's safety interlock as exactly `"locked"` --
+    /// word-tokenized classification, not substring matching (see `cool_test::TecSafetyState`,
+    /// whose doc comment covers a real regression where a `contains("lock")` check false-triggered
+    /// on the positive, non-fault state `"safe, unlocking"`).
+    TecLocked,
+    /// Same evidence basis as `TecLocked`, but for the distinct transitional state `"unsafe,
+    /// locking"` -- kept as its own variant (rather than folded into `TecLocked`) so
+    /// `cool_test::stop_reason_code` can report the two as the distinct codes
+    /// `explicit_tec_unsafe_locking`/`explicit_tec_locked` a live-hardware incident asked for.
+    TecUnsafeLocking,
+    /// Frozen sent an unsolicited `TargetUpdate` reporting the selected side disabled after we
+    /// had successfully enabled it -- i.e. the device turned the channel off on its own.
+    TargetDisabledUnexpectedly,
+    /// A firmware `Message` contained one of the generic fault keywords (overtemperature,
+    /// overcurrent, shutdown, fault, failed, locked) after the startup grace period. See
+    /// `cool_test::is_generic_fault_message` for the "flash locked" carve-out.
+    FirmwareFaultMessage,
+    /// The operator typed a report of a leak, burning smell, or abnormal noise (or the literal
+    /// word ABORT) during the active phase. See `cool_test::spawn_operator_abort_watcher`.
+    OperatorAbort,
+    /// `frozen-prime-test` only: a firmware message named the pump as faulted (matched narrowly:
+    /// "pump" plus a fault word). See `prime_test::is_pump_fault_message`.
+    PumpFault,
+    /// `frozen-prime-test` only: an unsolicited `TargetUpdate` reported a side enabled -- this
+    /// mode must never have an enabled target at any point.
+    TargetEnabledUnexpectedly,
+    /// `frozen-prime-test` only: a periodic Ping during the active phase got `Pong(false)`
+    /// (bootloader), meaning Frozen reset itself out of application firmware mid-run.
+    FrozenReturnedToBootloader,
+    /// `frozen-prime-test` only: a periodic re-probe of the 0x20 reset/enable expander failed
+    /// after priming had already started.
+    I2cFailureDuringPriming,
+    /// `frozen-prime-test` only: not an error -- the firmware reported priming complete
+    /// (`"FW: [priming] done"` or `"...done because empty"`) before the configured duration
+    /// elapsed, so the test stopped early and ran safe-stop, per spec.
+    PrimingCompleted,
+    /// `frozen-cool-test` only: not an error -- the selected side's live temperature reached the
+    /// computed target (`baseline - requested delta`) before the configured duration elapsed, so
+    /// the test stopped early rather than continuing to cool further than requested. Never
+    /// produced by `--firmware-authoritative` mode: that mode logs target attainment but lets
+    /// Frozen continue maintaining it for the remaining requested duration instead of stopping.
+    TargetTemperatureReached,
+    /// `frozen-cool-test --firmware-authoritative` only: a firmware `Message` matched
+    /// `cool_test::is_generic_fault_message` (a recognized, word-scoped negative keyword --
+    /// never inferred from missing or delayed telemetry). Kept distinct from the legacy active
+    /// loop's `FirmwareFaultMessage` so `cool_test::stop_reason_code` can report the two under
+    /// the exact, separate codes their respective specs asked for
+    /// (`explicit_firmware_safety_fault` vs. `thermal_safety_limit`).
+    FirmwareSafetyFault,
+    /// `frozen-cool-test --firmware-authoritative` only: Frozen's own `TargetUpdate` reported the
+    /// selected side's enabled target lost (disabled) after this run had confirmed it enabled --
+    /// the firmware-authoritative counterpart of `TargetDisabledUnexpectedly`, reported under its
+    /// own spec code (`enabled_target_state_explicitly_lost`).
+    EnabledTargetStateLost,
+    /// `frozen-cool-test --firmware-authoritative` only: a UART write or read failure, or the
+    /// link closing outright, during firmware-authoritative observation -- deliberately one
+    /// combined reason (unlike the legacy loop's separate `UartWriteFailure`/`UartReadFailure`/
+    /// `TelemetryLost`), matching that mode's own spec vocabulary (`fatal_uart_write_or_read_error`).
+    FatalUartError,
+    /// `frozen-cool-test --firmware-authoritative` only: an internal panic or task failure during
+    /// firmware-authoritative observation -- the firmware-authoritative counterpart of `Panic`,
+    /// reported under that mode's own spec code (`internal_process_error`).
+    InternalProcessError,
+    /// `frozen-cool-test --firmware-authoritative` only: no valid packet of any kind was received
+    /// for longer than a conservative, prominently-warned-about silence window (see
+    /// `cool_test::FA_COMMUNICATION_SILENCE_LIMIT`) -- deliberately a much longer, separate
+    /// threshold from the legacy loop's `CommunicationWatchdogExpired` (5s): firmware-authoritative
+    /// mode's own spec explicitly forbids "the old two-second or five-second heuristic".
+    CommunicationSilenceExceeded,
+    /// Not reported in the main run's own `stop_reason` field -- this is the independent shutdown
+    /// guard's (`guard.rs`) own internal reason for the disable sequence it performs in its own
+    /// separate process, reusing `cool_test::run_cool_test_shutdown` exactly as the main run does.
+    /// Kept in this shared enum (rather than a parallel type local to `guard.rs`) purely so the
+    /// guard can reuse that one function without needing its own reason type.
+    IndependentGuardFired,
+}
+
+impl StopReason {
+    pub fn description(&self) -> &'static str {
+        match self {
+            StopReason::Normal => "completed normally",
+            StopReason::CtrlC => "operator pressed Ctrl+C",
+            StopReason::Sigterm => "received SIGTERM",
+            StopReason::Sighup => "received SIGHUP",
+            StopReason::DurationExpired => "configured duration expired",
+            StopReason::UartWriteFailure => "UART write failure",
+            StopReason::UartReadFailure => "UART read failure",
+            StopReason::TelemetryLost => "lost valid telemetry",
+            StopReason::TelemetryStale => "telemetry stale for more than 2 seconds",
+            StopReason::CommunicationWatchdogExpired => "no valid packet of any kind for longer than the communication watchdog limit",
+            StopReason::TemperatureWatchdogExpired => "no fresh temperature sample for longer than the temperature watchdog limit",
+            StopReason::TemperatureStartupGraceExpired => "no temperature sample arrived within the active-phase startup grace period",
+            StopReason::DecodeFailure => "temperature decode failure during active phase",
+            StopReason::FatalStatus => "documented fatal error/status",
+            StopReason::UnknownNonzeroStatus => "unknown nonzero status that cannot be proven harmless",
+            StopReason::ImplausibleTemperatureChange => "water temperature changed implausibly fast",
+            StopReason::HeatsinkLimitExceeded => "heatsink temperature exceeded the compile-time threshold",
+            StopReason::TemperatureRangeExceeded => "water temperature left the conservative compile-time range",
+            StopReason::Panic => "internal panic or task failure",
+            StopReason::PreflightRefused => "preflight checks refused to start the active test",
+            StopReason::PumpNotConfirmedRunning => "selected-side pump still reported off/0V after the startup grace period",
+            StopReason::TecLocked => "firmware reported the selected TEC locked",
+            StopReason::TecUnsafeLocking => "firmware reported the selected TEC transitioning to unsafe (locking)",
+            StopReason::TargetDisabledUnexpectedly => "Frozen disabled the selected target unexpectedly",
+            StopReason::FirmwareFaultMessage => "firmware reported a fault condition by message",
+            StopReason::OperatorAbort => "operator reported a leak, smell, or abnormal noise",
+            StopReason::PumpFault => "firmware reported a pump fault",
+            StopReason::TargetEnabledUnexpectedly => "an unexpected enabled target appeared",
+            StopReason::FrozenReturnedToBootloader => "Frozen returned to bootloader mode during the active phase",
+            StopReason::I2cFailureDuringPriming => "I2C access failed after priming started",
+            StopReason::PrimingCompleted => "firmware reported priming complete",
+            StopReason::TargetTemperatureReached => "selected side reached the requested target temperature",
+            StopReason::FirmwareSafetyFault => "firmware reported an explicit safety fault message",
+            StopReason::EnabledTargetStateLost => "Frozen reported the selected side's enabled target lost",
+            StopReason::FatalUartError => "fatal UART write or read error",
+            StopReason::InternalProcessError => "internal process error",
+            StopReason::CommunicationSilenceExceeded => "no valid packet of any kind for longer than the communication silence limit",
+            StopReason::IndependentGuardFired => "independent shutdown guard fired",
+        }
+    }
+}
+
+impl std::fmt::Display for StopReason {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}", self.description())
+    }
+}
+
+/// Resolves as soon as Ctrl+C, SIGTERM, or SIGHUP is received. Safe to call from a non-Linux host
+/// too (SIGTERM/SIGHUP registration failures are logged and that branch simply never fires,
+/// rather than panicking) so dry-run/tests keep working on any development machine.
+pub async fn wait_for_termination_signal() -> StopReason {
+    #[cfg(unix)]
+    {
+        use tokio::signal::unix::{SignalKind, signal};
+        let mut sigterm = signal(SignalKind::terminate()).ok();
+        let mut sighup = signal(SignalKind::hangup()).ok();
+        tokio::select! {
+            _ = tokio::signal::ctrl_c() => StopReason::CtrlC,
+            _ = async { match sigterm.as_mut() { Some(s) => s.recv().await, None => std::future::pending().await } } => StopReason::Sigterm,
+            _ = async { match sighup.as_mut() { Some(s) => s.recv().await, None => std::future::pending().await } } => StopReason::Sighup,
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = tokio::signal::ctrl_c().await;
+        StopReason::CtrlC
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn descriptions_are_non_empty_for_every_reason() {
+        for reason in [
+            StopReason::Normal,
+            StopReason::CtrlC,
+            StopReason::Sigterm,
+            StopReason::Sighup,
+            StopReason::DurationExpired,
+            StopReason::UartWriteFailure,
+            StopReason::UartReadFailure,
+            StopReason::TelemetryLost,
+            StopReason::TelemetryStale,
+            StopReason::CommunicationWatchdogExpired,
+            StopReason::TemperatureWatchdogExpired,
+            StopReason::TemperatureStartupGraceExpired,
+            StopReason::DecodeFailure,
+            StopReason::FatalStatus,
+            StopReason::UnknownNonzeroStatus,
+            StopReason::ImplausibleTemperatureChange,
+            StopReason::HeatsinkLimitExceeded,
+            StopReason::TemperatureRangeExceeded,
+            StopReason::Panic,
+            StopReason::PreflightRefused,
+            StopReason::PumpNotConfirmedRunning,
+            StopReason::TecLocked,
+            StopReason::TecUnsafeLocking,
+            StopReason::TargetDisabledUnexpectedly,
+            StopReason::FirmwareFaultMessage,
+            StopReason::OperatorAbort,
+            StopReason::PumpFault,
+            StopReason::TargetEnabledUnexpectedly,
+            StopReason::FrozenReturnedToBootloader,
+            StopReason::I2cFailureDuringPriming,
+            StopReason::PrimingCompleted,
+            StopReason::TargetTemperatureReached,
+            StopReason::FirmwareSafetyFault,
+            StopReason::EnabledTargetStateLost,
+            StopReason::FatalUartError,
+            StopReason::InternalProcessError,
+            StopReason::CommunicationSilenceExceeded,
+            StopReason::IndependentGuardFired,
+        ] {
+            assert!(!reason.description().is_empty());
+        }
+    }
+}
