+#[allow(clippy::too_many_arguments)]
+fn finish(
+    args: &PrimeTestArgs,
+    dry_run: bool,
+    audit: &AuditedTransport,
+    stats: &PacketStats,
+    samples: Vec<TemperatureSampleJson>,
+    pump_samples: Vec<PumpSampleJson>,
+    solenoid_valve_messages: Vec<String>,
+    reservoir_transition_messages: Vec<String>,
+    other_decoded_packets: Vec<String>,
+    pr: PrimeResults,
+    priming_start_observed: bool,
+    priming_done_observed: bool,
+    priming_done_because_empty: bool,
+    observations: Option<PrimeOperatorObservations>,
+    safe_stop: crate::safe_stop::SafeStopResult,
+    stop_reason: StopReason,
+    overall_pass: bool,
+    capture: &crate::io_logging::RawIoCapture,
+    expander: &crate::i2c::ProbeResult,
+    led: &crate::i2c::ProbeResult,
+    subsystem_reset_ok: bool,
+    frozen_uart_opened: bool,
+    reached_firmware: bool,
+    hardware_info_str: Option<String>,
+    firmware_probed: bool,
+    prime_frame_hex: Option<String>,
+) -> (Report, u8) {
+    let raw_io_events = capture
+        .lock()
+        .map(|log| log.iter().map(crate::report::RawIoEventJson::from).collect())
+        .unwrap_or_default();
+
+    let mut report = Report {
+        program_version: DIAGNOSTIC_VERSION.to_string(),
+        opensleep_base_version: opensleep::VERSION.to_string(),
+        opensleep_source_commit: source_commit().to_string(),
+        kernel: kernel_release(),
+        arch: std::env::consts::ARCH.to_string(),
+        mode: audit.mode().label().to_string(),
+        dry_run,
+        confirmations: Confirmations {
+            cover_hydraulics_connected_declared: Some(args.confirm_cover_hydraulics_connected),
+            water_loop_filled_declared: Some(args.confirm_reservoir_filled),
+            no_visible_leaks_declared: Some(args.confirm_no_visible_leaks),
+            active_test_confirmed_flag: Some(args.confirm_active_test),
+            interactive_phrase_confirmed: Some(true),
+            final_start_phrase_confirmed: Some(pr.prime_command_transmitted != Verdict::Unknown),
+        },
+        i2c_device: args.i2c_device.clone(),
+        i2c_bus_open: true,
+        reset_expander_probe_ok: expander.success,
+        reset_expander_value: expander.value,
+        led_controller_probe_ok: led.success,
+        subsystem_reset_performed: true,
+        subsystem_reset_ok,
+        frozen_port: args.frozen_port.clone(),
+        frozen_uart_opened,
+        frozen_bootloader_ping: None,
+        frozen_firmware_ping: Some(reached_firmware),
+        frozen_hardware_info: hardware_info_str,
+        firmware_version_or_hash: None,
+        frozen_firmware_probed: firmware_probed,
+        detected_initial_mode: None,
+        firmware_jump_sent: false,
+        outgoing_commands: audit.entries().iter().map(AuditEntryJson::from).collect(),
+        enabled_target_command_count: audit.enabled_target_count(),
+        prime_command_count: audit.prime_count(),
+        random_command_count: audit.random_count(),
+        safety_off_commands_sent: audit.entries().iter().filter(|e| e.enabled == Some(false)).count() as u32,
+        rejected_command_count: audit.rejected_command_count(),
+        prime_frame_hex,
+        telemetry_samples: samples,
+        raw_packets_decoded: stats.raw_packets_decoded,
+        malformed_windows: stats.malformed_windows,
+        communication_timeouts: stats.timeouts,
+        unsolicited_telemetry_seen: stats.unsolicited_telemetry_seen,
+        firmware_messages: stats.messages.clone(),
+        pump_samples,
+        solenoid_valve_messages,
+        reservoir_transition_messages,
+        other_decoded_packets,
+        raw_io_events,
+        priming_start_observed,
+        priming_done_observed,
+        priming_done_because_empty,
+        operator_observations: None,
+        prime_operator_observations: observations,
+        stop_reason: stop_reason.to_string(),
+        safe_stop: Some((&safe_stop).into()),
+        component_results: None,
+        prime_results: Some(pr),
+        opensleep_init_results: None,
+        release_frozen_only_results: None,
+        cool_test_results: None,
+        overall_pass,
+        exit_code: 0,
+    };
+    report.exit_code = if overall_pass { 0 } else if !safe_stop.fully_succeeded() { 21 } else { 1 };
+
+    if let Some(path) = &args.json_output
+        && let Err(e) = report.write_json(path)
+    {
+        log::error!("failed to write JSON output to {path}: {e}");
+    }
+    report.print_table();
+
+    let code = report.exit_code;
+    (report, code)
+}
