+
+    #[tokio::test]
+    async fn pulse_detects_readback_mismatch_on_the_release_half() {
+        let mock = mock_with_reg02(0xFF);
+        // Simulate a write that silently doesn't stick by overriding reg_state right back after
+        // the write happens: easiest way is a mock whose read_reg always returns a fixed stale
+        // value regardless of writes. We approximate this with a thin wrapper mock below.
+        struct StaleReadback {
+            inner: MockI2c,
+            stale_value: u8,
+        }
+        impl I2cPort for StaleReadback {
+            fn read_byte(&mut self, addr: u8) -> Result<u8, I2cIoError> {
+                self.inner.read_byte(addr)
+            }
+            fn read_reg(&mut self, addr: u8, reg: u8) -> Result<u8, I2cIoError> {
+                if addr == RESET_EXPANDER_ADDR && reg == REG_OUTPUT_PORT_0 && !self.inner.writes.is_empty() {
+                    return Ok(self.stale_value);
+                }
+                self.inner.read_reg(addr, reg)
+            }
+            fn write_reg(&mut self, addr: u8, reg: u8, value: u8) -> Result<(), I2cIoError> {
+                self.inner.write_reg(addr, reg, value)
+            }
+        }
+        // Stale at 0xFF: the assert half's readback (0xFF) matches; the release half's readback
+        // (also stuck at 0xFF) does not match the intended release target (0xFD).
+        let mut stale = StaleReadback { inner: mock, stale_value: 0xFF };
+        let r = pulse_frozen_reset_bit(&mut stale).await.unwrap();
+        assert!(r.assert_output_step.readback_matches);
+        assert!(!r.release_step.readback_matches);
+        assert!(!r.fully_verified());
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/io_logging.rs b/src/bin/opensleep-diagnostic/io_logging.rs
new file mode 100644
index 0000000..ba0a190
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/io_logging.rs
@@ -0,0 +1,192 @@
+//! Transparent `AsyncRead + AsyncWrite` wrapper that logs every raw byte chunk that crosses it,
+//! so raw TX/RX frames can be logged in hex without touching the shared `PacketCodec` (which is
+//! also used, unmodified, by normal OpenSleep).
+//!
+//! Optionally also retains those same chunks in a shared, lock-protected list (`with_capture`),
+//! for callers (`frozen-prime-test`) that want raw I/O evidence in their JSON report, not just the
+//! log stream. This is a raw byte-chunk log, not a per-frame log: `Framed`/`PacketCodec` do not
+//! expose frame boundaries alongside a decoded packet through the `Stream` API this binary uses,
+//! so a captured chunk may contain part of a frame, a whole frame, or several -- documented as
+//! such in PROTOCOL_AUDIT.md and in the JSON field itself.
+//!
+//! Printing the raw `"<label> RX/TX raw (...)"` debug log lines is opt-in (`with_raw_log_enabled`,
+//! off by default on every constructor) and independent of the overall log level `--verbose`
+//! selects: gated by an explicit boolean checked before each `log::debug!` call, not by the log
+//! crate's own level filtering. `--verbose` alone (this struct's default) never prints them --
+//! real-hardware use found the raw hex dumps made normal `--verbose` logs extremely noisy. Capture
+//! via `with_capture`/`wrap_capturing` is unaffected either way: it is a separate mechanism from
+//! the printed log lines.
+
+use std::io;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+use std::task::{Context, Poll};
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+
+#[derive(Debug, Clone)]
+pub struct RawIoEvent {
+    pub direction: &'static str, // "rx" | "tx"
+    pub hex: String,
+    pub timestamp: String,
+}
+
+pub type RawIoCapture = Arc<Mutex<Vec<RawIoEvent>>>;
+
+pub struct LoggingIo<T> {
+    inner: T,
+    label: &'static str,
+    capture: Option<RawIoCapture>,
+    raw_log_enabled: bool,
+}
+
+impl<T> LoggingIo<T> {
+    pub fn new(inner: T, label: &'static str) -> Self {
+        Self { inner, label, capture: None, raw_log_enabled: false }
+    }
+
+    pub fn with_capture(inner: T, label: &'static str, capture: RawIoCapture) -> Self {
+        Self { inner, label, capture: Some(capture), raw_log_enabled: false }
+    }
+
+    /// Opt-in: also print `"<label> RX/TX raw (...)"` debug log lines for every byte chunk. Off by
+    /// default on every constructor, and independent of `--verbose` -- see module docs.
+    pub fn with_raw_log_enabled(mut self, enabled: bool) -> Self {
+        self.raw_log_enabled = enabled;
+        self
+    }
+}
+
+/// Every event appended to `capture` since `*checkpoint`, which is then advanced to the capture's
+/// current length -- same checkpoint/since shape as `log_tap`'s, but scoped to one capture handle
+/// (a `FrozenLink`'s capture is per-instance, not process-global). Used by `cool_test.rs`'s
+/// baseline loop to feed only newly-arrived raw bytes to `frozen_compat::CompatFrameScanner` each
+/// tick, rather than rescanning everything captured since the link was opened.
+pub fn events_since(capture: &RawIoCapture, checkpoint: &mut usize) -> Vec<RawIoEvent> {
+    let Ok(log) = capture.lock() else { return Vec::new() };
+    let start = (*checkpoint).min(log.len());
+    let result = log[start..].to_vec();
+    *checkpoint = log.len();
+    result
+}
+
+/// Parses a space-separated uppercase-hex string (`RawIoEvent::hex`'s own format, produced by
+/// `record` below) back into bytes. `None` only if the text itself is malformed -- should never
+/// happen for a string this same module produced, but this is shared, `Mutex`-guarded state read
+/// from a different call site than the one that wrote it, so it is not simply unwrapped.
+pub fn hex_to_bytes(hex: &str) -> Option<Vec<u8>> {
+    hex.split_whitespace().map(|tok| u8::from_str_radix(tok, 16).ok()).collect()
+}
+
+fn record(capture: &Option<RawIoCapture>, direction: &'static str, data: &[u8]) {
+    let Some(capture) = capture else { return };
+    let hex = data.iter().map(|b| format!("{b:02X}")).collect::<Vec<_>>().join(" ");
+    let event = RawIoEvent { direction, hex, timestamp: jiff::Timestamp::now().to_string() };
+    if let Ok(mut log) = capture.lock() {
+        log.push(event);
+    }
+}
+
+impl<T: AsyncRead + Unpin> AsyncRead for LoggingIo<T> {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        let before = buf.filled().len();
+        let this = self.get_mut();
+        let poll = Pin::new(&mut this.inner).poll_read(cx, buf);
+        if let Poll::Ready(Ok(())) = &poll {
+            let data = &buf.filled()[before..];
+            if !data.is_empty() {
+                if this.raw_log_enabled {
+                    log::debug!("{} RX raw ({} bytes): {:02X?}", this.label, data.len(), data);
+                }
+                record(&this.capture, "rx", data);
+            }
+        }
+        poll
+    }
+}
+
+impl<T: AsyncWrite + Unpin> AsyncWrite for LoggingIo<T> {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        let poll = Pin::new(&mut this.inner).poll_write(cx, buf);
+        if let Poll::Ready(Ok(n)) = &poll {
+            if this.raw_log_enabled {
+                log::debug!("{} TX raw ({} bytes): {:02X?}", this.label, n, &buf[..*n]);
+            }
+            record(&this.capture, "tx", &buf[..*n]);
+        }
+        poll
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_flush(cx)
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_shutdown(cx)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn raw_log_is_disabled_on_every_constructor_by_default() {
+        assert!(!LoggingIo::new((), "test").raw_log_enabled);
+        let capture: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+        assert!(!LoggingIo::with_capture((), "test", capture).raw_log_enabled);
+    }
+
+    #[test]
+    fn with_raw_log_enabled_is_independent_of_capture() {
+        let io = LoggingIo::new((), "test").with_raw_log_enabled(true);
+        assert!(io.raw_log_enabled);
+        assert!(io.capture.is_none(), "enabling raw log printing must not itself start capturing");
+
+        let capture: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+        let io = LoggingIo::with_capture((), "test", capture).with_raw_log_enabled(false);
+        assert!(!io.raw_log_enabled);
+        assert!(io.capture.is_some(), "disabling raw log printing must not itself stop capturing");
+    }
+
+    #[test]
+    fn record_is_unaffected_by_raw_log_enabled() {
+        let capture: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+        record(&Some(capture.clone()), "rx", &[0xAB, 0xCD]);
+        assert_eq!(capture.lock().unwrap().len(), 1);
+        assert_eq!(capture.lock().unwrap()[0].hex, "AB CD");
+    }
+
+    #[test]
+    fn hex_to_bytes_round_trips_records_own_format() {
+        assert_eq!(hex_to_bytes("AB CD 00 FF"), Some(vec![0xAB, 0xCD, 0x00, 0xFF]));
+        assert_eq!(hex_to_bytes(""), Some(vec![]));
+        assert_eq!(hex_to_bytes("ZZ"), None);
+    }
+
+    #[test]
+    fn events_since_only_returns_new_events_and_advances_the_checkpoint() {
+        let capture: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+        record(&Some(capture.clone()), "rx", &[0x01]);
+        let mut checkpoint = 0;
+        let first = events_since(&capture, &mut checkpoint);
+        assert_eq!(first.len(), 1);
+        assert_eq!(checkpoint, 1);
+
+        assert!(events_since(&capture, &mut checkpoint).is_empty());
+
+        record(&Some(capture.clone()), "rx", &[0x02]);
+        record(&Some(capture.clone()), "tx", &[0x03]);
+        let second = events_since(&capture, &mut checkpoint);
+        assert_eq!(second.len(), 2);
+        assert_eq!(checkpoint, 3);
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/link.rs b/src/bin/opensleep-diagnostic/link.rs
new file mode 100644
index 0000000..b78aeba
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/link.rs
@@ -0,0 +1,376 @@
+//! Frozen UART transport: every send goes through [`AuditedTransport::check`] first, and the wire
+//! framing itself is entirely `opensleep::common::codec::PacketCodec` / `FrozenPacket` -- nothing
+//! here reimplements packet encoding or decoding. Generic over the underlying I/O so the exact
+//! same code runs against a real serial port, `tokio::io::duplex` mocks in tests, and the mock
+//! Frozen device used for `--dry-run`.
+
+use std::time::Duration;
+
+use futures_util::{SinkExt, StreamExt};
+use opensleep::common::codec::PacketCodec;
+use opensleep::common::serial::create_port;
+use opensleep::frozen::FrozenPacket;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio_serial::SerialStream;
+use tokio_util::codec::Framed;
+
+use crate::io_logging::LoggingIo;
+use crate::safety::{AuditedTransport, FrozenAction, SafetyViolation};
+
+pub const BAUD: u32 = 38400;
+/// Hard ceiling on a single write (one frame send, or a flush) completing. Every write in this
+/// module goes through this bound -- unlike the read side (whose timeout has always been
+/// caller-supplied via `wait`), writes had no timeout at all until this was added: a write can
+/// block forever if the underlying transport's buffer ever fills and nothing drains it (a real,
+/// reproducible hang found in testing against a non-responsive mock device during a long retry
+/// loop -- `tokio::io::duplex`'s fixed-size buffer fills after enough un-drained writes, and
+/// `Framed::send`'s flush then blocks indefinitely). The same failure mode -- a stuck or
+/// disconnected UART -- is plausible on real hardware too, so this is a genuine safety fix, not
+/// only a test fix: this diagnostic must always terminate and report within a bounded time.
+const WRITE_TIMEOUT: Duration = Duration::from_secs(3);
+
+#[derive(Debug)]
+pub enum PacketOutcome {
+    Received(FrozenPacket),
+    TimedOut,
+    Closed,
+}
+
+#[derive(Debug)]
+pub enum LinkError {
+    Safety(SafetyViolation),
+    /// The write half failed (e.g. the serial port disappeared): maps to `StopReason::UartWriteFailure`.
+    WriteIo(std::io::Error),
+    /// The read half failed while waiting for a response: maps to `StopReason::UartReadFailure`.
+    /// (`PacketCodec::decode` never itself returns an `Err` -- see `telemetry.rs` -- so this can
+    /// only be a genuine I/O read failure, not a decode/parse error.)
+    ReadIo(std::io::Error),
+}
+
+impl std::fmt::Display for LinkError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            LinkError::Safety(v) => write!(f, "{v}"),
+            LinkError::WriteIo(e) => write!(f, "write failed: {e}"),
+            LinkError::ReadIo(e) => write!(f, "read failed: {e}"),
+        }
+    }
+}
+impl std::error::Error for LinkError {}
+
+pub struct FrozenLink<T> {
+    framed: Framed<LoggingIo<T>, PacketCodec<FrozenPacket>>,
+}
+
+impl FrozenLink<SerialStream> {
+    /// Opens the real Frozen UART: 38400 baud, 8N1, no flow control (matching stock OpenSleep).
+    /// Raw RX/TX debug log lines are off (see [`Self::open_with_raw_log`] to enable them).
+    pub fn open(port: &str) -> Result<Self, opensleep::common::serial::SerialError> {
+        Self::open_with_raw_log(port, false)
+    }
+
+    /// Same as [`Self::open`], but lets the caller opt into raw RX/TX debug log lines (see
+    /// `io_logging.rs` module docs -- off by default, independent of `--verbose`).
+    pub fn open_with_raw_log(port: &str, raw_log_enabled: bool) -> Result<Self, opensleep::common::serial::SerialError> {
+        let raw = create_port(port, BAUD)?;
+        log::info!("Frozen UART opened: {port} @ {BAUD} baud, 8N1, no flow control");
+        Ok(Self::wrap_with_raw_log(raw, "Frozen", raw_log_enabled))
+    }
+
+    /// Same as [`Self::open_with_raw_log`], but also retains every raw RX/TX byte chunk in
+    /// `capture` -- see [`Self::wrap_capturing_with_raw_log`].
+    pub fn open_capturing_with_raw_log(
+        port: &str,
+        capture: crate::io_logging::RawIoCapture,
+        raw_log_enabled: bool,
+    ) -> Result<Self, opensleep::common::serial::SerialError> {
+        let raw = create_port(port, BAUD)?;
+        log::info!("Frozen UART opened: {port} @ {BAUD} baud, 8N1, no flow control");
+        Ok(Self::wrap_capturing_with_raw_log(raw, "Frozen", capture, raw_log_enabled))
+    }
+}
+
+impl<T: AsyncRead + AsyncWrite + Unpin> FrozenLink<T> {
+    pub fn wrap(inner: T, label: &'static str) -> Self {
+        Self {
+            framed: Framed::new(LoggingIo::new(inner, label), PacketCodec::new()),
+        }
+    }
+
+    /// Same as [`Self::wrap`], but lets the caller opt into raw RX/TX debug log lines (see
+    /// `io_logging.rs` module docs -- off by default, independent of `--verbose`).
+    pub fn wrap_with_raw_log(inner: T, label: &'static str, raw_log_enabled: bool) -> Self {
+        Self {
+            framed: Framed::new(LoggingIo::new(inner, label).with_raw_log_enabled(raw_log_enabled), PacketCodec::new()),
+        }
+    }
+
+    /// Same as [`Self::wrap`], but also retains every raw RX/TX byte chunk in `capture` -- used
+    /// by `frozen-prime-test` to include raw I/O evidence in its JSON report. See `io_logging.rs`
+    /// module docs for exactly what "raw" means here.
+    pub fn wrap_capturing(inner: T, label: &'static str, capture: crate::io_logging::RawIoCapture) -> Self {
+        Self {
+            framed: Framed::new(LoggingIo::with_capture(inner, label, capture), PacketCodec::new()),
+        }
+    }
+
+    /// Same as [`Self::wrap_capturing`], but also lets the caller opt into raw RX/TX debug log
+    /// lines (see `io_logging.rs` module docs) -- used by `frozen-cool-test`, which needs both:
+    /// capture to feed `frozen_compat::CompatFrameScanner`, and the existing `--raw-serial-log`
+    /// gate for the printed debug lines. The two are independent (`LoggingIo`'s own doc comment),
+    /// so this is just the one constructor that composes both builder calls.
+    pub fn wrap_capturing_with_raw_log(
+        inner: T,
+        label: &'static str,
+        capture: crate::io_logging::RawIoCapture,
+        raw_log_enabled: bool,
+    ) -> Self {
+        Self {
+            framed: Framed::new(
+                LoggingIo::with_capture(inner, label, capture).with_raw_log_enabled(raw_log_enabled),
+                PacketCodec::new(),
+            ),
+        }
+    }
+
+    /// Checks `action` against the audit's whitelist, and only if it passes, serializes and
+    /// transmits it (bounded by [`WRITE_TIMEOUT`]), then waits up to `wait` for one decoded
+    /// response packet.
+    pub async fn send(
+        &mut self,
+        audit: &mut AuditedTransport,
+        action: FrozenAction,
+        wait: Duration,
+    ) -> Result<PacketOutcome, LinkError> {
+        audit.check(&action).map_err(LinkError::Safety)?;
+        let cmd = action.to_command();
+        log::info!("-> {} ({:?})", action.name(), cmd);
+        Self::write_one(&mut self.framed, cmd).await?;
+        Self::await_one(&mut self.framed, wait).await
+    }
+
+    /// Waits up to `wait` for the next decoded packet without sending anything -- used to drain
+    /// unsolicited telemetry/messages that arrive between our own polls.
+    pub async fn recv(&mut self, wait: Duration) -> Result<PacketOutcome, LinkError> {
+        Self::await_one(&mut self.framed, wait).await
+    }
+
+    /// Checks `action` against the audit's whitelist and, only if it passes, serializes and
+    /// transmits it (bounded by [`WRITE_TIMEOUT`]) -- but does not itself wait for a reply. Used
+    /// where the caller wants to nudge the device (and have the send audited/logged) but will
+    /// pick up whatever arrives, solicited or not, via a subsequent [`Self::recv`] drain loop
+    /// instead of pairing this send with exactly one response.
+    pub async fn send_only(&mut self, audit: &mut AuditedTransport, action: FrozenAction) -> Result<(), LinkError> {
+        audit.check(&action).map_err(LinkError::Safety)?;
+        let cmd = action.to_command();
+        log::info!("-> {} ({:?}) [no-wait]", action.name(), cmd);
+        Self::write_one(&mut self.framed, cmd).await
+    }
+
+    pub async fn flush(&mut self) -> Result<(), std::io::Error> {
+        match tokio::time::timeout(WRITE_TIMEOUT, SinkExt::<opensleep::frozen::FrozenCommand>::flush(&mut self.framed)).await {
+            Ok(result) => result,
+            Err(_elapsed) => Err(std::io::Error::new(
+                std::io::ErrorKind::TimedOut,
+                format!("flush did not complete within {WRITE_TIMEOUT:?}"),
+            )),
+        }
+    }
+
+    /// Serializes and transmits `cmd`, bounded by [`WRITE_TIMEOUT`] -- see that constant's doc
+    /// comment for why an unbounded write is a real hang, not a theoretical one.
+    async fn write_one(
+        framed: &mut Framed<LoggingIo<T>, PacketCodec<FrozenPacket>>,
+        cmd: opensleep::frozen::FrozenCommand,
+    ) -> Result<(), LinkError> {
+        match tokio::time::timeout(WRITE_TIMEOUT, framed.send(cmd)).await {
+            Ok(Ok(())) => Ok(()),
+            Ok(Err(e)) => Err(LinkError::WriteIo(e)),
+            Err(_elapsed) => Err(LinkError::WriteIo(std::io::Error::new(
+                std::io::ErrorKind::TimedOut,
+                format!("write did not complete within {WRITE_TIMEOUT:?}"),
+            ))),
+        }
+    }
+
+    async fn await_one(
+        framed: &mut Framed<LoggingIo<T>, PacketCodec<FrozenPacket>>,
+        wait: Duration,
+    ) -> Result<PacketOutcome, LinkError> {
+        match tokio::time::timeout(wait, framed.next()).await {
+            Ok(Some(Ok(pkt))) => {
+                log::info!("<- decoded: {pkt:?}");
+                Ok(PacketOutcome::Received(pkt))
+            }
+            Ok(Some(Err(e))) => {
+                log::warn!("UART read error: {e}");
+                Err(LinkError::ReadIo(e))
+            }
+            Ok(None) => {
+                log::warn!("Frozen port closed");
+                Ok(PacketOutcome::Closed)
+            }
+            Err(_elapsed) => Ok(PacketOutcome::TimedOut),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::safety::Mode;
+    use bytes::{Buf, BytesMut};
+    use opensleep::common::packet::BedSide;
+    use tokio::io::DuplexStream;
+
+    fn pong_frame(in_firmware: bool) -> Vec<u8> {
+        let code: u8 = if in_firmware { 0b0100_0110 } else { 0b0100_0010 };
+        opensleep::common::codec::command(vec![0x81, 0x00, code])
+    }
+
+    /// Same fake-device pattern used elsewhere in this binary's tests: decode each incoming frame
+    /// with the real wire framing and reply per `script`.
+    fn spawn_fake_frozen(
+        mut device_side: DuplexStream,
+        script: Vec<(u8, Vec<u8>)>,
+    ) -> tokio::task::JoinHandle<Vec<u8>> {
+        tokio::spawn(async move {
+            use tokio::io::{AsyncReadExt, AsyncWriteExt};
+            let mut seen_opcodes = Vec::new();
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+
+            'script: for (want_opcode, response) in script {
+                loop {
+                    if acc.len() >= 2 {
+                        let len = acc[1] as usize;
+                        let total = 1 + 1 + len + 2;
+                        if acc.len() >= total {
+                            let opcode = acc[2];
+                            seen_opcodes.push(opcode);
+                            acc.advance(total);
+                            if opcode == want_opcode {
+                                let _ = device_side.write_all(&response).await;
+                                continue 'script;
+                            }
+                            continue;
+                        }
+                    }
+                    let n = match device_side.read(&mut read_buf).await {
+                        Ok(0) | Err(_) => break 'script,
+                        Ok(n) => n,
+                    };
+                    acc.extend_from_slice(&read_buf[..n]);
+                }
+            }
+            seen_opcodes
+        })
+    }
+
+    #[tokio::test]
+    async fn ping_round_trips_over_the_real_wire_framing() {
+        let (client, device) = tokio::io::duplex(4096);
+        let device_task = spawn_fake_frozen(device, vec![(0x01, pong_frame(true))]);
+
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::Passive);
+        let outcome = link
+            .send(&mut audit, FrozenAction::ping(), Duration::from_secs(1))
+            .await
+            .unwrap();
+
+        match outcome {
+            PacketOutcome::Received(FrozenPacket::Pong(true)) => {}
+            other => panic!("unexpected outcome: {other:?}"),
+        }
+        assert_eq!(audit.sent_count(), 1);
+        drop(link);
+        assert_eq!(device_task.await.unwrap(), vec![0x01]);
+    }
+
+    #[tokio::test]
+    async fn safety_violation_is_returned_before_any_bytes_are_written() {
+        let (client, device) = tokio::io::duplex(4096);
+        // Device expects nothing; if the link wrote anything, this task would never see a
+        // matching opcode and the test would hang/timeout.
+        let device_task = spawn_fake_frozen(device, vec![]);
+
+        let mut link = FrozenLink::wrap(client, "test");
+        // Emergency-stop mode does not permit GetHardwareInfo.
+        let mut audit = AuditedTransport::new(Mode::EmergencyStop);
+        let err = link
+            .send(
+                &mut audit,
+                FrozenAction::get_hardware_info(),
+                Duration::from_millis(50),
+            )
+            .await;
+        assert!(matches!(err, Err(LinkError::Safety(_))));
+        assert_eq!(audit.sent_count(), 0);
+
+        drop(link);
+        device_task.abort();
+    }
+
+    #[tokio::test]
+    async fn cool_test_can_enable_exactly_its_selected_side_over_the_wire() {
+        let (client, device) = tokio::io::duplex(4096);
+        let device_task = spawn_fake_frozen(
+            device,
+            vec![(0x40, opensleep::common::codec::command(vec![0xC0, 0x00, 0x00, 0x01, 0x08, 0xFC]))],
+        );
+
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::CoolTest { side: BedSide::Left });
+        let action = FrozenAction::enable_cooling(BedSide::Left, 2400, 100).unwrap();
+        let outcome = link.send(&mut audit, action, Duration::from_secs(1)).await.unwrap();
+        assert!(matches!(outcome, PacketOutcome::Received(_)));
+        assert_eq!(audit.enabled_target_count(), 1);
+
+        drop(link);
+        assert_eq!(device_task.await.unwrap(), vec![0x40]);
+    }
+
+    #[tokio::test]
+    async fn send_only_writes_without_waiting_for_a_reply() {
+        let (client, device) = tokio::io::duplex(4096);
+        let device_task = spawn_fake_frozen(device, vec![(0x41, vec![])]);
+
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::Passive);
+        link.send_only(&mut audit, FrozenAction::get_temperatures())
+            .await
+            .unwrap();
+        assert_eq!(audit.sent_count(), 1);
+
+        drop(link);
+        assert_eq!(device_task.await.unwrap(), vec![0x41]);
+    }
+
+    #[tokio::test]
+    async fn send_only_is_rejected_by_the_whitelist_before_any_bytes_are_written() {
+        let (client, device) = tokio::io::duplex(4096);
+        let device_task = spawn_fake_frozen(device, vec![]);
+
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::EmergencyStop);
+        let err = link.send_only(&mut audit, FrozenAction::get_hardware_info()).await;
+        assert!(matches!(err, Err(LinkError::Safety(_))));
+        assert_eq!(audit.sent_count(), 0);
+
+        drop(link);
+        device_task.abort();
+    }
+
+    #[tokio::test]
+    async fn no_response_times_out_without_panicking() {
+        let (client, _device) = tokio::io::duplex(4096);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::Passive);
+        let outcome = link
+            .send(&mut audit, FrozenAction::ping(), Duration::from_millis(50))
+            .await
+            .unwrap();
+        assert!(matches!(outcome, PacketOutcome::TimedOut));
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/log_tap.rs b/src/bin/opensleep-diagnostic/log_tap.rs
new file mode 100644
index 0000000..216770e
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/log_tap.rs
@@ -0,0 +1,179 @@
+//! Global, opt-in tap on this process's own log output.
+//!
+//! `frozen-prime-opensleep-init` calls into the real, unmodified `reset`/`frozen`/`sensor` modules
+//! of the `opensleep` library (see that module's docs for why), which has no observer hook of its
+//! own -- the only way it ever reports what happened is via `log::`
+//! calls (e.g. `frozen::state::FrozenState::handle_packet` logs `"Message: FW: [capwater] sensor
+//! unavailable"` at debug level, and `"Priming Message: done"` / `"...done because empty"` at info
+//! level). Since this binary is the one process running that code, every one of those calls passes
+//! through the same global logger this module taps -- the only way to detect specific
+//! upstream-emitted messages without modifying that code.
+//!
+//! Installed once, globally, by `buildinfo::init_logging` (a custom `env_logger` format closure),
+//! but inert (a single relaxed atomic-bool load, no allocation) for every subcommand except
+//! `frozen-prime-opensleep-init`, the only caller of [`enable`].
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+#[derive(Debug, Clone)]
+pub struct CapturedLine {
+    pub target: String,
+    pub message: String,
+}
+
+fn buffer() -> &'static Mutex<Vec<CapturedLine>> {
+    static BUFFER: OnceLock<Mutex<Vec<CapturedLine>>> = OnceLock::new();
+    BUFFER.get_or_init(|| Mutex::new(Vec::new()))
+}
+
+/// Turns capture on for the rest of the process's life. Idempotent. Never disabled again: this
+/// binary's one-shot subcommands run once and exit, so there is no "done observing" moment that
+/// isn't also process exit.
+pub fn enable() {
+    ENABLED.store(true, Ordering::SeqCst);
+}
+
+/// Called from the global log formatter for every emitted record. A cheap no-op unless
+/// [`enable`] has been called (only `frozen-prime-opensleep-init` ever does), so every other
+/// subcommand pays only a single relaxed atomic load per log line.
+pub fn observe(target: &str, message: &str) {
+    if !ENABLED.load(Ordering::Relaxed) {
+        return;
+    }
+    if let Ok(mut buf) = buffer().lock() {
+        buf.push(CapturedLine {
+            target: target.to_string(),
+            message: message.to_string(),
+        });
+    }
+}
+
+/// A checkpoint into the capture buffer, so a caller can later ask "what happened since this
+/// point" without needing exclusive ownership of the logger for the whole process lifetime.
+pub fn checkpoint() -> usize {
+    buffer().lock().map(|b| b.len()).unwrap_or(0)
+}
+
+/// Every line captured since `since` (as returned by [`checkpoint`]).
+pub fn since(since: usize) -> Vec<CapturedLine> {
+    buffer()
+        .lock()
+        .map(|b| {
+            let start = since.min(b.len());
+            b[start..].to_vec()
+        })
+        .unwrap_or_default()
+}
+
+/// True if any line captured since `since` has a target starting with `target_prefix` and a
+/// message *exactly* equal to `message` -- never a substring match, so e.g. `"[priming] done"`
+/// can never be confused with `"[priming] done because empty"`.
+pub fn contains_exact(since_checkpoint: usize, target_prefix: &str, message: &str) -> bool {
+    since(since_checkpoint)
+        .iter()
+        .any(|l| l.target.starts_with(target_prefix) && l.message == message)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    /// `enable`/`observe`/`checkpoint` share process-global state, but `cargo test` runs tests in
+    /// parallel within one process by default -- without this, two of these tests running at the
+    /// same time can interleave their `observe` calls into each other's `since(checkpoint)` range,
+    /// making exact-count assertions flaky. This lock keeps this module's own tests (the only ones
+    /// that call `observe` -- `prime_opensleep_init`'s tests never reach `log_tap::enable()`, since
+    /// they all exercise the `--dry-run` path, which returns before that call) strictly
+    /// one-at-a-time relative to each other.
+    static TEST_LOCK: Mutex<()> = Mutex::new(());
+
+    #[test]
+    fn capture_records_lines_and_contains_exact_matches_target_and_message() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        enable();
+        let before = checkpoint();
+        observe(
+            "opensleep::frozen::state",
+            "Message: FW: [capwater] sensor unavailable",
+        );
+        observe("opensleep::frozen::manager", " -> Prime");
+        let lines = since(before);
+        assert_eq!(lines.len(), 2);
+        assert!(contains_exact(
+            before,
+            "opensleep::frozen::state",
+            "Message: FW: [capwater] sensor unavailable"
+        ));
+        assert!(!contains_exact(
+            before,
+            "opensleep::frozen::state",
+            "Message: FW: [flowrate] sensor unavailable"
+        ));
+    }
+
+    #[test]
+    fn exact_match_never_confuses_done_with_done_because_empty() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        enable();
+        let before = checkpoint();
+        observe("opensleep::frozen::state", "Priming Message: done");
+        assert!(contains_exact(
+            before,
+            "opensleep::frozen::state",
+            "Priming Message: done"
+        ));
+        assert!(!contains_exact(
+            before,
+            "opensleep::frozen::state",
+            "Priming Message: done because empty"
+        ));
+
+        let before2 = checkpoint();
+        observe(
+            "opensleep::frozen::state",
+            "Priming Message: done because empty",
+        );
+        assert!(!contains_exact(
+            before2,
+            "opensleep::frozen::state",
+            "Priming Message: done"
+        ));
+        assert!(contains_exact(
+            before2,
+            "opensleep::frozen::state",
+            "Priming Message: done because empty"
+        ));
+    }
+
+    #[test]
+    fn checkpoint_excludes_earlier_lines() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        enable();
+        observe("some::target", "irrelevant line before checkpoint");
+        let cp = checkpoint();
+        observe("some::target", "line after checkpoint");
+        let lines = since(cp);
+        assert_eq!(lines.len(), 1);
+        assert_eq!(lines[0].message, "line after checkpoint");
+    }
+
+    #[test]
+    fn target_prefix_match_does_not_match_an_unrelated_module() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        enable();
+        let before = checkpoint();
+        observe(
+            "opensleep_diagnostic::some_other_module",
+            "Message: FW: [capwater] sensor unavailable",
+        );
+        assert!(!contains_exact(
+            before,
+            "opensleep::frozen::state",
+            "Message: FW: [capwater] sensor unavailable"
+        ));
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/main.rs b/src/bin/opensleep-diagnostic/main.rs
new file mode 100644
index 0000000..9fff56f
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/main.rs
@@ -0,0 +1,312 @@
+//! opensleep-diagnostic: a staged, Frozen-only hardware diagnostic for an Eight Sleep Pod 3 Hub.
+//!
+//! Five subcommands, each with its own fixed command whitelist (see `safety.rs`):
+//!   - `frozen-passive`:    safe with the cover disconnected and no water.
+//!   - `frozen-cool-test`:  intentionally activates one cooling channel; requires a filled,
+//!     connected hydraulic loop and multiple explicit confirmations.
+//!   - `frozen-prime-test`: intentionally sends Prime, exactly once, to fill an empty hydraulic
+//!     loop, via this binary's own reimplemented reset sequence and command transport; requires a
+//!     connected cover and multiple explicit confirmations. `Prime` is permitted only in this mode
+//!     and `frozen-prime-opensleep-init` -- see safety.rs.
+//!   - `frozen-prime-opensleep-init`: the same Prime-once operation, but through the real,
+//!     unmodified upstream OpenSleep initialization and Frozen manager code instead of a
+//!     reimplemented transport -- see `prime_opensleep_init` module docs and SAFETY.md for why
+//!     both exist and how they differ.
+//!   - `emergency-stop`:    independent fast-path disable + reset-assert command.
+//!
+//! Every subcommand except `frozen-prime-opensleep-init` never runs `opensleep::frozen::manager::run`
+//! (which schedules temperature targets and priming on its own), never loads `config.ron`, never
+//! connects to MQTT, and never opens the Sensor subsystem or LED controller beyond the nonfatal
+//! 0x53 probe. `frozen-prime-opensleep-init` is the one deliberate exception to all of that -- see
+//! its module docs. See SAFETY.md for the full safety model, including how that mode's guarantees
+//! differ from every other subcommand's.
+
+mod buildinfo;
+mod cli;
+mod compat_counters;
+mod confirm;
+mod cool_test;
+mod emergency_stop;
+mod frozen_compat;
+mod frozen_ops;
+mod frozen_startup;
+mod guard;
+mod i2c;
+mod io_logging;
+mod link;
+mod log_tap;
+mod mock;
+mod ownership;
+mod passive;
+mod prime_opensleep_init;
+mod prime_test;
+mod report;
+mod safe_stop;
+mod safety;
+mod signals;
+mod telemetry;
+
+use clap::Parser;
+use cli::{Cli, Commands};
+
+fn main() -> std::process::ExitCode {
+    let cli = Cli::parse();
+
+    let verbose = match &cli.command {
+        Commands::FrozenPassive(a) => a.verbose,
+        Commands::FrozenCoolTest(a) => a.verbose,
+        Commands::EmergencyStop(a) => a.verbose,
+        Commands::FrozenPrimeTest(a) => a.verbose,
+        Commands::FrozenPrimeOpenSleepInit(a) => a.verbose,
+        Commands::InternalCoolTestGuard(a) => a.verbose,
+    };
+    buildinfo::init_logging(verbose);
+    signals::install_panic_hook();
+
+    log::info!(
+        "opensleep-diagnostic v{} (opensleep base {}, source commit {})",
+        buildinfo::DIAGNOSTIC_VERSION,
+        opensleep::VERSION,
+        buildinfo::source_commit()
+    );
+    if matches!(cli.command, Commands::FrozenPrimeOpenSleepInit(_)) {
+        log::warn!("================================================================");
+        log::warn!(" This mode runs the real, unmodified upstream OpenSleep subsystem");
+        log::warn!(" initialization and Frozen manager -- unlike every other");
+        log::warn!(" subcommand in this binary. See SAFETY.md and prime_opensleep_init");
+        log::warn!(" module docs for exactly what that means.");
+        log::warn!("================================================================");
+    } else {
+        log::warn!("================================================================");
+        log::warn!(" This binary never runs normal OpenSleep, MQTT, profiles, Sensor");
+        log::warn!(" management, LED management, or scheduled priming. See SAFETY.md.");
+        log::warn!("================================================================");
+    }
+
+    let runtime = tokio::runtime::Runtime::new().expect("failed to start async runtime");
+    let code = runtime.block_on(async move {
+        match cli.command {
+            Commands::FrozenPassive(args) => {
+                let (_, code) = passive::run(&args).await;
+                code
+            }
+            Commands::FrozenCoolTest(args) => {
+                let (_, code) = cool_test::run(&args).await;
+                code
+            }
+            Commands::EmergencyStop(args) => emergency_stop::run(&args).await,
+            Commands::FrozenPrimeTest(args) => {
+                let (_, code) = prime_test::run(&args).await;
+                code
+            }
+            Commands::FrozenPrimeOpenSleepInit(args) => {
+                let (_, code) = prime_opensleep_init::run(&args).await;
+                code
+            }
+            Commands::InternalCoolTestGuard(args) => guard::run(&args).await,
+        }
+    });
+
+    std::process::ExitCode::from(code)
+}
+
+/// Guardrail tests that scan this binary's own sources for forbidden references. These
+/// complement the runtime whitelist tests in `safety.rs`: they prove the *code* never mentions
+/// Sensor/MQTT/config.ron/the normal command loop/the LED write path at all outside the one
+/// deliberate exception (`frozen-prime-opensleep-init` -- see that module's docs), not just that a
+/// particular run didn't happen to use them.
+///
+/// Needles are built with `format!`/`concat!` from split fragments rather than written as
+/// contiguous literals, specifically so this test file's own assertions don't false-positive
+/// against themselves when every `.rs` file in the directory (including this one) is scanned.
+#[cfg(test)]
+mod guardrail_tests {
+    const OPENSLEEP_INIT_FILE: &str = "prime_opensleep_init.rs";
+
+    /// Reads every `.rs` file in this directory except the ones named in `excluded`, concatenated.
+    fn read_all_our_sources_except(excluded: &[&str]) -> String {
+        let dir = concat!(env!("CARGO_MANIFEST_DIR"), "/src/bin/opensleep-diagnostic");
+        let mut combined = String::new();
+        for entry in std::fs::read_dir(dir).expect("diagnostic source dir must exist") {
+            let entry = entry.expect("readable dir entry");
+            let path = entry.path();
+            if path.file_name().and_then(|n| n.to_str()).is_some_and(|n| excluded.contains(&n)) {
+                continue;
+            }
+            if path.extension().is_some_and(|e| e == "rs") {
+                combined.push_str(&std::fs::read_to_string(&path).expect("readable .rs file"));
+                combined.push('\n');
+            }
+        }
+        combined
+    }
+
+    fn read_opensleep_init_source() -> String {
+        let path = concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/src/bin/opensleep-diagnostic/",
+            "prime_opensleep_init.rs"
+        );
+        std::fs::read_to_string(path).expect("readable prime_opensleep_init.rs")
+    }
+
+    #[test]
+    fn sensor_subsystem_is_never_referenced() {
+        // Unlike MQTT/the LED driver/the real Frozen manager, frozen-prime-opensleep-init does not
+        // carve out an exception here: it never starts the Sensor subsystem either (a separate
+        // physical UART with no bearing on Frozen priming) -- see that module's docs for why "must
+        // not prevent priming" is satisfied by never running it, not by running it best-effort.
+        let src = read_all_our_sources_except(&["main.rs"]);
+        let needle_a = format!("{}{}{}", "opensleep", "::", "sensor");
+        let needle_b = format!("{}{}{}", "sensor", "::", "run");
+        assert!(!src.contains(&needle_a), "diagnostic source must never reference opensleep::sensor");
+        assert!(!src.contains(&needle_b), "diagnostic source must never call the Sensor manager's run loop");
+    }
+
+    #[test]
+    fn mqtt_is_referenced_only_by_opensleep_init_and_config_ron_is_never_loaded_anywhere() {
+        let needle_mqtt = format!("{}{}{}", "opensleep", "::", "mqtt");
+        let needle_rumqttc = "rumqttc".to_string();
+        let needle_config_load = format!("{}{}{}", "Config", "::", "load");
+        let needle_config_ron = "config.ron".to_string();
+
+        // opensleep::mqtt: frozen-prime-opensleep-init is the one deliberate exception (it
+        // constructs the real MqttManager but never connects it -- see module docs).
+        let src_excl_init = read_all_our_sources_except(&["main.rs", OPENSLEEP_INIT_FILE]);
+        assert!(
+            !src_excl_init.contains(&needle_mqtt),
+            "diagnostic source must never reference opensleep::mqtt outside frozen-prime-opensleep-init"
+        );
+
+        // rumqttc/Config::load/config.ron: forbidden everywhere, including inside
+        // frozen-prime-opensleep-init itself -- that mode constructs its own in-memory Config and
+        // never reads the real config.ron or imports rumqttc directly (only the real MqttManager
+        // it calls into does).
+        let src_all = read_all_our_sources_except(&["main.rs"]);
+        for needle in [&needle_rumqttc, &needle_config_load, &needle_config_ron] {
+            assert!(
+                !src_all.contains(needle.as_str()),
+                "diagnostic source must never reference {needle}, including inside frozen-prime-opensleep-init"
+            );
+        }
+
+        let opensleep_init_src = read_opensleep_init_source();
+        assert!(
+            opensleep_init_src.contains(&needle_mqtt),
+            "frozen-prime-opensleep-init is expected to reference opensleep::mqtt -- update this test if that changed"
+        );
+    }
+
+    #[test]
+    fn led_controller_write_path_is_referenced_only_by_opensleep_init() {
+        let src = read_all_our_sources_except(&["main.rs", OPENSLEEP_INIT_FILE]);
+        let needle = "IS31FL3194".to_string();
+        assert!(
+            !src.contains(&needle),
+            "diagnostic source must never reference the LED controller driver outside frozen-prime-opensleep-init"
+        );
+
+        let opensleep_init_src = read_opensleep_init_source();
+        assert!(
+            opensleep_init_src.contains(&needle),
+            "frozen-prime-opensleep-init is expected to reference the real LED controller -- update this test if that changed"
+        );
+    }
+
+    #[test]
+    fn normal_frozen_command_loop_is_called_only_by_opensleep_init() {
+        let src = read_all_our_sources_except(&["main.rs", OPENSLEEP_INIT_FILE]);
+        let needle_a = format!("{}{}{}{}", "frozen", "::", "manager", "::run");
+        let needle_b = format!("{}{}{}", "frozen", "::", "run(");
+        assert!(!src.contains(&needle_a));
+        assert!(!src.contains(&needle_b));
+
+        let opensleep_init_src = read_opensleep_init_source();
+        assert!(
+            opensleep_init_src.contains(&needle_b),
+            "frozen-prime-opensleep-init is expected to call frozen::run(...) -- update this test if that changed"
+        );
+    }
+
+    /// Item 5 of the `/dev/ttyS1` fix: the obsolete MT8365-devkit UART paths must never appear as
+    /// a hardcoded literal anywhere in this binary's own source, `frozen-prime-opensleep-init`
+    /// included. The one legitimate reference to the real value is `opensleep::frozen::PORT`,
+    /// used only as the *comparison* side of a logged override message (see that module's docs) --
+    /// a symbolic reference, never a hardcoded copy of the literal path text, and it does not
+    /// appear as those literal strings in our own source at all.
+    #[test]
+    fn obsolete_devkit_uart_paths_are_never_hardcoded_anywhere() {
+        // Excludes `prime_opensleep_init.rs`'s own module docs, which must be free to *discuss*
+        // the obsolete upstream paths in plain English (e.g. explaining the `Serial Io(NotFound)`
+        // evidence behind the override) without that prose being mistaken for a hardcoded literal
+        // by this scan -- the narrower, code-only check for that file specifically is
+        // `prime_opensleep_init::tests::frozen_run_is_never_called_with_the_upstream_port_constant`.
+        let src = read_all_our_sources_except(&["main.rs", OPENSLEEP_INIT_FILE]);
+        for needle in ["/dev/ttymxc0", "/dev/ttymxc2", "/dev/ttymxc"] {
+            assert!(!src.contains(needle), "diagnostic source must never hardcode the obsolete UART path {needle}");
+        }
+    }
+
+    #[test]
+    fn prime_and_random_frozen_command_variants_are_never_referenced_as_constructors() {
+        // `FrozenCommand::Prime`/`FrozenCommand::Random` (the *library's* raw command type, as
+        // opposed to this binary's own `FrozenAction`) only ever appear inside `safety.rs` -- its
+        // `to_command()` mapping (the one place `FrozenAction::Prime` becomes a real
+        // `FrozenCommand::Prime`) and its own negative tests (which construct the library type
+        // directly to prove the audit rejects it). No other file may ever reference the raw
+        // library variant by name, `frozen-prime-test` included: that mode only ever calls
+        // `FrozenAction::prime()`, never `FrozenCommand::Prime` directly -- see
+        // `frozen_action_prime_is_referenced_only_in_safety_and_prime_test` below for the
+        // complementary check on `FrozenAction::Prime`/`FrozenAction::prime()` itself.
+        let dir = concat!(env!("CARGO_MANIFEST_DIR"), "/src/bin/opensleep-diagnostic");
+        let needle_prime = format!("{}{}{}", "FrozenCommand", "::", "Prime");
+        let needle_random = format!("{}{}{}", "FrozenCommand", "::", "Random");
+        for entry in std::fs::read_dir(dir).expect("diagnostic source dir must exist") {
+            let entry = entry.expect("readable dir entry");
+            let path = entry.path();
+            let name = path.file_name().and_then(|n| n.to_str());
+            if name == Some("safety.rs") || name == Some("main.rs") {
+                continue; // safety.rs's own rejection tests, and this file's own explanatory prose
+            }
+            if path.extension().is_some_and(|e| e == "rs") {
+                let src = std::fs::read_to_string(&path).expect("readable .rs file");
+                assert!(!src.contains(&needle_prime), "{path:?} must not construct FrozenCommand::Prime");
+                assert!(!src.contains(&needle_random), "{path:?} must not construct FrozenCommand::Random");
+            }
+        }
+    }
+
+    #[test]
+    fn frozen_action_prime_is_referenced_only_in_safety_and_prime_test() {
+        // `FrozenAction::Prime`/`FrozenAction::prime()` -- this binary's own, closed command type
+        // -- must never appear in `passive.rs`, `cool_test.rs`, or `emergency_stop.rs` (or any
+        // other file besides `safety.rs`, where the variant and its constructor are defined,
+        // `prime_test.rs`, and `prime_opensleep_init.rs`'s `--release-frozen-only` mode -- the
+        // only two modes permitted to call `FrozenAction::prime()`, both under `Mode::PrimeTest`).
+        // This is the source-level complement to the runtime whitelist tests in `safety.rs`
+        // (`prime_is_refused_outside_prime_test_mode` etc.) and to
+        // `prime_and_random_frozen_command_variants_are_never_referenced_as_constructors` above.
+        let dir = concat!(env!("CARGO_MANIFEST_DIR"), "/src/bin/opensleep-diagnostic");
+        let needle_variant = format!("{}{}{}", "FrozenAction", "::", "Prime");
+        let needle_ctor = format!("{}{}{}", "FrozenAction", "::", "prime()");
+        for entry in std::fs::read_dir(dir).expect("diagnostic source dir must exist") {
+            let entry = entry.expect("readable dir entry");
+            let path = entry.path();
+            let name = path.file_name().and_then(|n| n.to_str());
+            if name == Some("safety.rs")
+                || name == Some("main.rs")
+                || name == Some("prime_test.rs")
+                || name == Some("prime_opensleep_init.rs")
+            {
+                continue; // safety.rs defines it, prime_test.rs and prime_opensleep_init.rs are the
+                          // two modes allowed to use it, main.rs's own explanatory prose (this
+                          // comment) would self-match
+            }
+            if path.extension().is_some_and(|e| e == "rs") {
+                let src = std::fs::read_to_string(&path).expect("readable .rs file");
+                assert!(!src.contains(&needle_variant), "{path:?} must not reference FrozenAction::Prime");
+                assert!(!src.contains(&needle_ctor), "{path:?} must not call FrozenAction::prime()");
+            }
+        }
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/mock.rs b/src/bin/opensleep-diagnostic/mock.rs
new file mode 100644
index 0000000..263fd77
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/mock.rs
@@ -0,0 +1,403 @@
+//! Mock Frozen device used by `--dry-run` (so dry-run is testable on a normal development
+//! computer with no real hardware attached) and reused directly by integration tests. Speaks the
+//! exact real wire framing (`opensleep::common::codec::command`) on one end of a
+//! `tokio::io::duplex` pair; the diagnostic's own code talks to the other end exactly as it would
+//! a real serial port.
+
+use std::time::Duration;
+
+use bytes::{Buf, BytesMut};
+use hex_literal::hex;
+use tokio::io::{AsyncReadExt, AsyncWriteExt, DuplexStream};
+
+/// A plausible, fixed baseline water temperature (24.50C = 2450 centidegrees) used to answer
+/// `GetTemperatures` in dry-run/mocked mode, and a plausible heatsink reading.
+pub const MOCK_BASELINE_LEFT_CENTIDEG: u16 = 2450;
+pub const MOCK_BASELINE_RIGHT_CENTIDEG: u16 = 2460;
+pub const MOCK_HEATSINK_CENTIDEG: u16 = 2600;
+
+fn mock_hardware_info_frame() -> Vec<u8> {
+    // Reuses the exact CBOR fixture verified by
+    // `opensleep::common::packet::tests::test_hardware_info`.
+    let payload = hex!(
+        "82 00 A6 63 73 6B 75 01 68 64 61 74 65
+        63 6F 64 65 1A 00 16 01 0D 6B 66 61 63
+        74 6F 72 79 6C 69 6E 65 01 65 68 77 72
+        65 76 19 05 00 62 70 6E 19 50 78 68 64
+        65 76 69 63 65 73 6E 1A 00 01 08 9C"
+    );
+    opensleep::common::codec::command(payload.to_vec())
+}
+
+fn mock_pong_frame(in_firmware: bool) -> Vec<u8> {
+    let code: u8 = if in_firmware { 0b0100_0110 } else { 0b0100_0010 };
+    opensleep::common::codec::command(vec![0x81, 0x00, code])
+}
+
+fn mock_get_temperature_frame() -> Vec<u8> {
+    // Matches `FrozenPacket::parse_get_temperature`'s exact layout: markers at indices 1/2/5/8/11
+    // (values 0,1,2,3,4), temperature fields at 3-4/6-7/9-10/12-13, and a fixed total payload
+    // size of 27 bytes (only the first 14 are meaningful; the rest is padding, per source).
+    let l = MOCK_BASELINE_LEFT_CENTIDEG.to_be_bytes();
+    let r = MOCK_BASELINE_RIGHT_CENTIDEG.to_be_bytes();
+    let h = MOCK_HEATSINK_CENTIDEG.to_be_bytes();
+    let mut payload = vec![
+        0xC1, 0x00, 0x01, l[0], l[1], 0x02, r[0], r[1], 0x03, 0x00, 0x00, 0x04, h[0], h[1],
+    ];
+    payload.resize(27, 0);
+    opensleep::common::codec::command(payload)
+}
+
+fn mock_target_update_frame(side: u8, enabled: bool, temp: u16) -> Vec<u8> {
+    let t = temp.to_be_bytes();
+    opensleep::common::codec::command(vec![0xC0, 0x00, side, enabled as u8, t[0], t[1]])
+}
+
+/// `FrozenPacket::parse_priming_started`'s exact layout: opcode 0xD2 + one value byte (0 =
+/// no unexpected value, per source). Sent by real Frozen firmware as the direct acknowledgment
+/// that priming has started -- see PROTOCOL_AUDIT.md.
+fn mock_priming_started_frame() -> Vec<u8> {
+    opensleep::common::codec::command(vec![0xD2, 0x00])
+}
+
+/// A `Message` (opcode 0x07) frame carrying `text`, matching `common::packet::parse_message`'s
+/// layout (2 header bytes the parser skips, then UTF-8 text).
+fn mock_message_frame(text: &str) -> Vec<u8> {
+    let mut payload = vec![0x07u8, 0x00];
+    payload.extend_from_slice(text.as_bytes());
+    opensleep::common::codec::command(payload)
+}
+
+/// Matches `FrozenPacket::parse_temperature_update`'s exact layout (opcode + 8 bytes: left/
+/// right/heatsink as big-endian u16, then a one-byte control-error term, then a one-byte
+/// wrapping counter). Real hardware pushes this unsolicited, on its own schedule, using the same
+/// raw opcode (0x41) as the `GetTemperatures` command itself -- see PROTOCOL_AUDIT.md.
+fn mock_temperature_update_frame(left: u16, right: u16, heatsink: u16, control_error_c: u8, count: u8) -> Vec<u8> {
+    let l = left.to_be_bytes();
+    let r = right.to_be_bytes();
+    let h = heatsink.to_be_bytes();
+    opensleep::common::codec::command(vec![0x41, l[0], l[1], r[0], r[1], h[0], h[1], control_error_c, count])
+}
+
+/// Spawns a background task that answers Frozen commands plausibly: Ping -> in-firmware Pong,
+/// GetHardwareInfo -> a fixed hardware-info fixture, GetTemperatures -> the fixed baseline above
+/// (both the solicited 0xC1 reply AND an immediately-following unsolicited 0x41 push, mirroring
+/// real hardware pushing telemetry on its own schedule independent of being polled -- see
+/// `cool_test.rs`, which relies on the unsolicited push, not the solicited reply, for safety
+/// monitoring), SetTargetTemperature -> an echoing TargetUpdate ack. Runs until the client side
+/// closes.
+///
+/// Prime (0x52) -> the real `PrimingStarted` (0xD2) ack plus a `"FW: [priming] start"` message
+/// immediately, then -- paced across the next few `GetTemperatures` requests that follow, so
+/// `frozen-prime-test`'s dry-run/tests see a realistic multi-tick sequence rather than everything
+/// at once -- a pump `Message` for each side and finally `"FW: [priming] done"`. All four message
+/// strings are exactly as captured in `frozen/state.rs`'s source (see PROTOCOL_AUDIT.md).
+///
+/// SetTargetTemperature(enabled=true) additionally arms one more paced push, on the next
+/// `GetTemperatures` tick: the exact real-hardware TEC sequence a live-hardware incident was found
+/// from (`"current: 11.402626 A"` then `"safe, unlocking"`, for whichever side was enabled) -- so
+/// `frozen-cool-test --dry-run` exercises this positive, nonterminal sequence too, including when
+/// run as the actual packaged ARM64 binary under `qemu-aarch64-static`.
+pub fn spawn_mock_frozen_device(mut device_side: DuplexStream) -> tokio::task::JoinHandle<()> {
+    tokio::spawn(async move {
+        let mut acc = BytesMut::new();
+        let mut read_buf = [0u8; 256];
+        let mut temperature_update_count: u8 = 0;
+        let mut primed = false;
+        let mut post_prime_ticks: u32 = 0;
+        // Set once `frozen-cool-test --dry-run` enables a side, so its own smoke-testing (via the
+        // real packaged binary under qemu-aarch64-static, not just `cargo test`) exercises the
+        // exact positive-TEC-state sequence a live-hardware incident was found from: a current
+        // reading followed by "safe, unlocking" must not itself end the run. `prime_test.rs` never
+        // enables a target, so this never fires there.
+        let mut enabled_side_word: Option<&'static str> = None;
+        let mut post_enable_ticks: u32 = 0;
+        loop {
+            if acc.len() >= 2 {
+                let len = acc[1] as usize;
+                let total = 1 + 1 + len + 2;
+                if acc.len() >= total {
+                    let opcode = acc[2];
+                    let payload = acc[2..2 + len].to_vec();
+                    acc.advance(total);
+                    if opcode == 0x41 {
+                        temperature_update_count = temperature_update_count.wrapping_add(1);
+                        let mut combined = mock_get_temperature_frame();
+                        // The real captured evidence for this control-error term is 8-9 during
+                        // normal pump operation (frozen/command.rs source comment; real passive
+                        // telemetry from this hardware consistently reports 9) -- never a fault
+                        // code, so the mock reuses that exact value rather than 0.
+                        combined.extend(mock_temperature_update_frame(
+                            MOCK_BASELINE_LEFT_CENTIDEG,
+                            MOCK_BASELINE_RIGHT_CENTIDEG,
+                            MOCK_HEATSINK_CENTIDEG,
+                            9,
+                            temperature_update_count,
+                        ));
+                        if primed {
+                            post_prime_ticks += 1;
+                            if post_prime_ticks == 1 {
+                                combined.extend(mock_message_frame("FW: pump[left] slow @ 6.030475V 0.169202A"));
+                                combined.extend(mock_message_frame("FW: pump[right] slow @ 6.044009V 0.161510A"));
+                            } else if post_prime_ticks == 3 {
+                                combined.extend(mock_message_frame("FW: [priming] done"));
+                            }
+                        }
+                        if let Some(side_word) = enabled_side_word {
+                            post_enable_ticks += 1;
+                            if post_enable_ticks == 1 {
+                                // Exact real-hardware capture: a current reading immediately
+                                // followed by the interlock reporting it is safe to run.
+                                combined.extend(mock_message_frame(&format!("FW: tec[{side_word}] current: 11.402626 A")));
+                                combined.extend(mock_message_frame(&format!("FW: tec[{side_word}] safe, unlocking")));
+                            }
+                        }
+                        if device_side.write_all(&combined).await.is_err() {
+                            break;
+                        }
+                        continue;
+                    }
+                    if opcode == 0x52 {
+                        primed = true;
+                        let mut combined = mock_priming_started_frame();
+                        combined.extend(mock_message_frame("FW: [priming] start"));
+                        if device_side.write_all(&combined).await.is_err() {
+                            break;
+                        }
+                        continue;
+                    }
+                    let response = match opcode {
+                        0x01 => Some(mock_pong_frame(true)),
+                        0x02 => Some(mock_hardware_info_frame()),
+                        0x04 => Some(opensleep::common::codec::command(vec![0x84])),
+                        0x10 => Some(opensleep::common::codec::command(vec![0x90, 0x00])),
+                        0x40 if payload.len() == 5 => {
+                            let side = payload[1];
+                            let enabled = payload[2] != 0;
+                            let temp = u16::from_be_bytes([payload[3], payload[4]]);
+                            if enabled {
+                                enabled_side_word = Some(if side == 0 { "left" } else { "right" });
+                            }
+                            Some(mock_target_update_frame(side, enabled, temp))
+                        }
+                        _ => None,
+                    };
+                    if let Some(resp) = response
+                        && device_side.write_all(&resp).await.is_err()
+                    {
+                        break;
+                    }
+                    continue;
+                }
+            }
+            match device_side.read(&mut read_buf).await {
+                Ok(0) | Err(_) => break,
+                Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+            }
+        }
+    })
+}
+
+/// Builds a connected duplex pair with the mock device already running on one end; the caller
+/// gets the client end to use exactly like a real `FrozenLink` transport.
+pub fn mock_frozen_link_pair() -> (DuplexStream, tokio::task::JoinHandle<()>) {
+    let (client, device) = tokio::io::duplex(8192);
+    let task = spawn_mock_frozen_device(device);
+    (client, task)
+}
+
+/// `frozen-cool-test --firmware-authoritative --dry-run`'s own mock device: unlike
+/// [`spawn_mock_frozen_device`] (shared with every other mode's dry-run/tests), this one
+/// deliberately reproduces the exact live-hardware race that motivated
+/// `--firmware-authoritative`'s item 12 packaged-binary check -- several `"pump[<side>] off @
+/// 0.000000V"` reports bundled into the *same write* as the enable command's own `TargetUpdate`
+/// acknowledgment, so they are still sitting unread in the transport when the enable confirmation
+/// is processed, exactly reproducing "arrived in the startup burst before or around target
+/// activation" -- plus the `"[pump-<side>] slow=>..."`/`"[pump-<side>] default=>..."`
+/// dash-and-arrow pump-*command* format (distinct from the bracket-and-`@` status format above)
+/// also captured in that incident. A healthy `--firmware-authoritative` run must not terminate
+/// because of any of this. Kept separate from `spawn_mock_frozen_device` rather than adding this
+/// injection there: that device is shared by every other mode's dry-run and tests, and this
+/// exact-ordering race is specific to what `--firmware-authoritative` is being checked against.
+pub fn spawn_mock_frozen_device_firmware_authoritative(mut device_side: DuplexStream) -> tokio::task::JoinHandle<()> {
+    tokio::spawn(async move {
+        let mut acc = BytesMut::new();
+        let mut read_buf = [0u8; 256];
+        let mut temperature_update_count: u8 = 0;
+        let mut enabled_side_word: Option<&'static str> = None;
+        let mut post_enable_ticks: u32 = 0;
+        loop {
+            if acc.len() >= 2 {
+                let len = acc[1] as usize;
+                let total = 1 + 1 + len + 2;
+                if acc.len() >= total {
+                    let opcode = acc[2];
+                    let payload = acc[2..2 + len].to_vec();
+                    acc.advance(total);
+                    if opcode == 0x41 {
+                        temperature_update_count = temperature_update_count.wrapping_add(1);
+                        let mut combined = mock_get_temperature_frame();
+                        combined.extend(mock_temperature_update_frame(
+                            MOCK_BASELINE_LEFT_CENTIDEG,
+                            MOCK_BASELINE_RIGHT_CENTIDEG,
+                            MOCK_HEATSINK_CENTIDEG,
+                            9,
+                            temperature_update_count,
+                        ));
+                        if enabled_side_word.is_none() {
+                            // Pre-enable pump-off telemetry, buffered well before any enable
+                            // command is even sent -- read and harmlessly discarded during
+                            // baseline collection (which never looks at Message content), exactly
+                            // like real captured evidence.
+                            combined.extend(mock_message_frame("FW: pump[left] off @ 0.000000V"));
+                        }
+                        if let Some(side_word) = enabled_side_word {
+                            post_enable_ticks += 1;
+                            match post_enable_ticks {
+                                1 => {
+                                    combined.extend(mock_message_frame(&format!("[pump-{side_word}] slow=>6.500000")));
+                                    combined.extend(mock_message_frame("[solenoid] on"));
+                                    combined.extend(mock_message_frame(&format!("FW: pid[{side_word}] 25.250000 -1.000000")));
+                                }
+                                2 => {
+                                    combined.extend(mock_message_frame(&format!("[pump-{side_word}] default=>9.000000")));
+                                }
+                                // No further pump-current/command telemetry for several ticks --
+                                // item 11's "no fresh pump-current report for 10 seconds": this
+                                // mode must not treat that absence as a fault.
+                                _ => {}
+                            }
+                        }
+                        if device_side.write_all(&combined).await.is_err() {
+                            break;
+                        }
+                        continue;
+                    }
+                    let response = match opcode {
+                        0x01 => Some(mock_pong_frame(true)),
+                        0x02 => Some(mock_hardware_info_frame()),
+                        0x04 => Some(opensleep::common::codec::command(vec![0x84])),
+                        0x10 => Some(opensleep::common::codec::command(vec![0x90, 0x00])),
+                        0x40 if payload.len() == 5 => {
+                            let side = payload[1];
+                            let enabled = payload[2] != 0;
+                            let temp = u16::from_be_bytes([payload[3], payload[4]]);
+                            let mut combined = Vec::new();
+                            if enabled {
+                                let side_word = if side == 0 { "left" } else { "right" };
+                                enabled_side_word = Some(side_word);
+                                // Bundled into the *same write* as the enable acknowledgment, so
+                                // these are still unread when the enable confirmation loop starts
+                                // -- the exact race this device exists to reproduce.
+                                combined.extend(mock_message_frame(&format!("FW: pump[{side_word}] off @ 0.000000V")));
+                                combined.extend(mock_message_frame(&format!("FW: pump[{side_word}] off @ 0.000000V")));
+                            }
+                            combined.extend(mock_target_update_frame(side, enabled, temp));
+                            Some(combined)
+                        }
+                        _ => None,
+                    };
+                    if let Some(resp) = response
+                        && device_side.write_all(&resp).await.is_err()
+                    {
+                        break;
+                    }
+                    continue;
+                }
+            }
+            match device_side.read(&mut read_buf).await {
+                Ok(0) | Err(_) => break,
+                Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+            }
+        }
+    })
+}
+
+/// Same as [`mock_frozen_link_pair`], but for `--firmware-authoritative --dry-run` -- see
+/// [`spawn_mock_frozen_device_firmware_authoritative`].
+pub fn mock_frozen_link_pair_firmware_authoritative() -> (DuplexStream, tokio::task::JoinHandle<()>) {
+    let (client, device) = tokio::io::duplex(8192);
+    let task = spawn_mock_frozen_device_firmware_authoritative(device);
+    (client, task)
+}
+
+/// Proactive mock Frozen device for `--release-frozen-only`'s dry-run and tests. Unlike
+/// [`spawn_mock_frozen_device`] (which paces its priming-completion push across several
+/// `GetTemperatures` polls, to give `frozen-prime-test`'s tick-based active loop a realistic
+/// multi-message sequence), this device pushes every message on its own short timer, with no
+/// polling required at all -- matching both real Frozen firmware (which pushes over UART on its
+/// own schedule) and `--release-frozen-only`'s own flow, which never sends `GetTemperatures`.
+///
+/// `start_in_bootloader` makes the first Ping answer `Pong(false)`, requiring a `JumpToFirmware`
+/// (opcode 0x10) before Ping answers `Pong(true)` -- exercising item 10's two branches.
+/// `capwater_unavailable` pushes `"FW: [capwater] sensor unavailable"` immediately after the first
+/// in-firmware Pong, mirroring real startup evidence. `done_because_empty` selects which of the
+/// two priming-completion messages `Prime` (0x52) elicits.
+pub fn spawn_mock_frozen_device_release_only(
+    start_in_bootloader: bool,
+    capwater_unavailable: bool,
+    done_because_empty: bool,
+) -> (DuplexStream, tokio::task::JoinHandle<()>) {
+    let (client, mut device_side) = tokio::io::duplex(8192);
+    let task = tokio::spawn(async move {
+        let mut in_firmware = !start_in_bootloader;
+        let mut capwater_message_sent = false;
+        let mut acc = BytesMut::new();
+        let mut read_buf = [0u8; 256];
+        loop {
+            if acc.len() >= 2 {
+                let len = acc[1] as usize;
+                let total = 1 + 1 + len + 2;
+                if acc.len() >= total {
+                    let opcode = acc[2];
+                    acc.advance(total);
+                    match opcode {
+                        0x01 => {
+                            let mut combined = mock_pong_frame(in_firmware);
+                            if in_firmware && capwater_unavailable && !capwater_message_sent {
+                                combined.extend(mock_message_frame("FW: [capwater] sensor unavailable"));
+                                capwater_message_sent = true;
+                            }
+                            if device_side.write_all(&combined).await.is_err() {
+                                break;
+                            }
+                        }
+                        0x10 => {
+                            in_firmware = true;
+                            if device_side
+                                .write_all(&opensleep::common::codec::command(vec![0x90, 0x00]))
+                                .await
+                                .is_err()
+                            {
+                                break;
+                            }
+                        }
+                        0x52 => {
+                            let mut combined = mock_priming_started_frame();
+                            combined.extend(mock_message_frame("FW: [priming] start"));
+                            if device_side.write_all(&combined).await.is_err() {
+                                break;
+                            }
+                            tokio::time::sleep(Duration::from_millis(50)).await;
+                            let done_text = if done_because_empty {
+                                "FW: [priming] done because empty"
+                            } else {
+                                "FW: [priming] done"
+                            };
+                            if device_side.write_all(&mock_message_frame(done_text)).await.is_err() {
+                                break;
+                            }
+                        }
+                        _ => {}
+                    }
+                    continue;
+                }
+            }
+            match device_side.read(&mut read_buf).await {
+                Ok(0) | Err(_) => break,
+                Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+            }
+        }
+    });
+    (client, task)
+}
diff --git a/src/bin/opensleep-diagnostic/ownership.rs b/src/bin/opensleep-diagnostic/ownership.rs
new file mode 100644
index 0000000..910d8c6
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/ownership.rs
@@ -0,0 +1,121 @@
+//! Best-effort checks that stock OpenSleep-family services aren't running and that no other
+//! process already holds `/dev/i2c-1` or the Frozen UART open. Both checks are advisory when
+//! inconclusive (e.g. `systemctl` isn't present on a development machine) but refuse to proceed
+//! on a *positive* detection, since testing hardware that a live stock service is simultaneously
+//! driving is unsafe and the results would be meaningless anyway.
+
+use std::path::Path;
+use std::process::Command;
+
+const STOCK_SERVICES: &[&str] = &[
+    "capybara.service",
+    "dac.service",
+    "frank.service",
+    "frankenfirmware.service",
+    "opensleep.service",
+    // Added for frozen-prime-test; harmless to also check from frozen-passive/frozen-cool-test,
+    // since `systemctl is-active` on a unit that doesn't exist on this Hub just reports inactive.
+    "opensleep-manual-ui.service",
+];
+
+#[derive(Debug, Clone)]
+pub struct ServiceCheck {
+    pub name: String,
+    pub active: bool,
+}
+
+/// Runs `systemctl is-active <name>` for each known stock unit. Returns an empty vec (not an
+/// error) when `systemctl` itself isn't available, e.g. on a development machine -- that case is
+/// logged and treated as inconclusive, not as a refusal.
+pub fn check_stock_services() -> Vec<ServiceCheck> {
+    if which_systemctl().is_none() {
+        log::info!("systemctl not found on this host; skipping stock-service check (expected on a dev machine)");
+        return Vec::new();
+    }
+
+    STOCK_SERVICES
+        .iter()
+        .map(|name| {
+            let active = Command::new("systemctl")
+                .args(["is-active", "--quiet", name])
+                .status()
+                .map(|s| s.success())
+                .unwrap_or(false);
+            ServiceCheck {
+                name: name.to_string(),
+                active,
+            }
+        })
+        .collect()
+}
+
+fn which_systemctl() -> Option<()> {
+    Command::new("systemctl")
+        .arg("--version")
+        .output()
+        .ok()
+        .filter(|o| o.status.success())
+        .map(|_| ())
+}
+
+/// Best-effort scan of `/proc/*/fd/*` for a symlink resolving to `path`, i.e. "fuser"-lite.
+/// Returns `Ok(true)` only on a positive match; permission-denied entries for other users' `/proc`
+/// directories are silently skipped (not treated as a match) since this diagnostic does not run
+/// as every uid.
+pub fn device_is_open_elsewhere(path: &str) -> bool {
+    let target = match std::fs::canonicalize(path) {
+        Ok(p) => p,
+        Err(_) => return false, // device doesn't exist yet; nothing can have it open
+    };
+
+    let proc_dir = match std::fs::read_dir("/proc") {
+        Ok(d) => d,
+        Err(_) => return false, // not on Linux /proc, e.g. some dev machines: inconclusive
+    };
+
+    for entry in proc_dir.flatten() {
+        let pid_path = entry.path();
+        let Some(pid) = pid_path.file_name().and_then(|n| n.to_str()) else {
+            continue;
+        };
+        if pid.parse::<u32>().is_err() {
+            continue;
+        }
+        let fd_dir = pid_path.join("fd");
+        let Ok(fds) = std::fs::read_dir(&fd_dir) else {
+            continue;
+        };
+        for fd in fds.flatten() {
+            if let Ok(resolved) = std::fs::read_link(fd.path())
+                && resolved == target
+            {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+pub fn device_exists(path: &str) -> bool {
+    Path::new(path).exists()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nonexistent_device_is_not_reported_as_open_elsewhere() {
+        assert!(!device_is_open_elsewhere("/dev/does-not-exist-opensleep-diagnostic"));
+    }
+
+    #[test]
+    fn our_own_open_file_is_detected_as_open() {
+        let path = std::env::temp_dir().join("opensleep-diagnostic-ownership-test");
+        let _f = std::fs::File::create(&path).unwrap();
+        let held = _f;
+        assert!(device_is_open_elsewhere(path.to_str().unwrap()));
+        drop(held);
+        let _ = std::fs::remove_file(&path);
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/passive.rs b/src/bin/opensleep-diagnostic/passive.rs
new file mode 100644
index 0000000..dbe251f
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/passive.rs
@@ -0,0 +1,443 @@
+//! `frozen-passive`: safe with the cover disconnected and no water. Never constructs an enabled
+//! `SetTargetTemperature`; the only actuator-shaped command it can ever send is the disabled
+//! (`enabled=false`) safety-off, which both `AuditedTransport` and the closed `FrozenAction` enum
+//! make the sole reachable option in `Mode::Passive`. See SAFETY.md and PROTOCOL_AUDIT.md.
+
+use std::time::Duration;
+
+use opensleep::common::packet::BedSide;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::time::Instant;
+
+use crate::buildinfo::{DIAGNOSTIC_VERSION, kernel_release, source_commit};
+use crate::cli::PassiveArgs;
+use crate::i2c::{I2cPort, MockI2c, RealI2c, probe_address, run_reset_sequence};
+use crate::link::{FrozenLink, PacketOutcome};
+use crate::mock::mock_frozen_link_pair;
+use crate::ownership;
+use crate::report::{AuditEntryJson, Confirmations, Report, TemperatureSampleJson};
+use crate::safe_stop::run_safe_stop;
+use crate::safety::{AuditedTransport, FrozenAction, Mode};
+use crate::signals::StopReason;
+use crate::telemetry::{PacketStats, sample_from_get_temperature, sample_from_temperature_update};
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(3);
+
+pub async fn run(args: &PassiveArgs) -> (Report, u8) {
+    if args.dry_run {
+        log::warn!("--dry-run: no I2C or UART writes will be performed; using a mocked Frozen device");
+        let mock_i2c = MockI2c::always_succeed();
+        let (client, device_task) = mock_frozen_link_pair();
+        let link = crate::link::FrozenLink::wrap(client, "dry-run");
+        let result = run_core(args, mock_i2c, Some(link), true).await;
+        device_task.abort();
+        return result;
+    }
+
+    // Step 1: refuse if a known stock service is running or another process already holds the
+    // device open.
+    if let Some(early) = refuse_if_owned(args) {
+        return early;
+    }
+
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("failed to open I2C device {}: {e}", args.i2c_device);
+            return (
+                base_report(args, false, "I2C bus failed to open", None),
+                20,
+            );
+        }
+    };
+
+    let (bus_open, expander_probe, expander_value, led_ok, reset_ok) =
+        run_i2c_preflight(args, &mut i2c).await;
+    let _ = (bus_open, expander_probe, expander_value, led_ok, reset_ok);
+
+    let link = match FrozenLink::<tokio_serial::SerialStream>::open(&args.frozen_port) {
+        Ok(l) => Some(l),
+        Err(e) => {
+            log::error!("failed to open Frozen UART {}: {e}", args.frozen_port);
+            None
+        }
+    };
+
+    run_core(args, i2c, link, false).await
+}
+
+fn refuse_if_owned(args: &PassiveArgs) -> Option<(Report, u8)> {
+    let services = ownership::check_stock_services();
+    let active: Vec<_> = services.iter().filter(|s| s.active).map(|s| s.name.clone()).collect();
+    if !active.is_empty() {
+        log::error!("refusing to run: stock service(s) active: {active:?}");
+        return Some((
+            base_report(args, false, "stock service(s) active; refusing to run", None),
+            40,
+        ));
+    }
+    if ownership::device_exists(&args.i2c_device) && ownership::device_is_open_elsewhere(&args.i2c_device) {
+        log::error!("refusing to run: {} appears to be open in another process", args.i2c_device);
+        return Some((
+            base_report(args, false, "I2C device already open elsewhere", None),
+            40,
+        ));
+    }
+    if ownership::device_exists(&args.frozen_port) && ownership::device_is_open_elsewhere(&args.frozen_port) {
+        log::error!("refusing to run: {} appears to be open in another process", args.frozen_port);
+        return Some((
+            base_report(args, false, "Frozen UART already open elsewhere", None),
+            40,
+        ));
+    }
+    None
+}
+
+async fn run_i2c_preflight<P: I2cPort>(args: &PassiveArgs, dev: &mut P) -> (bool, bool, Option<u8>, bool, bool) {
+    let _ = args;
+    let expander = probe_address(dev, crate::i2c::RESET_EXPANDER_ADDR);
+    log::info!("{}", expander.describe());
+
+    let led = probe_address(dev, crate::i2c::LED_CONTROLLER_ADDR);
+    if led.success {
+        log::info!("{}", led.describe());
+    } else {
+        log::info!("LED controller unavailable; continuing diagnostic ({})", led.describe());
+    }
+
+    (true, expander.success, expander.value, led.success, false)
+}
+
+async fn run_core<T, P>(
+    args: &PassiveArgs,
+    mut i2c: P,
+    mut link: Option<FrozenLink<T>>,
+    dry_run: bool,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let expander = probe_address(&mut i2c, crate::i2c::RESET_EXPANDER_ADDR);
+    let led = probe_address(&mut i2c, crate::i2c::LED_CONTROLLER_ADDR);
+    if !led.success {
+        log::info!("LED controller unavailable; continuing diagnostic ({})", led.describe());
+    }
+
+    let subsystem_reset_ok = if args.reset_subsystems {
+        let (steps, _release) = run_reset_sequence(&mut i2c).await;
+        steps.iter().all(|s| s.success)
+    } else {
+        log::info!("Subsystem reset not requested (pass --reset-subsystems to opt in)");
+        true
+    };
+
+    let mut audit = AuditedTransport::new(Mode::Passive);
+    let mut stats = PacketStats::default();
+    let mut samples: Vec<TemperatureSampleJson> = Vec::new();
+
+    let mut bootloader_ping = None;
+    let mut firmware_ping = None;
+    let mut detected_initial_mode = None;
+    let mut firmware_jump_sent = false;
+    let mut hardware_info_str = None;
+    let mut reached_firmware = false;
+    let mut safety_off_sent = 0u32;
+    let mut firmware_probed = false;
+
+    if let Some(link) = link.as_mut() {
+        let (ok, mode) = crate::frozen_ops::ping(link, &mut audit, COMMAND_TIMEOUT).await;
+        detected_initial_mode = Some(match mode {
+            crate::frozen_ops::DeviceMode::Bootloader => "bootloader",
+            crate::frozen_ops::DeviceMode::Firmware => "firmware",
+            crate::frozen_ops::DeviceMode::Unknown => "unknown",
+        });
+        match mode {
+            crate::frozen_ops::DeviceMode::Bootloader => bootloader_ping = Some(ok),
+            crate::frozen_ops::DeviceMode::Firmware => firmware_ping = Some(ok),
+            crate::frozen_ops::DeviceMode::Unknown => {}
+        }
+
+        if ok {
+            if let Some(hw) = crate::frozen_ops::get_hardware_info(link, &mut audit, COMMAND_TIMEOUT).await {
+                hardware_info_str = Some(hw.to_string());
+            }
+        }
+
+        if mode == crate::frozen_ops::DeviceMode::Firmware {
+            reached_firmware = true;
+        } else if mode == crate::frozen_ops::DeviceMode::Bootloader {
+            if args.allow_firmware_jump {
+                firmware_jump_sent = true;
+                let ok = crate::frozen_ops::jump_to_firmware_and_wait(link, &mut audit, COMMAND_TIMEOUT).await;
+                firmware_ping = Some(ok);
+                reached_firmware = ok;
+            } else {
+                log::info!("Frozen is in its bootloader; not jumping (pass --allow-firmware-jump to opt in)");
+            }
+        }
+
+        // Optional, passive, best-effort: GetFirmware (0x04). Only sent once application
+        // firmware has already answered, and its outcome never affects `reached_firmware`. Note
+        // for the report: the reused `FrozenPacket::GetFirmware` response (opcode 0x84) carries
+        // no version/hash payload in this source revision -- it is an acknowledgement only -- so
+        // `firmware_version_or_hash` stays `None` even on success rather than inventing content.
+        if reached_firmware {
+            match link.send(&mut audit, FrozenAction::get_firmware(), COMMAND_TIMEOUT).await {
+                Ok(crate::link::PacketOutcome::Received(_)) => firmware_probed = true,
+                Ok(_) => log::debug!("Frozen did not respond to GetFirmware within {COMMAND_TIMEOUT:?}"),
+                Err(e) => log::debug!("Frozen GetFirmware failed (non-fatal): {e}"),
+            }
+        }
+
+        // Step 12: immediately send a safety-off target to both sides, regardless of mode
+        // outcome, using the exact "disabled" value stock OpenSleep itself sends (see
+        // safety::DISABLE_TARGET_CENTIDEG).
+        for side in [BedSide::Left, BedSide::Right] {
+            match link.send(&mut audit, FrozenAction::safety_off(side), COMMAND_TIMEOUT).await {
+                Ok(_) => safety_off_sent += 1,
+                Err(e) => log::error!("safety-off for {side:?} failed: {e}"),
+            }
+        }
+
+        if reached_firmware {
+            let start = Instant::now();
+            let duration = Duration::from_secs(args.duration_seconds.max(1));
+            let mut tick = 0u64;
+            while start.elapsed() < duration {
+                let elapsed_ms = start.elapsed().as_millis() as u64;
+                poll_tick(link, &mut audit, elapsed_ms, &mut stats, &mut samples).await;
+                tick += 1;
+                let next_tick_at = start + Duration::from_secs(tick);
+                let now = Instant::now();
+                if next_tick_at > now {
+                    tokio::time::sleep(next_tick_at - now).await;
+                }
+            }
+        }
+    }
+
+    let ss_i2c = &mut i2c;
+    let safe_stop = run_safe_stop(link.as_mut(), &mut audit, Some(ss_i2c)).await;
+
+    let telemetry_valid = !samples.is_empty();
+    let overall_pass = reached_firmware && telemetry_valid && safe_stop.fully_succeeded();
+
+    let mut report = base_report(
+        args,
+        dry_run,
+        if overall_pass { "completed normally" } else { "completed" },
+        None,
+    );
+    report.i2c_bus_open = true;
+    report.reset_expander_probe_ok = expander.success;
+    report.reset_expander_value = expander.value;
+    report.led_controller_probe_ok = led.success;
+    report.subsystem_reset_performed = args.reset_subsystems;
+    report.subsystem_reset_ok = subsystem_reset_ok;
+    report.frozen_uart_opened = link.is_some();
+    report.frozen_bootloader_ping = bootloader_ping;
+    report.frozen_firmware_ping = firmware_ping;
+    report.frozen_hardware_info = hardware_info_str;
+    report.detected_initial_mode = detected_initial_mode.map(str::to_string);
+    report.firmware_jump_sent = firmware_jump_sent;
+    report.frozen_firmware_probed = firmware_probed;
+    report.mode = audit.mode().label().to_string();
+    report.outgoing_commands = audit.entries().iter().map(AuditEntryJson::from).collect();
+    report.enabled_target_command_count = audit.enabled_target_count();
+    report.prime_command_count = audit.prime_count();
+    report.random_command_count = audit.random_count();
+    report.safety_off_commands_sent = safety_off_sent;
+    report.telemetry_samples = samples;
+    report.raw_packets_decoded = stats.raw_packets_decoded;
+    report.malformed_windows = stats.malformed_windows;
+    report.communication_timeouts = stats.timeouts;
+    report.unsolicited_telemetry_seen = stats.unsolicited_telemetry_seen;
+    report.firmware_messages = stats.messages;
+    report.stop_reason = StopReason::Normal.to_string();
+    report.safe_stop = Some((&safe_stop).into());
+    report.overall_pass = overall_pass;
+    report.exit_code = if overall_pass {
+        0
+    } else if detected_initial_mode.as_deref() == Some("bootloader") {
+        10
+    } else if report.frozen_uart_opened {
+        11
+    } else {
+        11
+    };
+
+    if let Some(path) = &args.json_output
+        && let Err(e) = report.write_json(path)
+    {
+        log::error!("failed to write JSON output to {path}: {e}");
+    }
+    if let Some(path) = &args.csv_output
+        && let Err(e) = report.write_csv(path)
+    {
+        log::error!("failed to write CSV output to {path}: {e}");
+    }
+    report.print_table();
+
+    let code = report.exit_code;
+    (report, code)
+}
+
+async fn poll_tick<T>(
+    link: &mut FrozenLink<T>,
+    audit: &mut AuditedTransport,
+    elapsed_ms: u64,
+    stats: &mut PacketStats,
+    samples: &mut Vec<TemperatureSampleJson>,
+) where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    match link.send(audit, FrozenAction::get_temperatures(), COMMAND_TIMEOUT).await {
+        Ok(PacketOutcome::Received(pkt)) => {
+            stats.record(&pkt);
+            store_sample(pkt, elapsed_ms, samples);
+        }
+        Ok(PacketOutcome::TimedOut) => stats.record_timeout(),
+        Ok(PacketOutcome::Closed) => {}
+        Err(e) => log::error!("GetTemperatures failed: {e}"),
+    }
+
+    // Drain any additional packets already buffered (e.g. unsolicited pushes) without sending.
+    loop {
+        match link.recv(Duration::from_millis(50)).await {
+            Ok(PacketOutcome::Received(pkt)) => {
+                stats.record(&pkt);
+                store_sample(pkt, elapsed_ms, samples);
+            }
+            _ => break,
+        }
+    }
+}
+
+fn store_sample(pkt: opensleep::frozen::FrozenPacket, elapsed_ms: u64, samples: &mut Vec<TemperatureSampleJson>) {
+    use opensleep::frozen::FrozenPacket;
+    let ts = jiff::Timestamp::now().to_string();
+    match pkt {
+        FrozenPacket::GetTemperature(g) => {
+            samples.push((&sample_from_get_temperature(elapsed_ms, ts, &g)).into());
+        }
+        FrozenPacket::TemperatureUpdate(u) => {
+            samples.push((&sample_from_temperature_update(elapsed_ms, ts, &u)).into());
+        }
+        FrozenPacket::Message(m) => log::info!("Frozen firmware message: {m}"),
+        other => log::debug!("Frozen packet: {other:?}"),
+    }
+}
+
+fn base_report(args: &PassiveArgs, dry_run: bool, stop_reason: &str, exit_code_override: Option<u8>) -> Report {
+    Report {
+        program_version: DIAGNOSTIC_VERSION.to_string(),
+        opensleep_base_version: opensleep::VERSION.to_string(),
+        opensleep_source_commit: source_commit().to_string(),
+        kernel: kernel_release(),
+        arch: std::env::consts::ARCH.to_string(),
+        mode: "frozen-passive".to_string(),
+        dry_run,
+        confirmations: Confirmations::default(),
+        i2c_device: args.i2c_device.clone(),
+        i2c_bus_open: false,
+        reset_expander_probe_ok: false,
+        reset_expander_value: None,
+        led_controller_probe_ok: false,
+        subsystem_reset_performed: args.reset_subsystems,
+        subsystem_reset_ok: false,
+        frozen_port: args.frozen_port.clone(),
+        frozen_uart_opened: false,
+        frozen_bootloader_ping: None,
+        frozen_firmware_ping: None,
+        frozen_hardware_info: None,
+        firmware_version_or_hash: None,
+        frozen_firmware_probed: false,
+        detected_initial_mode: None,
+        firmware_jump_sent: false,
+        outgoing_commands: Vec::new(),
+        enabled_target_command_count: 0,
+        prime_command_count: 0,
+        random_command_count: 0,
+        safety_off_commands_sent: 0,
+        rejected_command_count: 0,
+        prime_frame_hex: None,
+        telemetry_samples: Vec::new(),
+        raw_packets_decoded: 0,
+        malformed_windows: 0,
+        communication_timeouts: 0,
+        unsolicited_telemetry_seen: false,
+        firmware_messages: Vec::new(),
+        pump_samples: Vec::new(),
+        solenoid_valve_messages: Vec::new(),
+        reservoir_transition_messages: Vec::new(),
+        other_decoded_packets: Vec::new(),
+        raw_io_events: Vec::new(),
+        priming_start_observed: false,
+        priming_done_observed: false,
+        priming_done_because_empty: false,
+        operator_observations: None,
+        prime_operator_observations: None,
+        stop_reason: stop_reason.to_string(),
+        safe_stop: None,
+        component_results: None,
+        prime_results: None,
+        opensleep_init_results: None,
+        release_frozen_only_results: None,
+        cool_test_results: None,
+        overall_pass: false,
+        exit_code: exit_code_override.unwrap_or(30),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::cli::PassiveArgs;
+
+    fn args(dry_run: bool) -> PassiveArgs {
+        PassiveArgs {
+            i2c_device: "/dev/i2c-1".into(),
+            frozen_port: "/dev/ttyS1".into(),
+            reset_subsystems: false,
+            allow_firmware_jump: true,
+            duration_seconds: 1,
+            json_output: None,
+            csv_output: None,
+            verbose: false,
+            dry_run,
+        }
+    }
+
+    #[tokio::test]
+    async fn dry_run_never_touches_real_devices_and_reaches_firmware() {
+        let (report, code) = run(&args(true)).await;
+        assert!(report.dry_run);
+        assert_eq!(report.frozen_firmware_ping, Some(true));
+        assert!(report.overall_pass);
+        assert_eq!(code, 0);
+        assert_eq!(report.enabled_target_command_count, 0);
+        assert_eq!(report.prime_command_count, 0);
+        assert_eq!(report.random_command_count, 0);
+    }
+
+    #[tokio::test]
+    async fn passive_never_sends_an_enabled_target_command() {
+        let (report, _) = run(&args(true)).await;
+        assert!(report.outgoing_commands.iter().all(|c| c.enabled != Some(true)));
+    }
+
+    #[tokio::test]
+    async fn passive_sends_safety_off_for_both_sides() {
+        let (report, _) = run(&args(true)).await;
+        assert_eq!(report.safety_off_commands_sent, 2);
+        let sides: Vec<_> = report
+            .outgoing_commands
+            .iter()
+            .filter(|c| c.enabled == Some(false))
+            .filter_map(|c| c.side.clone())
+            .collect();
+        assert!(sides.contains(&"left".to_string()));
+        assert!(sides.contains(&"right".to_string()));
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/prime_opensleep_init.rs b/src/bin/opensleep-diagnostic/prime_opensleep_init.rs
new file mode 100644
index 0000000..268213c
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/prime_opensleep_init.rs
@@ -0,0 +1,1394 @@
+//! `frozen-prime-opensleep-init`: fills an empty or partially-filled hydraulic loop by sending
+//! `Prime` exactly once, through the real, unmodified upstream OpenSleep initialization and Frozen
+//! manager code -- `opensleep::reset::ResetController::reset_subsystems`, `opensleep::led`,
+//! `opensleep::mqtt::MqttManager`, `opensleep::frozen::run` -- rather than `frozen-prime-test`'s
+//! own reimplemented reset sequence and command transport. The Sensor subsystem is deliberately
+//! never started at all -- see "MQTT is optional; Sensor is disabled entirely" below.
+//!
+//! ## Why this mode exists, and how it differs from `frozen-prime-test`
+//!
+//! `frozen-prime-test` (and this binary's other subcommands) reimplement a *minimal* version of
+//! OpenSleep's I2C reset sequence and Frozen UART transport, specifically so they can run without
+//! ever touching MQTT/the operator's saved configuration file/the Sensor subsystem/the normal
+//! command scheduler. That
+//! reimplementation is deliberately partial: it mirrors the real `ResetController::reset_subsystems`
+//! register-for-register, but it is still a *second, separate* implementation of that sequence, not
+//! the real one -- and real hardware evidence has shown that a partial/alternate initialization
+//! path can leave the reservoir-level (`capwater`) sensor in a different state than a full, real
+//! OpenSleep boot does. This mode exists to remove that gap entirely: it calls the exact same
+//! functions real `opensleep`'s own `main.rs` calls, in the same order, so there is no second
+//! implementation to drift from the first.
+//!
+//! ## What is, and is not, reused
+//!
+//! Reused unmodified: `ResetController::new`/`reset_subsystems` (the real I2C reset), the real
+//! `/home/dac/app/sewer/device-label` read, `IS31FL3194Controller` (LED; writes to the unavailable
+//! 0x53 controller are already non-fatal in the *upstream* `frozen::run` -- see `set_led` in
+//! `opensleep::frozen::manager` -- so nothing extra is needed for that here), `MqttManager::new`,
+//! and -- doing all of the real work -- `opensleep::frozen::run` (the actual Frozen manager task:
+//! the real Ping/GetHardwareInfo boot sequence, the real wake-retry logic, and the real command
+//! scheduler that this mode steers into sending exactly one `Prime` by constructing an in-memory
+//! `Config`, not by calling any command channel that doesn't exist in the upstream code -- see
+//! "Triggering Prime" below).
+//!
+//! Deliberately not reused: the real config-file loader (this mode never reads the operator's own
+//! saved configuration from disk; it constructs its own in-memory `Config` -- see below) and
+//! `MqttManager::wait_for_conn`/`MqttManager::run` (this mode constructs an `MqttManager` exactly
+//! as upstream does, so `frozen::run` gets a real, well-formed `AsyncClient`, but never polls its
+//! event loop -- see "MQTT and Sensor are optional" below). Nothing in this file reimplements
+//! reset, transport framing, or packet decoding: every one of those is a call into the real
+//! `opensleep` library.
+//!
+//! ## Triggering Prime without a command channel
+//!
+//! The pinned upstream source has no API to tell a running `frozen::run` task "send Prime now":
+//! `frozen::manager::get_next_command` decides *internally*, once per ~20ms tick, whether to send
+//! `Prime` based on the current `Config` (`cfg.prime`, a time-of-day) and a few seconds of internal
+//! debounce state. This mode drives that real scheduling logic by constructing a `Config` whose
+//! `prime` field is "now" (in a timezone chosen only for internal self-consistency -- see
+//! `build_config`) immediately before starting `frozen::run`. The real scheduler's own 60-second
+//! per-run debounce and the 30-second matching window around `prime` then make it fire at most
+//! once, exactly like it would for a real end user's scheduled priming time -- this mode adds no
+//! separate at-most-once enforcement of its own because the reused code already has one.
+//!
+//! `away_mode` is left `false` (setting it `true` would also block the Prime schedule -- see
+//! `frozen::manager::get_next_command`'s `!away_mode` guard), but the constructed `SidesConfig` has
+//! an empty temperature profile, which `frozen::profile::SideConfig::calc_target` already treats as
+//! "always disabled" regardless of time -- so temperature targets never get enabled, satisfying
+//! "keep profiles disabled" without needing `away_mode` to do it.
+//!
+//! ## Observing capwater/flowrate and priming-stage messages without a tap in upstream code
+//!
+//! `opensleep::frozen::state::FrozenState::handle_packet` logs every firmware `Message` it doesn't
+//! specifically interpret (which includes `"FW: [capwater] sensor unavailable"` and
+//! `"FW: [flowrate] sensor unavailable"`) at `debug` level, and every `"FW: [priming] ..."` stage
+//! message at `info` level -- but exposes none of that to callers directly (`FrozenState` only
+//! tracks a collapsed `is_priming: bool`, which cannot distinguish `"done"` from `"done because
+//! empty"`). Since this process is the one running that code, `log_tap` taps the same global
+//! logger every subcommand already uses to observe those exact log lines without modifying
+//! `frozen/state.rs` at all -- see that module's docs.
+//!
+//! ## The Frozen UART path is hardware-specific, and is passed explicitly -- never the upstream
+//! ## `PORT` constant
+//!
+//! `opensleep::frozen::PORT` (`"/dev/ttymxc2"`) is correct for the MT8365 devkit this fork's pinned
+//! upstream source was written against, but not for every Hub this diagnostic runs on: a real,
+//! live run on this Hub completed the real subsystem reset and then failed immediately with
+//! `Serial Io(NotFound): No such file or directory` the moment `frozen::run` tried to open that
+//! path. This Hub exposes Frozen at `/dev/ttyS1` (still 38400 baud -- `frozen::manager::BAUD` is
+//! unchanged and untouched) instead. `frozen::run`'s first parameter is a plain `port: &'static
+//! str`; this file passes `FROZEN_UART_PATH` (`"/dev/ttyS1"`) there directly and never references
+//! `opensleep::frozen::PORT` as an argument to anything that opens a port -- only, once, as the
+//! *comparison* value in the logged override message in `run_core`, which does not open it. This
+//! changes nothing about the manager's protocol, wake sequence, or state
+//! machine: `frozen::run`'s body is untouched, exactly as every other module doc in this file
+//! already claims -- only the device path handed to it differs. See `FROZEN_UART_PATH`'s own doc
+//! comment and the regression tests at the bottom of this file.
+//!
+//! ## MQTT is optional; Sensor is disabled entirely
+//!
+//! Real `opensleep::main` treats `MqttManager::wait_for_conn` failure as fatal (it returns before
+//! starting Frozen at all); that is not appropriate for a one-shot Prime operation, so this mode
+//! never calls `wait_for_conn` -- a missing/unreachable MQTT broker never blocks or fails startup.
+//! The constructed `AsyncClient` is still handed to `frozen::run` exactly as upstream does, it
+//! simply never has its event loop polled, so no network I/O is ever attempted.
+//!
+//! The Sensor subsystem is not started at all in this mode: it is a separate physical UART (the
+//! upstream default for it is also wrong for this Hub, which would need `/dev/ttyS2` if Sensor
+//! were ever retained here) with no bearing on Frozen priming or on
+//! `capwater`/`flowrate` reporting (those come from Frozen's own firmware messages -- see
+//! `frozen/state.rs`), so the surest way to guarantee it "must not prevent priming" is to never run
+//! it, rather than run it best-effort and have to keep proving its failures stay non-blocking.
+//!
+//! ## Shutdown
+//!
+//! On normal completion or `"done because empty"`, this mode does **not** assert the I2C subsystem
+//! reset -- Frozen's own firmware returns to idle after priming ends on its own, and forcing a
+//! reset immediately after using the real initialization path would be needlessly disruptive to a
+//! subsystem this mode is specifically trying to leave in its normal, running state. The process
+//! exits via the same mechanism real `main.rs` already uses for its top-level shutdown: a
+//! `tokio::select!` whose losing branches are dropped (cancelled) the moment one branch resolves --
+//! here, that's either the observation loop deciding it's done, or a termination signal. Ctrl+C
+//! just lets that same drop-based shutdown happen -- temperature targets are never enabled during
+//! this run in the first place (the constructed profile has no temperatures, which the real
+//! scheduler always treats as disabled), so there is nothing to actively disable at that point; no
+//! reset is asserted for a clean stop either. The one exception is a genuine
+//! firmware-reported pump fault observed during the active window, which does assert reset (via
+//! this diagnostic's own, already-audited `i2c::assert_reset` -- not upstream's reset sequence) as
+//! an emergency backstop.
+
+use std::time::Duration;
+
+use jiff::Timestamp;
+use jiff::civil::Time;
+use jiff::tz::TimeZone;
+use opensleep::config::{Config, LEDConfig, MqttConfig, SideConfig, SidesConfig};
+use opensleep::frozen::FrozenPacket;
+use opensleep::led::{CurrentBand, IS31FL3194Controller, LedPattern};
+use opensleep::mqtt::MqttManager;
+use opensleep::reset::ResetController;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::sync::{mpsc, watch};
+use tokio::time::Instant;
