+                + 1;
+            let (client, device) = tokio::io::duplex(4096);
+            if call_num >= 2 || self.answer_first_firmware_call {
+                tokio::spawn(run_fake_device(
+                    device,
+                    self.firmware_script.clone(),
+                    self.seen_tx.clone(),
+                ));
+            }
+            // else: no device is attached to the far end, so any Ping sent on the first
+            // (pre-jump) firmware attempt goes unanswered, exactly like real bootloader-mode
+            // hardware would ignore a Ping sent at the wrong baud.
+            Ok(Framed::new(
+                LoggingIo::new(AnyIo::Duplex(client), "test-fw"),
+                PacketCodec::new(),
+            ))
+        }
