diff --git a/src/bin/opensleep-diagnostic/buildinfo.rs b/src/bin/opensleep-diagnostic/buildinfo.rs
new file mode 100644
index 0000000..261be8d
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/buildinfo.rs
@@ -0,0 +1,48 @@
+//! Build/source identifiers reported in every summary.
+
+pub const DIAGNOSTIC_VERSION: &str = env!("CARGO_PKG_VERSION");
+
+pub fn source_commit() -> &'static str {
+    option_env!("OPENSLEEP_SOURCE_COMMIT")
+        .unwrap_or("unknown (set OPENSLEEP_SOURCE_COMMIT at build time)")
+}
+
+pub fn kernel_release() -> String {
+    std::fs::read_to_string("/proc/sys/kernel/osrelease")
+        .map(|s| s.trim().to_string())
+        .unwrap_or_else(|_| "unknown".to_string())
+}
+
+/// Installs the process-wide logger. Every subcommand shares this one `env_logger::Builder::init`
+/// call (it can only be called once per process) -- the custom `format` closure below is what lets
+/// `frozen-prime-opensleep-init` observe messages logged by the real, unmodified upstream `frozen`/
+/// `sensor`/`reset` modules of the `opensleep` library it calls into (see `log_tap`'s module docs),
+/// without installing a second logger or modifying that code. For every
+/// other subcommand this is a single relaxed atomic load per log line (see `log_tap::observe`).
+///
+/// `opensleep::frozen` is always filtered at `debug` regardless of `--verbose`: the capwater/
+/// flowrate-unavailable messages `frozen-prime-opensleep-init` must detect are logged by that real
+/// upstream code at `debug` level (`frozen::state::FrozenState::handle_packet`'s fallback
+/// `log::debug!("Message: {msg}")` branch), and skipping them by default would silently defeat
+/// that detection. No other subcommand ever logs under the `opensleep::frozen` target (they use
+/// this binary's own `crate::frozen_ops`/`crate::link` modules instead), so this has no effect on
+/// them.
+pub fn init_logging(verbose: bool) {
+    use std::io::Write as _;
+
+    let default_level = if verbose { "debug" } else { "info" };
+    env_logger::Builder::from_env(env_logger::Env::default().default_filter_or(default_level))
+        .filter_module("opensleep::frozen", log::LevelFilter::Debug)
+        .format(|buf, record| {
+            let target = record.target();
+            let message = record.args().to_string();
+            crate::log_tap::observe(target, &message);
+            writeln!(
+                buf,
+                "[{} {:5} {target}] {message}",
+                buf.timestamp(),
+                record.level()
+            )
+        })
+        .init();
+}
diff --git a/src/bin/opensleep-diagnostic/cli.rs b/src/bin/opensleep-diagnostic/cli.rs
new file mode 100644
index 0000000..1e767be
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/cli.rs
@@ -0,0 +1,288 @@
+//! CLI surface. Every flag here maps to a fixed, validated field -- there is no flag that accepts
+//! a raw opcode, a raw frame, or an arbitrary absolute temperature target. Side selection is a
+//! closed `ValueEnum`; the cooling delta and duration are validated in `cool_test.rs` against
+//! hard-coded maximums that no flag can override.
+
+use clap::{Parser, Subcommand, ValueEnum};
+use opensleep::common::packet::BedSide;
+
+/// Staged, Frozen-only hardware diagnostic for an Eight Sleep Pod 3 Hub. Every subcommand except
+/// `frozen-prime-opensleep-init` never runs normal OpenSleep, MQTT, profiles, Sensor management,
+/// LED management, or scheduled priming -- `frozen-prime-opensleep-init` is the one deliberate
+/// exception: it reuses the real, unmodified upstream initialization/manager code (see that
+/// module's docs) rather than the diagnostic's own reimplemented transport.
+#[derive(Parser, Debug)]
+#[command(name = "opensleep-diagnostic", version, about, long_about = None)]
+pub struct Cli {
+    #[command(subcommand)]
+    pub command: Commands,
+}
+
+#[derive(Subcommand, Debug, Clone)]
+pub enum Commands {
+    /// Read-only-effect Frozen probe: safe with the cover disconnected and no water.
+    FrozenPassive(PassiveArgs),
+    /// Intentionally activates one cooling channel. Requires a filled, connected hydraulic loop.
+    FrozenCoolTest(CoolTestArgs),
+    /// Independent fast-path: disable both sides and assert subsystem reset, then exit.
+    EmergencyStop(EmergencyArgs),
+    /// Intentionally fills an empty hydraulic loop by sending Prime exactly once, via the
+    /// diagnostic's own reimplemented transport and reset sequence. Requires a connected cover
+    /// with an empty/partially-filled reservoir topped up with water.
+    FrozenPrimeTest(PrimeTestArgs),
+    /// Intentionally fills an empty hydraulic loop by sending Prime exactly once, via the real,
+    /// unmodified upstream OpenSleep initialization and Frozen manager code (not a reimplemented
+    /// transport). Requires a connected cover with an empty/partially-filled reservoir topped up
+    /// with water. See `prime_opensleep_init` module docs and SAFETY.md for how this differs from
+    /// `frozen-prime-test`.
+    #[command(name = "frozen-prime-opensleep-init")]
+    FrozenPrimeOpenSleepInit(PrimeOpenSleepInitArgs),
+}
+
+#[derive(ValueEnum, Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Side {
+    Left,
+    Right,
+}
+
+impl From<Side> for BedSide {
+    fn from(s: Side) -> Self {
+        match s {
+            Side::Left => BedSide::Left,
+            Side::Right => BedSide::Right,
+        }
+    }
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct PassiveArgs {
+    /// I2C device used to probe the reset/enable expander (0x20) and LED controller (0x53)
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    /// Serial port for the Frozen subsystem
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    /// Run the known 0x20 reset-expander sequence before the UART tests
+    #[arg(long, default_value_t = false)]
+    pub reset_subsystems: bool,
+
+    /// Allow sending JumpToFirmware if Frozen is found in its bootloader. Without this flag,
+    /// bootloader-mode Frozen is reported as such and the run stops there.
+    #[arg(long, default_value_t = false)]
+    pub allow_firmware_jump: bool,
+
+    /// How long to poll GetTemperatures (once per second) after the safety-off commands
+    #[arg(long, default_value_t = 15)]
+    pub duration_seconds: u64,
+
+    /// Write the structured result summary as JSON to this path
+    #[arg(long, value_name = "PATH")]
+    pub json_output: Option<String>,
+
+    /// Write decoded telemetry samples as CSV to this path
+    #[arg(long, value_name = "PATH")]
+    pub csv_output: Option<String>,
+
+    /// Verbose logging: raw TX/RX frame hex and decoded packets
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes; print every command that would be sent against a mocked
+    /// Frozen device instead
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct CoolTestArgs {
+    /// Which single cooling channel to enable. Exactly one side per invocation; the other side
+    /// is kept explicitly disabled for the whole run.
+    #[arg(long, value_enum)]
+    pub side: Side,
+
+    /// Cooling delta below the measured baseline water temperature, in degrees C. Clamped to a
+    /// hard maximum of 2.0C by `safety::FrozenAction::enable_cooling`; no flag can raise that
+    /// maximum.
+    #[arg(long, default_value_t = 1.0)]
+    pub delta_c: f64,
+
+    /// Active-phase duration in seconds. Defaults to a conservative 10 seconds for a first test;
+    /// hard-capped at 30 seconds regardless -- no flag can raise that cap.
+    #[arg(long, default_value_t = 10)]
+    pub duration_seconds: u64,
+
+    /// Required: operator declares the hydraulic cover is connected
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_hydraulics_connected: bool,
+
+    /// Required: operator declares the water loop is filled
+    #[arg(long, default_value_t = false)]
+    pub confirm_water_loop_filled: bool,
+
+    /// Required: operator declares there are no visible leaks
+    #[arg(long, default_value_t = false)]
+    pub confirm_no_visible_leaks: bool,
+
+    /// Required: operator explicitly confirms this is an active (actuating) test
+    #[arg(long, default_value_t = false)]
+    pub confirm_active_test: bool,
+
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    #[arg(long, value_name = "PATH")]
+    pub json_output: Option<String>,
+
+    #[arg(long, value_name = "PATH")]
+    pub csv_output: Option<String>,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes; run the full preflight/confirmation/reporting logic against
+    /// a mocked Frozen device instead. The interactive typed-phrase confirmation is still
+    /// required unless stdin is not a TTY.
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+
+    /// Testing/CI escape hatch only: skips the interactive typed-phrase confirmations even when
+    /// stdin is a TTY, by supplying the phrases directly. Never documented as a normal operator
+    /// flag in RUN_ON_POD.md.
+    #[arg(long, hide = true)]
+    pub assume_interactive_phrase: Option<String>,
+    #[arg(long, hide = true)]
+    pub assume_start_phrase: Option<String>,
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct PrimeTestArgs {
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    /// Maximum supervised observation window in seconds. Minimum 5, hard-capped at 60 -- no flag
+    /// can raise that cap. If firmware reports priming completed earlier, the test stops early.
+    #[arg(long, default_value_t = 30)]
+    pub duration_seconds: u64,
+
+    /// Required: operator declares the hydraulic cover is connected
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_hydraulics_connected: bool,
+
+    /// Required: operator declares the reservoir has been filled (or topped up) with water
+    #[arg(long, default_value_t = false)]
+    pub confirm_reservoir_filled: bool,
+
+    /// Required: operator declares the cover's hydraulic loop is empty or needs priming
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_loop_needs_priming: bool,
+
+    /// Required: operator declares there are no visible leaks
+    #[arg(long, default_value_t = false)]
+    pub confirm_no_visible_leaks: bool,
+
+    /// Required: operator explicitly confirms this is an active (actuating) test
+    #[arg(long, default_value_t = false)]
+    pub confirm_active_test: bool,
+
+    #[arg(long, value_name = "PATH")]
+    pub json_output: Option<String>,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes; run the full preflight/confirmation/reporting logic against
+    /// a mocked Frozen device instead. The interactive typed-phrase confirmations are still
+    /// required unless stdin is not a TTY.
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+
+    /// Testing/CI escape hatch only: skips the interactive typed-phrase confirmations even when
+    /// stdin is a TTY, by supplying the phrases directly. Never documented as a normal operator
+    /// flag in RUN_ON_POD.md.
+    #[arg(long, hide = true)]
+    pub assume_interactive_phrase: Option<String>,
+    #[arg(long, hide = true)]
+    pub assume_start_phrase: Option<String>,
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct PrimeOpenSleepInitArgs {
+    /// Required: operator declares the hydraulic cover is connected
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_hydraulics_connected: bool,
+
+    /// Required: operator declares the reservoir has been filled (or topped up) with water
+    #[arg(long, default_value_t = false)]
+    pub confirm_reservoir_filled: bool,
+
+    /// Required: operator declares the cover's hydraulic loop is empty or needs priming
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_loop_needs_priming: bool,
+
+    /// Required: operator declares there are no visible leaks
+    #[arg(long, default_value_t = false)]
+    pub confirm_no_visible_leaks: bool,
+
+    /// Required: operator explicitly confirms this is an active (actuating) test
+    #[arg(long, default_value_t = false)]
+    pub confirm_active_test: bool,
+
+    #[arg(long, value_name = "PATH")]
+    pub json_output: Option<String>,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes: skip real OpenSleep initialization entirely and only
+    /// validate confirmations/arguments. Unlike this binary's other --dry-run modes, this cannot
+    /// run the real, unmodified upstream reset/manager code against a mock -- that code hardcodes
+    /// real serial ports and I2C devices and has no transport abstraction to substitute one into.
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+
+    /// Minimal startup mode: instead of the full upstream reset (ResetController) or the previous
+    /// --preserve-boot-state behavior, release Frozen from reset by pulsing only bit 1 of I2C
+    /// expander register 0x02 low->high->low (assert then release, each a read-modify-write that
+    /// preserves every other bit), never writing registers 0x06/0x07. This replaces both the
+    /// global OpenSleep reset and --preserve-boot-state; it does not call
+    /// opensleep::reset::ResetController and does not run the real upstream Frozen or Sensor
+    /// manager tasks.
+    #[arg(long, default_value_t = false)]
+    pub release_frozen_only: bool,
+
+    /// Testing/CI escape hatch only: skips the interactive typed-phrase confirmations even when
+    /// stdin is a TTY, by supplying the phrases directly. Never documented as a normal operator
+    /// flag in RUN_ON_POD.md.
+    #[arg(long, hide = true)]
+    pub assume_interactive_phrase: Option<String>,
+    #[arg(long, hide = true)]
+    pub assume_start_phrase: Option<String>,
+    /// Testing/CI escape hatch only: supplies the "RESERVOIR INDICATOR IS STILL WORKING"
+    /// confirmation phrase required immediately before Prime in --release-frozen-only mode.
+    #[arg(long, hide = true)]
+    pub assume_reservoir_phrase: Option<String>,
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct EmergencyArgs {
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes; print what would be sent instead
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+}
diff --git a/src/bin/opensleep-diagnostic/confirm.rs b/src/bin/opensleep-diagnostic/confirm.rs
new file mode 100644
index 0000000..9c6296b
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/confirm.rs
@@ -0,0 +1,34 @@
+//! Shared interactive typed-phrase confirmation, used by every actuating (Prime-sending) mode.
+
+use std::io::IsTerminal;
+
+/// Reads and exactly matches a confirmation phrase. `assume` (test/CI only, hidden CLI flag)
+/// bypasses the actual stdin read but not the exact-match check itself. Per spec, the check is
+/// skipped entirely (treated as satisfied) when stdin is not a TTY.
+pub fn confirm_phrase(assume: Option<String>, expected: &str, prompt: &str) -> bool {
+    if let Some(supplied) = assume {
+        return supplied == expected;
+    }
+    if !std::io::stdin().is_terminal() {
+        log::info!("stdin is not a TTY; skipping interactive confirmation for: {prompt}");
+        return true;
+    }
+    eprint!("{prompt}");
+    let mut line = String::new();
+    if std::io::stdin().read_line(&mut line).is_err() {
+        return false;
+    }
+    line.trim_end_matches(['\n', '\r']) == expected
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn assumed_phrase_must_match_exactly() {
+        assert!(confirm_phrase(Some("X".to_string()), "X", ""));
+        assert!(!confirm_phrase(Some("x".to_string()), "X", ""));
+        assert!(!confirm_phrase(Some("X ".to_string()), "X", ""));
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/cool_test.rs b/src/bin/opensleep-diagnostic/cool_test.rs
new file mode 100644
index 0000000..ea120c9
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/cool_test.rs
@@ -0,0 +1,1543 @@
+//! `frozen-cool-test`: the one subcommand that intentionally activates a cooling channel. Every
+//! hard limit here (max delta, max duration, baseline range, heatsink ceiling) is a compile-time
+//! constant; no CLI flag can raise any of them. See SAFETY.md for the operator-facing version of
+//! this file's guarantees.
+//!
+//! Safety telemetry (baseline validation and the active-phase per-tick checks) is driven
+//! exclusively by the unsolicited `TemperatureUpdate` push (raw opcode 0x41, the same byte as the
+//! `GetTemperatures` command itself -- Frozen appears to broadcast this on its own schedule,
+//! independent of being polled). The solicited `GetTemperature` reply (opcode 0xC1) is still
+//! requested each tick and, if it decodes, preserved in the report as raw evidence, but it is
+//! never required: real hardware has been observed sending a 14-byte 0xC1 frame, while
+//! `FrozenPacket::parse_get_temperature` (reused unmodified from `opensleep`) requires exactly 27
+//! bytes and so never decodes it. See PROTOCOL_AUDIT.md for the full account.
+
+use std::io::IsTerminal;
+use std::time::Duration;
+
+use opensleep::common::packet::BedSide;
+use opensleep::frozen::FrozenPacket;
+use opensleep::frozen::packet::TemperatureUpdate;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::sync::mpsc;
+use tokio::time::Instant;
+
+use crate::buildinfo::{DIAGNOSTIC_VERSION, kernel_release, source_commit};
+use crate::cli::CoolTestArgs;
+use crate::i2c::{I2cPort, MockI2c, RealI2c, probe_address, run_reset_sequence};
+use crate::link::{FrozenLink, LinkError, PacketOutcome};
+use crate::mock::mock_frozen_link_pair;
+use crate::ownership;
+use crate::report::{
+    AuditEntryJson, ComponentResults, Confirmations, OperatorObservations, Report, TemperatureSampleJson, Verdict,
+};
+use crate::safe_stop::run_safe_stop;
+use crate::safety::{AuditedTransport, FrozenAction, Mode};
+use crate::signals::{StopReason, wait_for_termination_signal};
+use crate::telemetry::{PacketStats, sample_from_get_temperature, sample_from_temperature_update};
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// Hard, non-overridable maximum active duration.
+pub const HARD_MAX_DURATION_SECONDS: u64 = 30;
+/// Conservative baseline/active-phase water temperature envelope: 15-35C. See SAFETY.md for why.
+pub const MIN_WATER_CENTIDEG: i32 = 1500;
+pub const MAX_WATER_CENTIDEG: i32 = 3500;
+/// Heatsink ceiling during the active phase.
+pub const MAX_HEATSINK_CENTIDEG: i32 = 4500;
+/// A single-tick (~1s) water-temperature jump larger than this is treated as implausible/sensor
+/// fault rather than real cooling, since real thermal mass cannot move this fast.
+pub const MAX_PLAUSIBLE_TICK_JUMP_CENTIDEG: i32 = 300;
+pub const BASELINE_MIN_SAMPLES: usize = 5;
+pub const BASELINE_MIN_WINDOW: Duration = Duration::from_secs(5);
+pub const BASELINE_MAX_SPREAD_CENTIDEG: i32 = 300;
+/// No fresh, valid unsolicited `TemperatureUpdate` for longer than this aborts the active phase.
+pub const STALE_TELEMETRY_LIMIT: Duration = Duration::from_secs(2);
+/// How long after the enable command is accepted the selected-side pump is allowed to keep
+/// reporting off/0V before that is treated as an abort condition. Evidence-gated: only fires if a
+/// firmware pump message for our side was actually observed reporting zero voltage -- see
+/// `parse_pump_report`.
+pub const PUMP_CONFIRM_GRACE: Duration = Duration::from_secs(3);
+/// How long after the active phase starts before generic firmware fault keywords (see
+/// `is_generic_fault_message`) are treated as fatal, rather than logged only. Chosen conservatively
+/// (matching `STALE_TELEMETRY_LIMIT`'s magnitude) since no documented firmware startup-timing spec
+/// exists; a short window avoids mistaking benign boot-time chatter right after the enable command
+/// for a real fault.
+pub const FAULT_KEYWORD_GRACE: Duration = Duration::from_secs(2);
+/// Length of each drain window within one ~1-second active-phase/baseline-collection tick.
+const TICK_DRAIN_WINDOW: Duration = Duration::from_millis(900);
+
+const INTERACTIVE_PHRASE: &str = "I CONFIRM THE WATER LOOP IS CONNECTED AND FILLED";
+
+pub async fn run(args: &CoolTestArgs) -> (Report, u8) {
+    if args.duration_seconds > HARD_MAX_DURATION_SECONDS {
+        log::error!(
+            "refusing to run: --duration-seconds {} exceeds the hard maximum of {} (no option can raise this)",
+            args.duration_seconds, HARD_MAX_DURATION_SECONDS
+        );
+        return (refused_report(args, false, "duration exceeds hard maximum"), 30);
+    }
+
+    if !(args.confirm_cover_hydraulics_connected
+        && args.confirm_water_loop_filled
+        && args.confirm_no_visible_leaks
+        && args.confirm_active_test)
+    {
+        log::error!("refusing to run: all four --confirm-* flags are required");
+        return (refused_report(args, false, "missing required confirmation flags"), 30);
+    }
+
+    let interactive_ok = confirm_phrase(
+        args.assume_interactive_phrase.clone(),
+        INTERACTIVE_PHRASE,
+        "Type I CONFIRM THE WATER LOOP IS CONNECTED AND FILLED to continue: ",
+    );
+    if !interactive_ok {
+        log::error!("refusing to run: interactive confirmation phrase was not matched exactly");
+        return (refused_report(args, false, "interactive confirmation phrase mismatch"), 30);
+    }
+
+    if args.dry_run {
+        log::warn!("--dry-run: no I2C or UART writes will be performed; using a mocked Frozen device");
+        let mut i2c = MockI2c::always_succeed();
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "dry-run");
+        let result = run_core(args, &mut i2c, Some(&mut link), true, None).await;
+        drop(link);
+        task.abort();
+        return result;
+    }
+
+    if let Some(early) = refuse_if_owned(args) {
+        return early;
+    }
+
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("failed to open I2C device {}: {e}", args.i2c_device);
+            return (refused_report(args, false, "I2C bus failed to open"), 20);
+        }
+    };
+
+    let mut link = match FrozenLink::<tokio_serial::SerialStream>::open(&args.frozen_port) {
+        Ok(l) => Some(l),
+        Err(e) => {
+            log::error!("failed to open Frozen UART {}: {e}", args.frozen_port);
+            None
+        }
+    };
+
+    run_core(args, &mut i2c, link.as_mut(), false, None).await
+}
+
+fn refuse_if_owned(args: &CoolTestArgs) -> Option<(Report, u8)> {
+    let services = ownership::check_stock_services();
+    let active: Vec<_> = services.iter().filter(|s| s.active).map(|s| s.name.clone()).collect();
+    if !active.is_empty() {
+        log::error!("refusing to run: stock service(s) active: {active:?}");
+        return Some((refused_report(args, false, "stock service(s) active; refusing to run"), 40));
+    }
+    if ownership::device_exists(&args.i2c_device) && ownership::device_is_open_elsewhere(&args.i2c_device) {
+        log::error!("refusing to run: {} appears to be open in another process", args.i2c_device);
+        return Some((refused_report(args, false, "I2C device already open elsewhere"), 40));
+    }
+    if ownership::device_exists(&args.frozen_port) && ownership::device_is_open_elsewhere(&args.frozen_port) {
+        log::error!("refusing to run: {} appears to be open in another process", args.frozen_port);
+        return Some((refused_report(args, false, "Frozen UART already open elsewhere"), 40));
+    }
+    None
+}
+
+/// Reads and exactly matches a confirmation phrase. `assume` (test/CI only, hidden CLI flag)
+/// bypasses the actual stdin read but not the exact-match check itself. Per spec, the check is
+/// skipped entirely (treated as satisfied) when stdin is not a TTY.
+fn confirm_phrase(assume: Option<String>, expected: &str, prompt: &str) -> bool {
+    if let Some(supplied) = assume {
+        return supplied == expected;
+    }
+    if !std::io::stdin().is_terminal() {
+        log::info!("stdin is not a TTY; skipping interactive confirmation for: {prompt}");
+        return true;
+    }
+    eprint!("{prompt}");
+    let mut line = String::new();
+    if std::io::stdin().read_line(&mut line).is_err() {
+        return false;
+    }
+    line.trim_end_matches(['\n', '\r']) == expected
+}
+
+/// Spawns a background thread that reads lines from stdin for as long as the process runs, and
+/// forwards each trimmed line into the returned channel. Returns `None` (no thread spawned) when
+/// stdin is not a TTY, matching every other interactive-input gate in this binary. Only ever
+/// called from `run_core` after every blocking confirmation-phrase read has already completed, so
+/// it never races those reads for the same stdin.
+fn spawn_operator_abort_watcher() -> Option<mpsc::UnboundedReceiver<String>> {
+    if !std::io::stdin().is_terminal() {
+        return None;
+    }
+    let (tx, rx) = mpsc::unbounded_channel();
+    std::thread::spawn(move || {
+        let stdin = std::io::stdin();
+        loop {
+            let mut line = String::new();
+            match stdin.read_line(&mut line) {
+                Ok(0) | Err(_) => break,
+                Ok(_) => {
+                    if tx.send(line.trim().to_string()).is_err() {
+                        break;
+                    }
+                }
+            }
+        }
+    });
+    Some(rx)
+}
+
+/// True if `line` should abort the active test: an explicit operator report of a leak, burning
+/// smell, or abnormal noise, or the literal word ABORT.
+fn is_operator_abort_line(line: &str) -> bool {
+    let lower = line.to_lowercase();
+    lower.contains("leak") || lower.contains("smell") || lower.contains("noise") || lower.trim() == "abort"
+}
+
+/// Parses a firmware pump message for the given side (e.g. `FW: pump[left] slow @ 6.03V 0.17A`,
+/// per the captured evidence in `frozen/command.rs`). Returns `Some(true)` if it reports nonzero
+/// voltage (pump confirmed running), `Some(false)` if it explicitly reports "off" or 0.000000V,
+/// or `None` if this message is not about our side's pump at all.
+fn parse_pump_report(msg: &str, side_word: &str) -> Option<bool> {
+    let lower = msg.to_lowercase();
+    let marker = format!("pump[{side_word}]");
+    let idx = lower.find(&marker)?;
+    let rest = &lower[idx + marker.len()..];
+    if rest.trim_start().starts_with("off") {
+        return Some(false);
+    }
+    let at = rest.find('@')?;
+    let after_at = &rest[at + 1..];
+    let vpos = after_at.find('v')?;
+    let num_str = after_at[..vpos].trim();
+    let voltage: f64 = num_str.parse().ok()?;
+    Some(voltage > 0.0005)
+}
+
+/// True if `msg` names the selected TEC as locked. Matched narrowly (both "tec" and "lock" must
+/// appear) so this does not fire on unrelated messages.
+fn is_tec_locked_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    lower.contains("tec") && lower.contains("lock")
+}
+
+const FAULT_KEYWORDS: [&str; 6] = ["overtemperature", "overcurrent", "shutdown", "fault", "failed", "locked"];
+
+/// Generic firmware-fault keyword scan. Excludes the literal substring "flash locked": that is a
+/// captured, evidenced, benign boot-time firmware message (`frozen/command.rs` source comment,
+/// paired with "cal_info valid"), not an actuator/safety fault, and would otherwise false-trigger
+/// on the word "locked" alone.
+fn is_generic_fault_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    if lower.contains("flash locked") {
+        return false;
+    }
+    FAULT_KEYWORDS.iter().any(|kw| lower.contains(kw))
+}
+
+/// True if a firmware `Message` about the selected water/heatsink sensor is a known, non-fatal
+/// "sensor unavailable" notice (e.g. "FW: [capwater] sensor unavailable", "FW: [flowrate] sensor
+/// unavailable") rather than an active fault. These have been observed to persist with the cover
+/// connected and the reservoir filled; recorded as warnings, never treated as fatal by themselves.
+fn is_known_nonfatal_sensor_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    lower.contains("sensor unavailable")
+}
+
+async fn run_core<T, P>(
+    args: &CoolTestArgs,
+    i2c: &mut P,
+    mut link: Option<&mut FrozenLink<T>>,
+    dry_run: bool,
+    operator_abort_rx_override: Option<mpsc::UnboundedReceiver<String>>,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let side: BedSide = args.side.into();
+    let side_tag = side_word(side);
+    let mut audit = AuditedTransport::new(Mode::CoolTest { side });
+    let mut stats = PacketStats::default();
+    let mut samples: Vec<TemperatureSampleJson> = Vec::new();
+    let mut cr = ComponentResults::default();
+
+    let expander = probe_address(i2c, crate::i2c::RESET_EXPANDER_ADDR);
+    let led = probe_address(i2c, crate::i2c::LED_CONTROLLER_ADDR);
+    if !led.success {
+        log::info!("LED controller unavailable; continuing diagnostic ({})", led.describe());
+    }
+    let (reset_steps, _release) = run_reset_sequence(i2c).await;
+    let subsystem_reset_ok = reset_steps.iter().all(|s| s.success);
+
+    let Some(link) = link.as_deref_mut() else {
+        log::error!("refusing to run active test: Frozen UART is not open");
+        let safe_stop = run_safe_stop::<T, P>(None, &mut audit, Some(i2c)).await;
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, safe_stop, StopReason::PreflightRefused, false,
+            &expander, &led, subsystem_reset_ok, false, false,
+        );
+    };
+
+    let (ping_ok, mode) = crate::frozen_ops::ping(link, &mut audit, COMMAND_TIMEOUT).await;
+    let mut reached_firmware = mode == crate::frozen_ops::DeviceMode::Firmware;
+    if !reached_firmware && mode == crate::frozen_ops::DeviceMode::Bootloader {
+        reached_firmware = crate::frozen_ops::jump_to_firmware_and_wait(link, &mut audit, COMMAND_TIMEOUT).await;
+    }
+
+    // Explicitly disable both sides before doing anything else: the selected side will be the
+    // only one ever enabled below, and the other side is kept disabled for the whole run.
+    for s in [BedSide::Left, BedSide::Right] {
+        let _ = link.send(&mut audit, FrozenAction::safety_off(s), COMMAND_TIMEOUT).await;
+    }
+
+    if !ping_ok || !reached_firmware {
+        log::error!("refusing to run active test: Frozen did not reach application firmware");
+        let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, safe_stop, StopReason::PreflightRefused, false,
+            &expander, &led, subsystem_reset_ok, true, reached_firmware,
+        );
+    }
+
+    // Preflight step 8-11: at least 5 valid samples over at least 5 seconds, from unsolicited
+    // TemperatureUpdate pushes -- see module docs for why the solicited GetTemperature reply is
+    // not relied on here.
+    let baseline_start = Instant::now();
+    let mut baseline_updates: Vec<TemperatureUpdate> = Vec::new();
+    while baseline_updates.len() < BASELINE_MIN_SAMPLES || baseline_start.elapsed() < BASELINE_MIN_WINDOW {
+        if let Err(e) = link.send_only(&mut audit, FrozenAction::get_temperatures()).await {
+            log::error!("failed to send GetTemperatures during baseline collection: {e}");
+            stats.record_timeout();
+        }
+
+        let drain_deadline = Instant::now() + TICK_DRAIN_WINDOW;
+        loop {
+            let remaining = drain_deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            match link.recv(remaining).await {
+                Ok(PacketOutcome::Received(pkt)) => {
+                    stats.record(&pkt);
+                    let elapsed_ms = baseline_start.elapsed().as_millis() as u64;
+                    match pkt {
+                        FrozenPacket::TemperatureUpdate(u) => {
+                            samples.push(
+                                (&sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u))
+                                    .into(),
+                            );
+                            baseline_updates.push(u);
+                        }
+                        // Raw evidence only, per module docs -- never required or used for
+                        // baseline validation.
+                        FrozenPacket::GetTemperature(g) => {
+                            samples.push(
+                                (&sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g))
+                                    .into(),
+                            );
+                        }
+                        _ => {}
+                    }
+                }
+                Ok(PacketOutcome::TimedOut) => break,
+                Ok(PacketOutcome::Closed) => break,
+                Err(e) => {
+                    log::debug!("baseline collection: {e}");
+                    break;
+                }
+            }
+        }
+
+        if baseline_start.elapsed() > BASELINE_MIN_WINDOW * 4 {
+            break; // hard backstop against an unbounded preflight if telemetry never stabilizes
+        }
+    }
+
+    let baseline = match validate_baseline(&baseline_updates, side) {
+        Some(b) => b,
+        None => {
+            log::error!("refusing to run active test: baseline temperature did not pass validation");
+            let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, safe_stop, StopReason::PreflightRefused, false,
+                &expander, &led, subsystem_reset_ok, true, reached_firmware,
+            );
+        }
+    };
+
+    let delta_centideg = (args.delta_c * 100.0).round() as i32;
+    let action = match FrozenAction::enable_cooling(side, baseline as u16, delta_centideg) {
+        Ok(a) => a,
+        Err(e) => {
+            log::error!("refusing to run active test: {e}");
+            let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, safe_stop, StopReason::PreflightRefused, false,
+                &expander, &led, subsystem_reset_ok, true, reached_firmware,
+            );
+        }
+    };
+    let target_centideg = action.target_centideg().unwrap_or(0);
+
+    print_proposed_target(side, baseline, delta_centideg, target_centideg, args.duration_seconds);
+    let final_phrase = format!("START {} COOLING TEST", side_word(side).to_uppercase());
+    let start_ok = confirm_phrase(
+        args.assume_start_phrase.clone(),
+        &final_phrase,
+        &format!("Type {final_phrase} to continue: "),
+    );
+    if !start_ok {
+        log::error!("refusing to run active test: final start phrase was not matched exactly");
+        let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, safe_stop, StopReason::PreflightRefused, false,
+            &expander, &led, subsystem_reset_ok, true, reached_firmware,
+        );
+    }
+
+    // All blocking stdin reads for confirmation phrases are complete by this point, so it is now
+    // safe to start reading stdin in the background for operator-reported abort conditions
+    // without racing the reads above.
+    let mut operator_abort_rx = match operator_abort_rx_override {
+        Some(rx) => Some(rx),
+        None => spawn_operator_abort_watcher(),
+    };
+
+    // Active execution.
+    let send_result = link.send(&mut audit, action, COMMAND_TIMEOUT).await;
+    cr.frozen_command_accepted = match &send_result {
+        Ok(_) => Verdict::Pass,
+        Err(_) => Verdict::Fail,
+    };
+    if send_result.is_ok() {
+        eprintln!(
+            "If you observe a leak, a burning smell, or abnormal noise, type ABORT and press Enter \
+             (or press Ctrl+C) to stop immediately."
+        );
+    }
+    let we_enabled_side = send_result.is_ok();
+
+    let active_start = Instant::now();
+    let duration = Duration::from_secs(args.duration_seconds.min(HARD_MAX_DURATION_SECONDS));
+    let mut last_valid_at = Instant::now();
+    let mut active_left_c: Vec<f64> = Vec::new();
+    let mut active_right_c: Vec<f64> = Vec::new();
+    let mut prev_side_centideg: Option<i32> = None;
+    #[allow(unused_assignments)]
+    let mut stop_reason = StopReason::Normal;
+    let mut telemetry_ok = true;
+    let mut pump_confirmed_running = false;
+    let mut pump_last_report_off = false;
+
+    'active: loop {
+        if active_start.elapsed() >= duration {
+            stop_reason = StopReason::DurationExpired;
+            break;
+        }
+
+        // Best-effort solicited nudge: preserved/logged as raw evidence only if a reply happens
+        // to decode (see module docs). A write failure here is a real UART communication failure
+        // and does abort the run.
+        if let Err(e) = link.send_only(&mut audit, FrozenAction::get_temperatures()).await {
+            log::error!("UART write failure during active phase: {e}");
+            stop_reason = StopReason::UartWriteFailure;
+            telemetry_ok = false;
+            break 'active;
+        }
+
+        let drain_deadline = Instant::now() + TICK_DRAIN_WINDOW;
+        loop {
+            let remaining = drain_deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            tokio::select! {
+                biased;
+                reason = wait_for_termination_signal() => {
+                    stop_reason = reason;
+                    break 'active;
+                }
+                maybe_line = async {
+                    match operator_abort_rx.as_mut() {
+                        Some(rx) => rx.recv().await,
+                        None => std::future::pending().await,
+                    }
+                } => {
+                    match maybe_line {
+                        Some(line) if is_operator_abort_line(&line) => {
+                            log::error!("operator-reported abort: {line:?}");
+                            stop_reason = StopReason::OperatorAbort;
+                            telemetry_ok = false;
+                            break 'active;
+                        }
+                        Some(line) => {
+                            log::info!("ignoring unrecognized operator input during active phase: {line:?}");
+                        }
+                        None => {
+                            // The channel closed (sender dropped, e.g. stdin hit EOF). Stop
+                            // polling it: with `biased` select ordering, a closed channel
+                            // resolves to `None` instantly on every poll, which would otherwise
+                            // starve `link.recv()` below forever and falsely stale out telemetry.
+                            operator_abort_rx = None;
+                        }
+                    }
+                }
+                outcome = link.recv(remaining) => {
+                    match outcome {
+                        Ok(PacketOutcome::Received(FrozenPacket::TemperatureUpdate(u))) => {
+                            stats.record(&FrozenPacket::TemperatureUpdate(u.clone()));
+                            last_valid_at = Instant::now();
+                            let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                            samples.push((&sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u)).into());
+                            active_left_c.push(crate::telemetry::centideg_to_celsius(u.left_temp));
+                            active_right_c.push(crate::telemetry::centideg_to_celsius(u.right_temp));
+
+                            let side_centideg = match side {
+                                BedSide::Left => u.left_temp,
+                                BedSide::Right => u.right_temp,
+                            };
+                            let heatsink_centideg = u.heatsink_temp;
+
+                            // Isolated behind `catch_unwind`: `evaluate_tick` is a small, pure,
+                            // panic-free-by-design function, but wrapping it means a future bug
+                            // here cannot bring down the whole active loop before safe-stop runs.
+                            match std::panic::catch_unwind(|| evaluate_tick(side_centideg, heatsink_centideg, prev_side_centideg)) {
+                                Ok(Ok(v)) => prev_side_centideg = Some(v),
+                                Ok(Err(reason)) => {
+                                    stop_reason = reason;
+                                    telemetry_ok = false;
+                                    break 'active;
+                                }
+                                Err(_panic) => {
+                                    log::error!("panic while evaluating a temperature sample; stopping safely");
+                                    stop_reason = StopReason::Panic;
+                                    telemetry_ok = false;
+                                    break 'active;
+                                }
+                            }
+                        }
+                        Ok(PacketOutcome::Received(FrozenPacket::GetTemperature(g))) => {
+                            // Raw evidence only -- see module docs; never gates a decision.
+                            stats.record(&FrozenPacket::GetTemperature(g.clone()));
+                            let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                            samples.push((&sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g)).into());
+                        }
+                        Ok(PacketOutcome::Received(FrozenPacket::Message(m))) => {
+                            stats.record(&FrozenPacket::Message(m.clone()));
+                            if let Some(running) = parse_pump_report(&m, side_tag) {
+                                pump_confirmed_running |= running;
+                                pump_last_report_off = !running;
+                            }
+                            if is_tec_locked_message(&m) {
+                                log::error!("firmware reported the selected TEC locked: {m:?}");
+                                stop_reason = StopReason::TecLocked;
+                                telemetry_ok = false;
+                                break 'active;
+                            }
+                            if is_known_nonfatal_sensor_message(&m) {
+                                log::warn!("firmware sensor-unavailable message (non-fatal): {m:?}");
+                            } else if active_start.elapsed() > FAULT_KEYWORD_GRACE && is_generic_fault_message(&m) {
+                                log::error!("firmware fault message during active phase: {m:?}");
+                                stop_reason = StopReason::FirmwareFaultMessage;
+                                telemetry_ok = false;
+                                break 'active;
+                            }
+                        }
+                        Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((s, target)))) => {
+                            stats.record(&FrozenPacket::TargetUpdate((s, target.clone())));
+                            if s == side && we_enabled_side && !target.enabled {
+                                log::error!("Frozen disabled the selected side unexpectedly");
+                                stop_reason = StopReason::TargetDisabledUnexpectedly;
+                                telemetry_ok = false;
+                                break 'active;
+                            }
+                        }
+                        Ok(PacketOutcome::Received(other)) => {
+                            stats.record(&other);
+                        }
+                        Ok(PacketOutcome::TimedOut) => break, // nothing more buffered right now
+                        Ok(PacketOutcome::Closed) => {
+                            stop_reason = StopReason::TelemetryLost;
+                            telemetry_ok = false;
+                            break 'active;
+                        }
+                        Err(LinkError::ReadIo(e)) => {
+                            log::error!("UART read failure during active phase: {e}");
+                            stop_reason = StopReason::UartReadFailure;
+                            telemetry_ok = false;
+                            break 'active;
+                        }
+                        Err(e) => {
+                            // WriteIo/Safety are structurally unreachable from `recv()` (it never
+                            // writes or checks the audit); handled generically for exhaustiveness.
+                            log::error!("unexpected error draining telemetry: {e}");
+                        }
+                    }
+                }
+            }
+        }
+
+        if active_start.elapsed() >= PUMP_CONFIRM_GRACE && !pump_confirmed_running && pump_last_report_off {
+            log::error!(
+                "selected-side pump still reports off/0V {:?} after the target was enabled",
+                active_start.elapsed()
+            );
+            stop_reason = StopReason::PumpNotConfirmedRunning;
+            telemetry_ok = false;
+            break 'active;
+        }
+
+        if last_valid_at.elapsed() > STALE_TELEMETRY_LIMIT {
+            stop_reason = StopReason::TelemetryStale;
+            telemetry_ok = false;
+            break 'active;
+        }
+    }
+
+    cr.telemetry_remained_valid = if telemetry_ok && !samples.is_empty() { Verdict::Pass } else { Verdict::Fail };
+
+    let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+    cr.emergency_shutdown = if safe_stop.fully_succeeded() { Verdict::Pass } else { Verdict::Fail };
+
+    // Pump/fan/TEC results: only ever PASS from decoded evidence, never from "the command was
+    // accepted" (`cr.frozen_command_accepted` is tracked entirely separately above).
+    let side_bracket_tag = format!("[{side_tag}]");
+    let fan_seen = stats.messages.iter().any(|m| m.to_lowercase().contains("fan") && m.contains(&side_bracket_tag));
+    cr.pump_operation = if pump_confirmed_running {
+        Verdict::Pass
+    } else if pump_last_report_off {
+        Verdict::Fail
+    } else {
+        Verdict::Unverified
+    };
+    cr.fan_operation = if fan_seen { Verdict::Pass } else { Verdict::Unverified };
+
+    cr.tec_cooling_operation = tec_trend_verdict(side, &active_left_c, &active_right_c, telemetry_ok);
+
+    cr.overall_selected_side_result = overall_verdict(&cr);
+
+    let overall_pass = cr.overall_selected_side_result == Verdict::Pass;
+
+    finish(
+        args, dry_run, &audit, &stats, samples, cr, safe_stop, stop_reason, overall_pass,
+        &expander, &led, subsystem_reset_ok, true, reached_firmware,
+    )
+}
+
+/// Pure, panic-free-by-design per-tick range/plausibility check, isolated so it can be run behind
+/// `catch_unwind` in the active loop above. Operates on already-extracted centidegree values so
+/// it applies identically to `TemperatureUpdate` (the primary safety signal) and, if ever needed,
+/// `GetTemperature`.
+fn evaluate_tick(side_centideg: u16, heatsink_centideg: u16, prev_side_centideg: Option<i32>) -> Result<i32, StopReason> {
+    let side_centideg = side_centideg as i32;
+    if !(MIN_WATER_CENTIDEG..=MAX_WATER_CENTIDEG).contains(&side_centideg) {
+        return Err(StopReason::TemperatureRangeExceeded);
+    }
+    if (heatsink_centideg as i32) > MAX_HEATSINK_CENTIDEG {
+        return Err(StopReason::HeatsinkLimitExceeded);
+    }
+    if let Some(prev) = prev_side_centideg
+        && (side_centideg - prev).abs() > MAX_PLAUSIBLE_TICK_JUMP_CENTIDEG
+    {
+        return Err(StopReason::ImplausibleTemperatureChange);
+    }
+    Ok(side_centideg)
+}
+
+fn tec_trend_verdict(side: BedSide, left: &[f64], right: &[f64], telemetry_ok: bool) -> Verdict {
+    if !telemetry_ok {
+        return Verdict::Fail;
+    }
+    let series = match side {
+        BedSide::Left => left,
+        BedSide::Right => right,
+    };
+    if series.len() < 2 {
+        return Verdict::Unverified;
+    }
+    let first = series[0];
+    let last = *series.last().unwrap();
+    // A short test may not appreciably change water temperature (spec's own caveat): only a
+    // measurable, sustained decrease counts as PASS; anything else is UNVERIFIED, never FAIL,
+    // since the absence of a visible drop is not proof the TEC/pump/fan chain doesn't work.
+    if last <= first - 0.10 {
+        Verdict::Pass
+    } else {
+        Verdict::Unverified
+    }
+}
+
+fn overall_verdict(cr: &ComponentResults) -> Verdict {
+    if cr.frozen_command_accepted != Verdict::Pass
+        || cr.telemetry_remained_valid != Verdict::Pass
+        || cr.emergency_shutdown != Verdict::Pass
+    {
+        return Verdict::Fail;
+    }
+    if cr.pump_operation == Verdict::Fail || cr.fan_operation == Verdict::Fail || cr.tec_cooling_operation == Verdict::Fail {
+        return Verdict::Fail;
+    }
+    if cr.pump_operation == Verdict::Pass && cr.fan_operation != Verdict::Unknown && cr.tec_cooling_operation != Verdict::Unknown {
+        Verdict::Pass
+    } else {
+        Verdict::Inconclusive
+    }
+}
+
+fn validate_baseline(samples: &[TemperatureUpdate], side: BedSide) -> Option<i32> {
+    if samples.len() < BASELINE_MIN_SAMPLES {
+        log::error!("baseline validation failed: only {} samples (need >= {BASELINE_MIN_SAMPLES})", samples.len());
+        return None;
+    }
+    let values: Vec<i32> = samples
+        .iter()
+        .map(|u| match side { BedSide::Left => u.left_temp, BedSide::Right => u.right_temp } as i32)
+        .collect();
+    let heatsinks: Vec<i32> = samples.iter().map(|u| u.heatsink_temp as i32).collect();
+
+    for &v in values.iter().chain(heatsinks.iter()) {
+        if v == 0 || v == 0xFFFF {
+            log::error!("baseline validation failed: sentinel temperature value {v}");
+            return None;
+        }
+        if !(MIN_WATER_CENTIDEG..=MAX_WATER_CENTIDEG).contains(&v) {
+            log::error!("baseline validation failed: value {v} outside {MIN_WATER_CENTIDEG}-{MAX_WATER_CENTIDEG}");
+            return None;
+        }
+    }
+
+    let min = *values.iter().min().unwrap();
+    let max = *values.iter().max().unwrap();
+    if max - min > BASELINE_MAX_SPREAD_CENTIDEG {
+        log::error!("baseline validation failed: samples inconsistent (spread {} > {BASELINE_MAX_SPREAD_CENTIDEG})", max - min);
+        return None;
+    }
+
+    let sum: i32 = values.iter().sum();
+    Some(sum / values.len() as i32)
+}
+
+fn print_proposed_target(side: BedSide, baseline_centideg: i32, delta_centideg: i32, target_centideg: u16, duration_s: u64) {
+    let baseline_c = f64::from(baseline_centideg) / 100.0;
+    let delta_c = f64::from(delta_centideg) / 100.0;
+    let target_c = crate::telemetry::centideg_to_celsius(target_centideg);
+    eprintln!("Baseline {} water temperature: {:.2}C", side_word(side), baseline_c);
+    eprintln!("Requested delta:                 -{:.2}C", delta_c);
+    eprintln!("Proposed target:                  {:.2}C", target_c);
+    eprintln!("Maximum duration:                 {duration_s} seconds");
+    eprintln!("Selected side:                    {}", side_word(side).to_uppercase());
+}
+
+fn side_word(side: BedSide) -> &'static str {
+    match side {
+        BedSide::Left => "left",
+        BedSide::Right => "right",
+    }
+}
