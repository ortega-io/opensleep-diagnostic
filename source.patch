+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::report::Verdict;
+    use opensleep::frozen::packet::TemperatureUpdate;
+
+    fn args(dry_run: bool) -> PrimeTestArgs {
+        PrimeTestArgs {
+            i2c_device: "/dev/i2c-1".into(),
+            frozen_port: "/dev/ttyS1".into(),
+            duration_seconds: 8,
+            confirm_cover_hydraulics_connected: true,
+            confirm_reservoir_filled: true,
+            confirm_cover_loop_needs_priming: true,
+            confirm_no_visible_leaks: true,
+            confirm_active_test: true,
+            json_output: None,
+            verbose: false,
+            dry_run,
+            assume_interactive_phrase: Some(INTERACTIVE_PHRASE.to_string()),
+            assume_start_phrase: Some(FINAL_PHRASE.to_string()),
+        }
+    }
+
+    // ---- 1-4: Prime is allowed only in frozen-prime-test (already proven at the transport
+    // layer by safety::tests::prime_is_refused_outside_prime_test_mode /
+    // prime_test_mode_allows_prime_exactly_once / prime_test_mode_never_allows_an_enabled_target,
+    // and at the source level by guardrail_tests::frozen_action_prime_is_referenced_only_in_safety_and_prime_test). ----
+
+    #[test]
+    fn prime_action_serializes_to_the_exact_source_evidenced_frame() {
+        // Ties this file directly to frozen/command.rs's own test_prime fixture: 7E 01 52 B6 2B.
+        let bytes = FrozenAction::prime().to_command().to_bytes();
+        assert_eq!(bytes, vec![0x7E, 0x01, 0x52, 0xB6, 0x2B]);
+    }
+
+    // ---- 5-6: Prime sent at most once; no automatic retry. ----
+
+    #[tokio::test]
+    async fn dry_run_sends_prime_exactly_once() {
+        let (report, _code) = run(&args(true)).await;
+        assert_eq!(report.prime_command_count, 1);
+    }
+
+    // ---- 7: enabled temperature targets cannot be constructed in prime mode (also see
+    // safety::tests::prime_test_mode_never_allows_an_enabled_target at the transport layer). ----
+
+    #[tokio::test]
+    async fn dry_run_never_enables_a_target() {
+        let (report, _code) = run(&args(true)).await;
+        assert_eq!(report.enabled_target_command_count, 0);
+        assert!(report.outgoing_commands.iter().all(|c| c.enabled != Some(true)));
+    }
+
+    // ---- 8: all confirmation flags are mandatory. ----
+
+    #[tokio::test]
+    async fn refuses_without_all_confirmation_flags() {
+        let mut a = args(true);
+        a.confirm_no_visible_leaks = false;
+        let (report, code) = run(&a).await;
+        assert_eq!(code, 30);
+        assert!(!report.overall_pass);
+        assert_eq!(report.prime_command_count, 0);
+    }
+
+    // ---- 9: incorrect interactive confirmation is rejected. ----
+
+    #[tokio::test]
+    async fn refuses_when_interactive_phrase_is_wrong() {
+        let mut a = args(true);
+        a.assume_interactive_phrase = Some("nope".to_string());
+        let (report, code) = run(&a).await;
+        assert_eq!(code, 30);
+        assert!(!report.overall_pass);
+    }
+
+    // ---- 10: duration cannot exceed 60 seconds, and cannot go below 5. ----
+
+    #[tokio::test]
+    async fn refuses_when_duration_exceeds_hard_maximum() {
+        let mut a = args(true);
+        a.duration_seconds = 61;
+        let (_, code) = run(&a).await;
+        assert_eq!(code, 30);
+    }
+
+    #[tokio::test]
+    async fn refuses_when_duration_is_below_minimum() {
+        let mut a = args(true);
+        a.duration_seconds = 4;
+        let (_, code) = run(&a).await;
+        assert_eq!(code, 30);
+    }
+
+    #[test]
+    fn duration_bounds_match_spec() {
+        assert_eq!(HARD_MAX_DURATION_SECONDS, 60);
+        assert_eq!(MIN_DURATION_SECONDS, 5);
+    }
+
+    // ---- 11: Ctrl+C triggers safe-stop (mechanism shared with frozen-cool-test; see that
+    // module's docs for why real signal delivery isn't exercised in this suite). ----
+
+    #[tokio::test]
+    async fn termination_signal_future_does_not_resolve_spuriously() {
+        let result = tokio::time::timeout(Duration::from_millis(150), wait_for_termination_signal()).await;
+        assert!(result.is_err(), "must not resolve without a real signal");
+    }
+
+    // ---- 12: timeout (duration expiry) triggers safe-stop. ----
+
+    #[tokio::test]
+    async fn active_phase_stops_at_duration_expired_and_still_runs_safe_stop() {
+        let mut a = args(true);
+        a.duration_seconds = MIN_DURATION_SECONDS;
+        let (report, _) = run(&a).await;
+        assert!(
+            report.stop_reason.contains("duration")
+                || report.stop_reason == StopReason::DurationExpired.to_string()
+                || report.stop_reason == StopReason::PrimingCompleted.to_string()
+        );
+        assert!(report.safe_stop.is_some());
+        assert!(report.safe_stop.unwrap().i2c_reset_asserted);
+    }
+
+    /// A fake device that acks Ping/JumpToFirmware/GetHardwareInfo/GetFirmware/SetTargetTemperature
+    /// and always pushes an unsolicited TemperatureUpdate for GetTemperatures requests (so
+    /// staleness never fires on its own), acks Prime with PrimingStarted, and then -- once primed
+    /// -- goes completely silent (closes nothing, just stops answering), simulating a UART/
+    /// telemetry failure during the active phase.
+    fn spawn_device_that_goes_silent_after_prime(mut device_side: tokio::io::DuplexStream) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut primed = false;
+            let mut count: u8 = 0;
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        if primed {
+                            // Silent: acknowledge nothing further, simulating a dead link.
+                            continue;
+                        }
+                        let response = match opcode {
+                            0x01 => Some(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x02 => None,
+                            0x04 => Some(opensleep::common::codec::command(vec![0x84])),
+                            0x10 => Some(opensleep::common::codec::command(vec![0x90, 0x00])),
+                            0x41 => {
+                                count = count.wrapping_add(1);
+                                Some(opensleep::common::codec::command(vec![
+                                    0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, count,
+                                ]))
+                            }
+                            0x40 if payload.len() == 5 => Some(opensleep::common::codec::command(vec![
+                                0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                            ])),
+                            0x52 => {
+                                primed = true;
+                                Some(opensleep::common::codec::command(vec![0xD2, 0x00]))
+                            }
+                            _ => None,
+                        };
+                        if let Some(resp) = response
+                            && device_side.write_all(&resp).await.is_err()
+                        {
+                            break;
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
+
+    // ---- 13: UART failure triggers safe-stop. ----
+
+    #[tokio::test]
+    async fn going_silent_after_prime_triggers_safe_stop() {
+        let (client, device) = tokio::io::duplex(8192);
+        let device_task = spawn_device_that_goes_silent_after_prime(device);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+        let capture: crate::io_logging::RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+
+        let mut a = args(false);
+        a.duration_seconds = 10;
+        let (report, _code) = run_core(&a, &mut i2c, Some(&mut link), false, &capture).await;
+
+        assert_eq!(report.prime_command_count, 1);
+        assert!(
+            report.stop_reason == StopReason::TelemetryStale.to_string()
+                || report.stop_reason == StopReason::TelemetryLost.to_string()
+                || report.stop_reason == StopReason::UartReadFailure.to_string()
+        );
+        assert!(report.safe_stop.unwrap().i2c_reset_asserted);
+
+        drop(link);
+        device_task.abort();
+    }
+
+    // ---- 14: internal task failure triggers safe-stop -- practical limitation matches
+    // frozen-cool-test's: no panic-injection hook exists to force a real panic safely from a
+    // test. evaluate_temperatures itself is covered directly below as the thing catch_unwind
+    // wraps. ----
+
+    #[test]
+    fn evaluate_temperatures_accepts_plausible_values() {
+        assert!(evaluate_temperatures(2450, 2460, 2600).is_ok());
+    }
+
+    #[test]
+    fn evaluate_temperatures_rejects_out_of_range_water() {
+        assert_eq!(evaluate_temperatures(100, 2460, 2600), Err(StopReason::TemperatureRangeExceeded));
+        assert_eq!(evaluate_temperatures(2450, 100, 2600), Err(StopReason::TemperatureRangeExceeded));
+    }
+
+    #[test]
+    fn evaluate_temperatures_rejects_heatsink_over_limit() {
+        assert_eq!(evaluate_temperatures(2450, 2460, 5000), Err(StopReason::HeatsinkLimitExceeded));
+    }
+
+    // ---- 15-17: safe-stop disables both targets three times and asserts 0x20 reset (mode-
+    // agnostic mechanism, already proven in safe_stop::tests); failed reset causes a nonzero exit. ----
+
+    #[tokio::test]
+    async fn failed_i2c_reset_causes_a_nonzero_exit_code() {
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c { fail_all_writes: true, ..MockI2c::always_succeed() };
+        let capture: crate::io_logging::RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+
+        let mut a = args(false);
+        a.duration_seconds = MIN_DURATION_SECONDS;
+        let (report, code) = run_core(&a, &mut i2c, Some(&mut link), false, &capture).await;
+
+        assert_ne!(code, 0);
+        assert!(!report.safe_stop.unwrap().i2c_reset_asserted);
+
+        drop(link);
+        task.abort();
+    }
+
+    // ---- 18-20: 0x53 failure remains nonfatal; the Sensor UART, MQTT, and the normal config file
+    // are never referenced -- covered by i2c::tests and guardrail_tests (which scan this file too). ----
+
+    #[tokio::test]
+    async fn dry_run_completes_despite_the_led_controller_probe_failing() {
+        // MockI2c::always_succeed deliberately fails the 0x53 read (ENXIO), mirroring confirmed
+        // hardware; this proves it doesn't block frozen-prime-test either.
+        let (report, _code) = run(&args(true)).await;
+        assert!(!report.led_controller_probe_ok);
+        assert!(report.reset_expander_probe_ok);
+    }
+
+    // ---- 21-22: capwater/flowrate unavailable are recognized as warnings, not preflight failures. ----
+
+    #[test]
+    fn capwater_and_flowrate_unavailable_are_recognized_as_nonfatal_sensor_messages() {
+        assert!(is_known_nonfatal_sensor_message("FW: [capwater] sensor unavailable"));
+        assert!(is_known_nonfatal_sensor_message("FW: [flowrate] sensor unavailable"));
+    }
+
+    // ---- 23: control_error_c does not cause an automatic abort. ----
+
+    #[test]
+    fn evaluate_temperatures_has_no_control_error_parameter_to_gate_on() {
+        // Same structural proof as cool_test.rs: evaluate_temperatures doesn't even take this
+        // field, which is itself the proof it can never gate a decision.
