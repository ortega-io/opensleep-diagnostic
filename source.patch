new file mode 100644
index 0000000..2cf2571
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/frozen_hold.rs
@@ -0,0 +1,1014 @@
+//! `frozen-hold-start`/`frozen-hold-stop`/`frozen-hold-status`: persistent, firmware-owned
+//! absolute-temperature thermal control.
+//!
+//! `frozen-hold-start` sends one absolute target per side, requires an exact-matching
+//! `TargetUpdate` confirmation for each, and then **exits**. It is a one-shot configuration
+//! transaction, not an observation session: once both targets are confirmed, this process sends
+//! zero further Frozen commands of any kind -- no disable, no `SafetyOff`, no independent shutdown
+//! guard, no `Drop`-based shutdown behavior, no duration timer, no firmware-text interpretation, no
+//! pump/TEC/fan observer, no target-attainment logic, no host thermal watchdog, no reaction to
+//! priming or `tec[...] locked` messages, no UART monitoring, and no reset on exit. Frozen firmware
+//! remains completely responsible for pumps, TECs, PID, fans, solenoids, priming, interlocks,
+//! thermal control, current protection, and firmware safety behavior for as long as the targets
+//! remain enabled -- exactly the way stock OpenSleep's own scheduled `SetTargetTemperature` calls
+//! work (see `opensleep::frozen::manager`), just sent once, explicitly, by an operator instead of a
+//! schedule.
+//!
+//! Unlike `frozen-cool-test`/`frozen-prime-opensleep-init --release-frozen-only`, this mode must
+//! never reset a Frozen that is already responsive -- it may be adjusting targets on a Frozen a
+//! previous `frozen-hold-start` already brought up and is actively regulating. So startup here is
+//! "probe first, reset only if silent": a bounded, reset-free Ping probe runs first
+//! ([`probe_responsive_without_reset`]); only if that finds nothing does this fall back to the
+//! already-audited narrow startup/reset mechanism ([`crate::frozen_startup::start_frozen_narrow`]).
+//! Never reintroduces the historical whole-register PCAL initialization, and never writes register
+//! `0x07` -- exactly the same guarantee every other mode in this binary already holds.
+//!
+//! `frozen-hold-stop` explicitly disables both sides and requires confirmation of both before
+//! exiting successfully -- it Pings first (never to justify a reset, only to log responsiveness),
+//! never pulses Frozen reset as part of an ordinary stop, and never parses firmware message text.
+//!
+//! `frozen-hold-status` is strictly non-controlling: Ping/GetTemperatures only, safe to run at any
+//! time -- including while `frozen-hold-start`'s targets remain active -- since it never sends
+//! `SetTargetTemperature` (enabled or disabled), never resets Frozen, and never touches PCAL state.
+
+use std::time::Duration;
+
+use opensleep::common::packet::BedSide;
+use opensleep::frozen::FrozenPacket;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::time::Instant;
+
+use crate::buildinfo::{DIAGNOSTIC_VERSION, kernel_release, source_commit};
+use crate::cli::{HoldStartArgs, HoldStatusArgs, HoldStopArgs};
+use crate::frozen_ops;
+use crate::frozen_startup::start_frozen_narrow;
+use crate::i2c::{I2cPort, MockI2c, RealI2c};
+use crate::link::{FrozenLink, PacketOutcome};
+use crate::mock::mock_frozen_link_pair;
+use crate::ownership;
+use crate::report::{AuditEntryJson, Confirmations, HoldResults, Report};
+use crate::safety::{AuditedTransport, FrozenAction, Mode};
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(3);
+/// Per-attempt timeout for the initial, reset-free responsiveness probe.
+const PROBE_TIMEOUT: Duration = Duration::from_secs(2);
+/// How many Ping attempts the reset-free probe makes before concluding Frozen is silent and
+/// falling back to the narrow startup/reset mechanism.
+const PROBE_ATTEMPTS: u32 = 3;
+/// After a send's own reply isn't already the matching confirmation, how much longer to keep
+/// draining packets looking for it.
+const CONFIRM_WINDOW: Duration = Duration::from_secs(3);
+const DISABLE_WAIT: Duration = Duration::from_millis(500);
+const SHUTDOWN_REPEAT_COUNT: usize = 3;
+const SHUTDOWN_BETWEEN_ATTEMPTS_DELAY: Duration = Duration::from_millis(150);
+
+// ================================================================================================
+// frozen-hold-start
+// ================================================================================================
+
+pub async fn run_start(args: &HoldStartArgs) -> (Report, u8) {
+    let (left_c, right_c) = match resolve_requested_targets_c(args) {
+        Ok(t) => t,
+        Err(msg) => {
+            log::error!("frozen-hold-start: {msg}");
+            return (refused_start_report(args, &msg), 2);
+        }
+    };
+    let left_action = match hold_target_action(BedSide::Left, left_c) {
+        Ok(a) => a,
+        Err(msg) => {
+            log::error!("frozen-hold-start: {msg}");
+            return (refused_start_report(args, &msg), 2);
+        }
+    };
+    let right_action = match hold_target_action(BedSide::Right, right_c) {
+        Ok(a) => a,
+        Err(msg) => {
+            log::error!("frozen-hold-start: {msg}");
+            return (refused_start_report(args, &msg), 2);
+        }
+    };
+
+    if args.dry_run {
+        log::warn!("--dry-run: no I2C or UART writes will be performed; using a mocked Frozen device");
+        let mut i2c = MockI2c::always_succeed();
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "dry-run");
+        let result = run_start_core(args, &mut i2c, &mut link, true, left_c, right_c, left_action, right_action).await;
+        drop(link);
+        task.abort();
+        return result;
+    }
+
+    if let Some(reason) = refuse_if_owned(Some(&args.i2c_device), &args.frozen_port) {
+        log::error!("frozen-hold-start: refusing to run: {reason}");
+        return (refused_start_report(args, &reason), 40);
+    }
+
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("frozen-hold-start: failed to open I2C device {}: {e}", args.i2c_device);
+            return (refused_start_report(args, "I2C bus failed to open"), 20);
+        }
+    };
+    let mut link = match FrozenLink::<tokio_serial::SerialStream>::open(&args.frozen_port) {
+        Ok(l) => l,
+        Err(e) => {
+            log::error!("frozen-hold-start: failed to open Frozen UART {}: {e}", args.frozen_port);
+            return (refused_start_report(args, "Frozen UART failed to open"), 20);
+        }
+    };
+
+    run_start_core(args, &mut i2c, &mut link, false, left_c, right_c, left_action, right_action).await
+}
+
+/// `--target-c` sets the same absolute target on both sides and cannot be combined with
+/// `--left-target-c`/`--right-target-c`; those two must both be supplied together. No baseline
+/// measurement or delta calculation is involved in either form.
+fn resolve_requested_targets_c(args: &HoldStartArgs) -> Result<(f64, f64), String> {
+    match (args.target_c, args.left_target_c, args.right_target_c) {
+        (Some(_), Some(_), _) | (Some(_), _, Some(_)) => {
+            Err("--target-c cannot be combined with --left-target-c/--right-target-c".to_string())
+        }
+        (Some(t), None, None) => Ok((t, t)),
+        (None, Some(l), Some(r)) => Ok((l, r)),
+        (None, Some(_), None) | (None, None, Some(_)) => {
+            Err("--left-target-c and --right-target-c must both be supplied together".to_string())
+        }
+        (None, None, None) => Err("one of --target-c or --left-target-c/--right-target-c is required".to_string()),
+    }
+}
+
+/// Converts a requested absolute Celsius target directly to centidegrees (no baseline, no delta)
+/// and validates it via [`FrozenAction::hold_target`] -- the same absolute-range backstop
+/// `frozen-cool-test`'s `--target-c` uses, not a separately invented range.
+fn hold_target_action(side: BedSide, target_c: f64) -> Result<FrozenAction, String> {
+    let target_centideg = (target_c * 100.0).round() as i32;
+    FrozenAction::hold_target(side, target_centideg).map_err(|e| e.to_string())
+}
+
+fn refuse_if_owned(i2c_device: Option<&str>, frozen_port: &str) -> Option<String> {
+    let services = ownership::check_stock_services();
+    let active: Vec<_> = services.iter().filter(|s| s.active).map(|s| s.name.clone()).collect();
+    if !active.is_empty() {
+        return Some(format!("stock service(s) active: {active:?}"));
+    }
+    if let Some(dev) = i2c_device
+        && ownership::device_exists(dev)
+        && ownership::device_is_open_elsewhere(dev)
+    {
+        return Some(format!("{dev} appears to be open in another process"));
+    }
+    if ownership::device_exists(frozen_port) && ownership::device_is_open_elsewhere(frozen_port) {
+        return Some(format!("{frozen_port} appears to be open in another process"));
+    }
+    None
+}
+
+#[allow(clippy::too_many_arguments)]
+async fn run_start_core<T, P>(
+    args: &HoldStartArgs,
+    i2c: &mut P,
+    link: &mut FrozenLink<T>,
+    dry_run: bool,
+    left_c: f64,
+    right_c: f64,
+    left_action: FrozenAction,
+    right_action: FrozenAction,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let mut audit = AuditedTransport::new(Mode::HoldStart);
+
+    let ready = ensure_frozen_ready(i2c, link, &mut audit).await;
+    if !ready.responsive {
+        log::error!("frozen-hold-start: Frozen did not reach application firmware; refusing to send any target");
+        let report = finish_start(
+            args, dry_run, &audit, left_c, right_c, false, false, ready.reset_performed, false,
+            "Frozen not responsive", 21,
+        );
+        return (report, 21);
+    }
+
+    let left_confirmed = send_and_confirm_hold_target(link, &mut audit, BedSide::Left, left_action).await;
+    if !left_confirmed {
+        log::error!("frozen-hold-start: Left target was not confirmed by firmware");
+        let report = finish_start(
+            args, dry_run, &audit, left_c, right_c, false, false, ready.reset_performed, false,
+            "Left target not confirmed", 22,
+        );
+        return (report, 22);
+    }
+
+    let right_confirmed = send_and_confirm_hold_target(link, &mut audit, BedSide::Right, right_action).await;
+    if !right_confirmed {
+        log::error!("frozen-hold-start: Right target was not confirmed by firmware; rolling back Left");
+        rollback_left(link, &mut audit).await;
+        let report = finish_start(
+            args, dry_run, &audit, left_c, right_c, true, false, ready.reset_performed, true,
+            "Right target not confirmed; Left rolled back", 22,
+        );
+        return (report, 22);
+    }
+
+    eprintln!("Frozen thermal control enabled");
+    eprintln!("Left target:  {left_c:.2} C");
+    eprintln!("Right target: {right_c:.2} C");
+    eprintln!("Targets confirmed by firmware");
+    eprintln!("Host control transaction complete");
+    eprintln!("Frozen now owns thermal regulation");
+
+    let report = finish_start(
+        args, dry_run, &audit, left_c, right_c, true, true, ready.reset_performed, false, "", 0,
+    );
+    (report, 0)
+}
+
+struct ReadyOutcome {
+    responsive: bool,
+    reset_performed: bool,
+}
+
+/// Probes for a responsive Frozen without ever pulsing reset; only if that finds nothing does this
+/// fall back to the already-audited narrow startup/reset mechanism. See module docs.
+async fn ensure_frozen_ready<T, P>(i2c: &mut P, link: &mut FrozenLink<T>, audit: &mut AuditedTransport) -> ReadyOutcome
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    if probe_responsive_without_reset(link, audit).await {
+        log::info!("frozen-hold-start: Frozen is already responsive; no reset performed");
+        return ReadyOutcome { responsive: true, reset_performed: false };
+    }
+
+    log::info!(
+        "frozen-hold-start: Frozen did not answer the initial no-reset probe; falling back to the \
+         narrow startup/reset mechanism"
+    );
+    let startup = start_frozen_narrow(i2c, link, audit).await;
+    ReadyOutcome { responsive: startup.started_successfully(), reset_performed: true }
+}
+
+/// Up to [`PROBE_ATTEMPTS`] quick Pings, never touching I2C. A bootloader response is followed by
+/// the ordinary bootloader-to-firmware handoff (`JumpToFirmware`) -- that is not a reset, just the
+/// same transition every other mode in this binary already performs.
+async fn probe_responsive_without_reset<T>(link: &mut FrozenLink<T>, audit: &mut AuditedTransport) -> bool
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    for _ in 0..PROBE_ATTEMPTS {
+        let (ok, mode) = frozen_ops::ping(link, audit, PROBE_TIMEOUT).await;
+        if ok {
+            return match mode {
+                frozen_ops::DeviceMode::Firmware => true,
+                frozen_ops::DeviceMode::Bootloader => frozen_ops::jump_to_firmware_and_wait(link, audit, PROBE_TIMEOUT).await,
+                frozen_ops::DeviceMode::Unknown => false,
+            };
+        }
+    }
+    false
+}
+
+/// Sends `action` and requires an *exact* matching `TargetUpdate(side, enabled=true,
+/// temp=<requested>)` -- the send's own reply may already be it (the normal case); otherwise keeps
+/// draining further packets (which may include firmware `Message`s -- priming text,
+/// `tec[...] locked`, anything -- all silently ignored here) for up to [`CONFIRM_WINDOW`].
+async fn send_and_confirm_hold_target<T>(
+    link: &mut FrozenLink<T>,
+    audit: &mut AuditedTransport,
+    side: BedSide,
+    action: FrozenAction,
+) -> bool
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    let target_centideg = action.target_centideg().expect("hold_target always carries a target");
+    let send_result = link.send(audit, action, COMMAND_TIMEOUT).await;
+    if let Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((s, t)))) = &send_result
+        && *s == side
+        && t.enabled
+        && t.temp == target_centideg
+    {
+        return true;
+    }
+    if send_result.is_err() {
+        return false;
+    }
+
+    let deadline = Instant::now() + CONFIRM_WINDOW;
+    loop {
+        let remaining = deadline.saturating_duration_since(Instant::now());
+        if remaining.is_zero() {
+            return false;
+        }
+        match link.recv(remaining).await {
+            Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((s, t)))) if s == side && t.enabled && t.temp == target_centideg => {
+                return true;
+            }
+            Ok(PacketOutcome::Received(_)) => {}
+            Ok(PacketOutcome::TimedOut) | Ok(PacketOutcome::Closed) | Err(_) => return false,
+        }
+    }
+}
+
+/// Partial-transaction rollback: Left was already confirmed enabled but Right never confirmed, so
+/// disable Left again (best-effort -- this is a failure report either way, not a second success
+/// path requiring its own confirmation).
+async fn rollback_left<T>(link: &mut FrozenLink<T>, audit: &mut AuditedTransport)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    match link.send(audit, FrozenAction::safety_off(BedSide::Left), DISABLE_WAIT).await {
+        Ok(_) => log::warn!("frozen-hold-start: rolled back Left target after Right failed to confirm"),
+        Err(e) => log::error!("frozen-hold-start: rollback disable for Left failed: {e}"),
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn finish_start(
+    args: &HoldStartArgs,
+    dry_run: bool,
+    audit: &AuditedTransport,
+    left_c: f64,
+    right_c: f64,
+    left_confirmed: bool,
+    right_confirmed: bool,
+    reset_performed: bool,
+    rolled_back: bool,
+    stop_reason: &str,
+    exit_code: u8,
+) -> Report {
+    let mut report = base_report("frozen-hold-start", dry_run, &args.i2c_device, &args.frozen_port, stop_reason, exit_code);
+    report.i2c_bus_open = true;
+    report.frozen_uart_opened = true;
+    report.outgoing_commands = audit.entries().iter().map(AuditEntryJson::from).collect();
+    report.enabled_target_command_count = audit.enabled_target_count();
+    report.safety_off_commands_sent = audit.entries().iter().filter(|e| e.enabled == Some(false)).count() as u32;
+    report.hold_results = Some(HoldResults {
+        action: "start".to_string(),
+        requested_left_target_c: Some(left_c),
+        requested_right_target_c: Some(right_c),
+        left_target_confirmed: left_confirmed,
+        right_target_confirmed: right_confirmed,
+        reset_performed,
+        rolled_back,
+        ..Default::default()
+    });
+    report.overall_pass = left_confirmed && right_confirmed;
+    report.exit_code = exit_code;
+
+    write_json_if_requested(&report, args.json_output.as_deref());
+    report.print_table();
+    report
+}
+
+fn refused_start_report(args: &HoldStartArgs, reason: &str) -> Report {
+    let mut report = base_report("frozen-hold-start", args.dry_run, &args.i2c_device, &args.frozen_port, reason, 2);
+    report.hold_results = Some(HoldResults { action: "start".to_string(), ..Default::default() });
+    write_json_if_requested(&report, args.json_output.as_deref());
+    report
+}
+
+// ================================================================================================
+// frozen-hold-stop
+// ================================================================================================
+
+pub async fn run_stop(args: &HoldStopArgs) -> (Report, u8) {
+    if args.dry_run {
+        log::warn!("--dry-run: no UART writes will be performed; using a mocked Frozen device");
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "dry-run");
+        let result = run_stop_core(args, &mut link, true).await;
+        drop(link);
+        task.abort();
+        return result;
+    }
+
+    if let Some(reason) = refuse_if_owned(None, &args.frozen_port) {
+        log::error!("frozen-hold-stop: refusing to run: {reason}");
+        let mut report = base_report("frozen-hold-stop", false, "", &args.frozen_port, &reason, 40);
+        report.hold_results = Some(HoldResults { action: "stop".to_string(), ..Default::default() });
+        write_json_if_requested(&report, args.json_output.as_deref());
+        return (report, 40);
+    }
+
+    let mut link = match FrozenLink::<tokio_serial::SerialStream>::open(&args.frozen_port) {
+        Ok(l) => l,
+        Err(e) => {
+            log::error!("frozen-hold-stop: failed to open Frozen UART {}: {e}", args.frozen_port);
+            let mut report = base_report(
+                "frozen-hold-stop", false, "", &args.frozen_port, "Frozen UART failed to open", 20,
+            );
+            report.hold_results = Some(HoldResults { action: "stop".to_string(), ..Default::default() });
+            write_json_if_requested(&report, args.json_output.as_deref());
+            return (report, 20);
+        }
+    };
+
+    run_stop_core(args, &mut link, false).await
+}
+
+async fn run_stop_core<T>(args: &HoldStopArgs, link: &mut FrozenLink<T>, dry_run: bool) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    let mut audit = AuditedTransport::new(Mode::HoldStop);
+
+    // Ping first, purely for logging/reporting -- never to justify a reset, and the disable
+    // sequence below runs regardless of the result (best-effort, matching emergency-stop's own
+    // "send anyway" philosophy for a stop path).
+    let (ping_ok, mode) = frozen_ops::ping(link, &mut audit, COMMAND_TIMEOUT).await;
+    if !ping_ok {
+        log::warn!("frozen-hold-stop: Frozen did not answer the initial Ping; sending disables anyway");
+    }
+
+    let (left_disabled, right_disabled) = disable_both_and_confirm(link, &mut audit).await;
+    let overall_pass = left_disabled && right_disabled;
+
+    eprintln!("Left disabled:  {left_disabled}");
+    eprintln!("Right disabled: {right_disabled}");
+    if overall_pass {
+        eprintln!("Frozen thermal control stopped");
+    } else {
+        eprintln!("WARNING: could not confirm both sides disabled");
+    }
+
+    let mut report = base_report(
+        "frozen-hold-stop", dry_run, "", &args.frozen_port,
+        if overall_pass { "stopped" } else { "stop_not_confirmed" },
+        if overall_pass { 0 } else { 23 },
+    );
+    report.frozen_uart_opened = true;
+    report.frozen_bootloader_ping = ping_ok.then_some(mode == frozen_ops::DeviceMode::Bootloader);
+    report.frozen_firmware_ping = ping_ok.then_some(mode == frozen_ops::DeviceMode::Firmware);
+    report.outgoing_commands = audit.entries().iter().map(AuditEntryJson::from).collect();
+    report.safety_off_commands_sent = audit.entries().iter().filter(|e| e.enabled == Some(false)).count() as u32;
+    report.hold_results = Some(HoldResults {
+        action: "stop".to_string(),
+        left_disabled_confirmed: left_disabled,
+        right_disabled_confirmed: right_disabled,
+        frozen_responsive: ping_ok,
+        ..Default::default()
+    });
+    report.overall_pass = overall_pass;
+
+    write_json_if_requested(&report, args.json_output.as_deref());
+    report.print_table();
+    let code = report.exit_code;
+    (report, code)
+}
+
+/// The repeated-disable-and-confirm pattern `frozen-cool-test`'s own controlled shutdown uses
+/// (`cool_test::run_cool_test_shutdown`): send both disables, repeated with short spacing, checking
+/// each send's own reply for the confirming `TargetUpdate(enabled=false)`; only if that didn't
+/// already confirm both sides, keep draining a bit longer for a further unsolicited confirmation.
+/// Deliberately independent of that function rather than calling it directly: unlike cool-test's
+/// shutdown, this must never parse firmware message text and must never fall back to asserting the
+/// I2C reset -- see module docs.
+async fn disable_both_and_confirm<T>(link: &mut FrozenLink<T>, audit: &mut AuditedTransport) -> (bool, bool)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    let mut left_confirmed = false;
+    let mut right_confirmed = false;
+
+    for attempt in 0..SHUTDOWN_REPEAT_COUNT {
+        log::info!("frozen-hold-stop: disable attempt {}/{SHUTDOWN_REPEAT_COUNT}", attempt + 1);
+        if !left_confirmed {
+            let outcome = link.send(audit, FrozenAction::safety_off(BedSide::Left), DISABLE_WAIT).await;
+            if let Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((BedSide::Left, t)))) = &outcome
+                && !t.enabled
+            {
+                left_confirmed = true;
+            }
+        }
+        if !right_confirmed {
+            let outcome = link.send(audit, FrozenAction::safety_off(BedSide::Right), DISABLE_WAIT).await;
+            if let Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((BedSide::Right, t)))) = &outcome
+                && !t.enabled
+            {
+                right_confirmed = true;
+            }
+        }
+        if left_confirmed && right_confirmed {
+            break;
+        }
+        if attempt + 1 < SHUTDOWN_REPEAT_COUNT {
+            tokio::time::sleep(SHUTDOWN_BETWEEN_ATTEMPTS_DELAY).await;
+        }
+    }
+
+    if !(left_confirmed && right_confirmed) {
+        let deadline = Instant::now() + CONFIRM_WINDOW;
+        loop {
+            if left_confirmed && right_confirmed {
+                break;
+            }
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            match link.recv(remaining).await {
+                Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((s, t)))) if !t.enabled => match s {
+                    BedSide::Left => left_confirmed = true,
+                    BedSide::Right => right_confirmed = true,
+                },
+                Ok(PacketOutcome::Received(_)) => {}
+                Ok(PacketOutcome::TimedOut) | Ok(PacketOutcome::Closed) | Err(_) => break,
+            }
+        }
+    }
+
+    (left_confirmed, right_confirmed)
+}
