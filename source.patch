+    pub fn print_table(&self) {
+        log::info!("================ opensleep-diagnostic summary ================");
+        log::info!("mode: {} (dry_run={})", self.mode, self.dry_run);
+        log::info!(
+            "build: v{} (opensleep base {}, commit {})",
+            self.program_version,
+            self.opensleep_base_version,
+            self.opensleep_source_commit
+        );
+        log::info!(
+            "I2C bus open: {} | 0x20 probe: {} | 0x53 probe: {} (nonfatal)",
+            self.i2c_bus_open, self.reset_expander_probe_ok, self.led_controller_probe_ok
+        );
+        log::info!(
+            "Frozen bootloader ping: {:?} | firmware ping: {:?}",
+            self.frozen_bootloader_ping, self.frozen_firmware_ping
+        );
+        log::info!(
+            "Enabled target commands sent: {} | Prime sent: {} | Random sent: {} | Safety-off sent: {}",
+            self.enabled_target_command_count, self.prime_command_count, self.random_command_count,
+            self.safety_off_commands_sent
+        );
+        log::info!(
+            "Telemetry samples decoded: {} | unsolicited telemetry seen: {} | timeouts: {} | malformed windows: {}",
+            self.telemetry_samples.len(), self.unsolicited_telemetry_seen, self.communication_timeouts,
+            self.malformed_windows
+        );
+        if let Some(cr) = &self.component_results {
+            log::info!("-- component results --");
+            log::info!("  Frozen command accepted:      {}", cr.frozen_command_accepted);
+            log::info!("  Pump operation:               {}", cr.pump_operation);
+            log::info!("  Fan operation:                {}", cr.fan_operation);
+            log::info!("  TEC cooling operation:        {}", cr.tec_cooling_operation);
+            log::info!("  Telemetry remained valid:     {}", cr.telemetry_remained_valid);
+            // Item 9: `frozen-cool-test` normally stops by disabling both targets over UART, never
+            // by asserting any reset -- "Emergency shutdown" is misleading there unless the narrow
+            // emergency Frozen-only reset genuinely fired. Other modes keep the original label
+            // unchanged (their own shutdown paths are unaffected by this rename).
+            let emergency_reset_actually_used =
+                self.cool_test_results.as_ref().is_some_and(|ct| ct.emergency_reset_asserted);
+            if self.cool_test_results.is_some() && !emergency_reset_actually_used {
+                log::info!("  Controlled shutdown:          {}", cr.emergency_shutdown);
+            } else {
+                log::info!("  Emergency shutdown:           {}", cr.emergency_shutdown);
+            }
+            log::info!("  Overall selected-side result: {}", cr.overall_selected_side_result);
+        }
+        if let Some(pr) = &self.prime_results {
+            log::info!("-- prime results --");
+            log::info!("  Frozen application firmware:     {}", pr.frozen_application_firmware);
+            log::info!("  Prime command transmitted:       {}", pr.prime_command_transmitted);
+            log::info!("  Prime acknowledgment:            {}", pr.prime_acknowledgment);
+            log::info!("  Prime start observed:            {}", pr.prime_start_observed);
+            log::info!("  Left pump telemetry:             {}", pr.left_pump_telemetry);
+            log::info!("  Right pump telemetry:            {}", pr.right_pump_telemetry);
+            log::info!("  Left pump operator observation:  {}", pr.left_pump_operator_observation);
+            log::info!("  Right pump operator observation: {}", pr.right_pump_operator_observation);
+            log::info!("  Solenoid operation:               {}", pr.solenoid_operation);
+            log::info!("  Water movement observed:         {}", pr.water_movement_observed);
+            log::info!("  Prime completion observed:       {}", pr.prime_completion_observed);
+            log::info!("  Safe-stop and reset:             {}", pr.safe_stop_and_reset);
+            log::info!("  Overall result:                  {}", pr.overall_result);
+        }
+        if let Some(oi) = &self.opensleep_init_results {
+            log::info!("-- opensleep-init results --");
+            log::info!("  Subsystem reset performed/ok:    {}/{}", oi.reset_performed, oi.reset_ok);
+            log::info!("  Device label:                    {}", oi.device_label);
+            log::info!("  Frozen UART requested:           {}", oi.frozen_uart_requested);
+            log::info!("  Frozen UART opened:              {}", oi.frozen_uart_opened);
+            log::info!("  Frozen manager task running:     {}", oi.frozen_manager_task_running);
+            log::info!("  Frozen reached firmware:         {}", oi.frozen_reached_firmware);
+            log::info!("  [capwater] unavailable observed: {}", oi.capwater_unavailable_observed);
+            log::info!("  [flowrate] unavailable observed: {}", oi.flowrate_unavailable_observed);
+            log::info!("  Prime outcome:                   {}", oi.prime_outcome);
+            log::info!("  Prime sent:                      {}", oi.prime_sent);
+            log::info!("  Prime sent count:                {}", oi.prime_sent_count);
+            log::info!("  Normal done observed:            {}", oi.normal_done_observed);
+            log::info!("  Done because empty observed:     {}", oi.done_because_empty_observed);
+            log::info!("  Emergency reset asserted:        {}", oi.emergency_reset_asserted);
+        }
+        if let Some(rf) = &self.release_frozen_only_results {
+            log::info!("-- release-frozen-only results --");
+            log::info!("  Register 0x02 original:          0b{:08b}", rf.original_register_0x02);
+            log::info!(
+                "  Asserted (output latch, pre-direction): target=0b{:08b} readback=0b{:08b} matches={}",
+                rf.asserted_register_0x02, rf.asserted_readback_register_0x02, rf.asserted_readback_matches
+            );
+            log::info!("  Register 0x06 original:          0b{:08b}", rf.original_register_0x06);
+            log::info!(
+                "  Register 0x06 configured-as-output: target=0b{:08b} readback=0b{:08b} matches={} (bit 1 was previously {})",
+                rf.config_register_0x06, rf.config_readback_register_0x06, rf.config_readback_matches,
+                if rf.bit1_was_already_configured_as_output { "output" } else { "input" }
+            );
+            log::info!(
+                "  Released: target=0b{:08b} readback=0b{:08b} matches={}",
+                rf.released_register_0x02, rf.released_readback_register_0x02, rf.released_readback_matches
+            );
+            log::info!("  Only bit 1 changed (all three writes): {}", rf.only_bit1_changed);
+            log::info!("  Pulse duration (driven):         {} ms", rf.pulse_duration_ms);
+            log::info!("  Frozen UART opened:              {}", rf.frozen_uart_opened);
+            log::info!("  Frozen reached firmware:         {}", rf.frozen_reached_firmware);
+            log::info!("  [capwater] unavailable observed: {}", rf.capwater_unavailable_observed);
+            log::info!("  [flowrate] unavailable observed: {}", rf.flowrate_unavailable_observed);
+            log::info!("  Reservoir status:                {}", rf.reservoir_status);
+            log::info!("  Prime outcome:                   {}", rf.prime_outcome);
+            log::info!("  Prime sent:                      {}", rf.prime_sent);
+            log::info!("  Normal done observed:            {}", rf.normal_done_observed);
+            log::info!("  Done because empty observed:     {}", rf.done_because_empty_observed);
+            log::info!("  Emergency reset asserted:        {}", rf.emergency_reset_asserted);
+        }
+        if let Some(ct) = &self.cool_test_results {
+            log::info!("-- cool-test results --");
+            log::info!("  Selected side:                    {}", ct.selected_side);
+            log::info!("  Requested delta:                  -{:.2}C", ct.requested_delta_c);
+            log::info!(
+                "  Duration: requested={}s actual={:.1}s",
+                ct.requested_duration_seconds, ct.actual_active_duration_seconds
+            );
+            log::info!(
+                "  Baseline (L/R/heatsink):          {:?}/{:?}/{:?}",
+                ct.baseline_left_c, ct.baseline_right_c, ct.baseline_heatsink_c
+            );
+            log::info!(
+                "  Minimum (L/R) / maximum heatsink:  {:?}/{:?} / {:?}",
+                ct.minimum_left_c, ct.minimum_right_c, ct.maximum_heatsink_c
+            );
+            log::info!(
+                "  Final (L/R/heatsink):             {:?}/{:?}/{:?}",
+                ct.final_left_c, ct.final_right_c, ct.final_heatsink_c
+            );
+            log::info!(
+                "  Change (selected/opposite/heatsink): {:?}/{:?}/{:?}",
+                ct.selected_side_temperature_change_c, ct.opposite_side_temperature_change_c, ct.heatsink_temperature_change_c
+            );
+            log::info!(
+                "  Target reached:                   {} (time to target: {:?}s)",
+                ct.target_reached, ct.time_to_target_seconds
+            );
+            log::info!(
+                "  TEC activity (selected)/safety passed/unlocking observed/pump activity (selected/L/R): {}/{}/{}/{}/{}/{}",
+                ct.selected_tec_activity_observed, ct.selected_tec_safety_passed, ct.selected_tec_unlocking_observed,
+                ct.selected_pump_activity_observed, ct.left_pump_activity_observed, ct.right_pump_activity_observed
+            );
+            log::info!(
+                "  TEC current A (first/min/max/last, n={}): {:?}/{:?}/{:?}/{:?}",
+                ct.selected_tec_current_samples, ct.selected_tec_current_first_a, ct.selected_tec_current_min_a,
+                ct.selected_tec_current_max_a, ct.selected_tec_current_last_a
+            );
+            log::info!(
+                "  Watchdog triggered/communication loss/operator abort: {}/{}/{}",
+                ct.telemetry_watchdog_triggered, ct.communication_loss_observed, ct.operator_abort_observed
+            );
+            log::info!(
+                "  Shutdown verified: {} (both targets confirmed: {}, pump: {}, TEC: {})",
+                ct.shutdown_verified, ct.both_targets_shutdown_confirmed, ct.selected_pump_shutdown_observed,
+                ct.selected_tec_shutdown_observed
+            );
+            log::info!("  Emergency reset asserted:         {}", ct.emergency_reset_asserted);
+            log::info!("  Reservoir status:                 {}", ct.reservoir_status);
+            log::info!("  Startup mode:                     {}", ct.startup_mode);
+            if ct.control_authority == "firmware" {
+                log::info!("  -- firmware-authoritative --");
+                log::info!(
+                    "  Target enabled at:                {:?}s | target reached (observed, non-terminal): {}",
+                    ct.target_enabled_at, ct.target_reached_observed
+                );
+                log::info!(
+                    "  Selected min/final (C):           {:?}/{:?} | opposite min (C): {:?} | max heatsink (C): {:?}",
+                    ct.selected_temperature_min_c, ct.selected_temperature_final_c, ct.opposite_temperature_min_c,
+                    ct.heatsink_temperature_max_c
+                );
+                log::info!(
+                    "  Pump command/current observed: {}/{} | TEC current observed: {} | firmware safety passed/fault: {}/{}",
+                    ct.pump_command_observed, ct.pump_current_observed, ct.tec_current_observed,
+                    ct.explicit_firmware_safety_passed, ct.explicit_firmware_fault_observed
+                );
+                log::info!("  Telemetry warnings logged:        {}", ct.telemetry_warning_count);
+                log::info!(
+                    "  Independent shutdown guard armed/disarmed: {}/{}",
+                    ct.independent_guard_armed, ct.independent_guard_disarmed
+                );
+                log::info!(
+                    "  [temps] reads failed/total/ratio: {:?}/{:?}/{:?}",
+                    ct.temperature_reads_failed, ct.temperature_reads_total, ct.temperature_read_failure_ratio
+                );
+                log::info!(
+                    "  Top fan observed/duty/rpm/max rpm: {}/{:?}/{:?}/{:?}",
+                    ct.top_fan_activity_observed, ct.top_fan_latest_duty, ct.top_fan_latest_rpm, ct.top_fan_max_rpm
+                );
+                log::info!(
+                    "  Bottom fan observed/duty/rpm/max rpm: {}/{:?}/{:?}/{:?}",
+                    ct.bottom_fan_activity_observed, ct.bottom_fan_latest_duty, ct.bottom_fan_latest_rpm,
+                    ct.bottom_fan_max_rpm
+                );
+            }
+        }
+        if let Some(ct) = &self.cool_test_results {
+            log::info!("stop reason: {} (code: {})", self.stop_reason, ct.stop_reason_code);
+        } else {
+            log::info!("stop reason: {}", self.stop_reason);
+        }
+        if let Some(ss) = &self.safe_stop {
+            log::info!(
+                "safe-stop: fully_succeeded={} degraded={} catastrophic={}",
+                ss.fully_succeeded, ss.degraded, ss.catastrophic
+            );
+        }
+        log::info!("overall_pass: {} | exit_code: {}", self.overall_pass, self.exit_code);
+        log::info!("================================================================");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn verdict_display_matches_spec_vocabulary() {
+        assert_eq!(Verdict::Pass.to_string(), "PASS");
+        assert_eq!(Verdict::Unverified.to_string(), "UNVERIFIED");
+        assert_eq!(Verdict::Inconclusive.to_string(), "INCONCLUSIVE");
+    }
+
+    #[test]
+    fn component_results_default_to_unknown_not_pass() {
+        let cr = ComponentResults::default();
+        assert_eq!(cr.pump_operation, Verdict::Unknown);
+        assert_eq!(cr.tec_cooling_operation, Verdict::Unknown);
+    }
+}
