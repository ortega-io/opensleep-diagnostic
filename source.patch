+    #[tokio::test]
+    async fn no_temperature_sample_but_ongoing_message_traffic_triggers_temperature_watchdog() {
+        let (client, device) = tokio::io::duplex(8192);
+        let device_task = spawn_device_with_message_traffic_but_no_active_phase_temperature(device);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+
+        let mut a = args(Side::Left, false);
+        a.duration_seconds = Some(ACTIVE_STARTUP_GRACE.as_secs() + 5);
+        let (report, _code) = run_core(&a, &mut i2c, &mut link, false, None, None, false, resolve_requested_duration(&a).unwrap()).await;
+
+        // The active phase's own temperature-freshness clock starts fresh (`None`) when it
+        // begins -- baseline having already validated is not itself carried forward as an active-
+        // phase sample -- so a device that never sends a temperature reading once enabled hits
+        // the *startup grace* clock (ACTIVE_STARTUP_GRACE), not the steady-state one
+        // (TEMPERATURE_FRESHNESS_LIMIT, which only starts once a first active-phase sample has
+        // been seen). Message traffic keeps the communication watchdog satisfied the whole time,
+        // proving the two watchdogs are genuinely independent.
+        assert_eq!(report.stop_reason, StopReason::TemperatureStartupGraceExpired.to_string());
+        let ct = report.cool_test_results.expect("cool_test_results must be set");
+        assert_eq!(ct.stop_reason_code, "temperature_startup_grace_expired");
+        assert!(ct.telemetry_watchdog_triggered);
+        assert!(!ct.communication_loss_observed, "Message traffic must have kept the communication watchdog satisfied");
+        assert!(ct.selected_tec_current_samples > 0, "Message traffic must have been processed, not ignored");
+
+        drop(link);
+        device_task.abort();
+    }
