+//! Structured JSON/CSV/text reporting shared by all three subcommands. Machine evidence (audit
+//! log, decoded telemetry) is always kept in separate fields from operator-entered observations,
+//! per the safety model: a component may only be marked PASS from decoded evidence or an explicit
+//! recorded observation, never from "a command was accepted."
+
+use std::io::Write as _;
+
+use opensleep::common::packet::BedSide;
+use serde::Serialize;
+
+use crate::safety::AuditEntry;
+use crate::telemetry::{SampleSource, TemperatureSample};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "UPPERCASE")]
+pub enum Verdict {
+    Pass,
+    Fail,
+    Unverified,
+    Unknown,
+    Inconclusive,
+}
+
+impl Default for Verdict {
+    fn default() -> Self {
+        Verdict::Unknown
+    }
+}
+
+impl std::fmt::Display for Verdict {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let s = match self {
+            Verdict::Pass => "PASS",
+            Verdict::Fail => "FAIL",
+            Verdict::Unverified => "UNVERIFIED",
+            Verdict::Unknown => "UNKNOWN",
+            Verdict::Inconclusive => "INCONCLUSIVE",
+        };
+        write!(f, "{s}")
+    }
+}
+
+fn side_str(side: BedSide) -> &'static str {
+    match side {
+        BedSide::Left => "left",
+        BedSide::Right => "right",
+    }
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct AuditEntryJson {
+    pub command_name: String,
+    pub side: Option<String>,
+    pub enabled: Option<bool>,
+    pub target_c: Option<f64>,
+    pub target_centideg: Option<u16>,
+    pub bytes_hex: String,
+    pub timestamp: String,
+    pub mode: String,
+}
+
+impl From<&AuditEntry> for AuditEntryJson {
+    fn from(e: &AuditEntry) -> Self {
+        Self {
+            command_name: e.command_name.clone(),
+            side: e.side.map(side_str).map(str::to_string),
+            enabled: e.enabled,
+            target_c: e
+                .target_centideg
+                .map(crate::telemetry::centideg_to_celsius),
+            target_centideg: e.target_centideg,
+            bytes_hex: e.bytes.iter().map(|b| format!("{b:02X}")).collect::<Vec<_>>().join(" "),
+            timestamp: e.timestamp.clone(),
+            mode: e.mode.clone(),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct TemperatureSampleJson {
+    pub elapsed_ms: u64,
+    pub timestamp: String,
+    pub source: &'static str,
+    pub left_water_c: Option<f64>,
+    pub right_water_c: Option<f64>,
+    pub heatsink_c: Option<f64>,
+    /// Control-loop error term in degrees C (`TemperatureUpdate.error`, source-documented as
+    /// "error in deg celcius"). NOT a fault/status code -- see `telemetry::TemperatureSample`'s
+    /// doc comment for the evidence. `None` for samples decoded from a solicited `GetTemperature`
+    /// reply, which carries no such field.
+    pub control_error_c: Option<u8>,
+    pub raw_left_centideg: Option<u16>,
+    pub raw_right_centideg: Option<u16>,
+    pub raw_heatsink_centideg: Option<u16>,
+}
+
+impl From<&TemperatureSample> for TemperatureSampleJson {
+    fn from(s: &TemperatureSample) -> Self {
+        Self {
+            elapsed_ms: s.elapsed_ms,
+            timestamp: s.timestamp.clone(),
+            source: match s.source {
+                SampleSource::Solicited => "solicited",
+                SampleSource::Unsolicited => "unsolicited",
+                SampleSource::SolicitedCompat14Byte => "solicited_compat_14byte",
+            },
+            left_water_c: s.left_water_c,
+            right_water_c: s.right_water_c,
+            heatsink_c: s.heatsink_c,
+            control_error_c: s.control_error_c,
+            raw_left_centideg: s.raw_left,
+            raw_right_centideg: s.raw_right,
+            raw_heatsink_centideg: s.raw_heatsink,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct OperatorObservations {
+    /// "yes" | "no" | "unsure"
+    pub pump_heard_or_felt: Option<String>,
+    pub fan_seen_or_heard: Option<String>,
+    pub airflow_felt: Option<String>,
+    pub leak_observed: Option<bool>,
+    pub unusual_smell_or_noise: Option<bool>,
+    pub notes: Option<String>,
+}
+
+/// `frozen-prime-test`'s operator-entered observations, kept as a distinct type (not reused from
+/// `OperatorObservations`) since the questions asked are different, and separate from every
+/// machine-decoded field per the safety model's evidentiary-separation requirement.
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct PrimeOperatorObservations {
+    /// "yes" | "no" | "unsure"
+    pub left_pump_heard_or_felt: Option<String>,
+    pub right_pump_heard_or_felt: Option<String>,
+    pub water_movement_or_bubbles_observed: Option<String>,
+    pub reservoir_level_dropped: Option<String>,
+    pub reservoir_topped_up: Option<bool>,
+    pub leak_observed: Option<bool>,
+    pub abnormal_noise: Option<bool>,
+    pub burning_smell: Option<bool>,
+    pub notes: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct ComponentResults {
+    pub frozen_command_accepted: Verdict,
+    pub pump_operation: Verdict,
+    pub fan_operation: Verdict,
+    pub tec_cooling_operation: Verdict,
+    pub telemetry_remained_valid: Verdict,
+    pub emergency_shutdown: Verdict,
+    pub overall_selected_side_result: Verdict,
+}
+
+/// `frozen-prime-test`'s per-run result line, reported independently per the safety model: never
+/// collapsed into one pass/fail, and never PASS merely because the command was accepted, the
+/// firmware acknowledged it, a pump received voltage, or "priming done" was printed. See
+/// PROTOCOL_AUDIT.md.
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct PrimeResults {
+    pub frozen_application_firmware: Verdict,
+    pub prime_command_transmitted: Verdict,
+    pub prime_acknowledgment: Verdict,
+    pub prime_start_observed: Verdict,
+    pub left_pump_telemetry: Verdict,
+    pub right_pump_telemetry: Verdict,
+    pub left_pump_operator_observation: Verdict,
+    pub right_pump_operator_observation: Verdict,
+    pub solenoid_operation: Verdict,
+    pub water_movement_observed: Verdict,
+    pub prime_completion_observed: Verdict,
+    pub safe_stop_and_reset: Verdict,
+    pub overall_result: Verdict,
+}
+
+/// Outcome of the single `Prime` send in `frozen-prime-opensleep-init`. Distinct from
+/// `PrimeResults` (which drives the resettable mode's multi-factor PASS/FAIL/INCONCLUSIVE
+/// verdict): this is a plain report of what was directly observed.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum PrimeOutcome {
+    /// Preflight refused before Prime was ever sent -- Frozen never reached application firmware,
+    /// or capwater was observed unavailable as a result of this run's own initialization.
+    #[default]
+    NotSent,
+    /// The exact message `"FW: [priming] done"` was observed.
+    Success,
+    /// The exact message `"FW: [priming] done because empty"` was observed: the firmware's own
+    /// account that it stopped because the reservoir ran dry. Not success.
+    IncompleteReservoirEmpty,
+    /// Prime was sent but neither completion message was observed within the firmware-reported
+    /// priming duration (or a stop signal interrupted observation first).
+    NotObservedWithinWindow,
+}
+
+impl std::fmt::Display for PrimeOutcome {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let s = match self {
+            PrimeOutcome::NotSent => "not sent",
+            PrimeOutcome::Success => "success",
+            PrimeOutcome::IncompleteReservoirEmpty => "incomplete (done because empty)",
+            PrimeOutcome::NotObservedWithinWindow => "not observed within window",
+        };
+        write!(f, "{s}")
+    }
+}
+
+/// `frozen-prime-opensleep-init`'s report: this mode runs the real, unmodified upstream
+/// initialization/manager code (`ResetController::reset_subsystems`, `frozen::run`, ...) rather
+/// than the diagnostic's own transport, so its evidence is what was observed in the real log
+/// stream those functions emit, not a locally-audited command log. The Sensor subsystem is never
+/// started in this mode at all (see `prime_opensleep_init.rs` module docs), so there is no
+/// Sensor-related field here to report.
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct OpenSleepInitResults {
+    pub reset_performed: bool,
+    pub reset_ok: bool,
+    pub device_label: String,
+    /// The Frozen UART path this run asked `frozen::run` to open -- this Hub's confirmed
+    /// `/dev/ttyS1`, never the upstream `opensleep::frozen::PORT` default.
+    pub frozen_uart_requested: String,
+    /// Whether the Frozen manager's own future was still running `UART_OPEN_SETTLE` after being
+    /// started, rather than having resolved immediately with an open error -- see that constant's
+    /// doc comment for why this distinguishes "opened" from merely "a task was started".
+    pub frozen_uart_opened: bool,
+    /// Whether the Frozen manager task was still running (had not crashed/exited on its own) as of
+    /// the end of this run's observation loop.
+    pub frozen_manager_task_running: bool,
+    pub frozen_reached_firmware: bool,
+    pub capwater_unavailable_observed: bool,
+    pub flowrate_unavailable_observed: bool,
+    pub prime_outcome: PrimeOutcome,
+    /// Real per-run count of `" -> Prime"` log lines observed from the real Frozen manager. Should
+    /// never exceed 1 -- the manager's own scheduler debounce is what enforces that, not a count
+    /// kept by this binary (see `prime_opensleep_init.rs` module docs).
+    pub prime_sent_count: u32,
+    /// `true` iff `prime_sent_count > 0`. A plain boolean alongside the count for report clarity.
+    pub prime_sent: bool,
+    pub normal_done_observed: bool,
+    pub done_because_empty_observed: bool,
+    pub emergency_reset_asserted: bool,
+}
+
+/// `frozen-prime-opensleep-init --release-frozen-only`'s report: this mode never calls
+/// `opensleep::reset::ResetController` and never runs the real upstream Frozen or Sensor manager
+/// tasks -- it uses this diagnostic's own narrow I2C read-modify-write
+/// (`i2c::pulse_frozen_reset_bit`) and its own audited Frozen transport instead. See
+/// `prime_opensleep_init.rs` module docs for the full narrative.
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct ReleaseFrozenOnlyResults {
+    /// I2C expander register 0x02 (output latch) as read before this run changed anything.
+    pub original_register_0x02: u8,
+    /// Register 0x02 as written to prepare the output latch's asserted level, *before* bit 1 is
+    /// configured as an output (`original | 0x02`) -- see `i2c::pulse_frozen_reset_bit`'s doc
+    /// comment for why this ordering avoids a glitch.
+    pub asserted_register_0x02: u8,
+    /// Register 0x02 as read back immediately after that write.
+    pub asserted_readback_register_0x02: u8,
+    /// `true` iff `asserted_readback_register_0x02 == asserted_register_0x02`.
+    pub asserted_readback_matches: bool,
+    /// I2C expander register 0x06 (direction/config) as read before this run changed anything.
+    /// The PCAL6416A power-on-reset default is every bit configured as an input (`0xFF`); a bit
+    /// configured as an input ignores its register-0x02 output-latch value entirely -- this is the
+    /// real-hardware evidence behind why an earlier revision's register-0x02-only pulse produced
+    /// no physical edge and no response from Frozen.
+    pub original_register_0x06: u8,
+    /// Register 0x06 as written to configure only bit 1 as an output (`original & !0x02`); every
+    /// other bit, including bit 0, is preserved exactly as read. Left in place afterward -- never
+    /// restored to its original value -- so the reset line stays actively driven.
+    pub config_register_0x06: u8,
+    /// Register 0x06 as read back immediately after that write.
+    pub config_readback_register_0x06: u8,
+    /// `true` iff `config_readback_register_0x06 == config_register_0x06`.
+    pub config_readback_matches: bool,
+    /// `true` iff bit 1 of register 0x06 already read `0` (output) before this run's write; `false`
+    /// iff it read `1` (input/high-Z, the power-on-reset default) -- i.e. whether this run's write
+    /// is what first enabled the reset line to be physically driven at all.
+    pub bit1_was_already_configured_as_output: bool,
+    /// Register 0x02 as written for the pulse's release half (`asserted & !0x02`).
+    pub released_register_0x02: u8,
+    /// Register 0x02 as read back immediately after the release write.
+    pub released_readback_register_0x02: u8,
+    /// `true` iff `released_readback_register_0x02 == released_register_0x02`.
+    pub released_readback_matches: bool,
+    /// `true` iff none of the three writes (output-latch prep, direction/config, release) ever
+    /// changed any bit other than bit 1 of its own register.
+    pub only_bit1_changed: bool,
+    /// How long bit 1 was held asserted *while configured as an output* (i.e. while physically
+    /// driven), in milliseconds.
+    pub pulse_duration_ms: u64,
+    pub frozen_uart_opened: bool,
+    pub frozen_reached_firmware: bool,
+    pub capwater_unavailable_observed: bool,
+    pub flowrate_unavailable_observed: bool,
+    /// Whether the reservoir-fill indicator was confirmed still working, explicitly reported by
+    /// the operator rather than inferred from any automatic sensor check -- the entire point of
+    /// this narrower mode, per real-hardware evidence that the full reset sequence leaves it
+    /// off/unresponsive even though it does release Frozen. Stays `Unverified` (never a false
+    /// negative) if the run aborted before the confirmation was ever asked.
+    pub reservoir_status: ReservoirStatus,
+    pub prime_outcome: PrimeOutcome,
+    pub prime_sent: bool,
+    pub normal_done_observed: bool,
+    pub done_because_empty_observed: bool,
+    /// `true` iff this run's emergency path re-asserted Frozen's reset bit via
+    /// `i2c::assert_frozen_reset_bit_only` (bit-1-only read-modify-write), never the full
+    /// `i2c::assert_reset` (hardcoded 0xFF) used by every other mode's emergency-stop.
+    pub emergency_reset_asserted: bool,
+}
+
+/// Whether the reservoir-fill indicator was confirmed still working after `--release-frozen-only`
+/// released Frozen from reset -- reported explicitly by the operator (via the required
+/// `RESERVOIR INDICATOR IS STILL WORKING` confirmation), never inferred from an automatic sensor
+/// check. See [`ReleaseFrozenOnlyResults::reservoir_status`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Default)]
+#[serde(rename_all = "snake_case")]
+pub enum ReservoirStatus {
+    /// The run never reached the point of asking -- e.g. Frozen never responded, or the I2C pulse
+    /// itself failed to verify. Never reported merely because the run aborted; that would be a
+    /// false negative, not an honest "we never asked".
+    #[default]
+    Unverified,
+    /// The operator typed the exact confirmation phrase, declaring the indicator is still working.
+    Confirmed,
+    /// The operator was asked and did not type the exact confirmation phrase -- reported as a
+    /// distinct, explicit operator observation, not conflated with `Unverified`.
+    FailedByOperatorObservation,
+}
+
+impl std::fmt::Display for ReservoirStatus {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let s = match self {
+            ReservoirStatus::Unverified => "unverified",
+            ReservoirStatus::Confirmed => "confirmed",
+            ReservoirStatus::FailedByOperatorObservation => "failed by operator observation",
+        };
+        write!(f, "{s}")
+    }
+}
+
+/// `frozen-cool-test`'s report: this mode now starts Frozen via the same narrow
+/// register-0x02/0x06 pulse `--release-frozen-only` uses (`frozen_startup::start_frozen_narrow`),
+/// never `opensleep::reset::ResetController` or the four-register full reset sequence, and never
+/// asserts any I2C reset on normal completion -- only as an emergency backstop (narrow, bit-1-only)
+/// if UART-based shutdown could not be confirmed for a genuine fault. See `cool_test.rs` module
+/// docs and SAFETY.md for the full narrative.
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct CoolTestResults {
+    pub selected_side: String,
+    pub requested_delta_c: f64,
+    pub requested_duration_seconds: u64,
+    pub actual_active_duration_seconds: f64,
+    /// `true` iff the operator typed `RUN EXTENDED COOLING TEST FOR UP TO 15 MINUTES` (required
+    /// whenever `requested_duration_seconds` exceeds `cool_test::EXTENDED_DURATION_THRESHOLD_SECONDS`,
+    /// i.e. 300s). `false` when the requested duration didn't require it -- see `cool_test::run`.
+    pub extended_test_confirmation_received: bool,
+    /// Seconds from the active phase starting to the selected side's temperature first reaching
+    /// the computed target -- `None` if the target was never reached. Distinct from
+    /// `actual_active_duration_seconds`: the active phase keeps running for
+    /// `cool_test::TARGET_STABLE_CONFIRM_WINDOW` after this point to confirm the reading is
+    /// stable, not a single noisy sample, before actually stopping.
+    pub time_to_target_seconds: Option<f64>,
+    pub baseline_left_c: Option<f64>,
+    pub baseline_right_c: Option<f64>,
+    pub baseline_heatsink_c: Option<f64>,
+    /// The configured minimum sample count (`cool_test::BASELINE_MIN_SAMPLES`) baseline collection
+    /// was run against -- reported explicitly so a JSON/CSV consumer doesn't need the binary's own
+    /// source to know what threshold `baseline_synchronous_samples_decoded +
+    /// baseline_unsolicited_samples_decoded` was measured against.
+    pub baseline_samples_requested: usize,
+    /// Valid, deduplicated baseline samples decoded from a solicited `GetTemperature` reply --
+    /// either the original 27-byte reply (unmodified upstream parser) or this firmware's 14-byte
+    /// reply (`frozen_compat::decode_get_temperature_14byte`). See `telemetry::SampleSource`.
+    pub baseline_synchronous_samples_decoded: usize,
+    /// Valid, deduplicated baseline samples decoded from an unsolicited `TemperatureUpdate` push.
+    pub baseline_unsolicited_samples_decoded: usize,
+    /// Samples discarded because they had the exact same (left, right, heatsink) reading as
+    /// another sample already collected in the same ~1s baseline tick -- see
+    /// `cool_test::is_duplicate_within_tick`.
+    pub baseline_duplicate_samples_discarded: usize,
+    /// Samples discarded because the selected-side or heatsink reading was a sentinel value or
+    /// outside the plausible water-temperature range -- see `cool_test::is_valid_baseline_reading`.
+    /// Never incremented merely because a reply's protocol format wasn't recognized: both the
+    /// 27-byte and 14-byte `GetTemperature` shapes are decoded before this check ever runs.
+    pub baseline_invalid_samples_discarded: usize,
+    pub baseline_collection_duration_seconds: f64,
+    /// Max - min, in Celsius, of the selected side's raw baseline readings.
+    pub baseline_left_range_c: Option<f64>,
+    /// Max - min, in Celsius, of the non-selected side's raw baseline readings.
+    pub baseline_right_range_c: Option<f64>,
+    /// Max - min, in Celsius, of the heatsink's raw baseline readings.
+    pub baseline_heatsink_range_c: Option<f64>,
+    /// Count of `GetTemperature` (opcode `0xC1`) replies recovered from raw captured bytes as the
+    /// firmware-specific 14-byte shape during baseline collection -- see `frozen_compat.rs`.
+    pub compat_get_temperature_14byte_frames: u64,
+    /// Count of heartbeat-opcode (`0x53`) frames observed with the firmware-specific 9-byte
+    /// payload (the original upstream parser expects exactly 3) during baseline collection.
+    pub compat_heartbeat_9byte_frames: u64,
+    /// Count of unrecognized opcode `0x54` frames observed during baseline collection.
+    pub compat_opcode_0x54_frames: u64,
+    /// Count of unrecognized opcode `0x55` frames observed during baseline collection.
+    pub compat_opcode_0x55_frames: u64,
+    pub minimum_left_c: Option<f64>,
+    pub minimum_right_c: Option<f64>,
+    /// Highest heatsink reading observed during the active phase.
+    pub maximum_heatsink_c: Option<f64>,
+    pub final_left_c: Option<f64>,
+    pub final_right_c: Option<f64>,
+    pub final_heatsink_c: Option<f64>,
+    /// `final_left_c/right_c - baseline_left_c/right_c` for whichever side was selected (negative
+    /// means it cooled).
+    pub selected_side_temperature_change_c: Option<f64>,
+    /// Same, for the side that was never enabled -- expected to stay near zero.
+    pub opposite_side_temperature_change_c: Option<f64>,
+    pub heatsink_temperature_change_c: Option<f64>,
+    /// `true` iff the selected side's live temperature reached the computed target
+    /// (`baseline - requested_delta_c`) before the run stopped for any other reason.
+    pub target_reached: bool,
+    pub selected_tec_activity_observed: bool,
+    pub left_pump_activity_observed: bool,
+    pub right_pump_activity_observed: bool,
+    /// `left_pump_activity_observed`/`right_pump_activity_observed`, whichever corresponds to
+    /// `selected_side` -- provided directly so a consumer doesn't need to cross-reference the two
+    /// side-specific fields against `selected_side` itself.
+    pub selected_pump_activity_observed: bool,
+    /// `true` iff a firmware message reported the selected TEC's safety interlock in a
+    /// *safe* state (`"safe, unlocking"` or `"unlocked"`) during the active phase -- see
+    /// `cool_test::TecSafetyState`. This is the corrected replacement for the previous broad
+    /// `contains("tec") && contains("lock")` check, which also matched `"unlocking"`/`"unlocked"`
+    /// and aborted a healthy run on exactly that message.
+    pub selected_tec_safety_passed: bool,
+    /// `true` iff a firmware message specifically reported the selected TEC's safety interlock
+    /// transitioning (`"safe, unlocking"`, not the steady-state `"unlocked"`) during the active
+    /// phase -- narrower than `selected_tec_safety_passed`, which is `true` for either.
+    pub selected_tec_unlocking_observed: bool,
+    /// First, minimum, maximum, and most recent reported TEC current (amps) for the selected side,
+    /// and how many such messages were seen -- see `cool_test::parse_tec_current`. Purely
+    /// descriptive: never independently classified as safe or unsafe (Frozen firmware remains the
+    /// sole authority on its own internal current safety).
+    pub selected_tec_current_first_a: Option<f64>,
+    pub selected_tec_current_min_a: Option<f64>,
+    pub selected_tec_current_max_a: Option<f64>,
+    pub selected_tec_current_last_a: Option<f64>,
+    pub selected_tec_current_samples: u64,
+    /// `true` iff the active phase stopped because no fresh, valid `TemperatureUpdate` arrived for
+    /// longer than `cool_test::STALE_TELEMETRY_LIMIT` (`stop_reason ==
+    /// "telemetry stale for more than 2 seconds"`). Freshness is timestamp-based (last time a new
+    /// packet was actually received), never inferred from a cached value being reused.
+    pub telemetry_watchdog_triggered: bool,
+    /// `true` iff the active phase stopped because of a UART read/write failure or the link
+    /// closing outright (`StopReason::UartReadFailure`/`UartWriteFailure`/`TelemetryLost`).
+    pub communication_loss_observed: bool,
+    /// `true` iff the active phase stopped because the operator typed a leak/smell/noise report
+    /// or the literal word ABORT (`StopReason::OperatorAbort`).
+    pub operator_abort_observed: bool,
+    /// `true` iff a `TargetUpdate(enabled=false)` was observed for *both* sides during shutdown --
+    /// the literal protocol-level confirmation, distinct from `shutdown_verified` (which is also
+    /// `true` when the narrow emergency I2C reset fired instead, for a genuine fault where this
+    /// couldn't be confirmed).
+    pub both_targets_shutdown_confirmed: bool,
+    /// Best-effort: `true` iff a firmware pump message for the selected side reported off/0V
+    /// during the shutdown verify window. See `cool_test::CoolTestShutdown`'s doc comment --
+    /// `false` only means no such message happened to arrive in that window, not that the pump is
+    /// still running.
+    pub selected_pump_shutdown_observed: bool,
+    /// Best-effort: `true` iff a firmware TEC-current message for the selected side reported a
+    /// near-zero reading during the shutdown verify window. Same caveat as
+    /// `selected_pump_shutdown_observed`.
+    pub selected_tec_shutdown_observed: bool,
+    /// `true` iff shutdown was confirmed -- either both sides' `TargetUpdate(enabled=false)` was
+    /// observed over UART, or (only for a genuine fault where UART confirmation failed) the
+    /// narrow emergency I2C reset was asserted instead. See [`Self::emergency_reset_asserted`].
+    pub shutdown_verified: bool,
+    /// `true` iff this run's emergency path re-asserted Frozen's reset bit via
+    /// `i2c::assert_frozen_reset_bit_only` (bit-1-only read-modify-write) -- never the full,
+    /// hardcoded-0xFF `i2c::assert_reset` every other mode's shutdown uses. Only ever set for a
+    /// genuine fault where UART-based target shutdown could not be confirmed; never on normal
+    /// completion, `DurationExpired`, or a clean Ctrl+C/SIGTERM/SIGHUP.
+    pub emergency_reset_asserted: bool,
+    pub reservoir_status: ReservoirStatus,
+    pub stop_reason: String,
+    /// Short, stable, machine-readable identifier for `stop_reason` (e.g.
+    /// `"stable_target_reached"`, `"explicit_tec_unsafe_locking"`) -- see
+    /// `cool_test::stop_reason_code`. Distinct from `stop_reason`'s human-readable prose.
+    pub stop_reason_code: String,
+    /// Which reset/startup implementation this run used -- always the narrow pulse in this
+    /// revision (`ResetController`/the four-register full reset sequence are structurally
+    /// unreachable from this file -- see `main.rs`'s guardrail tests), reported explicitly rather
+    /// than left implicit.
+    pub startup_mode: String,
+
+    // ---- --firmware-authoritative mode only (blank/default for a legacy-mode run) ----
+    /// `"firmware"` for a `--firmware-authoritative` run, `"diagnostic"` otherwise -- who owns
+    /// pump sequencing, TEC ramping, thermal regulation, and current safety once the target is
+    /// enabled. See `cool_test.rs` module docs.
+    pub control_authority: String,
+    /// Seconds from the active phase starting to the selected side's enabled `TargetUpdate`
+    /// actually being confirmed (not merely "some reply arrived to our enable command") --
+    /// `--firmware-authoritative` only. `None` if that confirmation was never received.
+    pub target_enabled_at: Option<f64>,
+    /// `--firmware-authoritative` only: `true` iff the selected side's live temperature reached
+    /// the computed target at any point -- logged, but unlike legacy `target_reached`, never
+    /// itself a reason to stop; Frozen continues maintaining the target for the rest of the
+    /// requested duration.
+    pub target_reached_observed: bool,
+    /// `--firmware-authoritative` only: the selected side's lowest observed temperature.
+    pub selected_temperature_min_c: Option<f64>,
+    /// `--firmware-authoritative` only: the selected side's last observed temperature.
+    pub selected_temperature_final_c: Option<f64>,
+    /// `--firmware-authoritative` only: the non-selected side's lowest observed temperature
+    /// (expected to stay near baseline; that side's target is never enabled).
+    pub opposite_temperature_min_c: Option<f64>,
+    /// `--firmware-authoritative` only: the highest observed heatsink temperature -- observational
+    /// only in this mode (never an independent host-side shutdown threshold; Frozen owns thermal
+    /// regulation once enabled).
+    pub heatsink_temperature_max_c: Option<f64>,
+    /// `--firmware-authoritative` only: `true` iff at least one firmware pump command/status
+    /// message for the selected side was observed (positive evidence only -- its *absence* is
+    /// never itself a reason to stop in this mode).
+    pub pump_command_observed: bool,
+    /// `--firmware-authoritative` only: `true` iff at least one firmware pump message for the
+    /// selected side carried a parseable current (amps) component.
+    pub pump_current_observed: bool,
+    /// `--firmware-authoritative` only: `true` iff at least one firmware TEC-current message for
+    /// the selected side was observed. Equivalent evidence to `selected_tec_current_samples > 0`,
+    /// reported as its own boolean per this mode's spec.
+    pub tec_current_observed: bool,
+    /// `--firmware-authoritative` only: `true` iff a firmware message reported the selected TEC's
+    /// safety interlock in a safe state (`"safe, unlocking"` or `"unlocked"`) -- the
+    /// firmware-authoritative counterpart of `selected_tec_safety_passed` (which this mode also
+    /// populates identically; both fields are set together).
+    pub explicit_firmware_safety_passed: bool,
+    /// `--firmware-authoritative` only: `true` iff a recognized negative firmware safety-fault
+    /// message (see `cool_test::is_generic_fault_message`) was observed -- always accompanies a
+    /// `FirmwareSafetyFault` stop when `true`, never inferred from missing telemetry.
+    pub explicit_firmware_fault_observed: bool,
+    /// `--firmware-authoritative` only: how many non-fatal "missing telemetry" warnings this run
+    /// logged (sensor-unavailable messages observed, or no TEC-current/fan/pump-command telemetry
+    /// observed at all by the end of the run) -- never itself a reason to stop.
+    pub telemetry_warning_count: u64,
+    /// `--firmware-authoritative` only: `true` iff the independent shutdown guard (`guard.rs`) was
+    /// spawned as a separate process for this run. Always `false` for `--dry-run` (no real
+    /// hardware for it to protect) and for legacy-mode runs.
+    pub independent_guard_armed: bool,
+    /// `--firmware-authoritative` only: `true` iff this run's own verified shutdown successfully
+    /// disarmed the independent guard. `false` while `independent_guard_armed` is also `false`
+    /// (nothing to disarm), or if shutdown could not be verified (the guard is deliberately left
+    /// armed in that case -- see `cool_test.rs`) or the disarm write itself failed.
+    pub independent_guard_disarmed: bool,
+
+    // ---- `[temps]` firmware health telemetry (see cool_test::parse_temps_health_report) ----
+    /// The most recently reported failed-read count from `"FW: [temps] <failed> reads failed out
+    /// of <total>"`. Purely descriptive -- a nonzero count is never itself a reason to stop; a
+    /// live-hardware run's own zero-failure report was misclassified as a firmware safety fault
+    /// by an earlier revision's generic keyword scan before this parser was added.
+    pub temperature_reads_failed: Option<u64>,
+    /// The most recently reported total-read count from the same message.
+    pub temperature_reads_total: Option<u64>,
+    /// `temperature_reads_failed / temperature_reads_total` from the same message, `None` if
+    /// neither has been observed yet or the reported total was zero.
+    pub temperature_read_failure_ratio: Option<f64>,
+
+    // ---- Fan telemetry (see cool_test::parse_fan_report) -- global Hub thermal management,
+    // never scoped to either cooling side; there is no left/right fan. ----
+    pub top_fan_activity_observed: bool,
+    pub top_fan_latest_duty: Option<f64>,
+    pub top_fan_latest_rpm: Option<f64>,
+    pub top_fan_max_rpm: Option<f64>,
+    pub bottom_fan_activity_observed: bool,
+    pub bottom_fan_latest_duty: Option<f64>,
+    pub bottom_fan_latest_rpm: Option<f64>,
+    pub bottom_fan_max_rpm: Option<f64>,
+}
