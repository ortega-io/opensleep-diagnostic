index 0000000..f9dd922
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/sensor_phase.rs
@@ -0,0 +1,620 @@
+//! Sensor subsystem diagnostic: try firmware baud first, fall back to bootloader baud, and only
+//! with `--allow-firmware-jump` send JumpToFirmware and re-probe at firmware baud. Never enters
+//! `opensleep::sensor::manager::run`'s command scheduler; never enables vibration, piezo, an
+//! alarm, or a temperature probe.
+
+use std::io;
+use std::pin::Pin;
+use std::task::{Context, Poll};
+use std::time::Duration;
+
+use async_trait::async_trait;
+use opensleep::common::codec::PacketCodec;
+use opensleep::common::packet::HardwareInfo;
+use opensleep::common::serial::create_port;
+use opensleep::sensor::SensorPacket;
+use tokio::io::{AsyncRead, AsyncWrite, DuplexStream, ReadBuf};
+use tokio_serial::SerialStream;
+use tokio_util::codec::Framed;
+
+use crate::io_logging::LoggingIo;
+use crate::safety::{SENSOR_WHITELIST, SafetyAudit, SensorProbe};
+use crate::transport::{ExchangeOutcome, HasHardwareInfo, PongPacket, send_and_await};
+
+pub const BOOTLOADER_BAUD: u32 = 38400;
+pub const FIRMWARE_BAUD: u32 = 115200;
+/// Settle time after JumpToFirmware before reopening the port at firmware baud. The normal
+/// OpenSleep manager instead polls for a device-mode change driven by its full packet loop; this
+/// diagnostic does not run that loop, so a fixed settle delay is used instead.
+const POST_JUMP_SETTLE: Duration = Duration::from_millis(300);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum DetectedMode {
+    Firmware,
+    Bootloader,
+    #[default]
+    Unavailable,
+}
+
+impl std::fmt::Display for DetectedMode {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let s = match self {
+            DetectedMode::Firmware => "firmware",
+            DetectedMode::Bootloader => "bootloader",
+            DetectedMode::Unavailable => "unavailable",
+        };
+        write!(f, "{s}")
+    }
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct SensorPhaseResult {
+    pub firmware_port_opened: bool,
+    pub bootloader_port_opened: bool,
+    pub detected_mode: DetectedMode,
+    pub ping_ok: bool,
+    pub hardware_info: Option<HardwareInfo>,
+    pub firmware_hash_probed: bool,
+    pub firmware_jump_sent: bool,
+    pub post_jump_ping_ok: bool,
+    pub post_jump_hardware_info: Option<HardwareInfo>,
+}
+
+/// Either a real serial port or (in tests) an in-memory duplex stream. A concrete enum -- rather
+/// than a `Box<dyn AsyncRead + AsyncWrite>` -- so both variants are trivially `Unpin` and `Send`
+/// with no trait-object plumbing.
+pub enum AnyIo {
+    Serial(SerialStream),
+    #[allow(dead_code)] // constructed by the test-only `SensorPortOpener` impls in `tests`
+    Duplex(DuplexStream),
+}
+
+impl AsyncRead for AnyIo {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        match self.get_mut() {
+            AnyIo::Serial(s) => Pin::new(s).poll_read(cx, buf),
+            AnyIo::Duplex(s) => Pin::new(s).poll_read(cx, buf),
+        }
+    }
+}
+
+impl AsyncWrite for AnyIo {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        match self.get_mut() {
+            AnyIo::Serial(s) => Pin::new(s).poll_write(cx, buf),
+            AnyIo::Duplex(s) => Pin::new(s).poll_write(cx, buf),
+        }
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        match self.get_mut() {
+            AnyIo::Serial(s) => Pin::new(s).poll_flush(cx),
+            AnyIo::Duplex(s) => Pin::new(s).poll_flush(cx),
+        }
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        match self.get_mut() {
+            AnyIo::Serial(s) => Pin::new(s).poll_shutdown(cx),
+            AnyIo::Duplex(s) => Pin::new(s).poll_shutdown(cx),
+        }
+    }
+}
+
+type SensorFramed = Framed<LoggingIo<AnyIo>, PacketCodec<SensorPacket>>;
+
+/// Abstracts "open the Sensor UART at a given baud" so the exact same reopen-after-jump
+/// orchestration logic below can run against real hardware or a scripted test double.
+#[async_trait]
+pub trait SensorPortOpener: Send {
+    async fn open_firmware(&mut self) -> io::Result<SensorFramed>;
+    async fn open_bootloader(&mut self) -> io::Result<SensorFramed>;
+}
+
+pub struct RealSensorPorts {
+    pub path: String,
+}
+
+#[async_trait]
+impl SensorPortOpener for RealSensorPorts {
+    async fn open_firmware(&mut self) -> io::Result<SensorFramed> {
+        let raw = create_port(&self.path, FIRMWARE_BAUD).map_err(io::Error::other)?;
+        log::info!(
+            "Sensor UART opened: {} @ {FIRMWARE_BAUD} baud, 8N1, no flow control",
+            self.path
+        );
+        Ok(Framed::new(
+            LoggingIo::new(AnyIo::Serial(raw), "Sensor(fw)"),
+            PacketCodec::new(),
+        ))
+    }
+
+    async fn open_bootloader(&mut self) -> io::Result<SensorFramed> {
+        let raw = create_port(&self.path, BOOTLOADER_BAUD).map_err(io::Error::other)?;
+        log::info!(
+            "Sensor UART opened: {} @ {BOOTLOADER_BAUD} baud, 8N1, no flow control",
+            self.path
+        );
+        Ok(Framed::new(
+            LoggingIo::new(AnyIo::Serial(raw), "Sensor(bl)"),
+            PacketCodec::new(),
+        ))
+    }
+}
+
+pub async fn run_sensor_phase(
+    port: &str,
+    timeout: Duration,
+    allow_firmware_jump: bool,
+) -> (SensorPhaseResult, SafetyAudit) {
+    let mut audit = SafetyAudit::new(SENSOR_WHITELIST);
+    let mut opener = RealSensorPorts {
+        path: port.to_string(),
+    };
+    let result =
+        run_sensor_phase_generic(&mut opener, timeout, allow_firmware_jump, &mut audit).await;
+    (result, audit)
+}
+
+async fn fetch_hardware_info(
+    framed: &mut SensorFramed,
+    audit: &mut SafetyAudit,
+    timeout: Duration,
+) -> Option<HardwareInfo> {
+    match send_and_await(framed, audit, SensorProbe::GetHardwareInfo.command(), timeout).await {
+        Ok(ExchangeOutcome::Received(pkt)) => match pkt.as_hardware_info() {
+            Some(hw) => Some(hw.clone()),
+            None => {
+                log::warn!("Sensor GetHardwareInfo got unexpected packet: {pkt:?}");
+                None
+            }
+        },
+        Ok(_) => {
+            log::warn!("Sensor did not respond to GetHardwareInfo within {timeout:?}");
+            None
+        }
+        Err(e) => {
+            log::error!("Sensor GetHardwareInfo failed: {e}");
+            None
+        }
+    }
+}
+
+async fn probe_firmware_hash(
+    framed: &mut SensorFramed,
+    audit: &mut SafetyAudit,
+    timeout: Duration,
+) -> bool {
+    match send_and_await(framed, audit, SensorProbe::GetFirmwareHash.command(), timeout).await {
+        Ok(ExchangeOutcome::Received(pkt)) => {
+            log::info!("Sensor GetFirmwareHash: {pkt:?}");
+            true
+        }
+        Ok(_) => {
+            log::debug!("Sensor did not respond to GetFirmwareHash within {timeout:?}");
+            false
+        }
+        Err(e) => {
+            log::debug!("Sensor GetFirmwareHash failed: {e}");
+            false
+        }
+    }
+}
+
+pub async fn run_sensor_phase_generic<O: SensorPortOpener>(
+    opener: &mut O,
+    timeout: Duration,
+    allow_firmware_jump: bool,
+    audit: &mut SafetyAudit,
+) -> SensorPhaseResult {
+    let mut result = SensorPhaseResult::default();
+
+    // 1. Firmware mode first, at 115200 baud.
+    if let Ok(mut framed) = opener.open_firmware().await.inspect_err(|e| {
+        log::error!("failed to open Sensor port at firmware baud: {e}");
+    }) {
+        result.firmware_port_opened = true;
+        match send_and_await(&mut framed, audit, SensorProbe::Ping.command(), timeout).await {
+            Ok(ExchangeOutcome::Received(pkt)) => match pkt.as_pong() {
+                Some(in_firmware) => {
+                    result.detected_mode = DetectedMode::Firmware;
+                    result.ping_ok = true;
+                    if !in_firmware {
+                        log::warn!(
+                            "Sensor responded at firmware baud but its Pong reports bootloader"
+                        );
+                    }
+                }
+                None => log::warn!("Sensor Ping (firmware attempt) got unexpected packet: {pkt:?}"),
+            },
+            Ok(_) => log::info!(
+                "Sensor did not respond to Ping at firmware baud ({FIRMWARE_BAUD}); trying bootloader baud"
+            ),
+            Err(e) => log::warn!("Sensor Ping (firmware attempt) failed: {e}"),
+        }
+
+        if result.ping_ok {
+            result.hardware_info = fetch_hardware_info(&mut framed, audit, timeout).await;
+            result.firmware_hash_probed = probe_firmware_hash(&mut framed, audit, timeout).await;
+            return result;
+        }
+    }
+
+    // 2. Bootloader mode, at 38400 baud. Ping only, per spec.
+    let mut bootloader_framed = match opener.open_bootloader().await {
+        Ok(f) => {
+            result.bootloader_port_opened = true;
+            Some(f)
+        }
+        Err(e) => {
+            log::error!("failed to open Sensor port at bootloader baud: {e}");
+            None
+        }
+    };
+
+    if let Some(framed) = bootloader_framed.as_mut() {
+        match send_and_await(framed, audit, SensorProbe::Ping.command(), timeout).await {
+            Ok(ExchangeOutcome::Received(pkt)) => match pkt.as_pong() {
+                Some(in_firmware) => {
+                    result.detected_mode = DetectedMode::Bootloader;
+                    result.ping_ok = true;
+                    if in_firmware {
+                        log::warn!(
+                            "Sensor responded at bootloader baud but its Pong reports firmware"
+                        );
+                    }
+                }
+                None => {
+                    log::warn!("Sensor Ping (bootloader attempt) got unexpected packet: {pkt:?}")
+                }
+            },
+            Ok(_) => log::info!(
+                "Sensor did not respond to Ping at bootloader baud ({BOOTLOADER_BAUD}) either"
+            ),
+            Err(e) => log::warn!("Sensor Ping (bootloader attempt) failed: {e}"),
+        }
+    }
+
+    if result.detected_mode != DetectedMode::Bootloader {
+        result.detected_mode = DetectedMode::Unavailable;
+        return result;
+    }
+
+    if !allow_firmware_jump {
+        log::info!(
+            "Sensor appears to be in its bootloader; not sending JumpToFirmware (pass --allow-firmware-jump to opt in)"
+        );
+        return result;
+    }
+
+    log::warn!(
+        "Sensor appears to be in its bootloader; --allow-firmware-jump supplied, sending JumpToFirmware"
+    );
+    if let Some(mut framed) = bootloader_framed {
+        match send_and_await(&mut framed, audit, SensorProbe::JumpToFirmware.command(), timeout)
+            .await
+        {
+            Ok(ExchangeOutcome::Received(pkt)) => {
+                result.firmware_jump_sent = true;
+                log::info!("Sensor JumpToFirmware response: {pkt:?}");
+            }
+            Ok(_) => {
+                result.firmware_jump_sent = true;
+                log::warn!("Sensor did not respond to JumpToFirmware within {timeout:?}");
+            }
+            Err(e) => log::error!("Sensor JumpToFirmware failed: {e}"),
+        }
+        drop(framed);
+    }
+
+    tokio::time::sleep(POST_JUMP_SETTLE).await;
+
+    match opener.open_firmware().await {
+        Ok(mut framed) => {
+            match send_and_await(&mut framed, audit, SensorProbe::Ping.command(), timeout).await {
+                Ok(ExchangeOutcome::Received(pkt)) => {
+                    if pkt.as_pong().is_some() {
+                        result.post_jump_ping_ok = true;
+                    } else {
+                        log::warn!("Sensor post-jump Ping got unexpected packet: {pkt:?}");
+                    }
+                }
+                Ok(_) => log::warn!("Sensor did not respond to post-jump Ping within {timeout:?}"),
+                Err(e) => log::error!("Sensor post-jump Ping failed: {e}"),
+            }
+            if result.post_jump_ping_ok {
+                result.post_jump_hardware_info =
+                    fetch_hardware_info(&mut framed, audit, timeout).await;
+            }
+        }
+        Err(e) => log::error!("failed to reopen Sensor port at firmware baud after jump: {e}"),
+    }
+
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bytes::{Buf, BytesMut};
+    use tokio::sync::mpsc;
+
+    fn pong_frame(in_firmware: bool) -> Vec<u8> {
+        let code: u8 = if in_firmware { 0b0100_0110 } else { 0b0100_0010 };
+        opensleep::common::codec::command(vec![0x81, 0x00, code])
+    }
+
+    /// Reads whole frames off `device_side` and replies per `script`, keyed by opcode. Any
+    /// opcode not in `script` is recorded but gets no reply (matching real hardware silently
+    /// ignoring or not implementing an unknown command).
+    async fn run_fake_device(
+        mut device_side: DuplexStream,
+        script: std::collections::HashMap<u8, Vec<u8>>,
+        seen_tx: mpsc::UnboundedSender<u8>,
+    ) {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let mut acc = BytesMut::new();
+        let mut read_buf = [0u8; 256];
+        loop {
+            if acc.len() >= 2 {
+                let len = acc[1] as usize;
+                let total = 1 + 1 + len + 2;
+                if acc.len() >= total {
+                    let opcode = acc[2];
+                    acc.advance(total);
+                    let _ = seen_tx.send(opcode);
+                    if let Some(response) = script.get(&opcode)
+                        && device_side.write_all(response).await.is_err()
+                    {
+                        return;
+                    }
+                    continue;
+                }
+            }
+            let n = match device_side.read(&mut read_buf).await {
+                Ok(0) | Err(_) => return,
+                Ok(n) => n,
+            };
+            acc.extend_from_slice(&read_buf[..n]);
+        }
+    }
+
+    /// Test opener: firmware attempt is a duplex pair with no device on the far end (so Ping
+    /// always times out), bootloader attempt is a duplex pair with a scripted fake device.
+    struct BootloaderOnlyOpener {
+        script: std::collections::HashMap<u8, Vec<u8>>,
+        seen_tx: mpsc::UnboundedSender<u8>,
+    }
+
+    #[async_trait]
+    impl SensorPortOpener for BootloaderOnlyOpener {
+        async fn open_firmware(&mut self) -> io::Result<SensorFramed> {
+            let (client, _device_dropped_immediately) = tokio::io::duplex(4096);
+            Ok(Framed::new(
+                LoggingIo::new(AnyIo::Duplex(client), "test-fw"),
+                PacketCodec::new(),
+            ))
+        }
+
+        async fn open_bootloader(&mut self) -> io::Result<SensorFramed> {
+            let (client, device) = tokio::io::duplex(4096);
+            tokio::spawn(run_fake_device(
+                device,
+                self.script.clone(),
+                self.seen_tx.clone(),
+            ));
+            Ok(Framed::new(
+                LoggingIo::new(AnyIo::Duplex(client), "test-bl"),
+                PacketCodec::new(),
+            ))
+        }
+    }
+
+    /// Test opener where both firmware and bootloader attempts have a live fake device (used for
+    /// the JumpToFirmware -> reopen-at-firmware-baud path, which calls `open_firmware` twice).
+    ///
+    /// The *first* `open_firmware` call (the initial "try firmware mode first" probe) is always
+    /// left unanswered, so the phase logic falls through to the bootloader attempt exactly like
+    /// it would against real hardware that boots into its bootloader. Only the *second* call
+    /// (the post-JumpToFirmware reopen) gets a live scripted device.
+    struct ScriptedOpener {
+        firmware_script: std::collections::HashMap<u8, Vec<u8>>,
+        bootloader_script: std::collections::HashMap<u8, Vec<u8>>,
+        seen_tx: mpsc::UnboundedSender<u8>,
+        firmware_opens: std::sync::Arc<std::sync::atomic::AtomicUsize>,
+        /// Whether the *first* `open_firmware` call (the initial "try firmware mode first"
+        /// probe) gets a live device. Every call after the first always does, so the
+        /// post-JumpToFirmware reopen can be tested independently of the initial attempt.
+        answer_first_firmware_call: bool,
+    }
+
+    #[async_trait]
+    impl SensorPortOpener for ScriptedOpener {
+        async fn open_firmware(&mut self) -> io::Result<SensorFramed> {
+            let call_num = self
+                .firmware_opens
+                .fetch_add(1, std::sync::atomic::Ordering::SeqCst)
+                + 1;
+            let (client, device) = tokio::io::duplex(4096);
+            if call_num >= 2 || self.answer_first_firmware_call {
+                tokio::spawn(run_fake_device(
+                    device,
+                    self.firmware_script.clone(),
+                    self.seen_tx.clone(),
+                ));
+            }
+            // else: no device is attached to the far end, so any Ping sent on the first
+            // (pre-jump) firmware attempt goes unanswered, exactly like real bootloader-mode
+            // hardware would ignore a Ping sent at the wrong baud.
+            Ok(Framed::new(
+                LoggingIo::new(AnyIo::Duplex(client), "test-fw"),
+                PacketCodec::new(),
+            ))
+        }
+
+        async fn open_bootloader(&mut self) -> io::Result<SensorFramed> {
+            let (client, device) = tokio::io::duplex(4096);
+            tokio::spawn(run_fake_device(
+                device,
+                self.bootloader_script.clone(),
+                self.seen_tx.clone(),
+            ));
+            Ok(Framed::new(
+                LoggingIo::new(AnyIo::Duplex(client), "test-bl"),
+                PacketCodec::new(),
+            ))
+        }
+    }
+
+    #[tokio::test]
+    async fn firmware_mode_detected_when_it_answers_first() {
+        let (seen_tx, mut seen_rx) = mpsc::unbounded_channel();
+        let mut firmware_script = std::collections::HashMap::new();
+        firmware_script.insert(0x01u8, pong_frame(true));
+        let mut opener = ScriptedOpener {
+            firmware_script,
+            bootloader_script: std::collections::HashMap::new(),
+            seen_tx,
+            firmware_opens: Default::default(),
+            answer_first_firmware_call: true,
+        };
+        let mut audit = SafetyAudit::new(SENSOR_WHITELIST);
+        let result = run_sensor_phase_generic(
+            &mut opener,
+            Duration::from_millis(300),
+            false,
+            &mut audit,
+        )
+        .await;
+
+        assert_eq!(result.detected_mode, DetectedMode::Firmware);
+        assert!(result.ping_ok);
+        assert!(!result.bootloader_port_opened);
+        seen_rx.close();
+        let mut seen = Vec::new();
+        while let Some(op) = seen_rx.recv().await {
+            seen.push(op);
+        }
+        assert!(seen.contains(&0x01));
+    }
+
+    #[tokio::test]
+    async fn falls_back_to_bootloader_when_firmware_does_not_answer() {
+        let (seen_tx, _seen_rx) = mpsc::unbounded_channel();
+        let mut script = std::collections::HashMap::new();
+        script.insert(0x01u8, pong_frame(false));
+        let mut opener = BootloaderOnlyOpener { script, seen_tx };
+
+        let mut audit = SafetyAudit::new(SENSOR_WHITELIST);
+        let result = run_sensor_phase_generic(
+            &mut opener,
+            Duration::from_millis(150),
+            false,
+            &mut audit,
+        )
+        .await;
+
+        assert_eq!(result.detected_mode, DetectedMode::Bootloader);
+        assert!(result.ping_ok);
+        assert!(result.firmware_port_opened);
+        assert!(result.bootloader_port_opened);
+        assert!(!result.firmware_jump_sent);
+    }
+
+    #[tokio::test]
+    async fn neither_mode_answers_reports_unavailable() {
+        let (seen_tx, _seen_rx) = mpsc::unbounded_channel();
+        let mut opener = BootloaderOnlyOpener {
+            script: std::collections::HashMap::new(), // bootloader device never replies either
+            seen_tx,
+        };
+
+        let mut audit = SafetyAudit::new(SENSOR_WHITELIST);
+        let result = run_sensor_phase_generic(
+            &mut opener,
+            Duration::from_millis(100),
+            false,
+            &mut audit,
+        )
+        .await;
+
+        assert_eq!(result.detected_mode, DetectedMode::Unavailable);
+        assert!(!result.ping_ok);
+    }
+
+    #[tokio::test]
+    async fn jump_to_firmware_not_sent_without_opt_in_even_in_bootloader() {
+        let (seen_tx, mut seen_rx) = mpsc::unbounded_channel();
+        let mut script = std::collections::HashMap::new();
+        script.insert(0x01u8, pong_frame(false));
+        let mut opener = BootloaderOnlyOpener { script, seen_tx };
+
+        let mut audit = SafetyAudit::new(SENSOR_WHITELIST);
+        let result = run_sensor_phase_generic(
+            &mut opener,
+            Duration::from_millis(150),
+            false, // NOT allowed
+            &mut audit,
+        )
+        .await;
+
+        assert_eq!(result.detected_mode, DetectedMode::Bootloader);
+        assert!(!result.firmware_jump_sent);
+        assert!(!audit.sent_frames().iter().any(|f| f.get(2) == Some(&0x10)));
+
+        seen_rx.close();
+        let mut seen = Vec::new();
+        while let Some(op) = seen_rx.recv().await {
+            seen.push(op);
+        }
+        assert!(!seen.contains(&0x10));
+    }
+
+    #[tokio::test]
+    async fn jump_to_firmware_reopens_at_firmware_baud_when_allowed() {
+        let (seen_tx, _seen_rx) = mpsc::unbounded_channel();
+        let mut bootloader_script = std::collections::HashMap::new();
+        bootloader_script.insert(0x01u8, pong_frame(false));
+        bootloader_script.insert(
+            0x10u8,
+            opensleep::common::codec::command(vec![0x90, 0x00]),
+        );
+        let mut firmware_script = std::collections::HashMap::new();
+        firmware_script.insert(0x01u8, pong_frame(true));
+
+        let firmware_opens = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let mut opener = ScriptedOpener {
+            firmware_script,
+            bootloader_script,
+            seen_tx,
+            firmware_opens: firmware_opens.clone(),
+            answer_first_firmware_call: false,
+        };
+
+        let mut audit = SafetyAudit::new(SENSOR_WHITELIST);
+        let result = run_sensor_phase_generic(
+            &mut opener,
+            Duration::from_millis(300),
+            true, // allowed
+            &mut audit,
+        )
+        .await;
+
+        assert_eq!(result.detected_mode, DetectedMode::Bootloader);
+        assert!(result.firmware_jump_sent);
+        assert!(result.post_jump_ping_ok);
+        assert_eq!(firmware_opens.load(std::sync::atomic::Ordering::SeqCst), 2);
+        assert!(audit.sent_frames().iter().any(|f| f.get(2) == Some(&0x10)));
+        for frame in audit.sent_frames() {
+            assert!(SENSOR_WHITELIST.contains(&frame[2]));
+        }
+    }
+}
