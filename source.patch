+#[derive(Debug, Clone)]
+#[allow(dead_code)] // register/value are logged individually in `write_reg`; kept for callers/tests that want per-step detail
+pub struct ResetStepResult {
+    pub register: u8,
+    pub value: u8,
+    pub success: bool,
+    pub os_error: Option<i32>,
+}
+
+/// Mirrors `opensleep::reset::ResetController::reset_subsystems`'s exact register/value/timing
+/// sequence: config both ports, assert reset, wait, de-assert (enable), wait. Every write is
+/// logged individually; a failure does not abort the remaining steps.
+pub async fn run_reset_sequence<P: I2cPort>(dev: &mut P) -> (Vec<ResetStepResult>, Instant) {
+    let mut results = Vec::with_capacity(4);
+
+    results.push(write_reg(dev, REG_CONFIG_PORT_0, PORT_0_CONFIG));
+    results.push(write_reg(dev, REG_CONFIG_PORT_1, PORT_1_CONFIG));
+    sleep(Duration::from_millis(10)).await;
+
+    results.push(write_reg(dev, REG_OUTPUT_PORT_0, OUTPUT_RESET));
+    sleep(Duration::from_millis(100)).await;
+
+    results.push(write_reg(dev, REG_OUTPUT_PORT_0, OUTPUT_ENABLED));
+    sleep(Duration::from_millis(100)).await;
+
+    let reset_release = Instant::now();
+    log::info!("reset release completed at monotonic +0 ms");
+
+    (results, reset_release)
+}
+
+/// Used by safe-stop and `emergency-stop`: a single write asserting reset (`reg 0x02 <- 0xFF`),
+/// deliberately not followed by the de-assert/enable write, so the subsystem is left held in
+/// reset. This is the only I2C action either of those two paths ever performs.
+pub async fn assert_reset<P: I2cPort>(dev: &mut P) -> ResetStepResult {
+    write_reg(dev, REG_OUTPUT_PORT_0, OUTPUT_RESET)
+}
+
+/// The result of a narrow, read-modify-write operation on register 0x02 -- see
+/// [`pulse_frozen_reset_bit`]/[`assert_frozen_reset_bit_only`].
+#[derive(Debug, Clone, Copy, Default)]
+pub struct RegBitReadModifyWriteResult {
+    pub original: u8,
+    pub target: u8,
+    pub changed_mask: u8,
+    pub readback: u8,
+    /// `true` iff the readback exactly equals what was written.
+    pub readback_matches: bool,
+    /// `true` iff `changed_mask` is a subset of [`FROZEN_RESET_BIT`] -- i.e. no bit other than bit
+    /// 1 differs between `original` and `target`. Callers must check this (and
+    /// `readback_matches`) before treating the operation as safe to proceed past.
+    pub only_bit1_changed: bool,
+}
+
+/// Shared by register 0x02 (output latch) and register 0x06 (direction/config): reads `reg`,
+/// computes a new value via `transform`, verifies mathematically (before writing) that the change
+/// touches only bit 1, writes it, and reads it back to verify. `reg_label` is used only in log
+/// lines (e.g. `"0x02"`/`"0x06"`).
+async fn read_modify_write_reg<P: I2cPort>(
+    dev: &mut P,
+    reg: u8,
+    reg_label: &str,
+    transform: impl FnOnce(u8) -> u8,
+    target_label: &str,
+) -> Result<RegBitReadModifyWriteResult, I2cIoError> {
+    let original = dev.read_reg(RESET_EXPANDER_ADDR, reg)?;
+    let target = transform(original);
+    let changed_mask = original ^ target;
+    log::info!("original register {reg_label}: 0b{original:08b} (0x{original:02X})");
+    log::info!("{target_label} register {reg_label}: 0b{target:08b} (0x{target:02X})");
+    log::info!("changed-bit mask: 0b{changed_mask:08b} (0x{changed_mask:02X})");
+    // Verified mathematically, before any write is issued: every `transform` this function is
+    // ever called with is either `original | FROZEN_RESET_BIT` or `original & !FROZEN_RESET_BIT`,
+    // both of which can only ever differ from `original` in bit 1 -- this can never actually fail,
+    // but is asserted (not merely logged) as a structural proof of that claim rather than an
+    // assumption.
+    assert_eq!(
+        changed_mask & !FROZEN_RESET_BIT,
+        0,
+        "computed target for register {reg_label} would change a bit other than bit 1 (original=0b{original:08b} target=0b{target:08b})"
+    );
+    dev.write_reg(RESET_EXPANDER_ADDR, reg, target)?;
+    let readback = dev.read_reg(RESET_EXPANDER_ADDR, reg)?;
+    log::info!("readback result: 0b{readback:08b} (0x{readback:02X})");
+    Ok(RegBitReadModifyWriteResult {
+        original,
+        target,
+        changed_mask,
+        readback,
+        readback_matches: readback == target,
+        only_bit1_changed: (changed_mask & !FROZEN_RESET_BIT) == 0,
+    })
+}
+
+async fn read_modify_write_reg02<P: I2cPort>(
+    dev: &mut P,
+    transform: impl FnOnce(u8) -> u8,
+    target_label: &str,
+) -> Result<RegBitReadModifyWriteResult, I2cIoError> {
+    read_modify_write_reg(dev, REG_OUTPUT_PORT_0, "0x02", transform, target_label).await
+}
+
+/// The result of the register-0x06 direction/config half of [`pulse_frozen_reset_bit`]: whether
+/// bit 1 was already configured as an output before this write (`0` = output, `1` = input/high-Z
+/// on the PCAL6416A), which is exactly the evidence that explains why an earlier revision's
+/// output-register-only pulse produced no physical edge -- the pin was never actually driven.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Reg06ConfigResult {
+    pub inner: RegBitReadModifyWriteResult,
+    /// `true` iff bit 1 of register 0x06 already read `0` (output) before this write; `false` iff
+    /// it read `1` (input/high-Z), meaning this write is what first enables the pin to be driven.
+    pub bit1_was_already_output: bool,
+}
+
+/// The result of [`pulse_frozen_reset_bit`]: the output-latch prep, the direction/config write, and
+/// the release, each verified independently, plus how long bit 1 was actually held asserted *while
+/// configured as an output* (i.e. while physically driven).
+#[derive(Debug, Clone, Copy, Default)]
+pub struct Reg02PulseResult {
+    /// Prepares the output latch to the asserted level *before* the pin is configured as an output
+    /// (see [`pulse_frozen_reset_bit`]'s doc comment for why this ordering avoids a glitch).
+    pub assert_output_step: RegBitReadModifyWriteResult,
+    /// Configures only bit 1 of register 0x06 as an output; never touches bit 0 or any other bit.
+    pub config_step: Reg06ConfigResult,
+    pub release_step: RegBitReadModifyWriteResult,
+    pub pulse_duration: Duration,
+}
+
+impl Reg02PulseResult {
+    /// `true` iff every step verified: each write's readback matched what was written, and each
+    /// write changed only bit 1 (of its own register).
+    pub fn fully_verified(&self) -> bool {
+        self.assert_output_step.readback_matches
+            && self.assert_output_step.only_bit1_changed
+            && self.config_step.inner.readback_matches
+            && self.config_step.inner.only_bit1_changed
+            && self.release_step.readback_matches
+            && self.release_step.only_bit1_changed
+    }
+}
+
+/// Releases Frozen from reset with a low->high->low **pulse** of *only* bit 1 of register 0x02
+/// (the output latch) -- but first, only bit 1 of register 0x06 (direction/config) is configured
+/// as an output, since on the PCAL6416A a bit configured as an input (the power-on-reset default)
+/// ignores its output-latch value entirely: writing register 0x02 alone changes what the chip
+/// *would* drive if configured as an output, not the physical pin. Real hardware evidence: an
+/// earlier revision pulsed only register 0x02 (readbacks all verified, `0xFD -> 0xFF -> 0xFD`) and
+/// Frozen still never responded -- register 0x06 was never written, so bit 1 was never actually an
+/// output. The original, confirmed-working upstream reset sequence writes register 0x06 to `0xFC`
+/// (bits 0 and 1 as outputs) as one of its first two writes, which this function's own bit-1-only
+/// analog now mirrors, alongside never touching the four-register full reset sequence
+/// ([`run_reset_sequence`]) or `opensleep::reset::ResetController`, and never register 0x07 at all.
+///
+/// Ordering matters: bit 1's output latch (register 0x02) is set to the *asserted* level first,
+/// before bit 1 becomes an output (register 0x06) -- so the instant the pin starts being driven, it
+/// drives the already-intended asserted level, rather than whatever register 0x02 happened to
+/// already read (avoiding an unintended release glitch on the line). Only once the pin is
+/// confirmed configured as an output is the assert level actually held for [`PULSE_SETTLE`] and
+/// then released. Register 0x06 is deliberately **not** restored to its original value afterward:
+/// the reset line must remain actively driven (an output), not float back to high-impedance.
+///
+/// Every value written to either register is computed from what was actually read at that step
+/// (never a hardcoded constant), each write's readback is verified, and each write is re-checked
+/// to have changed only bit 1 of its own register (see [`read_modify_write_reg`]'s `assert_eq!`).
+/// Callers must check the returned result's [`Reg02PulseResult::fully_verified`] before proceeding,
+/// and must not treat a successful I2C transaction alone as sufficient confirmation.
+pub async fn pulse_frozen_reset_bit<P: I2cPort>(dev: &mut P) -> Result<Reg02PulseResult, I2cIoError> {
+    // Prepare the output latch to the asserted level before the pin becomes an output.
+    let assert_output_step =
+        read_modify_write_reg02(dev, |original| original | FROZEN_RESET_BIT, "asserted (output latch, pre-direction)").await?;
+
+    // Configure only bit 1 of register 0x06 as an output (0 = output on the PCAL6416A); never bit
+    // 0 or any other bit.
+    let config_original = dev.read_reg(RESET_EXPANDER_ADDR, REG_CONFIG_PORT_0)?;
+    let bit1_was_already_output = (config_original & FROZEN_RESET_BIT) == 0;
+    log::info!(
+        "bit 1 of register 0x06 was previously configured as: {}",
+        if bit1_was_already_output { "output" } else { "input" }
+    );
+    let config_inner = read_modify_write_reg(
+        dev,
+        REG_CONFIG_PORT_0,
+        "0x06",
+        |original| original & !FROZEN_RESET_BIT,
+        "configured-as-output",
+    )
+    .await?;
+    let config_step = Reg06ConfigResult {
+        inner: config_inner,
+        bit1_was_already_output,
+    };
+
+    // Only now is the pin actually driven -- hold the asserted level.
+    let pulse_start = Instant::now();
+    sleep(PULSE_SETTLE).await;
+    let pulse_duration = pulse_start.elapsed();
+
+    // Release. Register 0x06 is deliberately left configured as an output (see doc comment).
+    let release_step = read_modify_write_reg02(dev, |original| original & !FROZEN_RESET_BIT, "released").await?;
+
+    log::info!(
+        "pulse duration (driven asserted -> released): {pulse_duration:?} -- changed masks: \
+         output-latch-prep=0b{:08b} config=0b{:08b} release=0b{:08b}",
+        assert_output_step.changed_mask, config_step.inner.changed_mask, release_step.changed_mask
+    );
+    Ok(Reg02PulseResult {
+        assert_output_step,
+        config_step,
+        release_step,
+        pulse_duration,
+    })
+}
+
+/// Emergency-only backstop for `--release-frozen-only`: re-asserts *only* bit 1 of register 0x02
+/// via a read-modify-write (`asserted = current | 0x02`), preserving every other bit -- unlike
+/// [`assert_reset`] (used by every other mode's safe-stop/`emergency-stop`), which unconditionally
+/// writes the hardcoded value `0xFF` regardless of the register's current contents. Never touches
+/// 0x06/0x07.
+pub async fn assert_frozen_reset_bit_only<P: I2cPort>(dev: &mut P) -> Result<RegBitReadModifyWriteResult, I2cIoError> {
+    read_modify_write_reg02(dev, |original| original | FROZEN_RESET_BIT, "asserted").await
+}
+
+fn write_reg<P: I2cPort>(dev: &mut P, reg: u8, value: u8) -> ResetStepResult {
+    let result = dev.write_reg(RESET_EXPANDER_ADDR, reg, value);
+    let success = result.is_ok();
+    let os_error = result.err().and_then(|e| e.os_error);
+    log::info!(
+        "reset-expander write: reg=0x{reg:02X} value=0x{value:02X} -> {}",
+        if success {
+            "success".to_string()
+        } else {
+            format!("failed (errno {os_error:?})")
+        }
+    );
+    ResetStepResult {
+        register: reg,
+        value,
+        success,
+        os_error,
+    }
+}
+
+/// Bit 0 of registers 0x02/0x06 -- an unproven candidate Sensor enable/reset-release/power-enable
+/// line. Real hardware evidence motivating this: upstream OpenSleep's own reset sequence configures
+/// register 0x06 to `0xFC` (bits 0 and 1 both outputs) and keeps register 0x02 bit 0 HIGH
+/// throughout -- never pulsing it low -- while this fork's own proven narrow Frozen-only
+/// initialization leaves register 0x06 at `0xFD` (bit 0 still an input; only bit 1 configured as an
+/// output). That is, only bit 0 differs between the two initialization paths, and upstream never
+/// drives it low. `sensor-probe --enable-suspected-sensor-line`
+/// ([`configure_suspected_sensor_enable_high`]) tests this hypothesis in the narrowest possible
+/// way: configure bit 0 as an output, driven HIGH, and nothing else -- never a pulse (unlike
+/// [`pulse_frozen_reset_bit`], which asserts then releases bit 1), never LOW, never touching bit 1
+/// or register 0x07. Deliberately a separate constant/helper from Frozen's bit 1 machinery, not a
+/// generalization of it -- see `sensor_probe.rs` module docs and SAFETY.md for the full rationale
+/// and every invariant this enforces.
+pub const SUSPECTED_SENSOR_ENABLE_BIT: u8 = 0b0000_0001;
+/// How long `sensor-probe --enable-suspected-sensor-line` waits after configuring bit 0 before
+/// beginning Sensor UART discovery -- gives the candidate line time to take effect if it really is
+/// an enable/reset-release line.
+pub const SUSPECTED_SENSOR_ENABLE_SETTLE: Duration = Duration::from_millis(500);
+
+/// The result of one narrow, bit-0-only read-modify-write step on register 0x02 or 0x06. Deliberately
+/// a distinct type from [`RegBitReadModifyWriteResult`] (Frozen's bit-1 analog): `only_bit0_changed`
+/// is named for what it actually checks, rather than reusing a bit-1-named field for a bit-0
+/// operation.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct SuspectedSensorBitStepResult {
+    pub original: u8,
+    pub target: u8,
+    pub changed_mask: u8,
+    pub readback: u8,
+    /// `true` iff the readback exactly equals what was written.
+    pub readback_matches: bool,
+    /// `true` iff `changed_mask` is a subset of [`SUSPECTED_SENSOR_ENABLE_BIT`] -- i.e. no bit
+    /// other than bit 0 differs between `original` and `target`. Callers must check this (and
+    /// `readback_matches`) before proceeding -- in particular, before any Sensor UART probing.
+    pub only_bit0_changed: bool,
+}
+
+/// Reads `reg`, computes a new value via `transform`, verifies mathematically (before writing) that
+/// the change touches only bit 0, writes it, and reads it back to verify. Bit-0 analog of
+/// `read_modify_write_reg` above; kept as an independent function (rather than generalizing that
+/// one to take an arbitrary bit mask) so this experimental, unproven-hypothesis code path can never
+/// accidentally affect Frozen's own proven, hardware-validated bit-1 pulse logic.
+async fn read_modify_write_bit0<P: I2cPort>(
+    dev: &mut P,
+    reg: u8,
+    reg_label: &str,
+    transform: impl FnOnce(u8) -> u8,
+    target_label: &str,
+) -> Result<SuspectedSensorBitStepResult, I2cIoError> {
+    let original = dev.read_reg(RESET_EXPANDER_ADDR, reg)?;
+    let target = transform(original);
+    let changed_mask = original ^ target;
+    log::info!("[sensor-line] original register {reg_label}: 0b{original:08b} (0x{original:02X})");
+    log::info!("[sensor-line] {target_label} register {reg_label}: 0b{target:08b} (0x{target:02X})");
+    log::info!("[sensor-line] changed-bit mask: 0b{changed_mask:08b} (0x{changed_mask:02X})");
+    // Verified mathematically, before any write is issued: every `transform` this function is ever
+    // called with is constructed as `original | SUSPECTED_SENSOR_ENABLE_BIT`,
+    // `original & !SUSPECTED_SENSOR_ENABLE_BIT`, or a restore merge of only that same bit, each of
+    // which can only ever differ from `original` in bit 0 -- this can never actually fail, but is
+    // asserted (not merely logged) as a structural proof of that claim rather than an assumption.
+    assert_eq!(
+        changed_mask & !SUSPECTED_SENSOR_ENABLE_BIT,
+        0,
+        "computed target for register {reg_label} would change a bit other than bit 0 (original=0b{original:08b} target=0b{target:08b})"
+    );
+    dev.write_reg(RESET_EXPANDER_ADDR, reg, target)?;
+    let readback = dev.read_reg(RESET_EXPANDER_ADDR, reg)?;
+    log::info!("[sensor-line] readback result: 0b{readback:08b} (0x{readback:02X})");
+    Ok(SuspectedSensorBitStepResult {
+        original,
+        target,
+        changed_mask,
+        readback,
+        readback_matches: readback == target,
+        only_bit0_changed: (changed_mask & !SUSPECTED_SENSOR_ENABLE_BIT) == 0,
+    })
+}
+
+/// The result of [`configure_suspected_sensor_enable_high`] or [`restore_suspected_sensor_bit`]:
+/// the register-0x02 (output latch) and register-0x06 (direction/config) steps, each independently
+/// verified.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct SuspectedSensorLineResult {
+    pub reg02: SuspectedSensorBitStepResult,
+    pub reg06: SuspectedSensorBitStepResult,
+}
+
+impl SuspectedSensorLineResult {
+    /// `true` iff every step verified: each write's readback matched what was written, and each
+    /// write changed only bit 0 (of its own register). Callers must check this before proceeding
+    /// to Sensor UART probing -- see `sensor_probe.rs`'s `expander_verification_failed` result.
+    pub fn fully_verified(&self) -> bool {
+        self.reg02.readback_matches
+            && self.reg02.only_bit0_changed
+            && self.reg06.readback_matches
+            && self.reg06.only_bit0_changed
+    }
+}
+
+/// **Experimental.** Configures only bit 0 of registers 0x02/0x06 -- output latch driven HIGH,
+/// direction set to output -- and nothing else. Never a pulse, never LOW, never bit 1, never
+/// register 0x07, never a whole-register constant (every value written is computed from what was
+/// actually read at that step). See [`SUSPECTED_SENSOR_ENABLE_BIT`]'s doc comment for the hardware
+/// evidence motivating this, and `sensor_probe.rs`/SAFETY.md for the full experimental design.
+///
+/// Ordering mirrors [`pulse_frozen_reset_bit`]'s own documented reasoning: the output latch
+/// (register 0x02) is set to the intended HIGH level *before* bit 0 becomes an output (register
+/// 0x06), so the instant the pin starts being driven, it drives the already-intended level rather
+/// than glitching on whatever the latch happened to already read. Register 0x02's write is always
+/// issued (even when the original value already has bit 0 high, mirroring
+/// [`pulse_frozen_reset_bit`]'s own "never skip a step" convention -- a no-op write is still
+/// verified, not assumed). Waits [`SUSPECTED_SENSOR_ENABLE_SETTLE`] after both writes before
+/// returning. Callers must check [`SuspectedSensorLineResult::fully_verified`] before proceeding to
+/// any Sensor UART probing.
+pub async fn configure_suspected_sensor_enable_high<P: I2cPort>(dev: &mut P) -> Result<SuspectedSensorLineResult, I2cIoError> {
+    let reg02 = read_modify_write_bit0(
+        dev,
+        REG_OUTPUT_PORT_0,
+        "0x02",
+        |original| original | SUSPECTED_SENSOR_ENABLE_BIT,
+        "prepared (output latch, bit0 high)",
+    )
+    .await?;
+
+    let reg06 = read_modify_write_bit0(
+        dev,
+        REG_CONFIG_PORT_0,
+        "0x06",
+        |original| original & !SUSPECTED_SENSOR_ENABLE_BIT,
+        "configured-as-output (bit0)",
+    )
+    .await?;
+
+    sleep(SUSPECTED_SENSOR_ENABLE_SETTLE).await;
+
+    Ok(SuspectedSensorLineResult { reg02, reg06 })
+}
+
+/// **Experimental.** Restores *only* bit 0 of registers 0x02/0x06 to `captured_original_0x02`/
+/// `captured_original_0x06` -- the exact values [`configure_suspected_sensor_enable_high`] itself
+/// read at the start of the same invocation, passed back in by the caller (`sensor_probe.rs` never
+/// persists state across separate process invocations). Every other bit is preserved *as it exists
+/// at restore time* (a fresh read, not a blind write-back of the whole originally-captured byte) --
+/// so any change some other actor made to an unrelated bit in the meantime is not clobbered. Never
+/// touches bit 1 or register 0x07, structurally, exactly like
+/// [`configure_suspected_sensor_enable_high`].
+pub async fn restore_suspected_sensor_bit<P: I2cPort>(
+    dev: &mut P,
+    captured_original_0x02: u8,
+    captured_original_0x06: u8,
+) -> Result<SuspectedSensorLineResult, I2cIoError> {
+    let restore_bit_0x02 = captured_original_0x02 & SUSPECTED_SENSOR_ENABLE_BIT;
+    let reg02 = read_modify_write_bit0(
+        dev,
+        REG_OUTPUT_PORT_0,
+        "0x02",
+        move |original| (original & !SUSPECTED_SENSOR_ENABLE_BIT) | restore_bit_0x02,
+        "restored (bit0 to this invocation's captured original)",
+    )
+    .await?;
+
+    let restore_bit_0x06 = captured_original_0x06 & SUSPECTED_SENSOR_ENABLE_BIT;
+    let reg06 = read_modify_write_bit0(
+        dev,
+        REG_CONFIG_PORT_0,
+        "0x06",
+        move |original| (original & !SUSPECTED_SENSOR_ENABLE_BIT) | restore_bit_0x06,
+        "restored (bit0 to this invocation's captured original)",
+    )
+    .await?;
+
+    Ok(SuspectedSensorLineResult { reg02, reg06 })
+}
+
+/// Bits 0 and 1 of port 0 together -- the combined narrow-subsystem-init mask. Real hardware
+/// evidence: with only bit 0 configured as an output (via [`configure_suspected_sensor_enable_high`]
+/// alone), Sensor stayed completely silent at both known baud rates, and register 0x06 was
+/// observed at `0xFE` (bit 1 still an input) -- consistent with bit 1 (already proven to be
+/// Frozen's own reset line) also needing to be an output before Frozen operates correctly. This
+/// mask reproduces only the relevant port-0 portion of upstream's own startup sequence -- both bits
+/// as outputs, bit 1 pulsed exactly as already proven for Frozen -- while never touching register
+/// 0x07 (observed on this Hub as `0x77`, not upstream's `0x31`) or any other register. See
+/// `i2c::configure_combined_narrow_subsystem_init`'s doc comment and `sensor_probe.rs` module docs.
+pub const PORT0_COMBINED_MASK: u8 = SUSPECTED_SENSOR_ENABLE_BIT | FROZEN_RESET_BIT;
+
+/// The result of one narrow, bits-0-and-1-only read-modify-write step on register 0x02 or 0x06.
+/// Distinct from [`RegBitReadModifyWriteResult`] (bit 1 only) and [`SuspectedSensorBitStepResult`]
+/// (bit 0 only) -- `only_combined_bits_changed` is named for what it actually checks.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct CombinedBitStepResult {
+    pub original: u8,
+    pub target: u8,
+    pub changed_mask: u8,
+    pub readback: u8,
+    pub readback_matches: bool,
+    /// `true` iff `changed_mask` is a subset of [`PORT0_COMBINED_MASK`] -- i.e. no bit outside
+    /// bits 0/1 differs between `original` and `target`.
+    pub only_combined_bits_changed: bool,
+}
+
+/// Bits-0-and-1 analog of `read_modify_write_reg`/`read_modify_write_bit0` above: reads `reg`,
+/// computes a new value via `transform`, verifies mathematically (before writing) that the change
+/// touches only bits 0/1, writes it, and reads it back to verify. Kept as an independent function
+/// (not a generalization of either single-bit helper) for the same reason those two are
+/// independent of each other: this experimental combined sequence must never be able to affect
+/// either bit's own already-proven or already-tested single-bit logic.
+async fn read_modify_write_combined<P: I2cPort>(
+    dev: &mut P,
+    reg: u8,
+    reg_label: &str,
+    transform: impl FnOnce(u8) -> u8,
+    target_label: &str,
+) -> Result<CombinedBitStepResult, I2cIoError> {
+    let original = dev.read_reg(RESET_EXPANDER_ADDR, reg)?;
+    let target = transform(original);
+    let changed_mask = original ^ target;
+    log::info!("[combined-init] original register {reg_label}: 0b{original:08b} (0x{original:02X})");
+    log::info!("[combined-init] {target_label} register {reg_label}: 0b{target:08b} (0x{target:02X})");
+    log::info!("[combined-init] changed-bit mask: 0b{changed_mask:08b} (0x{changed_mask:02X})");
+    // Verified mathematically, before any write is issued: every `transform` this function is ever
+    // called with is constructed as `original | PORT0_COMBINED_MASK`, `original &
+    // !PORT0_COMBINED_MASK`, or `original & !FROZEN_RESET_BIT` (the release step, which only ever
+    // clears bit 1), each of which can only ever differ from `original` in bits 0/1 -- this can
+    // never actually fail, but is asserted as a structural proof rather than an assumption.
+    assert_eq!(
+        changed_mask & !PORT0_COMBINED_MASK,
+        0,
+        "computed target for register {reg_label} would change a bit other than bits 0/1 (original=0b{original:08b} target=0b{target:08b})"
+    );
+    dev.write_reg(RESET_EXPANDER_ADDR, reg, target)?;
+    let readback = dev.read_reg(RESET_EXPANDER_ADDR, reg)?;
+    log::info!("[combined-init] readback result: 0b{readback:08b} (0x{readback:02X})");
+    Ok(CombinedBitStepResult {
+        original,
+        target,
+        changed_mask,
+        readback,
+        readback_matches: readback == target,
+        only_combined_bits_changed: (changed_mask & !PORT0_COMBINED_MASK) == 0,
+    })
+}
+
+/// The result of [`configure_combined_narrow_subsystem_init`]: the three steps (0x02 assert, 0x06
+/// configure, 0x02 release), each independently verified.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct CombinedNarrowSubsystemInitResult {
+    pub reg02_assert: CombinedBitStepResult,
+    pub reg06_config: CombinedBitStepResult,
+    pub reg02_release: CombinedBitStepResult,
+}
+
+impl CombinedNarrowSubsystemInitResult {
+    /// `true` iff every step verified: each write's readback matched what was written, and each
+    /// write changed only bits 0/1 (of its own register). Callers must check this before
+    /// proceeding to any UART probing -- see `sensor_probe.rs`'s `expander_verification_failed`
+    /// result.
+    pub fn fully_verified(&self) -> bool {
+        self.reg02_assert.readback_matches
+            && self.reg02_assert.only_combined_bits_changed
+            && self.reg06_config.readback_matches
+            && self.reg06_config.only_combined_bits_changed
+            && self.reg02_release.readback_matches
+            && self.reg02_release.only_combined_bits_changed
+    }
+}
+
+/// **Experimental.** Reproduces only the port-0 portion of upstream's own startup sequence --
+/// bits 0 and 1 of registers 0x02/0x06 -- while leaving every other register (0x07 in particular)
+/// exactly as this Hub's own hardware already has it. Three writes total, in order:
+///
+/// 1. Register 0x02: `asserted = original | PORT0_COMBINED_MASK` (both bits 0 and 1 driven HIGH on
+///    the output latch, before either becomes an output -- same glitch-avoidance ordering
+///    [`pulse_frozen_reset_bit`]/[`configure_suspected_sensor_enable_high`] already use).
+/// 2. Register 0x06: `configured = original & !PORT0_COMBINED_MASK` (both bits 0 and 1 configured
+///    as outputs; `0` = output on the PCAL6416A).
+/// 3. Holds [`PULSE_SETTLE`] (the same ~100ms already proven for Frozen's own bit-1 pulse), then
+///    register 0x02 again: `released = (fresh read) & !FROZEN_RESET_BIT` -- clears *only* bit 1,
+///    leaving bit 0 asserted HIGH and every other bit (including whatever bits 2-7 currently read)
+///    untouched. This is exactly [`pulse_frozen_reset_bit`]'s own proven assert/hold/release
+///    sequence for bit 1, combined with [`configure_suspected_sensor_enable_high`]'s bit-0-stays-
+///    HIGH behavior, in the three writes upstream's own sequence would need instead of the five a
+///    naive sequential composition of the two existing single-bit functions would produce.
+///
+/// Never writes register 0x07 or 0x03, never calls `opensleep::reset::ResetController` or
+/// `run_reset_sequence`, never uses a hardcoded whole-register constant -- every value written is
+/// computed from what was actually read at that step. Callers must check
+/// [`CombinedNarrowSubsystemInitResult::fully_verified`] before proceeding to any UART probing.
+pub async fn configure_combined_narrow_subsystem_init<P: I2cPort>(dev: &mut P) -> Result<CombinedNarrowSubsystemInitResult, I2cIoError> {
+    let reg02_assert = read_modify_write_combined(
+        dev,
+        REG_OUTPUT_PORT_0,
+        "0x02",
+        |original| original | PORT0_COMBINED_MASK,
+        "prepared (bits 0+1 high)",
+    )
+    .await?;
+
+    let reg06_config = read_modify_write_combined(
+        dev,
+        REG_CONFIG_PORT_0,
+        "0x06",
+        |original| original & !PORT0_COMBINED_MASK,
+        "configured (bits 0+1 as outputs)",
+    )
+    .await?;
+
+    sleep(PULSE_SETTLE).await;
+
+    let reg02_release = read_modify_write_combined(
+        dev,
+        REG_OUTPUT_PORT_0,
+        "0x02",
+        |original| original & !FROZEN_RESET_BIT,
+        "released (bit 1 only; bit 0 stays high)",
+    )
+    .await?;
+
+    Ok(CombinedNarrowSubsystemInitResult { reg02_assert, reg06_config, reg02_release })
+}
