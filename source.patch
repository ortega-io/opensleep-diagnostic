+++ b/src/bin/opensleep-diagnostic/cool_test.rs
@@ -0,0 +1,4897 @@
+//! `frozen-cool-test`: the one subcommand that intentionally activates a cooling channel. Every
+//! hard limit here (max delta, max duration, baseline range, heatsink ceiling) is a compile-time
+//! constant; no CLI flag can raise any of them. See SAFETY.md for the operator-facing version of
+//! this file's guarantees.
+//!
+//! Baseline validation accepts both the unsolicited `TemperatureUpdate` push (raw opcode 0x41,
+//! the same byte as the `GetTemperatures` command itself -- Frozen appears to broadcast this on
+//! its own schedule, independent of being polled) and a decoded solicited `GetTemperature` reply
+//! (opcode 0xC1) -- the original 27-byte reply via the unmodified upstream parser, or this
+//! firmware's 14-byte reply via `frozen_compat::CompatFrameScanner` (real hardware has been
+//! observed sending both shapes; see PROTOCOL_AUDIT.md). The *active-phase* per-tick safety
+//! checks, by contrast, still rely exclusively on the unsolicited `TemperatureUpdate` push --
+//! `GetTemperature` replies received during the active phase are preserved in the report as raw
+//! evidence only, never required or used for a safety decision there.
+//!
+//! Firmware `Message` text (pump/TEC status, generic fault keywords) is parsed word-by-word where
+//! the wording matters, never by raw substring: `TecSafetyState`'s doc comment covers a real
+//! regression this guards against (`contains("lock")` also matches `"unlocking"`/`"unlocked"`,
+//! aborting a healthy run on a message that is actually reporting the interlock is safe).
+//!
+//! ## Startup: the same narrow pulse `--release-frozen-only` uses
+//!
+//! This mode releases Frozen from reset via `frozen_startup::start_frozen_narrow` -- the exact
+//! same shared implementation `frozen-prime-opensleep-init --release-frozen-only` uses, itself
+//! built on `i2c::pulse_frozen_reset_bit` -- never `opensleep::reset::ResetController`, never the
+//! four-register full reset sequence ([`crate::i2c::run_reset_sequence`]), and never register
+//! 0x07. See that function's doc comment for the real-hardware evidence behind the pulse (and why
+//! register 0x06 must be configured as an output first). `main.rs`'s guardrail tests prove this
+//! file never references `ResetController` or the full reset sequence at all.
+//!
+//! ## Shutdown: no full reset on normal completion
+//!
+//! Unlike every other active mode in this binary (which always assert the shared, hardcoded-0xFF
+//! `i2c::assert_reset` via `safe_stop::run_safe_stop` on every exit path), this mode's own
+//! shutdown (`run_cool_test_shutdown`) disables both sides over UART (three repeated attempts,
+//! matching `safe_stop`'s cadence) and asserts **no** I2C reset at all on normal completion,
+//! `DurationExpired`, `TargetTemperatureReached`, or a clean Ctrl+C/SIGTERM/SIGHUP -- Frozen is
+//! left running, exactly as `--release-frozen-only` leaves it. Only if UART-based shutdown could
+//! not be confirmed *and* the stop reason is a genuine fault does it fall back to the narrow,
+//! bit-1-only `i2c::assert_frozen_reset_bit_only` -- never the full reset, never registers
+//! 0x06/0x07.
+//!
+//! The first Ctrl+C/SIGTERM/SIGHUP always reaches this same controlled shutdown, never an
+//! immediate process exit -- including during baseline collection (up to `BASELINE_MAX_WINDOW` =
+//! 60s), not only the active phase: `wait_for_termination_signal` is raced via `tokio::select!` in
+//! both loops. This matters because `tokio::signal::ctrl_c()` only replaces the OS's default
+//! "kill immediately" SIGINT disposition once it has actually been awaited somewhere in the
+//! process; if baseline collection were the only place a real run spent significant time before
+//! that first await, a Ctrl+C there would terminate the process outright, bypassing shutdown
+//! entirely.
+
+use std::io::IsTerminal;
+use std::time::Duration;
+
+use opensleep::common::packet::BedSide;
+use opensleep::frozen::FrozenPacket;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::sync::mpsc;
+use tokio::time::Instant;
+
+use crate::buildinfo::{DIAGNOSTIC_VERSION, kernel_release, source_commit};
+use crate::cli::CoolTestArgs;
+use crate::frozen_compat::CompatFrameScanner;
+use crate::i2c::{I2cPort, MockI2c, RealI2c, probe_address};
+use crate::io_logging::RawIoCapture;
+use crate::link::{FrozenLink, LinkError, PacketOutcome};
+use crate::mock::mock_frozen_link_pair;
+use crate::ownership;
+use crate::report::{
+    AuditEntryJson, ComponentResults, Confirmations, CoolTestResults, OperatorObservations, Report, TemperatureSampleJson,
+    Verdict,
+};
+use crate::safety::{AuditedTransport, FrozenAction, Mode};
+use crate::signals::{StopReason, wait_for_termination_signal};
+use crate::telemetry::{
+    PacketStats, SampleSource, TemperatureSample, sample_from_get_temperature, sample_from_get_temperature_compat14,
+    sample_from_temperature_update,
+};
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// Default active-phase duration: long enough to establish meaningful water-temperature movement
+/// through the filled cover loop. The test still stops early on target-reached/safety/
+/// communication-loss/interrupt, so this is not a long minimum wait.
+pub const DEFAULT_DURATION_SECONDS: u64 = 120;
+/// Hard, non-overridable maximum active duration: 15 minutes. No flag can raise this.
+pub const HARD_MAX_DURATION_SECONDS: u64 = 900;
+/// Durations above this require the additional `--confirm-extended-test` acknowledgement.
+pub const EXTENDED_DURATION_THRESHOLD_SECONDS: u64 = 300;
+/// How long the selected side's live temperature must remain at or below the computed target
+/// before the active phase stops for [`crate::signals::StopReason::TargetTemperatureReached`] --
+/// a single tick at/below target is not itself sufficient (a brief undershoot from telemetry
+/// noise or a single fast-settling sample should not by itself end the test), but the target must
+/// not be held indefinitely either (see item 3 of the fix this constant was added for: never keep
+/// the TEC enabled merely to consume the rest of the requested duration once the target is
+/// genuinely reached). Chosen to be a handful of ticks (this loop polls roughly once per second)
+/// without adding a meaningful delay to a short default-duration run.
+pub const TARGET_STABLE_CONFIRM_WINDOW: Duration = Duration::from_secs(5);
+/// Conservative baseline/active-phase water temperature envelope: 15-35C. See SAFETY.md for why.
+pub const MIN_WATER_CENTIDEG: i32 = 1500;
+pub const MAX_WATER_CENTIDEG: i32 = 3500;
+/// Heatsink ceiling during the active phase.
+pub const MAX_HEATSINK_CENTIDEG: i32 = 4500;
+/// A single-tick (~1s) water-temperature jump larger than this is treated as implausible/sensor
+/// fault rather than real cooling, since real thermal mass cannot move this fast.
+pub const MAX_PLAUSIBLE_TICK_JUMP_CENTIDEG: i32 = 300;
+pub const BASELINE_MIN_SAMPLES: usize = 5;
+/// At least 10 seconds of stable samples before enabling cooling.
+pub const BASELINE_MIN_WINDOW: Duration = Duration::from_secs(10);
+/// Absolute ceiling on baseline collection: continues until `BASELINE_MIN_SAMPLES` valid samples
+/// have been collected over at least `BASELINE_MIN_WINDOW`, or this elapses, whichever comes
+/// first. Real hardware evidence: MT8365 / Frozen firmware v1.4.235 has been observed pushing
+/// unsolicited `TemperatureUpdate` only about once every 10 seconds, so reaching 5 samples can
+/// genuinely take 40-50s -- the previous `BASELINE_MIN_WINDOW * 4` (40s) backstop cut collection
+/// off before 5 samples could ever arrive on that firmware.
+pub const BASELINE_MAX_WINDOW: Duration = Duration::from_secs(60);
+pub const BASELINE_MAX_SPREAD_CENTIDEG: i32 = 300;
+/// No longer used by this file's own active loop -- see [`ANY_VALID_RX_LIMIT`]/
+/// [`TEMPERATURE_FRESHNESS_LIMIT`]/[`ACTIVE_STARTUP_GRACE`], which replace the single, too-short
+/// (2s) clock this constant drove with real-hardware-evidenced values. Still `pub` and still used
+/// by `prime_test.rs`'s own, unrelated active-phase staleness check -- priming has not been shown
+/// to share `frozen-cool-test`'s ~10s unsolicited-push cadence problem, so its own watchdog is
+/// intentionally left untouched here.
+pub const STALE_TELEMETRY_LIMIT: Duration = Duration::from_secs(2);
+/// Detects an actually silent/dead Frozen link during the active phase: no successfully-decoded
+/// packet of *any* kind (`TemperatureUpdate`, `GetTemperature`, `Message`, `TargetUpdate`, ...)
+/// for this long. Deliberately a *separate*, shorter clock from
+/// [`TEMPERATURE_FRESHNESS_LIMIT`] -- see that constant's doc comment for why one shared clock is
+/// wrong for this firmware.
+pub const ANY_VALID_RX_LIMIT: Duration = Duration::from_secs(5);
+/// How long a valid temperature sample (a solicited `GetTemperature` reply -- either the original
+/// 27-byte shape or this firmware's 14-byte shape -- or an unsolicited `TemperatureUpdate`) can go
+/// stale before the active phase aborts, once at least one sample has already been seen (see
+/// [`ACTIVE_STARTUP_GRACE`] for the separate clock covering *before* the first sample).
+///
+/// A live-hardware incident found the active phase shutting down almost immediately after
+/// enabling -- exactly 2 seconds after, in the captured timing -- despite no fault, timeout, or
+/// target attainment. Root cause: the previous single-clock check (`STALE_TELEMETRY_LIMIT`, 2s,
+/// refreshed only by `TemperatureUpdate`) was shorter than this firmware's own unsolicited-push
+/// cadence -- a separate live capture already on file showed `TemperatureUpdate` arriving only
+/// about once every ~10 seconds -- so the 2s watchdog was guaranteed to fire on every active-phase
+/// run regardless of any actual fault. 20s tolerates a missed unsolicited push (~10s) with margin;
+/// a healthy synchronous `GetTemperatures` poll (this binary sends one per ~1s tick) normally
+/// keeps this clock far fresher than 20s whenever the firmware's reply decodes.
+pub const TEMPERATURE_FRESHNESS_LIMIT: Duration = Duration::from_secs(20);
+/// How long after the active phase starts before the *first* temperature sample must have
+/// arrived. Distinct from [`TEMPERATURE_FRESHNESS_LIMIT`]: that clock only starts counting once a
+/// first sample has actually been seen, so a firmware that is simply slow to send its first
+/// reading right after being enabled (busy with pump/solenoid/PID/TEC startup messages -- exactly
+/// the burst of `Message` traffic seen in the incident above) needs its own grace period rather
+/// than being held to a clock that never started ticking.
+pub const ACTIVE_STARTUP_GRACE: Duration = Duration::from_secs(15);
+/// How long after the enable command is accepted the selected-side pump is allowed to keep
+/// reporting off/0V before that is treated as an abort condition. Evidence-gated: only fires if a
+/// firmware pump message for our side was actually observed reporting zero voltage -- see
+/// `parse_pump_report`.
+pub const PUMP_CONFIRM_GRACE: Duration = Duration::from_secs(3);
+/// How long after the active phase starts before generic firmware fault keywords (see
+/// `is_generic_fault_message`) are treated as fatal, rather than logged only. Chosen conservatively
+/// since no documented firmware startup-timing spec exists; a short window avoids mistaking benign
+/// boot-time chatter right after the enable command for a real fault.
+pub const FAULT_KEYWORD_GRACE: Duration = Duration::from_secs(2);
+/// Length of each drain window within one ~1-second active-phase/baseline-collection tick.
+const TICK_DRAIN_WINDOW: Duration = Duration::from_millis(900);
+
+/// Cool-test's own shutdown: repeated disable attempts, matching `safe_stop::run_safe_stop`'s
+/// cadence, but never the full I2C reset -- see module docs.
+const SHUTDOWN_REPEAT_COUNT: usize = 3;
+const SHUTDOWN_BETWEEN_ATTEMPTS_DELAY: Duration = Duration::from_millis(150);
+const SHUTDOWN_DISABLE_WAIT: Duration = Duration::from_millis(500);
+/// After the repeated disables, how long to keep reading to confirm both sides' `TargetUpdate`
+/// actually reports `enabled=false`, rather than merely that the disable command was accepted.
+const SHUTDOWN_VERIFY_WINDOW: Duration = Duration::from_secs(2);
+
+/// Default cooling delta when neither `--delta-c` nor `--target-c` is supplied. Not a maximum --
+/// see `safety::FrozenAction::enable_cooling`'s doc comment.
+const DEFAULT_DELTA_C: f64 = 1.0;
+/// Above this delta, `--confirm-large-temperature-delta` is required. An auditable
+/// acknowledgement only, not a second hidden cap -- `enable_cooling` itself no longer enforces
+/// any fixed maximum delta at all.
+const LARGE_DELTA_CONFIRMATION_THRESHOLD_CENTIDEG: i32 = 200;
+/// Reported in `CoolTestResults::startup_mode`: the only startup implementation this file can ever
+/// use (see module docs and `main.rs`'s guardrail tests).
+const STARTUP_MODE_LABEL: &str = "narrow (i2c::pulse_frozen_reset_bit)";
+/// A reported TEC current at or below this magnitude, observed *after* a disable command, is
+/// treated as evidence the TEC has stopped drawing significant current -- **not** a safety/hazard
+/// threshold (item 4 of the fix this constant was added for explicitly forbids inventing one of
+/// those): the only claim this makes is "the reported number dropped back down near zero," a
+/// purely descriptive signal, exactly like `parse_pump_report`'s existing `> 0.0005` V "is
+/// running" cutoff. Frozen firmware remains the sole authority on whether any current value it
+/// reports while the TEC is active is itself safe.
+const TEC_STOPPED_CURRENT_THRESHOLD_A: f64 = 0.5;
+
+/// `--firmware-authoritative` mode's own, much longer, single communication-silence threshold --
+/// deliberately not the legacy loop's `ANY_VALID_RX_LIMIT` (5s) or the original, since-replaced
+/// `STALE_TELEMETRY_LIMIT` (2s): a live-hardware incident showed the legacy active loop treating
+/// pre-enable, already-buffered telemetry as active-phase evidence and stopping on it. Rather than
+/// adding more host-side clocks to a mode whose whole purpose is to stop second-guessing Frozen,
+/// this is the one remaining automatic communication check: a conservative, prominently-logged
+/// period with genuinely no packet of any kind, long enough that it cannot plausibly be confused
+/// with this firmware's own observed telemetry cadence (Message traffic every few seconds,
+/// TemperatureUpdate roughly every ~10s -- see `TEMPERATURE_FRESHNESS_LIMIT`'s doc comment).
+pub const FA_COMMUNICATION_SILENCE_LIMIT: Duration = Duration::from_secs(30);
+/// `--firmware-authoritative` mode polls `GetTemperatures` no faster than this -- observation
+/// only, never required for safety in this mode (Frozen owns thermal regulation and current
+/// safety entirely once enabled), so there is no reason to poll as aggressively as the legacy
+/// loop's ~1s tick.
+pub const FA_TEMPERATURE_POLL_INTERVAL: Duration = Duration::from_secs(5);
+/// How long past the requested active-phase duration the independent shutdown guard (`guard.rs`)
+/// stays armed before firing on its own -- gives the main observer's own normal shutdown sequence
+/// (repeated disable attempts, UART flush, verify window) time to complete and disarm the guard
+/// before it would otherwise fire redundantly.
+pub const FA_GUARD_GRACE: Duration = Duration::from_secs(30);
+
+pub async fn run(args: &CoolTestArgs) -> (Report, u8) {
+    // Recognizes the same, stable set of known-firmware-compatibility log lines this run's own
+    // `frozen_compat::CompatFrameScanner` handles, and suppresses their noisy full-buffer dump --
+    // see `compat_counters.rs` module docs. Enabled unconditionally (including for --dry-run, so
+    // tests exercising the mock device see identical suppression behavior); a no-op until an
+    // actual matching log line is emitted.
+    crate::compat_counters::enable();
+
+    if args.duration_seconds > HARD_MAX_DURATION_SECONDS {
+        log::error!(
+            "refusing to run: --duration-seconds {} exceeds the hard maximum of {} (no option can raise this)",
+            args.duration_seconds, HARD_MAX_DURATION_SECONDS
+        );
+        return (refused_report(args, false, "duration exceeds hard maximum"), 30);
+    }
+
+    if !(args.confirm_cover_hydraulics_connected
+        && args.confirm_water_loop_filled
+        && args.confirm_no_visible_leaks
+        && args.confirm_active_test)
+    {
+        log::error!("refusing to run: all four --confirm-* flags are required");
+        return (refused_report(args, false, "missing required confirmation flags"), 30);
+    }
+
+    if args.delta_c.is_some() && args.target_c.is_some() {
+        log::error!("refusing to run: --delta-c and --target-c are mutually exclusive");
+        return (refused_report(args, false, "--delta-c and --target-c are mutually exclusive"), 30);
+    }
+    if let Some(d) = args.delta_c
+        && !(d.is_finite() && d > 0.0)
+    {
+        log::error!("refusing to run: --delta-c must be a finite value greater than zero, got {d}");
+        return (refused_report(args, false, "--delta-c must be a finite value greater than zero"), 30);
+    }
+    if let Some(t) = args.target_c
+        && !t.is_finite()
+    {
+        log::error!("refusing to run: --target-c must be a finite value, got {t}");
+        return (refused_report(args, false, "--target-c must be a finite value"), 30);
+    }
+
+    if args.duration_seconds > EXTENDED_DURATION_THRESHOLD_SECONDS && !args.confirm_extended_test {
+        log::error!(
+            "refusing to run: --duration-seconds {} exceeds {}s and requires --confirm-extended-test",
+            args.duration_seconds, EXTENDED_DURATION_THRESHOLD_SECONDS
+        );
+        return (refused_report(args, false, "extended-duration confirmation flag missing"), 30);
+    }
+    if args.duration_seconds > EXTENDED_DURATION_THRESHOLD_SECONDS {
+        eprintln!(
+            "--frozen-cool-test: requested duration ({}) exceeds {}s. This test may run for up to \
+             15 minutes. The operator must remain present for the entire run and continuously \
+             monitor for leaks, a burning smell, abnormal pump noise, loss of circulation, or \
+             unexpected heating.",
+            args.duration_seconds, EXTENDED_DURATION_THRESHOLD_SECONDS
+        );
+    }
+
+    // Only the --delta-c case can be checked this early -- the resulting delta is known from the
+    // CLI args alone. --target-c's resulting delta depends on the measured baseline and is
+    // checked again inside run_core once that's known (see the large-delta check there).
+    if let Some(d) = args.delta_c
+        && (d * 100.0).round() as i32 > LARGE_DELTA_CONFIRMATION_THRESHOLD_CENTIDEG
+        && !args.confirm_large_temperature_delta
+    {
+        log::error!(
+            "refusing to run: --delta-c {d} exceeds {:.2}C and requires --confirm-large-temperature-delta",
+            f64::from(LARGE_DELTA_CONFIRMATION_THRESHOLD_CENTIDEG) / 100.0
+        );
+        return (
+            refused_report(args, false, "large temperature delta confirmation flag missing (--confirm-large-temperature-delta)"),
+            30,
+        );
+    }
+
+    if args.dry_run {
+        log::warn!("--dry-run: no I2C or UART writes will be performed; using a mocked Frozen device");
+        let mut i2c = MockI2c::always_succeed();
+        // --firmware-authoritative gets its own mock device that specifically reproduces the
+        // pre-enable pump-off telemetry race item 12 asks this packaged build to be verified
+        // against -- see mock.rs module docs on spawn_mock_frozen_device_firmware_authoritative.
+        let (client, task) = if args.firmware_authoritative {
+            crate::mock::mock_frozen_link_pair_firmware_authoritative()
+        } else {
+            mock_frozen_link_pair()
+        };
+        let capture: RawIoCapture = Default::default();
+        let mut link = FrozenLink::wrap_capturing_with_raw_log(client, "dry-run", capture.clone(), args.raw_serial_log);
+        // The independent shutdown guard is never spawned for --dry-run: there is no real
+        // hardware for it to protect, and spawning a real re-exec'd process here would try (and
+        // fail, harmlessly but pointlessly) to open the real Frozen UART/I2C.
+        let result = run_core(args, &mut i2c, &mut link, true, None, Some(capture), false).await;
+        drop(link);
+        task.abort();
+        return result;
+    }
+
+    if let Some(early) = refuse_if_owned(args) {
+        return early;
+    }
+
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("failed to open I2C device {}: {e}", args.i2c_device);
+            return (refused_report(args, false, "I2C bus failed to open"), 20);
+        }
+    };
+
+    let capture: RawIoCapture = Default::default();
+    let mut link = match FrozenLink::<tokio_serial::SerialStream>::open_capturing_with_raw_log(
+        &args.frozen_port,
+        capture.clone(),
+        args.raw_serial_log,
+    ) {
+        Ok(l) => l,
+        Err(e) => {
+            log::error!("failed to open Frozen UART {}: {e}", args.frozen_port);
+            return (refused_report(args, false, "Frozen UART failed to open"), 20);
+        }
+    };
+
+    run_core(args, &mut i2c, &mut link, false, None, Some(capture), args.firmware_authoritative && !args.skip_independent_guard).await
+}
+
+fn refuse_if_owned(args: &CoolTestArgs) -> Option<(Report, u8)> {
+    let services = ownership::check_stock_services();
+    let active: Vec<_> = services.iter().filter(|s| s.active).map(|s| s.name.clone()).collect();
+    if !active.is_empty() {
+        log::error!("refusing to run: stock service(s) active: {active:?}");
+        return Some((refused_report(args, false, "stock service(s) active; refusing to run"), 40));
+    }
+    if ownership::device_exists(&args.i2c_device) && ownership::device_is_open_elsewhere(&args.i2c_device) {
+        log::error!("refusing to run: {} appears to be open in another process", args.i2c_device);
+        return Some((refused_report(args, false, "I2C device already open elsewhere"), 40));
+    }
+    if ownership::device_exists(&args.frozen_port) && ownership::device_is_open_elsewhere(&args.frozen_port) {
+        log::error!("refusing to run: {} appears to be open in another process", args.frozen_port);
+        return Some((refused_report(args, false, "Frozen UART already open elsewhere"), 40));
+    }
+    None
+}
+
+/// Spawns a background thread that reads lines from stdin for as long as the process runs, and
+/// forwards each trimmed line into the returned channel. Returns `None` (no thread spawned) when
+/// stdin is not a TTY, matching every other interactive-input gate in this binary. Only ever
+/// called from `run_core` after every blocking confirmation-phrase read has already completed, so
+/// it never races those reads for the same stdin.
+fn spawn_operator_abort_watcher() -> Option<mpsc::UnboundedReceiver<String>> {
+    if !std::io::stdin().is_terminal() {
+        return None;
+    }
+    let (tx, rx) = mpsc::unbounded_channel();
+    std::thread::spawn(move || {
+        let stdin = std::io::stdin();
+        loop {
+            let mut line = String::new();
+            match stdin.read_line(&mut line) {
+                Ok(0) | Err(_) => break,
+                Ok(_) => {
+                    if tx.send(line.trim().to_string()).is_err() {
+                        break;
+                    }
+                }
+            }
+        }
+    });
+    Some(rx)
+}
+
+/// True if `line` should abort the active test: an explicit operator report of a leak, burning
+/// smell, or abnormal noise, or the literal word ABORT.
+fn is_operator_abort_line(line: &str) -> bool {
+    let lower = line.to_lowercase();
+    lower.contains("leak") || lower.contains("smell") || lower.contains("noise") || lower.trim() == "abort"
+}
+
+/// Parses a firmware pump message for the given side (e.g. `FW: pump[left] slow @ 6.03V 0.17A`,
+/// per the captured evidence in `frozen/command.rs`). Returns `Some(true)` if it reports nonzero
+/// voltage (pump confirmed running), `Some(false)` if it explicitly reports "off" or 0.000000V,
+/// or `None` if this message is not about our side's pump at all.
+fn parse_pump_report(msg: &str, side_word: &str) -> Option<bool> {
+    let lower = msg.to_lowercase();
+    let marker = format!("pump[{side_word}]");
+    let idx = lower.find(&marker)?;
+    let rest = &lower[idx + marker.len()..];
+    if rest.trim_start().starts_with("off") {
+        return Some(false);
+    }
+    let at = rest.find('@')?;
+    let after_at = &rest[at + 1..];
+    let vpos = after_at.find('v')?;
+    let num_str = after_at[..vpos].trim();
+    let voltage: f64 = num_str.parse().ok()?;
+    Some(voltage > 0.0005)
+}
+
+/// Parses the current (amps) component of a firmware pump message for the given side (e.g. `"FW:
+/// pump[left] default @ 9.000000V 0.200000A"`), side-scoped exactly like [`parse_pump_report`].
+/// `None` if this message is not about our side's pump, reports "off" (no voltage/current pair at
+/// all), or has no parseable amperage after the voltage. Purely descriptive, like
+/// [`parse_tec_current`] -- used only to report `CoolTestResults::pump_current_observed`.
+fn parse_pump_current(msg: &str, side_word: &str) -> Option<f64> {
+    let lower = msg.to_lowercase();
+    let marker = format!("pump[{side_word}]");
+    let idx = lower.find(&marker)?;
+    let rest = &lower[idx + marker.len()..];
+    if rest.trim_start().starts_with("off") {
+        return None;
+    }
+    let at = rest.find('@')?;
+    let after_at = &rest[at + 1..];
+    let vpos = after_at.find('v')?;
+    let after_v = &after_at[vpos + 1..];
+    let apos = after_v.find('a')?;
+    let num_str = after_v[..apos].trim();
+    num_str.parse().ok()
+}
+
+/// True iff `msg` is a firmware pump-*command* event for the given side in the `"[pump-<side>]
+/// <command>=><value>"` format (e.g. `"[pump-left] slow=>6.500000"`) -- distinct from
+/// [`parse_pump_report`]'s `"pump[<side>] ... @ <V>V <A>A"` voltage/current status format; both
+/// have been observed from real firmware in the same live-hardware incident. Positive evidence
+/// only, per item 4 of the `--firmware-authoritative` fix this was added for: this message's
+/// *absence* is never itself a fault in that mode.
+fn is_pump_command_event(msg: &str, side_word: &str) -> bool {
+    let lower = msg.to_lowercase();
+    lower.contains(&format!("[pump-{side_word}]"))
+}
+
+/// The selected TEC's safety-interlock state, as reported in a firmware `Message`. Captured
+/// real-hardware evidence for a normal, successful active phase: `"FW: tec[left] current:
+/// 11.402626 A"` followed by `"FW: tec[left] safe, unlocking"` -- a *positive* transition (the
+/// interlock confirming it is safe to run), not a fault. An earlier version of this file matched
+/// TEC lock state with `contains("tec") && contains("lock")`, which also matches `"unlocking"` and
+/// `"unlocked"` (both contain the substring `"lock"`) and aborted a healthy run on exactly that
+/// message. This type/parser replaces that with explicit, word-tokenized classification instead
+/// of substring matching, so `"lock"` appearing inside a longer word can never be confused with
+/// the standalone word `"locked"`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TecSafetyState {
+    /// `"safe, unlocking"` -- interlock transitioning to unlocked; not a fault.
+    SafeUnlocking,
+    /// `"unlocked"` -- interlock already open; active/normal; not a fault.
+    Unlocked,
+    /// `"unsafe, locking"` -- interlock transitioning to locked in response to an unsafe
+    /// condition; a genuine safety shutdown.
+    UnsafeLocking,
+    /// The exact word `"locked"` -- interlock engaged; a genuine safety shutdown.
+    Locked,
+    /// The message named our side's TEC but didn't contain any of the four known state words
+    /// above. Never treated as a fault by itself -- see this type's doc comment.
+    Unknown,
+}
+
+/// Deliberately *no* `is_fault()`/`is_safe_transition()` convenience methods here: a second
+/// live-hardware incident found that even after the word-tokenized parser above was fixed, the
+/// *caller* still collapsed a recognized positive state into a generic terminal outcome (the
+/// active loop's own control flow, not the parser, was the bug -- code logically equivalent to
+/// `if parse_tec_state(msg).is_some() { break; }`). Every call site is now required to write an
+/// exhaustive `match` over all five variants instead, so a new positive state can never be
+/// silently folded into "treat as terminal" by a boolean helper that happens to default the wrong
+/// way -- see the active loop's own `match state { ... }` for the pattern this enforces.
+///
+/// Parses a firmware TEC safety-state message for the given side (e.g. `"FW: tec[left] safe,
+/// unlocking"`), side-scoped exactly like [`parse_pump_report`]. `None` if this message is not
+/// about our side's TEC at all. Classifies by *word*, not substring: splits on non-alphanumeric
+/// characters and looks for an exact token match against `"unlocking"`, `"unlocked"`, `"locking"`,
+/// or `"locked"` -- `"unlocked"` tokenizes to one word, `"unlocked"`, which can never equal the
+/// word `"locked"`, so there is no possible confusion between the two regardless of message
+/// wording, unlike a `contains("lock")` check.
+fn parse_tec_safety_state(msg: &str, side_word: &str) -> Option<TecSafetyState> {
+    let lower = msg.to_lowercase();
+    let marker = format!("tec[{side_word}]");
+    if !lower.contains(&marker) {
+        return None;
+    }
+    let words: Vec<&str> = lower.split(|c: char| !c.is_alphanumeric()).filter(|w| !w.is_empty()).collect();
+    let has = |w: &str| words.contains(&w);
+    Some(if has("unlocking") {
+        TecSafetyState::SafeUnlocking
+    } else if has("unlocked") {
+        TecSafetyState::Unlocked
+    } else if has("locking") {
+        TecSafetyState::UnsafeLocking
+    } else if has("locked") {
+        TecSafetyState::Locked
+    } else {
+        TecSafetyState::Unknown
+    })
+}
+
+/// Parses a firmware TEC current message for the given side (e.g. `"FW: tec[left] current:
+/// 11.402626 A"`, per real-hardware capture), side-scoped exactly like [`parse_pump_report`].
+/// Returns the raw reported amperage. Never itself classifies a value as safe or unsafe -- see
+/// [`TEC_STOPPED_CURRENT_THRESHOLD_A`]'s doc comment and item 4 of the fix this parser was added
+/// for: Frozen firmware remains the sole authority on its own internal current safety.
+fn parse_tec_current(msg: &str, side_word: &str) -> Option<f64> {
+    let lower = msg.to_lowercase();
+    let marker = format!("tec[{side_word}]");
+    let idx = lower.find(&marker)?;
+    let rest = &lower[idx + marker.len()..];
+    let cpos = rest.find("current:")?;
+    let after = &rest[cpos + "current:".len()..];
+    let apos = after.find('a')?;
+    let num_str = after[..apos].trim();
+    num_str.parse().ok()
+}
+
+const FAULT_KEYWORDS: [&str; 6] = ["overtemperature", "overcurrent", "shutdown", "fault", "failed", "locked"];
+/// Keywords matched *word-exact* (via tokenizing on non-alphanumeric characters), not by raw
+/// substring, because each is a literal substring of a real, benign firmware word:
+/// - `"locked"` is a substring of `"unlocked"` (a benign TEC-interlock state -- see
+///   [`TecSafetyState`]'s doc comment for the live-hardware regression this guards against).
+/// - `"fault"` is a substring of `"default"` -- confirmed by a second live-hardware incident,
+///   whose own captured timeline includes the real, benign message
+///   `"FW: pump[left] default @ 9.000000V 0.200000A"` (a pump reverting to its default drive
+///   state, not a fault) being misclassified as `FirmwareFaultMessage` by a plain
+///   `contains("fault")` check.
+///
+/// Every other keyword in [`FAULT_KEYWORDS`] keeps the original substring match -- no evidence has
+/// been found of a benign word containing any of them.
+const WORD_EXACT_FAULT_KEYWORDS: [&str; 2] = ["locked", "fault"];
+
+/// Generic firmware-fault keyword scan -- **legacy (non-`--firmware-authoritative`) active loop
+/// only**; `--firmware-authoritative` mode never calls this at all (see item 1 of the fix that
+/// removed it there: a live-hardware run reported `"FW: [temps] 0 reads failed out of 1200"` --
+/// healthy status telemetry, zero failures -- and this scan's `contains("failed")` misclassified
+/// it as an explicit firmware safety fault; automatic fault shutdown in that mode now requires a
+/// specifically parsed, recognized negative state, like `TecSafetyState`, not a keyword match).
+/// Excludes the literal substring "flash locked" (a captured, evidenced, benign boot-time firmware
+/// message, `frozen/command.rs` source comment, paired with "cal_info valid") and any `"[temps]"`
+/// health-report message (see `parse_temps_health_report`) for the same reason.
+fn is_generic_fault_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    if lower.contains("flash locked") || lower.contains("[temps]") {
+        return false;
+    }
+    let words: Vec<&str> = lower.split(|c: char| !c.is_alphanumeric()).filter(|w| !w.is_empty()).collect();
+    FAULT_KEYWORDS.iter().any(|&kw| {
+        if WORD_EXACT_FAULT_KEYWORDS.contains(&kw) {
+            words.contains(&kw)
+        } else {
+            lower.contains(kw)
+        }
+    })
+}
+
+/// Parses `"FW: [temps] <failed> reads failed out of <total>"` -- firmware's own temperature-read
+/// health counter (e.g. `"FW: [temps] 0 reads failed out of 1200"`). Purely descriptive telemetry,
+/// never itself a fault by any count -- a live-hardware run's own zero-failure report was the
+/// evidence behind excluding `"[temps]"` messages from `is_generic_fault_message` above and from
+/// `--firmware-authoritative` mode's fault detection entirely. Returns `(failed, total)`.
+fn parse_temps_health_report(msg: &str) -> Option<(u64, u64)> {
+    let lower = msg.to_lowercase();
+    let marker_idx = lower.find("[temps]")?;
+    let rest = &lower[marker_idx + "[temps]".len()..];
+    let failed_end = rest.find("reads failed")?;
+    let failed: u64 = rest[..failed_end].trim().parse().ok()?;
+    let after = &rest[failed_end + "reads failed".len()..];
+    let out_of_pos = after.find("out of")?;
+    let total_str = after[out_of_pos + "out of".len()..].trim();
+    let total_digits: String = total_str.chars().take_while(|c| c.is_ascii_digit()).collect();
+    let total: u64 = total_digits.parse().ok()?;
+    Some((failed, total))
+}
+
+/// Parses `"FW: [top-fan] <duty> @ <rpm> rpm"` / `"FW: [bottom-fan] <duty> @ <rpm> rpm"` -- global
+/// Hub thermal-management telemetry. Unlike pump/TEC messages, real captured fan telemetry has no
+/// left/right identifier at all: both fans serve the whole Hub, not either individual cooling
+/// side, so this is never scoped to (or expected to name) the selected side. `which` must be
+/// `"top-fan"` or `"bottom-fan"`. Returns `(duty, rpm)`.
+fn parse_fan_report(msg: &str, which: &str) -> Option<(f64, f64)> {
+    let lower = msg.to_lowercase();
+    let marker = format!("[{which}]");
+    let idx = lower.find(&marker)?;
+    let rest = &lower[idx + marker.len()..];
+    let at = rest.find('@')?;
+    let duty: f64 = rest[..at].trim().parse().ok()?;
+    let after_at = &rest[at + 1..];
+    let rpm_pos = after_at.find("rpm")?;
+    let rpm: f64 = after_at[..rpm_pos].trim().parse().ok()?;
+    Some((duty, rpm))
+}
+
+/// True if a firmware `Message` about the selected water/heatsink sensor is a known, non-fatal
+/// "sensor unavailable" notice (e.g. "FW: [capwater] sensor unavailable", "FW: [flowrate] sensor
+/// unavailable") rather than an active fault. These have been observed to persist with the cover
+/// connected and the reservoir filled; recorded as warnings, never treated as fatal by themselves.
+fn is_known_nonfatal_sensor_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    lower.contains("sensor unavailable")
+}
+
+/// Stop reasons this file treats as a genuine fault -- the only ones that can ever cause
+/// `run_cool_test_shutdown` to assert the narrow emergency I2C reset (and only then if UART-based
+/// shutdown also could not be confirmed). `Normal`/`DurationExpired`/`TargetTemperatureReached`/
+/// `CtrlC`/`Sigterm`/`Sighup`/`PreflightRefused` are all "no I2C write" outcomes.
+fn is_emergency_stop_reason(reason: StopReason) -> bool {
+    matches!(
+        reason,
+        StopReason::TecLocked
+            | StopReason::TecUnsafeLocking
+            | StopReason::FirmwareFaultMessage
+            | StopReason::TemperatureRangeExceeded
+            | StopReason::HeatsinkLimitExceeded
+            | StopReason::ImplausibleTemperatureChange
+            | StopReason::PumpNotConfirmedRunning
+            | StopReason::TargetDisabledUnexpectedly
+            | StopReason::TelemetryLost
+            | StopReason::TelemetryStale
+            | StopReason::CommunicationWatchdogExpired
+            | StopReason::TemperatureWatchdogExpired
+            | StopReason::TemperatureStartupGraceExpired
+            | StopReason::UartReadFailure
+            | StopReason::UartWriteFailure
+            | StopReason::Panic
+            | StopReason::OperatorAbort
+            | StopReason::FirmwareSafetyFault
+            | StopReason::EnabledTargetStateLost
+            | StopReason::FatalUartError
+            | StopReason::InternalProcessError
+            | StopReason::CommunicationSilenceExceeded
+            | StopReason::IndependentGuardFired
+    )
+}
+
+/// Short, stable, machine-readable identifier for `reason`, distinct from
+/// `StopReason::description()`'s human prose -- logged once at the start of every controlled
+/// shutdown (see `run_cool_test_shutdown`, the sole path from the active loop, baseline
+/// collection, and every preflight refusal into shutdown, so there is no path that skips this)
+/// and reported in `CoolTestResults::stop_reason_code`. A live-hardware incident asked for this
+/// vocabulary specifically so a stop reason is never ambiguous from the logs alone.
+fn stop_reason_code(reason: StopReason) -> &'static str {
+    match reason {
+        StopReason::DurationExpired => "requested_duration_expired",
+        StopReason::TargetTemperatureReached => "stable_target_reached",
+        StopReason::OperatorAbort => "operator_abort",
+        StopReason::CtrlC => "sigint",
+        // SIGHUP is handled identically to SIGTERM throughout this file (both simply select
+        // alongside SIGINT in wait_for_termination_signal); no distinct code was requested for it.
+        StopReason::Sigterm | StopReason::Sighup => "sigterm",
+        StopReason::TecUnsafeLocking => "explicit_tec_unsafe_locking",
+        StopReason::TecLocked => "explicit_tec_locked",
+        StopReason::UartReadFailure | StopReason::UartWriteFailure | StopReason::TelemetryLost => "communication_loss",
+        StopReason::CommunicationWatchdogExpired => "communication_watchdog_expired",
+        StopReason::TemperatureWatchdogExpired | StopReason::TelemetryStale => "temperature_watchdog_expired",
+        StopReason::TemperatureStartupGraceExpired => "temperature_startup_grace_expired",
+        StopReason::PumpNotConfirmedRunning => "pump_startup_failure",
+        StopReason::TargetDisabledUnexpectedly => "target_state_lost",
+        StopReason::TemperatureRangeExceeded | StopReason::HeatsinkLimitExceeded | StopReason::ImplausibleTemperatureChange => {
+            "thermal_safety_limit"
+        }
+        StopReason::FirmwareFaultMessage => "thermal_safety_limit",
+        StopReason::Panic => "internal_error",
+        StopReason::PreflightRefused => "preflight_refused",
+        // --firmware-authoritative mode's own spec vocabulary -- see that mode's module docs.
+        StopReason::FirmwareSafetyFault => "explicit_firmware_safety_fault",
+        StopReason::EnabledTargetStateLost => "enabled_target_state_explicitly_lost",
+        StopReason::FatalUartError => "fatal_uart_write_or_read_error",
+        StopReason::InternalProcessError => "internal_process_error",
+        StopReason::CommunicationSilenceExceeded => "communication_silence_exceeded",
+        // Never appears in the main run's own stop_reason_code -- only in the independent
+        // guard's own separate-process log line, via this same function.
+        StopReason::IndependentGuardFired => "independent_guard_fired",
+        // Never actually produced on any path this file's own code takes; kept for match
+        // exhaustiveness across the enum shared with the other subcommands.
+        _ => "internal_error",
+    }
+}
+
+/// The result of [`run_cool_test_shutdown`]. `pub(crate)`: also constructed by `guard.rs`'s own
+/// call into [`run_cool_test_shutdown`] from its separate process.
+#[derive(Debug, Clone, Default)]
+pub(crate) struct CoolTestShutdown {
+    left_disable_attempts: Vec<bool>,
+    right_disable_attempts: Vec<bool>,
+    /// `true` iff a `TargetUpdate(enabled=false)` was observed for *both* sides within
+    /// `SHUTDOWN_VERIFY_WINDOW` of the repeated disable attempts.
+    both_confirmed_disabled: bool,
+    uart_flushed: bool,
+    emergency_reset_asserted: bool,
+    /// `true` iff a firmware pump message for the selected side reported off/0V during the
+    /// shutdown verify window -- best-effort: `false` just means no such message happened to
+    /// arrive in that window, not that the pump is still running (`both_confirmed_disabled`, from
+    /// the protocol-level `TargetUpdate` ack, is the primary shutdown confirmation).
+    selected_pump_shutdown_observed: bool,
+    /// `true` iff a firmware TEC-current message for the selected side reported a near-zero
+    /// reading (see [`TEC_STOPPED_CURRENT_THRESHOLD_A`]) during the shutdown verify window.
+    /// Same best-effort caveat as `selected_pump_shutdown_observed`.
+    selected_tec_shutdown_observed: bool,
+}
+
+impl CoolTestShutdown {
+    pub(crate) fn verified(&self) -> bool {
+        self.both_confirmed_disabled || self.emergency_reset_asserted
+    }
+}
+
+/// Cool-test's own shutdown: disables both sides over UART (three repeated attempts with short
+/// spacing, matching `safe_stop::run_safe_stop`'s cadence), flushes, then reads briefly to confirm
+/// both sides are actually disabled. Never performs a full subsystem reset, and never writes any
+/// I2C register on a normal stop -- only if the UART-based confirmation above failed *and*
+/// `stop_reason` is a genuine fault (see [`is_emergency_stop_reason`]) does it fall back to the
+/// narrow, bit-1-only `i2c::assert_frozen_reset_bit_only`. See module docs.
+pub(crate) async fn run_cool_test_shutdown<T, P>(
+    link: Option<&mut FrozenLink<T>>,
+    audit: &mut AuditedTransport,
+    i2c: &mut P,
+    stop_reason: StopReason,
+    side: BedSide,
+) -> CoolTestShutdown
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let side_tag = side_word(side);
+    // Every path into controlled shutdown funnels through this one function -- the active loop,
+    // baseline-collection interruption, and every preflight refusal all call this before
+    // returning -- so this single log line structurally guarantees there is no path from the
+    // active loop to shutdown without an assigned, logged stop reason.
+    log::info!("beginning controlled shutdown: stop_reason={}", stop_reason_code(stop_reason));
+    let mut result = CoolTestShutdown::default();
+
+    if let Some(link) = link {
+        // The disable command's own reply *is* the `TargetUpdate` confirmation (real hardware and
+        // the mock device both answer `SetTargetTemperature` this way) -- captured directly from
+        // each `send()` response, not just its success/failure, so a normal shutdown never needs
+        // to wait for a separate unsolicited push that may never come.
+        let mut left_confirmed_disabled = false;
+        let mut right_confirmed_disabled = false;
+        for attempt in 0..SHUTDOWN_REPEAT_COUNT {
+            log::info!("cool-test shutdown: disable attempt {}/{SHUTDOWN_REPEAT_COUNT}", attempt + 1);
+            let left_outcome = link.send(audit, FrozenAction::safety_off(BedSide::Left), SHUTDOWN_DISABLE_WAIT).await;
+            if let Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((BedSide::Left, t)))) = &left_outcome
+                && !t.enabled
+            {
+                left_confirmed_disabled = true;
+            }
+            result.left_disable_attempts.push(left_outcome.is_ok());
+
+            let right_outcome = link.send(audit, FrozenAction::safety_off(BedSide::Right), SHUTDOWN_DISABLE_WAIT).await;
+            if let Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((BedSide::Right, t)))) = &right_outcome
+                && !t.enabled
+            {
+                right_confirmed_disabled = true;
+            }
+            result.right_disable_attempts.push(right_outcome.is_ok());
+
+            if attempt + 1 < SHUTDOWN_REPEAT_COUNT {
+                tokio::time::sleep(SHUTDOWN_BETWEEN_ATTEMPTS_DELAY).await;
+            }
+        }
+
+        match link.flush().await {
+            Ok(()) => {
+                result.uart_flushed = true;
+                log::info!("cool-test shutdown: UART flushed");
+            }
+            Err(e) => log::error!("cool-test shutdown: UART flush failed: {e}"),
+        }
+
+        // Only if the disable acks above didn't already confirm both sides, keep reading briefly
+        // in case Frozen sends a further unsolicited confirmation -- bounded, and skipped
+        // entirely (no wasted wait) once both sides are already confirmed.
+        if !(left_confirmed_disabled && right_confirmed_disabled) {
+            let verify_deadline = Instant::now() + SHUTDOWN_VERIFY_WINDOW;
+            loop {
+                if left_confirmed_disabled && right_confirmed_disabled {
+                    break;
+                }
+                let remaining = verify_deadline.saturating_duration_since(Instant::now());
+                if remaining.is_zero() {
+                    break;
+                }
+                match link.recv(remaining).await {
+                    Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((s, t)))) if !t.enabled => match s {
+                        BedSide::Left => left_confirmed_disabled = true,
+                        BedSide::Right => right_confirmed_disabled = true,
+                    },
+                    // Best-effort pump/TEC shutdown evidence -- see `CoolTestShutdown`'s doc
+                    // comments on these two fields for why this is "when available", not required.
+                    Ok(PacketOutcome::Received(FrozenPacket::Message(m))) => {
+                        if parse_pump_report(&m, side_tag) == Some(false) {
+                            result.selected_pump_shutdown_observed = true;
+                        }
+                        if let Some(amps) = parse_tec_current(&m, side_tag)
+                            && amps.abs() <= TEC_STOPPED_CURRENT_THRESHOLD_A
+                        {
+                            result.selected_tec_shutdown_observed = true;
+                        }
+                    }
+                    Ok(PacketOutcome::Closed) | Err(_) => break,
+                    _ => {}
+                }
+            }
+        }
+        result.both_confirmed_disabled = left_confirmed_disabled && right_confirmed_disabled;
+    } else {
+        log::warn!("cool-test shutdown: no Frozen UART link was open; skipping disable commands");
+    }
+
+    let uart_disable_ok = result.left_disable_attempts.iter().any(|&ok| ok)
+        && result.right_disable_attempts.iter().any(|&ok| ok)
+        && result.both_confirmed_disabled;
+
+    if !uart_disable_ok && is_emergency_stop_reason(stop_reason) {
+        log::error!(
+            "cool-test shutdown: target shutdown could not be confirmed for a genuine fault ({stop_reason}) -- \
+             asserting emergency Frozen-only reset"
+        );
+        match crate::i2c::assert_frozen_reset_bit_only(i2c).await {
+            Ok(r) if r.readback_matches && r.only_bit1_changed => {
+                result.emergency_reset_asserted = true;
+                log::warn!("cool-test shutdown: emergency Frozen-only reset asserted (0x20 reg 0x02 bit 1 set); left asserted");
+            }
+            Ok(r) => log::error!(
+                "cool-test shutdown: emergency reset write did not verify: readback_matches={} only_bit1_changed={}",
+                r.readback_matches, r.only_bit1_changed
+            ),
+            Err(e) => log::error!("cool-test shutdown: FAILED to assert emergency Frozen-only reset: {e}"),
+        }
+    }
+
+    if result.verified() {
+        eprintln!(
+            "--frozen-cool-test: shutdown verified (both targets confirmed disabled{}).",
+            if result.emergency_reset_asserted { " via emergency reset" } else { "" }
+        );
+    } else {
+        eprintln!(
+            "--frozen-cool-test: WARNING -- shutdown could NOT be verified. If cooling does not visibly \
+             stop, reboot the Hub or disconnect Hub power."
+        );
+    }
+    result
+}
+
+#[allow(clippy::too_many_arguments)]
+async fn run_core<T, P>(
+    args: &CoolTestArgs,
+    i2c: &mut P,
+    link: &mut FrozenLink<T>,
+    dry_run: bool,
+    operator_abort_rx_override: Option<mpsc::UnboundedReceiver<String>>,
+    // Raw RX/TX bytes for the same link, captured below `Framed`/`PacketCodec` -- see
+    // `frozen_compat.rs` module docs. `None` in the many existing tests that only exercise the
+    // normal decode path (unaffected: they never look for the 14-byte compat reply); `Some` for
+    // every real run and for tests that specifically exercise `CompatFrameScanner` end to end.
+    capture: Option<RawIoCapture>,
+    // Only ever `true` from `run()`'s real (non-dry-run) path when `--firmware-authoritative` was
+    // requested: spawns `guard.rs`'s independent shutdown guard as a real, separate re-exec'd OS
+    // process once the target is confirmed enabled. Always `false` in every test in this file --
+    // `std::env::current_exe()` under `cargo test` resolves to the *test* binary, which has no
+    // `internal-cool-test-guard` subcommand, so this must never be exercised as `true` outside a
+    // real packaged binary. See `guard.rs` module docs and item 9 of the fix this parameter was
+    // added for.
+    spawn_guard: bool,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let side: BedSide = args.side.into();
+    let side_tag = side_word(side);
+    let mut audit = AuditedTransport::new(Mode::CoolTest { side });
+    let mut stats = PacketStats::default();
+    let mut samples: Vec<TemperatureSampleJson> = Vec::new();
+    let mut cr = ComponentResults::default();
+    let mut ct = CoolTestResults {
+        selected_side: side_tag.to_string(),
+        // Placeholder until baseline collection completes and the real delta (from --delta-c,
+        // --target-c, or the default) is known and reassigned below -- see the large-delta
+        // confirmation check.
+        requested_delta_c: args.delta_c.unwrap_or(DEFAULT_DELTA_C),
+        requested_duration_seconds: args.duration_seconds,
+        startup_mode: STARTUP_MODE_LABEL.to_string(),
+        // `run_core` is only ever reached (via `run()`) after any *required* confirmation has
+        // already succeeded -- `run()` returns early otherwise, before opening any hardware --
+        // so reaching this line already proves --confirm-extended-test was set whenever it was
+        // required. Tests that call `run_core` directly (bypassing `run()`'s own checks entirely)
+        // get the same, correct answer: it wasn't needed unless the duration itself exceeds the
+        // threshold.
+        extended_test_confirmation_received: args.duration_seconds > EXTENDED_DURATION_THRESHOLD_SECONDS,
+        control_authority: if args.firmware_authoritative { "firmware" } else { "diagnostic" }.to_string(),
+        ..Default::default()
+    };
+
+    let led = probe_address(i2c, crate::i2c::LED_CONTROLLER_ADDR);
+    if !led.success {
+        log::info!("LED controller unavailable; continuing diagnostic ({})", led.describe());
+    }
+
+    // Items 1-9: the narrow startup shared with `frozen-prime-opensleep-init
+    // --release-frozen-only` -- pulse only bit 1 of registers 0x02/0x06 (never the full reset
+    // sequence, never opensleep::reset::ResetController, never register 0x07), then wait for boot
+    // messages and Ping/JumpToFirmware until application firmware is reached. See module docs.
+    let startup = crate::frozen_startup::start_frozen_narrow(i2c, link, &mut audit).await;
+    let expander_value = startup.pulse.assert_output_step.original;
+
+    if !startup.pulse.fully_verified() {
+        log::error!("refusing to run active test: register 0x02/0x06 pulse did not verify");
+        ct.stop_reason = StopReason::PreflightRefused.to_string();
+        ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 20,
+            expander_value, &led, false, false,
+        );
+    }
+    if !startup.ping_ok || !startup.frozen_reached_firmware {
+        log::error!("refusing to run active test: Frozen did not reach application firmware");
+        let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused, side).await;
+        cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+        ct.shutdown_verified = shutdown.verified();
+        ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+        ct.stop_reason = StopReason::PreflightRefused.to_string();
+        ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 20,
+            expander_value, &led, true, startup.frozen_reached_firmware,
+        );
+    }
+    debug_assert!(startup.started_successfully(), "both preflight checks above passed, so this must hold");
+
+    // Explicitly disable both sides, and confirm from the acks that neither is enabled -- the
+    // selected side will be the only one ever enabled below, and the other side is kept disabled
+    // for the whole run.
+    let mut left_enabled_after_disable = None;
+    let mut right_enabled_after_disable = None;
+    for s in [BedSide::Left, BedSide::Right] {
+        match link.send(&mut audit, FrozenAction::safety_off(s), COMMAND_TIMEOUT).await {
+            Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((side, t)))) => match side {
+                BedSide::Left => left_enabled_after_disable = Some(t.enabled),
+                BedSide::Right => right_enabled_after_disable = Some(t.enabled),
+            },
+            Ok(_) => {}
+            Err(e) => log::error!("safety-off for {s:?} failed: {e}"),
+        }
+    }
+    if left_enabled_after_disable == Some(true) || right_enabled_after_disable == Some(true) {
+        log::error!("refusing to run active test: an enabled target is still active after safety-off");
+        let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused, side).await;
+        cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+        ct.shutdown_verified = shutdown.verified();
+        ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+        ct.stop_reason = StopReason::PreflightRefused.to_string();
+        ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+            expander_value, &led, true, true,
+        );
+    }
+
+    // Preflight: at least BASELINE_MIN_SAMPLES valid samples over at least BASELINE_MIN_WINDOW, or
+    // BASELINE_MAX_WINDOW elapsed, whichever comes first. Accepts valid temperatures from both the
+    // unsolicited TemperatureUpdate push and decoded GetTemperature replies -- the original 27-byte
+    // reply via the unmodified upstream parser, and this firmware's 14-byte reply recovered by
+    // `frozen_compat::CompatFrameScanner` from raw captured bytes (see that module's docs for why a
+    // raw-byte tap is the only way to see it at all) -- deduplicated within each ~1s tick and
+    // filtered for per-sample validity before ever counting toward the minimum.
+    let baseline_start = Instant::now();
+    let mut baseline_samples: Vec<TemperatureSample> = Vec::new();
+    let mut baseline_synchronous_decoded: usize = 0;
+    let mut baseline_unsolicited_decoded: usize = 0;
+    let mut baseline_duplicates_discarded: usize = 0;
+    let mut baseline_invalid_discarded: usize = 0;
+    let mut compat_get_temperature_14byte_frames: u64 = 0;
+    let mut compat_heartbeat_9byte_frames: u64 = 0;
+    let mut compat_opcode_0x54_frames: u64 = 0;
+    let mut compat_opcode_0x55_frames: u64 = 0;
+    let mut compat_scanner = CompatFrameScanner::new();
+    // Skip preflight/disable-phase traffic already sitting in the capture -- only bytes that
+    // arrive from here on are relevant to baseline compat scanning.
+    let mut raw_scan_checkpoint: usize = capture.as_ref().and_then(|c| c.lock().ok()).map(|c| c.len()).unwrap_or(0);
+
+    // Racing `wait_for_termination_signal()` here (not just in the active loop below) closes a
+    // real gap: `tokio::signal::ctrl_c()` only replaces the OS's default "kill immediately"
+    // SIGINT disposition once it has been awaited somewhere in the process, and baseline
+    // collection (up to BASELINE_MAX_WINDOW = 60s) runs entirely before the active loop ever
+    // reaches its own signal race. Without this, the first Ctrl+C during baseline collection would
+    // terminate the process outright -- skipping `run_cool_test_shutdown` entirely -- instead of
+    // triggering the same controlled shutdown every other exit path uses.
+    let mut baseline_interrupted: Option<StopReason> = None;
+    'baseline: while baseline_should_continue(baseline_samples.len(), baseline_start.elapsed()) {
+        if let Err(e) = link.send_only(&mut audit, FrozenAction::get_temperatures()).await {
+            log::error!("failed to send GetTemperatures during baseline collection: {e}");
+            stats.record_timeout();
+        }
+
+        let tick_start_index = baseline_samples.len();
+        let mut tick_candidates: Vec<TemperatureSample> = Vec::new();
+
+        let drain_deadline = Instant::now() + TICK_DRAIN_WINDOW;
+        loop {
+            let remaining = drain_deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            tokio::select! {
+                biased;
+                reason = wait_for_termination_signal() => {
+                    baseline_interrupted = Some(reason);
+                    break 'baseline;
+                }
+                outcome = link.recv(remaining) => {
+                    match outcome {
+                        Ok(PacketOutcome::Received(pkt)) => {
+                            stats.record(&pkt);
+                            let elapsed_ms = baseline_start.elapsed().as_millis() as u64;
+                            match pkt {
+                                FrozenPacket::TemperatureUpdate(u) => {
+                                    let sample = sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u);
+                                    samples.push((&sample).into());
+                                    tick_candidates.push(sample);
+                                }
+                                FrozenPacket::GetTemperature(g) => {
+                                    let sample = sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g);
+                                    samples.push((&sample).into());
+                                    tick_candidates.push(sample);
+                                }
+                                _ => {}
+                            }
+                        }
+                        Ok(PacketOutcome::TimedOut) => break,
+                        Ok(PacketOutcome::Closed) => break,
+                        Err(e) => {
+                            log::debug!("baseline collection: {e}");
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+
+        // Raw-capture-based recovery of the 14-byte GetTemperature shape the drain loop above can
+        // never see through the normal decode path (`PacketCodec::decode` discards it before it
+        // ever reaches `Framed::next()` -- see `frozen_compat.rs`), and, while scanning the same
+        // bytes, concise counters for the other known firmware-compatibility frame shapes (item 8).
+        if let Some(capture) = &capture {
+            let new_events = crate::io_logging::events_since(capture, &mut raw_scan_checkpoint);
+            for event in new_events.iter().filter(|e| e.direction == "rx") {
+                if let Some(bytes) = crate::io_logging::hex_to_bytes(&event.hex) {
+                    compat_scanner.feed(&bytes);
+                }
+            }
+            for frame in compat_scanner.drain_frames() {
+                match frame.opcode {
+                    crate::frozen_compat::GET_TEMPERATURE_OPCODE => {
+                        if let Some(g) = crate::frozen_compat::decode_get_temperature_14byte(&frame.payload) {
+                            compat_get_temperature_14byte_frames += 1;
+                            let elapsed_ms = baseline_start.elapsed().as_millis() as u64;
+                            let sample =
+                                sample_from_get_temperature_compat14(elapsed_ms, jiff::Timestamp::now().to_string(), &g);
+                            samples.push((&sample).into());
+                            tick_candidates.push(sample);
+                        }
+                    }
+                    crate::frozen_compat::HEARTBEAT_OPCODE
+                        if frame.payload.len() == crate::frozen_compat::HEARTBEAT_OBSERVED_COMPAT_SIZE =>
+                    {
+                        compat_heartbeat_9byte_frames += 1;
+                    }
+                    0x54 => compat_opcode_0x54_frames += 1,
+                    0x55 => compat_opcode_0x55_frames += 1,
+                    _ => {}
+                }
+            }
+        }
+
+        for candidate in tick_candidates {
+            if !is_valid_baseline_reading(side, &candidate) {
+                baseline_invalid_discarded += 1;
+                continue;
+            }
+            if is_duplicate_within_tick(&baseline_samples[tick_start_index..], &candidate) {
+                baseline_duplicates_discarded += 1;
+                continue;
+            }
+            match candidate.source {
+                SampleSource::Unsolicited => baseline_unsolicited_decoded += 1,
+                SampleSource::Solicited | SampleSource::SolicitedCompat14Byte => baseline_synchronous_decoded += 1,
+            }
+            baseline_samples.push(candidate);
+        }
+    }
+
+    if let Some(reason) = baseline_interrupted {
+        log::error!("baseline collection interrupted: {reason}");
+        let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, reason, side).await;
+        cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+        ct.shutdown_verified = shutdown.verified();
+        ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+        ct.stop_reason = reason.to_string();
+        ct.stop_reason_code = stop_reason_code(reason).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, reason, false, 30, expander_value, &led, true, true,
+        );
+    }
+
+    let baseline_collection_duration = baseline_start.elapsed();
+    ct.baseline_samples_requested = BASELINE_MIN_SAMPLES;
+    ct.baseline_synchronous_samples_decoded = baseline_synchronous_decoded;
+    ct.baseline_unsolicited_samples_decoded = baseline_unsolicited_decoded;
+    ct.baseline_duplicate_samples_discarded = baseline_duplicates_discarded;
+    ct.baseline_invalid_samples_discarded = baseline_invalid_discarded;
+    ct.baseline_collection_duration_seconds = baseline_collection_duration.as_secs_f64();
+    ct.compat_get_temperature_14byte_frames = compat_get_temperature_14byte_frames;
+    ct.compat_heartbeat_9byte_frames = compat_heartbeat_9byte_frames;
+    ct.compat_opcode_0x54_frames = compat_opcode_0x54_frames;
+    ct.compat_opcode_0x55_frames = compat_opcode_0x55_frames;
+
+    let baseline = match validate_baseline(&baseline_samples, side) {
+        Some(b) => b,
+        None => {
+            log::error!("refusing to run active test: baseline temperature did not pass validation");
+            let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused, side).await;
+            cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+            ct.shutdown_verified = shutdown.verified();
+            ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+            ct.stop_reason = StopReason::PreflightRefused.to_string();
+            ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+                expander_value, &led, true, true,
+            );
+        }
+    };
+    if let Some(last) = baseline_samples.last() {
+        ct.baseline_left_c = last.left_water_c;
+        ct.baseline_right_c = last.right_water_c;
+        ct.baseline_heatsink_c = last.heatsink_c;
+    }
+    ct.baseline_left_range_c = baseline_range_c(&baseline_samples, |s| s.raw_left);
+    ct.baseline_right_range_c = baseline_range_c(&baseline_samples, |s| s.raw_right);
+    ct.baseline_heatsink_range_c = baseline_range_c(&baseline_samples, |s| s.raw_heatsink);
+
+    // Item 2/3: --target-c is validated against the just-measured baseline here (it cannot be
+    // validated any earlier, since the baseline isn't known until now); --delta-c's own
+    // finiteness/positivity was already checked in run() before any hardware access. Neither path
+    // enforces a fixed maximum delta any more -- see safety::FrozenAction::enable_cooling's doc
+    // comment for why -- only the auditable --confirm-large-temperature-delta acknowledgement
+    // above LARGE_DELTA_CONFIRMATION_THRESHOLD_CENTIDEG.
+    let delta_centideg = match args.target_c {
+        Some(target_c) => {
+            let target_centideg = (target_c * 100.0).round() as i32;
+            i32::from(baseline as u16) - target_centideg
+        }
+        None => (args.delta_c.unwrap_or(DEFAULT_DELTA_C) * 100.0).round() as i32,
+    };
+    ct.requested_delta_c = f64::from(delta_centideg) / 100.0;
+
+    if delta_centideg > LARGE_DELTA_CONFIRMATION_THRESHOLD_CENTIDEG && !args.confirm_large_temperature_delta {
+        log::error!(
+            "refusing to run active test: requested delta {:.2}C exceeds {:.2}C and requires \
+             --confirm-large-temperature-delta",
+            ct.requested_delta_c,
+            f64::from(LARGE_DELTA_CONFIRMATION_THRESHOLD_CENTIDEG) / 100.0
+        );
+        let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused, side).await;
+        cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+        ct.shutdown_verified = shutdown.verified();
+        ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+        ct.stop_reason = StopReason::PreflightRefused.to_string();
+        ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+        return finish(
+            args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+            expander_value, &led, true, true,
+        );
+    }
+
+    let action = match FrozenAction::enable_cooling(side, baseline as u16, delta_centideg) {
+        Ok(a) => a,
+        Err(e) => {
+            log::error!("refusing to run active test: {e}");
+            let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, StopReason::PreflightRefused, side).await;
+            cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+            ct.shutdown_verified = shutdown.verified();
+            ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+            ct.stop_reason = StopReason::PreflightRefused.to_string();
+            ct.stop_reason_code = stop_reason_code(StopReason::PreflightRefused).to_string();
+            return finish(
+                args, dry_run, &audit, &stats, samples, cr, ct, StopReason::PreflightRefused, false, 30,
+                expander_value, &led, true, true,
+            );
+        }
+    };
+    let target_centideg = action.target_centideg().unwrap_or(0);
+
+    print_proposed_target(side, baseline, delta_centideg, target_centideg, args.duration_seconds);
+    // No more typed confirmation phrases -- see cli.rs's --non-interactive doc comment. The four
+    // required --confirm-* flags plus (when applicable) --confirm-extended-test and
+    // --confirm-large-temperature-delta are the sole acknowledgement mechanism now; a fully
+    // specified command proceeds straight through to enabling cooling with no further prompts.
+    // reservoir_status is left at its Unverified default (see ReservoirStatus's own doc comment):
+    // there is no longer an interactive reservoir-indicator confirmation to have asked.
+
+    let mut operator_abort_rx = match operator_abort_rx_override {
+        Some(rx) => Some(rx),
+        None => spawn_operator_abort_watcher(),
+    };
+
+    // Active execution.
+    let send_result = link.send(&mut audit, action, COMMAND_TIMEOUT).await;
+    cr.frozen_command_accepted = match &send_result {
+        Ok(_) => Verdict::Pass,
+        Err(_) => Verdict::Fail,
+    };
+    if send_result.is_ok() {
+        eprintln!(
+            "If you observe a leak, a burning smell, or abnormal noise, type ABORT and press Enter \
+             (or press Ctrl+C) to stop immediately."
+        );
+    }
+    if args.firmware_authoritative {
+        return run_firmware_authoritative_phase(
+            args, i2c, link, &mut audit, &mut stats, &mut samples, side, side_tag, target_centideg, send_result,
+            &mut operator_abort_rx, &capture, &mut compat_scanner, &mut raw_scan_checkpoint,
+            &mut compat_get_temperature_14byte_frames, &mut compat_heartbeat_9byte_frames,
+            &mut compat_opcode_0x54_frames, &mut compat_opcode_0x55_frames, cr, ct, dry_run, expander_value, &led,
+            spawn_guard,
+        )
+        .await;
+    }
+
+    let we_enabled_side = send_result.is_ok();
+
+    let active_start = Instant::now();
+    let duration = Duration::from_secs(args.duration_seconds.min(HARD_MAX_DURATION_SECONDS));
+    // Four separate freshness clocks, not one shared clock -- see ANY_VALID_RX_LIMIT/
+    // TEMPERATURE_FRESHNESS_LIMIT/ACTIVE_STARTUP_GRACE's doc comments for the real-hardware
+    // incident that resulted from conflating "any packet arrived" with "a temperature sample
+    // arrived". The pump/TEC clocks are tracked for visibility but do not themselves gate a stop
+    // condition (pump startup failure already has its own evidence-gated mechanism below).
+    let mut last_any_valid_rx_at = Instant::now();
+    let mut last_temperature_sample_at: Option<Instant> = None;
+    let mut last_selected_pump_telemetry_at: Option<Instant> = None;
+    let mut last_selected_tec_telemetry_at: Option<Instant> = None;
+    let mut active_left_c: Vec<f64> = Vec::new();
+    let mut active_right_c: Vec<f64> = Vec::new();
+    let mut prev_side_centideg: Option<i32> = None;
+    let mut min_left_c: Option<f64> = None;
+    let mut min_right_c: Option<f64> = None;
+    let mut final_left_c: Option<f64> = None;
+    let mut final_right_c: Option<f64> = None;
+    let mut final_heatsink_c: Option<f64> = None;
+    let mut max_heatsink_c: Option<f64> = None;
+    let mut target_reached = false;
+    let mut target_reached_at: Option<Instant> = None;
+    let mut time_to_target_seconds: Option<f64> = None;
+    let mut tec_activity_seen = false;
+    let mut left_pump_activity_observed = false;
+    let mut right_pump_activity_observed = false;
+    let mut selected_tec_safety_passed = false;
+    let mut selected_tec_unlocking_observed = false;
+    let mut tec_current_first_a: Option<f64> = None;
+    let mut tec_current_min_a: Option<f64> = None;
+    let mut tec_current_max_a: Option<f64> = None;
+    let mut tec_current_last_a: Option<f64> = None;
+    let mut tec_current_samples: u64 = 0;
+    #[allow(unused_assignments)]
+    let mut stop_reason = StopReason::Normal;
+    let mut telemetry_ok = true;
+    let mut pump_confirmed_running = false;
+    let mut pump_last_report_off = false;
+
+    'active: loop {
+        if active_start.elapsed() >= duration {
+            stop_reason = StopReason::DurationExpired;
+            break;
+        }
+
+        // Best-effort solicited nudge: preserved/logged as raw evidence only if a reply happens
+        // to decode (see module docs). A write failure here is a real UART communication failure
+        // and does abort the run.
+        if let Err(e) = link.send_only(&mut audit, FrozenAction::get_temperatures()).await {
+            log::error!("UART write failure during active phase: {e}");
+            stop_reason = StopReason::UartWriteFailure;
+            telemetry_ok = false;
+            break 'active;
+        }
+
+        let drain_deadline = Instant::now() + TICK_DRAIN_WINDOW;
+        loop {
+            let remaining = drain_deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            tokio::select! {
+                biased;
+                reason = wait_for_termination_signal() => {
+                    stop_reason = reason;
+                    break 'active;
+                }
+                maybe_line = async {
+                    match operator_abort_rx.as_mut() {
+                        Some(rx) => rx.recv().await,
+                        None => std::future::pending().await,
+                    }
+                } => {
+                    match maybe_line {
+                        Some(line) if is_operator_abort_line(&line) => {
+                            log::error!("operator-reported abort: {line:?}");
+                            stop_reason = StopReason::OperatorAbort;
+                            telemetry_ok = false;
+                            break 'active;
+                        }
+                        Some(line) => {
+                            log::info!("ignoring unrecognized operator input during active phase: {line:?}");
+                        }
+                        None => {
+                            // The channel closed (sender dropped, e.g. stdin hit EOF). Stop
+                            // polling it: with `biased` select ordering, a closed channel
+                            // resolves to `None` instantly on every poll, which would otherwise
+                            // starve `link.recv()` below forever and falsely stale out telemetry.
+                            operator_abort_rx = None;
+                        }
+                    }
+                }
+                outcome = link.recv(remaining) => {
+                    match outcome {
+                        Ok(PacketOutcome::Received(pkt)) => {
+                            // Communication-watchdog clock: refreshed by *any* successfully
+                            // decoded packet, regardless of type -- see ANY_VALID_RX_LIMIT's doc
+                            // comment for why this is deliberately separate from the
+                            // temperature-specific clock below.
+                            last_any_valid_rx_at = Instant::now();
+                            match pkt {
+                                FrozenPacket::TemperatureUpdate(u) => {
+                                    stats.record(&FrozenPacket::TemperatureUpdate(u.clone()));
+                                    last_temperature_sample_at = Some(Instant::now());
+                                    let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                    samples.push((&sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u)).into());
+                                    if let Some(reason) = record_active_temperature_sample(
+                                        side, u.left_temp, u.right_temp, u.heatsink_temp, we_enabled_side,
+                                        target_centideg, active_start, &mut active_left_c, &mut active_right_c,
+                                        &mut prev_side_centideg, &mut min_left_c, &mut min_right_c, &mut max_heatsink_c,
+                                        &mut final_left_c, &mut final_right_c, &mut final_heatsink_c,
+                                        &mut target_reached, &mut target_reached_at, &mut time_to_target_seconds,
+                                    ) {
+                                        stop_reason = reason;
+                                        if !matches!(reason, StopReason::TargetTemperatureReached) {
+                                            telemetry_ok = false;
+                                        }
+                                        break 'active;
+                                    }
+                                }
+                                FrozenPacket::GetTemperature(g) => {
+                                    // No longer "raw evidence only": a synchronous GetTemperatures
+                                    // response is now a first-class temperature source during the
+                                    // active phase too, symmetric with the unsolicited push -- see
+                                    // record_active_temperature_sample's doc comment.
+                                    stats.record(&FrozenPacket::GetTemperature(g.clone()));
+                                    last_temperature_sample_at = Some(Instant::now());
+                                    let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                    samples.push((&sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g)).into());
+                                    if let Some(reason) = record_active_temperature_sample(
+                                        side, g.left_temp, g.right_temp, g.heatsink_temp, we_enabled_side,
+                                        target_centideg, active_start, &mut active_left_c, &mut active_right_c,
+                                        &mut prev_side_centideg, &mut min_left_c, &mut min_right_c, &mut max_heatsink_c,
+                                        &mut final_left_c, &mut final_right_c, &mut final_heatsink_c,
+                                        &mut target_reached, &mut target_reached_at, &mut time_to_target_seconds,
+                                    ) {
+                                        stop_reason = reason;
+                                        if !matches!(reason, StopReason::TargetTemperatureReached) {
+                                            telemetry_ok = false;
+                                        }
+                                        break 'active;
+                                    }
+                                }
+                                FrozenPacket::Message(m) => {
+                                    stats.record(&FrozenPacket::Message(m.clone()));
+                                    if let Some(running) = parse_pump_report(&m, side_tag) {
+                                        pump_confirmed_running |= running;
+                                        pump_last_report_off = !running;
+                                        last_selected_pump_telemetry_at = Some(Instant::now());
+                                    }
+                                    if parse_pump_report(&m, "left") == Some(true) {
+                                        left_pump_activity_observed = true;
+                                    }
+                                    if parse_pump_report(&m, "right") == Some(true) {
+                                        right_pump_activity_observed = true;
+                                    }
+                                    // TEC-prefixed messages are routed by exact type, not tried
+                                    // against every parser unconditionally: a "current:" line
+                                    // must never reach the safety-state parser (it previously
+                                    // did, producing a spurious "unrecognized TEC safety-state
+                                    // message" warning for perfectly valid telemetry).
+                                    if let Some(amps) = parse_tec_current(&m, side_tag) {
+                                        tec_current_samples += 1;
+                                        tec_current_first_a.get_or_insert(amps);
+                                        tec_current_min_a = Some(tec_current_min_a.map_or(amps, |v: f64| v.min(amps)));
+                                        tec_current_max_a = Some(tec_current_max_a.map_or(amps, |v: f64| v.max(amps)));
+                                        tec_current_last_a = Some(amps);
+                                        tec_activity_seen = true;
+                                        last_selected_tec_telemetry_at = Some(Instant::now());
+                                    } else if let Some(state) = parse_tec_safety_state(&m, side_tag) {
+                                        last_selected_tec_telemetry_at = Some(Instant::now());
+                                        match state {
+                                            TecSafetyState::Locked => {
+                                                log::error!("firmware reported the selected TEC locked: {m:?}");
+                                                stop_reason = StopReason::TecLocked;
+                                                telemetry_ok = false;
+                                                break 'active;
+                                            }
+                                            TecSafetyState::UnsafeLocking => {
+                                                log::error!(
+                                                    "firmware reported the selected TEC transitioning unsafe (locking): {m:?}"
+                                                );
+                                                stop_reason = StopReason::TecUnsafeLocking;
+                                                telemetry_ok = false;
+                                                break 'active;
+                                            }
+                                            TecSafetyState::SafeUnlocking => {
+                                                selected_tec_safety_passed = true;
+                                                selected_tec_unlocking_observed = true;
+                                                tec_activity_seen = true;
+                                            }
+                                            TecSafetyState::Unlocked => {
+                                                selected_tec_safety_passed = true;
+                                                tec_activity_seen = true;
+                                            }
+                                            TecSafetyState::Unknown => {
+                                                log::warn!(
+                                                    "unrecognized TEC safety-state message (not treated as a fault): {m:?}"
+                                                );
+                                            }
+                                        }
+                                    }
+                                    if is_known_nonfatal_sensor_message(&m) {
+                                        log::warn!("firmware sensor-unavailable message (non-fatal): {m:?}");
+                                    } else if active_start.elapsed() > FAULT_KEYWORD_GRACE && is_generic_fault_message(&m) {
+                                        log::error!("firmware fault message during active phase: {m:?}");
+                                        stop_reason = StopReason::FirmwareFaultMessage;
+                                        telemetry_ok = false;
+                                        break 'active;
+                                    }
+                                }
+                                FrozenPacket::TargetUpdate((s, target)) => {
+                                    stats.record(&FrozenPacket::TargetUpdate((s, target.clone())));
+                                    if s == side && we_enabled_side && !target.enabled {
+                                        log::error!("Frozen disabled the selected side unexpectedly");
+                                        stop_reason = StopReason::TargetDisabledUnexpectedly;
+                                        telemetry_ok = false;
+                                        break 'active;
+                                    }
+                                }
+                                other => {
+                                    stats.record(&other);
+                                }
+                            }
+                        }
+                        Ok(PacketOutcome::TimedOut) => break, // nothing more buffered right now
+                        Ok(PacketOutcome::Closed) => {
+                            stop_reason = StopReason::TelemetryLost;
+                            telemetry_ok = false;
+                            break 'active;
+                        }
+                        Err(LinkError::ReadIo(e)) => {
+                            log::error!("UART read failure during active phase: {e}");
+                            stop_reason = StopReason::UartReadFailure;
+                            telemetry_ok = false;
+                            break 'active;
+                        }
+                        Err(e) => {
+                            // WriteIo/Safety are structurally unreachable from `recv()` (it never
+                            // writes or checks the audit); handled generically for exhaustiveness.
+                            log::error!("unexpected error draining telemetry: {e}");
+                        }
+                    }
+                }
+            }
+        }
+
+        // Raw-capture-based recovery of the 14-byte GetTemperature shape during the active phase
+        // too, not only baseline collection -- see record_active_temperature_sample's doc comment
+        // for why. Also continues tallying the other known firmware-compatibility frame shapes.
+        if let Some(capture) = &capture {
+            let new_events = crate::io_logging::events_since(capture, &mut raw_scan_checkpoint);
+            for event in new_events.iter().filter(|e| e.direction == "rx") {
+                if let Some(bytes) = crate::io_logging::hex_to_bytes(&event.hex) {
+                    compat_scanner.feed(&bytes);
+                }
+            }
+            for frame in compat_scanner.drain_frames() {
+                match frame.opcode {
+                    crate::frozen_compat::GET_TEMPERATURE_OPCODE => {
+                        if let Some(g) = crate::frozen_compat::decode_get_temperature_14byte(&frame.payload) {
+                            compat_get_temperature_14byte_frames += 1;
+                            last_any_valid_rx_at = Instant::now();
+                            last_temperature_sample_at = Some(Instant::now());
+                            let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                            let sample =
+                                sample_from_get_temperature_compat14(elapsed_ms, jiff::Timestamp::now().to_string(), &g);
+                            samples.push((&sample).into());
+                            if let Some(reason) = record_active_temperature_sample(
+                                side, g.left_temp, g.right_temp, g.heatsink_temp, we_enabled_side,
+                                target_centideg, active_start, &mut active_left_c, &mut active_right_c,
+                                &mut prev_side_centideg, &mut min_left_c, &mut min_right_c, &mut max_heatsink_c,
+                                &mut final_left_c, &mut final_right_c, &mut final_heatsink_c,
+                                &mut target_reached, &mut target_reached_at, &mut time_to_target_seconds,
+                            ) {
+                                stop_reason = reason;
+                                if !matches!(reason, StopReason::TargetTemperatureReached) {
+                                    telemetry_ok = false;
+                                }
+                                break 'active;
+                            }
+                        }
+                    }
+                    crate::frozen_compat::HEARTBEAT_OPCODE
+                        if frame.payload.len() == crate::frozen_compat::HEARTBEAT_OBSERVED_COMPAT_SIZE =>
+                    {
+                        compat_heartbeat_9byte_frames += 1;
+                    }
+                    0x54 => compat_opcode_0x54_frames += 1,
+                    0x55 => compat_opcode_0x55_frames += 1,
+                    _ => {}
+                }
+            }
+        }
+
+        if active_start.elapsed() >= PUMP_CONFIRM_GRACE && !pump_confirmed_running && pump_last_report_off {
+            log::error!(
+                "selected-side pump still reports off/0V {:?} after the target was enabled",
+                active_start.elapsed()
+            );
+            stop_reason = StopReason::PumpNotConfirmedRunning;
+            telemetry_ok = false;
+            break 'active;
+        }
+
+        if last_any_valid_rx_at.elapsed() > ANY_VALID_RX_LIMIT {
+            log::error!(
+                "no valid packet of any kind for {:?} (limit {:?}) -- communication watchdog. \
+                 Last selected-side pump telemetry: {:?} ago. Last selected-side TEC telemetry: {:?} ago.",
+                last_any_valid_rx_at.elapsed(), ANY_VALID_RX_LIMIT,
+                last_selected_pump_telemetry_at.map(|at| at.elapsed()),
+                last_selected_tec_telemetry_at.map(|at| at.elapsed()),
+            );
+            stop_reason = StopReason::CommunicationWatchdogExpired;
+            telemetry_ok = false;
+            break 'active;
+        }
+
+        match last_temperature_sample_at {
+            None if active_start.elapsed() > ACTIVE_STARTUP_GRACE => {
+                log::error!(
+                    "no temperature sample within {:?} of enabling (limit {:?}) -- startup grace expired",
+                    active_start.elapsed(), ACTIVE_STARTUP_GRACE
+                );
+                stop_reason = StopReason::TemperatureStartupGraceExpired;
+                telemetry_ok = false;
+                break 'active;
+            }
+            Some(at) if at.elapsed() > TEMPERATURE_FRESHNESS_LIMIT => {
+                log::error!(
+                    "no fresh temperature sample for {:?} (limit {:?}) -- temperature watchdog",
+                    at.elapsed(), TEMPERATURE_FRESHNESS_LIMIT
+                );
+                stop_reason = StopReason::TemperatureWatchdogExpired;
+                telemetry_ok = false;
+                break 'active;
+            }
+            _ => {}
+        }
+    }
+
+    cr.telemetry_remained_valid = if telemetry_ok && !samples.is_empty() { Verdict::Pass } else { Verdict::Fail };
+
+    let side_bracket_tag = format!("[{side_tag}]");
+    tec_activity_seen = tec_activity_seen
+        || stats.messages.iter().any(|m| m.to_lowercase().contains("tec") && m.contains(&side_bracket_tag));
+    // Fan telemetry is global Hub thermal management, never side-scoped -- see parse_fan_report's
+    // doc comment. "seen" here means either fan produced any telemetry at all, not the selected
+    // side specifically (there is no such thing for a fan).
+    let fan_seen = stats.messages.iter().any(|m| parse_fan_report(m, "top-fan").is_some() || parse_fan_report(m, "bottom-fan").is_some());
+
+    let shutdown = run_cool_test_shutdown(Some(link), &mut audit, i2c, stop_reason, side).await;
+    cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+
+    // Pump/fan/TEC results: only ever PASS from decoded evidence, never from "the command was
+    // accepted" (`cr.frozen_command_accepted` is tracked entirely separately above).
+    cr.pump_operation = if pump_confirmed_running {
+        Verdict::Pass
+    } else if pump_last_report_off {
+        Verdict::Fail
+    } else {
+        Verdict::Unverified
+    };
+    cr.fan_operation = if fan_seen { Verdict::Pass } else { Verdict::Unverified };
+    cr.tec_cooling_operation = tec_trend_verdict(side, &active_left_c, &active_right_c, telemetry_ok);
+    cr.overall_selected_side_result = overall_verdict(&cr);
+    let overall_pass = cr.overall_selected_side_result == Verdict::Pass;
+
+    ct.minimum_left_c = min_left_c;
+    ct.minimum_right_c = min_right_c;
+    ct.maximum_heatsink_c = max_heatsink_c;
+    ct.final_left_c = final_left_c;
+    ct.final_right_c = final_right_c;
+    ct.final_heatsink_c = final_heatsink_c;
+    ct.selected_side_temperature_change_c = match side {
+        BedSide::Left => final_left_c.zip(ct.baseline_left_c).map(|(f, b)| f - b),
+        BedSide::Right => final_right_c.zip(ct.baseline_right_c).map(|(f, b)| f - b),
+    };
+    ct.opposite_side_temperature_change_c = match side {
+        BedSide::Left => final_right_c.zip(ct.baseline_right_c).map(|(f, b)| f - b),
+        BedSide::Right => final_left_c.zip(ct.baseline_left_c).map(|(f, b)| f - b),
+    };
+    ct.heatsink_temperature_change_c = final_heatsink_c.zip(ct.baseline_heatsink_c).map(|(f, b)| f - b);
+    ct.target_reached = target_reached;
+    ct.time_to_target_seconds = time_to_target_seconds;
+    ct.selected_tec_activity_observed = tec_activity_seen;
+    ct.selected_tec_safety_passed = selected_tec_safety_passed;
+    ct.left_pump_activity_observed = left_pump_activity_observed;
+    ct.right_pump_activity_observed = right_pump_activity_observed;
+    ct.selected_pump_activity_observed = match side {
+        BedSide::Left => left_pump_activity_observed,
+        BedSide::Right => right_pump_activity_observed,
+    };
+    ct.selected_tec_current_first_a = tec_current_first_a;
+    ct.selected_tec_current_min_a = tec_current_min_a;
+    ct.selected_tec_current_max_a = tec_current_max_a;
+    ct.selected_tec_current_last_a = tec_current_last_a;
+    ct.selected_tec_current_samples = tec_current_samples;
+    ct.telemetry_watchdog_triggered = matches!(
+        stop_reason,
+        StopReason::TelemetryStale | StopReason::TemperatureWatchdogExpired | StopReason::TemperatureStartupGraceExpired
+    );
+    ct.communication_loss_observed = matches!(
+        stop_reason,
+        StopReason::UartReadFailure
+            | StopReason::UartWriteFailure
+            | StopReason::TelemetryLost
+            | StopReason::CommunicationWatchdogExpired
+    );
+    ct.operator_abort_observed = stop_reason == StopReason::OperatorAbort;
+    ct.both_targets_shutdown_confirmed = shutdown.both_confirmed_disabled;
+    ct.selected_pump_shutdown_observed = shutdown.selected_pump_shutdown_observed;
+    ct.selected_tec_shutdown_observed = shutdown.selected_tec_shutdown_observed;
+    ct.shutdown_verified = shutdown.verified();
+    ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+    ct.actual_active_duration_seconds = active_start.elapsed().as_secs_f64();
+    ct.stop_reason = stop_reason.to_string();
+    ct.stop_reason_code = stop_reason_code(stop_reason).to_string();
+    ct.selected_tec_unlocking_observed = selected_tec_unlocking_observed;
+    // Overwrites the baseline-only snapshot taken right after baseline collection (see above) now
+    // that the active phase may have added to the same counters -- see
+    // frozen_compat.rs/record_active_temperature_sample's doc comments.
+    ct.compat_get_temperature_14byte_frames = compat_get_temperature_14byte_frames;
+    ct.compat_heartbeat_9byte_frames = compat_heartbeat_9byte_frames;
+    ct.compat_opcode_0x54_frames = compat_opcode_0x54_frames;
+    ct.compat_opcode_0x55_frames = compat_opcode_0x55_frames;
+
+    // stop_reason here is never PreflightRefused (every such path above already returned its own
+    // exit code directly): a normal active-test outcome is 0 on PASS, 21 if shutdown itself could
+    // not be verified, else 1.
+    let exit_code = if overall_pass {
+        0
+    } else if !shutdown.verified() {
+        21
+    } else {
+        1
+    };
+    finish(
+        args, dry_run, &audit, &stats, samples, cr, ct, stop_reason, overall_pass, exit_code,
+        expander_value, &led, true, true,
+    )
+}
+
+/// The `--firmware-authoritative` active phase: item 2's sequence from "send exactly one enable
+/// target" onward. See `cli::CoolTestArgs::firmware_authoritative`'s doc comment and this module's
+/// top-level docs for the full rationale -- in short, once the target is confirmed enabled, Frozen
+/// firmware owns pump sequencing, TEC ramping, PID control, solenoid control, fan control, current
+/// safety, thermal regulation, and target maintenance; this function observes and logs, and only
+/// ever initiates a controlled shutdown for one of the small, closed set of reasons in
+/// `is_fa_legitimate_stop_reason`'s doc comment (duration expiry, operator abort, a signal, an
+/// explicit TEC safety lock, an explicit recognized firmware safety-fault message, the enabled
+/// target being explicitly lost, a fatal UART error, an internal error, or a very long
+/// communication silence) -- never from its own inference about incomplete, delayed, reordered, or
+/// temporarily stale pump/TEC/temperature telemetry.
+#[allow(clippy::too_many_arguments)]
+async fn run_firmware_authoritative_phase<T, P>(
+    args: &CoolTestArgs,
+    i2c: &mut P,
+    link: &mut FrozenLink<T>,
+    audit: &mut AuditedTransport,
+    stats: &mut PacketStats,
+    samples: &mut Vec<TemperatureSampleJson>,
+    side: BedSide,
+    side_tag: &'static str,
+    target_centideg: u16,
+    send_result: Result<PacketOutcome, LinkError>,
+    operator_abort_rx: &mut Option<mpsc::UnboundedReceiver<String>>,
+    capture: &Option<RawIoCapture>,
+    compat_scanner: &mut CompatFrameScanner,
+    raw_scan_checkpoint: &mut usize,
+    compat_get_temperature_14byte_frames: &mut u64,
+    compat_heartbeat_9byte_frames: &mut u64,
+    compat_opcode_0x54_frames: &mut u64,
+    compat_opcode_0x55_frames: &mut u64,
+    mut cr: ComponentResults,
+    mut ct: CoolTestResults,
+    dry_run: bool,
+    expander_value: u8,
+    led: &crate::i2c::ProbeResult,
+    spawn_guard: bool,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    eprintln!(
+        "--firmware-authoritative: Frozen firmware now owns pump sequencing, TEC ramping, PID \
+         control, solenoid control, fan control, current safety, thermal regulation, and target \
+         maintenance. This binary observes and enforces only the requested duration and a small, \
+         closed set of explicit safety/communication conditions."
+    );
+    if send_result.is_ok() {
+        eprintln!(
+            "If you observe a leak, a burning smell, or abnormal noise, type ABORT and press Enter \
+             (or press Ctrl+C) to stop immediately."
+        );
+    }
+
+    let active_start = Instant::now();
+    let duration = Duration::from_secs(args.duration_seconds.min(HARD_MAX_DURATION_SECONDS));
+
+    let mut stop_reason = StopReason::Normal;
+    let mut telemetry_ok = true;
+
+    // Item 2 steps 6-8, and item 3: confirm the *specific* enabled TargetUpdate for our side, not
+    // merely "some reply arrived" -- the legacy loop's `send_result.is_ok()` shortcut is exactly
+    // the gap that let already-buffered pre-enable telemetry look like proof of enablement in the
+    // live-hardware incident this mode was added to fix. Anything else observed while waiting here
+    // is pre-enable telemetry: recorded into `stats`/`samples` for the raw report, never actioned
+    // as active-phase pump/TEC/fan/target state -- `active_generation`/`target_enabled_at` only
+    // begin once the real confirmation is seen.
+    let mut target_enabled_at: Option<Instant> = None;
+    let mut active_generation: u64 = 0;
+    // The original enable send's own single-packet reply may already *be* the enabling
+    // TargetUpdate -- the normal case, when no stray pre-enable telemetry happened to be queued
+    // ahead of it in the transport. Check that first; only fall through to draining further
+    // packets below if it wasn't (i.e. that one reply was itself pre-enable telemetry).
+    match &send_result {
+        Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((s, t)))) if *s == side && t.enabled => {
+            active_generation += 1;
+            target_enabled_at = Some(Instant::now());
+        }
+        Ok(PacketOutcome::Received(pkt)) => {
+            log::info!("firmware-authoritative: pre-enable telemetry (recorded, not actioned): {pkt:?}");
+            stats.record(pkt);
+        }
+        _ => {}
+    }
+    if target_enabled_at.is_none() && send_result.is_ok() {
+        let confirm_deadline = Instant::now() + COMMAND_TIMEOUT;
+        'confirm: loop {
+            let remaining = confirm_deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            match link.recv(remaining).await {
+                Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((s, t)))) if s == side && t.enabled => {
+                    stats.record(&FrozenPacket::TargetUpdate((s, t)));
+                    active_generation += 1;
+                    target_enabled_at = Some(Instant::now());
+                    break 'confirm;
+                }
+                Ok(PacketOutcome::Received(pkt)) => {
+                    log::info!("firmware-authoritative: pre-enable telemetry (recorded, not actioned): {pkt:?}");
+                    stats.record(&pkt);
+                }
+                Ok(PacketOutcome::TimedOut) => break,
+                Ok(PacketOutcome::Closed) => {
+                    stop_reason = StopReason::FatalUartError;
+                    telemetry_ok = false;
+                    break;
+                }
+                Err(e) => {
+                    log::error!("firmware-authoritative: UART error while confirming enable: {e}");
+                    stop_reason = StopReason::FatalUartError;
+                    telemetry_ok = false;
+                    break;
+                }
+            }
+        }
+    }
+    let we_enabled_side = target_enabled_at.is_some();
+    ct.target_enabled_at = target_enabled_at.map(|t| t.saturating_duration_since(active_start).as_secs_f64());
+
+    if !we_enabled_side && stop_reason == StopReason::Normal {
+        log::error!("firmware-authoritative: the selected side's enabled TargetUpdate was never confirmed");
+        stop_reason = StopReason::EnabledTargetStateLost;
+        telemetry_ok = false;
+    }
+
+    let mut active_left_c: Vec<f64> = Vec::new();
+    let mut active_right_c: Vec<f64> = Vec::new();
+    let mut min_left_c: Option<f64> = None;
+    let mut min_right_c: Option<f64> = None;
+    let mut final_left_c: Option<f64> = None;
+    let mut final_right_c: Option<f64> = None;
+    let mut final_heatsink_c: Option<f64> = None;
+    let mut max_heatsink_c: Option<f64> = None;
+    let mut target_reached_observed = false;
+    let mut pump_command_observed = false;
+    let mut pump_current_observed = false;
+    let mut tec_current_observed = false;
+    let mut tec_activity_seen = false;
+    let mut explicit_firmware_safety_passed = false;
+    let mut selected_tec_unlocking_observed = false;
+    // Never currently set `true`: item 1 removed the only trigger (the generic fault-keyword
+    // scan) from this mode entirely. Kept as a named, reported field -- not `mut` right now -- so
+    // a future specifically-parsed, evidenced negative firmware state has somewhere to report
+    // itself without inventing a new field at that point.
+    let explicit_firmware_fault_observed = false;
+    let mut temperature_reads_failed: Option<u64> = None;
+    let mut temperature_reads_total: Option<u64> = None;
+    let mut top_fan_activity_observed = false;
+    let mut top_fan_latest_duty: Option<f64> = None;
+    let mut top_fan_latest_rpm: Option<f64> = None;
+    let mut top_fan_max_rpm: Option<f64> = None;
+    let mut bottom_fan_activity_observed = false;
+    let mut bottom_fan_latest_duty: Option<f64> = None;
+    let mut bottom_fan_latest_rpm: Option<f64> = None;
+    let mut bottom_fan_max_rpm: Option<f64> = None;
+    let mut tec_current_first_a: Option<f64> = None;
+    let mut tec_current_min_a: Option<f64> = None;
+    let mut tec_current_max_a: Option<f64> = None;
+    let mut tec_current_last_a: Option<f64> = None;
+    let mut tec_current_samples: u64 = 0;
+    let mut left_pump_activity_observed = false;
+    let mut right_pump_activity_observed = false;
+    let mut telemetry_warning_count: u64 = 0;
+    let mut fan_seen = false;
+    let mut guard_handle: Option<crate::guard::GuardHandle> = None;
+
+    if we_enabled_side {
+        log::info!(
+            "firmware-authoritative: selected side confirmed enabled (generation {active_generation}); \
+             entering observation"
+        );
+
+        // Item 9: an independent shutdown guard, armed only for a real run (never --dry-run, and
+        // only now that the target is confirmed enabled) -- see guard.rs module docs.
+        if spawn_guard {
+            let arm_seconds = duration.as_secs_f64() + FA_GUARD_GRACE.as_secs_f64();
+            match crate::guard::spawn(&args.frozen_port, &args.i2c_device, side, arm_seconds) {
+                Ok(h) => {
+                    log::info!("firmware-authoritative: independent shutdown guard armed for {arm_seconds:.0}s");
+                    ct.independent_guard_armed = true;
+                    guard_handle = Some(h);
+                }
+                Err(e) => log::error!("firmware-authoritative: failed to spawn independent shutdown guard: {e}"),
+            }
+        } else {
+            log::info!("firmware-authoritative: independent shutdown guard not spawned (--dry-run or disabled)");
+        }
+
+        let mut last_any_valid_rx_at = Instant::now();
+        let mut last_temperature_poll_at: Option<Instant> = None;
+
+        'fa_active: loop {
+            if active_start.elapsed() >= duration {
+                stop_reason = StopReason::DurationExpired;
+                break;
+            }
+
+            // Item 6: observation only -- poll no faster than FA_TEMPERATURE_POLL_INTERVAL.
+            let should_poll = last_temperature_poll_at.is_none_or(|at| at.elapsed() >= FA_TEMPERATURE_POLL_INTERVAL);
+            if should_poll {
+                if let Err(e) = link.send_only(audit, FrozenAction::get_temperatures()).await {
+                    log::error!("firmware-authoritative: UART write failure: {e}");
+                    stop_reason = StopReason::FatalUartError;
+                    telemetry_ok = false;
+                    break 'fa_active;
+                }
+                last_temperature_poll_at = Some(Instant::now());
+            }
+
+            let drain_deadline = Instant::now() + TICK_DRAIN_WINDOW;
+            loop {
+                let remaining = drain_deadline.saturating_duration_since(Instant::now());
+                if remaining.is_zero() {
+                    break;
+                }
+                tokio::select! {
+                    biased;
+                    reason = wait_for_termination_signal() => {
+                        stop_reason = reason;
+                        break 'fa_active;
+                    }
+                    maybe_line = async {
+                        match operator_abort_rx.as_mut() {
+                            Some(rx) => rx.recv().await,
+                            None => std::future::pending().await,
+                        }
+                    } => {
+                        match maybe_line {
+                            Some(line) if is_operator_abort_line(&line) => {
+                                log::error!("operator-reported abort: {line:?}");
+                                stop_reason = StopReason::OperatorAbort;
+                                telemetry_ok = false;
+                                break 'fa_active;
+                            }
+                            Some(line) => {
+                                log::info!("ignoring unrecognized operator input during active phase: {line:?}");
+                            }
+                            None => {
+                                *operator_abort_rx = None;
+                            }
+                        }
+                    }
+                    outcome = link.recv(remaining) => {
+                        match outcome {
+                            Ok(PacketOutcome::Received(pkt)) => {
+                                last_any_valid_rx_at = Instant::now();
+                                match pkt {
+                                    FrozenPacket::TemperatureUpdate(u) => {
+                                        stats.record(&FrozenPacket::TemperatureUpdate(u.clone()));
+                                        let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                        samples.push((&sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u)).into());
+                                        record_fa_temperature_sample(
+                                            side, u.left_temp, u.right_temp, u.heatsink_temp, target_centideg,
+                                            &mut active_left_c, &mut active_right_c, &mut min_left_c, &mut min_right_c,
+                                            &mut max_heatsink_c, &mut final_left_c, &mut final_right_c,
+                                            &mut final_heatsink_c, &mut target_reached_observed,
+                                        );
+                                    }
+                                    FrozenPacket::GetTemperature(g) => {
+                                        stats.record(&FrozenPacket::GetTemperature(g.clone()));
+                                        let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                        samples.push((&sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g)).into());
+                                        record_fa_temperature_sample(
+                                            side, g.left_temp, g.right_temp, g.heatsink_temp, target_centideg,
+                                            &mut active_left_c, &mut active_right_c, &mut min_left_c, &mut min_right_c,
+                                            &mut max_heatsink_c, &mut final_left_c, &mut final_right_c,
+                                            &mut final_heatsink_c, &mut target_reached_observed,
+                                        );
+                                    }
+                                    FrozenPacket::Message(m) => {
+                                        stats.record(&FrozenPacket::Message(m.clone()));
+                                        if parse_pump_report(&m, side_tag).is_some() || is_pump_command_event(&m, side_tag) {
+                                            pump_command_observed = true;
+                                        }
+                                        if parse_pump_report(&m, "left") == Some(true) {
+                                            left_pump_activity_observed = true;
+                                        }
+                                        if parse_pump_report(&m, "right") == Some(true) {
+                                            right_pump_activity_observed = true;
+                                        }
+                                        if parse_pump_current(&m, side_tag).is_some() {
+                                            pump_current_observed = true;
+                                        }
+                                        if let Some(amps) = parse_tec_current(&m, side_tag) {
+                                            tec_current_samples += 1;
+                                            tec_current_first_a.get_or_insert(amps);
+                                            tec_current_min_a = Some(tec_current_min_a.map_or(amps, |v: f64| v.min(amps)));
+                                            tec_current_max_a = Some(tec_current_max_a.map_or(amps, |v: f64| v.max(amps)));
+                                            tec_current_last_a = Some(amps);
+                                            tec_current_observed = true;
+                                            tec_activity_seen = true;
+                                        } else if let Some(state) = parse_tec_safety_state(&m, side_tag) {
+                                            match state {
+                                                TecSafetyState::Locked => {
+                                                    log::error!("firmware-authoritative: firmware reported the selected TEC locked: {m:?}");
+                                                    stop_reason = StopReason::TecLocked;
+                                                    telemetry_ok = false;
+                                                    break 'fa_active;
+                                                }
+                                                TecSafetyState::UnsafeLocking => {
+                                                    log::error!(
+                                                        "firmware-authoritative: firmware reported the selected TEC transitioning unsafe (locking): {m:?}"
+                                                    );
+                                                    stop_reason = StopReason::TecUnsafeLocking;
+                                                    telemetry_ok = false;
+                                                    break 'fa_active;
+                                                }
+                                                TecSafetyState::SafeUnlocking => {
+                                                    explicit_firmware_safety_passed = true;
+                                                    selected_tec_unlocking_observed = true;
+                                                    tec_activity_seen = true;
+                                                }
+                                                TecSafetyState::Unlocked => {
+                                                    explicit_firmware_safety_passed = true;
+                                                    tec_activity_seen = true;
+                                                }
+                                                TecSafetyState::Unknown => {
+                                                    log::info!(
+                                                        "firmware-authoritative: unrecognized TEC safety-state message (not treated as a fault): {m:?}"
+                                                    );
+                                                }
+                                            }
+                                        }
+                                        if let Some((failed, total)) = parse_temps_health_report(&m) {
+                                            temperature_reads_failed = Some(failed);
+                                            temperature_reads_total = Some(total);
+                                        }
+                                        if let Some((duty, rpm)) = parse_fan_report(&m, "top-fan") {
+                                            top_fan_activity_observed = true;
+                                            top_fan_latest_duty = Some(duty);
+                                            top_fan_latest_rpm = Some(rpm);
+                                            top_fan_max_rpm = Some(top_fan_max_rpm.map_or(rpm, |v: f64| v.max(rpm)));
+                                        }
+                                        if let Some((duty, rpm)) = parse_fan_report(&m, "bottom-fan") {
+                                            bottom_fan_activity_observed = true;
+                                            bottom_fan_latest_duty = Some(duty);
+                                            bottom_fan_latest_rpm = Some(rpm);
+                                            bottom_fan_max_rpm = Some(bottom_fan_max_rpm.map_or(rpm, |v: f64| v.max(rpm)));
+                                        }
+                                        // Item 1: no generic fault-keyword scan in this mode at all --
+                                        // an automatic firmware-fault shutdown requires a specifically
+                                        // parsed, recognized negative state (TEC lock states above are
+                                        // the only ones currently evidenced). Every other firmware
+                                        // Message, however it's worded, is observational and
+                                        // nonterminal here -- see is_generic_fault_message's own doc
+                                        // comment for the live-hardware incident this fixed
+                                        // ("[temps] 0 reads failed out of 1200" misclassified as a
+                                        // fault by a plain contains("failed") check).
+                                        if is_known_nonfatal_sensor_message(&m) {
+                                            log::warn!("firmware-authoritative: firmware sensor-unavailable message (non-fatal): {m:?}");
+                                            telemetry_warning_count += 1;
+                                        }
+                                    }
+                                    FrozenPacket::TargetUpdate((s, target)) => {
+                                        stats.record(&FrozenPacket::TargetUpdate((s, target.clone())));
+                                        if s == side && !target.enabled {
+                                            log::error!("firmware-authoritative: Frozen reported the selected side's enabled target lost");
+                                            stop_reason = StopReason::EnabledTargetStateLost;
+                                            telemetry_ok = false;
+                                            break 'fa_active;
+                                        }
+                                    }
+                                    other => {
+                                        stats.record(&other);
+                                    }
+                                }
+                            }
+                            Ok(PacketOutcome::TimedOut) => break,
+                            Ok(PacketOutcome::Closed) => {
+                                stop_reason = StopReason::FatalUartError;
+                                telemetry_ok = false;
+                                break 'fa_active;
+                            }
+                            Err(e) => {
+                                log::error!("firmware-authoritative: UART error during observation: {e}");
+                                stop_reason = StopReason::FatalUartError;
+                                telemetry_ok = false;
+                                break 'fa_active;
+                            }
+                        }
+                    }
+                }
+            }
+
+            // Same raw-capture-based 14-byte GetTemperature recovery as the legacy loop -- see
+            // record_active_temperature_sample's doc comment for why a synchronous reply must not
+            // be "raw evidence only". No watchdog updates here: this mode deliberately has none of
+            // those (see FA_COMMUNICATION_SILENCE_LIMIT's doc comment for the one exception).
+            if let Some(capture) = capture {
+                let new_events = crate::io_logging::events_since(capture, raw_scan_checkpoint);
+                for event in new_events.iter().filter(|e| e.direction == "rx") {
+                    if let Some(bytes) = crate::io_logging::hex_to_bytes(&event.hex) {
+                        compat_scanner.feed(&bytes);
+                    }
+                }
+                for frame in compat_scanner.drain_frames() {
+                    match frame.opcode {
+                        crate::frozen_compat::GET_TEMPERATURE_OPCODE => {
+                            if let Some(g) = crate::frozen_compat::decode_get_temperature_14byte(&frame.payload) {
+                                *compat_get_temperature_14byte_frames += 1;
+                                last_any_valid_rx_at = Instant::now();
+                                let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                let sample = sample_from_get_temperature_compat14(elapsed_ms, jiff::Timestamp::now().to_string(), &g);
+                                samples.push((&sample).into());
+                                record_fa_temperature_sample(
+                                    side, g.left_temp, g.right_temp, g.heatsink_temp, target_centideg,
+                                    &mut active_left_c, &mut active_right_c, &mut min_left_c, &mut min_right_c,
+                                    &mut max_heatsink_c, &mut final_left_c, &mut final_right_c, &mut final_heatsink_c,
+                                    &mut target_reached_observed,
+                                );
+                            }
+                        }
+                        crate::frozen_compat::HEARTBEAT_OPCODE
+                            if frame.payload.len() == crate::frozen_compat::HEARTBEAT_OBSERVED_COMPAT_SIZE =>
+                        {
+                            *compat_heartbeat_9byte_frames += 1;
+                        }
+                        0x54 => *compat_opcode_0x54_frames += 1,
+                        0x55 => *compat_opcode_0x55_frames += 1,
+                        _ => {}
+                    }
+                }
+            }
+
+            // Item 5's own, much longer, separate silence threshold -- never the legacy 2s/5s
+            // heuristic.
+            if last_any_valid_rx_at.elapsed() > FA_COMMUNICATION_SILENCE_LIMIT {
+                log::error!(
+                    "firmware-authoritative: no valid packet of any kind for {:?} (limit {:?}) -- \
+                     attempting a controlled both-side disable",
+                    last_any_valid_rx_at.elapsed(), FA_COMMUNICATION_SILENCE_LIMIT
+                );
+                stop_reason = StopReason::CommunicationSilenceExceeded;
+                telemetry_ok = false;
+                break 'fa_active;
+            }
+        }
+
+        let side_bracket_tag = format!("[{side_tag}]");
+        // Fan telemetry is global Hub thermal management, never side-scoped -- see
+        // parse_fan_report's doc comment. "seen" means either fan produced any telemetry at all.
+        fan_seen = top_fan_activity_observed || bottom_fan_activity_observed;
+        tec_activity_seen = tec_activity_seen
+            || stats.messages.iter().any(|m| m.to_lowercase().contains("tec") && m.contains(&side_bracket_tag));
+        if !tec_current_observed {
+            log::warn!("firmware-authoritative: no TEC-current telemetry observed for the selected side (not treated as a fault)");
+            telemetry_warning_count += 1;
+        }
+        if !fan_seen {
+            log::warn!("firmware-authoritative: no global fan telemetry observed (not treated as a fault)");
+            telemetry_warning_count += 1;
+        }
+        if !pump_command_observed {
+            log::warn!("firmware-authoritative: no pump command message observed for the selected side (not treated as a fault)");
+            telemetry_warning_count += 1;
+        }
+    }
+
+    cr.telemetry_remained_valid = if telemetry_ok && !samples.is_empty() { Verdict::Pass } else { Verdict::Fail };
+
+    let shutdown = run_cool_test_shutdown(Some(link), audit, i2c, stop_reason, side).await;
+    cr.emergency_shutdown = if shutdown.verified() { Verdict::Pass } else { Verdict::Fail };
+
+    if let Some(mut handle) = guard_handle {
+        if shutdown.verified() {
+            ct.independent_guard_disarmed = handle.disarm();
+            if ct.independent_guard_disarmed {
+                log::info!("firmware-authoritative: independent shutdown guard disarmed");
+            } else {
+                log::error!(
+                    "firmware-authoritative: failed to disarm the independent shutdown guard -- it \
+                     remains armed and will fire on its own if not otherwise stopped"
+                );
+            }
+        } else {
+            log::error!(
+                "firmware-authoritative: shutdown could not be verified -- the independent shutdown \
+                 guard is intentionally left armed as a last-resort fallback"
+            );
+        }
+    }
+
+    cr.pump_operation = if pump_command_observed || left_pump_activity_observed || right_pump_activity_observed {
+        Verdict::Pass
+    } else {
+        Verdict::Unverified
+    };
+    cr.fan_operation = if fan_seen { Verdict::Pass } else { Verdict::Unverified };
+    cr.tec_cooling_operation = tec_trend_verdict(side, &active_left_c, &active_right_c, telemetry_ok);
+    cr.overall_selected_side_result = overall_verdict(&cr);
+    let overall_pass = cr.overall_selected_side_result == Verdict::Pass;
+
+    ct.minimum_left_c = min_left_c;
+    ct.minimum_right_c = min_right_c;
+    ct.maximum_heatsink_c = max_heatsink_c;
+    ct.final_left_c = final_left_c;
+    ct.final_right_c = final_right_c;
+    ct.final_heatsink_c = final_heatsink_c;
+    ct.selected_side_temperature_change_c = match side {
+        BedSide::Left => final_left_c.zip(ct.baseline_left_c).map(|(f, b)| f - b),
+        BedSide::Right => final_right_c.zip(ct.baseline_right_c).map(|(f, b)| f - b),
+    };
+    ct.opposite_side_temperature_change_c = match side {
+        BedSide::Left => final_right_c.zip(ct.baseline_right_c).map(|(f, b)| f - b),
+        BedSide::Right => final_left_c.zip(ct.baseline_left_c).map(|(f, b)| f - b),
+    };
+    ct.heatsink_temperature_change_c = final_heatsink_c.zip(ct.baseline_heatsink_c).map(|(f, b)| f - b);
+    ct.target_reached = target_reached_observed;
+    ct.target_reached_observed = target_reached_observed;
+    ct.selected_temperature_min_c = match side {
+        BedSide::Left => min_left_c,
+        BedSide::Right => min_right_c,
+    };
+    ct.selected_temperature_final_c = match side {
+        BedSide::Left => final_left_c,
+        BedSide::Right => final_right_c,
+    };
+    ct.opposite_temperature_min_c = match side {
+        BedSide::Left => min_right_c,
+        BedSide::Right => min_left_c,
+    };
+    ct.heatsink_temperature_max_c = max_heatsink_c;
+    ct.selected_tec_activity_observed = tec_activity_seen;
+    ct.selected_tec_safety_passed = explicit_firmware_safety_passed;
+    ct.explicit_firmware_safety_passed = explicit_firmware_safety_passed;
+    ct.selected_tec_unlocking_observed = selected_tec_unlocking_observed;
+    ct.left_pump_activity_observed = left_pump_activity_observed;
+    ct.right_pump_activity_observed = right_pump_activity_observed;
+    ct.selected_pump_activity_observed = match side {
+        BedSide::Left => left_pump_activity_observed,
+        BedSide::Right => right_pump_activity_observed,
+    };
+    ct.pump_command_observed = pump_command_observed;
+    ct.pump_current_observed = pump_current_observed;
+    ct.tec_current_observed = tec_current_observed;
+    ct.selected_tec_current_first_a = tec_current_first_a;
+    ct.selected_tec_current_min_a = tec_current_min_a;
+    ct.selected_tec_current_max_a = tec_current_max_a;
+    ct.selected_tec_current_last_a = tec_current_last_a;
+    ct.selected_tec_current_samples = tec_current_samples;
+    ct.explicit_firmware_fault_observed = explicit_firmware_fault_observed;
+    ct.temperature_reads_failed = temperature_reads_failed;
+    ct.temperature_reads_total = temperature_reads_total;
+    ct.temperature_read_failure_ratio = match (temperature_reads_failed, temperature_reads_total) {
+        (Some(failed), Some(total)) if total > 0 => Some(failed as f64 / total as f64),
+        _ => None,
+    };
+    ct.top_fan_activity_observed = top_fan_activity_observed;
+    ct.top_fan_latest_duty = top_fan_latest_duty;
+    ct.top_fan_latest_rpm = top_fan_latest_rpm;
+    ct.top_fan_max_rpm = top_fan_max_rpm;
+    ct.bottom_fan_activity_observed = bottom_fan_activity_observed;
+    ct.bottom_fan_latest_duty = bottom_fan_latest_duty;
+    ct.bottom_fan_latest_rpm = bottom_fan_latest_rpm;
+    ct.bottom_fan_max_rpm = bottom_fan_max_rpm;
+    ct.telemetry_warning_count = telemetry_warning_count;
+    // This mode has no watchdog-style stop condition at all -- see FA_COMMUNICATION_SILENCE_LIMIT.
+    ct.telemetry_watchdog_triggered = false;
+    ct.communication_loss_observed = matches!(stop_reason, StopReason::FatalUartError | StopReason::CommunicationSilenceExceeded);
+    ct.operator_abort_observed = stop_reason == StopReason::OperatorAbort;
+    ct.both_targets_shutdown_confirmed = shutdown.both_confirmed_disabled;
+    ct.selected_pump_shutdown_observed = shutdown.selected_pump_shutdown_observed;
+    ct.selected_tec_shutdown_observed = shutdown.selected_tec_shutdown_observed;
+    ct.shutdown_verified = shutdown.verified();
+    ct.emergency_reset_asserted = shutdown.emergency_reset_asserted;
+    ct.actual_active_duration_seconds = active_start.elapsed().as_secs_f64();
+    ct.stop_reason = stop_reason.to_string();
+    ct.stop_reason_code = stop_reason_code(stop_reason).to_string();
+    ct.compat_get_temperature_14byte_frames = *compat_get_temperature_14byte_frames;
+    ct.compat_heartbeat_9byte_frames = *compat_heartbeat_9byte_frames;
+    ct.compat_opcode_0x54_frames = *compat_opcode_0x54_frames;
+    ct.compat_opcode_0x55_frames = *compat_opcode_0x55_frames;
+
+    let exit_code = if overall_pass {
+        0
+    } else if !shutdown.verified() {
+        21
+    } else {
+        1
+    };
+    finish(
+        args, dry_run, &*audit, &*stats, std::mem::take(samples), cr, ct, stop_reason, overall_pass, exit_code,
+        expander_value, led, true, true,
+    )
+}
+
+/// One tick's worth of temperature bookkeeping for `--firmware-authoritative` mode: unlike
+/// `record_active_temperature_sample`, this never returns a `StopReason` -- this mode does not use
+/// a host-side plausibility/range/heatsink ceiling check at all (Frozen owns thermal regulation
+/// and current safety once the target is enabled -- see module docs), and never stops merely
+/// because the target was reached (only observes and logs it once, the first time).
+#[allow(clippy::too_many_arguments)]
+fn record_fa_temperature_sample(
+    side: BedSide,
+    left_temp: u16,
+    right_temp: u16,
+    heatsink_temp: u16,
+    target_centideg: u16,
+    active_left_c: &mut Vec<f64>,
+    active_right_c: &mut Vec<f64>,
+    min_left_c: &mut Option<f64>,
+    min_right_c: &mut Option<f64>,
+    max_heatsink_c: &mut Option<f64>,
+    final_left_c: &mut Option<f64>,
+    final_right_c: &mut Option<f64>,
+    final_heatsink_c: &mut Option<f64>,
+    target_reached_observed: &mut bool,
+) {
+    let left_c = crate::telemetry::centideg_to_celsius(left_temp);
+    let right_c = crate::telemetry::centideg_to_celsius(right_temp);
+    let heatsink_c = crate::telemetry::centideg_to_celsius(heatsink_temp);
+    active_left_c.push(left_c);
+    active_right_c.push(right_c);
+    *min_left_c = Some(min_left_c.map_or(left_c, |m: f64| m.min(left_c)));
+    *min_right_c = Some(min_right_c.map_or(right_c, |m: f64| m.min(right_c)));
+    *max_heatsink_c = Some(max_heatsink_c.map_or(heatsink_c, |m: f64| m.max(heatsink_c)));
+    *final_left_c = Some(left_c);
+    *final_right_c = Some(right_c);
+    *final_heatsink_c = Some(heatsink_c);
+
+    let side_centideg = match side {
+        BedSide::Left => left_temp,
+        BedSide::Right => right_temp,
+    } as i32;
+    if !*target_reached_observed && side_centideg <= target_centideg as i32 {
+        *target_reached_observed = true;
+        log::info!(
+            "firmware-authoritative: selected side reached the requested target temperature; Frozen \
+             will continue maintaining it for the remaining requested duration"
+        );
+    }
+}
+
+/// Pure, panic-free-by-design per-tick range/plausibility check, isolated so it can be run behind
+/// `catch_unwind` in the active loop above. Operates on already-extracted centidegree values so
+/// it applies identically to `TemperatureUpdate` (the primary safety signal) and, if ever needed,
+/// `GetTemperature`.
+fn evaluate_tick(side_centideg: u16, heatsink_centideg: u16, prev_side_centideg: Option<i32>) -> Result<i32, StopReason> {
+    let side_centideg = side_centideg as i32;
+    if !(MIN_WATER_CENTIDEG..=MAX_WATER_CENTIDEG).contains(&side_centideg) {
+        return Err(StopReason::TemperatureRangeExceeded);
+    }
+    if (heatsink_centideg as i32) > MAX_HEATSINK_CENTIDEG {
+        return Err(StopReason::HeatsinkLimitExceeded);
+    }
+    if let Some(prev) = prev_side_centideg
+        && (side_centideg - prev).abs() > MAX_PLAUSIBLE_TICK_JUMP_CENTIDEG
+    {
+        return Err(StopReason::ImplausibleTemperatureChange);
+    }
+    Ok(side_centideg)
+}
+
+/// One tick's worth of processing for a valid, decoded temperature reading during the active
+/// phase, regardless of source: an unsolicited `TemperatureUpdate`, a solicited `GetTemperature`
+/// reply via the normal, unmodified upstream 27-byte decode path, or one recovered via
+/// `frozen_compat::CompatFrameScanner` from this firmware's 14-byte reply. All three now share
+/// this one path (history, min/max, `evaluate_tick`, target-stability tracking) instead of only
+/// `TemperatureUpdate` being wired up and the other two being "raw evidence only" -- a real
+/// synchronous `GetTemperatures` response must not be decoded only for baseline collection and
+/// then ignored once the active phase starts. Returns `Some(reason)` if this sample itself must
+/// end the active phase (an implausible jump, an out-of-range value, the heatsink ceiling, a panic
+/// while evaluating, or the target being *stably* reached).
+#[allow(clippy::too_many_arguments)]
+fn record_active_temperature_sample(
+    side: BedSide,
+    left_temp: u16,
+    right_temp: u16,
+    heatsink_temp: u16,
+    we_enabled_side: bool,
+    target_centideg: u16,
+    active_start: Instant,
+    active_left_c: &mut Vec<f64>,
+    active_right_c: &mut Vec<f64>,
+    prev_side_centideg: &mut Option<i32>,
+    min_left_c: &mut Option<f64>,
+    min_right_c: &mut Option<f64>,
+    max_heatsink_c: &mut Option<f64>,
+    final_left_c: &mut Option<f64>,
+    final_right_c: &mut Option<f64>,
+    final_heatsink_c: &mut Option<f64>,
+    target_reached: &mut bool,
+    target_reached_at: &mut Option<Instant>,
+    time_to_target_seconds: &mut Option<f64>,
+) -> Option<StopReason> {
+    let left_c = crate::telemetry::centideg_to_celsius(left_temp);
+    let right_c = crate::telemetry::centideg_to_celsius(right_temp);
+    let heatsink_c = crate::telemetry::centideg_to_celsius(heatsink_temp);
+    active_left_c.push(left_c);
+    active_right_c.push(right_c);
+    *min_left_c = Some(min_left_c.map_or(left_c, |m: f64| m.min(left_c)));
+    *min_right_c = Some(min_right_c.map_or(right_c, |m: f64| m.min(right_c)));
+    *max_heatsink_c = Some(max_heatsink_c.map_or(heatsink_c, |m: f64| m.max(heatsink_c)));
+    *final_left_c = Some(left_c);
+    *final_right_c = Some(right_c);
+    *final_heatsink_c = Some(heatsink_c);
+
+    let side_centideg = match side {
+        BedSide::Left => left_temp,
+        BedSide::Right => right_temp,
+    };
+
+    // Isolated behind `catch_unwind`: `evaluate_tick` is a small, pure, panic-free-by-design
+    // function, but wrapping it means a future bug here cannot bring down the whole active loop
+    // before shutdown runs.
+    match std::panic::catch_unwind(|| evaluate_tick(side_centideg, heatsink_temp, *prev_side_centideg)) {
+        Ok(Ok(v)) => *prev_side_centideg = Some(v),
+        Ok(Err(reason)) => return Some(reason),
+        Err(_panic) => {
+            log::error!("panic while evaluating a temperature sample; stopping safely");
+            return Some(StopReason::Panic);
+        }
+    }
+
+    // Stop early once the requested target has been reached -- never cool further than what was
+    // requested and confirmed. A single tick at or below target is not itself sufficient
+    // (telemetry noise or a single fast-settling sample); the reading must stay at/below target
+    // for TARGET_STABLE_CONFIRM_WINDOW before the active phase actually stops -- and the TEC is
+    // never kept enabled merely to consume the rest of the requested duration once that stability
+    // is confirmed.
+    if we_enabled_side && (side_centideg as i32) <= (target_centideg as i32) {
+        let reached_at = *target_reached_at.get_or_insert_with(Instant::now);
+        if reached_at.elapsed() >= TARGET_STABLE_CONFIRM_WINDOW {
+            *target_reached = true;
+            *time_to_target_seconds = Some(reached_at.saturating_duration_since(active_start).as_secs_f64());
+            return Some(StopReason::TargetTemperatureReached);
+        }
+    } else {
+        *target_reached_at = None;
+    }
+    None
+}
+
+fn tec_trend_verdict(side: BedSide, left: &[f64], right: &[f64], telemetry_ok: bool) -> Verdict {
+    if !telemetry_ok {
+        return Verdict::Fail;
+    }
+    let series = match side {
+        BedSide::Left => left,
+        BedSide::Right => right,
+    };
+    if series.len() < 2 {
+        return Verdict::Unverified;
+    }
+    let first = series[0];
+    let last = *series.last().unwrap();
+    // A short test may not appreciably change water temperature (spec's own caveat): only a
+    // measurable, sustained decrease counts as PASS; anything else is UNVERIFIED, never FAIL,
+    // since the absence of a visible drop is not proof the TEC/pump/fan chain doesn't work.
+    if last <= first - 0.10 {
+        Verdict::Pass
+    } else {
+        Verdict::Unverified
+    }
+}
+
+fn overall_verdict(cr: &ComponentResults) -> Verdict {
+    if cr.frozen_command_accepted != Verdict::Pass
+        || cr.telemetry_remained_valid != Verdict::Pass
+        || cr.emergency_shutdown != Verdict::Pass
+    {
+        return Verdict::Fail;
+    }
+    if cr.pump_operation == Verdict::Fail || cr.fan_operation == Verdict::Fail || cr.tec_cooling_operation == Verdict::Fail {
+        return Verdict::Fail;
+    }
+    if cr.pump_operation == Verdict::Pass && cr.fan_operation != Verdict::Unknown && cr.tec_cooling_operation != Verdict::Unknown {
+        Verdict::Pass
+    } else {
+        Verdict::Inconclusive
+    }
+}
+
+/// Item 5's exact stop condition, pulled out as a pure function so it can be tested directly
+/// against synthetic elapsed durations rather than through a real or virtual-time async loop:
+/// continue collecting baseline samples until either `BASELINE_MIN_SAMPLES` valid samples have
+/// been collected over at least `BASELINE_MIN_WINDOW`, or `BASELINE_MAX_WINDOW` has elapsed,
+/// whichever comes first. In particular this must stay `true` at ~40s with only 4 samples (the
+/// real-hardware regression this fix addresses: MT8365 / Frozen firmware v1.4.235 pushes
+/// unsolicited telemetry only about once every 10 seconds, so 5 samples can take 40-50s to arrive,
+/// and the previous `BASELINE_MIN_WINDOW * 4` backstop cut collection off before that could happen).
+fn baseline_should_continue(samples_len: usize, elapsed: Duration) -> bool {
+    (samples_len < BASELINE_MIN_SAMPLES || elapsed < BASELINE_MIN_WINDOW) && elapsed < BASELINE_MAX_WINDOW
+}
+
+/// True iff `sample`'s selected-side water reading and heatsink reading are both present and
+/// plausible: neither a sentinel value (0 or 0xFFFF) nor outside `MIN_WATER_CENTIDEG..=
+/// MAX_WATER_CENTIDEG`. Runs identically regardless of `sample.source` -- a sample decoded via the
+/// 14-byte compat path is validated exactly like one from the normal 27-byte/unsolicited path, so
+/// baseline validation never rejects a reading merely because of which protocol format produced
+/// it, only for an actually invalid or missing value.
+fn is_valid_baseline_reading(side: BedSide, sample: &TemperatureSample) -> bool {
+    let side_raw = match side {
+        BedSide::Left => sample.raw_left,
+        BedSide::Right => sample.raw_right,
+    };
+    let (Some(side_raw), Some(heatsink_raw)) = (side_raw, sample.raw_heatsink) else {
+        return false;
+    };
+    for v in [side_raw as i32, heatsink_raw as i32] {
+        if v == 0 || v == 0xFFFF {
+            return false;
+        }
+        if !(MIN_WATER_CENTIDEG..=MAX_WATER_CENTIDEG).contains(&v) {
+            return false;
+        }
+    }
+    true
+}
+
+/// True iff `candidate` has the exact same (left, right, heatsink) raw reading as any sample
+/// already collected *within the current baseline tick* (`tick_samples`): a solicited reply and an
+/// unsolicited push landing in the same ~1s drain window because they carry the same underlying
+/// firmware sample. Deliberately scoped to one tick, not the whole baseline history -- two
+/// genuinely separate ticks that happen to read the same stable temperature (expected during a
+/// short, stable baseline window) are not duplicates of each other.
+fn is_duplicate_within_tick(tick_samples: &[TemperatureSample], candidate: &TemperatureSample) -> bool {
+    tick_samples
+        .iter()
+        .any(|s| s.raw_left == candidate.raw_left && s.raw_right == candidate.raw_right && s.raw_heatsink == candidate.raw_heatsink)
+}
+
+/// Max - min, in Celsius, of whichever raw centidegree field `select` reads off each sample --
+/// `None` if `samples` is empty. Used only for the "stability range per channel" report fields;
+/// `validate_baseline` does its own, separate spread check on the selected side alone.
+fn baseline_range_c(samples: &[TemperatureSample], select: impl Fn(&TemperatureSample) -> Option<u16>) -> Option<f64> {
+    let values: Vec<u16> = samples.iter().filter_map(select).collect();
+    let min = *values.iter().min()?;
+    let max = *values.iter().max()?;
+    Some(crate::telemetry::centideg_to_celsius(max) - crate::telemetry::centideg_to_celsius(min))
+}
+
+/// Aggregate baseline check, run only on samples that already passed [`is_valid_baseline_reading`]
+/// and per-tick deduplication -- so the only ways this can now fail are "not enough valid samples"
+/// (the collection loop's own minimum wasn't reached, e.g. the `BASELINE_MAX_WINDOW` backstop fired
+/// first) or "implausibly unstable" (spread across the selected side's readings too wide). Never
+/// rejects for a reason belonging to sample collection (invalid/missing/unsupported format) --
+/// those are filtered out before a sample ever reaches this function.
+fn validate_baseline(samples: &[TemperatureSample], side: BedSide) -> Option<i32> {
+    if samples.len() < BASELINE_MIN_SAMPLES {
+        log::error!("baseline validation failed: only {} samples (need >= {BASELINE_MIN_SAMPLES})", samples.len());
+        return None;
+    }
+    let values: Vec<i32> = samples
+        .iter()
+        .map(|s| match side {
+            BedSide::Left => s.raw_left,
+            BedSide::Right => s.raw_right,
+        }
+        .expect("is_valid_baseline_reading already required this to be Some") as i32)
+        .collect();
+
+    let min = *values.iter().min().unwrap();
+    let max = *values.iter().max().unwrap();
+    if max - min > BASELINE_MAX_SPREAD_CENTIDEG {
+        log::error!("baseline validation failed: samples inconsistent (spread {} > {BASELINE_MAX_SPREAD_CENTIDEG})", max - min);
+        return None;
+    }
+
+    let sum: i32 = values.iter().sum();
+    Some(sum / values.len() as i32)
+}
+
+fn print_proposed_target(side: BedSide, baseline_centideg: i32, delta_centideg: i32, target_centideg: u16, duration_s: u64) {
+    let baseline_c = f64::from(baseline_centideg) / 100.0;
+    let delta_c = f64::from(delta_centideg) / 100.0;
+    let target_c = crate::telemetry::centideg_to_celsius(target_centideg);
+    eprintln!("Baseline {} water temperature: {:.2}C", side_word(side), baseline_c);
+    eprintln!("Requested delta:                 -{:.2}C", delta_c);
+    eprintln!("Proposed target:                  {:.2}C", target_c);
+    eprintln!("Maximum duration:                 {duration_s} seconds");
+    eprintln!("Selected side:                    {}", side_word(side).to_uppercase());
+}
+
+fn side_word(side: BedSide) -> &'static str {
+    match side {
+        BedSide::Left => "left",
+        BedSide::Right => "right",
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn finish(
+    args: &CoolTestArgs,
+    dry_run: bool,
+    audit: &AuditedTransport,
+    stats: &PacketStats,
+    samples: Vec<TemperatureSampleJson>,
+    cr: ComponentResults,
+    ct: CoolTestResults,
+    stop_reason: StopReason,
+    overall_pass: bool,
+    exit_code: u8,
+    reset_expander_value: u8,
+    led: &crate::i2c::ProbeResult,
+    frozen_uart_opened: bool,
+    reached_firmware: bool,
+) -> (Report, u8) {
+    let report = Report {
+        program_version: DIAGNOSTIC_VERSION.to_string(),
+        opensleep_base_version: opensleep::VERSION.to_string(),
+        opensleep_source_commit: source_commit().to_string(),
+        kernel: kernel_release(),
+        arch: std::env::consts::ARCH.to_string(),
+        mode: audit.mode().label().to_string(),
+        dry_run,
+        confirmations: Confirmations {
+            cover_hydraulics_connected_declared: Some(args.confirm_cover_hydraulics_connected),
+            water_loop_filled_declared: Some(args.confirm_water_loop_filled),
+            no_visible_leaks_declared: Some(args.confirm_no_visible_leaks),
+            active_test_confirmed_flag: Some(args.confirm_active_test),
+            // No longer applicable: this binary has no typed confirmation phrases at all --
+            // `None` here means "not asked", not "asked and failed".
+            interactive_phrase_confirmed: None,
+            final_start_phrase_confirmed: None,
+        },
+        i2c_device: args.i2c_device.clone(),
+        i2c_bus_open: true,
+        reset_expander_probe_ok: true,
+        reset_expander_value: Some(reset_expander_value),
+        led_controller_probe_ok: led.success,
+        subsystem_reset_performed: false,
+        subsystem_reset_ok: false,
+        frozen_port: args.frozen_port.clone(),
+        frozen_uart_opened,
+        frozen_bootloader_ping: None,
+        frozen_firmware_ping: Some(reached_firmware),
+        frozen_hardware_info: None,
+        firmware_version_or_hash: None,
+        frozen_firmware_probed: false,
+        detected_initial_mode: None,
+        firmware_jump_sent: false,
+        outgoing_commands: audit.entries().iter().map(AuditEntryJson::from).collect(),
+        enabled_target_command_count: audit.enabled_target_count(),
+        prime_command_count: audit.prime_count(),
+        random_command_count: audit.random_count(),
+        safety_off_commands_sent: audit.entries().iter().filter(|e| e.enabled == Some(false)).count() as u32,
+        rejected_command_count: audit.rejected_command_count(),
+        prime_frame_hex: None,
+        telemetry_samples: samples,
+        raw_packets_decoded: stats.raw_packets_decoded,
+        malformed_windows: stats.malformed_windows,
+        communication_timeouts: stats.timeouts,
+        unsolicited_telemetry_seen: stats.unsolicited_telemetry_seen,
+        firmware_messages: stats.messages.clone(),
+        pump_samples: Vec::new(),
+        solenoid_valve_messages: Vec::new(),
+        reservoir_transition_messages: Vec::new(),
+        other_decoded_packets: Vec::new(),
+        raw_io_events: Vec::new(),
+        priming_start_observed: false,
+        priming_done_observed: false,
+        priming_done_because_empty: false,
+        operator_observations: build_operator_observations(args),
+        prime_operator_observations: None,
+        stop_reason: stop_reason.to_string(),
+        safe_stop: None,
+        component_results: Some(cr),
+        prime_results: None,
+        opensleep_init_results: None,
+        release_frozen_only_results: None,
+        cool_test_results: Some(ct),
+        overall_pass,
+        exit_code,
+    };
+
+    if let Some(path) = &args.json_output
+        && let Err(e) = report.write_json(path)
+    {
+        log::error!("failed to write JSON output to {path}: {e}");
+    }
+    if let Some(path) = &args.csv_output
+        && let Err(e) = report.write_csv(path)
+    {
+        log::error!("failed to write CSV output to {path}: {e}");
+    }
+    report.print_table();
+
+    let code = report.exit_code;
+    (report, code)
+}
