+//! `frozen-prime-test`: the one subcommand that intentionally sends `Prime` (opcode 0x52) to fill
+//! an empty or partially-filled Eight Sleep Pod 3 hydraulic loop. See SAFETY.md for the
+//! operator-facing guarantees and PROTOCOL_AUDIT.md for the full source audit behind every claim
+//! in this file's doc comments.
+//!
+//! Key facts established by that audit, load-bearing for this file's design:
+//! - `Prime` takes no arguments and applies to both sides in one shot -- there is no per-side
+//!   Prime, so (unlike `frozen-cool-test`) this mode has no `--side` flag.
+//! - The only direct start evidence is the `PrimingStarted` packet (opcode 0xD2) and/or a
+//!   `"FW: [priming] start"` message. The only completion evidence is a `"FW: [priming] done"` or
+//!   `"...done because empty"` message -- there is no binary "priming complete" packet.
+//! - No Prime-cancellation command exists anywhere in the reused protocol. Subsystem reset (I2C
+//!   0x20) is therefore the only forced-stop mechanism, exactly as for every other mode's
+//!   safe-stop, and is asserted on every exit path regardless of whether "done" was ever observed.
+//! - The firmware does not expose a reliable reservoir-empty signal on this hardware (`capwater`
+//!   is reported unavailable). The operator, watching the reservoir, is the primary safety
+//!   interlock -- this tool cannot substitute for that.
+
+use std::io::IsTerminal;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use opensleep::common::codec::CommandTrait;
+use opensleep::common::packet::BedSide;
+use opensleep::frozen::FrozenPacket;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::time::Instant;
+
+use crate::buildinfo::{DIAGNOSTIC_VERSION, kernel_release, source_commit};
+use crate::cli::PrimeTestArgs;
+use crate::confirm::confirm_phrase;
+use crate::cool_test::{MAX_HEATSINK_CENTIDEG, MAX_WATER_CENTIDEG, MIN_WATER_CENTIDEG, STALE_TELEMETRY_LIMIT};
+use crate::i2c::{I2cPort, MockI2c, RealI2c, probe_address, run_reset_sequence};
+use crate::link::{FrozenLink, LinkError, PacketOutcome};
+use crate::mock::mock_frozen_link_pair;
+use crate::ownership;
+use crate::report::{
+    AuditEntryJson, Confirmations, PrimeOperatorObservations, PrimeResults, PumpSampleJson, Report,
+    TemperatureSampleJson, Verdict,
+};
+use crate::safe_stop::run_safe_stop;
+use crate::safety::{AuditedTransport, FrozenAction, Mode};
+use crate::signals::{StopReason, wait_for_termination_signal};
+use crate::telemetry::{PacketStats, sample_from_get_temperature, sample_from_temperature_update};
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// Hard, non-overridable maximum observation window.
+pub const HARD_MAX_DURATION_SECONDS: u64 = 60;
+/// Hard, non-overridable minimum -- a shorter window cannot meaningfully observe anything.
+pub const MIN_DURATION_SECONDS: u64 = 5;
+pub const BASELINE_MIN_SAMPLES: usize = 3;
+pub const BASELINE_WINDOW: Duration = Duration::from_secs(3);
+/// Length of each drain window within one ~1-second active-phase tick.
+const TICK_DRAIN_WINDOW: Duration = Duration::from_millis(900);
+/// How often a Ping is sent during the active phase solely to detect an unexpected fallback to
+/// bootloader mode. Same interference caution as above.
+const BOOTLOADER_CHECK_EVERY_N_TICKS: u32 = 5;
+/// How often the 0x20 reset/enable expander is re-probed during the active phase.
+const I2C_CHECK_EVERY_N_TICKS: u32 = 5;
+
+const INTERACTIVE_PHRASE: &str = "I CONFIRM THE RESERVOIR IS FILLED AND THE COVER IS CONNECTED";
+const FINAL_PHRASE: &str = "START SUPERVISED PRIMING";
+
+pub async fn run(args: &PrimeTestArgs) -> (Report, u8) {
+    if args.duration_seconds > HARD_MAX_DURATION_SECONDS {
+        log::error!(
+            "refusing to run: --duration-seconds {} exceeds the hard maximum of {} (no option can raise this)",
+            args.duration_seconds, HARD_MAX_DURATION_SECONDS
+        );
+        return (refused_report(args, false, "duration exceeds hard maximum"), 30);
+    }
+    if args.duration_seconds < MIN_DURATION_SECONDS {
+        log::error!(
+            "refusing to run: --duration-seconds {} is below the minimum of {}",
+            args.duration_seconds, MIN_DURATION_SECONDS
+        );
+        return (refused_report(args, false, "duration below minimum"), 30);
+    }
+
+    if !(args.confirm_cover_hydraulics_connected
+        && args.confirm_reservoir_filled
+        && args.confirm_cover_loop_needs_priming
+        && args.confirm_no_visible_leaks
+        && args.confirm_active_test)
+    {
+        log::error!("refusing to run: all five --confirm-* flags are required");
+        return (refused_report(args, false, "missing required confirmation flags"), 30);
+    }
+
+    let interactive_ok = confirm_phrase(
+        args.assume_interactive_phrase.clone(),
+        INTERACTIVE_PHRASE,
+        "Type I CONFIRM THE RESERVOIR IS FILLED AND THE COVER IS CONNECTED to continue: ",
+    );
+    if !interactive_ok {
+        log::error!("refusing to run: interactive confirmation phrase was not matched exactly");
+        return (refused_report(args, false, "interactive confirmation phrase mismatch"), 30);
+    }
+
+    let capture: crate::io_logging::RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+
+    if args.dry_run {
+        log::warn!("--dry-run: no I2C or UART writes will be performed; using a mocked Frozen device");
+        let mut i2c = MockI2c::always_succeed();
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap_capturing(client, "dry-run", capture.clone());
+        let result = run_core(args, &mut i2c, Some(&mut link), true, &capture).await;
+        drop(link);
+        task.abort();
+        return result;
+    }
+
+    if let Some(early) = refuse_if_owned(args) {
+        return early;
+    }
+
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("failed to open I2C device {}: {e}", args.i2c_device);
+            return (refused_report(args, false, "I2C bus failed to open"), 20);
+        }
+    };
+
+    let mut link = match opensleep::common::serial::create_port(&args.frozen_port, crate::link::BAUD) {
+        Ok(raw) => {
+            log::info!("Frozen UART opened: {} @ {} baud, 8N1, no flow control", args.frozen_port, crate::link::BAUD);
+            Some(FrozenLink::wrap_capturing(raw, "Frozen", capture.clone()))
+        }
+        Err(e) => {
+            log::error!("failed to open Frozen UART {}: {e}", args.frozen_port);
+            None
+        }
+    };
+
+    run_core(args, &mut i2c, link.as_mut(), false, &capture).await
+}
+
+fn refuse_if_owned(args: &PrimeTestArgs) -> Option<(Report, u8)> {
+    let services = ownership::check_stock_services();
+    let active: Vec<_> = services.iter().filter(|s| s.active).map(|s| s.name.clone()).collect();
+    if !active.is_empty() {
+        log::error!("refusing to run: stock service(s) active: {active:?}");
+        return Some((refused_report(args, false, "stock service(s) active; refusing to run"), 40));
+    }
+    if ownership::device_exists(&args.i2c_device) && ownership::device_is_open_elsewhere(&args.i2c_device) {
+        log::error!("refusing to run: {} appears to be open in another process", args.i2c_device);
+        return Some((refused_report(args, false, "I2C device already open elsewhere"), 40));
+    }
+    if ownership::device_exists(&args.frozen_port) && ownership::device_is_open_elsewhere(&args.frozen_port) {
+        log::error!("refusing to run: {} appears to be open in another process", args.frozen_port);
+        return Some((refused_report(args, false, "Frozen UART already open elsewhere"), 40));
+    }
+    None
+}
+
+/// Parses a firmware pump message (e.g. `FW: pump[left] slow @ 6.030475V 0.169202A`) into
+/// `(side, voltage, current)`. Returns `None` if `msg` isn't a pump message at all.
+fn parse_pump_telemetry(msg: &str) -> Option<(&'static str, Option<f64>, Option<f64>)> {
+    let lower = msg.to_lowercase();
+    let side = if lower.contains("pump[left]") {
+        "left"
+    } else if lower.contains("pump[right]") {
+        "right"
+    } else {
+        return None;
+    };
+    let at = lower.find('@');
+    let (voltage, current) = match at {
+        Some(at_pos) => {
+            let rest = &lower[at_pos + 1..];
+            let voltage = rest
+                .find('v')
+                .and_then(|vpos| rest[..vpos].trim().parse::<f64>().ok());
+            let current = rest.find('v').and_then(|vpos| {
+                let after_v = &rest[vpos + 1..];
+                after_v.find('a').and_then(|apos| after_v[..apos].trim().parse::<f64>().ok())
+            });
+            (voltage, current)
+        }
+        None => (None, None),
+    };
+    Some((side, voltage, current))
+}
+
+/// True if `msg` names a pump fault (narrow match: "pump" plus a fault word), distinct from a
+/// normal `pump[<side>] ... @ V A` telemetry line.
+fn is_pump_fault_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    lower.contains("pump") && (lower.contains("fault") || lower.contains("locked")) && !lower.contains('@')
+}
+
+/// No "solenoid" or "valve" message has ever been observed in the pinned source or captured logs
+/// (see PROTOCOL_AUDIT.md) -- this is a forward-compatible keyword scan, not a confirmed protocol
+/// feature. Absence of a match is not evidence that no such message exists on real hardware.
+fn is_solenoid_or_valve_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    lower.contains("solenoid") || lower.contains("valve")
+}
+
+/// `"FW: water empty -> full"` / `"FW: water full -> empty"` -- real, evidenced messages
+/// (`frozen/state.rs`) about a reservoir-level transition, distinct from the `[capwater] sensor
+/// unavailable` warning. May never fire if that sensor stays unavailable on this hardware.
+fn is_reservoir_transition_message(msg: &str) -> bool {
+    msg == "FW: water empty -> full" || msg == "FW: water full -> empty"
+}
+
+/// Strips the `"FW: [priming] "` prefix used by every priming-stage message (source: real
+/// captured firmware log strings in `frozen/state.rs`), or `None` if `msg` isn't one.
+fn priming_stage_text(msg: &str) -> Option<&str> {
+    msg.strip_prefix("FW: [priming] ")
+}
+
+const FAULT_KEYWORDS: [&str; 6] = ["overtemperature", "overcurrent", "shutdown", "fault", "failed", "locked"];
+
+/// Generic firmware-fault keyword scan for messages that are *not* a cataloged `[priming]`-stage
+/// message (those are handled separately -- see module docs: real evidence shows "failed" appears
+/// in routine purge-retry accounting there, e.g. "%u consecutive failed purges", which is not by
+/// itself a fatal condition; the firmware's own "done"/"done because empty" messages are the
+/// authoritative completion signals). Excludes "flash locked" -- a captured, evidenced, benign
+/// firmware boot-time message unrelated to any actuator or safety fault.
+fn is_generic_fault_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    if lower.contains("flash locked") {
+        return false;
+    }
+    FAULT_KEYWORDS.iter().any(|kw| lower.contains(kw))
+}
+
+/// True if a firmware message about the water/heatsink sensor is the known, non-fatal "sensor
+/// unavailable" notice observed with the cover connected and the reservoir filled.
+fn is_known_nonfatal_sensor_message(msg: &str) -> bool {
+    msg.to_lowercase().contains("sensor unavailable")
+}
+
+/// Pure, panic-free-by-design range/plausibility check for both sides at once (Prime affects both
+/// sides in a single command, unlike `frozen-cool-test`'s single selected side).
+fn evaluate_temperatures(left_centideg: u16, right_centideg: u16, heatsink_centideg: u16) -> Result<(), StopReason> {
+    for v in [left_centideg as i32, right_centideg as i32] {
+        if !(MIN_WATER_CENTIDEG..=MAX_WATER_CENTIDEG).contains(&v) {
+            return Err(StopReason::TemperatureRangeExceeded);
+        }
+    }
+    if heatsink_centideg as i32 > MAX_HEATSINK_CENTIDEG {
+        return Err(StopReason::HeatsinkLimitExceeded);
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn print_live_summary(
+    elapsed: Duration,
+    prime_sent: bool,
+    start_observed: bool,
+    done_observed: bool,
+    left_pump: Option<(f64, f64)>,
+    right_pump: Option<(f64, f64)>,
+    solenoid_seen: bool,
+    last_flow_message: &Option<String>,
+    left_water_c: Option<f64>,
+    right_water_c: Option<f64>,
+    heatsink_c: Option<f64>,
+    last_telemetry_age: Option<Duration>,
+) {
+    eprintln!("---- frozen-prime-test: {:.0}s elapsed ----", elapsed.as_secs_f64());
+    eprintln!("Prime command sent:        {}", prime_sent);
+    eprintln!("Prime start observed:      {}", start_observed);
+    eprintln!("Prime completion observed: {}", done_observed);
+    eprintln!(
+        "Left pump voltage/current:  {}",
+        left_pump.map(|(v, a)| format!("{v:.3}V {a:.3}A")).unwrap_or_else(|| "unknown".to_string())
+    );
+    eprintln!(
+        "Right pump voltage/current: {}",
+        right_pump.map(|(v, a)| format!("{v:.3}V {a:.3}A")).unwrap_or_else(|| "unknown".to_string())
+    );
+    eprintln!("Solenoid state:            {}", if solenoid_seen { "message observed" } else { "no message observed" });
+    eprintln!("Flow message:              {}", last_flow_message.as_deref().unwrap_or("none"));
+    eprintln!(
+        "Left water temperature:    {}",
+        left_water_c.map(|v| format!("{v:.2}C")).unwrap_or_else(|| "unknown".to_string())
+    );
+    eprintln!(
+        "Right water temperature:   {}",
+        right_water_c.map(|v| format!("{v:.2}C")).unwrap_or_else(|| "unknown".to_string())
+    );
+    eprintln!(
+        "Heatsink temperature:      {}",
+        heatsink_c.map(|v| format!("{v:.2}C")).unwrap_or_else(|| "unknown".to_string())
+    );
+    eprintln!(
+        "Last telemetry age:        {}",
+        last_telemetry_age.map(|d| format!("{:.1}s", d.as_secs_f64())).unwrap_or_else(|| "never".to_string())
+    );
+    eprintln!("WATCH THE RESERVOIR. Press Ctrl+C immediately if it approaches empty.");
+}
+
+#[allow(clippy::too_many_arguments)]
+async fn run_core<T, P>(
+    args: &PrimeTestArgs,
+    i2c: &mut P,
+    mut link: Option<&mut FrozenLink<T>>,
+    dry_run: bool,
+    capture: &crate::io_logging::RawIoCapture,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let mut audit = AuditedTransport::new(Mode::PrimeTest);
+    let mut stats = PacketStats::default();
+    let mut samples: Vec<TemperatureSampleJson> = Vec::new();
+    let mut pump_samples: Vec<PumpSampleJson> = Vec::new();
+    let mut solenoid_valve_messages: Vec<String> = Vec::new();
+    let mut reservoir_transition_messages: Vec<String> = Vec::new();
+    let mut other_decoded_packets: Vec<String> = Vec::new();
+    let mut pr = PrimeResults::default();
+
+    let expander = probe_address(i2c, crate::i2c::RESET_EXPANDER_ADDR);
+    let led = probe_address(i2c, crate::i2c::LED_CONTROLLER_ADDR);
+    if !led.success {
+        log::info!("LED controller unavailable; continuing diagnostic ({})", led.describe());
+    }
+    let (reset_steps, _release) = run_reset_sequence(i2c).await;
+    let subsystem_reset_ok = reset_steps.iter().all(|s| s.success);
+
+    let Some(link) = link.as_deref_mut() else {
+        log::error!("refusing to run active test: Frozen UART is not open");
+        let safe_stop = run_safe_stop::<T, P>(None, &mut audit, Some(i2c)).await;
+        return finish(
+            args, dry_run, &audit, &stats, samples, pump_samples, solenoid_valve_messages,
+            reservoir_transition_messages, other_decoded_packets, pr, false, false, false, None,
+            safe_stop, StopReason::PreflightRefused, false, capture,
+            &expander, &led, subsystem_reset_ok, false, false, None, false, None,
+        );
+    };
+
+    let (ping_ok, mode) = crate::frozen_ops::ping(link, &mut audit, COMMAND_TIMEOUT).await;
+    let mut reached_firmware = mode == crate::frozen_ops::DeviceMode::Firmware;
+    if !reached_firmware && mode == crate::frozen_ops::DeviceMode::Bootloader {
+        reached_firmware = crate::frozen_ops::jump_to_firmware_and_wait(link, &mut audit, COMMAND_TIMEOUT).await;
+    }
+
+    let mut hardware_info_str = None;
+    let mut firmware_probed = false;
+    if ping_ok
+        && let Some(hw) = crate::frozen_ops::get_hardware_info(link, &mut audit, COMMAND_TIMEOUT).await
+    {
+        hardware_info_str = Some(hw.to_string());
+    }
+    if reached_firmware {
+        match link.send(&mut audit, FrozenAction::get_firmware(), COMMAND_TIMEOUT).await {
+            Ok(PacketOutcome::Received(_)) => firmware_probed = true,
+            Ok(_) => log::debug!("Frozen did not respond to GetFirmware within {COMMAND_TIMEOUT:?}"),
+            Err(e) => log::debug!("Frozen GetFirmware failed (non-fatal): {e}"),
+        }
+    }
+
+    // Step 12: explicitly disable both sides, and confirm from the acks that neither is enabled
+    // (step 14) before proceeding any further.
+    let mut left_enabled_after_disable = None;
+    let mut right_enabled_after_disable = None;
+    for side in [BedSide::Left, BedSide::Right] {
+        match link.send(&mut audit, FrozenAction::safety_off(side), COMMAND_TIMEOUT).await {
+            Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((s, t)))) => match s {
+                BedSide::Left => left_enabled_after_disable = Some(t.enabled),
+                BedSide::Right => right_enabled_after_disable = Some(t.enabled),
+            },
+            Ok(_) => {}
+            Err(e) => log::error!("safety-off for {side:?} failed: {e}"),
+        }
+    }
+
+    pr.frozen_application_firmware = if reached_firmware { Verdict::Pass } else { Verdict::Fail };
+
+    if !ping_ok || !reached_firmware {
+        log::error!("refusing to run active test: Frozen did not reach application firmware");
+        let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+        return finish(
+            args, dry_run, &audit, &stats, samples, pump_samples, solenoid_valve_messages,
+            reservoir_transition_messages, other_decoded_packets, pr, false, false, false, None,
+            safe_stop, StopReason::PreflightRefused, false, capture,
+            &expander, &led, subsystem_reset_ok, true, reached_firmware, hardware_info_str, firmware_probed, None,
+        );
+    }
+
+    if left_enabled_after_disable == Some(true) || right_enabled_after_disable == Some(true) {
+        log::error!("refusing to run active test: an enabled target is still active after safety-off");
+        let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+        return finish(
+            args, dry_run, &audit, &stats, samples, pump_samples, solenoid_valve_messages,
+            reservoir_transition_messages, other_decoded_packets, pr, false, false, false, None,
+            safe_stop, StopReason::PreflightRefused, false, capture,
+            &expander, &led, subsystem_reset_ok, true, reached_firmware, hardware_info_str, firmware_probed, None,
+        );
+    }
+
+    // Step 13: fresh baseline telemetry, from unsolicited TemperatureUpdate pushes (see
+    // cool_test.rs's module docs for why the solicited 0xC1 reply is not relied on).
+    let baseline_start = Instant::now();
+    let mut baseline_samples = 0usize;
+    while baseline_samples < BASELINE_MIN_SAMPLES || baseline_start.elapsed() < BASELINE_WINDOW {
+        if let Err(e) = link.send_only(&mut audit, FrozenAction::get_temperatures()).await {
+            log::error!("failed to send GetTemperatures during baseline collection: {e}");
+            stats.record_timeout();
+        }
+        let drain_deadline = Instant::now() + TICK_DRAIN_WINDOW;
+        loop {
+            let remaining = drain_deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                break;
+            }
+            match link.recv(remaining).await {
+                Ok(PacketOutcome::Received(pkt)) => {
+                    stats.record(&pkt);
+                    let elapsed_ms = baseline_start.elapsed().as_millis() as u64;
+                    match pkt {
+                        FrozenPacket::TemperatureUpdate(u) => {
+                            samples.push(
+                                (&sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u))
+                                    .into(),
+                            );
+                            baseline_samples += 1;
+                        }
+                        FrozenPacket::GetTemperature(g) => {
+                            samples.push(
+                                (&sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g))
+                                    .into(),
+                            );
+                        }
+                        _ => {}
+                    }
+                }
+                Ok(PacketOutcome::TimedOut) | Ok(PacketOutcome::Closed) => break,
+                Err(_) => break,
+            }
+        }
+        if baseline_start.elapsed() > BASELINE_WINDOW * 4 {
+            break; // hard backstop
+        }
+    }
+
+    // Mandatory warning and final confirmation, now that preflight has established firmware is
+    // reached, no target is enabled, and baseline telemetry is flowing.
+    eprintln!("WARNING: Priming may rapidly lower the reservoir water level.");
+    eprintln!("Watch the reservoir continuously.");
+    eprintln!("Stop immediately if the reservoir approaches empty.");
+    eprintln!("Keep access to disconnect Hub power.");
+    eprintln!("Do not touch the open electronics while powered.");
+    let start_ok = confirm_phrase(
+        args.assume_start_phrase.clone(),
+        FINAL_PHRASE,
+        &format!("Type {FINAL_PHRASE} to continue: "),
+    );
+    if !start_ok {
+        log::error!("refusing to run active test: final start phrase was not matched exactly");
+        let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+        return finish(
+            args, dry_run, &audit, &stats, samples, pump_samples, solenoid_valve_messages,
+            reservoir_transition_messages, other_decoded_packets, pr, false, false, false, None,
+            safe_stop, StopReason::PreflightRefused, false, capture,
+            &expander, &led, subsystem_reset_ok, true, reached_firmware, hardware_info_str, firmware_probed, None,
+        );
+    }
+
+    // Step 16: send Prime exactly once. AuditedTransport::check additionally enforces this
+    // structurally (see safety.rs) -- this call site is simply the only place in this binary that
+    // ever attempts it.
+    let prime_frame_hex = FrozenAction::prime().to_command().to_bytes().iter().map(|b| format!("{b:02X}")).collect::<Vec<_>>().join(" ");
+    let send_result = link.send(&mut audit, FrozenAction::prime(), COMMAND_TIMEOUT).await;
+    pr.prime_command_transmitted = match &send_result {
+        Ok(_) => Verdict::Pass,
+        Err(_) => Verdict::Fail,
+    };
+
+    let mut priming_start_observed = false;
+    let mut priming_done_observed = false;
+    let mut priming_done_because_empty = false;
+    let mut stop_reason;
+    let mut telemetry_ok = true;
+
+    match &send_result {
+        Ok(PacketOutcome::Received(FrozenPacket::PrimingStarted)) => {
+            priming_start_observed = true;
+            pr.prime_acknowledgment = Verdict::Pass;
+        }
+        Ok(PacketOutcome::Received(other)) => {
+            other_decoded_packets.push(format!("{other:?}"));
+            pr.prime_acknowledgment = Verdict::Unverified;
+        }
+        Ok(_) => pr.prime_acknowledgment = Verdict::Unverified,
+        Err(_) => pr.prime_acknowledgment = Verdict::Unverified,
+    }
+
+    if send_result.is_err() {
+        stop_reason = StopReason::UartWriteFailure;
+        telemetry_ok = false;
+    } else {
+        stop_reason = StopReason::Normal;
+    }
+
+    let active_start = Instant::now();
+    let duration = Duration::from_secs(args.duration_seconds.min(HARD_MAX_DURATION_SECONDS));
+    let mut last_valid_at = Instant::now();
+    let mut last_flow_message: Option<String> = None;
+    let mut left_water_c: Option<f64> = None;
+    let mut right_water_c: Option<f64> = None;
+    let mut heatsink_c: Option<f64> = None;
+    let mut left_pump_last: Option<(f64, f64)> = None;
+    let mut right_pump_last: Option<(f64, f64)> = None;
+    let mut left_pump_confirmed_running = false;
+    let mut right_pump_confirmed_running = false;
+    let mut tick_count: u32 = 0;
+
+    if send_result.is_ok() {
+        'active: loop {
+            if active_start.elapsed() >= duration {
+                stop_reason = StopReason::DurationExpired;
+                break;
+            }
+            if priming_done_observed {
+                stop_reason = StopReason::PrimingCompleted;
+                break;
+            }
+
+            tick_count += 1;
+
+            // Polled every tick (~1/s), matching frozen-cool-test's proven cadence: Frozen has
+            // only ever been observed pushing a fresh TemperatureUpdate in response to being
+            // polled (see mock.rs/PROTOCOL_AUDIT.md), so throttling this specific request would
+            // make the staleness check below fire on every tick it's skipped, regardless of
+            // whether Prime is actually progressing normally.
+            if let Err(e) = link.send_only(&mut audit, FrozenAction::get_temperatures()).await {
+                log::error!("UART write failure during active phase: {e}");
+                stop_reason = StopReason::UartWriteFailure;
+                telemetry_ok = false;
+                break 'active;
+            }
+            if tick_count % BOOTLOADER_CHECK_EVERY_N_TICKS == 0
+                && let Err(e) = link.send_only(&mut audit, FrozenAction::ping()).await
+            {
+                log::error!("UART write failure during active phase: {e}");
+                stop_reason = StopReason::UartWriteFailure;
+                telemetry_ok = false;
+                break 'active;
+            }
+            if tick_count % I2C_CHECK_EVERY_N_TICKS == 0 {
+                let probe = probe_address(i2c, crate::i2c::RESET_EXPANDER_ADDR);
+                if !probe.success {
+                    log::error!("I2C re-probe of 0x20 failed during active phase: {}", probe.describe());
+                    stop_reason = StopReason::I2cFailureDuringPriming;
+                    telemetry_ok = false;
+                    break 'active;
+                }
+            }
+
+            let drain_deadline = Instant::now() + TICK_DRAIN_WINDOW;
+            loop {
+                let remaining = drain_deadline.saturating_duration_since(Instant::now());
+                if remaining.is_zero() {
+                    break;
+                }
+                tokio::select! {
+                    biased;
+                    reason = wait_for_termination_signal() => {
+                        stop_reason = reason;
+                        break 'active;
+                    }
+                    outcome = link.recv(remaining) => {
+                        match outcome {
+                            Ok(PacketOutcome::Received(FrozenPacket::TemperatureUpdate(u))) => {
+                                stats.record(&FrozenPacket::TemperatureUpdate(u.clone()));
+                                last_valid_at = Instant::now();
+                                let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                samples.push((&sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u)).into());
+                                left_water_c = Some(crate::telemetry::centideg_to_celsius(u.left_temp));
+                                right_water_c = Some(crate::telemetry::centideg_to_celsius(u.right_temp));
+                                heatsink_c = Some(crate::telemetry::centideg_to_celsius(u.heatsink_temp));
+
+                                match std::panic::catch_unwind(|| evaluate_temperatures(u.left_temp, u.right_temp, u.heatsink_temp)) {
+                                    Ok(Ok(())) => {}
+                                    Ok(Err(reason)) => {
+                                        stop_reason = reason;
+                                        telemetry_ok = false;
+                                        break 'active;
+                                    }
+                                    Err(_panic) => {
+                                        log::error!("panic while evaluating a temperature sample; stopping safely");
+                                        stop_reason = StopReason::Panic;
+                                        telemetry_ok = false;
+                                        break 'active;
+                                    }
+                                }
+                            }
+                            Ok(PacketOutcome::Received(FrozenPacket::GetTemperature(g))) => {
+                                stats.record(&FrozenPacket::GetTemperature(g.clone()));
+                                let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                samples.push((&sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g)).into());
+                            }
+                            Ok(PacketOutcome::Received(FrozenPacket::PrimingStarted)) => {
+                                stats.record(&FrozenPacket::PrimingStarted);
+                                priming_start_observed = true;
+                            }
+                            Ok(PacketOutcome::Received(FrozenPacket::Message(m))) => {
+                                stats.record(&FrozenPacket::Message(m.clone()));
+                                last_flow_message = Some(m.clone());
+
+                                if let Some(stage) = priming_stage_text(&m) {
+                                    match stage {
+                                        "start" => priming_start_observed = true,
+                                        "done" => priming_done_observed = true,
+                                        "done because empty" => {
+                                            priming_done_observed = true;
+                                            priming_done_because_empty = true;
+                                            log::warn!("firmware reports priming stopped because the reservoir is empty");
+                                        }
+                                        _ => {}
+                                    }
+                                    // Cataloged priming-stage text (including routine purge-retry
+                                    // "failed" counts) is informational, never auto-abort -- see
+                                    // module docs.
+                                } else if let Some((side, voltage, current)) = parse_pump_telemetry(&m) {
+                                    let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                    pump_samples.push(PumpSampleJson {
+                                        elapsed_ms,
+                                        timestamp: jiff::Timestamp::now().to_string(),
+                                        side: side.to_string(),
+                                        voltage,
+                                        current,
+                                        raw_message: m.clone(),
+                                    });
+                                    let running = voltage.is_some_and(|v| v > 0.0005);
+                                    match side {
+                                        "left" => left_pump_last = voltage.zip(current).or(left_pump_last),
+                                        _ => right_pump_last = voltage.zip(current).or(right_pump_last),
+                                    }
+                                    if running {
+                                        match side {
+                                            "left" => left_pump_confirmed_running = true,
+                                            _ => right_pump_confirmed_running = true,
+                                        }
+                                    }
+                                    if is_pump_fault_message(&m) {
+                                        stop_reason = StopReason::PumpFault;
+                                        telemetry_ok = false;
+                                        break 'active;
+                                    }
+                                } else if is_pump_fault_message(&m) {
+                                    stop_reason = StopReason::PumpFault;
+                                    telemetry_ok = false;
+                                    break 'active;
+                                } else if is_solenoid_or_valve_message(&m) {
+                                    solenoid_valve_messages.push(m.clone());
+                                } else if is_reservoir_transition_message(&m) {
+                                    reservoir_transition_messages.push(m.clone());
+                                } else if is_known_nonfatal_sensor_message(&m) {
+                                    log::warn!("firmware sensor-unavailable message (non-fatal): {m:?}");
+                                } else if is_generic_fault_message(&m) {
+                                    log::error!("firmware fault message during active phase: {m:?}");
+                                    stop_reason = StopReason::FirmwareFaultMessage;
+                                    telemetry_ok = false;
+                                    break 'active;
+                                }
+                            }
+                            Ok(PacketOutcome::Received(FrozenPacket::TargetUpdate((_, target)))) => {
+                                if target.enabled {
+                                    log::error!("an unexpected enabled target appeared during frozen-prime-test");
+                                    stop_reason = StopReason::TargetEnabledUnexpectedly;
+                                    telemetry_ok = false;
+                                    break 'active;
+                                }
+                            }
+                            Ok(PacketOutcome::Received(FrozenPacket::Pong(in_firmware))) => {
+                                if !in_firmware {
+                                    log::error!("Frozen returned to bootloader mode during frozen-prime-test");
+                                    stop_reason = StopReason::FrozenReturnedToBootloader;
+                                    telemetry_ok = false;
+                                    break 'active;
+                                }
+                            }
+                            Ok(PacketOutcome::Received(other)) => {
+                                stats.record(&other);
+                                other_decoded_packets.push(format!("{other:?}"));
+                            }
+                            Ok(PacketOutcome::TimedOut) => break,
+                            Ok(PacketOutcome::Closed) => {
+                                stop_reason = StopReason::TelemetryLost;
+                                telemetry_ok = false;
+                                break 'active;
+                            }
+                            Err(LinkError::ReadIo(e)) => {
+                                log::error!("UART read failure during active phase: {e}");
+                                stop_reason = StopReason::UartReadFailure;
+                                telemetry_ok = false;
+                                break 'active;
+                            }
+                            Err(e) => {
+                                log::error!("unexpected error draining telemetry: {e}");
+                            }
+                        }
+                    }
+                }
+            }
+
+            print_live_summary(
+                active_start.elapsed(),
+                true,
+                priming_start_observed,
+                priming_done_observed,
+                left_pump_last,
+                right_pump_last,
+                !solenoid_valve_messages.is_empty(),
+                &last_flow_message,
+                left_water_c,
+                right_water_c,
+                heatsink_c,
+                Some(last_valid_at.elapsed()),
+            );
+
+            if last_valid_at.elapsed() > STALE_TELEMETRY_LIMIT {
+                stop_reason = StopReason::TelemetryStale;
+                telemetry_ok = false;
+                break 'active;
+            }
+        }
+    }
+
+    pr.prime_start_observed = if priming_start_observed { Verdict::Pass } else { Verdict::Unverified };
+    pr.prime_completion_observed = if priming_done_observed { Verdict::Pass } else { Verdict::Unverified };
+    pr.left_pump_telemetry = if left_pump_confirmed_running {
+        Verdict::Pass
+    } else if left_pump_last.is_some() {
+        Verdict::Fail
+    } else {
+        Verdict::Unverified
+    };
+    pr.right_pump_telemetry = if right_pump_confirmed_running {
+        Verdict::Pass
+    } else if right_pump_last.is_some() {
+        Verdict::Fail
+    } else {
+        Verdict::Unverified
+    };
+    pr.solenoid_operation = if solenoid_valve_messages.iter().any(|m| {
+        let l = m.to_lowercase();
+        l.contains("fault") || l.contains("fail") || l.contains("stuck")
+    }) {
+        Verdict::Fail
+    } else if !solenoid_valve_messages.is_empty() {
+        Verdict::Pass
+    } else {
+        Verdict::Unverified
+    };
+
+    let safe_stop = run_safe_stop(Some(link), &mut audit, Some(i2c)).await;
+    pr.safe_stop_and_reset = if safe_stop.fully_succeeded() { Verdict::Pass } else { Verdict::Fail };
+
+    let observations = prompt_prime_observations();
+    pr.left_pump_operator_observation = observation_verdict(observations.as_ref().and_then(|o| o.left_pump_heard_or_felt.as_deref()));
+    pr.right_pump_operator_observation = observation_verdict(observations.as_ref().and_then(|o| o.right_pump_heard_or_felt.as_deref()));
+
+    let operator_water_movement = observations.as_ref().and_then(|o| o.water_movement_or_bubbles_observed.as_deref());
+    let operator_reservoir_dropped = observations.as_ref().and_then(|o| o.reservoir_level_dropped.as_deref());
+    let forced_fail = observations.as_ref().is_some_and(|o| {
+        o.leak_observed == Some(true) || o.abnormal_noise == Some(true) || o.burning_smell == Some(true)
+    });
+
+    pr.water_movement_observed = if !reservoir_transition_messages.is_empty() || operator_water_movement == Some("yes") {
+        Verdict::Pass
+    } else if operator_water_movement == Some("no") {
+        Verdict::Fail
+    } else {
+        Verdict::Unverified
+    };
+
+    // Never PASS from the command/ack/voltage/"done" alone -- requires either (operator evidence
+    // of both water movement AND reservoir-level change) OR a direct firmware circulation proof.
+    let water_circulation_proven = !reservoir_transition_messages.is_empty()
+        || (operator_water_movement == Some("yes") && operator_reservoir_dropped == Some("yes"));
+
+    pr.overall_result = if forced_fail
+        || pr.frozen_application_firmware == Verdict::Fail
+        || pr.prime_command_transmitted == Verdict::Fail
+        || pr.safe_stop_and_reset == Verdict::Fail
+        || pr.left_pump_telemetry == Verdict::Fail && pr.right_pump_telemetry == Verdict::Fail
+        || pr.solenoid_operation == Verdict::Fail
+    {
+        Verdict::Fail
+    } else if water_circulation_proven {
+        Verdict::Pass
+    } else {
+        Verdict::Inconclusive
+    };
+
+    let overall_pass = pr.overall_result == Verdict::Pass;
+
+    let _ = telemetry_ok;
+    finish(
+        args, dry_run, &audit, &stats, samples, pump_samples, solenoid_valve_messages,
+        reservoir_transition_messages, other_decoded_packets, pr, priming_start_observed,
+        priming_done_observed, priming_done_because_empty, observations, safe_stop, stop_reason,
+        overall_pass, capture, &expander, &led, subsystem_reset_ok, true, reached_firmware,
+        hardware_info_str, firmware_probed, Some(prime_frame_hex),
+    )
+}
+
+fn observation_verdict(answer: Option<&str>) -> Verdict {
+    match answer {
+        Some("yes") => Verdict::Pass,
+        Some("no") => Verdict::Fail,
+        _ => Verdict::Unverified,
+    }
+}
+
+fn prompt_prime_observations() -> Option<PrimeOperatorObservations> {
+    if !std::io::stdin().is_terminal() {
+        return None;
+    }
+    let ask = |prompt: &str| -> String {
+        eprint!("{prompt}");
+        let mut line = String::new();
+        let _ = std::io::stdin().read_line(&mut line);
+        line.trim().to_string()
+    };
+    Some(PrimeOperatorObservations {
+        left_pump_heard_or_felt: Some(ask("Left pump heard/felt? (yes/no/unsure): ")),
+        right_pump_heard_or_felt: Some(ask("Right pump heard/felt? (yes/no/unsure): ")),
+        water_movement_or_bubbles_observed: Some(ask("Water movement or bubbles observed? (yes/no/unsure): ")),
+        reservoir_level_dropped: Some(ask("Reservoir level dropped? (yes/no/unsure): ")),
+        reservoir_topped_up: Some(ask("Reservoir was topped up? (yes/no): ").eq_ignore_ascii_case("yes")),
+        leak_observed: Some(ask("Leak observed? (yes/no): ").eq_ignore_ascii_case("yes")),
+        abnormal_noise: Some(ask("Abnormal noise? (yes/no): ").eq_ignore_ascii_case("yes")),
+        burning_smell: Some(ask("Burning smell? (yes/no): ").eq_ignore_ascii_case("yes")),
+        notes: Some(ask("Notes (optional): ")),
+    })
+}
