+    }
+
+    // ---- configure_suspected_sensor_enable_high / restore_suspected_sensor_bit ----
+
+    fn mock_with_reg02_reg06(reg02: u8, reg06: u8) -> MockI2c {
+        let mut mock = MockI2c::always_succeed();
+        mock.reg_state.insert((RESET_EXPANDER_ADDR, REG_OUTPUT_PORT_0), reg02);
+        mock.reg_state.insert((RESET_EXPANDER_ADDR, REG_CONFIG_PORT_0), reg06);
+        mock
+    }
+
+    #[tokio::test]
+    async fn configure_suspected_sensor_enable_changes_only_bit_0() {
+        // reg02 = 0xFD (bit0 low, bit1 high i.e. Frozen released); reg06 = 0xFD (bit0 input, bit1
+        // output i.e. our proven narrow Frozen init) -- matches the real-hardware evidence in the
+        // spec: only bit 0 of 0x06 differs from upstream's 0xFC.
+        let mut mock = mock_with_reg02_reg06(0xFD, 0xFD);
+        let r = configure_suspected_sensor_enable_high(&mut mock).await.unwrap();
+        assert_eq!(r.reg02.target, 0xFD | SUSPECTED_SENSOR_ENABLE_BIT);
+        assert_eq!(r.reg06.target, 0xFD & !SUSPECTED_SENSOR_ENABLE_BIT);
+        assert!(r.reg02.only_bit0_changed);
+        assert!(r.reg06.only_bit0_changed);
+        assert!(r.fully_verified());
+        // bit 1 (Frozen's reset bit) must read identically before and after in both registers.
+        assert_eq!(r.reg02.original & FROZEN_RESET_BIT, r.reg02.target & FROZEN_RESET_BIT);
+        assert_eq!(r.reg06.original & FROZEN_RESET_BIT, r.reg06.target & FROZEN_RESET_BIT);
+    }
+
+    #[tokio::test]
+    async fn configure_suspected_sensor_enable_output_latch_set_before_direction_becomes_output() {
+        let mut mock = mock_with_reg02_reg06(0xFC, 0xFF);
+        configure_suspected_sensor_enable_high(&mut mock).await.unwrap();
+        let reg02_write_index = mock.writes.iter().position(|(_, reg, _)| *reg == REG_OUTPUT_PORT_0);
+        let reg06_write_index = mock.writes.iter().position(|(_, reg, _)| *reg == REG_CONFIG_PORT_0);
+        assert!(reg02_write_index.is_some() && reg06_write_index.is_some());
+        assert!(reg02_write_index < reg06_write_index, "0x02 must be written before 0x06: writes={:?}", mock.writes);
+    }
+
+    #[tokio::test]
+    async fn configure_suspected_sensor_enable_never_drives_bit_0_low() {
+        // Exercises `read_modify_write_bit0` directly (the same bit-computation logic
+        // `configure_suspected_sensor_enable_high` calls) rather than the full public function, so
+        // this 256-value sweep doesn't also pay `SUSPECTED_SENSOR_ENABLE_SETTLE` (500ms) 256 times
+        // over -- that wait is covered once, exactly, by
+        // `configure_suspected_sensor_enable_waits_the_settle_duration`.
+        for reg02_original in 0u8..=255 {
+            let mut mock = mock_with_reg02_reg06(reg02_original, 0xFF);
+            let r = read_modify_write_bit0(
+                &mut mock,
+                REG_OUTPUT_PORT_0,
+                "0x02",
+                |original| original | SUSPECTED_SENSOR_ENABLE_BIT,
+                "prepared",
+            )
+            .await
+            .unwrap();
+            assert_eq!(r.target & SUSPECTED_SENSOR_ENABLE_BIT, SUSPECTED_SENSOR_ENABLE_BIT, "original=0b{reg02_original:08b}");
+        }
+    }
+
+    #[tokio::test]
+    async fn configure_suspected_sensor_enable_never_writes_register_0x07() {
+        let mut mock = mock_with_reg02_reg06(0xFD, 0xFD);
+        configure_suspected_sensor_enable_high(&mut mock).await.unwrap();
+        for (_, reg, _) in &mock.writes {
+            assert_ne!(*reg, REG_CONFIG_PORT_1, "must never write register 0x07");
+        }
+        assert_eq!(mock.writes.len(), 2, "exactly two writes: 0x02 then 0x06");
+    }
+
+    #[tokio::test]
+    async fn configure_suspected_sensor_enable_never_uses_whole_register_constants() {
+        // For every possible original, the write must be a narrow function of that original --
+        // never one of the historical whole-register constants (0xFC/0xFF/0xFD) regardless of what
+        // was actually read. Uses `read_modify_write_bit0` directly -- see the sibling sweep test
+        // above for why.
+        for reg02_original in 0u8..=255 {
+            let mut mock = mock_with_reg02_reg06(reg02_original, 0xFF);
+            let r = read_modify_write_bit0(
+                &mut mock,
+                REG_OUTPUT_PORT_0,
+                "0x02",
+                |original| original | SUSPECTED_SENSOR_ENABLE_BIT,
+                "prepared",
+            )
+            .await
+            .unwrap();
+            assert_eq!(r.target, reg02_original | SUSPECTED_SENSOR_ENABLE_BIT, "original=0b{reg02_original:08b}");
+        }
+    }
+
+    #[tokio::test]
+    async fn configure_suspected_sensor_enable_waits_the_settle_duration() {
+        let mut mock = mock_with_reg02_reg06(0xFD, 0xFD);
+        let start = std::time::Instant::now();
+        configure_suspected_sensor_enable_high(&mut mock).await.unwrap();
+        assert!(start.elapsed() >= SUSPECTED_SENSOR_ENABLE_SETTLE);
+    }
+
+    #[tokio::test]
+    async fn readback_mismatch_is_detected_and_not_fully_verified() {
+        struct StaleReadback {
+            inner: MockI2c,
+            stale_value: u8,
+        }
+        impl I2cPort for StaleReadback {
+            fn read_byte(&mut self, addr: u8) -> Result<u8, I2cIoError> {
+                self.inner.read_byte(addr)
+            }
+            fn read_reg(&mut self, addr: u8, reg: u8) -> Result<u8, I2cIoError> {
+                if addr == RESET_EXPANDER_ADDR && reg == REG_OUTPUT_PORT_0 && !self.inner.writes.is_empty() {
+                    return Ok(self.stale_value);
+                }
+                self.inner.read_reg(addr, reg)
+            }
+            fn write_reg(&mut self, addr: u8, reg: u8, value: u8) -> Result<(), I2cIoError> {
+                self.inner.write_reg(addr, reg, value)
+            }
+        }
+        let mock = mock_with_reg02_reg06(0xFD, 0xFD);
+        let mut stale = StaleReadback { inner: mock, stale_value: 0x00 };
+        let r = configure_suspected_sensor_enable_high(&mut stale).await.unwrap();
+        assert!(!r.reg02.readback_matches);
+        assert!(!r.fully_verified());
+    }
+
+    #[tokio::test]
+    async fn restore_only_touches_bit_0_and_preserves_current_other_bits() {
+        // Simulate: enable ran against reg02=0xFD/reg06=0xFD (captured originals), then something
+        // else (or the enable itself) left the registers at reg02=0xFF/reg06=0xFC (bit1 also
+        // happens to differ now, e.g. Frozen was independently reset in between) -- restore must
+        // preserve that current bit-1 state, only forcing bit 0 back to the captured originals.
+        let mut mock = mock_with_reg02_reg06(0xFF, 0xFC);
+        let r = restore_suspected_sensor_bit(&mut mock, 0xFD, 0xFD).await.unwrap();
+        // captured original bit0 of 0xFD is 1 (low bit set)... 0xFD = 0b1111_1101, bit0 = 1.
+        assert_eq!(r.reg02.target, 0xFF & !SUSPECTED_SENSOR_ENABLE_BIT | (0xFDu8 & SUSPECTED_SENSOR_ENABLE_BIT));
+        assert_eq!(r.reg06.target, 0xFC & !SUSPECTED_SENSOR_ENABLE_BIT | (0xFDu8 & SUSPECTED_SENSOR_ENABLE_BIT));
+        // bit 1 of the current (not captured) values must be preserved exactly.
+        assert_eq!(r.reg02.target & FROZEN_RESET_BIT, 0xFF & FROZEN_RESET_BIT);
+        assert_eq!(r.reg06.target & FROZEN_RESET_BIT, 0xFC & FROZEN_RESET_BIT);
+        assert!(r.fully_verified());
+    }
+
+    #[tokio::test]
+    async fn restore_never_writes_register_0x07() {
+        let mut mock = mock_with_reg02_reg06(0xFF, 0xFF);
+        restore_suspected_sensor_bit(&mut mock, 0xFD, 0xFD).await.unwrap();
+        for (_, reg, _) in &mock.writes {
+            assert_ne!(*reg, REG_CONFIG_PORT_1);
+        }
+    }
+
+    #[tokio::test]
+    async fn restore_can_drive_bit_0_low_unlike_enable() {
+        // Restoring to an original where bit 0 was 0 (e.g. 0xFC) must actually clear it -- proving
+        // restore is not artificially prevented from ever going low (only `configure_suspected_
+        // sensor_enable_high` is one-directional).
+        let mut mock = mock_with_reg02_reg06(0xFF, 0xFF);
+        let r = restore_suspected_sensor_bit(&mut mock, 0xFC, 0xFC).await.unwrap();
+        assert_eq!(r.reg02.target & SUSPECTED_SENSOR_ENABLE_BIT, 0);
+        assert_eq!(r.reg06.target & SUSPECTED_SENSOR_ENABLE_BIT, 0);
+    }
+
+    // ---- configure_combined_narrow_subsystem_init ----
+
+    #[tokio::test]
+    async fn combined_init_matches_the_hub_evidence_in_the_spec() {
+        // reg02 = 0xFD (bit0 low, bit1 high), reg06 = 0xFF (both inputs) -- matches "Observed
+        // expander state before the experiment" in the spec.
+        let mut mock = mock_with_reg02_reg06(0xFD, 0xFF);
+        let r = configure_combined_narrow_subsystem_init(&mut mock).await.unwrap();
+        assert_eq!(r.reg02_assert.target, 0xFD | PORT0_COMBINED_MASK); // 0xFF
+        assert_eq!(r.reg06_config.target, 0xFF & !PORT0_COMBINED_MASK); // 0xFC
+        assert_eq!(r.reg02_release.target, 0xFF & !FROZEN_RESET_BIT); // 0xFD: bit0 high, bit1 low
+        assert!(r.fully_verified());
+        // Expected final state per the spec: reg 0x02 = 0xFD, reg 0x06 = 0xFC.
+        assert_eq!(r.reg02_release.readback, 0xFD);
+        assert_eq!(r.reg06_config.readback, 0xFC);
+    }
+
+    #[tokio::test]
+    async fn combined_init_writes_0x02_before_0x06_and_never_touches_0x07_or_0x03() {
+        let mut mock = mock_with_reg02_reg06(0xFD, 0xFF);
+        configure_combined_narrow_subsystem_init(&mut mock).await.unwrap();
+        assert_eq!(mock.writes.len(), 3, "exactly three writes: 0x02 assert, 0x06 config, 0x02 release");
+        assert_eq!(mock.writes[0].1, REG_OUTPUT_PORT_0);
+        assert_eq!(mock.writes[1].1, REG_CONFIG_PORT_0);
+        assert_eq!(mock.writes[2].1, REG_OUTPUT_PORT_0);
+        for (_, reg, _) in &mock.writes {
+            assert_ne!(*reg, REG_CONFIG_PORT_1, "must never write register 0x07");
+            assert_ne!(*reg, 0x03, "must never write register 0x03");
+        }
+    }
+
+    #[tokio::test]
+    async fn combined_init_waits_the_settle_duration() {
+        let mut mock = mock_with_reg02_reg06(0xFD, 0xFF);
+        let start = std::time::Instant::now();
+        configure_combined_narrow_subsystem_init(&mut mock).await.unwrap();
+        assert!(start.elapsed() >= PULSE_SETTLE);
+    }
+
+    #[tokio::test]
+    async fn combined_init_bit0_never_reads_low_in_either_0x02_write() {
+        // Sweep via `read_modify_write_combined` directly (no PULSE_SETTLE sleep per iteration --
+        // see the equivalent single-bit sweep tests above for why this matters at 256 iterations).
+        for original in 0u8..=255 {
+            let mut mock = mock_with_reg02_reg06(original, 0xFF);
+            let assert_step = read_modify_write_combined(&mut mock, REG_OUTPUT_PORT_0, "0x02", |o| o | PORT0_COMBINED_MASK, "prepared")
+                .await
+                .unwrap();
+            assert_eq!(assert_step.target & SUSPECTED_SENSOR_ENABLE_BIT, SUSPECTED_SENSOR_ENABLE_BIT, "original=0b{original:08b}");
+            let release_step = read_modify_write_combined(&mut mock, REG_OUTPUT_PORT_0, "0x02", |o| o & !FROZEN_RESET_BIT, "released")
+                .await
+                .unwrap();
+            assert_eq!(release_step.target & SUSPECTED_SENSOR_ENABLE_BIT, SUSPECTED_SENSOR_ENABLE_BIT, "original=0b{original:08b}");
+            assert_eq!(release_step.target & FROZEN_RESET_BIT, 0, "bit 1 must be low after release; original=0b{original:08b}");
+        }
+    }
+
+    #[tokio::test]
+    async fn combined_init_only_bits_0_and_1_ever_change_on_either_register() {
+        for original in 0u8..=255 {
+            let mut mock = mock_with_reg02_reg06(original, original);
+            let step02 = read_modify_write_combined(&mut mock, REG_OUTPUT_PORT_0, "0x02", |o| o | PORT0_COMBINED_MASK, "prepared")
+                .await
+                .unwrap();
+            assert!(step02.only_combined_bits_changed, "original=0b{original:08b}");
+            assert_eq!(step02.target & !PORT0_COMBINED_MASK, original & !PORT0_COMBINED_MASK, "original=0b{original:08b}");
+
+            let step06 = read_modify_write_combined(&mut mock, REG_CONFIG_PORT_0, "0x06", |o| o & !PORT0_COMBINED_MASK, "configured")
+                .await
+                .unwrap();
+            assert!(step06.only_combined_bits_changed, "original=0b{original:08b}");
+            assert_eq!(step06.target & !PORT0_COMBINED_MASK, original & !PORT0_COMBINED_MASK, "original=0b{original:08b}");
+        }
+    }
+
+    #[tokio::test]
+    async fn combined_init_readback_mismatch_is_not_fully_verified() {
+        struct StaleReg02 {
+            inner: MockI2c,
+            stale_value: u8,
+        }
+        impl I2cPort for StaleReg02 {
+            fn read_byte(&mut self, addr: u8) -> Result<u8, I2cIoError> {
+                self.inner.read_byte(addr)
+            }
+            fn read_reg(&mut self, addr: u8, reg: u8) -> Result<u8, I2cIoError> {
+                if addr == RESET_EXPANDER_ADDR && reg == REG_OUTPUT_PORT_0 && !self.inner.writes.is_empty() {
+                    return Ok(self.stale_value);
+                }
+                self.inner.read_reg(addr, reg)
+            }
+            fn write_reg(&mut self, addr: u8, reg: u8, value: u8) -> Result<(), I2cIoError> {
+                self.inner.write_reg(addr, reg, value)
+            }
+        }
+        let mock = mock_with_reg02_reg06(0xFD, 0xFF);
+        let mut stale = StaleReg02 { inner: mock, stale_value: 0x00 };
+        let r = configure_combined_narrow_subsystem_init(&mut stale).await.unwrap();
+        assert!(!r.reg02_assert.readback_matches);
+        assert!(!r.fully_verified());
+    }
+}
