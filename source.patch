+/// Documented reference constant, cross-checked against `cli.rs`'s own `--sensor-port` default by
+/// `tests::default_sensor_port_is_dev_ttys2`; not read at runtime (the default lives in the
+/// `clap` attribute, same pattern as `safety::DEFAULT_COOL_DELTA_CENTIDEG`).
+#[allow(dead_code)]
+pub const DEFAULT_SENSOR_PORT: &str = "/dev/ttyS2";
+pub const FIRMWARE_BAUD: u32 = 115200;
+pub const BOOTLOADER_BAUD: u32 = 38400;
+
+pub async fn run(args: &SensorProbeArgs) -> (SensorProbeReport, u8) {
+    let mode = match determine_mode(args) {
+        Ok(m) => m,
+        Err(e) => {
+            log::error!("{e}");
+            return (empty_report(args, ProbeMode::Passive, args.dry_run, "invalid_arguments"), 2);
+        }
+    };
+
+    if args.restore_suspected_sensor_line && !args.enable_suspected_sensor_line {
+        let msg = "--restore-suspected-sensor-line requires --enable-suspected-sensor-line in the same invocation (there is no captured original state to restore to otherwise)";
+        log::error!("{msg}");
+        return (empty_report(args, mode, args.dry_run, "invalid_arguments"), 2);
+    }
+
+    if args.combined_narrow_subsystem_init && (args.enable_suspected_sensor_line || args.restore_suspected_sensor_line || args.audit_expander) {
+        let msg = "--combined-narrow-subsystem-init has its own fixed expander sequence and audit; it cannot be combined with --enable-suspected-sensor-line, --restore-suspected-sensor-line, or --audit-expander";
+        log::error!("{msg}");
+        return (empty_report(args, mode, args.dry_run, "invalid_arguments"), 2);
+    }
+
+    let (mut report, _code) = if args.combined_narrow_subsystem_init {
+        if args.dry_run {
+            log::warn!("--dry-run: no real UART or I2C access; using mocked Sensor/Frozen devices");
+        } else if let Some(early) = refuse_if_owned(args) {
+            return early;
+        }
+        run_combined_narrow_subsystem_init(args).await
+    } else if args.dry_run {
+        log::warn!("--dry-run: no real UART or I2C access; using a mocked Sensor device");
+        if args.enable_suspected_sensor_line {
+            run_dry_line_enable(args, mode).await
+        } else {
+            run_dry(args, mode).await
+        }
+    } else {
+        if let Some(early) = refuse_if_owned(args) {
+            return early;
+        }
+        if args.enable_suspected_sensor_line {
+            run_real_line_enable(args, mode).await
+        } else {
+            match mode {
+                ProbeMode::Passive => run_real_passive(args).await,
+                ProbeMode::Ping => run_real_ping(args).await,
+                ProbeMode::Discover => run_real_discover(args).await,
+            }
+        }
+    };
+
+    if args.audit_expander && !args.combined_narrow_subsystem_init {
+        // `write_count` is always 0: `audit_expander` never calls `write_reg` (see its own doc
+        // comment and the `expander_audit_never_writes_any_register` test) -- computed from the
+        // mock's own write log rather than hardcoded, so a future regression would fail loudly.
+        let (audit, write_count) = if args.dry_run {
+            let mut mock = MockI2c::always_succeed();
+            let a = audit_expander(&mut mock);
+            (a, mock.writes.len() as u32)
+        } else {
+            match RealI2c::open(&args.i2c_device) {
+                Ok(mut dev) => (audit_expander(&mut dev), 0),
+                Err(e) => {
+                    log::error!("failed to open I2C device {} for --audit-expander: {e}", args.i2c_device);
+                    (ExpanderAudit::default(), 0)
+                }
+            }
+        };
+        report.i2c_reads += audit.readings.len() as u32;
+        report.i2c_writes += write_count;
+        report.expander_audit = Some(audit);
+    }
+
+    if let Some(path) = &args.json_output
+        && let Err(e) = report.write_json(path)
+    {
+        log::error!("failed to write JSON output to {path}: {e}");
+    }
+    if let Some(path) = &args.csv_output
+        && let Err(e) = report.write_csv(path)
+    {
+        log::error!("failed to write CSV output to {path}: {e}");
+    }
+    report.print_table();
+    let code = report.exit_code;
+    (report, code)
+}
+
+fn determine_mode(args: &SensorProbeArgs) -> Result<ProbeMode, String> {
+    let selected = [args.passive, args.ping, args.discover].iter().filter(|&&b| b).count();
+    if selected > 1 {
+        return Err("--passive, --ping, and --discover are mutually exclusive".to_string());
+    }
+    if args.ping {
+        Ok(ProbeMode::Ping)
+    } else if args.discover {
+        Ok(ProbeMode::Discover)
+    } else {
+        Ok(ProbeMode::Passive) // default; also covers an explicit --passive
+    }
+}
+
+fn refuse_if_owned(args: &SensorProbeArgs) -> Option<(SensorProbeReport, u8)> {
+    if ownership::device_exists(&args.sensor_port) && ownership::device_is_open_elsewhere(&args.sensor_port) {
+        log::error!("refusing to run: {} appears to be open in another process", args.sensor_port);
+        return Some((empty_report(args, ProbeMode::Passive, false, "sensor_port_open_elsewhere"), 40));
+    }
+    if (args.audit_expander || args.enable_suspected_sensor_line || args.combined_narrow_subsystem_init)
+        && ownership::device_exists(&args.i2c_device)
+        && ownership::device_is_open_elsewhere(&args.i2c_device)
+    {
+        log::error!("refusing to run: {} appears to be open in another process", args.i2c_device);
+        return Some((empty_report(args, ProbeMode::Passive, false, "i2c_device_open_elsewhere"), 40));
+    }
+    if args.combined_narrow_subsystem_init
+        && ownership::device_exists(&args.frozen_port)
+        && ownership::device_is_open_elsewhere(&args.frozen_port)
+    {
+        log::error!("refusing to run: {} appears to be open in another process", args.frozen_port);
+        return Some((empty_report(args, ProbeMode::Passive, false, "frozen_port_open_elsewhere"), 40));
+    }
+    None
+}
