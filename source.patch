+    /// A fake device that answers Ping/JumpToFirmware/SetTargetTemperature and pushes a plausible
+    /// unsolicited TemperatureUpdate for `pushes_before_disconnect` requests, then drops its side
+    /// of the connection entirely -- unlike "going silent" (the connection stays open, so the
+    /// client eventually times out to `TelemetryStale`), this simulates the link actually closing
+    /// (`PacketOutcome::Closed` -> `StopReason::TelemetryLost`), i.e. genuine communication loss.
+    fn spawn_device_that_disconnects_during_active_phase(
+        mut device_side: tokio::io::DuplexStream,
+        pushes_before_disconnect: usize,
+    ) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut pushes_remaining = pushes_before_disconnect;
+            let mut count: u8 = 0;
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        let response = match opcode {
+                            0x01 => Some(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x41 => {
+                                if pushes_remaining == 0 {
+                                    return; // drop device_side: the client sees the link close
+                                }
+                                pushes_remaining -= 1;
+                                count = count.wrapping_add(1);
+                                Some(opensleep::common::codec::command(vec![
+                                    0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, count,
+                                ]))
+                            }
+                            0x40 if payload.len() == 5 => Some(opensleep::common::codec::command(vec![
+                                0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                            ])),
+                            _ => None,
+                        };
+                        if let Some(resp) = response
+                            && device_side.write_all(&resp).await.is_err()
+                        {
+                            break;
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
