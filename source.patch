+fn empty_report(args: &SensorProbeArgs, mode: ProbeMode, dry_run: bool, result: &str) -> SensorProbeReport {
+    let mut r = base_report(args, mode, dry_run);
+    r.overall_result = result.to_string();
+    r.exit_code = exit_code_for(result);
+    r
+}
+
+fn exit_code_for(result: &str) -> u8 {
+    match result {
+        "communicating_firmware"
+        | "communicating_bootloader"
+        | "unsolicited_traffic_only"
+        | "sensor_alive_after_line_enable"
+        | "sensor_bootloader_after_line_enable"
+        | "spontaneous_sensor_traffic_after_line_enable"
+        | "sensor_firmware_alive_after_combined_init"
+        | "sensor_bootloader_alive_after_combined_init"
+        | "sensor_rx_activity_after_combined_init" => 0,
+        "uart_silent" | "still_silent_after_line_enable" | "sensor_still_silent_after_combined_init" | "frozen_alive_sensor_silent" => 10,
+        "undecodable_traffic" => 11,
+        "unresolved" => 12,
+        "expander_verification_failed" => 13,
+        _ => 20,
+    }
+}
+
+fn finish(args: &SensorProbeArgs, mode: ProbeMode, dry_run: bool, outcome: ModeOutcome, audit: SensorAudit) -> (SensorProbeReport, u8) {
+    let mut r = base_report(args, mode, dry_run);
+    r.firmware_baud_opened = outcome.firmware_baud_opened;
+    r.bootloader_baud_opened = outcome.bootloader_baud_opened;
+
+    if let Some(t) = &outcome.passive_115200 {
+        r.passive_bytes_115200 = t.bytes_received;
+    }
+    if let Some(t) = &outcome.passive_38400 {
+        r.passive_bytes_38400 = t.bytes_received;
+    }
+
+    let mut all_types: std::collections::BTreeSet<String> = std::collections::BTreeSet::new();
+    let mut malformed = 0u64;
+    let mut cap_samples = 0u64;
+    let mut piezo_samples = 0u64;
+    let mut temp_samples = 0u64;
+    for t in [&outcome.passive_115200, &outcome.passive_38400, &outcome.active_probe].into_iter().flatten() {
+        all_types.extend(t.packet_types_observed.keys().cloned());
+        malformed += t.malformed_frames;
+        cap_samples += t.capacitance_samples;
+        piezo_samples += t.piezo_samples;
+        temp_samples += t.temperature_samples;
+    }
+    r.packet_types_observed = all_types.into_iter().collect();
+    r.malformed_packets = malformed;
+    r.capacitance_samples = cap_samples;
+    r.piezo_samples = piezo_samples;
+    r.temperature_samples = temp_samples;
+
+    r.passive_115200 = outcome.passive_115200;
+    r.passive_38400 = outcome.passive_38400;
+    r.active_probe = outcome.active_probe;
+    r.firmware_ping_response = outcome.firmware_ping_response;
+    r.bootloader_ping_response = outcome.bootloader_ping_response;
+    r.jump_to_firmware_sent = outcome.jump_to_firmware_sent;
+    r.firmware_mode_confirmed = outcome.firmware_mode_confirmed;
+    r.hardware_info = outcome.hardware_info;
+    r.firmware_info = outcome.firmware_info;
+
+    r.sensor_uart_writes = audit.sensor_uart_writes;
+    r.actuator_commands_sent = audit.actuator_commands_sent;
+
+    r.overall_result = outcome.overall_result.clone();
+    r.exit_code = exit_code_for(&outcome.overall_result);
+    let code = r.exit_code;
+    (r, code)
+}
+
+// ---------------------------------------------------------------------------------------------
+// EXPERIMENTAL: --enable-suspected-sensor-line / --restore-suspected-sensor-line
+//
+// Tests the hypothesis that port-0 bit 0 of the PCAL6416A expander is a Sensor enable/
+// reset-release/power-enable line, in the narrowest possible way: configure it as an output,
+// driven HIGH, and nothing else -- never a pulse, never LOW, never bit 1, never register 0x07.
+// See i2c.rs's `SUSPECTED_SENSOR_ENABLE_BIT` doc comment for the hardware evidence, and SAFETY.md
+// for the full experimental design.
+// ---------------------------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, Default)]
+struct LineEnableOutcome {
+    verified: bool,
+    reg02_original: u8,
+    reg02_after_prepare: u8,
+    reg02_readback: u8,
+    reg02_changed_mask: u8,
+    reg06_original: u8,
+    reg06_after_config: u8,
+    reg06_readback: u8,
+    reg06_changed_mask: u8,
+    port0_bit0_output_latch_high: bool,
+    port0_bit0_configured_as_output: bool,
+    unrelated_bits_preserved: bool,
+}
+
+/// Prints the required prominent EXPERIMENTAL message, then performs the narrow bit-0 enable
+/// sequence (`i2c::configure_suspected_sensor_enable_high`) and translates its result into the
+/// report-shaped [`LineEnableOutcome`]. Never itself decides whether to proceed to Sensor UART
+/// probing -- callers must check `verified` first (see [`LineEnableOutcome::verified`]'s doc
+/// comment at its use sites: `--abort before Sensor probing if any other bit differs`).
+async fn apply_suspected_sensor_line_enable<P: I2cPort>(dev: &mut P) -> LineEnableOutcome {
+    log::warn!("EXPERIMENTAL: configuring PCAL6416A port-0 bit 0 as output-high.");
+    log::warn!("No pulse will be generated and no other expander bit will be modified.");
+    match configure_suspected_sensor_enable_high(dev).await {
+        Ok(r) => LineEnableOutcome {
+            verified: r.fully_verified(),
+            reg02_original: r.reg02.original,
+            reg02_after_prepare: r.reg02.target,
+            reg02_readback: r.reg02.readback,
+            reg02_changed_mask: r.reg02.changed_mask,
+            reg06_original: r.reg06.original,
+            reg06_after_config: r.reg06.target,
+            reg06_readback: r.reg06.readback,
+            reg06_changed_mask: r.reg06.changed_mask,
+            port0_bit0_output_latch_high: (r.reg02.readback & crate::i2c::SUSPECTED_SENSOR_ENABLE_BIT) != 0,
+            port0_bit0_configured_as_output: (r.reg06.readback & crate::i2c::SUSPECTED_SENSOR_ENABLE_BIT) == 0,
+            unrelated_bits_preserved: r.reg02.only_bit0_changed && r.reg06.only_bit0_changed,
+        },
+        Err(e) => {
+            log::error!("failed to configure suspected Sensor enable line: {e}");
+            LineEnableOutcome::default()
+        }
+    }
+}
+
+/// Restores only bit 0 of 0x02/0x06 to `enable`'s own captured original values, preserving every
+/// other bit as it exists at restore time. Returns `(final_0x02, final_0x06)`; on I2C failure,
+/// falls back to reporting the (unrestored) enabled state rather than guessing.
+async fn apply_suspected_sensor_line_restore<P: I2cPort>(dev: &mut P, enable: &LineEnableOutcome) -> (u8, u8) {
+    match restore_suspected_sensor_bit(dev, enable.reg02_original, enable.reg06_original).await {
+        Ok(r) => {
+            log::info!("restored suspected Sensor enable line bit 0 to this invocation's captured original state");
+            (r.reg02.readback, r.reg06.readback)
+        }
+        Err(e) => {
+            log::error!("failed to restore suspected Sensor enable line: {e}");
+            (enable.reg02_readback, enable.reg06_readback)
+        }
+    }
+}
+
+/// Listens for `duration`, decoding through the same `PacketCodec` as [`listen_and_tally`], but
+/// additionally polls `capture` (in `POLL`-sized slices) to record the elapsed time since
+/// `enable_completed_at` at the first raw byte and the first decoded packet -- the evidence this
+/// experiment is specifically looking for (spontaneous Sensor boot traffic shortly after the bit-0
+/// direction change). Approximate to within one `POLL` interval, not sub-millisecond hardware
+/// timing, which is adequate for this diagnostic's purpose.
+async fn listen_with_enable_timing<T: AsyncRead + AsyncWrite + Unpin>(
+    link: &mut SensorLink<T>,
+    capture: &RawIoCapture,
+    duration: Duration,
+    enable_completed_at: tokio::time::Instant,
+    first_rx_ms: &mut Option<u64>,
+    first_decoded_ms: &mut Option<u64>,
+) -> PacketTally {
+    const POLL: Duration = Duration::from_millis(50);
+    let mut tally = PacketTally::default();
+    let deadline = tokio::time::Instant::now() + duration;
+    loop {
+        let now = tokio::time::Instant::now();
+        if now >= deadline {
+            break;
+        }
+        let wait = POLL.min(deadline - now);
+        match link.recv(wait).await {
+            Ok(PacketOutcome::Received(pkt)) => {
+                if first_decoded_ms.is_none() {
+                    *first_decoded_ms = Some(tokio::time::Instant::now().saturating_duration_since(enable_completed_at).as_millis() as u64);
+                }
+                tally.record(&pkt);
+            }
+            Ok(PacketOutcome::TimedOut) => {}
+            Ok(PacketOutcome::Closed) | Err(_) => break,
+        }
+        if first_rx_ms.is_none() {
+            let (bytes, _) = tally_raw_capture(capture);
+            if bytes > 0 {
+                *first_rx_ms = Some(tokio::time::Instant::now().saturating_duration_since(enable_completed_at).as_millis() as u64);
+            }
+        }
+    }
+    tally
+}
+
+/// Assembles the final report for an `--enable-suspected-sensor-line` run. Uses its own
+/// `overall_result` vocabulary (`sensor_alive_after_line_enable`,
+/// `sensor_bootloader_after_line_enable`, `spontaneous_sensor_traffic_after_line_enable`,
+/// `still_silent_after_line_enable`, `expander_verification_failed`) instead of `finish`'s, per
+/// item 9 of this feature's spec. Never called for a plain (non-enable) run -- `finish` above
+/// keeps handling those exactly as before.
+#[allow(clippy::too_many_arguments)]
+fn finish_line_enable(
+    args: &SensorProbeArgs,
+    mode: ProbeMode,
+    dry_run: bool,
+    enable: LineEnableOutcome,
+    restore_final: Option<(u8, u8)>,
+    probe: ModeOutcome,
+    audit: SensorAudit,
+    passive_rx_before_enable: u64,
+    passive_rx_after_enable: u64,
+    first_rx_after_enable_ms: Option<u64>,
+    first_decoded_packet_after_enable_ms: Option<u64>,
+    i2c_reads: u32,
+    i2c_writes: u32,
+) -> (SensorProbeReport, u8) {
+    let mut r = base_report(args, mode, dry_run);
+
+    r.reg_0x02_original = Some(enable.reg02_original);
+    r.reg_0x02_after_prepare = Some(enable.reg02_after_prepare);
+    r.reg_0x02_readback = Some(enable.reg02_readback);
+    r.reg_0x02_changed_mask = Some(enable.reg02_changed_mask);
+    r.reg_0x06_original = Some(enable.reg06_original);
+    r.reg_0x06_after_config = Some(enable.reg06_after_config);
+    r.reg_0x06_readback = Some(enable.reg06_readback);
+    r.reg_0x06_changed_mask = Some(enable.reg06_changed_mask);
+    r.port0_bit0_output_latch_high = enable.port0_bit0_output_latch_high;
+    r.port0_bit0_configured_as_output = enable.port0_bit0_configured_as_output;
+    r.unrelated_bits_preserved = enable.unrelated_bits_preserved;
+
+    let (final02, final06) = restore_final.unwrap_or((enable.reg02_readback, enable.reg06_readback));
+    r.reg_0x02_final = Some(final02);
+    r.reg_0x06_final = Some(final06);
+
+    r.passive_rx_before_enable = passive_rx_before_enable;
+    r.passive_rx_after_enable = passive_rx_after_enable;
+    r.first_rx_after_enable_ms = first_rx_after_enable_ms;
+    r.first_decoded_packet_after_enable_ms = first_decoded_packet_after_enable_ms;
+
+    r.firmware_baud_opened = probe.firmware_baud_opened;
+    r.bootloader_baud_opened = probe.bootloader_baud_opened;
+    r.firmware_ping_response = probe.firmware_ping_response;
+    r.bootloader_ping_response = probe.bootloader_ping_response;
+    r.jump_to_firmware_sent = probe.jump_to_firmware_sent;
+    r.firmware_mode_confirmed = probe.firmware_mode_confirmed;
+    r.hardware_info = probe.hardware_info;
+    r.firmware_info = probe.firmware_info;
+    // Aggregates across every tally this mode could have populated (passive's two per-baud tallies,
+    // or discover's single post-communication observe tally) -- mirrors `finish`'s own aggregation
+    // above so `--enable-suspected-sensor-line` reports packet/telemetry stats exactly as
+    // completely as a plain run would.
+    let mut all_types: std::collections::BTreeSet<String> = std::collections::BTreeSet::new();
+    let mut malformed = 0u64;
+    let mut cap_samples = 0u64;
+    let mut piezo_samples = 0u64;
+    let mut temp_samples = 0u64;
+    if let Some(t) = &probe.passive_115200 {
+        r.passive_bytes_115200 = t.bytes_received;
+    }
+    if let Some(t) = &probe.passive_38400 {
+        r.passive_bytes_38400 = t.bytes_received;
+    }
+    for t in [&probe.passive_115200, &probe.passive_38400, &probe.active_probe].into_iter().flatten() {
+        all_types.extend(t.packet_types_observed.keys().cloned());
+        malformed += t.malformed_frames;
+        cap_samples += t.capacitance_samples;
+        piezo_samples += t.piezo_samples;
+        temp_samples += t.temperature_samples;
+    }
+    r.packet_types_observed = all_types.into_iter().collect();
+    r.malformed_packets = malformed;
+    r.capacitance_samples = cap_samples;
+    r.piezo_samples = piezo_samples;
+    r.temperature_samples = temp_samples;
+    r.active_probe = probe.active_probe;
+    r.passive_115200 = probe.passive_115200;
+    r.passive_38400 = probe.passive_38400;
+
+    r.sensor_uart_writes = audit.sensor_uart_writes;
+    r.actuator_commands_sent = audit.actuator_commands_sent;
+    r.i2c_reads = i2c_reads;
+    r.i2c_writes = i2c_writes;
+
+    let bootloader_confirmed = probe.bootloader_ping_response == Some(true);
+    let passive_traffic_seen = passive_rx_after_enable > 0;
+
+    r.overall_result = if !enable.verified {
+        "expander_verification_failed"
+    } else if r.firmware_mode_confirmed {
+        "sensor_alive_after_line_enable"
+    } else if bootloader_confirmed {
+        "sensor_bootloader_after_line_enable"
+    } else if mode == ProbeMode::Passive && passive_traffic_seen {
+        "spontaneous_sensor_traffic_after_line_enable"
+    } else {
+        "still_silent_after_line_enable"
+    }
+    .to_string();
+    r.exit_code = exit_code_for(&r.overall_result);
+    let code = r.exit_code;
+    (r, code)
+}
+
+/// `--ping --enable-suspected-sensor-line`: after enabling the line, behaves exactly like plain
+/// `--ping` (firmware baud first, then bootloader baud) -- the spec does not describe a different
+/// sequence for this combination, unlike `--passive`/`--discover` (sections 5/6). A small,
+/// deliberate duplication of `run_real_ping`'s own logic rather than reusing it directly: that
+/// function builds and returns a full report via `finish`, not a reusable [`ModeOutcome`].
+async fn line_enable_ping_probe<T: AsyncRead + AsyncWrite + Unpin, O>(audit: &mut SensorAudit, mut open: O) -> ModeOutcome
+where
+    O: FnMut(u32) -> Result<SensorLink<T>, String>,
+{
+    let mut outcome = ModeOutcome::default();
+    match open(FIRMWARE_BAUD) {
+        Ok(mut link) => {
+            outcome.firmware_baud_opened = true;
+            let r = try_ping(&mut link, audit, ProbeMode::Ping, false, 3).await;
+            outcome.firmware_ping_response = Some(matches!(r, Some(true)));
+        }
+        Err(e) => log::error!("failed to open Sensor UART @ {FIRMWARE_BAUD}: {e}"),
+    }
+    if outcome.firmware_ping_response != Some(true) {
+        match open(BOOTLOADER_BAUD) {
+            Ok(mut link) => {
+                outcome.bootloader_baud_opened = true;
+                let r = try_ping(&mut link, audit, ProbeMode::Ping, false, 3).await;
+                outcome.bootloader_ping_response = Some(matches!(r, Some(false)));
+            }
+            Err(e) => log::error!("failed to open Sensor UART @ {BOOTLOADER_BAUD}: {e}"),
+        }
+    }
+    outcome.firmware_mode_confirmed = outcome.firmware_ping_response == Some(true);
+    outcome
+}
+
+/// `--discover --enable-suspected-sensor-line` (item 5 of this feature's spec): mirrors upstream
+/// ordering exactly -- **bootloader first** (unlike plain `--discover`, which tries firmware
+/// first), always followed by a firmware attempt regardless of the bootloader step's outcome (so
+/// this experimental flow gathers maximum diagnostic evidence rather than upstream's own
+/// production-oriented early return). Each stage listens passively for 1 second before
+/// transmitting anything, recording spontaneous traffic; unsolicited packets never consume the
+/// Ping retry budget (`try_ping` already guarantees this via `send_and_wait_for`).
+async fn line_enable_discover_probe<T: AsyncRead + AsyncWrite + Unpin, O>(audit: &mut SensorAudit, args: &SensorProbeArgs, mut open: O) -> ModeOutcome
+where
+    O: FnMut(u32) -> Result<SensorLink<T>, String>,
+{
+    let mut outcome = ModeOutcome::default();
+
+    // Step A: bootloader first.
+    if let Ok(mut link) = open(BOOTLOADER_BAUD) {
+        outcome.bootloader_baud_opened = true;
+        let _pre = listen_and_tally(&mut link, Duration::from_secs(1)).await;
+        let r = try_ping(&mut link, audit, ProbeMode::Discover, false, 3).await;
+        let bootloader_confirmed = r == Some(false);
+        outcome.bootloader_ping_response = Some(bootloader_confirmed);
+        if bootloader_confirmed {
+            match link.send(audit, ProbeMode::Discover, SensorProbeAction::JumpToFirmware, false, Duration::from_secs(1)).await {
+                Ok(_) => outcome.jump_to_firmware_sent = true,
+                Err(e) => log::error!("JumpToFirmware failed: {e}"),
+            }
+            let _ = listen_and_tally(&mut link, Duration::from_secs(2)).await; // wait for mode transition
+        }
+    } else {
+        log::error!("failed to open Sensor UART @ {BOOTLOADER_BAUD}");
+    }
+    // `link` (if any) drops here -- UART closed before Step B reopens it.
+
+    // Step B: firmware -- always attempted, regardless of Step A's outcome.
+    if let Ok(mut link) = open(FIRMWARE_BAUD) {
+        outcome.firmware_baud_opened = true;
+        let _pre = listen_and_tally(&mut link, Duration::from_secs(1)).await;
+        let r = try_ping(&mut link, audit, ProbeMode::Discover, false, 3).await;
+        outcome.firmware_ping_response = Some(matches!(r, Some(true)));
+        outcome.firmware_mode_confirmed = outcome.firmware_ping_response == Some(true);
+
+        if outcome.firmware_mode_confirmed {
+            if args.query_info {
+                if let Some(SensorPacket::HardwareInfo(hw)) = send_and_wait_for(
+                    &mut link,
+                    audit,
+                    ProbeMode::Discover,
+                    SensorProbeAction::GetHardwareInfo,
+                    true,
+                    Duration::from_secs(1),
+                    |p| matches!(p, SensorPacket::HardwareInfo(_)),
+                )
+                .await
+                {
+                    outcome.hardware_info = Some(hw.to_string());
+                }
+                if let Some(SensorPacket::GetFirmware(v)) = send_and_wait_for(
+                    &mut link,
+                    audit,
+                    ProbeMode::Discover,
+                    SensorProbeAction::GetFirmwareHash,
+                    true,
+                    Duration::from_secs(1),
+                    |p| matches!(p, SensorPacket::GetFirmware(_)),
+                )
+                .await
+                {
+                    outcome.firmware_info = Some(format!("firmware hash response value: {v}"));
+                }
+            }
+            let observe = listen_and_tally(&mut link, Duration::from_secs(args.observe_seconds)).await;
+            outcome.active_probe = Some(observe.finalize(0));
+        }
+    } else {
+        log::error!("failed to open Sensor UART @ {FIRMWARE_BAUD}");
+    }
+
+    outcome
+}
+
+/// `--passive --enable-suspected-sensor-line` (item 6): zero Sensor UART writes, both before and
+/// after enabling the line. Listens briefly before enabling (`passive_rx_before_enable`), then at
+/// both bauds for `--listen-seconds` after enabling, tracking the elapsed time to the first raw
+/// byte and first decoded packet relative to when the enable sequence completed -- the strongest
+/// possible evidence of a causal link between the bit-0 change and any Sensor activity.
+async fn line_enable_passive_probe<T: AsyncRead + AsyncWrite + Unpin, O>(
+    args: &SensorProbeArgs,
+    enable_completed_at: tokio::time::Instant,
+    passive_rx_after_enable: &mut u64,
+    first_rx_ms: &mut Option<u64>,
+    first_decoded_ms: &mut Option<u64>,
+    mut open: O,
+) -> ModeOutcome
+where
+    O: FnMut(u32) -> Result<(SensorLink<T>, RawIoCapture), String>,
+{
+    let mut outcome = ModeOutcome::default();
+    let per_baud = Duration::from_secs(args.listen_seconds.max(1));
+
+    if let Ok((mut link, capture)) = open(FIRMWARE_BAUD) {
+        outcome.firmware_baud_opened = true;
+        let tally = listen_with_enable_timing(&mut link, &capture, per_baud, enable_completed_at, first_rx_ms, first_decoded_ms).await;
+        let (bytes, found) = tally_raw_capture(&capture);
+        *passive_rx_after_enable += bytes;
+        let mut json = tally.finalize(found);
+        json.bytes_received = bytes;
+        outcome.passive_115200 = Some(json);
+    } else {
+        log::error!("failed to open Sensor UART @ {FIRMWARE_BAUD}");
+    }
+
+    if let Ok((mut link, capture)) = open(BOOTLOADER_BAUD) {
+        outcome.bootloader_baud_opened = true;
+        let tally = listen_with_enable_timing(&mut link, &capture, per_baud, enable_completed_at, first_rx_ms, first_decoded_ms).await;
+        let (bytes, found) = tally_raw_capture(&capture);
+        *passive_rx_after_enable += bytes;
+        let mut json = tally.finalize(found);
+        json.bytes_received = bytes;
+        outcome.passive_38400 = Some(json);
+    } else {
+        log::error!("failed to open Sensor UART @ {BOOTLOADER_BAUD}");
+    }
+
+    outcome
+}
+
+async fn run_real_line_enable(args: &SensorProbeArgs, mode: ProbeMode) -> (SensorProbeReport, u8) {
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("failed to open I2C device {} for --enable-suspected-sensor-line: {e}", args.i2c_device);
+            return finish_line_enable(args, mode, false, LineEnableOutcome::default(), None, ModeOutcome::default(), SensorAudit::new(), 0, 0, None, None, 0, 0);
+        }
+    };
+
+    // A short pre-enable listen establishes a baseline: is there already traffic on the line
+    // before anything changes? Only meaningful/used for `--passive`; harmless (and cheap) to skip
+    // for `--ping`/`--discover`, which don't report `passive_rx_before_enable`.
+    let mut passive_rx_before_enable = 0u64;
+    if matches!(mode, ProbeMode::Passive) {
+        let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+        if let Ok(mut link) = SensorLink::<SerialStream>::open_capturing(&args.sensor_port, FIRMWARE_BAUD, cap.clone(), args.raw_serial_log) {
+            let _ = listen_and_tally(&mut link, Duration::from_secs(1)).await;
+            let (bytes, _) = tally_raw_capture(&cap);
+            passive_rx_before_enable += bytes;
+        }
+    }
+
+    let enable = apply_suspected_sensor_line_enable(&mut i2c).await;
+    // Two register reads + two readbacks (0x02, 0x06 each), two writes (0x02, 0x06).
+    let mut i2c_reads = 4u32;
+    let mut i2c_writes = 2u32;
+
+    if !enable.verified {
+        log::error!("expander verification failed (changed a bit other than bit 0, or a readback mismatch): aborting before any Sensor UART probing");
+        return finish_line_enable(args, mode, false, enable, None, ModeOutcome::default(), SensorAudit::new(), passive_rx_before_enable, 0, None, None, i2c_reads, i2c_writes);
+    }
+
+    let mut audit = SensorAudit::new();
+    let enable_completed_at = tokio::time::Instant::now();
+    let mut passive_rx_after_enable = 0u64;
+    let mut first_rx_ms = None;
+    let mut first_decoded_ms = None;
+
+    let probe = match mode {
+        ProbeMode::Passive => {
+            line_enable_passive_probe(
+                args,
+                enable_completed_at,
+                &mut passive_rx_after_enable,
+                &mut first_rx_ms,
+                &mut first_decoded_ms,
+                |baud| {
+                    let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+                    SensorLink::<SerialStream>::open_capturing(&args.sensor_port, baud, cap.clone(), args.raw_serial_log)
+                        .map(|l| (l, cap))
+                        .map_err(|e| e.to_string())
+                },
+            )
+            .await
+        }
+        ProbeMode::Ping => {
+            line_enable_ping_probe(&mut audit, |baud| {
+                let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+                SensorLink::<SerialStream>::open_capturing(&args.sensor_port, baud, cap, args.raw_serial_log).map_err(|e| e.to_string())
+            })
+            .await
+        }
+        ProbeMode::Discover => {
+            line_enable_discover_probe(&mut audit, args, |baud| {
+                let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+                SensorLink::<SerialStream>::open_capturing(&args.sensor_port, baud, cap, args.raw_serial_log).map_err(|e| e.to_string())
+            })
+            .await
+        }
+    };
+
+    let restore_final = if args.restore_suspected_sensor_line {
+        Some(apply_suspected_sensor_line_restore(&mut i2c, &enable).await)
+    } else {
+        None
+    };
+    if args.restore_suspected_sensor_line {
+        i2c_reads += 4;
+        i2c_writes += 2;
+    }
+
+    finish_line_enable(
+        args,
+        mode,
+        false,
+        enable,
+        restore_final,
+        probe,
+        audit,
+        passive_rx_before_enable,
+        passive_rx_after_enable,
+        first_rx_ms,
+        first_decoded_ms,
+        i2c_reads,
+        i2c_writes,
+    )
+}
+
+async fn run_dry_line_enable(args: &SensorProbeArgs, mode: ProbeMode) -> (SensorProbeReport, u8) {
+    let mut mock = MockI2c::always_succeed();
+    // Mirrors real hardware evidence: register 0x02 reads 0xFD (Frozen released, bit0 low) and
+    // register 0x06 reads 0xFD (our proven narrow Frozen init: bit1 output, bit0 still input) --
+    // matches the spec's own motivating evidence, so `--dry-run` demonstrates the interesting
+    // "only bit 0 changes" case, not the degenerate all-zeros mock default.
+    mock.reg_state.insert((crate::i2c::RESET_EXPANDER_ADDR, 0x02), 0xFD);
+    mock.reg_state.insert((crate::i2c::RESET_EXPANDER_ADDR, 0x06), 0xFD);
+
+    // dry-run has no meaningful pre-enable baseline window (nothing is "already on the wire"
+    // for a freshly spawned mock).
+    let passive_rx_before_enable = 0u64;
+    let enable = apply_suspected_sensor_line_enable(&mut mock).await;
+    let i2c_reads = 4u32;
+    let i2c_writes = mock.writes.len() as u32;
+
+    if !enable.verified {
+        return finish_line_enable(args, mode, true, enable, None, ModeOutcome::default(), SensorAudit::new(), 0, 0, None, None, i2c_reads, i2c_writes);
+    }
+
+    let mut audit = SensorAudit::new();
+    let enable_completed_at = tokio::time::Instant::now();
+    let mut passive_rx_after_enable = 0u64;
+    let mut first_rx_ms = None;
+    let mut first_decoded_ms = None;
+
+    // A single, persistent mock device/duplex pair is reused across every conceptual "open" in
+    // dry-run (unlike real hardware, which genuinely closes/reopens the UART at a different baud
+    // each step) -- real hardware evidence shows a UART reopen doesn't reset the Sensor MCU's own
+    // internal state, and this keeps the mock's bootloader -> firmware transition visible across
+    // Step A/Step B without needing a second, disconnected simulated device. `--passive` sends
+    // zero commands (it can never observe a Ping/JumpToFirmware-driven transition), so it uses the
+    // firmware-mode mock instead -- the one demonstration of section 6's actual point (spontaneous
+    // traffic appearing once the line is enabled) that a --dry-run can meaningfully show.
+    let (client, device) = tokio::io::duplex(4096);
+    let _ = if matches!(mode, ProbeMode::Passive) {
+        spawn_mock_sensor_device_firmware(device)
+    } else {
+        spawn_mock_sensor_device_bootloader(device)
+    };
+    let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+    let mut link = SensorLink::wrap_capturing(client, "dry-run", cap.clone());
+
+    let probe = match mode {
+        ProbeMode::Passive => {
+            let tally =
+                listen_with_enable_timing(&mut link, &cap, Duration::from_millis(200), enable_completed_at, &mut first_rx_ms, &mut first_decoded_ms).await;
+            let (bytes, found) = tally_raw_capture(&cap);
+            passive_rx_after_enable += bytes;
+            let mut json = tally.finalize(found);
+            json.bytes_received = bytes;
+            let mut o = ModeOutcome::default();
+            o.firmware_baud_opened = true;
+            o.bootloader_baud_opened = true;
+            o.passive_115200 = Some(json);
+            o
+        }
+        ProbeMode::Ping => {
+            let mut o = ModeOutcome::default();
+            o.bootloader_baud_opened = true;
+            let r = try_ping(&mut link, &mut audit, ProbeMode::Ping, false, 3).await;
+            o.bootloader_ping_response = Some(matches!(r, Some(false)));
+            if o.bootloader_ping_response != Some(true) {
+                let r2 = try_ping(&mut link, &mut audit, ProbeMode::Ping, false, 3).await;
+                o.firmware_ping_response = Some(matches!(r2, Some(true)));
+            }
+            o.firmware_mode_confirmed = o.firmware_ping_response == Some(true);
+            o
+        }
+        ProbeMode::Discover => {
+            let mut o = ModeOutcome::default();
+            o.bootloader_baud_opened = true;
+            let r = try_ping(&mut link, &mut audit, ProbeMode::Discover, false, 3).await;
+            let bootloader_confirmed = r == Some(false);
+            o.bootloader_ping_response = Some(bootloader_confirmed);
+            if bootloader_confirmed {
+                if link.send(&mut audit, ProbeMode::Discover, SensorProbeAction::JumpToFirmware, false, Duration::from_secs(1)).await.is_ok() {
+                    o.jump_to_firmware_sent = true;
+                }
+            }
+            o.firmware_baud_opened = true;
+            let r2 = try_ping(&mut link, &mut audit, ProbeMode::Discover, false, 3).await;
+            o.firmware_ping_response = Some(matches!(r2, Some(true)));
+            o.firmware_mode_confirmed = o.firmware_ping_response == Some(true);
+            if o.firmware_mode_confirmed && args.query_info {
+                if let Some(SensorPacket::HardwareInfo(hw)) = send_and_wait_for(
+                    &mut link,
+                    &mut audit,
+                    ProbeMode::Discover,
+                    SensorProbeAction::GetHardwareInfo,
+                    true,
+                    Duration::from_secs(1),
+                    |p| matches!(p, SensorPacket::HardwareInfo(_)),
+                )
+                .await
+                {
+                    o.hardware_info = Some(hw.to_string());
+                }
+                if let Some(SensorPacket::GetFirmware(v)) = send_and_wait_for(
+                    &mut link,
+                    &mut audit,
+                    ProbeMode::Discover,
+                    SensorProbeAction::GetFirmwareHash,
+                    true,
+                    Duration::from_secs(1),
+                    |p| matches!(p, SensorPacket::GetFirmware(_)),
+                )
+                .await
+                {
+                    o.firmware_info = Some(format!("firmware hash response value: {v}"));
+                }
+            }
+            o
+        }
+    };
+
+    let restore_final = if args.restore_suspected_sensor_line {
+        Some(apply_suspected_sensor_line_restore(&mut mock, &enable).await)
+    } else {
+        None
+    };
+    let i2c_writes = mock.writes.len() as u32;
+
+    finish_line_enable(
+        args,
+        mode,
+        true,
+        enable,
+        restore_final,
+        probe,
+        audit,
+        passive_rx_before_enable,
+        passive_rx_after_enable,
+        first_rx_ms,
+        first_decoded_ms,
+        i2c_reads,
+        i2c_writes,
+    )
+}
+
+// ---------------------------------------------------------------------------------------------
+// --passive
+// ---------------------------------------------------------------------------------------------
+
+async fn run_real_passive(args: &SensorProbeArgs) -> (SensorProbeReport, u8) {
+    let mut outcome = ModeOutcome::default();
+
+    let cap_115200: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+    match SensorLink::<SerialStream>::open_capturing(&args.sensor_port, FIRMWARE_BAUD, cap_115200.clone(), args.raw_serial_log) {
+        Ok(mut link) => {
+            outcome.firmware_baud_opened = true;
+            let tally = listen_and_tally(&mut link, Duration::from_secs(args.listen_seconds.max(1))).await;
+            let (bytes, found) = tally_raw_capture(&cap_115200);
+            let mut json = tally.finalize(found);
+            json.bytes_received = bytes;
+            outcome.passive_115200 = Some(json);
+        }
+        Err(e) => log::error!("failed to open Sensor UART @ {FIRMWARE_BAUD}: {e}"),
+    }
+
+    let cap_38400: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+    match SensorLink::<SerialStream>::open_capturing(&args.sensor_port, BOOTLOADER_BAUD, cap_38400.clone(), args.raw_serial_log) {
+        Ok(mut link) => {
+            outcome.bootloader_baud_opened = true;
+            let tally = listen_and_tally(&mut link, Duration::from_secs(args.listen_seconds.max(1))).await;
+            let (bytes, found) = tally_raw_capture(&cap_38400);
+            let mut json = tally.finalize(found);
+            json.bytes_received = bytes;
+            outcome.passive_38400 = Some(json);
+        }
+        Err(e) => log::error!("failed to open Sensor UART @ {BOOTLOADER_BAUD}: {e}"),
+    }
+
+    outcome.overall_result = passive_result(&outcome).to_string();
+    finish(args, ProbeMode::Passive, false, outcome, SensorAudit::new())
+}
+
+fn passive_result(outcome: &ModeOutcome) -> &'static str {
+    let decoded_any = [&outcome.passive_115200, &outcome.passive_38400]
+        .into_iter()
+        .flatten()
+        .any(|t| t.frames_decoded > 0);
+    let bytes_any = [&outcome.passive_115200, &outcome.passive_38400].into_iter().flatten().any(|t| t.bytes_received > 0);
+    if decoded_any {
+        "unsolicited_traffic_only"
+    } else if bytes_any {
+        "undecodable_traffic"
+    } else {
+        "uart_silent"
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// --ping
+// ---------------------------------------------------------------------------------------------
+
+async fn run_real_ping(args: &SensorProbeArgs) -> (SensorProbeReport, u8) {
+    let mut audit = SensorAudit::new();
+    let mut outcome = ModeOutcome::default();
+    let mut any_bytes = false;
+
+    let cap_fw: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+    match SensorLink::<SerialStream>::open_capturing(&args.sensor_port, FIRMWARE_BAUD, cap_fw.clone(), args.raw_serial_log) {
+        Ok(mut link) => {
+            outcome.firmware_baud_opened = true;
+            let r = try_ping(&mut link, &mut audit, ProbeMode::Ping, false, 3).await;
+            outcome.firmware_ping_response = Some(matches!(r, Some(true)));
+        }
+        Err(e) => log::error!("failed to open Sensor UART @ {FIRMWARE_BAUD}: {e}"),
+    }
+    let (fw_bytes, _) = tally_raw_capture(&cap_fw);
+    any_bytes |= fw_bytes > 0;
+
+    if outcome.firmware_ping_response != Some(true) {
+        let cap_bl: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+        match SensorLink::<SerialStream>::open_capturing(&args.sensor_port, BOOTLOADER_BAUD, cap_bl.clone(), args.raw_serial_log) {
+            Ok(mut link) => {
+                outcome.bootloader_baud_opened = true;
+                let r = try_ping(&mut link, &mut audit, ProbeMode::Ping, false, 3).await;
+                outcome.bootloader_ping_response = Some(matches!(r, Some(false)));
+            }
+            Err(e) => log::error!("failed to open Sensor UART @ {BOOTLOADER_BAUD}: {e}"),
+        }
+        let (bl_bytes, _) = tally_raw_capture(&cap_bl);
+        any_bytes |= bl_bytes > 0;
+    }
+
+    outcome.firmware_mode_confirmed = outcome.firmware_ping_response == Some(true);
+    outcome.overall_result = if outcome.firmware_ping_response == Some(true) {
+        "communicating_firmware"
+    } else if outcome.bootloader_ping_response == Some(true) {
+        "communicating_bootloader"
+    } else if any_bytes {
+        "undecodable_traffic"
+    } else {
+        "uart_silent"
+    }
+    .to_string();
+
+    finish(args, ProbeMode::Ping, false, outcome, audit)
+}
