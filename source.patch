+// frozen-hold-status
+// ================================================================================================
+
+pub async fn run_status(args: &HoldStatusArgs) -> (Report, u8) {
+    if args.dry_run {
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "dry-run");
+        let result = run_status_core(args, &mut link, true).await;
+        drop(link);
+        task.abort();
+        return result;
+    }
+
+    if let Some(reason) = refuse_if_owned(None, &args.frozen_port) {
+        log::error!("frozen-hold-status: refusing to run: {reason}");
+        let mut report = base_report("frozen-hold-status", false, "", &args.frozen_port, &reason, 40);
+        report.hold_results = Some(HoldResults { action: "status".to_string(), ..Default::default() });
+        write_json_if_requested(&report, args.json_output.as_deref());
+        return (report, 40);
+    }
+
+    let mut link = match FrozenLink::<tokio_serial::SerialStream>::open(&args.frozen_port) {
+        Ok(l) => l,
+        Err(e) => {
+            log::error!("frozen-hold-status: failed to open Frozen UART {}: {e}", args.frozen_port);
+            let mut report = base_report(
+                "frozen-hold-status", false, "", &args.frozen_port, "Frozen UART failed to open", 20,
+            );
+            report.hold_results = Some(HoldResults { action: "status".to_string(), ..Default::default() });
+            write_json_if_requested(&report, args.json_output.as_deref());
+            return (report, 20);
+        }
+    };
+
+    run_status_core(args, &mut link, false).await
+}
+
+async fn run_status_core<T>(args: &HoldStatusArgs, link: &mut FrozenLink<T>, dry_run: bool) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    let mut audit = AuditedTransport::new(Mode::HoldStatus);
+
+    let (ping_ok, mode) = frozen_ops::ping(link, &mut audit, COMMAND_TIMEOUT).await;
+
+    let mut left_water_c = None;
+    let mut right_water_c = None;
+    let mut heatsink_c = None;
+    if ping_ok {
+        match link.send(&mut audit, FrozenAction::get_temperatures(), COMMAND_TIMEOUT).await {
+            Ok(PacketOutcome::Received(FrozenPacket::GetTemperature(g))) => {
+                left_water_c = Some(crate::telemetry::centideg_to_celsius(g.left_temp));
+                right_water_c = Some(crate::telemetry::centideg_to_celsius(g.right_temp));
+                heatsink_c = Some(crate::telemetry::centideg_to_celsius(g.heatsink_temp));
+            }
+            Ok(PacketOutcome::Received(FrozenPacket::TemperatureUpdate(u))) => {
+                left_water_c = Some(crate::telemetry::centideg_to_celsius(u.left_temp));
+                right_water_c = Some(crate::telemetry::centideg_to_celsius(u.right_temp));
+                heatsink_c = Some(crate::telemetry::centideg_to_celsius(u.heatsink_temp));
+            }
+            _ => {}
+        }
+    }
+
+    eprintln!("Frozen responsive: {ping_ok}");
+    if let Some(l) = left_water_c {
+        eprintln!("Left water temperature:  {l:.2} C");
+    }
+    if let Some(r) = right_water_c {
+        eprintln!("Right water temperature: {r:.2} C");
+    }
+
+    let mut report = base_report(
+        "frozen-hold-status", dry_run, "", &args.frozen_port, if ping_ok { "responsive" } else { "silent" },
+        if ping_ok { 0 } else { 10 },
+    );
+    report.frozen_uart_opened = true;
+    report.frozen_bootloader_ping = ping_ok.then_some(mode == frozen_ops::DeviceMode::Bootloader);
+    report.frozen_firmware_ping = ping_ok.then_some(mode == frozen_ops::DeviceMode::Firmware);
+    report.outgoing_commands = audit.entries().iter().map(AuditEntryJson::from).collect();
+    report.hold_results = Some(HoldResults {
+        action: "status".to_string(),
+        frozen_responsive: ping_ok,
+        left_water_c,
+        right_water_c,
+        heatsink_c,
+        ..Default::default()
+    });
+    report.overall_pass = ping_ok;
+
+    write_json_if_requested(&report, args.json_output.as_deref());
+    report.print_table();
+    let code = report.exit_code;
+    (report, code)
+}
