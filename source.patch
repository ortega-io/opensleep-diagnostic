+/// One decoded firmware pump message (`FW: pump[<side>] ... @ <V>V <A>A`), kept separate from
+/// `telemetry_samples` since it is not a temperature reading.
+#[derive(Debug, Clone, Serialize)]
+pub struct PumpSampleJson {
+    pub elapsed_ms: u64,
+    pub timestamp: String,
+    pub side: String,
+    pub voltage: Option<f64>,
