+        drop(link);
+        device_task.abort();
+    }
+
+    #[tokio::test]
+    async fn safe_stop_without_a_uart_link_still_asserts_reset() {
+        let mut audit = AuditedTransport::new(Mode::Passive);
+        let mut i2c = MockI2c::always_succeed();
+        let result: SafeStopResult =
+            run_safe_stop::<tokio::io::DuplexStream, _>(None, &mut audit, Some(&mut i2c)).await;
+        assert!(result.i2c_reset_asserted);
+        assert!(result.left_disable_attempts.is_empty());
+    }
+
+    #[tokio::test]
