+    // -------------------------------------------------------------------------------------------
+    // Test helpers: a minimal scriptable fake Frozen device for cases the shared, correct-by-
+    // default mock (`mock::spawn_mock_frozen_device`) can't produce (wrong replies, silence for
+    // one side, injected messages ahead of a confirmation).
+    // -------------------------------------------------------------------------------------------
+
+    fn target_update_frame(side: BedSide, enabled: bool, temp: u16) -> Vec<u8> {
+        let s: u8 = if side == BedSide::Left { 0 } else { 1 };
+        let t = temp.to_be_bytes();
+        opensleep::common::codec::command(vec![0xC0, 0x00, s, enabled as u8, t[0], t[1]])
+    }
+
+    fn message_frame(text: &str) -> Vec<u8> {
+        let mut payload = vec![0x07u8, 0x00];
+        payload.extend_from_slice(text.as_bytes());
+        opensleep::common::codec::command(payload)
+    }
+
+    fn pong_frame(in_firmware: bool) -> Vec<u8> {
+        let code: u8 = if in_firmware { 0b0100_0110 } else { 0b0100_0010 };
+        opensleep::common::codec::command(vec![0x81, 0x00, code])
+    }
+
+    fn spawn_scripted_device(
+        mut device_side: DuplexStream,
+        mut respond: impl FnMut(u8, &[u8]) -> Option<Vec<u8>> + Send + 'static,
+    ) -> tokio::task::JoinHandle<()> {
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        if let Some(resp) = respond(opcode, &payload)
+                            && device_side.write_all(&resp).await.is_err()
+                        {
+                            break;
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/frozen_ops.rs b/src/bin/opensleep-diagnostic/frozen_ops.rs
new file mode 100644
index 0000000..666ce19
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/frozen_ops.rs
@@ -0,0 +1,169 @@
+//! Small Frozen protocol operations shared by `frozen-passive` and `frozen-cool-test`: Ping,
+//! GetHardwareInfo, and mode detection via `FrozenPacket::Pong`'s `in_firmware` flag (never
+//! inferred from timing alone), plus the bootloader -> firmware transition. All built on
+//! `FrozenLink`/`AuditedTransport`; nothing here can reach an opcode outside the current mode's
+//! whitelist.
+
+use std::time::Duration;
+
+use opensleep::common::packet::HardwareInfo;
+use opensleep::frozen::FrozenPacket;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::time::Instant;
+
+use crate::link::{FrozenLink, PacketOutcome};
+use crate::safety::{AuditedTransport, FrozenAction};
+
+/// After JumpToFirmware, how long to wait before the first re-Ping attempt.
+pub const POST_JUMP_SETTLE: Duration = Duration::from_millis(300);
+/// Interval between post-jump re-Pings.
+pub const POST_JUMP_RETRY_INTERVAL: Duration = Duration::from_millis(300);
+/// Hard ceiling on the whole bootloader -> firmware transition wait.
+pub const POST_JUMP_HARD_TIMEOUT: Duration = Duration::from_secs(10);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DeviceMode {
+    Unknown,
+    Bootloader,
+    Firmware,
+}
+
+pub async fn ping<T>(
+    link: &mut FrozenLink<T>,
+    audit: &mut AuditedTransport,
+    timeout: Duration,
+) -> (bool, DeviceMode)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    match link.send(audit, FrozenAction::ping(), timeout).await {
+        Ok(PacketOutcome::Received(FrozenPacket::Pong(in_firmware))) => (
+            true,
+            if in_firmware {
+                DeviceMode::Firmware
+            } else {
+                DeviceMode::Bootloader
+            },
+        ),
+        Ok(PacketOutcome::Received(other)) => {
+            log::warn!("Ping got unexpected packet: {other:?}");
+            (false, DeviceMode::Unknown)
+        }
+        Ok(PacketOutcome::TimedOut) => {
+            log::warn!("Frozen did not respond to Ping within {timeout:?}");
+            (false, DeviceMode::Unknown)
+        }
+        Ok(PacketOutcome::Closed) => {
+            log::warn!("Frozen port closed while waiting for Ping response");
+            (false, DeviceMode::Unknown)
+        }
+        Err(e) => {
+            log::error!("Ping failed: {e}");
+            (false, DeviceMode::Unknown)
+        }
+    }
+}
+
+pub async fn get_hardware_info<T>(
+    link: &mut FrozenLink<T>,
+    audit: &mut AuditedTransport,
+    timeout: Duration,
+) -> Option<HardwareInfo>
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    match link.send(audit, FrozenAction::get_hardware_info(), timeout).await {
+        Ok(PacketOutcome::Received(FrozenPacket::HardwareInfo(hw))) => Some(hw),
+        Ok(PacketOutcome::Received(other)) => {
+            log::warn!("GetHardwareInfo got unexpected packet: {other:?}");
+            None
+        }
+        Ok(_) => {
+            log::warn!("Frozen did not respond to GetHardwareInfo within {timeout:?}");
+            None
+        }
+        Err(e) => {
+            log::error!("GetHardwareInfo failed: {e}");
+            None
+        }
+    }
+}
+
+/// Sends JumpToFirmware and then re-Pings until firmware mode is confirmed or the hard timeout
+/// expires. Returns `true` only if application firmware actually answered afterward.
+pub async fn jump_to_firmware_and_wait<T>(
+    link: &mut FrozenLink<T>,
+    audit: &mut AuditedTransport,
+    ping_timeout: Duration,
+) -> bool
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    match link.send(audit, FrozenAction::jump_to_firmware(), ping_timeout).await {
+        Ok(PacketOutcome::Received(pkt)) => log::info!("JumpToFirmware response: {pkt:?}"),
+        Ok(_) => log::warn!("JumpToFirmware sent; no response within {ping_timeout:?} (continuing to re-ping)"),
+        Err(e) => {
+            log::error!("JumpToFirmware failed to send: {e}");
+            return false;
+        }
+    }
+
+    tokio::time::sleep(POST_JUMP_SETTLE).await;
+
+    let deadline = Instant::now() + POST_JUMP_HARD_TIMEOUT;
+    loop {
+        let (ok, mode) = ping(link, audit, ping_timeout).await;
+        if ok && mode == DeviceMode::Firmware {
+            return true;
+        }
+        if Instant::now() >= deadline {
+            log::error!("Frozen did not reach application firmware within {POST_JUMP_HARD_TIMEOUT:?} of JumpToFirmware");
+            return false;
+        }
+        tokio::time::sleep(POST_JUMP_RETRY_INTERVAL).await;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::mock::mock_frozen_link_pair;
+    use crate::safety::Mode;
+
+    #[tokio::test]
+    async fn ping_detects_firmware_mode_from_pong_flag_not_timing() {
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::Passive);
+        let (ok, mode) = ping(&mut link, &mut audit, Duration::from_secs(1)).await;
+        assert!(ok);
+        assert_eq!(mode, DeviceMode::Firmware);
+        drop(link);
+        task.abort();
+    }
+
+    /// The mock device's solicited 0xC1 reply to GetTemperatures still decodes correctly against
+    /// the real, unmodified `FrozenPacket::parse_get_temperature` -- kept as raw evidence in
+    /// reports even though `cool_test.rs`'s baseline/active-phase safety logic no longer relies
+    /// on it (see that module's docs for why: real hardware sends a 14-byte 0xC1 frame, and the
+    /// parser requires exactly 27).
+    #[tokio::test]
+    async fn get_temperatures_solicited_reply_still_decodes_from_the_mock() {
+        let (client, task) = mock_frozen_link_pair();
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::Passive);
+        let outcome = link
+            .send(&mut audit, FrozenAction::get_temperatures(), Duration::from_secs(1))
+            .await
+            .unwrap();
+        match outcome {
+            PacketOutcome::Received(FrozenPacket::GetTemperature(g)) => {
+                assert_eq!(g.left_temp, crate::mock::MOCK_BASELINE_LEFT_CENTIDEG);
+                assert_eq!(g.right_temp, crate::mock::MOCK_BASELINE_RIGHT_CENTIDEG);
+            }
+            other => panic!("unexpected outcome: {other:?}"),
+        }
+        drop(link);
+        task.abort();
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/frozen_startup.rs b/src/bin/opensleep-diagnostic/frozen_startup.rs
new file mode 100644
index 0000000..c3f544e
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/frozen_startup.rs
@@ -0,0 +1,223 @@
+//! Narrow Frozen startup, shared by `frozen-prime-opensleep-init --release-frozen-only` and
+//! `frozen-cool-test`: releases Frozen from reset via `i2c::pulse_frozen_reset_bit` -- never the
+//! four-register full reset sequence ([`crate::i2c::run_reset_sequence`]) and never
+//! `opensleep::reset::ResetController` -- then confirms application firmware is reached via
+//! Ping/JumpToFirmware. One implementation, reused by both callers, so the two narrow-reset modes
+//! this binary has can never drift from each other. See [`crate::i2c::pulse_frozen_reset_bit`]'s
+//! doc comment for the real-hardware evidence behind the pulse (and why register 0x06 must be
+//! configured as an output first).
+
+use std::time::Duration;
+
+use opensleep::frozen::FrozenPacket;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::time::Instant;
+
+use crate::i2c::{I2cPort, Reg02PulseResult, pulse_frozen_reset_bit};
+use crate::link::{FrozenLink, PacketOutcome};
+use crate::safety::AuditedTransport;
+
+/// After the pulse, how long to wait and drain unsolicited boot messages before Pinging at all.
+pub const BOOT_MESSAGE_SETTLE: Duration = Duration::from_secs(2);
+/// Hard ceiling on repeatedly Pinging after the boot-message settle window, before concluding
+/// Frozen never responded at all.
+pub const PING_RETRY_WINDOW: Duration = Duration::from_secs(10);
+/// How long to wait between repeated Ping attempts, and the granularity of the boot-message drain
+/// loop.
+pub const STARTUP_POLL_INTERVAL: Duration = Duration::from_millis(500);
+/// Per-command timeout for a single Ping/JumpToFirmware exchange during startup.
+pub const STARTUP_COMMAND_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// The result of [`start_frozen_narrow`]: the I2C pulse plus what was observed while waiting for
+/// Frozen to reach application firmware afterward.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct NarrowStartupResult {
+    pub pulse: Reg02PulseResult,
+    /// `true` iff Frozen answered Ping at all (in either bootloader or firmware mode) within
+    /// [`PING_RETRY_WINDOW`] of the pulse completing.
+    pub ping_ok: bool,
+    pub frozen_reached_firmware: bool,
+    pub capwater_unavailable_observed: bool,
+    pub flowrate_unavailable_observed: bool,
+}
+
+impl NarrowStartupResult {
+    /// `true` iff the pulse fully verified *and* Frozen reached application firmware. Callers must
+    /// check this before proceeding to anything that assumes Frozen is up (sending `Prime`,
+    /// enabling a cooling target, etc.).
+    pub fn started_successfully(&self) -> bool {
+        self.pulse.fully_verified() && self.ping_ok && self.frozen_reached_firmware
+    }
+}
+
+/// Releases Frozen from reset and waits for it to reach application firmware. Never calls
+/// `opensleep::reset::ResetController` or the four-register full reset sequence, and never writes
+/// register 0x07. If the I2C pulse itself fails to verify, returns immediately without ever
+/// touching the Frozen UART (`result.ping_ok`/`frozen_reached_firmware` stay `false`).
+pub async fn start_frozen_narrow<T, P>(
+    i2c: &mut P,
+    link: &mut FrozenLink<T>,
+    audit: &mut AuditedTransport,
+) -> NarrowStartupResult
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let mut result = NarrowStartupResult::default();
+
+    let pulse = match pulse_frozen_reset_bit(i2c).await {
+        Ok(p) => p,
+        Err(e) => {
+            log::error!("failed to pulse Frozen reset bit via I2C: {e}");
+            return result;
+        }
+    };
+    result.pulse = pulse;
+
+    if !pulse.fully_verified() {
+        log::error!(
+            "aborting: register 0x02/0x06 pulse did not verify (asserted_readback_matches={} \
+             asserted_only_bit1_changed={} config_readback_matches={} config_only_bit1_changed={} \
+             released_readback_matches={} released_only_bit1_changed={})",
+            pulse.assert_output_step.readback_matches,
+            pulse.assert_output_step.only_bit1_changed,
+            pulse.config_step.inner.readback_matches,
+            pulse.config_step.inner.only_bit1_changed,
+            pulse.release_step.readback_matches,
+            pulse.release_step.only_bit1_changed
+        );
+        return result;
+    }
+    log::info!(
+        "Frozen reset bit pulsed: register 0x06 bit 1 configured as output (was previously {}), \
+         asserted 0x{:02X} -> released 0x{:02X} in {:?}, every other bit unchanged",
+        if pulse.config_step.bit1_was_already_output { "output" } else { "input" },
+        pulse.assert_output_step.target,
+        pulse.release_step.target,
+        pulse.pulse_duration
+    );
+
+    // Wait up to BOOT_MESSAGE_SETTLE for boot messages, draining and logging anything Frozen
+    // sends unsolicited (informational only -- capwater/flowrate mentions here do not gate
+    // anything by themselves; callers decide what to do with them).
+    let mut capwater_unavailable = false;
+    let mut flowrate_unavailable = false;
+    let boot_deadline = Instant::now() + BOOT_MESSAGE_SETTLE;
+    loop {
+        let remaining = boot_deadline.saturating_duration_since(Instant::now());
+        if remaining.is_zero() {
+            break;
+        }
+        match link.recv(remaining).await {
+            Ok(PacketOutcome::Received(FrozenPacket::Message(m))) => {
+                log::info!("boot message: {m}");
+                if m == "FW: [capwater] sensor unavailable" {
+                    capwater_unavailable = true;
+                }
+                if m == "FW: [flowrate] sensor unavailable" {
+                    flowrate_unavailable = true;
+                }
+            }
+            Ok(PacketOutcome::Received(pkt)) => log::info!("boot packet: {pkt:?}"),
+            Ok(PacketOutcome::TimedOut) => {}
+            Ok(PacketOutcome::Closed) | Err(_) => break,
+        }
+    }
+    result.capwater_unavailable_observed = capwater_unavailable;
+    result.flowrate_unavailable_observed = flowrate_unavailable;
+
+    // Ping repeatedly for up to PING_RETRY_WINDOW until Frozen answers at all.
+    let ping_deadline = Instant::now() + PING_RETRY_WINDOW;
+    let mut mode = crate::frozen_ops::DeviceMode::Unknown;
+    let mut ping_ok = false;
+    loop {
+        let (ok, m) = crate::frozen_ops::ping(link, audit, STARTUP_COMMAND_TIMEOUT).await;
+        if ok {
+            ping_ok = true;
+            mode = m;
+            break;
+        }
+        if Instant::now() >= ping_deadline {
+            break;
+        }
+        tokio::time::sleep(STARTUP_POLL_INTERVAL).await;
+    }
+    result.ping_ok = ping_ok;
+
+    if !ping_ok {
+        log::error!(
+            "Frozen did not respond to Ping within {PING_RETRY_WINDOW:?} of being released from reset"
+        );
+        return result;
+    }
+
+    // Pong(false) -> JumpToFirmware, then re-Ping (tolerating any interleaved startup messages)
+    // until Pong(true) or the hard timeout inside jump_to_firmware_and_wait expires.
+    result.frozen_reached_firmware = match mode {
+        crate::frozen_ops::DeviceMode::Firmware => true,
+        crate::frozen_ops::DeviceMode::Bootloader => {
+            crate::frozen_ops::jump_to_firmware_and_wait(link, audit, STARTUP_COMMAND_TIMEOUT).await
+        }
+        crate::frozen_ops::DeviceMode::Unknown => false,
+    };
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::i2c::MockI2c;
+    use crate::mock::spawn_mock_frozen_device_release_only;
+    use crate::safety::Mode;
+
+    #[tokio::test]
+    async fn succeeds_against_a_responsive_device() {
+        let mut i2c = MockI2c::always_succeed();
+        let (client, task) = spawn_mock_frozen_device_release_only(false, false, false);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::PrimeTest);
+        let result = start_frozen_narrow(&mut i2c, &mut link, &mut audit).await;
+        assert!(result.started_successfully());
+        assert!(result.pulse.fully_verified());
+        drop(link);
+        task.abort();
+    }
+
+    #[tokio::test]
+    async fn reports_unresponsive_frozen_without_hanging_the_pulse() {
+        let mut i2c = MockI2c::always_succeed();
+        let (client, _unused_device_side) = tokio::io::duplex(64);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::PrimeTest);
+        let result = start_frozen_narrow(&mut i2c, &mut link, &mut audit).await;
+        assert!(result.pulse.fully_verified(), "the I2C pulse itself must still succeed");
+        assert!(!result.ping_ok);
+        assert!(!result.frozen_reached_firmware);
+        assert!(!result.started_successfully());
+    }
+
+    #[tokio::test]
+    async fn aborts_before_pinging_when_the_i2c_pulse_fails() {
+        let mut i2c = MockI2c { fail_reg_reads: true, ..MockI2c::always_succeed() };
+        let (client, task) = spawn_mock_frozen_device_release_only(false, false, false);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::PrimeTest);
+        let result = start_frozen_narrow(&mut i2c, &mut link, &mut audit).await;
+        assert!(!result.started_successfully());
+        assert!(!result.ping_ok);
+        drop(link);
+        task.abort();
+    }
+
+    #[tokio::test]
+    async fn jumps_to_firmware_when_frozen_answers_from_the_bootloader() {
+        let mut i2c = MockI2c::always_succeed();
+        let (client, task) = spawn_mock_frozen_device_release_only(true, false, false);
+        let mut link = FrozenLink::wrap(client, "test");
+        let mut audit = AuditedTransport::new(Mode::PrimeTest);
+        let result = start_frozen_narrow(&mut i2c, &mut link, &mut audit).await;
+        assert!(result.started_successfully());
+        drop(link);
+        task.abort();
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/guard.rs b/src/bin/opensleep-diagnostic/guard.rs
new file mode 100644
index 0000000..c120bf8
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/guard.rs
@@ -0,0 +1,421 @@
+//! `frozen-cool-test --firmware-authoritative`'s independent shutdown guard: protects against the
+//! *main observer process itself* crashing, hanging, losing its controlling terminal, or being
+//! killed during a long (potentially hours-long) active-phase run, when no other part of this
+//! binary would be left running to disable cooling.
+//!
+//! This is deliberately a **separate OS process**, not a thread or spawned task: an in-process
+//! construct shares fate with the process it is meant to protect against. A panic that unwinds
+//! past `main` (Rust's default `fn main()` panic behavior exits the whole process), a segfault, an
+//! OOM kill, or an operator's `kill -9` all take every thread and task in that process down
+//! together. Only a genuinely separate process can keep running once the parent is gone.
+//!
+//! ## Mechanism
+//!
+//! Once `cool_test.rs`'s firmware-authoritative active phase confirms every requested side's
+//! enabled `TargetUpdate`, it re-execs the current binary (`std::env::current_exe()`) with the
+//! hidden `internal-cool-test-guard` subcommand (see `cli::Commands::InternalCoolTestGuard`),
+//! spawned into its own process group (`process_group(0)`, so a SIGHUP delivered to the parent's
+//! controlling terminal/session on an SSH disconnect is never delivered to the guard at all) and
+//! piping its stdin. The guard's own signal handling additionally treats SIGINT/SIGTERM/SIGHUP as
+//! no-ops for as long as it is armed -- see [`ignore_hostile_signals_forever`] -- so only the
+//! parent's own disarm byte, the deadline, or heartbeat loss can end it; the guard is not supposed
+//! to be killable by the same event that might be killing the parent.
+//!
+//! The guard ([`run`]) then loops, racing three things against each other -- see
+//! [`watch_for_disarm_heartbeat_or_deadline`]:
+//!
+//!   - reading [`DISARM_BYTE`] on stdin means the parent's own verified shutdown completed and
+//!     explicitly told this guard to stand down -- exit immediately without touching hardware.
+//!   - reading [`HEARTBEAT_BYTE`] (sent periodically by the parent's own observation loop, proving
+//!     that loop is still actually iterating, not merely that the process exists) resets the
+//!     heartbeat timer and the wait continues.
+//!   - EOF (the pipe closed, e.g. the parent process exited without writing anything) means the
+//!     parent is gone *unexpectedly* -- fire immediately.
+//!   - no heartbeat or disarm byte within `--heartbeat-timeout-seconds` means the parent's own
+//!     observation loop has stalled (hung, deadlocked, or otherwise stopped iterating) even though
+//!     the process might technically still exist -- fire immediately, well before the full
+//!     deadline, exactly what a hung parent needs.
+//!   - the absolute deadline (`--arm-seconds`, already including the requested duration plus a
+//!     grace period) elapsing first means the parent never disarmed at all -- fire.
+//!
+//! "Firing" means opening the real Frozen UART and I2C device directly and running the exact same
+//! [`crate::cool_test::run_cool_test_shutdown`] the main run's own shutdown path uses: repeated
+//! both-side disable commands confirmed from each command's own reply, falling back to the narrow,
+//! bit-1-only emergency reset only if that could not be confirmed -- never the global subsystem
+//! reset outside that existing, already-audited fallback.
+//!
+//! ## What is and isn't covered by automated tests
+//!
+//! [`watch_for_disarm_heartbeat_or_deadline`] -- the safety-critical fire-or-stand-down decision --
+//! is a pure function tested directly against an in-memory duplex stream (see this module's own
+//! tests). The real-hardware plumbing around it ([`run`]: opening a real serial port and I2C
+//! device, re-exec'ing the real packaged binary as a child process, writing bytes across a real OS
+//! pipe, process-group/signal-disposition behavior) cannot be exercised by `cargo test`:
+//! `std::env::current_exe()` under `cargo test` resolves to the *test* binary, which has no
+//! `internal-cool-test-guard` subcommand at all, and there is no real Frozen UART/I2C device
+//! available in a test environment regardless. This mirrors the same, already-documented gap
+//! `prime_opensleep_init.rs`'s real (non-mocked) initialization path has -- see TEST_RESULTS.md for
+//! what was and wasn't verified this way for both.
+
+use std::time::Duration;
+
+use tokio::io::{AsyncRead, AsyncReadExt};
+
+use crate::cli::GuardArgs;
+use crate::i2c::RealI2c;
+use crate::link::FrozenLink;
+use crate::safety::{AuditedTransport, Mode};
+use crate::signals::StopReason;
+
+/// The byte the parent writes to disarm the guard.
+pub const DISARM_BYTE: u8 = b'D';
+/// The byte the parent's observation loop writes periodically to prove it is still iterating.
+/// Distinct from [`DISARM_BYTE`]: receiving this resets the heartbeat timer but does *not* stand
+/// the guard down.
+pub const HEARTBEAT_BYTE: u8 = b'H';
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum GuardOutcome {
+    /// The parent wrote the disarm byte: stand down, touch nothing.
+    Disarmed,
+    /// The stdin pipe closed (EOF): the parent is gone unexpectedly.
+    ParentGone,
+    /// No heartbeat or disarm byte arrived within the heartbeat timeout: the parent's own
+    /// observation loop has stalled, even if the process itself is technically still running.
+    HeartbeatLost,
+    /// The absolute deadline elapsed with the pipe still open and no disarm byte ever seen.
+    DeadlineExpired,
+}
+
+/// Pure decision logic, independent of real hardware or a real child process: loops reading bytes
+/// from `stdin`, tracking the most recent heartbeat/disarm activity against `heartbeat_timeout`,
+/// and racing both that and the absolute `deadline` (measured from the first call). Generic over
+/// the stdin type so tests can substitute an in-memory duplex stream instead of a real OS pipe --
+/// this is the one function in this module that automated tests can and do exercise directly (see
+/// this module's own `tests` below).
+pub async fn watch_for_disarm_heartbeat_or_deadline<R>(mut stdin: R, deadline: Duration, heartbeat_timeout: Duration) -> GuardOutcome
+where
+    R: AsyncRead + Unpin,
+{
+    let start = tokio::time::Instant::now();
+    let mut last_heartbeat = tokio::time::Instant::now();
+    let mut buf = [0u8; 1];
+    loop {
+        let deadline_remaining = deadline.saturating_sub(start.elapsed());
+        if deadline_remaining.is_zero() {
+            return GuardOutcome::DeadlineExpired;
+        }
+        let heartbeat_remaining = heartbeat_timeout.saturating_sub(last_heartbeat.elapsed());
+        if heartbeat_remaining.is_zero() {
+            return GuardOutcome::HeartbeatLost;
+        }
+        let wait = deadline_remaining.min(heartbeat_remaining);
+        tokio::select! {
+            biased;
+            result = stdin.read(&mut buf) => match result {
+                Ok(0) => return GuardOutcome::ParentGone,
+                Ok(_) if buf[0] == DISARM_BYTE => return GuardOutcome::Disarmed,
+                Ok(_) => last_heartbeat = tokio::time::Instant::now(),
+                Err(_) => return GuardOutcome::ParentGone,
+            },
+            _ = tokio::time::sleep(wait) => {} // loop back around; the checks above pick the reason
+        }
+    }
+}
+
+/// Consumes and discards SIGINT/SIGTERM/SIGHUP for as long as the guard is armed, so the OS's
+/// default "terminate" disposition for those signals is replaced with "do nothing" -- the whole
+/// point of this guard is to remain armed through exactly the kind of event (a terminal
+/// disconnect, an operator's Ctrl+C hitting the whole process group, a `systemd`/session manager
+/// sending SIGTERM) that might be taking the parent observer down at the same moment. Only the
+/// parent's own explicit disarm byte, the heartbeat timeout, or the deadline can end the guard --
+/// never a signal. (`SIGKILL` cannot be caught by any process and is not attempted here.)
+async fn ignore_hostile_signals_forever() {
+    #[cfg(unix)]
+    {
+        use tokio::signal::unix::{SignalKind, signal};
+        let mut sigterm = signal(SignalKind::terminate()).ok();
+        let mut sighup = signal(SignalKind::hangup()).ok();
+        loop {
+            tokio::select! {
+                _ = tokio::signal::ctrl_c() => log::info!("independent shutdown guard: ignoring SIGINT while armed"),
+                _ = async { match sigterm.as_mut() { Some(s) => s.recv().await, None => std::future::pending().await } } => {
+                    log::info!("independent shutdown guard: ignoring SIGTERM while armed");
+                }
+                _ = async { match sighup.as_mut() { Some(s) => s.recv().await, None => std::future::pending().await } } => {
+                    log::info!("independent shutdown guard: ignoring SIGHUP while armed");
+                }
+            }
+        }
+    }
+    #[cfg(not(unix))]
+    std::future::pending::<()>().await;
+}
+
+/// Real entry point for the hidden `internal-cool-test-guard` subcommand -- see module docs for
+/// why this specific function (as opposed to [`watch_for_disarm_heartbeat_or_deadline`]) is not
+/// exercised by `cargo test`. Returns a process exit code (0 = stood down cleanly, or fired and
+/// the disable sequence was verified; 1 = fired but disable could not be verified, or a real
+/// I2C/UART device could not even be opened).
+pub async fn run(args: &GuardArgs) -> u8 {
+    let deadline = Duration::from_secs_f64(args.arm_seconds.max(0.0));
+    let heartbeat_timeout = Duration::from_secs_f64(args.heartbeat_timeout_seconds.max(0.0));
+    log::info!(
+        "independent shutdown guard: armed (deadline={deadline:?}, heartbeat_timeout={heartbeat_timeout:?}, \
+         left_active={}, right_active={})",
+        args.left_active, args.right_active
+    );
+
+    let outcome = tokio::select! {
+        biased;
+        outcome = watch_for_disarm_heartbeat_or_deadline(tokio::io::stdin(), deadline, heartbeat_timeout) => outcome,
+        () = ignore_hostile_signals_forever() => unreachable!("ignore_hostile_signals_forever never returns"),
+    };
+    match outcome {
+        GuardOutcome::Disarmed => {
+            log::info!("independent shutdown guard: disarmed by parent; exiting without touching hardware");
+            return 0;
+        }
+        GuardOutcome::ParentGone => {
+            log::error!(
+                "independent shutdown guard: the main observer process's stdin pipe closed without a \
+                 disarm signal -- it appears to have exited unexpectedly. Asserting both-side disable now."
+            );
+        }
+        GuardOutcome::HeartbeatLost => {
+            log::error!(
+                "independent shutdown guard: no heartbeat from the main observer process for {heartbeat_timeout:?} -- \
+                 its observation loop appears to have stalled. Asserting both-side disable now."
+            );
+        }
+        GuardOutcome::DeadlineExpired => {
+            log::error!(
+                "independent shutdown guard: arm deadline elapsed without being disarmed -- the main \
+                 observer process may be hung. Asserting both-side disable now."
+            );
+        }
+    }
+    log::warn!("independent shutdown guard: activated");
+
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("independent shutdown guard: failed to open I2C device {}: {e}", args.i2c_device);
+            return 1;
+        }
+    };
+    // Only used for logging/audit context inside run_cool_test_shutdown -- SafetyOff (disable) is
+    // permitted for either side in every Mode::CoolTest regardless, so this Mode value doesn't
+    // change which commands the guard is allowed to send.
+    let mut audit = AuditedTransport::new(Mode::cool_test_both());
+    let mut link = match FrozenLink::<tokio_serial::SerialStream>::open(&args.frozen_port) {
+        Ok(l) => Some(l),
+        Err(e) => {
+            log::error!("independent shutdown guard: failed to open Frozen UART {}: {e}", args.frozen_port);
+            None
+        }
+    };
+
+    let shutdown =
+        crate::cool_test::run_cool_test_shutdown(link.as_mut(), &mut audit, &mut i2c, StopReason::IndependentGuardFired).await;
+    if shutdown.verified() {
+        log::warn!("independent shutdown guard: shutdown confirmed");
+        0
+    } else {
+        log::error!("independent shutdown guard: fired, but the disable sequence could NOT be verified");
+        1
+    }
+}
+
+/// Parent-side handle for a spawned guard process -- see [`spawn`]. Dropping this without calling
+/// [`disarm`](Self::disarm) leaves the child's stdin pipe open and the child still armed; only an
+/// explicit disarm (or the deadline/heartbeat timeout) ends the child's wait.
+pub struct GuardHandle {
+    child: std::process::Child,
+    stdin: Option<std::process::ChildStdin>,
+}
+
+impl GuardHandle {
+    /// Best-effort: writes the heartbeat byte to the child's stdin pipe. Called periodically from
+    /// the active observation loop -- see `cool_test.rs` -- so the guard can distinguish "the
+    /// parent process exists" from "the parent's observation loop is actually still iterating".
+    /// Returns whether the write succeeded; a caller that sees repeated failures here should treat
+    /// the guard as no longer reliably reachable (though it will still fire correctly on its own
+    /// heartbeat timeout regardless).
+    pub fn heartbeat(&mut self) -> bool {
+        use std::io::Write;
+        let Some(stdin) = self.stdin.as_mut() else {
+            return false;
+        };
+        stdin.write_all(&[HEARTBEAT_BYTE]).is_ok()
+    }
+
+    /// Best-effort: writes the disarm byte to the child's stdin pipe. Returns whether the write
+    /// itself succeeded -- callers should treat a `false` return as "the guard may still fire" and
+    /// log accordingly (see `cool_test.rs`'s own caller), never as evidence that it did not.
+    pub fn disarm(&mut self) -> bool {
+        use std::io::Write;
+        let Some(stdin) = self.stdin.take() else {
+            return false;
+        };
+        let mut stdin = stdin;
+        stdin.write_all(&[DISARM_BYTE]).is_ok()
+    }
+}
+
+impl Drop for GuardHandle {
+    fn drop(&mut self) {
+        // Best-effort cleanup only: a `GuardHandle` dropped without an explicit `disarm()` call
+        // (e.g. an early return on a code path that forgot to) should not leak a lingering armed
+        // child process indefinitely. This is *not* the guard's primary disarm mechanism -- normal
+        // shutdown always calls `disarm()` explicitly first, which is what lets the child log and
+        // exit cleanly instead of merely being reaped here.
+        let _ = self.child.try_wait();
+    }
+}
+
+/// Spawns the independent shutdown guard as a real, separate OS process: re-execs the current
+/// binary (`std::env::current_exe()`) with the hidden `internal-cool-test-guard` subcommand,
+/// piping its stdin so [`GuardHandle::heartbeat`]/[`GuardHandle::disarm`] can later signal it, and
+/// placing it in its own process group (`process_group(0)`) so a SIGHUP delivered to the parent's
+/// controlling terminal/session (e.g. an SSH disconnect) is never delivered to the guard. Only
+/// ever called from `cool_test.rs`'s real (non-dry-run) `--firmware-authoritative` path, once
+/// every requested side's target is confirmed enabled -- never from a test (see module docs for
+/// why `cargo test` cannot exercise this function meaningfully).
+pub fn spawn(
+    frozen_port: &str,
+    i2c_device: &str,
+    left_active: bool,
+    right_active: bool,
+    arm_seconds: f64,
+    heartbeat_timeout_seconds: f64,
+) -> std::io::Result<GuardHandle> {
+    use std::os::unix::process::CommandExt;
+    let exe = std::env::current_exe()?;
+    let mut command = std::process::Command::new(exe);
+    command
+        .arg("internal-cool-test-guard")
+        .arg("--frozen-port")
+        .arg(frozen_port)
+        .arg("--i2c-device")
+        .arg(i2c_device)
+        .arg("--arm-seconds")
+        .arg(arm_seconds.to_string())
+        .arg("--heartbeat-timeout-seconds")
+        .arg(heartbeat_timeout_seconds.to_string());
+    if left_active {
+        command.arg("--left-active");
+    }
+    if right_active {
+        command.arg("--right-active");
+    }
+    // A new process group means signals delivered to the parent's controlling terminal's
+    // foreground process group (SIGHUP on hangup, a terminal-driven SIGINT) are not also
+    // delivered to the guard -- on top of (not instead of) ignore_hostile_signals_forever's own
+    // in-process handling, since a guard spawned by something other than an interactive terminal
+    // (e.g. already under `setsid`) still benefits from both layers.
+    command.process_group(0);
+    let mut child = command
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::inherit())
+        .spawn()?;
+    let stdin = child.stdin.take();
+    Ok(GuardHandle { child, stdin })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn disarm_byte_written_before_the_deadline_wins() {
+        let (mut parent, child) = tokio::io::duplex(8);
+        tokio::spawn(async move {
+            use tokio::io::AsyncWriteExt;
+            let _ = parent.write_all(&[DISARM_BYTE]).await;
+        });
+        let outcome = watch_for_disarm_heartbeat_or_deadline(child, Duration::from_secs(5), Duration::from_secs(5)).await;
+        assert_eq!(outcome, GuardOutcome::Disarmed);
+    }
+
+    #[tokio::test]
+    async fn heartbeat_bytes_reset_the_heartbeat_timer_without_disarming() {
+        let (mut parent, child) = tokio::io::duplex(8);
+        // Keeps writing (well past the assertion) so `parent` -- and thus the pipe's write half --
+        // stays open; dropping it early would close the pipe and register as ParentGone (EOF)
+        // instead of exercising the intended heartbeat-timeout path.
+        let heartbeat_task = tokio::spawn(async move {
+            use tokio::io::AsyncWriteExt;
+            for _ in 0..3 {
+                tokio::time::sleep(Duration::from_millis(30)).await;
+                let _ = parent.write_all(&[HEARTBEAT_BYTE]).await;
+            }
+            // Then go silent -- the heartbeat timeout (40ms) should fire before the deadline (1s).
+            tokio::time::sleep(Duration::from_secs(5)).await;
+        });
+        let outcome =
+            watch_for_disarm_heartbeat_or_deadline(child, Duration::from_secs(1), Duration::from_millis(40)).await;
+        assert_eq!(outcome, GuardOutcome::HeartbeatLost);
+        heartbeat_task.abort();
+    }
+
+    #[tokio::test]
+    async fn heartbeat_alone_never_disarms() {
+        let (mut parent, child) = tokio::io::duplex(8);
+        // Keeps the pipe open past the assertion (see comment above) so the deadline -- not a
+        // spurious EOF from the write half closing -- is what actually fires.
+        let heartbeat_task = tokio::spawn(async move {
+            use tokio::io::AsyncWriteExt;
+            let _ = parent.write_all(&[HEARTBEAT_BYTE]).await;
+            // Parent then goes silent for longer than the deadline without ever disarming.
+            tokio::time::sleep(Duration::from_secs(5)).await;
+        });
+        let outcome =
+            watch_for_disarm_heartbeat_or_deadline(child, Duration::from_millis(60), Duration::from_secs(5)).await;
+        assert_eq!(outcome, GuardOutcome::DeadlineExpired);
+        heartbeat_task.abort();
+    }
+
+    #[tokio::test]
+    async fn pipe_closing_with_nothing_read_means_parent_gone() {
+        let (parent, child) = tokio::io::duplex(8);
+        drop(parent); // simulates the parent process exiting without writing anything
+        let outcome = watch_for_disarm_heartbeat_or_deadline(child, Duration::from_secs(5), Duration::from_secs(5)).await;
+        assert_eq!(outcome, GuardOutcome::ParentGone);
+    }
+
+    #[tokio::test]
+    async fn deadline_elapsing_with_the_pipe_still_open_and_healthy_heartbeat_still_fires() {
+        let (mut parent, child) = tokio::io::duplex(8);
+        let heartbeat_task = tokio::spawn(async move {
+            use tokio::io::AsyncWriteExt;
+            loop {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+                if parent.write_all(&[HEARTBEAT_BYTE]).await.is_err() {
+                    break;
+                }
+            }
+        });
+        // Heartbeats keep arriving well inside their own timeout, but the absolute deadline is
+        // still shorter and must win regardless -- a healthy heartbeat does not extend the
+        // deadline itself, only proves the parent isn't stalled before it.
+        let outcome =
+            watch_for_disarm_heartbeat_or_deadline(child, Duration::from_millis(60), Duration::from_secs(5)).await;
+        assert_eq!(outcome, GuardOutcome::DeadlineExpired);
+        heartbeat_task.abort();
+    }
+
+    #[tokio::test]
+    async fn disarm_arriving_just_before_deadline_still_wins() {
+        let (mut parent, child) = tokio::io::duplex(8);
+        tokio::spawn(async move {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+            use tokio::io::AsyncWriteExt;
+            let _ = parent.write_all(&[DISARM_BYTE]).await;
+        });
+        let outcome =
+            watch_for_disarm_heartbeat_or_deadline(child, Duration::from_millis(200), Duration::from_secs(5)).await;
+        assert_eq!(outcome, GuardOutcome::Disarmed);
+    }
+}
