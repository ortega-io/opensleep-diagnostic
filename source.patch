+                self.inner.read_reg(addr, reg)
+            }
+            fn write_reg(&mut self, addr: u8, reg: u8, value: u8) -> Result<(), crate::i2c::I2cIoError> {
+                self.inner.write_reg(addr, reg, value)
+            }
+        }
+        let mut mock = MockI2c::always_succeed();
+        mock.reg_state.insert((crate::i2c::RESET_EXPANDER_ADDR, 0x02), 0xFD);
+        mock.reg_state.insert((crate::i2c::RESET_EXPANDER_ADDR, 0x06), 0xFF);
+        let mut stale = StaleReg02 { inner: mock, stale_value: 0x00 };
+        let init = apply_combined_narrow_subsystem_init(&mut stale).await;
+        assert!(!init.verified);
+
+        let a = args(true);
+        let (report, code) = finish_combined_init(
+            &a,
+            true,
+            init,
+            None,
+            None,
+            0,
+            false,
+            ModeOutcome::default(),
+            SensorAudit::new(),
+            None,
+            None,
+            None,
+            None,
+            0,
+            0,
+            None,
+            None,
+            0,
+            0,
+        );
+        assert_eq!(report.overall_result, "expander_verification_failed");
+        assert_eq!(report.sensor_uart_writes, 0, "verification failure must abort before any Sensor UART writes");
+        assert_eq!(code, 13);
+    }
+
+    #[tokio::test]
+    async fn combined_init_frozen_verification_sends_no_actuator_command() {
+        let mut a = args(true);
+        a.combined_narrow_subsystem_init = true;
+        let (report, _) = run(&a).await;
+        // Mode::Passive's own whitelist structurally forbids an enabled SetTargetTemperature and
+        // Prime -- see safety::tests::passive_rejects_enabled_cooling_for_either_side /
+        // prime_is_refused_outside_prime_test_mode. This is the report-level cross-check that this
+        // mode's Frozen verification step never sets a target, primes, or otherwise actuates.
+        assert!(!report.frozen_command_sent);
+        assert!(!report.prime_command_sent);
+        assert!(!report.temperature_target_changed);
+        assert!(report.frozen_reached_firmware);
+    }
+
+    #[tokio::test]
+    async fn combined_init_sensor_discovery_tries_bootloader_before_firmware() {
+        let mut audit = SensorAudit::new();
+        let mut spontaneous_38400 = 0u64;
+        let mut spontaneous_115200 = 0u64;
+        let mut first_rx_ms = None;
+        let mut first_decoded_ms = None;
+        let mut a = args(true);
+        a.observe_seconds = 0;
+        let outcome = combined_init_sensor_probe(
+            &a,
+            &mut audit,
+            tokio::time::Instant::now(),
+            &mut spontaneous_38400,
+            &mut spontaneous_115200,
+            &mut first_rx_ms,
+            &mut first_decoded_ms,
+            {
+                let mut calls = 0u32;
+                move |_baud| {
+                    calls += 1;
+                    let (client, device) = tokio::io::duplex(4096);
+                    let _ = if calls == 1 { spawn_mock_sensor_device_bootloader(device) } else { spawn_mock_sensor_device_firmware(device) };
+                    let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+                    Ok((SensorLink::wrap_capturing(client, "test", cap.clone()), cap))
+                }
+            },
+        )
+        .await;
+        assert_eq!(outcome.bootloader_ping_response, Some(true));
+        assert!(outcome.jump_to_firmware_sent);
+        assert!(outcome.firmware_mode_confirmed);
+    }
+
+    #[tokio::test]
+    async fn combined_init_sensor_discovery_never_jumps_when_bootloader_silent() {
+        let mut audit = SensorAudit::new();
+        let mut spontaneous_38400 = 0u64;
+        let mut spontaneous_115200 = 0u64;
+        let mut first_rx_ms = None;
+        let mut first_decoded_ms = None;
+        let mut a = args(true);
+        a.observe_seconds = 0;
+        let outcome = combined_init_sensor_probe(
+            &a,
+            &mut audit,
+            tokio::time::Instant::now(),
+            &mut spontaneous_38400,
+            &mut spontaneous_115200,
+            &mut first_rx_ms,
+            &mut first_decoded_ms,
+            |_baud| {
+                let (client, device) = tokio::io::duplex(4096);
+                let _ = spawn_mock_sensor_device_silent(device);
+                let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+                Ok((SensorLink::wrap_capturing(client, "test", cap.clone()), cap))
+            },
+        )
+        .await;
+        assert_eq!(outcome.bootloader_ping_response, Some(false));
+        assert!(!outcome.jump_to_firmware_sent);
+        assert!(!outcome.firmware_mode_confirmed);
+    }
+
+    #[test]
+    fn combined_init_never_references_reset_controller() {
+        let path = concat!(env!("CARGO_MANIFEST_DIR"), "/src/bin/opensleep-diagnostic/sensor_probe.rs");
+        let src = std::fs::read_to_string(path).expect("readable source file");
+        let needle = format!("{}{}{}", "Reset", "Controller", "::");
+        assert!(!src.contains(&needle), "sensor_probe.rs must never construct/call ResetController");
+    }
+
+    #[tokio::test]
+    async fn combined_init_never_writes_register_0x07_or_0x03_end_to_end() {
+        let mut a = args(true);
+        a.combined_narrow_subsystem_init = true;
+        let (report, _) = run(&a).await;
+        // Exactly three I2C writes total (0x02 assert, 0x06 config, 0x02 release) -- if either
+        // 0x07 or 0x03 had been written, this count would be higher (see the i2c.rs-level
+        // byte-for-byte proof, `combined_init_writes_0x02_before_0x06_and_never_touches_0x07_or_0x03`,
+        // for the direct register-identity check).
+        assert_eq!(report.i2c_writes, 3);
+    }
+}
