+    // ---- item 10: bootloader-first ordering, JumpToFirmware only after bootloader confirms ----
+
+    /// Opens a fresh `tokio::io::duplex` + mock device pair per call -- `line_enable_discover_probe`
+    /// calls `open` once for bootloader baud and once for firmware baud, exactly like real hardware
+    /// closing and reopening the UART at a different baud (a genuinely independent connection each
+    /// time, unlike `run_dry_line_enable`'s single persistent mock, which is a deliberate
+    /// dry-run-only shortcut -- see that function's own doc comment). `bootloader_then_firmware`
+    /// selects which personality answers the *second* call, matching whichever behavior the test
+    /// needs to exercise for Step B independent of Step A's own outcome.
+    fn counting_mock_opener(bootloader_then_firmware: bool) -> impl FnMut(u32) -> Result<SensorLink<tokio::io::DuplexStream>, String> {
+        let mut calls = 0u32;
+        move |_baud| {
+            calls += 1;
+            let (client, device) = tokio::io::duplex(4096);
+            let _ = if calls == 1 {
+                spawn_mock_sensor_device_bootloader(device)
+            } else if bootloader_then_firmware {
+                spawn_mock_sensor_device_firmware(device)
+            } else {
+                spawn_mock_sensor_device_silent(device)
+            };
+            Ok(SensorLink::wrap(client, "test"))
+        }
+    }
