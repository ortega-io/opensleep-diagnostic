+// ---------------------------------------------------------------------------------------------
+// Packet tallying, shared by every listening context (passive per-baud, ping's incidental
+// listening, and discover's post-communication observe phase).
+// ---------------------------------------------------------------------------------------------
+
+#[derive(Default)]
+struct PacketTally {
+    frames_decoded: u64,
+    packet_type_counts: BTreeMap<&'static str, u64>,
+    capacitance_samples: u64,
+    cap_left_min: Option<u16>,
+    cap_left_max: Option<u16>,
+    cap_left_latest: Option<u16>,
+    cap_right_min: Option<u16>,
+    cap_right_max: Option<u16>,
+    cap_right_latest: Option<u16>,
+    piezo_samples: u64,
+    piezo_left_min: Option<u16>,
+    piezo_left_max: Option<u16>,
+    piezo_left_latest: Option<u16>,
+    piezo_right_min: Option<u16>,
+    piezo_right_max: Option<u16>,
+    piezo_right_latest: Option<u16>,
+    temperature_samples: u64,
+    first_valid_ts: Option<String>,
+    last_valid_ts: Option<String>,
+}
+
+fn fold_minmax(min: &mut Option<u16>, max: &mut Option<u16>, latest: &mut Option<u16>, values: &[u16]) {
+    for &v in values {
+        *min = Some(min.map_or(v, |m| m.min(v)));
+        *max = Some(max.map_or(v, |m| m.max(v)));
+        *latest = Some(v);
+    }
+}
+
+fn packet_type_name(pkt: &SensorPacket) -> &'static str {
+    match pkt {
+        SensorPacket::Pong(_) => "pong",
+        SensorPacket::Message(_) => "message",
+        SensorPacket::HardwareInfo(_) => "hardware_info",
+        SensorPacket::JumpingToFirmware(_) => "jumping_to_firmware",
+        SensorPacket::PiezoGainSet(_, _) => "piezo_gain_set",
+        SensorPacket::VibrationEnabled(_, _) => "vibration_enabled",
+        SensorPacket::GetFirmware(_) => "firmware_hash_response",
+        SensorPacket::PiezoFreqSet(_) => "piezo_freq_set",
+        SensorPacket::PiezoEnabled(_) => "piezo_enabled",
+        SensorPacket::Init(_) => "init",
+        SensorPacket::Capacitance(_) => "capacitance",
+        SensorPacket::Piezo(_) => "piezo",
+        SensorPacket::Temperature(_) => "temperature",
+        SensorPacket::AlarmSet(_) => "alarm_set",
+    }
+}
+
+impl PacketTally {
+    fn record(&mut self, pkt: &SensorPacket) {
+        self.frames_decoded += 1;
+        let now = jiff::Timestamp::now().to_string();
+        if self.first_valid_ts.is_none() {
+            self.first_valid_ts = Some(now.clone());
+        }
+        self.last_valid_ts = Some(now);
+        *self.packet_type_counts.entry(packet_type_name(pkt)).or_insert(0) += 1;
+
+        match pkt {
+            SensorPacket::Capacitance(data) => {
+                self.capacitance_samples += 1;
+                fold_minmax(&mut self.cap_left_min, &mut self.cap_left_max, &mut self.cap_left_latest, &data.values[0..3]);
+                fold_minmax(&mut self.cap_right_min, &mut self.cap_right_max, &mut self.cap_right_latest, &data.values[3..6]);
+            }
+            SensorPacket::Piezo(p) => {
+                self.piezo_samples += 1;
+                fold_minmax(&mut self.piezo_left_min, &mut self.piezo_left_max, &mut self.piezo_left_latest, &p.left_samples);
+                fold_minmax(&mut self.piezo_right_min, &mut self.piezo_right_max, &mut self.piezo_right_latest, &p.right_samples);
+            }
+            SensorPacket::Temperature(_) => self.temperature_samples += 1,
+            _ => {}
+        }
+    }
+
+    fn finalize(self, frames_found: u64) -> PacketTallyJson {
+        PacketTallyJson {
+            bytes_received: 0, // filled in by the caller, which owns the raw capture
+            frames_found,
+            frames_decoded: self.frames_decoded,
+            malformed_frames: frames_found.saturating_sub(self.frames_decoded),
+            packet_types_observed: self.packet_type_counts.into_iter().map(|(k, v)| (k.to_string(), v)).collect(),
+            capacitance_samples: self.capacitance_samples,
+            capacitance_left_min: self.cap_left_min,
+            capacitance_left_max: self.cap_left_max,
+            capacitance_left_latest: self.cap_left_latest,
+            capacitance_right_min: self.cap_right_min,
+            capacitance_right_max: self.cap_right_max,
+            capacitance_right_latest: self.cap_right_latest,
+            piezo_samples: self.piezo_samples,
+            piezo_left_min: self.piezo_left_min,
+            piezo_left_max: self.piezo_left_max,
+            piezo_left_latest: self.piezo_left_latest,
+            piezo_right_min: self.piezo_right_min,
+            piezo_right_max: self.piezo_right_max,
+            piezo_right_latest: self.piezo_right_latest,
+            temperature_samples: self.temperature_samples,
+            first_valid_packet_timestamp: self.first_valid_ts,
+            last_valid_packet_timestamp: self.last_valid_ts,
+        }
+    }
+}
+
+/// `(bytes received, candidate 0x7E frame starts)` -- see `PacketTallyJson::frames_found`'s doc
+/// comment for why the latter is a heuristic upper bound, not an exact count.
+fn tally_raw_capture(capture: &RawIoCapture) -> (u64, u64) {
+    let Ok(events) = capture.lock() else { return (0, 0) };
+    let mut bytes = 0u64;
+    let mut markers = 0u64;
+    for event in events.iter().filter(|e| e.direction == "rx") {
+        if let Some(b) = crate::io_logging::hex_to_bytes(&event.hex) {
+            bytes += b.len() as u64;
+            markers += b.iter().filter(|&&x| x == opensleep::common::codec::START).count() as u64;
+        }
+    }
+    (bytes, markers)
+}
+
+/// Listens (never sends) until `duration` elapses or the link closes, decoding every packet
+/// through the real `PacketCodec`. The sole operation `--passive` mode performs.
+async fn listen_and_tally<T: AsyncRead + AsyncWrite + Unpin>(link: &mut SensorLink<T>, duration: Duration) -> PacketTally {
+    let mut tally = PacketTally::default();
+    let deadline = tokio::time::Instant::now() + duration;
+    loop {
+        let now = tokio::time::Instant::now();
+        if now >= deadline {
+            break;
+        }
+        match link.recv(deadline - now).await {
+            Ok(PacketOutcome::Received(pkt)) => tally.record(&pkt),
+            Ok(PacketOutcome::TimedOut) | Ok(PacketOutcome::Closed) => break,
+            Err(_) => break,
+        }
+    }
+    tally
+}
+
+/// Sends `action` once, then keeps listening (never resending) until either a packet matching
+/// `want` arrives or `budget` elapses. Real Sensor firmware (and this binary's own mock) can push
+/// unsolicited telemetry (capacitance/piezo/temperature) interleaved with a solicited response --
+/// a naive single-`next()` pairing would mistake the first unrelated packet for the answer, or
+/// (worse) burn through the whole retry budget consuming unrelated packets while the real response
+/// sits unread. This drains and discards anything that doesn't match `want` instead of treating it
+/// as a failed attempt -- exactly the "do not abort merely because some packets use a firmware
+/// variant not yet understood" tolerance this feature's spec requires.
+async fn send_and_wait_for<T, F>(
+    link: &mut SensorLink<T>,
+    audit: &mut SensorAudit,
+    mode: ProbeMode,
+    action: SensorProbeAction,
+    firmware_mode_confirmed: bool,
+    budget: Duration,
+    mut want: F,
+) -> Option<SensorPacket>
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    F: FnMut(&SensorPacket) -> bool,
+{
+    let deadline = tokio::time::Instant::now() + budget;
+    let mut sent = false;
+    loop {
+        let now = tokio::time::Instant::now();
+        if now >= deadline {
+            return None;
+        }
+        let outcome = if !sent {
+            sent = true;
+            link.send(audit, mode, action, firmware_mode_confirmed, deadline - now).await
+        } else {
+            link.recv(deadline - now).await
+        };
+        match outcome {
+            Ok(PacketOutcome::Received(pkt)) if want(&pkt) => return Some(pkt),
+            Ok(PacketOutcome::Received(_)) => continue, // unsolicited packet; keep waiting
+            Ok(PacketOutcome::TimedOut) | Ok(PacketOutcome::Closed) => return None,
+            Err(LinkError::Safety(v)) => {
+                log::error!("refusing to send {}: {v}", action.name());
+                return None;
+            }
+            Err(e) => {
+                log::warn!("Sensor {} failed: {e}", action.name());
+                return None;
+            }
+        }
+    }
+}
+
+async fn try_ping<T: AsyncRead + AsyncWrite + Unpin>(
+    link: &mut SensorLink<T>,
+    audit: &mut SensorAudit,
+    mode: ProbeMode,
+    firmware_mode_confirmed: bool,
+    max_attempts: u32,
+) -> Option<bool> {
+    for _ in 0..max_attempts {
+        if let Some(SensorPacket::Pong(in_firmware)) = send_and_wait_for(
+            link,
+            audit,
+            mode,
+            SensorProbeAction::Ping,
+            firmware_mode_confirmed,
+            Duration::from_secs(1),
+            |p| matches!(p, SensorPacket::Pong(_)),
+        )
+        .await
+        {
+            return Some(in_firmware);
+        }
+    }
+    None
+}
