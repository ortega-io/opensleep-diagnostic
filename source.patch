+// ---------------------------------------------------------------------------------------------
+// --discover
+// ---------------------------------------------------------------------------------------------
+
+async fn run_real_discover(args: &SensorProbeArgs) -> (SensorProbeReport, u8) {
+    let mut audit = SensorAudit::new();
+    let mut outcome = ModeOutcome::default();
+    let mut any_bytes = false;
+    let mut bootloader_confirmed = false;
+
+    let cap_fw1: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+    let mut firmware_link: Option<SensorLink<SerialStream>> =
+        match SensorLink::<SerialStream>::open_capturing(&args.sensor_port, FIRMWARE_BAUD, cap_fw1.clone(), args.raw_serial_log) {
+            Ok(mut link) => {
+                outcome.firmware_baud_opened = true;
+                let r = try_ping(&mut link, &mut audit, ProbeMode::Discover, false, 3).await;
+                if r == Some(true) {
+                    outcome.firmware_ping_response = Some(true);
+                    outcome.firmware_mode_confirmed = true;
+                    Some(link)
+                } else {
+                    outcome.firmware_ping_response = Some(false);
+                    None
+                }
+            }
+            Err(e) => {
+                log::error!("failed to open Sensor UART @ {FIRMWARE_BAUD}: {e}");
+                None
+            }
+        };
+    let (b, _) = tally_raw_capture(&cap_fw1);
+    any_bytes |= b > 0;
+
+    if !outcome.firmware_mode_confirmed {
+        let cap_bl: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+        match SensorLink::<SerialStream>::open_capturing(&args.sensor_port, BOOTLOADER_BAUD, cap_bl.clone(), args.raw_serial_log) {
+            Ok(mut link) => {
+                outcome.bootloader_baud_opened = true;
+                let r = try_ping(&mut link, &mut audit, ProbeMode::Discover, false, 3).await;
+                bootloader_confirmed = r == Some(false);
+                outcome.bootloader_ping_response = Some(bootloader_confirmed);
+
+                if bootloader_confirmed {
+                    // Step 4: exactly one JumpToFirmware, observe the mode-switch traffic briefly.
+                    match link.send(&mut audit, ProbeMode::Discover, SensorProbeAction::JumpToFirmware, false, Duration::from_secs(1)).await {
+                        Ok(_) => outcome.jump_to_firmware_sent = true,
+                        Err(e) => log::error!("JumpToFirmware failed: {e}"),
+                    }
+                    let _ = listen_and_tally(&mut link, Duration::from_secs(2)).await;
+                    drop(link);
+
+                    let cap_fw2: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+                    match SensorLink::<SerialStream>::open_capturing(&args.sensor_port, FIRMWARE_BAUD, cap_fw2.clone(), args.raw_serial_log) {
+                        Ok(mut relink) => {
+                            let r2 = try_ping(&mut relink, &mut audit, ProbeMode::Discover, false, 3).await;
+                            if r2 == Some(true) {
+                                outcome.firmware_mode_confirmed = true;
+                                firmware_link = Some(relink);
+                            }
+                        }
+                        Err(e) => log::error!("failed to reopen Sensor UART @ {FIRMWARE_BAUD}: {e}"),
+                    }
+                    let (b2, _) = tally_raw_capture(&cap_fw2);
+                    any_bytes |= b2 > 0;
+                }
+            }
+            Err(e) => log::error!("failed to open Sensor UART @ {BOOTLOADER_BAUD}: {e}"),
+        }
+        let (b3, _) = tally_raw_capture(&cap_bl);
+        any_bytes |= b3 > 0;
+    }
+
+    if outcome.firmware_mode_confirmed
+        && let Some(link) = firmware_link.as_mut()
+    {
+        if args.query_info {
+            if let Some(SensorPacket::HardwareInfo(hw)) = send_and_wait_for(
+                link,
+                &mut audit,
+                ProbeMode::Discover,
+                SensorProbeAction::GetHardwareInfo,
+                true,
+                Duration::from_secs(1),
+                |p| matches!(p, SensorPacket::HardwareInfo(_)),
+            )
+            .await
+            {
+                outcome.hardware_info = Some(hw.to_string());
+            }
+            if let Some(SensorPacket::GetFirmware(v)) = send_and_wait_for(
+                link,
+                &mut audit,
+                ProbeMode::Discover,
+                SensorProbeAction::GetFirmwareHash,
+                true,
+                Duration::from_secs(1),
+                |p| matches!(p, SensorPacket::GetFirmware(_)),
+            )
+            .await
+            {
+                outcome.firmware_info = Some(format!("firmware hash response value: {v}"));
+            }
+        }
+
+        let observe = listen_and_tally(link, Duration::from_secs(args.observe_seconds)).await;
+        outcome.active_probe = Some(observe.finalize(0));
+    }
+
+    outcome.overall_result = if outcome.firmware_mode_confirmed {
+        "communicating_firmware"
+    } else if bootloader_confirmed {
+        "unresolved"
+    } else if any_bytes {
+        "undecodable_traffic"
+    } else {
+        "uart_silent"
+    }
+    .to_string();
+
+    finish(args, ProbeMode::Discover, false, outcome, audit)
+}
