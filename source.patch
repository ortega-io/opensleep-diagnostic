+    // -- TecSafetyState: item 1's regression fixtures, verbatim --
+
+    /// A parser returning a recognized positive state must not be treated as a generic terminal
+    /// `Some(...)` result by its caller -- so these tests exercise the caller's own exhaustive
+    /// `match` logic via [`tec_state_terminal_outcome`], not a boolean convenience method (this
+    /// crate deliberately has none -- see `TecSafetyState`'s doc comment for why a second
+    /// live-hardware incident found exactly that class of caller-side bug even after the parser
+    /// itself was already correct).
+    fn tec_state_terminal_outcome(state: TecSafetyState) -> Option<StopReason> {
+        match state {
+            TecSafetyState::Locked => Some(StopReason::TecLocked),
+            TecSafetyState::UnsafeLocking => Some(StopReason::TecUnsafeLocking),
+            TecSafetyState::SafeUnlocking | TecSafetyState::Unlocked | TecSafetyState::Unknown => None,
+        }
+    }
+
+    #[test]
+    fn safe_unlocking_is_not_a_fault() {
+        let state = parse_tec_safety_state("FW: tec[left] safe, unlocking", "left").unwrap();
+        assert_eq!(state, TecSafetyState::SafeUnlocking);
+        assert_eq!(tec_state_terminal_outcome(state), None);
+    }
+
+    #[test]
+    fn unlocked_is_not_a_fault() {
+        let state = parse_tec_safety_state("FW: tec[left] unlocked", "left").unwrap();
+        assert_eq!(state, TecSafetyState::Unlocked);
+        assert_eq!(tec_state_terminal_outcome(state), None);
+    }
+
+    #[test]
+    fn unsafe_locking_is_a_fault() {
+        let state = parse_tec_safety_state("FW: tec[left] unsafe, locking", "left").unwrap();
+        assert_eq!(state, TecSafetyState::UnsafeLocking);
+        assert_eq!(tec_state_terminal_outcome(state), Some(StopReason::TecUnsafeLocking));
+    }
+
+    #[test]
+    fn exact_locked_is_a_fault() {
+        let state = parse_tec_safety_state("FW: tec[left] locked", "left").unwrap();
+        assert_eq!(state, TecSafetyState::Locked);
+        assert_eq!(tec_state_terminal_outcome(state), Some(StopReason::TecLocked));
+    }
+
+    #[test]
+    fn unlocking_can_never_be_classified_as_locked() {
+        // The exact regression this fix addresses: a real active-phase run aborted on
+        // "FW: tec[left] safe, unlocking" because the old check was `contains("lock")`, which
+        // matches "unlocking" too. Word-tokenized classification must never conflate the two.
+        for msg in ["FW: tec[left] safe, unlocking", "FW: tec[left] unlocked"] {
+            let state = parse_tec_safety_state(msg, "left").unwrap();
+            assert_ne!(state, TecSafetyState::Locked, "{msg:?} must never classify as Locked");
+            assert_ne!(state, TecSafetyState::UnsafeLocking, "{msg:?} must never classify as UnsafeLocking");
+            assert_eq!(tec_state_terminal_outcome(state), None, "{msg:?} must never be treated as a fault");
+        }
+    }
+
+    #[test]
+    fn unrecognized_tec_message_is_unknown_not_a_fault() {
+        let state = parse_tec_safety_state("FW: tec[left] recalibrating", "left").unwrap();
+        assert_eq!(state, TecSafetyState::Unknown);
+        assert_eq!(tec_state_terminal_outcome(state), None);
+    }
+
+    #[test]
+    fn tec_safety_state_is_scoped_to_the_named_side() {
+        assert_eq!(parse_tec_safety_state("FW: tec[right] locked", "left"), None);
+        let state = parse_tec_safety_state("FW: tec[right] locked", "right").unwrap();
+        assert_eq!(tec_state_terminal_outcome(state), Some(StopReason::TecLocked));
+    }
+
+    #[test]
+    fn tec_safety_state_ignores_unrelated_messages() {
+        assert_eq!(parse_tec_safety_state("FW: flash locked", "left"), None);
+        assert_eq!(parse_tec_safety_state("FW: pump[left] slow @ 6.03V 0.17A", "left"), None);
