+// ---------------------------------------------------------------------------------------------
+// --audit-expander: read-only. No `write_reg` call anywhere in this module.
+// ---------------------------------------------------------------------------------------------
+
+const EXPANDER_REGISTERS: &[(u8, &str)] = &[
+    (0x00, "Input Port 0"),
+    (0x01, "Input Port 1"),
+    (0x02, "Output Port 0"),
+    (0x03, "Output Port 1"),
+    (0x04, "Polarity Inversion Port 0"),
+    (0x05, "Polarity Inversion Port 1"),
+    (0x06, "Configuration Port 0"),
+    (0x07, "Configuration Port 1"),
+];
+
+fn audit_expander<P: I2cPort>(dev: &mut P) -> ExpanderAudit {
+    let mut readings = Vec::with_capacity(EXPANDER_REGISTERS.len());
+    for &(reg, label) in EXPANDER_REGISTERS {
+        match dev.read_reg(crate::i2c::RESET_EXPANDER_ADDR, reg) {
+            Ok(v) => readings.push(ExpanderRegisterReading {
+                register: reg,
+                register_hex: format!("0x{reg:02X}"),
+                label,
+                success: true,
+                value: Some(v),
+                value_hex: Some(format!("0x{v:02X}")),
+                value_binary: Some(format!("0b{v:08b}")),
+                os_error: None,
+            }),
+            Err(e) => readings.push(ExpanderRegisterReading {
+                register: reg,
+                register_hex: format!("0x{reg:02X}"),
+                label,
+                success: false,
+                value: None,
+                value_hex: None,
+                value_binary: None,
+                os_error: e.os_error,
+            }),
+        }
+    }
+    ExpanderAudit { readings, read_only: true }
+}
+
+// ---------------------------------------------------------------------------------------------
+// EXPERIMENTAL: --combined-narrow-subsystem-init
+//
+// Reproduces only the port-0 portion of upstream OpenSleep's own startup sequence (bits 0 and 1
+// of PCAL6416A registers 0x02/0x06), verifies Frozen is reachable (Ping only), then probes Sensor
+// using upstream's own bootloader-first discovery ordering. See module docs and SAFETY.md.
+// ---------------------------------------------------------------------------------------------
+
+/// `/dev/ttyS2`'s index in `/proc/tty/driver/serial` on this MT8365 Hub.
+const SENSOR_TTY_INDEX: u32 = 2;
+
+/// Best-effort `/proc/tty/driver/serial` byte-counter read for `ttyS{tty_index}` -- `(rx, tx)`.
+/// `None` for either value whenever the file is unavailable, the line for that index is missing,
+/// or the expected `rx:`/`tx:` fields aren't present on it. Never treated as fatal -- see this
+/// feature's own "or equivalent internal counters if practical" framing.
+fn read_serial_counters(tty_index: u32) -> (Option<u64>, Option<u64>) {
+    let Ok(contents) = std::fs::read_to_string("/proc/tty/driver/serial") else {
+        return (None, None);
+    };
+    let prefix = format!("{tty_index}:");
+    let Some(line) = contents.lines().find(|l| l.trim_start().starts_with(&prefix)) else {
+        return (None, None);
+    };
+    (parse_counter_field(line, "rx:"), parse_counter_field(line, "tx:"))
+}
+
+fn parse_counter_field(line: &str, field: &str) -> Option<u64> {
+    let idx = line.find(field)?;
+    let rest = &line[idx + field.len()..];
+    let digits: String = rest.chars().take_while(|c| c.is_ascii_digit()).collect();
+    digits.parse().ok()
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+struct CombinedInitOutcome {
+    /// `true` iff the I2C sequence was actually attempted (whether it then succeeded or failed) --
+    /// `false` only when the I2C device itself never opened, so the register fields below were
+    /// never actually read and must be reported as `None`, not a misleading `Some(0x00)`.
+    attempted: bool,
+    verified: bool,
+    reg02_assert_original: u8,
+    reg02_assert_target: u8,
+    reg02_assert_readback: u8,
+    reg02_assert_changed_mask: u8,
+    reg06_config_original: u8,
+    reg06_config_target: u8,
+    reg06_config_readback: u8,
+    reg06_config_changed_mask: u8,
+    reg02_release_original: u8,
+    reg02_release_target: u8,
+    reg02_release_readback: u8,
+    reg02_release_changed_mask: u8,
+}
+
+/// Prints the required prominent warning, then performs and translates
+/// `i2c::configure_combined_narrow_subsystem_init`'s result. Never itself decides whether to
+/// proceed to UART probing -- callers must check `verified` first.
+async fn apply_combined_narrow_subsystem_init<P: I2cPort>(dev: &mut P) -> CombinedInitOutcome {
+    log::warn!("EXPERIMENTAL: configuring PCAL6416A port-0 bits 0 and 1 (combined narrow subsystem init).");
+    log::warn!("Bit 1 will receive the already-proven Frozen assert/hold/release pulse; bit 0 will be left asserted HIGH. No other register will be written.");
+    match configure_combined_narrow_subsystem_init(dev).await {
+        Ok(r) => CombinedInitOutcome {
+            attempted: true,
+            verified: r.fully_verified(),
+            reg02_assert_original: r.reg02_assert.original,
+            reg02_assert_target: r.reg02_assert.target,
+            reg02_assert_readback: r.reg02_assert.readback,
+            reg02_assert_changed_mask: r.reg02_assert.changed_mask,
+            reg06_config_original: r.reg06_config.original,
+            reg06_config_target: r.reg06_config.target,
+            reg06_config_readback: r.reg06_config.readback,
+            reg06_config_changed_mask: r.reg06_config.changed_mask,
+            reg02_release_original: r.reg02_release.original,
+            reg02_release_target: r.reg02_release.target,
+            reg02_release_readback: r.reg02_release.readback,
+            reg02_release_changed_mask: r.reg02_release.changed_mask,
+        },
+        Err(e) => {
+            log::error!("failed to configure combined narrow subsystem init: {e}");
+            CombinedInitOutcome { attempted: true, ..Default::default() }
+        }
+    }
+}
+
+async fn drain_frozen_startup_traffic<T: AsyncRead + AsyncWrite + Unpin>(link: &mut FrozenLink<T>, duration: Duration) {
+    let deadline = tokio::time::Instant::now() + duration;
+    loop {
+        let now = tokio::time::Instant::now();
+        if now >= deadline {
+            break;
+        }
+        match link.recv(deadline - now).await {
+            Ok(FrozenPacketOutcome::Received(_)) | Ok(FrozenPacketOutcome::TimedOut) => {}
+            Ok(FrozenPacketOutcome::Closed) | Err(_) => break,
+        }
+    }
+}
+
+/// Ping-only Frozen verification: `Mode::Passive`'s whitelist structurally forbids everything this
+/// step must never send (an enabled `SetTargetTemperature`, `Prime`) -- see module docs. Drains
+/// ~2s of startup traffic first, then Pings; a bootloader response is followed by the same
+/// already-proven bootloader-to-firmware handling `frozen-passive`/`frozen-cool-test` use
+/// (`frozen_ops::jump_to_firmware_and_wait`). Returns `true` only once application firmware
+/// actually answers.
+async fn verify_frozen_reachable<T: AsyncRead + AsyncWrite + Unpin>(link: &mut FrozenLink<T>) -> bool {
+    let mut audit = AuditedTransport::new(FrozenMode::Passive);
+    drain_frozen_startup_traffic(link, Duration::from_secs(2)).await;
+    let (ok, mode) = frozen_ops::ping(link, &mut audit, Duration::from_secs(1)).await;
+    match (ok, mode) {
+        (true, frozen_ops::DeviceMode::Firmware) => true,
+        (true, frozen_ops::DeviceMode::Bootloader) => frozen_ops::jump_to_firmware_and_wait(link, &mut audit, Duration::from_secs(1)).await,
+        _ => false,
+    }
+}
+
+/// Bootloader-first Sensor discovery (mirrors `line_enable_discover_probe`'s ordering exactly),
+/// additionally tracking `spontaneous_bytes_38400`/`spontaneous_bytes_115200` and the elapsed time
+/// to the first raw byte/decoded packet relative to `init_completed_at` -- kept as its own function
+/// rather than generalizing `line_enable_discover_probe`, for the same reason every other pair of
+/// similar-but-distinct flows in this file is kept separate.
+#[allow(clippy::too_many_arguments)]
+async fn combined_init_sensor_probe<T: AsyncRead + AsyncWrite + Unpin, O>(
+    args: &SensorProbeArgs,
+    audit: &mut SensorAudit,
+    init_completed_at: tokio::time::Instant,
+    spontaneous_bytes_38400: &mut u64,
+    spontaneous_bytes_115200: &mut u64,
+    first_rx_ms: &mut Option<u64>,
+    first_decoded_ms: &mut Option<u64>,
+    mut open: O,
+) -> ModeOutcome
+where
+    O: FnMut(u32) -> Result<(SensorLink<T>, RawIoCapture), String>,
+{
+    let mut outcome = ModeOutcome::default();
+
+    // Bootloader first.
+    if let Ok((mut link, capture)) = open(BOOTLOADER_BAUD) {
+        outcome.bootloader_baud_opened = true;
+        let _pre =
+            listen_with_enable_timing(&mut link, &capture, Duration::from_secs(1), init_completed_at, first_rx_ms, first_decoded_ms).await;
+        let (bytes, _) = tally_raw_capture(&capture);
+        *spontaneous_bytes_38400 += bytes;
+        let r = try_ping(&mut link, audit, ProbeMode::Discover, false, 3).await;
+        let bootloader_confirmed = r == Some(false);
+        outcome.bootloader_ping_response = Some(bootloader_confirmed);
+        if bootloader_confirmed {
+            match link.send(audit, ProbeMode::Discover, SensorProbeAction::JumpToFirmware, false, Duration::from_secs(1)).await {
+                Ok(_) => outcome.jump_to_firmware_sent = true,
+                Err(e) => log::error!("JumpToFirmware failed: {e}"),
+            }
+            let _ = listen_and_tally(&mut link, Duration::from_secs(2)).await; // wait for mode transition
+        }
+    } else {
+        log::error!("failed to open Sensor UART @ {BOOTLOADER_BAUD}");
+    }
+    // `link` (if any) drops here -- UART closed before the firmware-baud reopen below.
+
+    // Firmware -- always attempted, regardless of the bootloader step's outcome.
+    if let Ok((mut link, capture)) = open(FIRMWARE_BAUD) {
+        outcome.firmware_baud_opened = true;
+        let _pre =
+            listen_with_enable_timing(&mut link, &capture, Duration::from_secs(1), init_completed_at, first_rx_ms, first_decoded_ms).await;
+        let (bytes, _) = tally_raw_capture(&capture);
+        *spontaneous_bytes_115200 += bytes;
+        let r = try_ping(&mut link, audit, ProbeMode::Discover, false, 3).await;
+        outcome.firmware_ping_response = Some(matches!(r, Some(true)));
+        outcome.firmware_mode_confirmed = outcome.firmware_ping_response == Some(true);
+
+        if outcome.firmware_mode_confirmed && args.query_info {
+            if let Some(SensorPacket::HardwareInfo(hw)) = send_and_wait_for(
+                &mut link,
+                audit,
+                ProbeMode::Discover,
+                SensorProbeAction::GetHardwareInfo,
+                true,
+                Duration::from_secs(1),
+                |p| matches!(p, SensorPacket::HardwareInfo(_)),
+            )
+            .await
+            {
+                outcome.hardware_info = Some(hw.to_string());
+            }
+            if let Some(SensorPacket::GetFirmware(v)) = send_and_wait_for(
+                &mut link,
+                audit,
+                ProbeMode::Discover,
+                SensorProbeAction::GetFirmwareHash,
+                true,
+                Duration::from_secs(1),
+                |p| matches!(p, SensorPacket::GetFirmware(_)),
+            )
+            .await
+            {
+                outcome.firmware_info = Some(format!("firmware hash response value: {v}"));
+            }
+        }
+    } else {
+        log::error!("failed to open Sensor UART @ {FIRMWARE_BAUD}");
+    }
+
+    outcome
+}
+
+#[allow(clippy::too_many_arguments)]
+fn finish_combined_init(
+    args: &SensorProbeArgs,
+    dry_run: bool,
+    init: CombinedInitOutcome,
+    audit_before: Option<ExpanderAudit>,
+    audit_after: Option<ExpanderAudit>,
+    frozen_uart_opens: u32,
+    frozen_reached_firmware: bool,
+    sensor_probe: ModeOutcome,
+    sensor_audit: SensorAudit,
+    rx_before: Option<u64>,
+    tx_before: Option<u64>,
+    rx_after: Option<u64>,
+    tx_after: Option<u64>,
+    spontaneous_bytes_38400: u64,
+    spontaneous_bytes_115200: u64,
+    first_sensor_rx_after_init_ms: Option<u64>,
+    first_decoded_sensor_packet_after_init_ms: Option<u64>,
+    i2c_reads: u32,
+    i2c_writes: u32,
+) -> (SensorProbeReport, u8) {
+    let mut r = base_report(args, ProbeMode::Discover, dry_run);
+    r.mode = "combined-narrow-subsystem-init".to_string();
+
+    r.combined_init_verified = init.verified;
+    // `None` (not a misleading `Some(0x00)`) whenever the I2C sequence was never actually
+    // attempted at all (the device failed to open) -- see `CombinedInitOutcome::attempted`'s doc
+    // comment.
+    let opt = |v: u8| init.attempted.then_some(v);
+    r.combined_reg02_assert_original = opt(init.reg02_assert_original);
+    r.combined_reg02_assert_target = opt(init.reg02_assert_target);
+    r.combined_reg02_assert_readback = opt(init.reg02_assert_readback);
+    r.combined_reg02_assert_changed_mask = opt(init.reg02_assert_changed_mask);
+    r.combined_reg06_config_original = opt(init.reg06_config_original);
+    r.combined_reg06_config_target = opt(init.reg06_config_target);
+    r.combined_reg06_config_readback = opt(init.reg06_config_readback);
+    r.combined_reg06_config_changed_mask = opt(init.reg06_config_changed_mask);
+    r.combined_reg02_release_original = opt(init.reg02_release_original);
+    r.combined_reg02_release_target = opt(init.reg02_release_target);
+    r.combined_reg02_release_readback = opt(init.reg02_release_readback);
+    r.combined_reg02_release_changed_mask = opt(init.reg02_release_changed_mask);
+
+    let reg07_before = audit_before.as_ref().and_then(|a| a.readings.iter().find(|x| x.register == 0x07)).and_then(|x| x.value);
+    let reg07_after = audit_after.as_ref().and_then(|a| a.readings.iter().find(|x| x.register == 0x07)).and_then(|x| x.value);
+    r.combined_reg07_original = reg07_before;
+    r.combined_reg07_final = reg07_after;
+    r.combined_reg07_preserved = reg07_before.is_some() && reg07_before == reg07_after;
+
+    r.expander_audit_before = audit_before;
+    r.expander_audit_after = audit_after;
+
+    r.frozen_uart_opens = frozen_uart_opens;
+    r.frozen_reached_firmware = frozen_reached_firmware;
+
+    r.firmware_baud_opened = sensor_probe.firmware_baud_opened;
+    r.bootloader_baud_opened = sensor_probe.bootloader_baud_opened;
+    r.bootloader_ping_response = sensor_probe.bootloader_ping_response;
+    r.firmware_ping_response = sensor_probe.firmware_ping_response;
+    r.jump_to_firmware_sent = sensor_probe.jump_to_firmware_sent;
+    r.firmware_mode_confirmed = sensor_probe.firmware_mode_confirmed;
+    r.hardware_info = sensor_probe.hardware_info;
+    r.firmware_info = sensor_probe.firmware_info;
+    r.sensor_bootloader_confirmed = sensor_probe.bootloader_ping_response == Some(true);
+    r.sensor_firmware_confirmed = sensor_probe.firmware_mode_confirmed;
+
+    r.rx_count_before = rx_before;
+    r.tx_count_before = tx_before;
+    r.rx_count_after = rx_after;
+    r.tx_count_after = tx_after;
+    r.spontaneous_bytes_38400 = spontaneous_bytes_38400;
+    r.spontaneous_bytes_115200 = spontaneous_bytes_115200;
+    r.first_sensor_rx_after_init_ms = first_sensor_rx_after_init_ms;
+    r.first_decoded_sensor_packet_after_init_ms = first_decoded_sensor_packet_after_init_ms;
+
+    r.sensor_uart_writes = sensor_audit.sensor_uart_writes;
+    r.actuator_commands_sent = sensor_audit.actuator_commands_sent;
+    r.i2c_reads = i2c_reads;
+    r.i2c_writes = i2c_writes;
+
+    let spontaneous_seen = spontaneous_bytes_38400 > 0 || spontaneous_bytes_115200 > 0;
+
+    r.overall_result = if !init.verified {
+        "expander_verification_failed"
+    } else if r.sensor_firmware_confirmed {
+        "sensor_firmware_alive_after_combined_init"
+    } else if r.sensor_bootloader_confirmed {
+        "sensor_bootloader_alive_after_combined_init"
+    } else if spontaneous_seen {
+        "sensor_rx_activity_after_combined_init"
+    } else if frozen_reached_firmware {
+        "frozen_alive_sensor_silent"
+    } else {
+        "sensor_still_silent_after_combined_init"
+    }
+    .to_string();
+    r.exit_code = exit_code_for(&r.overall_result);
+    let code = r.exit_code;
+    (r, code)
+}
+
+async fn run_combined_narrow_subsystem_init(args: &SensorProbeArgs) -> (SensorProbeReport, u8) {
+    if args.dry_run { run_dry_combined_init(args).await } else { run_real_combined_init(args).await }
+}
+
+async fn run_real_combined_init(args: &SensorProbeArgs) -> (SensorProbeReport, u8) {
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("failed to open I2C device {} for --combined-narrow-subsystem-init: {e}", args.i2c_device);
+            return finish_combined_init(
+                args,
+                false,
+                CombinedInitOutcome::default(),
+                None,
+                None,
+                0,
+                false,
+                ModeOutcome::default(),
+                SensorAudit::new(),
+                None,
+                None,
+                None,
+                None,
+                0,
+                0,
+                None,
+                None,
+                0,
+                0,
+            );
+        }
+    };
+
+    let (rx_before, tx_before) = read_serial_counters(SENSOR_TTY_INDEX);
+    let audit_before = audit_expander(&mut i2c);
+    let mut i2c_reads = audit_before.readings.len() as u32;
+
+    let init = apply_combined_narrow_subsystem_init(&mut i2c).await;
+    // Three writes (0x02 assert, 0x06 config, 0x02 release), each with a read-then-readback (2
+    // reads per step).
+    i2c_reads += 6;
+    let i2c_writes = 3u32;
+
+    let audit_after = audit_expander(&mut i2c);
+    i2c_reads += audit_after.readings.len() as u32;
+
+    if !init.verified {
+        log::error!("expander verification failed (changed a bit other than bits 0/1, or a readback mismatch): aborting before any UART probing");
+        return finish_combined_init(
+            args,
+            false,
+            init,
+            Some(audit_before),
+            Some(audit_after),
+            0,
+            false,
+            ModeOutcome::default(),
+            SensorAudit::new(),
+            rx_before,
+            tx_before,
+            None,
+            None,
+            0,
+            0,
+            None,
+            None,
+            i2c_reads,
+            i2c_writes,
+        );
+    }
+
+    let mut frozen_uart_opens = 0u32;
+    let mut frozen_reached_firmware = false;
+    match FrozenLink::<SerialStream>::open(&args.frozen_port) {
+        Ok(mut flink) => {
+            frozen_uart_opens += 1;
+            frozen_reached_firmware = verify_frozen_reachable(&mut flink).await;
+        }
+        Err(e) => {
+            frozen_uart_opens += 1;
+            log::error!("failed to open Frozen UART {} for verification: {e}", args.frozen_port);
+        }
+    }
+    log::info!("frozen_reached_firmware={frozen_reached_firmware} (verification only -- no target set, no Prime, no pump/cooling started)");
+
+    let mut sensor_audit = SensorAudit::new();
+    let init_completed_at = tokio::time::Instant::now();
+    let mut spontaneous_bytes_38400 = 0u64;
+    let mut spontaneous_bytes_115200 = 0u64;
+    let mut first_rx_ms = None;
+    let mut first_decoded_ms = None;
+
+    let sensor_probe = combined_init_sensor_probe(
+        args,
+        &mut sensor_audit,
+        init_completed_at,
+        &mut spontaneous_bytes_38400,
+        &mut spontaneous_bytes_115200,
+        &mut first_rx_ms,
+        &mut first_decoded_ms,
+        |baud| {
+            let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+            SensorLink::<SerialStream>::open_capturing(&args.sensor_port, baud, cap.clone(), args.raw_serial_log)
+                .map(|l| (l, cap))
+                .map_err(|e| e.to_string())
+        },
+    )
+    .await;
+
+    let (rx_after, tx_after) = read_serial_counters(SENSOR_TTY_INDEX);
+
+    finish_combined_init(
+        args,
+        false,
+        init,
+        Some(audit_before),
+        Some(audit_after),
+        frozen_uart_opens,
+        frozen_reached_firmware,
+        sensor_probe,
+        sensor_audit,
+        rx_before,
+        tx_before,
+        rx_after,
+        tx_after,
+        spontaneous_bytes_38400,
+        spontaneous_bytes_115200,
+        first_rx_ms,
+        first_decoded_ms,
+        i2c_reads,
+        i2c_writes,
+    )
+}
+
+async fn run_dry_combined_init(args: &SensorProbeArgs) -> (SensorProbeReport, u8) {
+    let mut mock = MockI2c::always_succeed();
+    // Matches this feature's own motivating hardware evidence: reg 0x02 = 0xFD, reg 0x06 = 0xFF
+    // (bit 0 already configured HIGH by a prior --enable-suspected-sensor-line run; bit 1 still an
+    // input) -- so --dry-run demonstrates the interesting "both bits become outputs, bit 1 pulses"
+    // case rather than the degenerate all-zeros mock default.
+    mock.reg_state.insert((crate::i2c::RESET_EXPANDER_ADDR, 0x02), 0xFD);
+    mock.reg_state.insert((crate::i2c::RESET_EXPANDER_ADDR, 0x06), 0xFF);
+    // Real hardware evidence: this Hub's register 0x07 reads 0x77, never touched by this feature
+    // -- seeded here so --dry-run's own `combined_reg07_preserved` demonstrates `true` rather than
+    // `false` purely because the mock never had 0x07 seeded at all.
+    mock.reg_state.insert((crate::i2c::RESET_EXPANDER_ADDR, 0x07), 0x77);
+
+    let audit_before = audit_expander(&mut mock);
+    let init = apply_combined_narrow_subsystem_init(&mut mock).await;
+    let audit_after = audit_expander(&mut mock);
+    let i2c_reads = (audit_before.readings.len() + audit_after.readings.len()) as u32 + 6;
+    let i2c_writes = mock.writes.len() as u32;
+
+    if !init.verified {
+        return finish_combined_init(
+            args,
+            true,
+            init,
+            Some(audit_before),
+            Some(audit_after),
+            0,
+            false,
+            ModeOutcome::default(),
+            SensorAudit::new(),
+            None,
+            None,
+            None,
+            None,
+            0,
+            0,
+            None,
+            None,
+            i2c_reads,
+            i2c_writes,
+        );
+    }
+
+    // Dry-run Frozen verification against the same mocked Frozen device other dry-run paths use
+    // (`crate::mock::mock_frozen_link_pair` -- already-in-firmware, answers Ping immediately).
+    let (frozen_client, frozen_task) = mock_frozen_link_pair();
+    let mut flink = FrozenLink::wrap(frozen_client, "dry-run");
+    let frozen_reached_firmware = verify_frozen_reachable(&mut flink).await;
+    drop(flink);
+    frozen_task.abort();
+    log::info!("frozen_reached_firmware={frozen_reached_firmware} (verification only -- no target set, no Prime, no pump/cooling started)");
+
+    let mut sensor_audit = SensorAudit::new();
+    let init_completed_at = tokio::time::Instant::now();
+    let mut spontaneous_bytes_38400 = 0u64;
+    let mut spontaneous_bytes_115200 = 0u64;
+    let mut first_rx_ms = None;
+    let mut first_decoded_ms = None;
+
+    // Same persistent-mock approach `run_dry_line_enable` uses -- a single simulated Sensor device
+    // reused across the bootloader-baud and firmware-baud "opens" -- see that function's own doc
+    // comment for why this is a deliberate dry-run-only shortcut, not a faithful simulation of a
+    // real UART reopen.
+    let sensor_probe = combined_init_sensor_probe(
+        args,
+        &mut sensor_audit,
+        init_completed_at,
+        &mut spontaneous_bytes_38400,
+        &mut spontaneous_bytes_115200,
+        &mut first_rx_ms,
+        &mut first_decoded_ms,
+        {
+            let mut calls = 0u32;
+            move |_baud| {
+                calls += 1;
+                let (client, device) = tokio::io::duplex(4096);
+                let _ = if calls == 1 { spawn_mock_sensor_device_bootloader(device) } else { spawn_mock_sensor_device_firmware(device) };
+                let cap: RawIoCapture = Arc::new(Mutex::new(Vec::new()));
+                Ok((SensorLink::wrap_capturing(client, "dry-run", cap.clone()), cap))
+            }
+        },
+    )
+    .await;
+
+    finish_combined_init(
+        args,
+        true,
+        init,
+        Some(audit_before),
+        Some(audit_after),
+        1,
+        frozen_reached_firmware,
+        sensor_probe,
+        sensor_audit,
+        None,
+        None,
+        None,
+        None,
+        spontaneous_bytes_38400,
+        spontaneous_bytes_115200,
+        first_rx_ms,
+        first_decoded_ms,
+        i2c_reads,
+        i2c_writes,
+    )
+}
+
