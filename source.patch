diff --git a/src/bin/opensleep-diagnostic/buildinfo.rs b/src/bin/opensleep-diagnostic/buildinfo.rs
new file mode 100644
index 0000000..be05be7
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/buildinfo.rs
@@ -0,0 +1,54 @@
+//! Build/source identifiers reported in every summary.
+
+pub const DIAGNOSTIC_VERSION: &str = env!("CARGO_PKG_VERSION");
+
+pub fn source_commit() -> &'static str {
+    option_env!("OPENSLEEP_SOURCE_COMMIT")
+        .unwrap_or("unknown (set OPENSLEEP_SOURCE_COMMIT at build time)")
+}
+
+pub fn kernel_release() -> String {
+    std::fs::read_to_string("/proc/sys/kernel/osrelease")
+        .map(|s| s.trim().to_string())
+        .unwrap_or_else(|_| "unknown".to_string())
+}
+
+/// Installs the process-wide logger. Every subcommand shares this one `env_logger::Builder::init`
+/// call (it can only be called once per process) -- the custom `format` closure below is what lets
+/// `frozen-prime-opensleep-init` observe messages logged by the real, unmodified upstream `frozen`/
+/// `sensor`/`reset` modules of the `opensleep` library it calls into (see `log_tap`'s module docs),
+/// without installing a second logger or modifying that code. For every
+/// other subcommand this is a single relaxed atomic load per log line (see `log_tap::observe`).
+///
+/// `opensleep::frozen` is always filtered at `debug` regardless of `--verbose`: the capwater/
+/// flowrate-unavailable messages `frozen-prime-opensleep-init` must detect are logged by that real
+/// upstream code at `debug` level (`frozen::state::FrozenState::handle_packet`'s fallback
+/// `log::debug!("Message: {msg}")` branch), and skipping them by default would silently defeat
+/// that detection. No other subcommand ever logs under the `opensleep::frozen` target (they use
+/// this binary's own `crate::frozen_ops`/`crate::link` modules instead), so this has no effect on
+/// them.
+pub fn init_logging(verbose: bool) {
+    use std::io::Write as _;
+
+    let default_level = if verbose { "debug" } else { "info" };
+    env_logger::Builder::from_env(env_logger::Env::default().default_filter_or(default_level))
+        .filter_module("opensleep::frozen", log::LevelFilter::Debug)
+        .format(|buf, record| {
+            let target = record.target();
+            let message = record.args().to_string();
+            crate::log_tap::observe(target, &message);
+            if crate::compat_counters::is_known_compat_noise(target, &message) {
+                // Known, now-handled-elsewhere protocol-compatibility noise (see that module's
+                // docs) -- suppressed instead of dumping the full raw buffer on every occurrence;
+                // `frozen_compat::CompatFrameScanner` tracks the real counts.
+                return Ok(());
+            }
+            writeln!(
+                buf,
+                "[{} {:5} {target}] {message}",
+                buf.timestamp(),
+                record.level()
+            )
+        })
+        .init();
+}
diff --git a/src/bin/opensleep-diagnostic/cli.rs b/src/bin/opensleep-diagnostic/cli.rs
new file mode 100644
index 0000000..b7cae81
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/cli.rs
@@ -0,0 +1,389 @@
+//! CLI surface. Every flag here maps to a fixed, validated field -- there is no flag that accepts
+//! a raw opcode, a raw frame, or an arbitrary absolute temperature target. Side selection is a
+//! closed `ValueEnum`; the cooling delta and duration are validated in `cool_test.rs` against
+//! hard-coded maximums that no flag can override.
+
+use clap::{Parser, Subcommand, ValueEnum};
+use opensleep::common::packet::BedSide;
+
+/// Staged, Frozen-only hardware diagnostic for an Eight Sleep Pod 3 Hub. Every subcommand except
+/// `frozen-prime-opensleep-init` never runs normal OpenSleep, MQTT, profiles, Sensor management,
+/// LED management, or scheduled priming -- `frozen-prime-opensleep-init` is the one deliberate
+/// exception: it reuses the real, unmodified upstream initialization/manager code (see that
+/// module's docs) rather than the diagnostic's own reimplemented transport.
+#[derive(Parser, Debug)]
+#[command(name = "opensleep-diagnostic", version, about, long_about = None)]
+pub struct Cli {
+    #[command(subcommand)]
+    pub command: Commands,
+}
+
+#[derive(Subcommand, Debug, Clone)]
+pub enum Commands {
+    /// Read-only-effect Frozen probe: safe with the cover disconnected and no water.
+    FrozenPassive(PassiveArgs),
+    /// Intentionally activates one cooling channel. Requires a filled, connected hydraulic loop.
+    FrozenCoolTest(CoolTestArgs),
+    /// Independent fast-path: disable both sides and assert subsystem reset, then exit.
+    EmergencyStop(EmergencyArgs),
+    /// Intentionally fills an empty hydraulic loop by sending Prime exactly once, via the
+    /// diagnostic's own reimplemented transport and reset sequence. Requires a connected cover
+    /// with an empty/partially-filled reservoir topped up with water.
+    FrozenPrimeTest(PrimeTestArgs),
+    /// Intentionally fills an empty hydraulic loop by sending Prime exactly once, via the real,
+    /// unmodified upstream OpenSleep initialization and Frozen manager code (not a reimplemented
+    /// transport). Requires a connected cover with an empty/partially-filled reservoir topped up
+    /// with water. See `prime_opensleep_init` module docs and SAFETY.md for how this differs from
+    /// `frozen-prime-test`.
+    #[command(name = "frozen-prime-opensleep-init")]
+    FrozenPrimeOpenSleepInit(PrimeOpenSleepInitArgs),
+    /// Internal only, never documented in RUN_ON_POD.md: `frozen-cool-test --firmware-authoritative`'s
+    /// own independent shutdown guard, re-exec'd as a separate OS process (not merely a thread) so
+    /// it survives the main observer process crashing outright -- see `guard.rs` module docs. Reads
+    /// a single disarm byte from its own stdin pipe; if the arm window elapses (or that pipe closes
+    /// without the disarm byte first) before that happens, it opens the real Frozen UART/I2C itself
+    /// and runs the same disable sequence `cool_test.rs` uses.
+    #[command(name = "internal-cool-test-guard", hide = true)]
+    InternalCoolTestGuard(GuardArgs),
+}
+
+#[derive(ValueEnum, Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Side {
+    Left,
+    Right,
+}
+
+impl From<Side> for BedSide {
+    fn from(s: Side) -> Self {
+        match s {
+            Side::Left => BedSide::Left,
+            Side::Right => BedSide::Right,
+        }
+    }
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct PassiveArgs {
+    /// I2C device used to probe the reset/enable expander (0x20) and LED controller (0x53)
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    /// Serial port for the Frozen subsystem
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    /// Run the known 0x20 reset-expander sequence before the UART tests
+    #[arg(long, default_value_t = false)]
+    pub reset_subsystems: bool,
+
+    /// Allow sending JumpToFirmware if Frozen is found in its bootloader. Without this flag,
+    /// bootloader-mode Frozen is reported as such and the run stops there.
+    #[arg(long, default_value_t = false)]
+    pub allow_firmware_jump: bool,
+
+    /// How long to poll GetTemperatures (once per second) after the safety-off commands
+    #[arg(long, default_value_t = 15)]
+    pub duration_seconds: u64,
+
+    /// Write the structured result summary as JSON to this path
+    #[arg(long, value_name = "PATH")]
+    pub json_output: Option<String>,
+
+    /// Write decoded telemetry samples as CSV to this path
+    #[arg(long, value_name = "PATH")]
+    pub csv_output: Option<String>,
+
+    /// Verbose logging: raw TX/RX frame hex and decoded packets
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes; print every command that would be sent against a mocked
+    /// Frozen device instead
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct CoolTestArgs {
+    /// Which single cooling channel to enable. Exactly one side per invocation; the other side
+    /// is kept explicitly disabled for the whole run.
+    #[arg(long, value_enum)]
+    pub side: Side,
+
+    /// Cooling delta below the measured baseline water temperature, in degrees C. No fixed
+    /// host-side maximum: a live-hardware run conclusively demonstrated working cooling,
+    /// circulation, fan control, TEC operation, temperature reduction, and verified shutdown well
+    /// above the former 2.0C cap, and Frozen firmware -- not this host-side check -- remains
+    /// responsible for PID regulation, TEC current protection, thermal protection, and target
+    /// maintenance. Defaults to 1.0C when neither this nor `--target-c` is supplied; that default
+    /// is not a maximum. Mutually exclusive with `--target-c`. A resulting delta above 2.0C
+    /// requires `--confirm-large-temperature-delta`.
+    #[arg(long, value_name = "DELTA_C")]
+    pub delta_c: Option<f64>,
+
+    /// Absolute cooling target in degrees C, instead of a delta below the measured baseline.
+    /// Mutually exclusive with `--delta-c`. Validated against the measured baseline and the
+    /// Frozen protocol's representable range once baseline collection completes. A resulting
+    /// delta (baseline minus this target) above 2.0C requires
+    /// `--confirm-large-temperature-delta`.
+    #[arg(long, value_name = "TARGET_C")]
+    pub target_c: Option<f64>,
+
+    /// Active-phase duration in seconds. Defaults to 120 seconds -- long enough to establish
+    /// meaningful water-temperature movement through the filled cover loop; hard-capped at 900
+    /// seconds (15 minutes) regardless -- no flag can raise that cap. The test still stops early
+    /// on a safety condition, communication loss, or an operator interrupt (durations above 300
+    /// seconds require `--confirm-extended-test`); in `--firmware-authoritative` mode, reaching
+    /// the requested target no longer stops the test early either -- Frozen keeps maintaining it
+    /// for the rest of the requested duration.
+    #[arg(long, default_value_t = crate::cool_test::DEFAULT_DURATION_SECONDS)]
+    pub duration_seconds: u64,
+
+    /// Required: operator declares the hydraulic cover is connected
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_hydraulics_connected: bool,
+
+    /// Required: operator declares the water loop is filled
+    #[arg(long, default_value_t = false)]
+    pub confirm_water_loop_filled: bool,
+
+    /// Required: operator declares there are no visible leaks
+    #[arg(long, default_value_t = false)]
+    pub confirm_no_visible_leaks: bool,
+
+    /// Required: operator explicitly confirms this is an active (actuating) test
+    #[arg(long, default_value_t = false)]
+    pub confirm_active_test: bool,
+
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    #[arg(long, value_name = "PATH")]
+    pub json_output: Option<String>,
+
+    #[arg(long, value_name = "PATH")]
+    pub csv_output: Option<String>,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes; run the full preflight/confirmation/reporting logic against
+    /// a mocked Frozen device instead.
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+
+    /// Opt-in: also print "Frozen RX/TX raw (...)" byte-array debug log lines for every chunk
+    /// crossing the Frozen UART. Off by default (even under --verbose) because it makes normal
+    /// logs extremely noisy; works independently of --verbose.
+    #[arg(long, default_value_t = false)]
+    pub raw_serial_log: bool,
+
+    /// After the target is successfully enabled, let Frozen firmware own pump sequencing, TEC
+    /// ramping, PID control, solenoid control, fan control, current safety, thermal regulation,
+    /// and target maintenance -- this binary becomes an observer plus a bounded stop timer. It
+    /// will not disable cooling merely because its own inferred pump/TEC/temperature state is
+    /// incomplete, delayed, reordered, or temporarily stale (the legacy active loop's host-side
+    /// heuristics -- pump-startup-not-confirmed, the communication/temperature watchdogs, generic
+    /// firmware-message keyword scanning, stopping early on target attainment -- are all disabled
+    /// in this mode); only an explicit TEC safety-lock message, an explicit recognized firmware
+    /// safety-fault message, the enabled target being explicitly lost, a fatal UART error, an
+    /// internal error, operator abort, a signal, or the requested duration expiring can end the
+    /// run. Does not change the default (120s) or hard-maximum (900s) duration or any
+    /// preflight/confirmation requirement. See SAFETY.md for the full rationale.
+    #[arg(long, default_value_t = false)]
+    pub firmware_authoritative: bool,
+
+    /// Never prompt for or read interactive confirmation input: no typed confirmation phrases (this
+    /// binary no longer has any), no waiting for Enter, no post-run operator questionnaire. The
+    /// required `--confirm-*` flags above are the acknowledgement mechanism instead, checked purely
+    /// from the command line, so a fully specified command proceeds straight through command-line
+    /// validation and automated preflight with no further questions. Live typed-ABORT handling
+    /// during the active phase is still available whenever stdin is actually a TTY, and
+    /// SIGINT/SIGTERM handling is always active regardless of stdin -- neither depends on this flag.
+    #[arg(long, default_value_t = false)]
+    pub non_interactive: bool,
+
+    /// Required acknowledgement when `--duration-seconds` exceeds 300. Replaces the former typed
+    /// "RUN EXTENDED COOLING TEST FOR UP TO 15 MINUTES" confirmation phrase with a plain,
+    /// scriptable command-line flag; checked before any I2C/UART access.
+    #[arg(long, default_value_t = false)]
+    pub confirm_extended_test: bool,
+
+    /// Required acknowledgement when the requested (or, via `--target-c`, computed) cooling delta
+    /// exceeds 2.0C. This is an auditable acknowledgement only -- it does not itself impose any
+    /// maximum, and no flag can raise a limit that no longer exists (see `--delta-c`).
+    #[arg(long, default_value_t = false)]
+    pub confirm_large_temperature_delta: bool,
+
+    /// Optional free-text note attached to the report (`operator_note`). Never required and never
+    /// prompted for.
+    #[arg(long, value_name = "TEXT")]
+    pub operator_note: Option<String>,
+
+    /// Testing/CI escape hatch only: skips spawning the real independent shutdown guard
+    /// subprocess (which would try to open real hardware) even for a non-`--dry-run` invocation.
+    /// Never set by RUN_ON_POD.md's documented usage.
+    #[arg(long, hide = true)]
+    pub skip_independent_guard: bool,
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct PrimeTestArgs {
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    /// Maximum supervised observation window in seconds. Minimum 5, hard-capped at 60 -- no flag
+    /// can raise that cap. If firmware reports priming completed earlier, the test stops early.
+    #[arg(long, default_value_t = 30)]
+    pub duration_seconds: u64,
+
+    /// Required: operator declares the hydraulic cover is connected
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_hydraulics_connected: bool,
+
+    /// Required: operator declares the reservoir has been filled (or topped up) with water
+    #[arg(long, default_value_t = false)]
+    pub confirm_reservoir_filled: bool,
+
+    /// Required: operator declares the cover's hydraulic loop is empty or needs priming
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_loop_needs_priming: bool,
+
+    /// Required: operator declares there are no visible leaks
+    #[arg(long, default_value_t = false)]
+    pub confirm_no_visible_leaks: bool,
+
+    /// Required: operator explicitly confirms this is an active (actuating) test
+    #[arg(long, default_value_t = false)]
+    pub confirm_active_test: bool,
+
+    #[arg(long, value_name = "PATH")]
+    pub json_output: Option<String>,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes; run the full preflight/confirmation/reporting logic against
+    /// a mocked Frozen device instead. The interactive typed-phrase confirmations are still
+    /// required unless stdin is not a TTY.
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+
+    /// Testing/CI escape hatch only: skips the interactive typed-phrase confirmations even when
+    /// stdin is a TTY, by supplying the phrases directly. Never documented as a normal operator
+    /// flag in RUN_ON_POD.md.
+    #[arg(long, hide = true)]
+    pub assume_interactive_phrase: Option<String>,
+    #[arg(long, hide = true)]
+    pub assume_start_phrase: Option<String>,
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct PrimeOpenSleepInitArgs {
+    /// Required: operator declares the hydraulic cover is connected
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_hydraulics_connected: bool,
+
+    /// Required: operator declares the reservoir has been filled (or topped up) with water
+    #[arg(long, default_value_t = false)]
+    pub confirm_reservoir_filled: bool,
+
+    /// Required: operator declares the cover's hydraulic loop is empty or needs priming
+    #[arg(long, default_value_t = false)]
+    pub confirm_cover_loop_needs_priming: bool,
+
+    /// Required: operator declares there are no visible leaks
+    #[arg(long, default_value_t = false)]
+    pub confirm_no_visible_leaks: bool,
+
+    /// Required: operator explicitly confirms this is an active (actuating) test
+    #[arg(long, default_value_t = false)]
+    pub confirm_active_test: bool,
+
+    #[arg(long, value_name = "PATH")]
+    pub json_output: Option<String>,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes: skip real OpenSleep initialization entirely and only
+    /// validate confirmations/arguments. Unlike this binary's other --dry-run modes, this cannot
+    /// run the real, unmodified upstream reset/manager code against a mock -- that code hardcodes
+    /// real serial ports and I2C devices and has no transport abstraction to substitute one into.
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+
+    /// Minimal startup mode: instead of the full upstream reset (ResetController) or the previous
+    /// --preserve-boot-state behavior, release Frozen from reset by pulsing only bit 1 of I2C
+    /// expander register 0x02 low->high->low (assert then release, each a read-modify-write that
+    /// preserves every other bit), first configuring only bit 1 of register 0x06 as an output (so
+    /// the pin is actually driven), and never writing register 0x07. This replaces both the global
+    /// OpenSleep reset and --preserve-boot-state; it does not call opensleep::reset::ResetController
+    /// and does not run the real upstream Frozen or Sensor manager tasks.
+    #[arg(long, default_value_t = false)]
+    pub release_frozen_only: bool,
+
+    /// Testing/CI escape hatch only: skips the interactive typed-phrase confirmations even when
+    /// stdin is a TTY, by supplying the phrases directly. Never documented as a normal operator
+    /// flag in RUN_ON_POD.md.
+    #[arg(long, hide = true)]
+    pub assume_interactive_phrase: Option<String>,
+    #[arg(long, hide = true)]
+    pub assume_start_phrase: Option<String>,
+    /// Testing/CI escape hatch only: supplies the "RESERVOIR INDICATOR IS STILL WORKING"
+    /// confirmation phrase required immediately before Prime in --release-frozen-only mode.
+    #[arg(long, hide = true)]
+    pub assume_reservoir_phrase: Option<String>,
+}
+
+#[derive(clap::Args, Debug, Clone)]
+pub struct EmergencyArgs {
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+
+    /// Perform no I2C or UART writes; print what would be sent instead
+    #[arg(long, default_value_t = false)]
+    pub dry_run: bool,
+}
+
+/// Args for the hidden `internal-cool-test-guard` subcommand -- see `guard.rs` module docs and
+/// `Commands::InternalCoolTestGuard`'s doc comment. Never invoked directly by an operator: only
+/// `cool_test.rs` spawns this, as a child process of itself, when `--firmware-authoritative` is
+/// used against real hardware.
+#[derive(clap::Args, Debug, Clone)]
+pub struct GuardArgs {
+    #[arg(long, default_value = "/dev/i2c-1")]
+    pub i2c_device: String,
+
+    #[arg(long, default_value = "/dev/ttyS1")]
+    pub frozen_port: String,
+
+    /// The single side the parent run enabled -- the guard's own disable sequence (borrowed
+    /// directly from `cool_test::run_cool_test_shutdown`) always addresses both sides regardless,
+    /// exactly like the parent's own shutdown; this is only used for that function's logging/audit
+    /// context.
+    #[arg(long, value_enum)]
+    pub side: Side,
+
+    /// How long, in seconds from process start, to wait for a disarm byte on stdin before opening
+    /// the real Frozen UART/I2C itself and running the disable sequence. Already includes the
+    /// parent's requested active-phase duration plus a small grace period -- see
+    /// `cool_test::spawn_independent_guard`.
+    #[arg(long)]
+    pub arm_seconds: f64,
+
+    #[arg(long, default_value_t = false)]
+    pub verbose: bool,
+}
diff --git a/src/bin/opensleep-diagnostic/compat_counters.rs b/src/bin/opensleep-diagnostic/compat_counters.rs
new file mode 100644
index 0000000..1ffa228
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/compat_counters.rs
@@ -0,0 +1,139 @@
+//! Global, opt-in suppression of specific, known-noisy log lines that `opensleep::common::codec`'s
+//! unmodified `PacketCodec::decode` emits via its own `log::error!("{e}")` call whenever a
+//! checksum-valid frame fails `FrozenPacket::parse` (e.g. the firmware-specific 14-byte
+//! `GetTemperature` reply this binary now decodes itself -- see `frozen_compat.rs`, or the 0x54/
+//! 0x55/9-byte-heartbeat frames this binary only counts). That call cannot be modified or
+//! suppressed at its call site (`opensleep::common::codec` is pinned, unmodified upstream source),
+//! so the only place left to intercept it is the process-wide `env_logger` format closure
+//! (`buildinfo::init_logging`) that already exists for `log_tap`'s own, similarly-shaped purpose.
+//!
+//! Matching is by *stable prefix* of the exact, compile-time-known `thiserror` `Display` strings
+//! from `opensleep::common::packet::PacketError` (`InvalidSize`/`Unexpected`), not by parsing the
+//! trailing `Buffer: ...` dump -- see each constant's doc comment for the derivation. `Bytes`'s own
+//! custom `Debug` impl (`bytes-1.10.1/src/fmt/debug.rs`) renders ASCII-printable bytes literally
+//! (not as `%02X` hex, despite the `{buf:02X?}` format spec in the error string -- that impl
+//! ignores formatter flags entirely), which is why the 0x54/0x55 opcode prefixes below end in the
+//! literal characters `T`/`U` rather than a hex byte.
+//!
+//! Same enable-once-per-process / near-zero-cost-when-disabled shape as `log_tap.rs`, gated on by
+//! `frozen-cool-test` only (see `enable`) -- every other subcommand's log lines are unaffected.
+//! The *counts* of how many times each pattern was actually seen are tracked separately and
+//! authoritatively by `frozen_compat::CompatFrameScanner`, which parses the real bytes rather than
+//! log-message text; this module's only job is stopping the noisy duplicate print.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+const CODEC_TARGET: &str = "opensleep::common::codec";
+
+/// `PacketError::InvalidSize{ packet_name: "Frozen/GetTemperature", expected: 27, actual: 14 }`'s
+/// `Display` prefix (`"{packet_name} wrong size: expected {expected}, got {actual}."`). Once this
+/// binary decodes the 14-byte reply itself (`frozen_compat::decode_get_temperature_14byte`), the
+/// condition this line reports is expected and handled, not an error.
+const GET_TEMPERATURE_14BYTE_PREFIX: &str = "Frozen/GetTemperature wrong size: expected 27, got 14.";
+/// `PacketError::InvalidSize{ packet_name: "Frozen/Heartbeat", expected: 3, actual: 9 }`'s prefix --
+/// real hardware has been observed sending a 9-byte payload under the heartbeat opcode.
+const HEARTBEAT_9BYTE_PREFIX: &str = "Frozen/Heartbeat wrong size: expected 3, got 9.";
+/// `PacketError::Unexpected{ subsystem_name: "Frozen", buf }`'s prefix, followed by `Bytes`'s debug
+/// rendering of a buffer starting with opcode `0x54` (ASCII `'T'`, printable, so it renders as the
+/// literal character, not an escape -- see module docs).
+const OPCODE_0X54_PREFIX: &str = "Frozen got unexpected packet: b\"T";
+/// Same, for opcode `0x55` (ASCII `'U'`).
+const OPCODE_0X55_PREFIX: &str = "Frozen got unexpected packet: b\"U";
+
+/// Turns suppression on for the rest of the process's life. Idempotent. Only `frozen-cool-test`
+/// calls this.
+pub fn enable() {
+    ENABLED.store(true, Ordering::SeqCst);
+}
+
+fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// Called from the global log format closure for every emitted record, before it is printed.
+/// Returns `true` if this line is one of the known, now-handled-elsewhere compatibility patterns
+/// above -- in which case the closure must not print it (that full-buffer dump is exactly the
+/// noise item 8 of the fix this module was added for asks to eliminate). Always `false` unless
+/// [`enable`] was called.
+pub fn is_known_compat_noise(target: &str, message: &str) -> bool {
+    if !enabled() || target != CODEC_TARGET {
+        return false;
+    }
+    message.starts_with(GET_TEMPERATURE_14BYTE_PREFIX)
+        || message.starts_with(HEARTBEAT_9BYTE_PREFIX)
+        || message.starts_with(OPCODE_0X54_PREFIX)
+        || message.starts_with(OPCODE_0X55_PREFIX)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Mutex;
+
+    /// `enable` is a process-global, one-way flag (like `log_tap`'s) -- serialize this module's
+    /// own tests so the "disabled" test can't run after another test has already turned it on.
+    static TEST_LOCK: Mutex<()> = Mutex::new(());
+
+    #[test]
+    fn disabled_by_default_even_for_an_exact_match() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        // This test only means something if nothing else in this process has called `enable()`
+        // yet; run it defensively regardless by checking a target that would otherwise match.
+        if enabled() {
+            return;
+        }
+        assert!(!is_known_compat_noise(
+            CODEC_TARGET,
+            "Frozen/GetTemperature wrong size: expected 27, got 14. Buffer: b\"...\""
+        ));
+    }
+
+    #[test]
+    fn matches_known_patterns_once_enabled() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        enable();
+        assert!(is_known_compat_noise(
+            CODEC_TARGET,
+            "Frozen/GetTemperature wrong size: expected 27, got 14. Buffer: b\"\\x00\\x01\\n...\""
+        ));
+        assert!(is_known_compat_noise(
+            CODEC_TARGET,
+            "Frozen/Heartbeat wrong size: expected 3, got 9. Buffer: b\"...\""
+        ));
+        assert!(is_known_compat_noise(CODEC_TARGET, "Frozen got unexpected packet: b\"T\\x00\\x01\""));
+        assert!(is_known_compat_noise(CODEC_TARGET, "Frozen got unexpected packet: b\"U\\x00\\x01\""));
+    }
+
+    #[test]
+    fn does_not_match_an_unrelated_size_mismatch() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        enable();
+        assert!(!is_known_compat_noise(
+            CODEC_TARGET,
+            "Frozen/GetTemperature wrong size: expected 27, got 13. Buffer: b\"...\""
+        ));
+        assert!(!is_known_compat_noise(
+            CODEC_TARGET,
+            "Frozen/Heartbeat wrong size: expected 3, got 4. Buffer: b\"...\""
+        ));
+    }
+
+    #[test]
+    fn does_not_match_a_different_unexpected_opcode() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        enable();
+        assert!(!is_known_compat_noise(CODEC_TARGET, "Frozen got unexpected packet: b\"V\\x00\\x01\""));
+    }
+
+    #[test]
+    fn does_not_match_outside_the_codec_target() {
+        let _guard = TEST_LOCK.lock().unwrap();
+        enable();
+        assert!(!is_known_compat_noise(
+            "opensleep_diagnostic::some_other_module",
+            "Frozen/GetTemperature wrong size: expected 27, got 14. Buffer: b\"...\""
+        ));
+    }
+}
