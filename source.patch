new file mode 100644
index 0000000..a1c128f
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/sensor_probe.rs
@@ -0,0 +1,2828 @@
+//! `sensor-probe`: investigates the Eight Sleep Sensor subsystem (presence/piezo/temperature MCU)
+//! over its own UART, entirely independent of Frozen. This first version establishes reliable
+//! communication and decodes whatever is already available -- it deliberately does NOT attempt
+//! presence calibration, piezo configuration, vibration actuation, alarms, or expander reset
+//! pulsing (see SAFETY.md and `sensor_safety.rs` module docs for why those command variants are
+//! not even constructible in this binary).
+//!
+//! Three stages of increasing capability, all still zero-I2C-write:
+//!   - `--passive` (default): zero UART writes too. Opens `/dev/ttyS2` at each known Sensor baud
+//!     in turn and only listens, decoding through the real, unmodified
+//!     `opensleep::common::codec::PacketCodec<SensorPacket>`.
+//!   - `--ping`: may send `SensorCommand::Ping`, never `JumpToFirmware`, never changes Sensor mode.
+//!   - `--discover`: implements upstream's Ping / JumpToFirmware discovery sequence (firmware Ping
+//!     first, then bootloader Ping, then -- only if bootloader responded -- exactly one
+//!     `JumpToFirmware` and a re-ping at firmware baud), but never starts the normal Sensor
+//!     `CommandScheduler` and never sends any actuator/config command.
+//!
+//! `--audit-expander` (combinable with any stage) performs a read-only PCAL6416A register dump,
+//! reusing the existing `I2cPort::read_reg` -- this module contains no `write_reg` call at all, so
+//! registers 0x02/0x06/0x07 (and every other register) are structurally unwritable here. Port-0
+//! bit 0's function is deliberately left unproven: see SAFETY.md and item 8 of this feature's
+//! spec -- no reset-line pulsing of any kind is implemented in this version.
+//!
+//! Never opens Frozen's own dedicated UART device or references its transport/command types at
+//! all, with exactly one deliberate, narrow exception: `--combined-narrow-subsystem-init`'s
+//! Ping-only verification step (see that mode's own section below) -- checked by the same
+//! `sensor_probe_never_touches_frozen` guardrail test in `main.rs`, updated to describe exactly
+//! that one exception rather than a blanket ban.
+//!
+//! `--combined-narrow-subsystem-init` (opt-in; not part of normal `--passive`/`--ping`/
+//! `--discover` operation) reproduces only the port-0 portion of upstream OpenSleep's own startup
+//! sequence -- bits 0 and 1 of the PCAL6416A's registers 0x02/0x06 -- while leaving every other
+//! register (0x07 in particular) exactly as this Hub's own hardware already has it. After a
+//! verified expander sequence, it verifies Frozen is reachable (Ping only, `Mode::Passive`'s
+//! whitelist -- no temperature targets, no Prime, no pumps, no cooling, no global
+//! `ResetController`), then probes Sensor using upstream's own bootloader-first discovery
+//! ordering. See SAFETY.md and `i2c::configure_combined_narrow_subsystem_init` for the full design.
+
+use std::collections::BTreeMap;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use opensleep::sensor::SensorPacket;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio_serial::SerialStream;
+
+use crate::buildinfo::{DIAGNOSTIC_VERSION, kernel_release, source_commit};
+use crate::cli::SensorProbeArgs;
+use crate::frozen_ops;
+use crate::i2c::{
+    I2cPort, MockI2c, RealI2c, configure_combined_narrow_subsystem_init, configure_suspected_sensor_enable_high, restore_suspected_sensor_bit,
+};
+use crate::io_logging::RawIoCapture;
+use crate::link::{FrozenLink, PacketOutcome as FrozenPacketOutcome};
+use crate::mock::mock_frozen_link_pair;
+use crate::ownership;
+use crate::safety::{AuditedTransport, Mode as FrozenMode};
