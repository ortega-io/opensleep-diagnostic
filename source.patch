+    /// A fake device that, for every `GetTemperatures` request, sends *both* an unsolicited
+    /// `TemperatureUpdate` push and a normal 27-byte `GetTemperature` reply carrying the exact same
+    /// (left, right, heatsink) reading -- simulating a solicited reply landing in the same ~1s
+    /// drain window as an unrelated periodic push that happens to report the same underlying
+    /// firmware sample.
+    fn spawn_device_sending_duplicate_readings_each_tick(mut device_side: tokio::io::DuplexStream) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        match opcode {
+                            0x01 => {
+                                let resp = opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110]);
+                                if device_side.write_all(&resp).await.is_err() {
+                                    break;
+                                }
+                            }
+                            0x41 => {
+                                let push = opensleep::common::codec::command(vec![0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, 0]);
+                                let reply = opensleep::common::codec::command(get_temperature_27byte_frame(0x099A, 0x09A4, 0x0A28));
+                                if device_side.write_all(&push).await.is_err() || device_side.write_all(&reply).await.is_err() {
+                                    break;
+                                }
+                            }
+                            0x40 if payload.len() == 5 => {
+                                let resp = opensleep::common::codec::command(vec![
+                                    0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                                ]);
+                                if device_side.write_all(&resp).await.is_err() {
+                                    break;
+                                }
+                            }
+                            _ => {}
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
