+            csv_field!("top_fan_activity_observed", ct.top_fan_activity_observed);
+            csv_field!("top_fan_latest_duty", ct.top_fan_latest_duty.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("top_fan_latest_rpm", ct.top_fan_latest_rpm.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("top_fan_max_rpm", ct.top_fan_max_rpm.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("bottom_fan_activity_observed", ct.bottom_fan_activity_observed);
+            csv_field!("bottom_fan_latest_duty", ct.bottom_fan_latest_duty.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("bottom_fan_latest_rpm", ct.bottom_fan_latest_rpm.map(|v| v.to_string()).unwrap_or_default());
