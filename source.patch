+//! `sensor-probe`'s report: a self-contained struct with its own JSON/CSV/text output, entirely
+//! separate from `report.rs`'s `Report` (which is Frozen-specific top to bottom -- `frozen_port`,
+//! `frozen_uart_opened`, `cool_test_results`, ... -- and stays untouched by this file). Mirrors
+//! that module's role, scoped to the Sensor investigation.
+
+use std::collections::BTreeMap;
+
+use serde::Serialize;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct ExpanderRegisterReading {
+    pub register: u8,
+    pub register_hex: String,
+    pub label: &'static str,
+    pub success: bool,
+    pub value: Option<u8>,
+    pub value_hex: Option<String>,
+    pub value_binary: Option<String>,
+    pub os_error: Option<i32>,
+}
+
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct ExpanderAudit {
+    pub readings: Vec<ExpanderRegisterReading>,
+    /// Always `true`: no register is ever written by this audit (defense-in-depth mirror of the
+    /// same fact `PROTOCOL_AUDIT.md`/`SAFETY.md` document -- see `sensor_probe::audit_expander`,
+    /// which only ever calls `I2cPort::read_reg`, never `write_reg`).
+    pub read_only: bool,
+}
+
+#[derive(Debug, Clone, Default, Serialize)]
+pub struct PacketTallyJson {
+    pub bytes_received: u64,
+    /// Candidate frame starts: raw `0x7E` byte occurrences observed on the wire during this
+    /// window. An upper-bound heuristic, not an exact frame count -- a payload or checksum byte can
+    /// coincidentally equal `0x7E` too. See `frames_decoded`/`malformed_frames` for the precise,
+    /// codec-verified counts.
+    pub frames_found: u64,
+    /// Frames `opensleep::common::codec::PacketCodec` actually decoded successfully.
+    pub frames_decoded: u64,
+    /// `frames_found` minus `frames_decoded`, floored at zero -- frames with a bad checksum, an
+    /// unrecognized opcode, or a firmware variant this binary doesn't yet decode. Never treated as
+    /// fatal; see module docs.
+    pub malformed_frames: u64,
+    pub packet_types_observed: BTreeMap<String, u64>,
+    pub capacitance_samples: u64,
+    pub capacitance_left_min: Option<u16>,
+    pub capacitance_left_max: Option<u16>,
+    pub capacitance_left_latest: Option<u16>,
+    pub capacitance_right_min: Option<u16>,
+    pub capacitance_right_max: Option<u16>,
+    pub capacitance_right_latest: Option<u16>,
+    pub piezo_samples: u64,
+    pub piezo_left_min: Option<u16>,
+    pub piezo_left_max: Option<u16>,
+    pub piezo_left_latest: Option<u16>,
+    pub piezo_right_min: Option<u16>,
+    pub piezo_right_max: Option<u16>,
+    pub piezo_right_latest: Option<u16>,
+    pub temperature_samples: u64,
+    pub first_valid_packet_timestamp: Option<String>,
+    pub last_valid_packet_timestamp: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct SensorProbeReport {
+    pub program_version: String,
+    pub opensleep_base_version: String,
+    pub opensleep_source_commit: String,
+    pub kernel: String,
+    pub arch: String,
+
+    pub mode: String, // "passive" | "ping" | "discover"
+    pub dry_run: bool,
+    pub sensor_port: String,
+    pub listen_seconds: u64,
+    pub observe_seconds: u64,
+    pub query_info_requested: bool,
+    pub audit_expander_requested: bool,
+    pub raw_serial_enabled: bool,
+
+    pub firmware_baud_opened: bool,
+    pub bootloader_baud_opened: bool,
+
+    /// `--passive` only: per-baud tallies. `None` for `--ping`/`--discover`.
+    pub passive_115200: Option<PacketTallyJson>,
+    pub passive_38400: Option<PacketTallyJson>,
+    /// `--ping`/`--discover` only: the round-trip/observe tally. `None` for `--passive`.
+    pub active_probe: Option<PacketTallyJson>,
+
+    // Flat convenience fields matching section 10's exact names, mirrored from whichever of the
+    // above tallies is relevant to the mode that actually ran.
+    pub passive_bytes_115200: u64,
+    pub passive_bytes_38400: u64,
+    pub packet_types_observed: Vec<String>,
+    pub capacitance_samples: u64,
+    pub piezo_samples: u64,
+    pub temperature_samples: u64,
+    pub malformed_packets: u64,
+
+    pub firmware_ping_response: Option<bool>,
+    pub bootloader_ping_response: Option<bool>,
+    pub jump_to_firmware_sent: bool,
+    pub firmware_mode_confirmed: bool,
+    pub hardware_info: Option<String>,
+    pub firmware_info: Option<String>,
+
+    pub expander_audit: Option<ExpanderAudit>,
+
+    // Section 9 safety counters.
+    pub sensor_uart_writes: u32,
+    pub frozen_uart_writes: u32,
+    pub i2c_reads: u32,
+    pub i2c_writes: u32,
+    pub actuator_commands_sent: u32,
+    pub frozen_port_never_opened: bool,
+    pub frozen_command_sent: bool,
+    pub prime_command_sent: bool,
+    pub temperature_target_changed: bool,
+    /// Always `0`: this binary never calls `SensorLink::open*`/`RealI2c`-equivalent open logic
+    /// against Frozen's UART. Distinct from `frozen_uart_writes` (which would catch a write even
+    /// if some future bug opened the port read-only) -- this catches the open attempt itself.
+    pub frozen_uart_opens: u32,
+
+    // --enable-suspected-sensor-line / --restore-suspected-sensor-line (all `None`/`false`/`0`
+    // unless --enable-suspected-sensor-line was actually passed). See SAFETY.md and
+    // `sensor_probe.rs` module docs.
+    pub suspected_sensor_line_enable_requested: bool,
+    pub suspected_sensor_line_restore_requested: bool,
+
+    pub reg_0x02_original: Option<u8>,
+    pub reg_0x02_after_prepare: Option<u8>,
+    pub reg_0x02_readback: Option<u8>,
+    pub reg_0x02_changed_mask: Option<u8>,
+
+    pub reg_0x06_original: Option<u8>,
+    pub reg_0x06_after_config: Option<u8>,
+    pub reg_0x06_readback: Option<u8>,
+    pub reg_0x06_changed_mask: Option<u8>,
+
+    pub port0_bit0_output_latch_high: bool,
+    pub port0_bit0_configured_as_output: bool,
+    pub unrelated_bits_preserved: bool,
+
+    /// The actual final state of 0x02/0x06 by the time this report is generated -- the enable
+    /// step's own readback, or (if `--restore-suspected-sensor-line` ran) the restore step's own
+    /// readback instead. See SAFETY.md's "preserve current expander state rather than restoring
+    /// blindly" rationale.
+    pub reg_0x02_final: Option<u8>,
+    pub reg_0x06_final: Option<u8>,
+
+    pub passive_rx_before_enable: u64,
+    pub passive_rx_after_enable: u64,
+    pub first_rx_after_enable_ms: Option<u64>,
+    pub first_decoded_packet_after_enable_ms: Option<u64>,
+
+    // --combined-narrow-subsystem-init (all default/`None`/`false`/`0` unless requested). See
+    // SAFETY.md and `sensor_probe.rs` module docs.
+    pub combined_init_requested: bool,
+    pub combined_init_verified: bool,
+
+    pub combined_reg02_assert_original: Option<u8>,
+    pub combined_reg02_assert_target: Option<u8>,
+    pub combined_reg02_assert_readback: Option<u8>,
+    pub combined_reg02_assert_changed_mask: Option<u8>,
+
+    pub combined_reg06_config_original: Option<u8>,
+    pub combined_reg06_config_target: Option<u8>,
+    pub combined_reg06_config_readback: Option<u8>,
+    pub combined_reg06_config_changed_mask: Option<u8>,
+
+    pub combined_reg02_release_original: Option<u8>,
+    pub combined_reg02_release_target: Option<u8>,
+    pub combined_reg02_release_readback: Option<u8>,
+    pub combined_reg02_release_changed_mask: Option<u8>,
+
+    /// `register 0x07 original == register 0x07 final` -- proven, not assumed, by reading the
+    /// expander both before and after the combined sequence. `false` whenever either read failed.
+    pub combined_reg07_preserved: bool,
+    pub combined_reg07_original: Option<u8>,
+    pub combined_reg07_final: Option<u8>,
+
+    /// Full read-only expander audit (0x00-0x07) captured immediately before the combined I2C
+    /// sequence and immediately after it.
+    pub expander_audit_before: Option<ExpanderAudit>,
+    pub expander_audit_after: Option<ExpanderAudit>,
+
+    pub frozen_reached_firmware: bool,
+    pub sensor_bootloader_confirmed: bool,
+    pub sensor_firmware_confirmed: bool,
+
+    /// Best-effort `/proc/tty/driver/serial` byte counters for the Sensor UART, captured
+    /// immediately before the I2C change and again at the end of the run. `None` when the file is
+    /// unavailable or unparseable (e.g. not running on Linux, or a kernel build without that proc
+    /// entry) -- never treated as fatal.
+    pub rx_count_before: Option<u64>,
+    pub tx_count_before: Option<u64>,
+    pub rx_count_after: Option<u64>,
+    pub tx_count_after: Option<u64>,
+
+    pub spontaneous_bytes_38400: u64,
+    pub spontaneous_bytes_115200: u64,
+    pub first_sensor_rx_after_init_ms: Option<u64>,
+    pub first_decoded_sensor_packet_after_init_ms: Option<u64>,
+
+    pub overall_result: String,
+    pub exit_code: u8,
+}
+
+impl SensorProbeReport {
+    pub fn write_json(&self, path: &str) -> std::io::Result<()> {
+        let json = serde_json::to_string_pretty(self)?;
+        std::fs::write(path, json)
+    }
+
+    pub fn write_csv(&self, path: &str) -> std::io::Result<()> {
+        use std::io::Write as _;
+        let mut w = std::fs::File::create(path)?;
+        writeln!(w, "field,value")?;
+        macro_rules! csv_field {
+            ($name:literal, $val:expr) => {
+                writeln!(w, "{},{}", $name, $val)?;
+            };
+        }
+        csv_field!("mode", self.mode);
+        csv_field!("dry_run", self.dry_run);
+        csv_field!("sensor_port", self.sensor_port);
+        csv_field!("firmware_baud_opened", self.firmware_baud_opened);
+        csv_field!("bootloader_baud_opened", self.bootloader_baud_opened);
+        csv_field!("passive_bytes_115200", self.passive_bytes_115200);
+        csv_field!("passive_bytes_38400", self.passive_bytes_38400);
+        csv_field!("firmware_ping_response", self.firmware_ping_response.map(|v| v.to_string()).unwrap_or_default());
+        csv_field!("bootloader_ping_response", self.bootloader_ping_response.map(|v| v.to_string()).unwrap_or_default());
+        csv_field!("jump_to_firmware_sent", self.jump_to_firmware_sent);
+        csv_field!("firmware_mode_confirmed", self.firmware_mode_confirmed);
+        csv_field!("hardware_info", self.hardware_info.clone().unwrap_or_default());
+        csv_field!("firmware_info", self.firmware_info.clone().unwrap_or_default());
+        csv_field!("packet_types_observed", self.packet_types_observed.join(" "));
+        csv_field!("capacitance_samples", self.capacitance_samples);
+        csv_field!("piezo_samples", self.piezo_samples);
+        csv_field!("temperature_samples", self.temperature_samples);
+        csv_field!("malformed_packets", self.malformed_packets);
+        csv_field!("raw_serial_enabled", self.raw_serial_enabled);
+        csv_field!("i2c_reads", self.i2c_reads);
+        csv_field!("i2c_writes", self.i2c_writes);
+        csv_field!("frozen_uart_writes", self.frozen_uart_writes);
+        csv_field!("sensor_uart_writes", self.sensor_uart_writes);
+        csv_field!("actuator_commands_sent", self.actuator_commands_sent);
+        csv_field!("suspected_sensor_line_enable_requested", self.suspected_sensor_line_enable_requested);
+        csv_field!("suspected_sensor_line_restore_requested", self.suspected_sensor_line_restore_requested);
+        csv_field!("reg_0x02_original", self.reg_0x02_original.map(|v| format!("0x{v:02X}")).unwrap_or_default());
+        csv_field!("reg_0x02_final", self.reg_0x02_final.map(|v| format!("0x{v:02X}")).unwrap_or_default());
+        csv_field!("reg_0x06_original", self.reg_0x06_original.map(|v| format!("0x{v:02X}")).unwrap_or_default());
+        csv_field!("reg_0x06_final", self.reg_0x06_final.map(|v| format!("0x{v:02X}")).unwrap_or_default());
+        csv_field!("port0_bit0_output_latch_high", self.port0_bit0_output_latch_high);
+        csv_field!("port0_bit0_configured_as_output", self.port0_bit0_configured_as_output);
+        csv_field!("unrelated_bits_preserved", self.unrelated_bits_preserved);
+        csv_field!("first_rx_after_enable_ms", self.first_rx_after_enable_ms.map(|v| v.to_string()).unwrap_or_default());
+        csv_field!(
+            "first_decoded_packet_after_enable_ms",
+            self.first_decoded_packet_after_enable_ms.map(|v| v.to_string()).unwrap_or_default()
+        );
+        csv_field!("frozen_uart_opens", self.frozen_uart_opens);
+        csv_field!("combined_init_requested", self.combined_init_requested);
+        csv_field!("combined_init_verified", self.combined_init_verified);
+        csv_field!("combined_reg07_preserved", self.combined_reg07_preserved);
+        csv_field!("frozen_reached_firmware", self.frozen_reached_firmware);
+        csv_field!("sensor_bootloader_confirmed", self.sensor_bootloader_confirmed);
+        csv_field!("sensor_firmware_confirmed", self.sensor_firmware_confirmed);
+        csv_field!("spontaneous_bytes_38400", self.spontaneous_bytes_38400);
+        csv_field!("spontaneous_bytes_115200", self.spontaneous_bytes_115200);
+        csv_field!(
+            "first_sensor_rx_after_init_ms",
+            self.first_sensor_rx_after_init_ms.map(|v| v.to_string()).unwrap_or_default()
+        );
+        csv_field!("overall_result", self.overall_result);
+        csv_field!("exit_code", self.exit_code);
+        Ok(())
+    }
+
+    pub fn print_table(&self) {
+        log::info!("================ opensleep-diagnostic sensor-probe summary ================");
+        log::info!("mode: {} (dry_run={})", self.mode, self.dry_run);
+        log::info!("sensor_port: {}", self.sensor_port);
+        log::info!("firmware_baud_opened: {}  bootloader_baud_opened: {}", self.firmware_baud_opened, self.bootloader_baud_opened);
+        if self.mode == "passive" {
+            log::info!(
+                "passive @115200: bytes={} frames_found(candidate 0x7E markers)={} decoded={} malformed={}",
+                self.passive_bytes_115200,
+                self.passive_115200.as_ref().map(|t| t.frames_found).unwrap_or(0),
+                self.passive_115200.as_ref().map(|t| t.frames_decoded).unwrap_or(0),
+                self.passive_115200.as_ref().map(|t| t.malformed_frames).unwrap_or(0),
+            );
+            log::info!(
+                "passive @38400:  bytes={} frames_found(candidate 0x7E markers)={} decoded={} malformed={}",
+                self.passive_bytes_38400,
+                self.passive_38400.as_ref().map(|t| t.frames_found).unwrap_or(0),
+                self.passive_38400.as_ref().map(|t| t.frames_decoded).unwrap_or(0),
+                self.passive_38400.as_ref().map(|t| t.malformed_frames).unwrap_or(0),
+            );
+        } else {
+            log::info!("firmware_ping_response: {:?}", self.firmware_ping_response);
+            log::info!("bootloader_ping_response: {:?}", self.bootloader_ping_response);
+            log::info!("jump_to_firmware_sent: {}  firmware_mode_confirmed: {}", self.jump_to_firmware_sent, self.firmware_mode_confirmed);
+        }
+        if self.suspected_sensor_line_enable_requested {
+            log::info!("---- EXPERIMENTAL: suspected Sensor enable line (port-0 bit 0) ----");
+            log::info!(
+                "reg 0x02: original=0x{:02X?} after_prepare=0x{:02X?} readback=0x{:02X?} changed_mask=0x{:02X?} final=0x{:02X?}",
+                self.reg_0x02_original, self.reg_0x02_after_prepare, self.reg_0x02_readback, self.reg_0x02_changed_mask, self.reg_0x02_final
+            );
+            log::info!(
+                "reg 0x06: original=0x{:02X?} after_config=0x{:02X?} readback=0x{:02X?} changed_mask=0x{:02X?} final=0x{:02X?}",
+                self.reg_0x06_original, self.reg_0x06_after_config, self.reg_0x06_readback, self.reg_0x06_changed_mask, self.reg_0x06_final
+            );
+            log::info!(
+                "port0_bit0_output_latch_high={} port0_bit0_configured_as_output={} unrelated_bits_preserved={}",
+                self.port0_bit0_output_latch_high, self.port0_bit0_configured_as_output, self.unrelated_bits_preserved
+            );
+            log::info!(
+                "passive_rx_before_enable={} passive_rx_after_enable={} first_rx_after_enable_ms={:?} first_decoded_packet_after_enable_ms={:?}",
+                self.passive_rx_before_enable, self.passive_rx_after_enable, self.first_rx_after_enable_ms, self.first_decoded_packet_after_enable_ms
+            );
+            log::info!("restore_requested: {}", self.suspected_sensor_line_restore_requested);
+        }
+        if self.combined_init_requested {
+            log::info!("---- EXPERIMENTAL: combined narrow subsystem init (port-0 bits 0+1) ----");
+            log::info!(
+                "reg 0x02 assert: original=0x{:02X?} target=0x{:02X?} readback=0x{:02X?} changed_mask=0x{:02X?}",
+                self.combined_reg02_assert_original,
+                self.combined_reg02_assert_target,
+                self.combined_reg02_assert_readback,
+                self.combined_reg02_assert_changed_mask
+            );
+            log::info!(
+                "reg 0x06 config: original=0x{:02X?} target=0x{:02X?} readback=0x{:02X?} changed_mask=0x{:02X?}",
+                self.combined_reg06_config_original,
+                self.combined_reg06_config_target,
+                self.combined_reg06_config_readback,
+                self.combined_reg06_config_changed_mask
+            );
+            log::info!(
+                "reg 0x02 release: original=0x{:02X?} target=0x{:02X?} readback=0x{:02X?} changed_mask=0x{:02X?}",
+                self.combined_reg02_release_original,
+                self.combined_reg02_release_target,
+                self.combined_reg02_release_readback,
+                self.combined_reg02_release_changed_mask
+            );
+            log::info!(
+                "combined_init_verified={} reg07: original=0x{:02X?} final=0x{:02X?} preserved={}",
+                self.combined_init_verified, self.combined_reg07_original, self.combined_reg07_final, self.combined_reg07_preserved
+            );
+            log::info!(
+                "frozen_reached_firmware={} sensor_bootloader_confirmed={} sensor_firmware_confirmed={}",
+                self.frozen_reached_firmware, self.sensor_bootloader_confirmed, self.sensor_firmware_confirmed
+            );
+            log::info!(
+                "serial counters (ttyS2): rx {:?} -> {:?}  tx {:?} -> {:?}",
+                self.rx_count_before, self.rx_count_after, self.tx_count_before, self.tx_count_after
+            );
+            log::info!(
+                "spontaneous_bytes_38400={} spontaneous_bytes_115200={} first_sensor_rx_after_init_ms={:?} first_decoded_sensor_packet_after_init_ms={:?}",
+                self.spontaneous_bytes_38400,
+                self.spontaneous_bytes_115200,
+                self.first_sensor_rx_after_init_ms,
+                self.first_decoded_sensor_packet_after_init_ms
+            );
+        }
+        if let Some(hw) = &self.hardware_info {
+            log::info!("hardware_info: {hw}");
+        }
+        if let Some(fw) = &self.firmware_info {
+            log::info!("firmware_info: {fw}");
+        }
+        log::info!("packet_types_observed: {:?}", self.packet_types_observed);
+        log::info!(
+            "capacitance_samples={} piezo_samples={} temperature_samples={} malformed_packets={}",
+            self.capacitance_samples, self.piezo_samples, self.temperature_samples, self.malformed_packets
+        );
+        if let Some(audit) = &self.expander_audit {
+            log::info!("---- PCAL6416A expander audit (read-only; read_only={}) ----", audit.read_only);
+            for r in &audit.readings {
+                match r.value {
+                    Some(v) => log::info!(
+                        "  reg {} ({}): 0x{:02X} = 0b{:08b}",
+                        r.register_hex, r.label, v, v
+                    ),
+                    None => log::info!("  reg {} ({}): read failed (errno {:?})", r.register_hex, r.label, r.os_error),
+                }
+            }
+        }
+        for (label, audit) in [("before", &self.expander_audit_before), ("after", &self.expander_audit_after)] {
+            if let Some(audit) = audit {
+                log::info!("---- PCAL6416A expander audit ({label} combined init, read-only) ----");
+                for r in &audit.readings {
+                    match r.value {
+                        Some(v) => log::info!("  reg {} ({}): 0x{:02X} = 0b{:08b}", r.register_hex, r.label, v, v),
+                        None => log::info!("  reg {} ({}): read failed (errno {:?})", r.register_hex, r.label, r.os_error),
+                    }
+                }
+            }
+        }
+        log::info!(
+            "safety counters: sensor_uart_writes={} frozen_uart_writes={} i2c_reads={} i2c_writes={} actuator_commands_sent={}",
+            self.sensor_uart_writes, self.frozen_uart_writes, self.i2c_reads, self.i2c_writes, self.actuator_commands_sent
+        );
+        log::info!("frozen_port_never_opened: {}", self.frozen_port_never_opened);
+        log::info!("overall_result: {}  exit_code: {}", self.overall_result, self.exit_code);
+        log::info!("=============================================================================");
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/sensor_safety.rs b/src/bin/opensleep-diagnostic/sensor_safety.rs
new file mode 100644
index 0000000..559baa4
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/sensor_safety.rs
@@ -0,0 +1,186 @@
+//! Structural enforcement of `sensor-probe`'s command whitelist, mirroring `safety.rs`'s model for
+//! Frozen but scoped far narrower: this binary's Sensor vocabulary has exactly four members.
+//!
+//! 1. [`SensorProbeAction`] is a closed enum with no actuator/config variant at all --
+//!    `EnableVibration`, `SetAlarm`, `EnablePiezo`, `SetPiezoGain`, `SetPiezoFreq`,
+//!    `ProbeTemperature`, `ClearAlarm`, `DisablePiezo`, and `Random` from upstream's
+//!    `SensorCommand` are not merely disallowed, they are unrepresentable in this type. Only
+//!    `Ping`, `JumpToFirmware`, `GetHardwareInfo`, and `GetFirmwareHash` exist.
+//! 2. [`ProbeMode::allows`] additionally gates every action against the current mode:
+//!    `Passive` allows nothing at all (zero UART writes, enforced even if a future bug tried to
+//!    call send); `Ping` allows only `Ping`; `Discover` allows `Ping`/`JumpToFirmware` always, and
+//!    `GetHardwareInfo`/`GetFirmwareHash` only once firmware-mode communication is confirmed
+//!    (`--query-info`).
+//!
+//! [`SensorAudit`] records every accepted send (`sensor_uart_writes`) and exists specifically so
+//! `actuator_commands_sent` can be an audited, always-zero fact in the report rather than an
+//! assumption -- it is incremented only by a constructor this module never calls, since no
+//! actuator variant exists to construct.
+
+use opensleep::sensor::SensorCommand;
+
+/// The only Sensor actions constructible anywhere in this binary. See module docs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SensorProbeAction {
+    Ping,
+    JumpToFirmware,
+    GetHardwareInfo,
+    GetFirmwareHash,
+}
+
+impl SensorProbeAction {
+    pub fn name(self) -> &'static str {
+        match self {
+            SensorProbeAction::Ping => "Ping",
+            SensorProbeAction::JumpToFirmware => "JumpToFirmware",
+            SensorProbeAction::GetHardwareInfo => "GetHardwareInfo",
+            SensorProbeAction::GetFirmwareHash => "GetFirmwareHash",
+        }
+    }
+
+    /// Reuses upstream `SensorCommand`/`CommandTrait` encoding unmodified -- this binary never
+    /// reimplements Sensor packet framing.
+    pub fn to_command(self) -> SensorCommand {
+        match self {
+            SensorProbeAction::Ping => SensorCommand::Ping,
+            SensorProbeAction::JumpToFirmware => SensorCommand::JumpToFirmware,
+            SensorProbeAction::GetHardwareInfo => SensorCommand::GetHardwareInfo,
+            SensorProbeAction::GetFirmwareHash => SensorCommand::GetFirmwareHash,
+        }
+    }
+}
+
+/// Which `sensor-probe` stage is running. Determines the whitelist [`ProbeMode::allows`] enforces.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ProbeMode {
+    Passive,
+    Ping,
+    Discover,
+}
+
+impl ProbeMode {
+    pub fn label(self) -> &'static str {
+        match self {
+            ProbeMode::Passive => "passive",
+            ProbeMode::Ping => "ping",
+            ProbeMode::Discover => "discover",
+        }
+    }
+
+    /// `firmware_mode_confirmed`: whether a Sensor Pong reporting firmware mode has already been
+    /// observed this run -- gates `GetHardwareInfo`/`GetFirmwareHash` (`--query-info`), which must
+    /// never be sent before communication is actually established.
+    pub fn allows(self, action: SensorProbeAction, firmware_mode_confirmed: bool) -> bool {
+        match self {
+            ProbeMode::Passive => false,
+            ProbeMode::Ping => matches!(action, SensorProbeAction::Ping),
+            ProbeMode::Discover => match action {
+                SensorProbeAction::Ping | SensorProbeAction::JumpToFirmware => true,
+                SensorProbeAction::GetHardwareInfo | SensorProbeAction::GetFirmwareHash => {
+                    firmware_mode_confirmed
+                }
+            },
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SensorSafetyViolation {
+    pub mode: ProbeMode,
+    pub action: SensorProbeAction,
+}
+
+impl std::fmt::Display for SensorSafetyViolation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{} is not permitted in sensor-probe --{} mode", self.action.name(), self.mode.label())
+    }
+}
+impl std::error::Error for SensorSafetyViolation {}
+
+/// Records every accepted Sensor UART write. `actuator_commands_sent` is exposed purely as an
+/// audited counter: nothing in this binary ever increments it, since [`SensorProbeAction`] has no
+/// actuator variant to construct -- see module docs.
+#[derive(Debug, Clone, Default)]
+pub struct SensorAudit {
+    pub sensor_uart_writes: u32,
+    pub actuator_commands_sent: u32,
+    pub sent: Vec<&'static str>,
+}
+
+impl SensorAudit {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Checks `action` against `mode`'s whitelist; only records it as sent if this returns `Ok`.
+    pub fn check(&self, mode: ProbeMode, action: SensorProbeAction, firmware_mode_confirmed: bool) -> Result<(), SensorSafetyViolation> {
+        if mode.allows(action, firmware_mode_confirmed) {
+            Ok(())
+        } else {
+            Err(SensorSafetyViolation { mode, action })
+        }
+    }
+
+    pub fn record_sent(&mut self, action: SensorProbeAction) {
+        self.sensor_uart_writes += 1;
+        self.sent.push(action.name());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn passive_mode_allows_nothing() {
+        for action in [
+            SensorProbeAction::Ping,
+            SensorProbeAction::JumpToFirmware,
+            SensorProbeAction::GetHardwareInfo,
+            SensorProbeAction::GetFirmwareHash,
+        ] {
+            assert!(!ProbeMode::Passive.allows(action, true));
+            assert!(!ProbeMode::Passive.allows(action, false));
+        }
+    }
+
+    #[test]
+    fn ping_mode_allows_only_ping() {
+        assert!(ProbeMode::Ping.allows(SensorProbeAction::Ping, false));
+        assert!(!ProbeMode::Ping.allows(SensorProbeAction::JumpToFirmware, false));
+        assert!(!ProbeMode::Ping.allows(SensorProbeAction::GetHardwareInfo, true));
+        assert!(!ProbeMode::Ping.allows(SensorProbeAction::GetFirmwareHash, true));
+    }
+
+    #[test]
+    fn discover_mode_allows_ping_and_jump_always() {
+        assert!(ProbeMode::Discover.allows(SensorProbeAction::Ping, false));
+        assert!(ProbeMode::Discover.allows(SensorProbeAction::JumpToFirmware, false));
+        assert!(ProbeMode::Discover.allows(SensorProbeAction::Ping, true));
+        assert!(ProbeMode::Discover.allows(SensorProbeAction::JumpToFirmware, true));
+    }
+
+    #[test]
+    fn discover_mode_gates_query_info_on_firmware_confirmation() {
+        assert!(!ProbeMode::Discover.allows(SensorProbeAction::GetHardwareInfo, false));
+        assert!(!ProbeMode::Discover.allows(SensorProbeAction::GetFirmwareHash, false));
+        assert!(ProbeMode::Discover.allows(SensorProbeAction::GetHardwareInfo, true));
+        assert!(ProbeMode::Discover.allows(SensorProbeAction::GetFirmwareHash, true));
+    }
+
+    #[test]
+    fn audit_only_records_after_a_successful_check() {
+        let audit = SensorAudit::new();
+        assert!(audit.check(ProbeMode::Ping, SensorProbeAction::JumpToFirmware, false).is_err());
+        assert_eq!(audit.sensor_uart_writes, 0);
+    }
+
+    #[test]
+    fn actuator_commands_sent_can_never_become_nonzero() {
+        // No code path in this binary can construct an actuator SensorProbeAction (there is no
+        // such variant), so record_sent can never be called for one; this counter documents that
+        // invariant as an audited fact.
+        let audit = SensorAudit::new();
+        assert_eq!(audit.actuator_commands_sent, 0);
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/signals.rs b/src/bin/opensleep-diagnostic/signals.rs
new file mode 100644
index 0000000..6505b5a
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/signals.rs
@@ -0,0 +1,315 @@
+//! Everything that can cut an active phase short. `StopReason` is the vocabulary every abort path
+//! (Ctrl+C, SIGTERM/SIGHUP, timeout, communication/telemetry error, panic, ...) reduces to before
+//! `safe_stop::run_safe_stop` runs and the report is written.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+pub static PANIC_OCCURRED: AtomicBool = AtomicBool::new(false);
+
+/// Installs a panic hook that logs the panic and flips [`PANIC_OCCURRED`]. This does not itself
+/// perform the (async, I2C/UART-touching) safe-stop -- that cannot safely happen inside a
+/// synchronous panic hook. Instead, the risky per-tick polling loop in `cool_test.rs` runs inside
+/// its own `tokio::spawn`ed task; if it panics, `JoinHandle::await` yields `Err` with
+/// `JoinError::is_panic()`, and the *outer*, unpanicked task runs safe-stop -- this is the
+/// practical form of "panic hook where practical" for an async binary.
+pub fn install_panic_hook() {
+    let default_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(move |info| {
+        PANIC_OCCURRED.store(true, Ordering::SeqCst);
+        log::error!("PANIC: {info}");
+        default_hook(info);
+    }));
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[allow(dead_code)] // DecodeFailure/FatalStatus/UnknownNonzeroStatus: see their doc comments below
+pub enum StopReason {
+    Normal,
+    CtrlC,
+    Sigterm,
+    Sighup,
+    DurationExpired,
+    UartWriteFailure,
+    UartReadFailure,
+    TelemetryLost,
+    /// `frozen-cool-test`'s original single-clock staleness check (2s, refreshed only by
+    /// `TemperatureUpdate`) -- no longer produced by that file's own active loop (see
+    /// `cool_test::TemperatureWatchdogExpired`/`TemperatureStartupGraceExpired`, which replace it
+    /// with two clocks and real-hardware-evidenced limits; a live capture showed this firmware
+    /// pushes unsolicited `TemperatureUpdate` only about once every ~10 seconds, so the 2s limit
+    /// fired on every single active-phase run regardless of any actual fault). Kept in the
+    /// vocabulary (still produced by `frozen-prime-test`) rather than removed.
+    TelemetryStale,
+    /// No successfully-decoded packet of *any* kind (`TemperatureUpdate`, `GetTemperature`,
+    /// `Message`, `TargetUpdate`, ...) for longer than `cool_test::ANY_VALID_RX_LIMIT` -- a
+    /// silence *timeout*, distinct from a genuine I/O error (`UartWriteFailure`/`UartReadFailure`)
+    /// or the link closing outright (`TelemetryLost`), which the transport itself reports
+    /// immediately rather than after a grace period.
+    CommunicationWatchdogExpired,
+    /// A valid temperature sample (synchronous `GetTemperature` reply, either byte shape, or
+    /// unsolicited `TemperatureUpdate`) had already been seen at least once during the active
+    /// phase, but none arrived for longer than `cool_test::TEMPERATURE_FRESHNESS_LIMIT`. See that
+    /// constant's doc comment for the real-hardware evidence behind its value.
+    TemperatureWatchdogExpired,
+    /// No valid temperature sample arrived at all within `cool_test::ACTIVE_STARTUP_GRACE` of the
+    /// active phase starting -- distinct from `TemperatureWatchdogExpired`, whose clock only
+    /// starts once a first sample has actually been seen.
+    TemperatureStartupGraceExpired,
+    /// Named in the safety spec but not constructed by this build: `PacketCodec::decode` (reused
+    /// unmodified from `opensleep`) never surfaces a per-frame decode error to callers of
+    /// `Framed::next()` -- it swallows bad-checksum/unparseable frames internally via
+    /// `log::error!`/`continue` (see `telemetry.rs`'s `PacketStats` doc comment). Kept in the
+    /// vocabulary, rather than removed, so a future revision that does expose decode errors has
+    /// a place to report them without inventing new meaning at that point.
+    DecodeFailure,
+    /// Same situation as `DecodeFailure`: no reliably-evidenced fault/status field is exposed by
+    /// the reused packet types (`HardwareInfo`'s CBOR status byte is checked and discarded inside
+    /// `parse_hardware_info`, never returned to callers). See PROTOCOL_AUDIT.md.
+    FatalStatus,
+    UnknownNonzeroStatus,
+    ImplausibleTemperatureChange,
+    HeatsinkLimitExceeded,
+    TemperatureRangeExceeded,
+    Panic,
+    PreflightRefused,
+    /// The selected side's pump was still reported off / at 0.000000V more than
+    /// `cool_test::PUMP_CONFIRM_GRACE` after the enable command was accepted -- evidence-gated:
+    /// only fires when a firmware pump message for our side was actually observed reporting
+    /// zero voltage, never merely from the absence of a message. See `cool_test::parse_pump_report`.
+    PumpNotConfirmedRunning,
+    /// A firmware message reported the selected TEC's safety interlock as exactly `"locked"` --
+    /// word-tokenized classification, not substring matching (see `cool_test::TecSafetyState`,
+    /// whose doc comment covers a real regression where a `contains("lock")` check false-triggered
+    /// on the positive, non-fault state `"safe, unlocking"`).
+    TecLocked,
+    /// Same evidence basis as `TecLocked`, but for the distinct transitional state `"unsafe,
+    /// locking"` -- kept as its own variant (rather than folded into `TecLocked`) so
+    /// `cool_test::stop_reason_code` can report the two as the distinct codes
+    /// `explicit_tec_unsafe_locking`/`explicit_tec_locked` a live-hardware incident asked for.
+    TecUnsafeLocking,
+    /// Frozen sent an unsolicited `TargetUpdate` reporting the selected side disabled after we
+    /// had successfully enabled it -- i.e. the device turned the channel off on its own.
+    TargetDisabledUnexpectedly,
+    /// A firmware `Message` contained one of the generic fault keywords (overtemperature,
+    /// overcurrent, shutdown, fault, failed, locked) after the startup grace period. See
+    /// `cool_test::is_generic_fault_message` for the "flash locked" carve-out.
+    FirmwareFaultMessage,
+    /// The operator typed a report of a leak, burning smell, or abnormal noise (or the literal
+    /// word ABORT) during the active phase. See `cool_test::spawn_operator_abort_watcher`.
+    OperatorAbort,
+    /// `frozen-prime-test` only: a firmware message named the pump as faulted (matched narrowly:
+    /// "pump" plus a fault word). See `prime_test::is_pump_fault_message`.
+    PumpFault,
+    /// `frozen-prime-test` only: an unsolicited `TargetUpdate` reported a side enabled -- this
+    /// mode must never have an enabled target at any point.
+    TargetEnabledUnexpectedly,
+    /// `frozen-prime-test` only: a periodic Ping during the active phase got `Pong(false)`
+    /// (bootloader), meaning Frozen reset itself out of application firmware mid-run.
+    FrozenReturnedToBootloader,
+    /// `frozen-prime-test` only: a periodic re-probe of the 0x20 reset/enable expander failed
+    /// after priming had already started.
+    I2cFailureDuringPriming,
+    /// `frozen-prime-test` only: not an error -- the firmware reported priming complete
+    /// (`"FW: [priming] done"` or `"...done because empty"`) before the configured duration
+    /// elapsed, so the test stopped early and ran safe-stop, per spec.
+    PrimingCompleted,
+    /// `frozen-cool-test` only: not an error -- the selected side's live temperature reached the
+    /// computed target (`baseline - requested delta`) before the configured duration elapsed, so
+    /// the test stopped early rather than continuing to cool further than requested. Never
+    /// produced by `--firmware-authoritative` mode: that mode logs target attainment but lets
+    /// Frozen continue maintaining it for the remaining requested duration instead of stopping.
+    TargetTemperatureReached,
+    /// `frozen-cool-test --firmware-authoritative` only: a firmware `Message` matched
+    /// `cool_test::is_generic_fault_message` (a recognized, word-scoped negative keyword --
+    /// never inferred from missing or delayed telemetry). Kept distinct from the legacy active
+    /// loop's `FirmwareFaultMessage` so `cool_test::stop_reason_code` can report the two under
+    /// the exact, separate codes their respective specs asked for
+    /// (`explicit_firmware_safety_fault` vs. `thermal_safety_limit`).
+    FirmwareSafetyFault,
+    /// `frozen-cool-test --firmware-authoritative` only: Frozen's own `TargetUpdate` reported the
+    /// selected side's enabled target lost (disabled) after this run had confirmed it enabled --
+    /// the firmware-authoritative counterpart of `TargetDisabledUnexpectedly`, reported under its
+    /// own spec code (`enabled_target_state_explicitly_lost`).
+    EnabledTargetStateLost,
+    /// `frozen-cool-test --firmware-authoritative` only: a UART write or read failure, or the
+    /// link closing outright, during firmware-authoritative observation -- deliberately one
+    /// combined reason (unlike the legacy loop's separate `UartWriteFailure`/`UartReadFailure`/
+    /// `TelemetryLost`), matching that mode's own spec vocabulary (`fatal_uart_write_or_read_error`).
+    FatalUartError,
+    /// `frozen-cool-test --firmware-authoritative` only: an internal panic or task failure during
+    /// firmware-authoritative observation -- the firmware-authoritative counterpart of `Panic`,
+    /// reported under that mode's own spec code (`internal_process_error`).
+    InternalProcessError,
+    /// `frozen-cool-test --firmware-authoritative` only: no valid packet of any kind was received
+    /// for longer than a conservative, prominently-warned-about silence window (see
+    /// `cool_test::FA_COMMUNICATION_SILENCE_LIMIT`) -- deliberately a much longer, separate
+    /// threshold from the legacy loop's `CommunicationWatchdogExpired` (5s): firmware-authoritative
+    /// mode's own spec explicitly forbids "the old two-second or five-second heuristic".
+    CommunicationSilenceExceeded,
+    /// Not reported in the main run's own `stop_reason` field -- this is the independent shutdown
+    /// guard's (`guard.rs`) own internal reason for the disable sequence it performs in its own
+    /// separate process, reusing `cool_test::run_cool_test_shutdown` exactly as the main run does.
+    /// Kept in this shared enum (rather than a parallel type local to `guard.rs`) purely so the
+    /// guard can reuse that one function without needing its own reason type.
+    IndependentGuardFired,
+    /// `frozen-cool-test --side both --firmware-authoritative` only: the left side's TEC reported
+    /// `"unsafe, locking"` -- the dual-side counterpart of `TecUnsafeLocking`, distinguished by
+    /// side so `stop_reason_code` can report `explicit_left_tec_unsafe_locking` specifically.
+    LeftTecUnsafeLocking,
+    /// Dual-side counterpart of `TecLocked` for the left side (`explicit_left_tec_locked`).
+    LeftTecLocked,
+    /// Dual-side counterpart of `TecUnsafeLocking` for the right side
+    /// (`explicit_right_tec_unsafe_locking`).
+    RightTecUnsafeLocking,
+    /// Dual-side counterpart of `TecLocked` for the right side (`explicit_right_tec_locked`).
+    RightTecLocked,
+    /// Dual-side counterpart of `EnabledTargetStateLost` for the left side
+    /// (`enabled_left_target_explicitly_lost`).
+    EnabledLeftTargetStateLost,
+    /// Dual-side counterpart of `EnabledTargetStateLost` for the right side
+    /// (`enabled_right_target_explicitly_lost`).
+    EnabledRightTargetStateLost,
+    /// `frozen-cool-test --side both` only: only one of the two requested sides' enabled
+    /// `TargetUpdate` was confirmed (the other never enabled, never acknowledged, or the two
+    /// confirmations didn't both arrive within the bounded confirmation window). Both sides are
+    /// disabled immediately; the run never enters active observation with only one side active.
+    PartialDualSideEnable,
+}
+
+impl StopReason {
+    pub fn description(&self) -> &'static str {
+        match self {
+            StopReason::Normal => "completed normally",
+            StopReason::CtrlC => "operator pressed Ctrl+C",
+            StopReason::Sigterm => "received SIGTERM",
+            StopReason::Sighup => "received SIGHUP",
+            StopReason::DurationExpired => "configured duration expired",
+            StopReason::UartWriteFailure => "UART write failure",
+            StopReason::UartReadFailure => "UART read failure",
+            StopReason::TelemetryLost => "lost valid telemetry",
+            StopReason::TelemetryStale => "telemetry stale for more than 2 seconds",
+            StopReason::CommunicationWatchdogExpired => "no valid packet of any kind for longer than the communication watchdog limit",
+            StopReason::TemperatureWatchdogExpired => "no fresh temperature sample for longer than the temperature watchdog limit",
+            StopReason::TemperatureStartupGraceExpired => "no temperature sample arrived within the active-phase startup grace period",
+            StopReason::DecodeFailure => "temperature decode failure during active phase",
+            StopReason::FatalStatus => "documented fatal error/status",
+            StopReason::UnknownNonzeroStatus => "unknown nonzero status that cannot be proven harmless",
+            StopReason::ImplausibleTemperatureChange => "water temperature changed implausibly fast",
+            StopReason::HeatsinkLimitExceeded => "heatsink temperature exceeded the compile-time threshold",
+            StopReason::TemperatureRangeExceeded => "water temperature left the conservative compile-time range",
+            StopReason::Panic => "internal panic or task failure",
+            StopReason::PreflightRefused => "preflight checks refused to start the active test",
+            StopReason::PumpNotConfirmedRunning => "selected-side pump still reported off/0V after the startup grace period",
+            StopReason::TecLocked => "firmware reported the selected TEC locked",
+            StopReason::TecUnsafeLocking => "firmware reported the selected TEC transitioning to unsafe (locking)",
+            StopReason::TargetDisabledUnexpectedly => "Frozen disabled the selected target unexpectedly",
+            StopReason::FirmwareFaultMessage => "firmware reported a fault condition by message",
+            StopReason::OperatorAbort => "operator reported a leak, smell, or abnormal noise",
+            StopReason::PumpFault => "firmware reported a pump fault",
+            StopReason::TargetEnabledUnexpectedly => "an unexpected enabled target appeared",
+            StopReason::FrozenReturnedToBootloader => "Frozen returned to bootloader mode during the active phase",
+            StopReason::I2cFailureDuringPriming => "I2C access failed after priming started",
+            StopReason::PrimingCompleted => "firmware reported priming complete",
+            StopReason::TargetTemperatureReached => "selected side reached the requested target temperature",
+            StopReason::FirmwareSafetyFault => "firmware reported an explicit safety fault message",
+            StopReason::EnabledTargetStateLost => "Frozen reported the selected side's enabled target lost",
+            StopReason::FatalUartError => "fatal UART write or read error",
+            StopReason::InternalProcessError => "internal process error",
+            StopReason::CommunicationSilenceExceeded => "no valid packet of any kind for longer than the communication silence limit",
+            StopReason::IndependentGuardFired => "independent shutdown guard fired",
+            StopReason::LeftTecUnsafeLocking => "firmware reported the left TEC transitioning to unsafe (locking)",
+            StopReason::LeftTecLocked => "firmware reported the left TEC locked",
+            StopReason::RightTecUnsafeLocking => "firmware reported the right TEC transitioning to unsafe (locking)",
+            StopReason::RightTecLocked => "firmware reported the right TEC locked",
+            StopReason::EnabledLeftTargetStateLost => "Frozen reported the left side's enabled target lost",
+            StopReason::EnabledRightTargetStateLost => "Frozen reported the right side's enabled target lost",
+            StopReason::PartialDualSideEnable => "only one of the two requested sides confirmed enabled",
+        }
+    }
+}
+
+impl std::fmt::Display for StopReason {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}", self.description())
+    }
+}
+
+/// Resolves as soon as Ctrl+C, SIGTERM, or SIGHUP is received. Safe to call from a non-Linux host
+/// too (SIGTERM/SIGHUP registration failures are logged and that branch simply never fires,
+/// rather than panicking) so dry-run/tests keep working on any development machine.
+pub async fn wait_for_termination_signal() -> StopReason {
+    #[cfg(unix)]
+    {
+        use tokio::signal::unix::{SignalKind, signal};
+        let mut sigterm = signal(SignalKind::terminate()).ok();
+        let mut sighup = signal(SignalKind::hangup()).ok();
+        tokio::select! {
+            _ = tokio::signal::ctrl_c() => StopReason::CtrlC,
+            _ = async { match sigterm.as_mut() { Some(s) => s.recv().await, None => std::future::pending().await } } => StopReason::Sigterm,
+            _ = async { match sighup.as_mut() { Some(s) => s.recv().await, None => std::future::pending().await } } => StopReason::Sighup,
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = tokio::signal::ctrl_c().await;
+        StopReason::CtrlC
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn descriptions_are_non_empty_for_every_reason() {
+        for reason in [
+            StopReason::Normal,
+            StopReason::CtrlC,
+            StopReason::Sigterm,
+            StopReason::Sighup,
+            StopReason::DurationExpired,
+            StopReason::UartWriteFailure,
+            StopReason::UartReadFailure,
+            StopReason::TelemetryLost,
+            StopReason::TelemetryStale,
+            StopReason::CommunicationWatchdogExpired,
+            StopReason::TemperatureWatchdogExpired,
+            StopReason::TemperatureStartupGraceExpired,
+            StopReason::DecodeFailure,
+            StopReason::FatalStatus,
+            StopReason::UnknownNonzeroStatus,
+            StopReason::ImplausibleTemperatureChange,
+            StopReason::HeatsinkLimitExceeded,
+            StopReason::TemperatureRangeExceeded,
+            StopReason::Panic,
+            StopReason::PreflightRefused,
+            StopReason::PumpNotConfirmedRunning,
+            StopReason::TecLocked,
+            StopReason::TecUnsafeLocking,
+            StopReason::TargetDisabledUnexpectedly,
+            StopReason::FirmwareFaultMessage,
+            StopReason::OperatorAbort,
+            StopReason::PumpFault,
+            StopReason::TargetEnabledUnexpectedly,
+            StopReason::FrozenReturnedToBootloader,
+            StopReason::I2cFailureDuringPriming,
+            StopReason::PrimingCompleted,
+            StopReason::TargetTemperatureReached,
+            StopReason::FirmwareSafetyFault,
+            StopReason::EnabledTargetStateLost,
+            StopReason::FatalUartError,
+            StopReason::InternalProcessError,
+            StopReason::CommunicationSilenceExceeded,
+            StopReason::IndependentGuardFired,
+            StopReason::LeftTecUnsafeLocking,
+            StopReason::LeftTecLocked,
+            StopReason::RightTecUnsafeLocking,
+            StopReason::RightTecLocked,
+            StopReason::EnabledLeftTargetStateLost,
+            StopReason::EnabledRightTargetStateLost,
+            StopReason::PartialDualSideEnable,
+        ] {
+            assert!(!reason.description().is_empty());
+        }
+    }
+}
