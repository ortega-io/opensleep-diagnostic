+        let mut link = FrozenLink::wrap(client, "test");
+        let mut i2c = MockI2c::always_succeed();
+
+        let mut a = args(Side::Left, false);
+        a.delta_c = Some(1.0); // baseline ~24.50C -> target ~23.50C (2350 centideg), well above the mock's post-enable 2200
+        a.duration_seconds = 60; // long enough that DurationExpired is never what stops it
