+async fn fetch_hardware_info(
+    framed: &mut SensorFramed,
+    audit: &mut SafetyAudit,
+    timeout: Duration,
+) -> Option<HardwareInfo> {
+    match send_and_await(framed, audit, SensorProbe::GetHardwareInfo.command(), timeout).await {
+        Ok(ExchangeOutcome::Received(pkt)) => match pkt.as_hardware_info() {
+            Some(hw) => Some(hw.clone()),
+            None => {
+                log::warn!("Sensor GetHardwareInfo got unexpected packet: {pkt:?}");
+                None
+            }
+        },
+        Ok(_) => {
+            log::warn!("Sensor did not respond to GetHardwareInfo within {timeout:?}");
+            None
+        }
+        Err(e) => {
+            log::error!("Sensor GetHardwareInfo failed: {e}");
+            None
+        }
+    }
+}
+
+async fn probe_firmware_hash(
+    framed: &mut SensorFramed,
+    audit: &mut SafetyAudit,
+    timeout: Duration,
+) -> bool {
+    match send_and_await(framed, audit, SensorProbe::GetFirmwareHash.command(), timeout).await {
+        Ok(ExchangeOutcome::Received(pkt)) => {
+            log::info!("Sensor GetFirmwareHash: {pkt:?}");
+            true
+        }
+        Ok(_) => {
+            log::debug!("Sensor did not respond to GetFirmwareHash within {timeout:?}");
+            false
+        }
+        Err(e) => {
+            log::debug!("Sensor GetFirmwareHash failed: {e}");
+            false
+        }
+    }
+}
+
+/// Result of the immediate post-reset Sensor bootloader retry-probe: repeated `Ping` at a fixed
+/// interval for a bounded duration. Built by calling `PacketCodec::decode` directly rather than
+/// through `Framed`'s `Stream` impl, because that impl never surfaces a decode error to its
+/// caller -- it just logs internally and keeps scanning -- so it cannot tell "received bytes
+/// that didn't decode" apart from "no bytes at all". Comparing the decode buffer's length before
+/// and after each `decode()` call recovers that distinction: a shrinking buffer with no packet
+/// means bytes were discarded (bad checksum, bad structure, or noise with no start byte).
+#[derive(Debug, Clone, Default)]
+pub struct SensorBootloaderProbeResult {
+    pub port_opened: bool,
+    pub open_error: Option<String>,
+    pub attempts: u32,
+    pub bytes_received: usize,
+    pub valid_frames: usize,
+    pub decode_errors: usize,
+    pub first_byte_latency: Option<Duration>,
+    pub first_valid_frame_latency: Option<Duration>,
+    /// `Some(in_firmware)` from a decoded Pong, if one was ever seen.
+    pub pong_in_firmware: Option<bool>,
+}
+
+impl SensorBootloaderProbeResult {
+    /// A "valid response" is any successfully checksum-and-structure-validated frame, matching
+    /// the summary field's literal name -- not necessarily a Pong specifically, since we only
+    /// ever transmit Ping here so any valid decoded frame is meaningful.
+    pub fn valid_response(&self) -> bool {
+        self.valid_frames > 0
+    }
+}
+
+/// Repeatedly sends `SensorCommand::Ping` at `probe_interval` for up to `probe_duration`,
+/// continuously reading and decoding between sends rather than blocking for a full timeout after
+/// each individual Ping. Stops immediately once a valid frame is decoded. Never reopens `io`.
+/// Uses a fixed-step schedule (`next_ping += probe_interval`, resynced if a write falls behind)
+/// so timing does not accumulate drift.
+async fn probe_sensor_bootloader_retries<T>(
+    io: &mut T,
+    audit: &mut SafetyAudit,
+    reference: Instant,
+    probe_duration: Duration,
+    probe_interval: Duration,
+) -> SensorBootloaderProbeResult
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    use tokio_util::codec::Decoder;
+
+    let mut result = SensorBootloaderProbeResult {
+        port_opened: true,
+        ..Default::default()
+    };
+    let mut codec = PacketCodec::<SensorPacket>::new();
+    let mut acc = BytesMut::new();
+    let mut read_buf = [0u8; 256];
+
+    let deadline = Instant::now() + probe_duration;
+    let mut next_ping = Instant::now();
+    let poll_slice = Duration::from_millis(20);
+
+    'retry: while Instant::now() < deadline {
+        let now = Instant::now();
+        if now >= next_ping {
+            result.attempts += 1;
+            let elapsed = now.saturating_duration_since(reference);
+            log::info!(
+                "Sensor bootloader Ping attempt {} at +{} ms",
+                result.attempts,
+                elapsed.as_millis()
+            );
+
+            match audit.check(&SensorProbe::Ping.command()) {
+                Ok(frame) => {
+                    if let Err(e) = io.write_all(&frame).await {
+                        log::warn!(
+                            "Sensor bootloader Ping attempt {} failed to write: {e}",
+                            result.attempts
+                        );
+                    }
+                }
+                Err(e) => {
+                    // Unreachable via any path this binary exposes -- SensorProbe::Ping is
+                    // always whitelisted. Logged loudly rather than silently ignored in case
+                    // that invariant is ever broken by a future change.
+                    log::error!("safety audit refused Sensor Ping (should be unreachable): {e}");
+                }
+            }
+
+            next_ping += probe_interval;
+            if next_ping < Instant::now() {
+                // Fell behind (e.g. a slow write); resync instead of firing a burst of
+                // already-due pings back to back.
+                next_ping = Instant::now() + probe_interval;
+            }
+        }
+
+        let now = Instant::now();
+        let wait = next_ping
+            .saturating_duration_since(now)
+            .min(deadline.saturating_duration_since(now))
+            .min(poll_slice);
+
+        match tokio::time::timeout(wait, io.read(&mut read_buf)).await {
+            Ok(Ok(0)) => {
+                log::warn!("Sensor bootloader UART closed unexpectedly");
+                break 'retry;
+            }
+            Ok(Ok(n)) => {
+                let elapsed = Instant::now().saturating_duration_since(reference);
+                if result.first_byte_latency.is_none() {
+                    result.first_byte_latency = Some(elapsed);
+                }
+                result.bytes_received += n;
+                log::debug!(
+                    "Sensor RX raw at +{} ms: {:02X?}",
+                    elapsed.as_millis(),
+                    &read_buf[..n]
+                );
+                acc.extend_from_slice(&read_buf[..n]);
+
+                loop {
+                    let before = acc.len();
+                    match codec.decode(&mut acc) {
+                        Ok(Some(pkt)) => {
+                            result.valid_frames += 1;
+                            let elapsed = Instant::now().saturating_duration_since(reference);
+                            if result.first_valid_frame_latency.is_none() {
+                                result.first_valid_frame_latency = Some(elapsed);
+                            }
+                            log::info!(
+                                "Sensor decoded response at +{} ms: {pkt:?}",
+                                elapsed.as_millis()
+                            );
+                            if let Some(in_firmware) = pkt.as_pong() {
+                                result.pong_in_firmware = Some(in_firmware);
+                            }
+                        }
+                        Ok(None) => {
+                            let after = acc.len();
+                            if after < before {
+                                result.decode_errors += 1;
+                                log::warn!(
+                                    "Sensor bootloader: discarded {} byte(s) while scanning for a valid frame (framing/checksum error or noise)",
+                                    before - after
+                                );
+                                if after == 0 {
+                                    break;
+                                }
+                                continue; // more bytes may already be buffered; keep draining
+                            }
+                            break; // no progress possible without more data
+                        }
+                        Err(e) => {
+                            result.decode_errors += 1;
+                            log::warn!("Sensor bootloader decode error: {e}");
+                            break;
+                        }
+                    }
+                }
+
+                if result.valid_frames > 0 {
+                    break 'retry;
+                }
+            }
+            Ok(Err(e)) => {
+                log::warn!("Sensor bootloader read error: {e}");
+            }
+            Err(_elapsed) => {
+                // Poll slice or next-ping wait expired with nothing to read; loop again.
+            }
+        }
+    }
+
+    result
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct SensorFirstResult {
+    pub bootloader: SensorBootloaderProbeResult,
+    pub firmware_port_opened: bool,
+    pub firmware_ping_ok: bool,
+    pub hardware_info: Option<HardwareInfo>,
+    pub firmware_hash_probed: bool,
+    pub detected_mode: DetectedMode,
+    pub firmware_jump_sent: bool,
+    pub post_jump_ping_ok: bool,
+    pub post_jump_hardware_info: Option<HardwareInfo>,
+}
+
+/// Sensor-first diagnostic sequence used when sensor-first mode is active (default whenever
+/// `--reset-subsystems` is given): bootloader retry-probe immediately, then a single
+/// firmware-mode attempt, in that fixed order. Unlike `run_sensor_phase_generic`'s "try
+/// firmware, fall back to bootloader" strategy used otherwise, this never waits out a
+/// firmware-mode timeout before ever touching the bootloader baud, so it can catch a short
+/// post-reset bootloader-listening window.
+pub async fn run_sensor_phase_reset_first<O: SensorPortOpener>(
+    opener: &mut O,
+    reset_release: Instant,
+    probe_duration: Duration,
+    probe_interval: Duration,
+    firmware_timeout: Duration,
+    allow_firmware_jump: bool,
+    audit: &mut SafetyAudit,
+) -> SensorFirstResult {
+    let mut result = SensorFirstResult::default();
+
+    // Step 5: bootloader retry-probe, immediately, on the same port for the whole probe window.
+    match opener.open_bootloader().await {
+        Ok(framed) => {
+            let mut raw = framed.into_inner();
+            raw.clear_input();
+            let opened_at = Instant::now().saturating_duration_since(reset_release);
+            log::info!(
+                "Sensor bootloader UART opened at +{} ms",
+                opened_at.as_millis()
+            );
+            result.bootloader = probe_sensor_bootloader_retries(
+                &mut raw,
+                audit,
+                reset_release,
+                probe_duration,
+                probe_interval,
+            )
+            .await;
+        }
+        Err(e) => {
+            log::error!("failed to open Sensor bootloader port: {e}");
+            result.bootloader.open_error = Some(e.to_string());
+        }
+    }
+
+    if result.bootloader.pong_in_firmware == Some(false) || result.bootloader.valid_response() {
+        result.detected_mode = DetectedMode::Bootloader;
+    }
+
+    // Step 6: firmware mode, always attempted next regardless of the bootloader outcome.
+    tokio::time::sleep(Duration::from_millis(75)).await;
+    match opener.open_firmware().await {
+        Ok(mut framed) => {
+            result.firmware_port_opened = true;
+            match send_and_await(&mut framed, audit, SensorProbe::Ping.command(), firmware_timeout)
+                .await
+            {
+                Ok(ExchangeOutcome::Received(pkt)) => match pkt.as_pong() {
+                    Some(_) => {
+                        result.firmware_ping_ok = true;
+                        result.detected_mode = DetectedMode::Firmware;
+                    }
+                    None => {
+                        log::warn!("Sensor Ping (firmware attempt) got unexpected packet: {pkt:?}")
+                    }
+                },
+                Ok(_) => log::info!(
+                    "Sensor did not respond to Ping at firmware baud ({FIRMWARE_BAUD})"
+                ),
+                Err(e) => log::warn!("Sensor Ping (firmware attempt) failed: {e}"),
+            }
+
+            if result.firmware_ping_ok {
+                result.hardware_info = fetch_hardware_info(&mut framed, audit, firmware_timeout).await;
+                result.firmware_hash_probed =
+                    probe_firmware_hash(&mut framed, audit, firmware_timeout).await;
+            }
+        }
+        Err(e) => log::error!("failed to open Sensor port at firmware baud: {e}"),
+    }
+
+    // Firmware-jump handling, gated on bootloader detection and not already confirmed firmware.
+    if result.detected_mode == DetectedMode::Bootloader && !result.firmware_ping_ok {
+        if !allow_firmware_jump {
+            log::info!("Sensor bootloader detected; firmware jump not requested");
+        } else {
+            log::warn!(
+                "Sensor bootloader detected; --allow-firmware-jump supplied, sending JumpToFirmware"
+            );
+            match opener.open_bootloader().await {
+                Ok(mut framed) => {
+                    match send_and_await(
+                        &mut framed,
+                        audit,
+                        SensorProbe::JumpToFirmware.command(),
+                        firmware_timeout,
+                    )
+                    .await
+                    {
+                        Ok(ExchangeOutcome::Received(pkt)) => {
+                            result.firmware_jump_sent = true;
+                            log::info!("Sensor JumpToFirmware response: {pkt:?}");
+                        }
+                        Ok(_) => {
+                            result.firmware_jump_sent = true;
+                            log::warn!(
+                                "Sensor did not respond to JumpToFirmware within {firmware_timeout:?}"
+                            );
+                        }
+                        Err(e) => log::error!("Sensor JumpToFirmware failed: {e}"),
+                    }
+                }
+                Err(e) => log::error!(
+                    "failed to reopen Sensor bootloader port to send JumpToFirmware: {e}"
+                ),
+            }
+
+            tokio::time::sleep(POST_JUMP_SETTLE).await;
+
+            match opener.open_firmware().await {
+                Ok(mut framed) => {
+                    match send_and_await(
+                        &mut framed,
+                        audit,
+                        SensorProbe::Ping.command(),
+                        firmware_timeout,
+                    )
+                    .await
+                    {
+                        Ok(ExchangeOutcome::Received(pkt)) => {
+                            if pkt.as_pong().is_some() {
+                                result.post_jump_ping_ok = true;
+                            } else {
+                                log::warn!("Sensor post-jump Ping got unexpected packet: {pkt:?}");
+                            }
+                        }
+                        Ok(_) => log::warn!(
+                            "Sensor did not respond to post-jump Ping within {firmware_timeout:?}"
+                        ),
+                        Err(e) => log::error!("Sensor post-jump Ping failed: {e}"),
+                    }
+                    if result.post_jump_ping_ok {
+                        result.post_jump_hardware_info =
+                            fetch_hardware_info(&mut framed, audit, firmware_timeout).await;
+                    }
+                }
+                Err(e) => {
+                    log::error!("failed to reopen Sensor port at firmware baud after jump: {e}")
+                }
+            }
+        }
+    }
+
+    result
+}
+
+pub async fn run_sensor_phase_reset_first_real(
+    port: &str,
+    reset_release: Instant,
+    probe_duration: Duration,
+    probe_interval: Duration,
+    firmware_timeout: Duration,
+    allow_firmware_jump: bool,
+) -> (SensorFirstResult, SafetyAudit) {
+    let mut audit = SafetyAudit::new(SENSOR_WHITELIST);
+    let mut opener = RealSensorPorts {
+        path: port.to_string(),
+    };
+    let result = run_sensor_phase_reset_first(
+        &mut opener,
+        reset_release,
+        probe_duration,
+        probe_interval,
+        firmware_timeout,
+        allow_firmware_jump,
+        &mut audit,
+    )
+    .await;
+    (result, audit)
+}
+
+pub async fn run_sensor_phase_generic<O: SensorPortOpener>(
+    opener: &mut O,
+    timeout: Duration,
+    allow_firmware_jump: bool,
+    audit: &mut SafetyAudit,
+) -> SensorPhaseResult {
+    let mut result = SensorPhaseResult::default();
+
+    // 1. Firmware mode first, at 115200 baud.
+    if let Ok(mut framed) = opener.open_firmware().await.inspect_err(|e| {
+        log::error!("failed to open Sensor port at firmware baud: {e}");
+    }) {
+        result.firmware_port_opened = true;
+        match send_and_await(&mut framed, audit, SensorProbe::Ping.command(), timeout).await {
+            Ok(ExchangeOutcome::Received(pkt)) => match pkt.as_pong() {
+                Some(in_firmware) => {
+                    result.detected_mode = DetectedMode::Firmware;
+                    result.ping_ok = true;
+                    if !in_firmware {
+                        log::warn!(
+                            "Sensor responded at firmware baud but its Pong reports bootloader"
+                        );
+                    }
+                }
+                None => log::warn!("Sensor Ping (firmware attempt) got unexpected packet: {pkt:?}"),
+            },
+            Ok(_) => log::info!(
+                "Sensor did not respond to Ping at firmware baud ({FIRMWARE_BAUD}); trying bootloader baud"
+            ),
+            Err(e) => log::warn!("Sensor Ping (firmware attempt) failed: {e}"),
+        }
+
+        if result.ping_ok {
+            result.hardware_info = fetch_hardware_info(&mut framed, audit, timeout).await;
+            result.firmware_hash_probed = probe_firmware_hash(&mut framed, audit, timeout).await;
+            return result;
+        }
+    }
+
+    // 2. Bootloader mode, at 38400 baud. Ping only, per spec.
+    let mut bootloader_framed = match opener.open_bootloader().await {
+        Ok(f) => {
+            result.bootloader_port_opened = true;
+            Some(f)
+        }
+        Err(e) => {
+            log::error!("failed to open Sensor port at bootloader baud: {e}");
+            None
+        }
+    };
+
+    if let Some(framed) = bootloader_framed.as_mut() {
+        match send_and_await(framed, audit, SensorProbe::Ping.command(), timeout).await {
+            Ok(ExchangeOutcome::Received(pkt)) => match pkt.as_pong() {
+                Some(in_firmware) => {
+                    result.detected_mode = DetectedMode::Bootloader;
+                    result.ping_ok = true;
+                    if in_firmware {
+                        log::warn!(
+                            "Sensor responded at bootloader baud but its Pong reports firmware"
+                        );
+                    }
+                }
+                None => {
+                    log::warn!("Sensor Ping (bootloader attempt) got unexpected packet: {pkt:?}")
+                }
+            },
+            Ok(_) => log::info!(
+                "Sensor did not respond to Ping at bootloader baud ({BOOTLOADER_BAUD}) either"
+            ),
+            Err(e) => log::warn!("Sensor Ping (bootloader attempt) failed: {e}"),
+        }
+    }
+
+    if result.detected_mode != DetectedMode::Bootloader {
+        result.detected_mode = DetectedMode::Unavailable;
+        return result;
+    }
+
+    if !allow_firmware_jump {
+        log::info!(
+            "Sensor appears to be in its bootloader; not sending JumpToFirmware (pass --allow-firmware-jump to opt in)"
+        );
+        return result;
+    }
+
+    log::warn!(
+        "Sensor appears to be in its bootloader; --allow-firmware-jump supplied, sending JumpToFirmware"
+    );
+    if let Some(mut framed) = bootloader_framed {
+        match send_and_await(&mut framed, audit, SensorProbe::JumpToFirmware.command(), timeout)
+            .await
+        {
+            Ok(ExchangeOutcome::Received(pkt)) => {
+                result.firmware_jump_sent = true;
+                log::info!("Sensor JumpToFirmware response: {pkt:?}");
+            }
+            Ok(_) => {
+                result.firmware_jump_sent = true;
+                log::warn!("Sensor did not respond to JumpToFirmware within {timeout:?}");
+            }
+            Err(e) => log::error!("Sensor JumpToFirmware failed: {e}"),
+        }
+        drop(framed);
+    }
+
+    tokio::time::sleep(POST_JUMP_SETTLE).await;
+
+    match opener.open_firmware().await {
+        Ok(mut framed) => {
+            match send_and_await(&mut framed, audit, SensorProbe::Ping.command(), timeout).await {
+                Ok(ExchangeOutcome::Received(pkt)) => {
+                    if pkt.as_pong().is_some() {
+                        result.post_jump_ping_ok = true;
+                    } else {
+                        log::warn!("Sensor post-jump Ping got unexpected packet: {pkt:?}");
+                    }
+                }
+                Ok(_) => log::warn!("Sensor did not respond to post-jump Ping within {timeout:?}"),
+                Err(e) => log::error!("Sensor post-jump Ping failed: {e}"),
+            }
+            if result.post_jump_ping_ok {
+                result.post_jump_hardware_info =
+                    fetch_hardware_info(&mut framed, audit, timeout).await;
+            }
+        }
+        Err(e) => log::error!("failed to reopen Sensor port at firmware baud after jump: {e}"),
+    }
+
+    result
+}
