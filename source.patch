+//! Structural enforcement of the per-mode Frozen command whitelist.
+//!
+//! Three independent layers keep everything except the documented command set unreachable:
+//!
+//! 1. [`FrozenAction`] is a closed enum with private fields. The *only* way to build one is
+//!    through its constructor functions (`ping`, `get_hardware_info`, ..., `enable_cooling`,
+//!    `prime`), which validate side/delta/limits before a value can exist at all. There is no
+//!    `Random` variant anywhere in this enum, so that `FrozenCommand` variant is not just
+//!    disallowed, it is unrepresentable in this binary's own command type. `Prime` *is*
+//!    representable (`frozen-prime-test` needs to send it) but is gated entirely by layer 2 below
+//!    plus the at-most-once enforcement in [`AuditedTransport::check`] -- see that method's docs.
+//! 2. [`AuditedTransport::check`] additionally gates every `FrozenAction` against the current
+//!    [`Mode`]'s whitelist before it is allowed to become bytes. `frozen-passive` never permits
+//!    an enabled `SetTargetTemperature` or `Prime`; `frozen-cool-test` permits an enabled target
+//!    for exactly the one side selected when the transport was constructed, never `Prime`;
+//!    `emergency-stop` permits only the two disable commands; `frozen-prime-test` permits `Prime`
+//!    (at most once per run -- enforced here, not just by caller discipline) but never an enabled
+//!    `SetTargetTemperature`.
+//! 3. As defense in depth, `check` also inspects the serialized opcode byte and refuses anything
+//!    outside a fixed allowed-opcode set, so even a future bug in (1)/(2) fails closed.
+//!
+//! Every accepted command is recorded in [`AuditedTransport::entries`] with its name, side,
+//! enabled state, target, serialized bytes, timestamp, and mode -- this is the "central audited
+//! transport" the safety model requires, and the JSON report is built directly from it. Every
+//! rejected attempt (wrong mode, or a repeated `Prime`) increments
+//! [`AuditedTransport::rejected_command_count`], the audited "unknown commands attempted" counter.
+
+use std::fmt;
+
+use jiff::Timestamp;
+use opensleep::common::codec::CommandTrait;
+use opensleep::common::packet::BedSide;
+use opensleep::frozen::FrozenCommand;
+use opensleep::frozen::packet::FrozenTarget;
+
+/// Maximum permitted cooling delta below the validated baseline: 2.0 degrees C.
+pub const MAX_COOL_DELTA_CENTIDEG: i32 = 200;
+/// Default cooling delta below the validated baseline: 1.0 degrees C. `cli.rs`'s
+/// `--delta-c` default (`1.0`) is the degrees-C form of this same value; see
+/// `tests::default_delta_flag_matches_default_delta_constant` for the cross-check.
+#[allow(dead_code)] // documented reference constant, not currently read at runtime; see cli.rs --delta-c
+pub const DEFAULT_COOL_DELTA_CENTIDEG: i32 = 100;
+
+/// The temperature field used for every disable (`enabled = false`) command. This is not an
+/// invented placeholder: it is exactly the value stock OpenSleep itself transmits for a disabled
+/// target (`FrozenTarget::default()`, sent by `frozen::profile::FrozenTarget::calc_wanted` for
+/// `away_mode` and by `SideConfig::calc_target` whenever no profile segment matches "now"). Using
+/// the same value stock firmware already sends in normal operation is the strongest available
+/// evidence that it is accepted, without guessing at undocumented firmware behavior.
+pub const DISABLE_TARGET_CENTIDEG: u16 = 0;
+
+/// Opcode-level defense in depth: the only Frozen opcodes this binary will ever serialize,
+/// regardless of mode. `0x40` (`SetTargetTemperature`) is included because both the disable and
+/// (mode-gated) enable commands use it. `0x52` (`Prime`) is included because `frozen-prime-test`
+/// needs to send it -- this opcode check runs *after* the mode/at-most-once checks in
+/// `AuditedTransport::check`, so it does not by itself grant Prime to any other mode. Any other
+/// opcode is refused even if some future change to `FrozenAction` accidentally reached this layer.
+const ALLOWED_OPCODES: &[u8] = &[0x01, 0x02, 0x04, 0x10, 0x40, 0x41, 0x52];
+
+/// Which diagnostic subcommand is currently running. Determines the whitelist `AuditedTransport`
+/// enforces; see module docs.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Mode {
+    Passive,
+    /// `side` is the one side this run is permitted to enable. Fixed for the lifetime of the
+    /// transport -- there is no way to change it after construction.
+    CoolTest { side: BedSide },
+    EmergencyStop,
+    /// Permits `Prime` (at most once -- see `AuditedTransport::check`) in addition to everything
+    /// `Passive` permits. Never permits an enabled `SetTargetTemperature`: this mode primes the
+    /// hydraulic loop, it does not run a cooling/heating test.
+    PrimeTest,
+}
+
+impl Mode {
+    pub fn label(&self) -> &'static str {
+        match self {
+            Mode::Passive => "frozen-passive",
+            Mode::CoolTest { .. } => "frozen-cool-test",
+            Mode::EmergencyStop => "emergency-stop",
+            Mode::PrimeTest => "frozen-prime-test",
+        }
+    }
+}
+
+/// The only Frozen actions constructible anywhere in this binary. Fields are private; every
+/// value is built through a constructor below, so CLI input can never assemble an arbitrary
+/// opcode, side, enabled flag, or temperature target.
+#[derive(Debug, Clone, PartialEq)]
+pub enum FrozenAction {
+    Ping,
+    GetHardwareInfo,
+    GetFirmware,
+    JumpToFirmware,
+    GetTemperatures,
+    SafetyOff {
+        side: BedSide,
+    },
+    EnableCooling {
+        side: BedSide,
+        target_centideg: u16,
+    },
+    /// `FrozenCommand::Prime` (opcode 0x52), reused unmodified -- see PROTOCOL_AUDIT.md for the
+    /// full source audit. Takes no arguments: the upstream command applies to both sides in one
+    /// shot: there is no per-side Prime. Only ever constructible via `FrozenAction::prime()`
+    /// (this variant has no fields, but there is still exactly one path to it, matching every
+    /// other variant's convention); only ever permitted by `AuditedTransport::check` in
+    /// `Mode::PrimeTest`, and only once per run -- see that method.
+    Prime,
+}
+
+/// Returned by [`FrozenAction::enable_cooling`] when the requested delta exceeds the hard limit,
+/// or the computed target would be physically implausible. There is no code path that bypasses
+/// this check: `EnableCooling`'s fields are private, so this constructor is the only way to
+/// produce one.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CoolingLimitError(pub String);
+
+impl fmt::Display for CoolingLimitError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}", self.0)
+    }
+}
+impl std::error::Error for CoolingLimitError {}
+
+impl FrozenAction {
+    pub fn ping() -> Self {
+        FrozenAction::Ping
+    }
+    pub fn get_hardware_info() -> Self {
+        FrozenAction::GetHardwareInfo
+    }
+    pub fn get_firmware() -> Self {
+        FrozenAction::GetFirmware
+    }
+    pub fn jump_to_firmware() -> Self {
+        FrozenAction::JumpToFirmware
+    }
+    pub fn get_temperatures() -> Self {
+        FrozenAction::GetTemperatures
+    }
+    pub fn safety_off(side: BedSide) -> Self {
+        FrozenAction::SafetyOff { side }
+    }
+    pub fn prime() -> Self {
+        FrozenAction::Prime
+    }
+
+    /// Validates and builds the single enabled `SetTargetTemperature` this binary can ever send.
+    /// `delta_centideg` must be within `[0, MAX_COOL_DELTA_CENTIDEG]` and `baseline_centideg` must
+    /// already have passed the caller's baseline sanity range check; this function additionally
+    /// refuses a target that would fall outside a conservative absolute range as a last-resort
+    /// backstop.
+    pub fn enable_cooling(
+        side: BedSide,
+        baseline_centideg: u16,
+        delta_centideg: i32,
+    ) -> Result<Self, CoolingLimitError> {
+        if delta_centideg < 0 {
+            return Err(CoolingLimitError(format!(
+                "cooling delta must not be negative (heating is not implemented by this tool), got {delta_centideg}"
+            )));
+        }
+        if delta_centideg > MAX_COOL_DELTA_CENTIDEG {
+            return Err(CoolingLimitError(format!(
+                "requested delta {}.{:02}C exceeds the maximum permitted {}.{:02}C; refusing (no option may override this limit)",
+                delta_centideg / 100, delta_centideg % 100,
+                MAX_COOL_DELTA_CENTIDEG / 100, MAX_COOL_DELTA_CENTIDEG % 100,
+            )));
+        }
+        let target = i32::from(baseline_centideg) - delta_centideg;
+        // Absolute backstop, independent of the caller's own baseline-range validation: refuse a
+        // target outside a wide but still conservative 0-45C envelope.
+        if !(0..=4500).contains(&target) {
+            return Err(CoolingLimitError(format!(
+                "computed target {target} centidegrees C is outside the conservative 0-45C backstop range"
+            )));
+        }
+        Ok(FrozenAction::EnableCooling {
+            side,
+            target_centideg: target as u16,
+        })
+    }
+
+    pub fn to_command(&self) -> FrozenCommand {
+        match self {
+            FrozenAction::Ping => FrozenCommand::Ping,
+            FrozenAction::GetHardwareInfo => FrozenCommand::GetHardwareInfo,
+            FrozenAction::GetFirmware => FrozenCommand::GetFirmware,
+            FrozenAction::JumpToFirmware => FrozenCommand::JumpToFirmware,
+            FrozenAction::GetTemperatures => FrozenCommand::GetTemperatures,
+            FrozenAction::SafetyOff { side } => FrozenCommand::SetTargetTemperature {
+                side: *side,
+                tar: FrozenTarget {
+                    enabled: false,
+                    temp: DISABLE_TARGET_CENTIDEG,
+                },
+            },
+            FrozenAction::EnableCooling {
+                side,
+                target_centideg,
+            } => FrozenCommand::SetTargetTemperature {
+                side: *side,
+                tar: FrozenTarget {
+                    enabled: true,
+                    temp: *target_centideg,
+                },
+            },
+            FrozenAction::Prime => FrozenCommand::Prime,
+        }
+    }
+
+    pub fn name(&self) -> &'static str {
+        match self {
+            FrozenAction::Ping => "Ping",
+            FrozenAction::GetHardwareInfo => "GetHardwareInfo",
+            FrozenAction::GetFirmware => "GetFirmware",
+            FrozenAction::JumpToFirmware => "JumpToFirmware",
+            FrozenAction::GetTemperatures => "GetTemperatures",
+            FrozenAction::SafetyOff { .. } => "SetTargetTemperature(disable)",
+            FrozenAction::EnableCooling { .. } => "SetTargetTemperature(enable)",
+            FrozenAction::Prime => "Prime",
+        }
+    }
+
+    pub fn side(&self) -> Option<BedSide> {
+        match self {
+            FrozenAction::SafetyOff { side } => Some(*side),
+            FrozenAction::EnableCooling { side, .. } => Some(*side),
+            _ => None,
+        }
+    }
+
+    pub fn enabled(&self) -> Option<bool> {
+        match self {
+            FrozenAction::SafetyOff { .. } => Some(false),
+            FrozenAction::EnableCooling { .. } => Some(true),
+            _ => None,
+        }
+    }
+
+    pub fn target_centideg(&self) -> Option<u16> {
+        match self {
+            FrozenAction::SafetyOff { .. } => Some(DISABLE_TARGET_CENTIDEG),
+            FrozenAction::EnableCooling {
+                target_centideg, ..
+            } => Some(*target_centideg),
+            _ => None,
+        }
+    }
+}
+
+fn allowed_in_mode(mode: Mode, action: &FrozenAction) -> bool {
+    use FrozenAction::*;
+    match mode {
+        Mode::Passive => matches!(
+            action,
+            Ping | GetHardwareInfo | GetFirmware | JumpToFirmware | GetTemperatures | SafetyOff { .. }
+        ),
+        Mode::CoolTest { side: allowed_side } => match action {
+            Ping | GetHardwareInfo | GetFirmware | JumpToFirmware | GetTemperatures
+            | SafetyOff { .. } => true,
+            EnableCooling { side, .. } => *side == allowed_side,
+            Prime => false,
+        },
+        Mode::EmergencyStop => matches!(action, SafetyOff { .. }),
+        // Never EnableCooling: frozen-prime-test fills the loop, it does not run a cooling test.
+        // Prime's at-most-once enforcement lives in AuditedTransport::check, not here.
+        Mode::PrimeTest => matches!(
+            action,
+            Ping | GetHardwareInfo | GetFirmware | JumpToFirmware | GetTemperatures | SafetyOff { .. } | Prime
+        ),
+    }
+}
+
+/// Raised by [`AuditedTransport::check`]. Should be unreachable via any path this binary exposes;
+/// its purpose is to make that claim falsifiable in tests and to fail closed if it is ever wrong.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SafetyViolation {
+    pub action_name: &'static str,
+    pub reason: String,
+}
+
+impl fmt::Display for SafetyViolation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            f,
+            "refused to transmit {}: {}",
+            self.action_name, self.reason
+        )
+    }
+}
+impl std::error::Error for SafetyViolation {}
+
+/// One outgoing command, as actually recorded by [`AuditedTransport::check`].
+#[derive(Debug, Clone)]
+pub struct AuditEntry {
+    pub command_name: String,
+    pub side: Option<BedSide>,
+    pub enabled: Option<bool>,
+    pub target_centideg: Option<u16>,
+    pub bytes: Vec<u8>,
+    pub timestamp: String,
+    pub mode: String,
+}
+
+/// The central audited transport. Every outgoing Frozen command in this binary -- real hardware
+/// or mock alike -- passes through [`AuditedTransport::check`] before it can be serialized and
+/// sent. See module docs for the three enforcement layers.
+pub struct AuditedTransport {
+    mode: Mode,
+    log: Vec<AuditEntry>,
+    enabled_target_count: u32,
+    prime_count: u32,
+    rejected_command_count: u32,
+}
+
+impl AuditedTransport {
+    pub fn new(mode: Mode) -> Self {
+        Self {
+            mode,
+            log: Vec::new(),
+            enabled_target_count: 0,
+            prime_count: 0,
+            rejected_command_count: 0,
+        }
+    }
+
+    pub fn mode(&self) -> Mode {
+        self.mode
+    }
+
+    /// Validates `action` against the mode whitelist, the Prime-at-most-once rule, and the opcode
+    /// backstop, and -- only if all three pass -- serializes it, records the audit entry, and
+    /// returns the frame bytes to send. Every rejection (any reason) increments
+    /// `rejected_command_count`, the audited "unknown commands attempted" counter.
+    pub fn check(&mut self, action: &FrozenAction) -> Result<Vec<u8>, SafetyViolation> {
+        if !allowed_in_mode(self.mode, action) {
+            self.rejected_command_count += 1;
+            return Err(SafetyViolation {
+                action_name: action.name(),
+                reason: format!("not permitted in mode {}", self.mode.label()),
+            });
+        }
+
+        // Structural "Prime at most once per run" enforcement -- not just a matter of this
+        // binary's own control flow only calling it once, but a hard refusal at the transport
+        // layer if it is ever attempted a second time for any reason (a bug, a retry, anything).
+        if matches!(action, FrozenAction::Prime) && self.prime_count > 0 {
+            self.rejected_command_count += 1;
+            return Err(SafetyViolation {
+                action_name: action.name(),
+                reason: "Prime was already sent once this run; repeated Prime is refused".to_string(),
+            });
+        }
+
+        let cmd = action.to_command();
+        let frame = cmd.to_bytes();
+        let opcode = frame.get(2).copied();
+        match opcode {
+            Some(op) if ALLOWED_OPCODES.contains(&op) => {}
+            _ => {
+                self.rejected_command_count += 1;
+                return Err(SafetyViolation {
+                    action_name: action.name(),
+                    reason: format!("opcode {opcode:?} outside the fixed allowed set"),
+                });
+            }
+        }
+
+        if action.enabled() == Some(true) {
+            self.enabled_target_count += 1;
+        }
+        if matches!(action, FrozenAction::Prime) {
+            self.prime_count += 1;
+        }
+
+        self.log.push(AuditEntry {
+            command_name: action.name().to_string(),
+            side: action.side(),
+            enabled: action.enabled(),
+            target_centideg: action.target_centideg(),
+            bytes: frame.clone(),
+            timestamp: Timestamp::now().to_string(),
+            mode: self.mode.label().to_string(),
+        });
+
+        Ok(frame)
+    }
+
+    pub fn entries(&self) -> &[AuditEntry] {
+        &self.log
+    }
+
+    #[allow(dead_code)] // exercised directly by this module's own tests; kept as public API for callers/tests
+    pub fn sent_count(&self) -> usize {
+        self.log.len()
+    }
+
+    pub fn enabled_target_count(&self) -> u32 {
+        self.enabled_target_count
+    }
+
+    /// Real per-run count of accepted `Prime` sends: 0 in every mode except `frozen-prime-test`,
+    /// where `check`'s at-most-once rule caps it at 1. Kept as a method (rather than a bare
+    /// constant) so the JSON report can cite it next to `enabled_target_count`.
+    pub fn prime_count(&self) -> u32 {
+        self.prime_count
+    }
+
+    /// Structurally always zero: `FrozenAction` has no `Random` variant.
+    pub fn random_count(&self) -> u32 {
+        0
+    }
+
+    /// Every command `check` refused, for any reason (wrong mode, repeated Prime, opcode
+    /// backstop) -- the audited "unknown commands attempted" counter.
+    pub fn rejected_command_count(&self) -> u32 {
+        self.rejected_command_count
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn passive_allows_only_the_documented_actions() {
+        let mut audit = AuditedTransport::new(Mode::Passive);
+        for action in [
+            FrozenAction::ping(),
+            FrozenAction::get_hardware_info(),
+            FrozenAction::get_firmware(),
+            FrozenAction::jump_to_firmware(),
+            FrozenAction::get_temperatures(),
+            FrozenAction::safety_off(BedSide::Left),
+            FrozenAction::safety_off(BedSide::Right),
+        ] {
+            assert!(audit.check(&action).is_ok(), "{action:?} should be allowed in passive");
+        }
+        assert_eq!(audit.sent_count(), 7);
+        assert_eq!(audit.enabled_target_count(), 0);
+    }
+
+    #[test]
+    fn passive_rejects_enabled_cooling_for_either_side() {
+        let mut audit = AuditedTransport::new(Mode::Passive);
+        let left = FrozenAction::enable_cooling(BedSide::Left, 2400, 100).unwrap();
+        let right = FrozenAction::enable_cooling(BedSide::Right, 2400, 100).unwrap();
+        assert!(audit.check(&left).is_err());
+        assert!(audit.check(&right).is_err());
+        assert_eq!(audit.sent_count(), 0);
+        assert_eq!(audit.enabled_target_count(), 0);
+    }
+
+    #[test]
+    fn cool_test_allows_enabled_cooling_only_for_its_selected_side() {
+        let mut audit = AuditedTransport::new(Mode::CoolTest { side: BedSide::Left });
+        let left = FrozenAction::enable_cooling(BedSide::Left, 2400, 100).unwrap();
+        let right = FrozenAction::enable_cooling(BedSide::Right, 2400, 100).unwrap();
+        assert!(audit.check(&left).is_ok());
+        assert!(audit.check(&right).is_err());
+        assert_eq!(audit.enabled_target_count(), 1);
+    }
+
+    #[test]
+    fn cool_test_never_allows_both_sides_enabled_in_the_same_run() {
+        // A single AuditedTransport is bound to exactly one Mode::CoolTest { side }, fixed at
+        // construction, so there is no sequence of calls against it that enables both sides.
+        let mut audit = AuditedTransport::new(Mode::CoolTest { side: BedSide::Right });
+        let right = FrozenAction::enable_cooling(BedSide::Right, 2400, 100).unwrap();
+        let left = FrozenAction::enable_cooling(BedSide::Left, 2400, 100).unwrap();
+        assert!(audit.check(&right).is_ok());
+        assert!(audit.check(&left).is_err());
+        assert_eq!(audit.enabled_target_count(), 1);
+    }
+
+    #[test]
+    fn cooling_delta_above_max_is_rejected_at_construction() {
+        assert!(FrozenAction::enable_cooling(BedSide::Left, 2400, 200).is_ok());
+        assert!(FrozenAction::enable_cooling(BedSide::Left, 2400, 201).is_err());
+        assert!(FrozenAction::enable_cooling(BedSide::Left, 2400, 1000).is_err());
+    }
+
+    #[test]
+    fn cooling_delta_cannot_be_negative_ie_no_heating() {
+        assert!(FrozenAction::enable_cooling(BedSide::Left, 2400, -1).is_err());
+    }
+
+    #[test]
+    fn emergency_stop_allows_only_the_two_disable_commands() {
+        let mut audit = AuditedTransport::new(Mode::EmergencyStop);
+        assert!(audit.check(&FrozenAction::safety_off(BedSide::Left)).is_ok());
+        assert!(audit.check(&FrozenAction::safety_off(BedSide::Right)).is_ok());
+        assert!(audit.check(&FrozenAction::ping()).is_err());
+        assert!(audit.check(&FrozenAction::get_hardware_info()).is_err());
+        assert!(audit
+            .check(&FrozenAction::enable_cooling(BedSide::Left, 2400, 100).unwrap())
+            .is_err());
+        assert_eq!(audit.sent_count(), 2);
+    }
+
+    #[test]
+    fn prime_and_random_counts_are_zero_outside_prime_test_mode() {
+        for mode in [
+            Mode::Passive,
+            Mode::CoolTest { side: BedSide::Left },
+            Mode::EmergencyStop,
+        ] {
+            let audit = AuditedTransport::new(mode);
+            assert_eq!(audit.prime_count(), 0);
+            assert_eq!(audit.random_count(), 0);
+        }
+    }
+
+    #[test]
+    fn random_count_is_always_zero() {
+        // FrozenAction has no Random variant at all, in any mode.
+        let audit = AuditedTransport::new(Mode::PrimeTest);
+        assert_eq!(audit.random_count(), 0);
+    }
+
+    #[test]
+    fn prime_test_mode_allows_prime_exactly_once() {
+        let mut audit = AuditedTransport::new(Mode::PrimeTest);
+        assert!(audit.check(&FrozenAction::prime()).is_ok());
+        assert_eq!(audit.prime_count(), 1);
+        let second = audit.check(&FrozenAction::prime());
+        assert!(second.is_err(), "a second Prime in the same run must be refused");
+        assert_eq!(audit.prime_count(), 1, "the refused second attempt must not increment the count");
+        assert_eq!(audit.rejected_command_count(), 1);
+    }
+
+    #[test]
+    fn prime_test_mode_never_allows_an_enabled_target() {
+        let mut audit = AuditedTransport::new(Mode::PrimeTest);
+        let left = FrozenAction::enable_cooling(BedSide::Left, 2400, 100).unwrap();
+        let right = FrozenAction::enable_cooling(BedSide::Right, 2400, 100).unwrap();
+        assert!(audit.check(&left).is_err());
+        assert!(audit.check(&right).is_err());
+        assert_eq!(audit.enabled_target_count(), 0);
+        assert_eq!(audit.rejected_command_count(), 2);
+    }
+
+    #[test]
+    fn prime_is_refused_outside_prime_test_mode() {
+        for mode in [
+            Mode::Passive,
+            Mode::CoolTest { side: BedSide::Left },
+            Mode::EmergencyStop,
+        ] {
+            let mut audit = AuditedTransport::new(mode);
+            let result = audit.check(&FrozenAction::prime());
+            assert!(result.is_err(), "Prime must be refused in {mode:?}");
+            assert_eq!(audit.prime_count(), 0);
+            assert_eq!(audit.rejected_command_count(), 1);
+        }
+    }
+
+    #[test]
+    fn prime_test_mode_allows_the_documented_non_prime_actions_too() {
+        let mut audit = AuditedTransport::new(Mode::PrimeTest);
+        for action in [
+            FrozenAction::ping(),
+            FrozenAction::get_hardware_info(),
+            FrozenAction::get_firmware(),
+            FrozenAction::jump_to_firmware(),
+            FrozenAction::get_temperatures(),
+            FrozenAction::safety_off(BedSide::Left),
+            FrozenAction::safety_off(BedSide::Right),
+        ] {
+            assert!(audit.check(&action).is_ok(), "{action:?} should be allowed in frozen-prime-test");
+        }
+        assert_eq!(audit.rejected_command_count(), 0);
+    }
+
+    #[test]
+    fn default_delta_flag_matches_default_delta_constant() {
+        assert_eq!(DEFAULT_COOL_DELTA_CENTIDEG as f64 / 100.0, 1.0);
+    }
+
+    #[test]
+    fn audit_entries_record_every_required_field() {
+        let mut audit = AuditedTransport::new(Mode::CoolTest { side: BedSide::Left });
+        let action = FrozenAction::enable_cooling(BedSide::Left, 2400, 100).unwrap();
+        audit.check(&action).unwrap();
+        let entry = &audit.entries()[0];
+        assert_eq!(entry.side, Some(BedSide::Left));
+        assert_eq!(entry.enabled, Some(true));
+        assert_eq!(entry.target_centideg, Some(2300));
+        assert!(!entry.bytes.is_empty());
+        assert!(!entry.timestamp.is_empty());
+        assert_eq!(entry.mode, "frozen-cool-test");
+    }
+
+    /// Command-audit test: enumerates every `FrozenCommand` variant that exists in the shared
+    /// library and proves which modes (if any) can reach it through `FrozenAction`.
+    #[test]
+    fn every_frozen_command_variant_is_accounted_for_by_mode() {
+        // (label, constructible via FrozenAction at all, allowed in passive, allowed in cool-test, allowed in emergency-stop, allowed in prime-test)
+        let cases: Vec<(&str, Option<FrozenAction>)> = vec![
+            ("Ping", Some(FrozenAction::ping())),
+            ("GetHardwareInfo", Some(FrozenAction::get_hardware_info())),
+            ("GetFirmware", Some(FrozenAction::get_firmware())),
+            ("JumpToFirmware", Some(FrozenAction::jump_to_firmware())),
+            ("GetTemperatures", Some(FrozenAction::get_temperatures())),
+            (
+                "SetTargetTemperature(disable)",
+                Some(FrozenAction::safety_off(BedSide::Left)),
+            ),
+            (
+                "SetTargetTemperature(enable)",
+                FrozenAction::enable_cooling(BedSide::Left, 2400, 100).ok(),
+            ),
+            // Prime is constructible (frozen-prime-test needs to send it) but only ever accepted
+            // by AuditedTransport::check in Mode::PrimeTest -- proven below, not by construction.
+            ("Prime", Some(FrozenAction::prime())),
+            // Random has no FrozenAction constructor at all: this binary's own command type
+            // cannot represent it, independent of any whitelist.
+            ("Random", None),
+        ];
+
+        let mut passive = AuditedTransport::new(Mode::Passive);
+        let mut cool_left = AuditedTransport::new(Mode::CoolTest { side: BedSide::Left });
+        let mut emergency = AuditedTransport::new(Mode::EmergencyStop);
+        let mut prime_test = AuditedTransport::new(Mode::PrimeTest);
+
+        for (label, action) in cases {
+            match action {
+                None => { /* unreachable by construction: Random */ }
+                Some(action) => {
+                    let p = passive.check(&action).is_ok();
+                    let c = cool_left.check(&action).is_ok();
+                    let e = emergency.check(&action).is_ok();
+                    let pt = prime_test.check(&action).is_ok();
+                    log::debug!("{label}: passive={p} cool-test(left)={c} emergency-stop={e} prime-test={pt}");
+                    if label == "Prime" {
+                        assert!(!p && !c && !e, "Prime must never be accepted outside frozen-prime-test");
+                        assert!(pt, "Prime must be accepted in frozen-prime-test");
+                    }
+                    if label == "SetTargetTemperature(enable)" {
+                        assert!(!pt, "an enabled target must never be accepted in frozen-prime-test");
+                    }
+                }
+            }
+        }
+    }
+}
