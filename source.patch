+    /// A fake device that, once enabled, keeps sending pump/TEC-current `Message` traffic every
+    /// ~1s tick (well under `ANY_VALID_RX_LIMIT`, so the communication watchdog never fires) but
+    /// never sends a temperature sample of any kind -- proving the two watchdogs are genuinely
+    /// independent: `last_any_valid_rx_at` stays fresh from the `Message` traffic alone, while
+    /// `last_temperature_sample_at` (seeded once during baseline) goes stale on its own separate
+    /// clock.
+    fn spawn_device_with_message_traffic_but_no_active_phase_temperature(
+        mut device_side: tokio::io::DuplexStream,
+    ) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            let mut enabled = false;
+            let mut count: u8 = 0;
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        let response = match opcode {
+                            0x01 => Some(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x41 if !enabled => {
+                                count = count.wrapping_add(1);
+                                Some(opensleep::common::codec::command(vec![
+                                    0x41, 0x09, 0x9A, 0x09, 0xA4, 0x0A, 0x28, 9, count,
+                                ]))
+                            }
+                            0x41 => {
+                                // Once enabled: valid Message traffic every tick, but never a
+                                // temperature sample of any kind.
+                                let mut p = vec![0x07u8, 0x00];
+                                p.extend_from_slice(b"FW: tec[left] current: 11.364773 A");
+                                Some(opensleep::common::codec::command(p))
+                            }
+                            0x40 if payload.len() == 5 => {
+                                if payload[2] == 1 {
+                                    enabled = true;
+                                }
+                                Some(opensleep::common::codec::command(vec![
+                                    0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                                ]))
+                            }
+                            _ => None,
+                        };
+                        if let Some(resp) = response
+                            && device_side.write_all(&resp).await.is_err()
+                        {
+                            break;
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
