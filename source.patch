+    /// A fake device that only ever answers a `GetTemperatures` request (opcode `0x41`) with the
+    /// raw, firmware-specific 14-byte `GetTemperature` reply -- never an unsolicited
+    /// `TemperatureUpdate` push. The normal `Framed`/`PacketCodec` decode path can never produce a
+    /// packet from these replies (wrong size for the unmodified upstream parser); only
+    /// `frozen_compat::CompatFrameScanner`, reading the same bytes from `RawIoCapture` below
+    /// `Framed`, can recover them. Reusing this device across ticks to satisfy `BASELINE_MIN_SAMPLES`
+    /// is therefore a direct, end-to-end proof that item 1/2's fix actually closes the real-hardware
+    /// gap this whole change was written for, not just that the standalone decoder works in isolation.
+    fn spawn_device_replying_only_with_14byte_get_temperature(mut device_side: tokio::io::DuplexStream) -> tokio::task::JoinHandle<()> {
+        use bytes::{Buf, BytesMut};
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        // Exact payload captured from MT8365 / Frozen firmware v1.4.235 real hardware.
+        const FIXTURE_1: [u8; 14] = [0xC1, 0x00, 0x01, 0x0A, 0x5A, 0x02, 0x0A, 0x3A, 0x03, 0x09, 0x92, 0x04, 0x09, 0xC4];
+        tokio::spawn(async move {
+            let mut acc = BytesMut::new();
+            let mut read_buf = [0u8; 256];
+            loop {
+                if acc.len() >= 2 {
+                    let len = acc[1] as usize;
+                    let total = 1 + 1 + len + 2;
+                    if acc.len() >= total {
+                        let opcode = acc[2];
+                        let payload = acc[2..2 + len].to_vec();
+                        acc.advance(total);
+                        let response = match opcode {
+                            0x01 => Some(opensleep::common::codec::command(vec![0x81, 0x00, 0b0100_0110])),
+                            0x41 => Some(opensleep::common::codec::command(FIXTURE_1.to_vec())),
+                            0x40 if payload.len() == 5 => Some(opensleep::common::codec::command(vec![
+                                0xC0, 0x00, payload[1], payload[2], payload[3], payload[4],
+                            ])),
+                            _ => None,
+                        };
+                        if let Some(resp) = response
+                            && device_side.write_all(&resp).await.is_err()
+                        {
+                            break;
+                        }
+                        continue;
+                    }
+                }
+                match device_side.read(&mut read_buf).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(n) => acc.extend_from_slice(&read_buf[..n]),
+                }
+            }
+        })
+    }
