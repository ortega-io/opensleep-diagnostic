new file mode 100644
index 0000000..29da4a1
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/sensor_mock.rs
@@ -0,0 +1,181 @@
+//! Mock Sensor MCU used by `sensor-probe --dry-run` (so dry-run is testable on a normal
+//! development computer with no real hardware attached) and reused directly by integration tests.
+//! Speaks the exact real wire framing (`opensleep::common::codec::command`) on one end of a
+//! `tokio::io::duplex` pair; the diagnostic's own code talks to the other end exactly as it would a
+//! real serial port. Mirrors `mock.rs`'s role for Frozen.
+
+use bytes::{Buf, BytesMut};
+use hex_literal::hex;
+use tokio::io::{AsyncReadExt, AsyncWriteExt, DuplexStream};
+use tokio::time::Duration;
+
+fn mock_pong_frame(in_firmware: bool) -> Vec<u8> {
+    let code: u8 = if in_firmware { 0b0100_0110 } else { 0b0100_0010 };
+    opensleep::common::codec::command(vec![0x81, 0x00, code])
+}
+
+fn mock_jumping_to_firmware_frame() -> Vec<u8> {
+    opensleep::common::codec::command(vec![0x90, 0x00])
+}
+
+/// Reuses the exact CBOR fixture verified by `opensleep::common::packet::tests::test_hardware_info`.
+fn mock_hardware_info_frame() -> Vec<u8> {
+    let payload = hex!(
+        "82 00 A6 63 73 6B 75 01 68 64 61 74 65
+        63 6F 64 65 1A 00 16 01 0D 6B 66 61 63
+        74 6F 72 79 6C 69 6E 65 01 65 68 77 72
+        65 76 19 05 00 62 70 6E 19 50 78 68 64
+        65 76 69 63 65 73 6E 1A 00 01 08 9C"
+    );
+    opensleep::common::codec::command(payload.to_vec())
+}
+
+/// `SensorPacket::parse_get_firmware`'s exact layout: opcode 0x84 + one value byte (always 4, per
+/// `opensleep::sensor::packet::tests::test_get_fw`).
+fn mock_get_firmware_frame() -> Vec<u8> {
+    opensleep::common::codec::command(vec![0x84, 0x04])
+}
+
+/// `SensorPacket::parse_capacitance`'s exact layout: sequence + 6 index/value pairs (values 0-5).
+fn mock_capacitance_frame(sequence: u32, values: [u16; 6]) -> Vec<u8> {
+    let seq = sequence.to_be_bytes();
+    let mut payload = vec![0x33, seq[0], seq[1], seq[2], seq[3], 0x00, 0x00, 0x00, 0x00];
+    for (i, v) in values.iter().enumerate() {
+        let b = v.to_be_bytes();
+        payload.extend_from_slice(&[i as u8, b[0], b[1]]);
+    }
+    opensleep::common::codec::command(payload)
+}
+
+/// `SensorPacket::parse_temperature`'s exact layout: 11 index/value pairs (indices 0-10), the last
+/// three being ambient/humidity/microcontroller.
+fn mock_temperature_frame(bed: [u16; 8], ambient: u16, humidity: u16, microcontroller: u16) -> Vec<u8> {
+    let mut payload = vec![0xAF, 0x00];
+    for (i, v) in bed.iter().enumerate() {
+        let b = v.to_be_bytes();
+        payload.extend_from_slice(&[i as u8, b[0], b[1]]);
+    }
+    for (i, v) in [ambient, humidity, microcontroller].iter().enumerate() {
+        let b = v.to_be_bytes();
+        payload.extend_from_slice(&[(8 + i) as u8, b[0], b[1]]);
+    }
+    opensleep::common::codec::command(payload)
+}
+
+/// `SensorPacket::parse_piezo`'s exact layout: freq + sequence + gain pair + interleaved
+/// left/right sample pairs.
+fn mock_piezo_frame(freq: u32, sequence: u32, gain: (u16, u16), left: &[u16], right: &[u16]) -> Vec<u8> {
+    let mut payload = vec![0x32, 0x02];
+    payload.extend_from_slice(&freq.to_be_bytes());
+    payload.extend_from_slice(&sequence.to_be_bytes());
+    payload.extend_from_slice(&gain.0.to_be_bytes());
+    payload.extend_from_slice(&gain.1.to_be_bytes());
+    for (l, r) in left.iter().zip(right.iter()) {
+        payload.extend_from_slice(&l.to_be_bytes());
+        payload.extend_from_slice(&r.to_be_bytes());
+    }
+    opensleep::common::codec::command(payload)
+}
+
+/// Plausible fixed telemetry values used by every mock below.
+const MOCK_CAPACITANCE: [u16; 6] = [100, 110, 120, 200, 210, 220];
+const MOCK_BED_TEMP: [u16; 8] = [2400, 2401, 2402, 2403, 2404, 2405, 2406, 2407];
+const MOCK_AMBIENT_CENTIDEG: u16 = 2200;
+const MOCK_HUMIDITY_CENTIPCT: u16 = 4500;
+const MOCK_MCU_CENTIDEG: u16 = 3000;
+const MOCK_PIEZO_LEFT: [u16; 2] = [10, 12];
+const MOCK_PIEZO_RIGHT: [u16; 2] = [20, 22];
+
+/// Spawns a background task simulating a Sensor MCU already running in firmware mode (the common
+/// real-world case: "happens if program was recently running", per upstream's own comment).
+/// Answers Ping with a firmware Pong, GetHardwareInfo/GetFirmwareHash with fixed fixtures, and
+/// unconditionally pushes one unsolicited Capacitance + one Temperature + one Piezo frame shortly
+/// after connecting (mirrors real firmware pushing telemetry on its own schedule), so `--passive`
+/// dry-run (which sends nothing) still has something to observe. Runs until the client side closes.
+pub fn spawn_mock_sensor_device_firmware(device_side: DuplexStream) -> tokio::task::JoinHandle<Vec<u8>> {
+    spawn_mock_sensor_device(device_side, true)
+}
+
+/// Same, but starts in bootloader mode: Ping gets a bootloader Pong until `JumpToFirmware` is
+/// received, at which point it acks with `JumpingToFirmware` and switches to firmware mode for all
+/// subsequent Pings (and starts pushing unsolicited telemetry, same as the firmware-only mock).
+/// Only exercised by `sensor_probe.rs`'s discover-mode tests today (`--dry-run` itself always uses
+/// [`spawn_mock_sensor_device_firmware`] -- see that function's doc comment), kept public for any
+/// future test that wants the full bootloader -> jump -> firmware sequence.
+#[allow(dead_code)]
+pub fn spawn_mock_sensor_device_bootloader(device_side: DuplexStream) -> tokio::task::JoinHandle<Vec<u8>> {
+    spawn_mock_sensor_device(device_side, false)
+}
+
+/// Spawns a background task that never responds to anything -- models a genuinely silent Sensor
+/// MCU (both baud rates unanswered).
+pub fn spawn_mock_sensor_device_silent(mut device_side: DuplexStream) -> tokio::task::JoinHandle<Vec<u8>> {
+    tokio::spawn(async move {
+        let mut read_buf = [0u8; 256];
+        loop {
+            match device_side.read(&mut read_buf).await {
+                Ok(0) | Err(_) => break,
+                Ok(_) => {} // received bytes, never reply
+            }
+        }
+        Vec::new()
+    })
+}
+
+fn spawn_mock_sensor_device(mut device_side: DuplexStream, start_in_firmware: bool) -> tokio::task::JoinHandle<Vec<u8>> {
+    tokio::spawn(async move {
+        let mut acc = BytesMut::new();
+        let mut read_buf = [0u8; 256];
+        let mut in_firmware = start_in_firmware;
+        let mut seen_opcodes = Vec::new();
+        let mut pushed_telemetry = false;
+
+        loop {
+            if !pushed_telemetry && in_firmware {
+                pushed_telemetry = true;
+                let _ = device_side.write_all(&mock_capacitance_frame(1, MOCK_CAPACITANCE)).await;
+                let _ = device_side
+                    .write_all(&mock_temperature_frame(MOCK_BED_TEMP, MOCK_AMBIENT_CENTIDEG, MOCK_HUMIDITY_CENTIPCT, MOCK_MCU_CENTIDEG))
+                    .await;
+                let _ = device_side
+                    .write_all(&mock_piezo_frame(1000, 1, (400, 400), &MOCK_PIEZO_LEFT, &MOCK_PIEZO_RIGHT))
+                    .await;
+            }
+
+            if acc.len() >= 2 {
+                let len = acc[1] as usize;
+                let total = 1 + 1 + len + 2;
+                if acc.len() >= total {
+                    let opcode = acc[2];
+                    seen_opcodes.push(opcode);
+                    acc.advance(total);
+                    match opcode {
+                        0x01 => {
+                            let _ = device_side.write_all(&mock_pong_frame(in_firmware)).await;
+                        }
+                        0x10 => {
+                            let _ = device_side.write_all(&mock_jumping_to_firmware_frame()).await;
+                            in_firmware = true;
+                        }
+                        0x02 => {
+                            let _ = device_side.write_all(&mock_hardware_info_frame()).await;
+                        }
+                        0x04 => {
+                            let _ = device_side.write_all(&mock_get_firmware_frame()).await;
+                        }
+                        _ => {}
+                    }
+                    continue;
+                }
+            }
+
+            let read = tokio::time::timeout(Duration::from_millis(50), device_side.read(&mut read_buf)).await;
+            match read {
+                Ok(Ok(0)) | Ok(Err(_)) => break,
+                Ok(Ok(n)) => acc.extend_from_slice(&read_buf[..n]),
+                Err(_elapsed) => {} // no bytes within this tick; loop back to (maybe) push telemetry
+            }
+        }
+        seen_opcodes
+    })
+}
