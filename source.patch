diff --git a/src/bin/opensleep-diagnostic/safe_stop.rs b/src/bin/opensleep-diagnostic/safe_stop.rs
new file mode 100644
index 0000000..ee0673a
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/safe_stop.rs
@@ -0,0 +1,205 @@
+//! The one shared safe-stop routine. Called before every active test, on normal completion, on
+//! Ctrl+C/SIGTERM/timeout/communication error/telemetry error/internal task failure, and (via a
+//! `catch_unwind` boundary around the risky polling loop -- see `cool_test.rs`) after a panic.
+//!
+//! Sequence (fixed, not configurable): disable LEFT, disable RIGHT, repeat both three times with
+//! short delays, flush the UART, then assert `0x20` subsystem reset (`reg 0x02 <- 0xFF`) and
+//! leave it asserted. A run is never reported as an overall PASS unless this completes with the
+//! I2C reset confirmed.
+
+use std::time::Duration;
+
+use opensleep::common::packet::BedSide;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::time::sleep;
+
+use crate::i2c::{I2cPort, assert_reset};
+use crate::link::FrozenLink;
+use crate::safety::{AuditedTransport, FrozenAction};
+
+const REPEAT_COUNT: usize = 3;
+const BETWEEN_ATTEMPTS_DELAY: Duration = Duration::from_millis(150);
+const DISABLE_WAIT: Duration = Duration::from_millis(500);
+
+#[derive(Debug, Clone, Default)]
+pub struct SafeStopResult {
+    pub left_disable_attempts: Vec<bool>,
+    pub right_disable_attempts: Vec<bool>,
+    pub uart_flushed: bool,
+    pub i2c_reset_asserted: bool,
+    pub uart_link_present: bool,
+}
+
+impl SafeStopResult {
+    pub fn uart_ok(&self) -> bool {
+        !self.uart_link_present
+            || (self.left_disable_attempts.iter().any(|&ok| ok)
+                && self.right_disable_attempts.iter().any(|&ok| ok))
+    }
+
+    /// A run may only be reported PASS if this is true.
+    pub fn fully_succeeded(&self) -> bool {
+        self.i2c_reset_asserted && self.uart_ok()
+    }
+
+    /// Degraded: UART disable failed but the I2C reset (the hard backstop) still succeeded.
+    pub fn degraded(&self) -> bool {
+        self.i2c_reset_asserted && !self.uart_ok()
+    }
+
+    /// Worst case: even the I2C reset failed. The caller must print the power-disconnect
+    /// instruction in this case.
+    pub fn catastrophic(&self) -> bool {
+        !self.i2c_reset_asserted
+    }
+}
+
+/// Runs the fixed safe-stop sequence. `link`/`i2c` are `None` when that transport was never
+/// successfully opened; the routine still does everything it can with what is available and
+/// reports exactly what happened.
+pub async fn run_safe_stop<T, P>(
+    mut link: Option<&mut FrozenLink<T>>,
+    audit: &mut AuditedTransport,
+    mut i2c: Option<&mut P>,
+) -> SafeStopResult
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let mut result = SafeStopResult {
+        uart_link_present: link.is_some(),
+        ..Default::default()
+    };
+
+    if let Some(link) = link.as_deref_mut() {
+        for attempt in 0..REPEAT_COUNT {
+            log::info!("safe-stop: disable attempt {}/{REPEAT_COUNT}", attempt + 1);
+            let left_ok = try_disable(link, audit, BedSide::Left).await;
+            let right_ok = try_disable(link, audit, BedSide::Right).await;
+            result.left_disable_attempts.push(left_ok);
+            result.right_disable_attempts.push(right_ok);
+            if attempt + 1 < REPEAT_COUNT {
+                sleep(BETWEEN_ATTEMPTS_DELAY).await;
+            }
+        }
+
+        match link.flush().await {
+            Ok(()) => {
+                result.uart_flushed = true;
+                log::info!("safe-stop: UART flushed");
+            }
+            Err(e) => log::error!("safe-stop: UART flush failed: {e}"),
+        }
+    } else {
+        log::warn!("safe-stop: no Frozen UART link was open; skipping disable commands");
+    }
+
+    if let Some(dev) = i2c.as_deref_mut() {
+        let step = assert_reset(dev).await;
+        result.i2c_reset_asserted = step.success;
+        if step.success {
+            log::warn!("safe-stop: subsystem reset asserted (0x20 reg 0x02 <- 0xFF); left asserted");
+        } else {
+            log::error!("safe-stop: FAILED to assert subsystem reset: errno {:?}", step.os_error);
+        }
+    } else {
+        log::error!("safe-stop: no I2C device was open; could not assert subsystem reset");
+    }
+
+    if result.catastrophic() {
+        log::error!("================================================================");
+        log::error!(" SAFE-STOP COULD NOT CONFIRM THE SUBSYSTEM RESET.");
+        log::error!(" DISCONNECT HUB POWER IMMEDIATELY.");
+        log::error!("================================================================");
+    } else if result.degraded() {
+        log::warn!("safe-stop: degraded shutdown -- UART disable did not confirm, but I2C reset succeeded");
+    }
+
+    result
+}
+
+async fn try_disable<T>(link: &mut FrozenLink<T>, audit: &mut AuditedTransport, side: BedSide) -> bool
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    match link.send(audit, FrozenAction::safety_off(side), DISABLE_WAIT).await {
+        Ok(_) => true,
+        Err(e) => {
+            log::error!("safe-stop: failed to send disable for {side:?}: {e}");
+            false
+        }
+    }
+}
+
