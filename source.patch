+    // ---- item 10: readback mismatch aborts before any Sensor UART writes ----
+
+    struct StaleReg02Readback {
+        inner: MockI2c,
+    }
+    impl I2cPort for StaleReg02Readback {
+        fn read_byte(&mut self, addr: u8) -> Result<u8, crate::i2c::I2cIoError> {
+            self.inner.read_byte(addr)
+        }
+        fn read_reg(&mut self, addr: u8, reg: u8) -> Result<u8, crate::i2c::I2cIoError> {
+            if addr == crate::i2c::RESET_EXPANDER_ADDR && reg == 0x02 && !self.inner.writes.is_empty() {
+                return Ok(0x00); // never reflects the write -> permanent readback mismatch
+            }
+            self.inner.read_reg(addr, reg)
+        }
+        fn write_reg(&mut self, addr: u8, reg: u8, value: u8) -> Result<(), crate::i2c::I2cIoError> {
+            self.inner.write_reg(addr, reg, value)
+        }
+    }
