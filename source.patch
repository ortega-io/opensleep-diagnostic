+    fn pong_frame(in_firmware: bool) -> Vec<u8> {
+        let code: u8 = if in_firmware { 0b0100_0110 } else { 0b0100_0010 };
+        opensleep::common::codec::command(vec![0x81, 0x00, code])
+    }
+
+    /// Reads whole frames off `device_side` and replies per `script`, keyed by opcode. Any
+    /// opcode not in `script` is recorded but gets no reply (matching real hardware silently
+    /// ignoring or not implementing an unknown command).
+    async fn run_fake_device(
+        mut device_side: DuplexStream,
+        script: std::collections::HashMap<u8, Vec<u8>>,
+        seen_tx: mpsc::UnboundedSender<u8>,
+    ) {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let mut acc = BytesMut::new();
+        let mut read_buf = [0u8; 256];
+        loop {
+            if acc.len() >= 2 {
+                let len = acc[1] as usize;
+                let total = 1 + 1 + len + 2;
+                if acc.len() >= total {
+                    let opcode = acc[2];
+                    acc.advance(total);
+                    let _ = seen_tx.send(opcode);
+                    if let Some(response) = script.get(&opcode)
+                        && device_side.write_all(response).await.is_err()
+                    {
+                        return;
+                    }
+                    continue;
+                }
+            }
+            let n = match device_side.read(&mut read_buf).await {
+                Ok(0) | Err(_) => return,
+                Ok(n) => n,
+            };
+            acc.extend_from_slice(&read_buf[..n]);
+        }
+    }
