+/// `frozen-hold-start`/`frozen-hold-stop`/`frozen-hold-status`'s own result block. `action`
+/// distinguishes which of the three produced it. Populated fields vary by action: `start` fills
+/// the requested/confirmed-target and rollback fields; `stop` fills the disable-confirmation
+/// fields; `status` fills the read-only telemetry fields. Fields not applicable to the action that
+/// ran are left at their default (`None`/`false`).
+#[derive(Debug, Clone, Serialize, Default)]
+pub struct HoldResults {
+    pub action: String,
+    pub requested_left_target_c: Option<f64>,
+    pub requested_right_target_c: Option<f64>,
+    /// `true` iff `TargetUpdate(Left, enabled=true, temp=<requested>)` was received -- exact
+    /// match, not merely "some reply arrived". `start` only.
+    pub left_target_confirmed: bool,
+    pub right_target_confirmed: bool,
+    /// `true` iff this run pulsed Frozen's reset bit via the narrow startup mechanism because the
+    /// initial no-reset Ping probe found Frozen unresponsive. `false` whenever a responsive
+    /// Frozen was left untouched -- see `frozen_hold.rs` module docs. `start` only.
+    pub reset_performed: bool,
+    /// `true` iff a partial-transaction rollback (disabling an already-confirmed side after the
+    /// other side failed to confirm) occurred. `start` only.
+    pub rolled_back: bool,
+    /// `true` iff `TargetUpdate(<side>, enabled=false)` was received for that side. `stop` only.
+    pub left_disabled_confirmed: bool,
+    pub right_disabled_confirmed: bool,
+    /// `true` iff Frozen answered Ping at all (bootloader or firmware). `stop`/`status`.
+    pub frozen_responsive: bool,
+    /// Read-only telemetry, from `GetTemperatures`/an unsolicited `TemperatureUpdate`. `status`
+    /// only.
+    pub left_water_c: Option<f64>,
+    pub right_water_c: Option<f64>,
+    pub heatsink_c: Option<f64>,
+}
