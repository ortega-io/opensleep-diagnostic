new file mode 100644
index 0000000..910d8c6
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/ownership.rs
@@ -0,0 +1,121 @@
+//! Best-effort checks that stock OpenSleep-family services aren't running and that no other
+//! process already holds `/dev/i2c-1` or the Frozen UART open. Both checks are advisory when
+//! inconclusive (e.g. `systemctl` isn't present on a development machine) but refuse to proceed
+//! on a *positive* detection, since testing hardware that a live stock service is simultaneously
+//! driving is unsafe and the results would be meaningless anyway.
+
+use std::path::Path;
+use std::process::Command;
+
+const STOCK_SERVICES: &[&str] = &[
+    "capybara.service",
+    "dac.service",
+    "frank.service",
+    "frankenfirmware.service",
+    "opensleep.service",
+    // Added for frozen-prime-test; harmless to also check from frozen-passive/frozen-cool-test,
+    // since `systemctl is-active` on a unit that doesn't exist on this Hub just reports inactive.
+    "opensleep-manual-ui.service",
+];
+
+#[derive(Debug, Clone)]
+pub struct ServiceCheck {
+    pub name: String,
+    pub active: bool,
+}
+
+/// Runs `systemctl is-active <name>` for each known stock unit. Returns an empty vec (not an
+/// error) when `systemctl` itself isn't available, e.g. on a development machine -- that case is
+/// logged and treated as inconclusive, not as a refusal.
+pub fn check_stock_services() -> Vec<ServiceCheck> {
+    if which_systemctl().is_none() {
+        log::info!("systemctl not found on this host; skipping stock-service check (expected on a dev machine)");
+        return Vec::new();
+    }
+
+    STOCK_SERVICES
+        .iter()
+        .map(|name| {
+            let active = Command::new("systemctl")
+                .args(["is-active", "--quiet", name])
+                .status()
+                .map(|s| s.success())
+                .unwrap_or(false);
+            ServiceCheck {
+                name: name.to_string(),
+                active,
+            }
+        })
+        .collect()
+}
+
+fn which_systemctl() -> Option<()> {
+    Command::new("systemctl")
+        .arg("--version")
+        .output()
+        .ok()
+        .filter(|o| o.status.success())
+        .map(|_| ())
+}
+
+/// Best-effort scan of `/proc/*/fd/*` for a symlink resolving to `path`, i.e. "fuser"-lite.
+/// Returns `Ok(true)` only on a positive match; permission-denied entries for other users' `/proc`
+/// directories are silently skipped (not treated as a match) since this diagnostic does not run
+/// as every uid.
+pub fn device_is_open_elsewhere(path: &str) -> bool {
+    let target = match std::fs::canonicalize(path) {
+        Ok(p) => p,
+        Err(_) => return false, // device doesn't exist yet; nothing can have it open
+    };
+
+    let proc_dir = match std::fs::read_dir("/proc") {
+        Ok(d) => d,
+        Err(_) => return false, // not on Linux /proc, e.g. some dev machines: inconclusive
+    };
+
+    for entry in proc_dir.flatten() {
+        let pid_path = entry.path();
+        let Some(pid) = pid_path.file_name().and_then(|n| n.to_str()) else {
+            continue;
+        };
+        if pid.parse::<u32>().is_err() {
+            continue;
+        }
+        let fd_dir = pid_path.join("fd");
+        let Ok(fds) = std::fs::read_dir(&fd_dir) else {
+            continue;
+        };
+        for fd in fds.flatten() {
+            if let Ok(resolved) = std::fs::read_link(fd.path())
+                && resolved == target
+            {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+pub fn device_exists(path: &str) -> bool {
+    Path::new(path).exists()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nonexistent_device_is_not_reported_as_open_elsewhere() {
+        assert!(!device_is_open_elsewhere("/dev/does-not-exist-opensleep-diagnostic"));
+    }
+
+    #[test]
+    fn our_own_open_file_is_detected_as_open() {
+        let path = std::env::temp_dir().join("opensleep-diagnostic-ownership-test");
+        let _f = std::fs::File::create(&path).unwrap();
+        let held = _f;
+        assert!(device_is_open_elsewhere(path.to_str().unwrap()));
+        drop(held);
+        let _ = std::fs::remove_file(&path);
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/passive.rs b/src/bin/opensleep-diagnostic/passive.rs
new file mode 100644
index 0000000..f4b95f7
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/passive.rs
@@ -0,0 +1,442 @@
+//! `frozen-passive`: safe with the cover disconnected and no water. Never constructs an enabled
+//! `SetTargetTemperature`; the only actuator-shaped command it can ever send is the disabled
+//! (`enabled=false`) safety-off, which both `AuditedTransport` and the closed `FrozenAction` enum
+//! make the sole reachable option in `Mode::Passive`. See SAFETY.md and PROTOCOL_AUDIT.md.
+
+use std::time::Duration;
+
+use opensleep::common::packet::BedSide;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::time::Instant;
+
+use crate::buildinfo::{DIAGNOSTIC_VERSION, kernel_release, source_commit};
+use crate::cli::PassiveArgs;
+use crate::i2c::{I2cPort, MockI2c, RealI2c, probe_address, run_reset_sequence};
+use crate::link::{FrozenLink, PacketOutcome};
+use crate::mock::mock_frozen_link_pair;
+use crate::ownership;
+use crate::report::{AuditEntryJson, Confirmations, Report, TemperatureSampleJson};
+use crate::safe_stop::run_safe_stop;
+use crate::safety::{AuditedTransport, FrozenAction, Mode};
+use crate::signals::StopReason;
+use crate::telemetry::{PacketStats, sample_from_get_temperature, sample_from_temperature_update};
+
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(3);
+
+pub async fn run(args: &PassiveArgs) -> (Report, u8) {
+    if args.dry_run {
+        log::warn!("--dry-run: no I2C or UART writes will be performed; using a mocked Frozen device");
+        let mock_i2c = MockI2c::always_succeed();
+        let (client, device_task) = mock_frozen_link_pair();
+        let link = crate::link::FrozenLink::wrap(client, "dry-run");
+        let result = run_core(args, mock_i2c, Some(link), true).await;
+        device_task.abort();
+        return result;
+    }
+
+    // Step 1: refuse if a known stock service is running or another process already holds the
+    // device open.
+    if let Some(early) = refuse_if_owned(args) {
+        return early;
+    }
+
+    let mut i2c = match RealI2c::open(&args.i2c_device) {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("failed to open I2C device {}: {e}", args.i2c_device);
+            return (
+                base_report(args, false, "I2C bus failed to open", None),
+                20,
+            );
+        }
+    };
+
+    let (bus_open, expander_probe, expander_value, led_ok, reset_ok) =
+        run_i2c_preflight(args, &mut i2c).await;
+    let _ = (bus_open, expander_probe, expander_value, led_ok, reset_ok);
+
+    let link = match FrozenLink::<tokio_serial::SerialStream>::open(&args.frozen_port) {
+        Ok(l) => Some(l),
+        Err(e) => {
+            log::error!("failed to open Frozen UART {}: {e}", args.frozen_port);
+            None
+        }
+    };
+
+    run_core(args, i2c, link, false).await
+}
+
+fn refuse_if_owned(args: &PassiveArgs) -> Option<(Report, u8)> {
+    let services = ownership::check_stock_services();
+    let active: Vec<_> = services.iter().filter(|s| s.active).map(|s| s.name.clone()).collect();
+    if !active.is_empty() {
+        log::error!("refusing to run: stock service(s) active: {active:?}");
+        return Some((
+            base_report(args, false, "stock service(s) active; refusing to run", None),
+            40,
+        ));
+    }
+    if ownership::device_exists(&args.i2c_device) && ownership::device_is_open_elsewhere(&args.i2c_device) {
+        log::error!("refusing to run: {} appears to be open in another process", args.i2c_device);
+        return Some((
+            base_report(args, false, "I2C device already open elsewhere", None),
+            40,
+        ));
+    }
+    if ownership::device_exists(&args.frozen_port) && ownership::device_is_open_elsewhere(&args.frozen_port) {
+        log::error!("refusing to run: {} appears to be open in another process", args.frozen_port);
+        return Some((
+            base_report(args, false, "Frozen UART already open elsewhere", None),
+            40,
+        ));
+    }
+    None
+}
+
+async fn run_i2c_preflight<P: I2cPort>(args: &PassiveArgs, dev: &mut P) -> (bool, bool, Option<u8>, bool, bool) {
+    let _ = args;
+    let expander = probe_address(dev, crate::i2c::RESET_EXPANDER_ADDR);
+    log::info!("{}", expander.describe());
+
+    let led = probe_address(dev, crate::i2c::LED_CONTROLLER_ADDR);
+    if led.success {
+        log::info!("{}", led.describe());
+    } else {
+        log::info!("LED controller unavailable; continuing diagnostic ({})", led.describe());
+    }
+
+    (true, expander.success, expander.value, led.success, false)
+}
+
+async fn run_core<T, P>(
+    args: &PassiveArgs,
+    mut i2c: P,
+    mut link: Option<FrozenLink<T>>,
+    dry_run: bool,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let expander = probe_address(&mut i2c, crate::i2c::RESET_EXPANDER_ADDR);
+    let led = probe_address(&mut i2c, crate::i2c::LED_CONTROLLER_ADDR);
+    if !led.success {
+        log::info!("LED controller unavailable; continuing diagnostic ({})", led.describe());
+    }
+
+    let subsystem_reset_ok = if args.reset_subsystems {
+        let (steps, _release) = run_reset_sequence(&mut i2c).await;
+        steps.iter().all(|s| s.success)
+    } else {
+        log::info!("Subsystem reset not requested (pass --reset-subsystems to opt in)");
+        true
+    };
+
+    let mut audit = AuditedTransport::new(Mode::Passive);
+    let mut stats = PacketStats::default();
+    let mut samples: Vec<TemperatureSampleJson> = Vec::new();
+
+    let mut bootloader_ping = None;
+    let mut firmware_ping = None;
+    let mut detected_initial_mode = None;
+    let mut firmware_jump_sent = false;
+    let mut hardware_info_str = None;
+    let mut reached_firmware = false;
+    let mut safety_off_sent = 0u32;
+    let mut firmware_probed = false;
+
+    if let Some(link) = link.as_mut() {
+        let (ok, mode) = crate::frozen_ops::ping(link, &mut audit, COMMAND_TIMEOUT).await;
+        detected_initial_mode = Some(match mode {
+            crate::frozen_ops::DeviceMode::Bootloader => "bootloader",
+            crate::frozen_ops::DeviceMode::Firmware => "firmware",
+            crate::frozen_ops::DeviceMode::Unknown => "unknown",
+        });
+        match mode {
+            crate::frozen_ops::DeviceMode::Bootloader => bootloader_ping = Some(ok),
+            crate::frozen_ops::DeviceMode::Firmware => firmware_ping = Some(ok),
+            crate::frozen_ops::DeviceMode::Unknown => {}
+        }
+
+        if ok {
+            if let Some(hw) = crate::frozen_ops::get_hardware_info(link, &mut audit, COMMAND_TIMEOUT).await {
+                hardware_info_str = Some(hw.to_string());
+            }
+        }
+
+        if mode == crate::frozen_ops::DeviceMode::Firmware {
+            reached_firmware = true;
+        } else if mode == crate::frozen_ops::DeviceMode::Bootloader {
+            if args.allow_firmware_jump {
+                firmware_jump_sent = true;
+                let ok = crate::frozen_ops::jump_to_firmware_and_wait(link, &mut audit, COMMAND_TIMEOUT).await;
+                firmware_ping = Some(ok);
+                reached_firmware = ok;
+            } else {
+                log::info!("Frozen is in its bootloader; not jumping (pass --allow-firmware-jump to opt in)");
+            }
+        }
+
+        // Optional, passive, best-effort: GetFirmware (0x04). Only sent once application
+        // firmware has already answered, and its outcome never affects `reached_firmware`. Note
+        // for the report: the reused `FrozenPacket::GetFirmware` response (opcode 0x84) carries
+        // no version/hash payload in this source revision -- it is an acknowledgement only -- so
+        // `firmware_version_or_hash` stays `None` even on success rather than inventing content.
+        if reached_firmware {
+            match link.send(&mut audit, FrozenAction::get_firmware(), COMMAND_TIMEOUT).await {
+                Ok(crate::link::PacketOutcome::Received(_)) => firmware_probed = true,
+                Ok(_) => log::debug!("Frozen did not respond to GetFirmware within {COMMAND_TIMEOUT:?}"),
+                Err(e) => log::debug!("Frozen GetFirmware failed (non-fatal): {e}"),
+            }
+        }
+
+        // Step 12: immediately send a safety-off target to both sides, regardless of mode
+        // outcome, using the exact "disabled" value stock OpenSleep itself sends (see
+        // safety::DISABLE_TARGET_CENTIDEG).
+        for side in [BedSide::Left, BedSide::Right] {
+            match link.send(&mut audit, FrozenAction::safety_off(side), COMMAND_TIMEOUT).await {
+                Ok(_) => safety_off_sent += 1,
+                Err(e) => log::error!("safety-off for {side:?} failed: {e}"),
+            }
+        }
+
+        if reached_firmware {
+            let start = Instant::now();
+            let duration = Duration::from_secs(args.duration_seconds.max(1));
+            let mut tick = 0u64;
+            while start.elapsed() < duration {
+                let elapsed_ms = start.elapsed().as_millis() as u64;
+                poll_tick(link, &mut audit, elapsed_ms, &mut stats, &mut samples).await;
+                tick += 1;
+                let next_tick_at = start + Duration::from_secs(tick);
+                let now = Instant::now();
+                if next_tick_at > now {
+                    tokio::time::sleep(next_tick_at - now).await;
+                }
+            }
+        }
+    }
+
+    let ss_i2c = &mut i2c;
+    let safe_stop = run_safe_stop(link.as_mut(), &mut audit, Some(ss_i2c)).await;
+
+    let telemetry_valid = !samples.is_empty();
+    let overall_pass = reached_firmware && telemetry_valid && safe_stop.fully_succeeded();
+
+    let mut report = base_report(
+        args,
+        dry_run,
+        if overall_pass { "completed normally" } else { "completed" },
+        None,
+    );
+    report.i2c_bus_open = true;
+    report.reset_expander_probe_ok = expander.success;
+    report.reset_expander_value = expander.value;
+    report.led_controller_probe_ok = led.success;
+    report.subsystem_reset_performed = args.reset_subsystems;
+    report.subsystem_reset_ok = subsystem_reset_ok;
+    report.frozen_uart_opened = link.is_some();
+    report.frozen_bootloader_ping = bootloader_ping;
+    report.frozen_firmware_ping = firmware_ping;
+    report.frozen_hardware_info = hardware_info_str;
+    report.detected_initial_mode = detected_initial_mode.map(str::to_string);
+    report.firmware_jump_sent = firmware_jump_sent;
+    report.frozen_firmware_probed = firmware_probed;
+    report.mode = audit.mode().label().to_string();
+    report.outgoing_commands = audit.entries().iter().map(AuditEntryJson::from).collect();
+    report.enabled_target_command_count = audit.enabled_target_count();
+    report.prime_command_count = audit.prime_count();
+    report.random_command_count = audit.random_count();
+    report.safety_off_commands_sent = safety_off_sent;
+    report.telemetry_samples = samples;
+    report.raw_packets_decoded = stats.raw_packets_decoded;
+    report.malformed_windows = stats.malformed_windows;
+    report.communication_timeouts = stats.timeouts;
+    report.unsolicited_telemetry_seen = stats.unsolicited_telemetry_seen;
+    report.firmware_messages = stats.messages;
+    report.stop_reason = StopReason::Normal.to_string();
+    report.safe_stop = Some((&safe_stop).into());
+    report.overall_pass = overall_pass;
+    report.exit_code = if overall_pass {
+        0
+    } else if detected_initial_mode.as_deref() == Some("bootloader") {
+        10
+    } else if report.frozen_uart_opened {
+        11
+    } else {
+        11
+    };
+
+    if let Some(path) = &args.json_output
+        && let Err(e) = report.write_json(path)
+    {
+        log::error!("failed to write JSON output to {path}: {e}");
+    }
+    if let Some(path) = &args.csv_output
+        && let Err(e) = report.write_csv(path)
+    {
+        log::error!("failed to write CSV output to {path}: {e}");
+    }
+    report.print_table();
+
+    let code = report.exit_code;
+    (report, code)
+}
+
+async fn poll_tick<T>(
+    link: &mut FrozenLink<T>,
+    audit: &mut AuditedTransport,
+    elapsed_ms: u64,
+    stats: &mut PacketStats,
+    samples: &mut Vec<TemperatureSampleJson>,
+) where
+    T: AsyncRead + AsyncWrite + Unpin,
+{
+    match link.send(audit, FrozenAction::get_temperatures(), COMMAND_TIMEOUT).await {
+        Ok(PacketOutcome::Received(pkt)) => {
+            stats.record(&pkt);
+            store_sample(pkt, elapsed_ms, samples);
+        }
+        Ok(PacketOutcome::TimedOut) => stats.record_timeout(),
+        Ok(PacketOutcome::Closed) => {}
+        Err(e) => log::error!("GetTemperatures failed: {e}"),
+    }
+
+    // Drain any additional packets already buffered (e.g. unsolicited pushes) without sending.
+    loop {
+        match link.recv(Duration::from_millis(50)).await {
+            Ok(PacketOutcome::Received(pkt)) => {
+                stats.record(&pkt);
+                store_sample(pkt, elapsed_ms, samples);
+            }
+            _ => break,
+        }
+    }
+}
+
+fn store_sample(pkt: opensleep::frozen::FrozenPacket, elapsed_ms: u64, samples: &mut Vec<TemperatureSampleJson>) {
+    use opensleep::frozen::FrozenPacket;
+    let ts = jiff::Timestamp::now().to_string();
+    match pkt {
+        FrozenPacket::GetTemperature(g) => {
+            samples.push((&sample_from_get_temperature(elapsed_ms, ts, &g)).into());
+        }
+        FrozenPacket::TemperatureUpdate(u) => {
+            samples.push((&sample_from_temperature_update(elapsed_ms, ts, &u)).into());
+        }
+        FrozenPacket::Message(m) => log::info!("Frozen firmware message: {m}"),
+        other => log::debug!("Frozen packet: {other:?}"),
+    }
+}
+
+fn base_report(args: &PassiveArgs, dry_run: bool, stop_reason: &str, exit_code_override: Option<u8>) -> Report {
+    Report {
+        program_version: DIAGNOSTIC_VERSION.to_string(),
+        opensleep_base_version: opensleep::VERSION.to_string(),
+        opensleep_source_commit: source_commit().to_string(),
+        kernel: kernel_release(),
+        arch: std::env::consts::ARCH.to_string(),
+        mode: "frozen-passive".to_string(),
+        dry_run,
+        confirmations: Confirmations::default(),
+        i2c_device: args.i2c_device.clone(),
+        i2c_bus_open: false,
+        reset_expander_probe_ok: false,
+        reset_expander_value: None,
+        led_controller_probe_ok: false,
+        subsystem_reset_performed: args.reset_subsystems,
+        subsystem_reset_ok: false,
+        frozen_port: args.frozen_port.clone(),
+        frozen_uart_opened: false,
+        frozen_bootloader_ping: None,
+        frozen_firmware_ping: None,
+        frozen_hardware_info: None,
+        firmware_version_or_hash: None,
+        frozen_firmware_probed: false,
+        detected_initial_mode: None,
+        firmware_jump_sent: false,
+        outgoing_commands: Vec::new(),
+        enabled_target_command_count: 0,
+        prime_command_count: 0,
+        random_command_count: 0,
+        safety_off_commands_sent: 0,
+        rejected_command_count: 0,
+        prime_frame_hex: None,
+        telemetry_samples: Vec::new(),
+        raw_packets_decoded: 0,
+        malformed_windows: 0,
+        communication_timeouts: 0,
+        unsolicited_telemetry_seen: false,
+        firmware_messages: Vec::new(),
+        pump_samples: Vec::new(),
+        solenoid_valve_messages: Vec::new(),
+        reservoir_transition_messages: Vec::new(),
+        other_decoded_packets: Vec::new(),
+        raw_io_events: Vec::new(),
+        priming_start_observed: false,
+        priming_done_observed: false,
+        priming_done_because_empty: false,
+        operator_observations: None,
+        prime_operator_observations: None,
+        stop_reason: stop_reason.to_string(),
+        safe_stop: None,
+        component_results: None,
+        prime_results: None,
+        opensleep_init_results: None,
+        release_frozen_only_results: None,
+        overall_pass: false,
+        exit_code: exit_code_override.unwrap_or(30),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::cli::PassiveArgs;
+
+    fn args(dry_run: bool) -> PassiveArgs {
+        PassiveArgs {
+            i2c_device: "/dev/i2c-1".into(),
+            frozen_port: "/dev/ttyS1".into(),
+            reset_subsystems: false,
+            allow_firmware_jump: true,
+            duration_seconds: 1,
+            json_output: None,
+            csv_output: None,
+            verbose: false,
+            dry_run,
+        }
+    }
+
+    #[tokio::test]
+    async fn dry_run_never_touches_real_devices_and_reaches_firmware() {
+        let (report, code) = run(&args(true)).await;
+        assert!(report.dry_run);
+        assert_eq!(report.frozen_firmware_ping, Some(true));
+        assert!(report.overall_pass);
+        assert_eq!(code, 0);
+        assert_eq!(report.enabled_target_command_count, 0);
+        assert_eq!(report.prime_command_count, 0);
+        assert_eq!(report.random_command_count, 0);
+    }
+
+    #[tokio::test]
+    async fn passive_never_sends_an_enabled_target_command() {
+        let (report, _) = run(&args(true)).await;
+        assert!(report.outgoing_commands.iter().all(|c| c.enabled != Some(true)));
+    }
+
+    #[tokio::test]
+    async fn passive_sends_safety_off_for_both_sides() {
+        let (report, _) = run(&args(true)).await;
+        assert_eq!(report.safety_off_commands_sent, 2);
+        let sides: Vec<_> = report
+            .outgoing_commands
+            .iter()
+            .filter(|c| c.enabled == Some(false))
+            .filter_map(|c| c.side.clone())
+            .collect();
+        assert!(sides.contains(&"left".to_string()));
+        assert!(sides.contains(&"right".to_string()));
+    }
+}
diff --git a/src/bin/opensleep-diagnostic/prime_opensleep_init.rs b/src/bin/opensleep-diagnostic/prime_opensleep_init.rs
new file mode 100644
index 0000000..ac53a77
--- /dev/null
+++ b/src/bin/opensleep-diagnostic/prime_opensleep_init.rs
@@ -0,0 +1,1460 @@
+//! `frozen-prime-opensleep-init`: fills an empty or partially-filled hydraulic loop by sending
+//! `Prime` exactly once, through the real, unmodified upstream OpenSleep initialization and Frozen
+//! manager code -- `opensleep::reset::ResetController::reset_subsystems`, `opensleep::led`,
+//! `opensleep::mqtt::MqttManager`, `opensleep::frozen::run` -- rather than `frozen-prime-test`'s
+//! own reimplemented reset sequence and command transport. The Sensor subsystem is deliberately
+//! never started at all -- see "MQTT is optional; Sensor is disabled entirely" below.
+//!
+//! ## Why this mode exists, and how it differs from `frozen-prime-test`
+//!
+//! `frozen-prime-test` (and this binary's other subcommands) reimplement a *minimal* version of
+//! OpenSleep's I2C reset sequence and Frozen UART transport, specifically so they can run without
+//! ever touching MQTT/the operator's saved configuration file/the Sensor subsystem/the normal
+//! command scheduler. That
+//! reimplementation is deliberately partial: it mirrors the real `ResetController::reset_subsystems`
+//! register-for-register, but it is still a *second, separate* implementation of that sequence, not
+//! the real one -- and real hardware evidence has shown that a partial/alternate initialization
+//! path can leave the reservoir-level (`capwater`) sensor in a different state than a full, real
+//! OpenSleep boot does. This mode exists to remove that gap entirely: it calls the exact same
+//! functions real `opensleep`'s own `main.rs` calls, in the same order, so there is no second
+//! implementation to drift from the first.
+//!
+//! ## What is, and is not, reused
+//!
+//! Reused unmodified: `ResetController::new`/`reset_subsystems` (the real I2C reset), the real
+//! `/home/dac/app/sewer/device-label` read, `IS31FL3194Controller` (LED; writes to the unavailable
+//! 0x53 controller are already non-fatal in the *upstream* `frozen::run` -- see `set_led` in
+//! `opensleep::frozen::manager` -- so nothing extra is needed for that here), `MqttManager::new`,
+//! and -- doing all of the real work -- `opensleep::frozen::run` (the actual Frozen manager task:
+//! the real Ping/GetHardwareInfo boot sequence, the real wake-retry logic, and the real command
+//! scheduler that this mode steers into sending exactly one `Prime` by constructing an in-memory
+//! `Config`, not by calling any command channel that doesn't exist in the upstream code -- see
+//! "Triggering Prime" below).
+//!
+//! Deliberately not reused: the real config-file loader (this mode never reads the operator's own
+//! saved configuration from disk; it constructs its own in-memory `Config` -- see below) and
+//! `MqttManager::wait_for_conn`/`MqttManager::run` (this mode constructs an `MqttManager` exactly
+//! as upstream does, so `frozen::run` gets a real, well-formed `AsyncClient`, but never polls its
+//! event loop -- see "MQTT and Sensor are optional" below). Nothing in this file reimplements
+//! reset, transport framing, or packet decoding: every one of those is a call into the real
+//! `opensleep` library.
+//!
+//! ## Triggering Prime without a command channel
+//!
+//! The pinned upstream source has no API to tell a running `frozen::run` task "send Prime now":
+//! `frozen::manager::get_next_command` decides *internally*, once per ~20ms tick, whether to send
+//! `Prime` based on the current `Config` (`cfg.prime`, a time-of-day) and a few seconds of internal
+//! debounce state. This mode drives that real scheduling logic by constructing a `Config` whose
+//! `prime` field is "now" (in a timezone chosen only for internal self-consistency -- see
+//! `build_config`) immediately before starting `frozen::run`. The real scheduler's own 60-second
+//! per-run debounce and the 30-second matching window around `prime` then make it fire at most
+//! once, exactly like it would for a real end user's scheduled priming time -- this mode adds no
+//! separate at-most-once enforcement of its own because the reused code already has one.
+//!
+//! `away_mode` is left `false` (setting it `true` would also block the Prime schedule -- see
+//! `frozen::manager::get_next_command`'s `!away_mode` guard), but the constructed `SidesConfig` has
+//! an empty temperature profile, which `frozen::profile::SideConfig::calc_target` already treats as
+//! "always disabled" regardless of time -- so temperature targets never get enabled, satisfying
+//! "keep profiles disabled" without needing `away_mode` to do it.
+//!
+//! ## Observing capwater/flowrate and priming-stage messages without a tap in upstream code
+//!
+//! `opensleep::frozen::state::FrozenState::handle_packet` logs every firmware `Message` it doesn't
+//! specifically interpret (which includes `"FW: [capwater] sensor unavailable"` and
+//! `"FW: [flowrate] sensor unavailable"`) at `debug` level, and every `"FW: [priming] ..."` stage
+//! message at `info` level -- but exposes none of that to callers directly (`FrozenState` only
+//! tracks a collapsed `is_priming: bool`, which cannot distinguish `"done"` from `"done because
+//! empty"`). Since this process is the one running that code, `log_tap` taps the same global
+//! logger every subcommand already uses to observe those exact log lines without modifying
+//! `frozen/state.rs` at all -- see that module's docs.
+//!
+//! ## The Frozen UART path is hardware-specific, and is passed explicitly -- never the upstream
+//! ## `PORT` constant
+//!
+//! `opensleep::frozen::PORT` (`"/dev/ttymxc2"`) is correct for the MT8365 devkit this fork's pinned
+//! upstream source was written against, but not for every Hub this diagnostic runs on: a real,
+//! live run on this Hub completed the real subsystem reset and then failed immediately with
+//! `Serial Io(NotFound): No such file or directory` the moment `frozen::run` tried to open that
+//! path. This Hub exposes Frozen at `/dev/ttyS1` (still 38400 baud -- `frozen::manager::BAUD` is
+//! unchanged and untouched) instead. `frozen::run`'s first parameter is a plain `port: &'static
+//! str`; this file passes `FROZEN_UART_PATH` (`"/dev/ttyS1"`) there directly and never references
+//! `opensleep::frozen::PORT` as an argument to anything that opens a port -- only, once, as the
+//! *comparison* value in the logged override message in `run_core`, which does not open it. This
+//! changes nothing about the manager's protocol, wake sequence, or state
+//! machine: `frozen::run`'s body is untouched, exactly as every other module doc in this file
+//! already claims -- only the device path handed to it differs. See `FROZEN_UART_PATH`'s own doc
+//! comment and the regression tests at the bottom of this file.
+//!
+//! ## MQTT is optional; Sensor is disabled entirely
+//!
+//! Real `opensleep::main` treats `MqttManager::wait_for_conn` failure as fatal (it returns before
+//! starting Frozen at all); that is not appropriate for a one-shot Prime operation, so this mode
+//! never calls `wait_for_conn` -- a missing/unreachable MQTT broker never blocks or fails startup.
+//! The constructed `AsyncClient` is still handed to `frozen::run` exactly as upstream does, it
+//! simply never has its event loop polled, so no network I/O is ever attempted.
+//!
+//! The Sensor subsystem is not started at all in this mode: it is a separate physical UART (the
+//! upstream default for it is also wrong for this Hub, which would need `/dev/ttyS2` if Sensor
+//! were ever retained here) with no bearing on Frozen priming or on
+//! `capwater`/`flowrate` reporting (those come from Frozen's own firmware messages -- see
+//! `frozen/state.rs`), so the surest way to guarantee it "must not prevent priming" is to never run
+//! it, rather than run it best-effort and have to keep proving its failures stay non-blocking.
+//!
+//! ## Shutdown
+//!
+//! On normal completion or `"done because empty"`, this mode does **not** assert the I2C subsystem
+//! reset -- Frozen's own firmware returns to idle after priming ends on its own, and forcing a
+//! reset immediately after using the real initialization path would be needlessly disruptive to a
+//! subsystem this mode is specifically trying to leave in its normal, running state. The process
+//! exits via the same mechanism real `main.rs` already uses for its top-level shutdown: a
+//! `tokio::select!` whose losing branches are dropped (cancelled) the moment one branch resolves --
+//! here, that's either the observation loop deciding it's done, or a termination signal. Ctrl+C
+//! just lets that same drop-based shutdown happen -- temperature targets are never enabled during
+//! this run in the first place (the constructed profile has no temperatures, which the real
+//! scheduler always treats as disabled), so there is nothing to actively disable at that point; no
+//! reset is asserted for a clean stop either. The one exception is a genuine
+//! firmware-reported pump fault observed during the active window, which does assert reset (via
+//! this diagnostic's own, already-audited `i2c::assert_reset` -- not upstream's reset sequence) as
+//! an emergency backstop.
+
+use std::time::Duration;
+
+use jiff::Timestamp;
+use jiff::civil::Time;
+use jiff::tz::TimeZone;
+use opensleep::config::{Config, LEDConfig, MqttConfig, SideConfig, SidesConfig};
+use opensleep::frozen::FrozenPacket;
+use opensleep::led::{CurrentBand, IS31FL3194Controller, LedPattern};
+use opensleep::mqtt::MqttManager;
+use opensleep::reset::ResetController;
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::sync::{mpsc, watch};
+use tokio::time::Instant;
+
+use crate::buildinfo::{DIAGNOSTIC_VERSION, kernel_release, source_commit};
+use crate::cli::PrimeOpenSleepInitArgs;
+use crate::confirm::confirm_phrase;
+use crate::i2c::I2cPort;
+use crate::link::{FrozenLink, PacketOutcome};
+use crate::log_tap;
+use crate::ownership;
+use crate::report::{Confirmations, OpenSleepInitResults, PrimeOutcome, ReleaseFrozenOnlyResults, ReservoirStatus, Report};
+use crate::safety::{AuditedTransport, FrozenAction, Mode};
+use crate::signals::{StopReason, wait_for_termination_signal};
+
+const INTERACTIVE_PHRASE: &str = "I CONFIRM THE RESERVOIR IS FILLED AND THE COVER IS CONNECTED";
+const FINAL_PHRASE: &str = "START SUPERVISED PRIMING";
+
+/// Confirmed against a live run on this Hub (an MT8365 Pod 3 Hub variant): `opensleep::frozen::PORT`
+/// (`/dev/ttymxc2`, correct for the devkit this fork's pinned upstream source targets) does not
+/// exist here, and `frozen::run` failed immediately with `Serial Io(NotFound)` when given it. This
+/// Hub exposes Frozen at `/dev/ttyS1` instead, still at the unmodified upstream baud rate
+/// (`frozen::manager::BAUD` = 38400) -- passed explicitly to `frozen::run`'s `port` argument
+/// (never `opensleep::frozen::PORT`) with no other change to that function's protocol, wake
+/// sequence, or state machine. See the module docs above and
+/// `tests::frozen_uart_path_is_ttys1_not_the_upstream_devkit_default`.
+const FROZEN_UART_PATH: &str = "/dev/ttyS1";
+
+/// Per firmware-reported evidence (not independently re-derived from the pinned source audit, as
+/// `HARD_MAX_DURATION_SECONDS` in `prime_test.rs` was): the firmware's own priming state machine
+/// runs for up to 600000 ms.
+const FIRMWARE_PRIMING_DURATION: Duration = Duration::from_millis(600_000);
+/// How long to wait, immediately after starting the real Frozen manager, before concluding it
+/// actually opened `FROZEN_UART_PATH` rather than having failed the way this file's own doc
+/// comments describe (`Serial Io(NotFound)`, surfaced as an immediate `Err` return from
+/// `frozen::run`'s future). A real open failure (missing device, permission denied, ...) is an
+/// immediate OS-level error; the first thing a *successful* open leads to is
+/// `FrozenState::publish_reset`, which submits an MQTT publish wrapped in a 100ms
+/// `tokio::time::timeout` that this mode's never-polled event loop cannot complete -- so a
+/// successful run always keeps `frozen::run`'s future pending for at least ~100ms before its main
+/// loop is ever reached, while a failed open resolves near-instantly. This window is kept well
+/// above that ~100ms floor for headroom without materially delaying a real run.
+const UART_OPEN_SETTLE: Duration = Duration::from_millis(500);
+/// Hard ceiling on waiting for the real Frozen manager to report `Pong(true)` (device mode ->
+/// Firmware) after starting. Generous relative to this binary's other subcommands'
+/// `COMMAND_TIMEOUT` because the real wake-retry loop in `opensleep::frozen::manager::run` backs
+/// off up to `MAX_WAKE_ATTEMPTS` * 2s internally before giving up on its own.
+const WAKE_TIMEOUT: Duration = Duration::from_secs(15);
+/// After `Pong(true)`, how long to keep watching captured log lines for capwater/flowrate/hardware
+/// info messages before deciding what was (and wasn't) reported, i.e. "until its normal startup
+/// messages have settled".
+const STARTUP_SETTLE: Duration = Duration::from_secs(3);
+/// Poll granularity while watching `log_tap` for a specific line to appear.
+const LOG_POLL_INTERVAL: Duration = Duration::from_millis(50);
+
+/// `--release-frozen-only` mode: after the I2C pulse (assert-then-release), how long to wait and
+/// drain unsolicited boot messages before Pinging at all. Real hardware evidence: Frozen emits
+/// interleaved startup chatter immediately after being released, so this window is drained (and
+/// logged) rather than skipped straight to Ping.
+const BOOT_MESSAGE_SETTLE: Duration = Duration::from_secs(2);
+/// `--release-frozen-only` mode: hard ceiling on repeatedly Pinging after the boot-message settle
+/// window, before concluding Frozen never responded at all and aborting without sending Prime.
+const PING_RETRY_WINDOW: Duration = Duration::from_secs(10);
+/// `--release-frozen-only` mode: how long to wait between repeated Ping attempts within
+/// `PING_RETRY_WINDOW`, and the granularity of the drain loop used both for the boot-message
+/// settle window and for watching for priming completion.
+const RELEASE_ONLY_POLL_INTERVAL: Duration = Duration::from_millis(500);
+/// `--release-frozen-only` mode: per-command timeout for a single Ping/JumpToFirmware/Prime
+/// exchange over its own `FrozenLink`/`AuditedTransport` (this mode does not use the real
+/// `frozen::run` manager at all -- see module docs). Mirrors `prime_test::COMMAND_TIMEOUT`.
+const RELEASE_ONLY_COMMAND_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// Item 20's required confirmation phrase, distinct from `INTERACTIVE_PHRASE`/`FINAL_PHRASE`:
+/// asked immediately before Prime, after Frozen has been released and its startup messages have
+/// been observed -- not at the very start of the run.
+const RESERVOIR_PHRASE: &str = "RESERVOIR INDICATOR IS STILL WORKING";
+
+/// Strips the `"FW: [priming] "` prefix used by every priming-stage message (source: real captured
+/// firmware log strings in `frozen/state.rs`), or `None` if `msg` isn't one. Mirrors
+/// `prime_test::priming_stage_text`.
+fn priming_stage_text(msg: &str) -> Option<&str> {
+    msg.strip_prefix("FW: [priming] ")
+}
+
+pub async fn run(args: &PrimeOpenSleepInitArgs) -> (Report, u8) {
+    if !(args.confirm_cover_hydraulics_connected
+        && args.confirm_reservoir_filled
+        && args.confirm_cover_loop_needs_priming
+        && args.confirm_no_visible_leaks
+        && args.confirm_active_test)
+    {
+        log::error!("refusing to run: all five --confirm-* flags are required");
+        return (refused_report(args, false, "missing required confirmation flags"), 30);
+    }
+
+    let interactive_ok = confirm_phrase(
+        args.assume_interactive_phrase.clone(),
+        INTERACTIVE_PHRASE,
+        "Type I CONFIRM THE RESERVOIR IS FILLED AND THE COVER IS CONNECTED to continue: ",
+    );
+    if !interactive_ok {
+        log::error!("refusing to run: interactive confirmation phrase was not matched exactly");
+        return (refused_report(args, false, "interactive confirmation phrase mismatch"), 30);
+    }
+
+    eprintln!("WARNING: Priming may rapidly lower the reservoir water level.");
+    eprintln!("Watch the reservoir continuously.");
+    eprintln!("Stop immediately if the reservoir approaches empty.");
+    eprintln!("Keep access to disconnect Hub power.");
+    let start_ok = confirm_phrase(
+        args.assume_start_phrase.clone(),
+        FINAL_PHRASE,
+        &format!("Type {FINAL_PHRASE} to continue: "),
+    );
+    if !start_ok {
+        log::error!("refusing to run: final start phrase was not matched exactly");
+        return (refused_report(args, false, "final start phrase mismatch"), 30);
+    }
+
+    // --release-frozen-only has its own dry-run handling (a mocked I2C expander and a mocked
+    // Frozen device -- see `run_release_frozen_only`), unlike the path below: it never touches
+    // opensleep::reset::ResetController or the real frozen::run manager, so unlike those, it *can*
+    // be run end-to-end against a mock, including in --dry-run.
+    if args.release_frozen_only {
+        return run_release_frozen_only(args).await;
+    }
+
+    if args.dry_run {
+        log::warn!(
+            "--dry-run: no I2C or UART writes will be performed; real OpenSleep initialization is skipped entirely \
+             (the reused upstream code hardcodes real serial ports/I2C devices and has no mock transport to substitute)"
+        );
+        return (dry_run_report(args), 0);
+    }
+
+    if let Some(early) = refuse_if_owned(args) {
+        return early;
+    }
+
+    log_tap::enable();
+    run_core(args).await
+}
+
+fn refuse_if_owned(args: &PrimeOpenSleepInitArgs) -> Option<(Report, u8)> {
+    let services = ownership::check_stock_services();
+    let active: Vec<_> = services.iter().filter(|s| s.active).map(|s| s.name.clone()).collect();
+    if !active.is_empty() {
+        log::error!("refusing to run: stock service(s) active: {active:?}");
+        return Some((refused_report(args, false, "stock service(s) active; refusing to run"), 40));
+    }
+    if ownership::device_exists("/dev/i2c-1") && ownership::device_is_open_elsewhere("/dev/i2c-1") {
+        log::error!("refusing to run: /dev/i2c-1 appears to be open in another process");
+        return Some((refused_report(args, false, "I2C device already open elsewhere"), 40));
+    }
+    if ownership::device_exists(FROZEN_UART_PATH) && ownership::device_is_open_elsewhere(FROZEN_UART_PATH) {
+        log::error!("refusing to run: {FROZEN_UART_PATH} appears to be open in another process");
+        return Some((refused_report(args, false, "Frozen UART already open elsewhere"), 40));
+    }
+    None
+}
+
+/// `--release-frozen-only`: a minimal startup mode that replaces both the global upstream reset
+/// (`opensleep::reset::ResetController`, used by [`run_core`] above) and the previous
+/// `--preserve-boot-state` behavior. It never calls `ResetController` and never writes I2C
+/// expander registers 0x06/0x07 -- see `i2c::pulse_frozen_reset_bit`'s doc comment for the
+/// real-hardware evidence behind this: the full reset sequence also reconfigures the
+/// port-direction registers, which leaves the reservoir-fill indicator off and unresponsive even
+/// though it does release Frozen. This mode releases Frozen with a narrow, single-bit
+/// low->high->low **pulse** on register 0x02 instead (a one-shot clear was tried first and does
+/// not work -- see that function's doc comment for the real-hardware evidence why), then drives
+/// Frozen through this diagnostic's own audited `FrozenLink`/`AuditedTransport` (`Mode::PrimeTest`)
+/// -- not the real `frozen::run` manager -- to Ping, jump to firmware if needed, observe boot
+/// messages, confirm the reservoir indicator is still working, and send `Prime` exactly once.
+async fn run_release_frozen_only(args: &PrimeOpenSleepInitArgs) -> (Report, u8) {
+    if args.dry_run {
+        log::warn!("--dry-run: no I2C or UART writes will be performed; using a mocked I2C expander and a mocked Frozen device");
+        let mut i2c = crate::i2c::MockI2c::always_succeed();
+        let (client, task) = crate::mock::spawn_mock_frozen_device_release_only(false, false, false);
+        let mut link = FrozenLink::wrap(client, "dry-run");
+        let result = run_release_frozen_only_core(args, &mut i2c, &mut link, true).await;
+        drop(link);
+        task.abort();
+        return result;
+    }
+
+    if let Some(early) = refuse_if_owned_release_only(args) {
+        return early;
+    }
+
+    let mut i2c = match crate::i2c::RealI2c::open("/dev/i2c-1") {
+        Ok(dev) => dev,
+        Err(e) => {
+            log::error!("failed to open I2C device for release: {e}");
+            return (refused_release_only_report(args, false, "I2C bus failed to open"), 20);
+        }
+    };
+
+    let mut link = match FrozenLink::open(FROZEN_UART_PATH) {
+        Ok(l) => l,
+        Err(e) => {
+            log::error!("failed to open Frozen UART {FROZEN_UART_PATH}: {e}");
+            return (refused_release_only_report(args, false, "Frozen UART failed to open"), 20);
+        }
+    };
+
+    run_release_frozen_only_core(args, &mut i2c, &mut link, false).await
+}
+
+fn refuse_if_owned_release_only(args: &PrimeOpenSleepInitArgs) -> Option<(Report, u8)> {
+    let services = ownership::check_stock_services();
+    let active: Vec<_> = services.iter().filter(|s| s.active).map(|s| s.name.clone()).collect();
+    if !active.is_empty() {
+        log::error!("refusing to run: stock service(s) active: {active:?}");
+        return Some((refused_release_only_report(args, false, "stock service(s) active; refusing to run"), 40));
+    }
+    if ownership::device_exists("/dev/i2c-1") && ownership::device_is_open_elsewhere("/dev/i2c-1") {
+        log::error!("refusing to run: /dev/i2c-1 appears to be open in another process");
+        return Some((refused_release_only_report(args, false, "I2C device already open elsewhere"), 40));
+    }
+    if ownership::device_exists(FROZEN_UART_PATH) && ownership::device_is_open_elsewhere(FROZEN_UART_PATH) {
+        log::error!("refusing to run: {FROZEN_UART_PATH} appears to be open in another process");
+        return Some((refused_release_only_report(args, false, "Frozen UART already open elsewhere"), 40));
+    }
+    None
+}
+
+/// The generic core of `--release-frozen-only`, testable against a mocked `I2cPort` and a mocked
+/// `FrozenLink` alike. Implements items 1-20 of the mode's spec (see module docs and this
+/// function's own inline comments for which item each step satisfies).
+async fn run_release_frozen_only_core<T, P>(
+    args: &PrimeOpenSleepInitArgs,
+    i2c: &mut P,
+    link: &mut FrozenLink<T>,
+    dry_run: bool,
+) -> (Report, u8)
+where
+    T: AsyncRead + AsyncWrite + Unpin,
+    P: I2cPort,
+{
+    let mut results = ReleaseFrozenOnlyResults::default();
+
+    // Items 1-6: pulse only bit 1 of register 0x02 low->high->low (assert, then release) -- never
+    // opensleep::reset::ResetController, never the four-register full reset sequence, never
+    // registers 0x06/0x07. See `i2c::pulse_frozen_reset_bit`'s doc comment for why a pulse (not a
+    // one-shot clear) is required: a live run found register 0x02 already reading `0xFD`, so
+    // clearing bit 1 alone was a no-op with no edge, and Frozen never responded.
+    let pulse = match crate::i2c::pulse_frozen_reset_bit(i2c).await {
+        Ok(p) => p,
+        Err(e) => {
+            log::error!("failed to pulse Frozen reset bit via I2C: {e}");
+            return (finish_release_only(args, results, StopReason::PreflightRefused, 20, dry_run), 20);
+        }
+    };
+    results.original_register_0x02 = pulse.assert_step.original;
+    results.asserted_register_0x02 = pulse.assert_step.target;
+    results.asserted_readback_register_0x02 = pulse.assert_step.readback;
+    results.asserted_readback_matches = pulse.assert_step.readback_matches;
+    results.released_register_0x02 = pulse.release_step.target;
+    results.released_readback_register_0x02 = pulse.release_step.readback;
+    results.released_readback_matches = pulse.release_step.readback_matches;
+    results.only_bit1_changed = pulse.assert_step.only_bit1_changed && pulse.release_step.only_bit1_changed;
+    results.pulse_duration_ms = pulse.pulse_duration.as_millis() as u64;
+
+    // Abort if either half of the pulse did not verify -- either a readback disagreed with what
+    // was written, or (should be impossible by construction) a bit other than bit 1 changed.
+    if !pulse.fully_verified() {
+        log::error!(
+            "aborting: register 0x02 pulse did not verify (asserted_readback_matches={} \
+             asserted_only_bit1_changed={} released_readback_matches={} released_only_bit1_changed={})",
+            pulse.assert_step.readback_matches, pulse.assert_step.only_bit1_changed,
+            pulse.release_step.readback_matches, pulse.release_step.only_bit1_changed
+        );
+        return (finish_release_only(args, results, StopReason::PreflightRefused, 20, dry_run), 20);
+    }
+    log::info!(
+        "Frozen reset bit pulsed: asserted 0x{:02X} -> released 0x{:02X} in {:?}, every other bit unchanged",
+        pulse.assert_step.target, pulse.release_step.target, pulse.pulse_duration
+    );
+    results.frozen_uart_opened = true;
+
+    // Item 7: wait up to 2 seconds for boot messages, draining and logging anything Frozen sends
+    // unsolicited (informational only -- capwater/flowrate mentions here are logged but do not
+    // gate Prime; only the operator's own reservoir confirmation below does, per item 11).
+    let mut audit = AuditedTransport::new(Mode::PrimeTest);
+    let mut capwater_unavailable = false;
+    let mut flowrate_unavailable = false;
+    let boot_deadline = Instant::now() + BOOT_MESSAGE_SETTLE;
+    loop {
+        let remaining = boot_deadline.saturating_duration_since(Instant::now());
+        if remaining.is_zero() {
+            break;
+        }
+        match link.recv(remaining).await {
+            Ok(PacketOutcome::Received(FrozenPacket::Message(m))) => {
+                log::info!("boot message: {m}");
+                if m == "FW: [capwater] sensor unavailable" {
+                    capwater_unavailable = true;
+                }
+                if m == "FW: [flowrate] sensor unavailable" {
+                    flowrate_unavailable = true;
+                }
+            }
+            Ok(PacketOutcome::Received(pkt)) => log::info!("boot packet: {pkt:?}"),
+            Ok(PacketOutcome::TimedOut) => {}
+            Ok(PacketOutcome::Closed) | Err(_) => break,
+        }
+    }
+    results.capwater_unavailable_observed = capwater_unavailable;
+    results.flowrate_unavailable_observed = flowrate_unavailable;
+
+    // Items 7-8: Ping repeatedly for up to 10 seconds until Frozen answers at all.
+    let ping_deadline = Instant::now() + PING_RETRY_WINDOW;
+    let mut mode = crate::frozen_ops::DeviceMode::Unknown;
+    let mut ping_ok = false;
+    loop {
+        let (ok, m) = crate::frozen_ops::ping(link, &mut audit, RELEASE_ONLY_COMMAND_TIMEOUT).await;
+        if ok {
+            ping_ok = true;
+            mode = m;
+            break;
+        }
+        if Instant::now() >= ping_deadline {
+            break;
+        }
+        tokio::time::sleep(RELEASE_ONLY_POLL_INTERVAL).await;
+    }
+
+    // Item 8: Pong(false) -> JumpToFirmware; Pong(true) -> already in firmware; no response within
+    // the window -> abort without sending Prime. Item 9: after JumpToFirmware,
+    // `jump_to_firmware_and_wait` allows sufficient time for interleaved startup messages by
+    // simply re-Pinging (tolerating anything else received in between) for up to its own 10-second
+    // hard timeout before requiring `Pong(true)`.
+    let reached_firmware = match mode {
+        crate::frozen_ops::DeviceMode::Firmware => true,
+        crate::frozen_ops::DeviceMode::Bootloader => {
+            crate::frozen_ops::jump_to_firmware_and_wait(link, &mut audit, RELEASE_ONLY_COMMAND_TIMEOUT).await
+        }
+        crate::frozen_ops::DeviceMode::Unknown => false,
+    };
+    results.frozen_reached_firmware = reached_firmware;
+
+    if !ping_ok {
+        log::error!("aborting: Frozen did not respond to Ping within {PING_RETRY_WINDOW:?} of being released from reset; no Prime sent");
+    }
+    // Item 12: no automatic reset assert here -- a preflight failure before Frozen ever responds is
+    // not "after Frozen is responsive", and is not a pump fault, so item 13's emergency backstop
+    // does not apply.
+    if !ping_ok || !reached_firmware {
+        return (finish_release_only(args, results, StopReason::PreflightRefused, 20, dry_run), 20);
+    }
+
+    // Item 10: the reservoir confirmation is required only now -- after Frozen has reached
+    // application firmware -- immediately before Prime. Item 11: its outcome is reported
+    // explicitly (never merely inferred from an automatic sensor check), and reaching this point at
+    // all means it is never left at its `Unverified` default.
+    let reservoir_ok = confirm_phrase(
+        args.assume_reservoir_phrase.clone(),
+        RESERVOIR_PHRASE,
+        &format!("Type {RESERVOIR_PHRASE} to continue: "),
+    );
+    results.reservoir_status = if reservoir_ok {
+        ReservoirStatus::Confirmed
+    } else {
+        ReservoirStatus::FailedByOperatorObservation
+    };
+    if !reservoir_ok {
+        log::error!("refusing to send Prime: reservoir confirmation phrase was not matched exactly");
+        // Item 12: still no automatic reset assert -- Frozen is responsive here, but this is a
+        // confirmation refusal, not a pump fault or other emergency.
+        return (finish_release_only(args, results, StopReason::PreflightRefused, 30, dry_run), 30);
+    }
+
+    let send_result = link.send(&mut audit, FrozenAction::prime(), RELEASE_ONLY_COMMAND_TIMEOUT).await;
+    results.prime_sent = send_result.is_ok();
+    if send_result.is_err() {
+        log::error!("failed to send Prime: {send_result:?}");
+        return (finish_release_only(args, results, StopReason::UartWriteFailure, 20, dry_run), 20);
+    }
+    log::info!("Prime sent");
+
+    // Items 14/15: distinguish "done" from "done because empty" (exact match, never a substring
+    // check -- mirrors run_core above); support the firmware's up-to-600000ms priming runtime.
+    let observe_deadline = Instant::now() + FIRMWARE_PRIMING_DURATION;
+    let mut stop_reason = StopReason::DurationExpired;
+    'observe: loop {
+        let remaining = observe_deadline.saturating_duration_since(Instant::now());
+        if remaining.is_zero() {
+            break;
+        }
+        tokio::select! {
+            biased;
+            reason = wait_for_termination_signal() => { stop_reason = reason; break 'observe; }
+            outcome = link.recv(remaining.min(RELEASE_ONLY_POLL_INTERVAL)) => {
+                match outcome {
+                    Ok(PacketOutcome::Received(FrozenPacket::Message(m))) => {
+                        if let Some(stage) = priming_stage_text(&m) {
+                            match stage {
+                                "done" => {
+                                    results.normal_done_observed = true;
+                                    stop_reason = StopReason::PrimingCompleted;
+                                    break 'observe;
+                                }
+                                "done because empty" => {
+                                    results.done_because_empty_observed = true;
+                                    stop_reason = StopReason::PrimingCompleted;
+                                    break 'observe;
+                                }
+                                _ => {}
+                            }
+                        } else if is_pump_fault_message(&m) {
+                            stop_reason = StopReason::PumpFault;
+                            break 'observe;
+                        }
+                    }
+                    Ok(PacketOutcome::Closed) | Err(_) => {
+                        stop_reason = StopReason::UartReadFailure;
+                        break 'observe;
+                    }
+                    _ => {}
+                }
+            }
+        }
+    }
+
+    let prime_outcome = if results.normal_done_observed {
+        PrimeOutcome::Success
+    } else if results.done_because_empty_observed {
+        PrimeOutcome::IncompleteReservoirEmpty
+    } else if results.prime_sent {
+        PrimeOutcome::NotObservedWithinWindow
+    } else {
+        PrimeOutcome::NotSent
+    };
+    results.prime_outcome = prime_outcome;
+
+    // Item 18: emergency-only backstop -- a genuine firmware-reported pump fault, and only that,
+    // re-asserts Frozen's reset bit via a narrow read-modify-write (never the full reset).
+    let emergency_reset_asserted = if matches!(stop_reason, StopReason::PumpFault) {
+        log::error!("firmware-reported pump fault observed: asserting emergency Frozen-only reset");
+        assert_release_only_emergency_reset(i2c).await
+    } else {
+        false
+    };
+    results.emergency_reset_asserted = emergency_reset_asserted;
+
+    // Item 17: on normal completion (or "done because empty"), do not restore the port or run any
+    // reset -- Frozen is left released and running, exactly as this mode's minimal-intervention
+    // design intends.
+    if matches!(stop_reason, StopReason::CtrlC | StopReason::Sigterm | StopReason::Sighup) {
+        eprintln!("--release-frozen-only: stop requested.");
+        eprintln!("Frozen is left released from reset (register 0x02 bit 1 remains cleared); no port restore or reset performed.");
+        eprintln!("If priming does not stop, reboot the Hub or disconnect Hub power.");
+    }
+
+    // `stop_reason` can only be `PrimingCompleted`/`DurationExpired`/`PumpFault`/
+    // `UartReadFailure`/`CtrlC`/`Sigterm`/`Sighup` at this point -- every `PreflightRefused` path
+    // above already returned its own exit code directly.
+    let exit_code = if prime_outcome == PrimeOutcome::Success { 0 } else { 1 };
+    (finish_release_only(args, results, stop_reason, exit_code, dry_run), exit_code)
+}
+
+/// Emergency-only backstop for `--release-frozen-only`, used solely for a genuine
+/// firmware-reported pump fault. Reuses `i2c::assert_frozen_reset_bit_only` -- a narrow,
+/// read-modify-write re-assertion of only bit 1 of register 0x02 -- never `i2c::assert_reset`
+/// (which unconditionally writes the hardcoded value 0xFF, used by every other mode's
+/// safe-stop/`emergency-stop`, and by `assert_emergency_reset` above for the non-`--release-
+/// frozen-only` path).
+async fn assert_release_only_emergency_reset<P: I2cPort>(i2c: &mut P) -> bool {
+    match crate::i2c::assert_frozen_reset_bit_only(i2c).await {
+        Ok(r) if r.readback_matches && r.only_bit1_changed => {
+            log::warn!("emergency Frozen-only reset asserted (0x20 reg 0x02 bit 1 set); left asserted");
+            true
+        }
+        Ok(r) => {
+            log::error!(
+                "emergency Frozen-only reset write did not verify: readback_matches={} only_bit1_changed={}",
+                r.readback_matches, r.only_bit1_changed
+            );
+            false
+        }
+        Err(e) => {
+            log::error!("FAILED to assert emergency Frozen-only reset: {e}");
+            false
+        }
+    }
+}
+
+fn finish_release_only(
+    args: &PrimeOpenSleepInitArgs,
+    results: ReleaseFrozenOnlyResults,
+    stop_reason: StopReason,
+    exit_code: u8,
+    dry_run: bool,
+) -> Report {
+    let overall_pass = results.prime_outcome == PrimeOutcome::Success;
+    let mut report = base_report(args, dry_run);
+    report.mode = "frozen-prime-opensleep-init --release-frozen-only".to_string();
+    report.confirmations = Confirmations {
+        cover_hydraulics_connected_declared: Some(args.confirm_cover_hydraulics_connected),
+        water_loop_filled_declared: Some(args.confirm_reservoir_filled),
+        no_visible_leaks_declared: Some(args.confirm_no_visible_leaks),
+        active_test_confirmed_flag: Some(args.confirm_active_test),
+        interactive_phrase_confirmed: Some(true),
+        final_start_phrase_confirmed: Some(true),
+    };
+    report.i2c_bus_open = true;
+    report.frozen_port = FROZEN_UART_PATH.to_string();
+    report.frozen_uart_opened = results.frozen_uart_opened;
+    report.frozen_firmware_ping = Some(results.frozen_reached_firmware);
+    report.prime_command_count = u32::from(results.prime_sent);
+    report.priming_done_observed = results.normal_done_observed || results.done_because_empty_observed;
+    report.priming_done_because_empty = results.done_because_empty_observed;
+    report.stop_reason = stop_reason.to_string();
+    report.release_frozen_only_results = Some(results);
+    report.overall_pass = overall_pass;
+    report.exit_code = exit_code;
+
+    if let Some(path) = &args.json_output
+        && let Err(e) = report.write_json(path)
+    {
+        log::error!("failed to write JSON output to {path}: {e}");
+    }
+    report.print_table();
+    report
+}
+
+/// Mirrors `refused_report` above but for `--release-frozen-only`: only ever called after the
+/// shared confirm-flags/interactive-phrase/final-phrase checks in `run` have already succeeded
+/// (see `run_release_frozen_only`), so both are reported `true` here, unlike `refused_report`'s
+/// own early-refusal call sites where they may not have been checked yet.
+fn refused_release_only_report(args: &PrimeOpenSleepInitArgs, dry_run: bool, reason: &str) -> Report {
+    let mut report = base_report(args, dry_run);
+    report.mode = "frozen-prime-opensleep-init --release-frozen-only".to_string();
+    report.confirmations = Confirmations {
+        cover_hydraulics_connected_declared: Some(args.confirm_cover_hydraulics_connected),
+        water_loop_filled_declared: Some(args.confirm_reservoir_filled),
+        no_visible_leaks_declared: Some(args.confirm_no_visible_leaks),
+        active_test_confirmed_flag: Some(args.confirm_active_test),
+        interactive_phrase_confirmed: Some(true),
+        final_start_phrase_confirmed: Some(true),
+    };
+    report.stop_reason = reason.to_string();
+    report.release_frozen_only_results = Some(ReleaseFrozenOnlyResults::default());
+    report.exit_code = 30;
+    report
+}
+
+/// Builds the in-memory `Config` this mode hands to the real `frozen::run`. See module docs
+/// ("Triggering Prime without a command channel") for why `prime` is "now" and `away_mode` is
+/// `false` with an empty temperature profile rather than `true`.
+fn build_config() -> Config {
+    let timezone = TimeZone::UTC;
+    let now_time: Time = Timestamp::now().to_zoned(timezone.clone()).time();
+
+    Config {
+        timezone,
+        away_mode: false,
+        prime: now_time,
+        led: LEDConfig {
+            idle: LedPattern::Off,
+            active: LedPattern::Off,
+            band: CurrentBand::One,
+        },
+        mqtt: MqttConfig {
+            server: "127.0.0.1".to_string(),
+            port: 1,
+            user: String::new(),
+            password: String::new(),
+        },
+        profile: SidesConfig::Solo(SideConfig {
+            temperatures: Vec::new(),
+            sleep: Time::midnight(),
+            wake: Time::midnight(),
+            alarm: None,
+        }),
+        presence: None,
+    }
+}
+
+async fn run_core(args: &PrimeOpenSleepInitArgs) -> (Report, u8) {
+    // Item 4: preflight check that the Frozen UART this Hub actually exposes exists, before
+    // touching I2C at all -- see `FROZEN_UART_PATH`'s doc comment for why this differs from the
+    // upstream `frozen::PORT` default.
+    if !ownership::device_exists(FROZEN_UART_PATH) {
+        log::error!("refusing to run: {FROZEN_UART_PATH} does not exist; aborting before touching I2C");
+        return (refused_report(args, false, &format!("{FROZEN_UART_PATH} does not exist")), 20);
+    }
+
+    // Step: the real I2C reset. Not this binary's own reimplementation -- see module docs.
+    let mut resetter = match ResetController::new() {
+        Ok(r) => r,
+        Err(e) => {
+            log::error!("failed to open I2C device for reset: {e}");
+            return (refused_report(args, false, "I2C bus failed to open"), 20);
+        }
+    };
+    let reset_result = resetter.reset_subsystems().await;
+    let reset_ok = reset_result.is_ok();
+    if let Err(e) = &reset_result {
+        log::error!("subsystem reset failed: {e}");
+        return (
+            finish(
+                args,
+                OpenSleepInitResults {
+                    reset_performed: true,
+                    reset_ok: false,
+                    frozen_uart_requested: FROZEN_UART_PATH.to_string(),
+                    ..Default::default()
+                },
+                StopReason::PreflightRefused,
+                30,
+            ),
+            30,
+        );
+    }
+    log::info!("subsystem reset completed via the real opensleep::reset::ResetController");
+
+    // The real LED controller, exactly as upstream constructs it -- takes ownership of the same
+    // I2cdev the resetter just used. Its writes are already non-fatal upstream (see
+    // `opensleep::frozen::manager::set_led`), so nothing further is needed here (item 7).
+    let led = IS31FL3194Controller::new(resetter.take());
+
+    let device_label =
+        std::fs::read_to_string("/home/dac/app/sewer/device-label").unwrap_or_else(|_| "unknown".to_string());
+
+    let config = build_config();
+    let (config_tx, config_rx) = watch::channel(config);
+    // Sensor is intentionally never started in this mode (see module docs), but MqttManager::new
+    // still requires a calibrate-request sender -- constructed and its receive side immediately
+    // dropped, since nothing will ever poll the MQTT event loop that would deliver into it.
+    let (calibrate_tx, _calibrate_rx) = mpsc::channel(32);
+
+    // The real MqttManager, constructed exactly as upstream does -- but its event loop is never
+    // polled (no wait_for_conn, no run()), so no network connection is ever attempted and a
+    // missing/unreachable broker cannot block or fail this run (item 8). See module docs.
+    let mqtt_man = MqttManager::new(config_tx.clone(), config_rx.clone(), calibrate_tx, device_label.clone());
+    let mqtt_client = mqtt_man.client.clone();
+
+    let checkpoint_before_frozen = log_tap::checkpoint();
+
+    // Item 3: log the override before opening. `opensleep::frozen::PORT` is referenced here only
+    // as the comparison value in this message -- never as an argument to anything that opens a
+    // port (see `FROZEN_UART_PATH`'s doc comment).
+    log::info!("Frozen manager UART override: {} -> {FROZEN_UART_PATH}", opensleep::frozen::PORT);
+
+    // The real Frozen manager, called with `FROZEN_UART_PATH` (never `opensleep::frozen::PORT` --
+    // item 1). Its `Future` is not `Send` (it holds a `tokio::sync::watch::Ref` internally, which
+    // wraps a non-`Send` lock guard), so unlike this binary's other spawned tasks, it cannot be
+    // `tokio::spawn`-ed -- it is polled directly in this task via `tokio::select!` below, exactly
+    // the way real `main.rs`'s own top-level `select!` drives it. This is also what makes shutdown
+    // "the normal OpenSleep manager path": there is no `.abort()` anywhere in this function -- this
+    // future is simply dropped when `run_core` returns, cancelling it the same way real `main.rs`
+    // cancels its losing `select!` branches. Nothing about the manager's protocol, wake sequence,
+    // or state machine changes (item 2): only the device path differs from upstream.
+    let frozen_fut = opensleep::frozen::run(FROZEN_UART_PATH, config_rx.clone(), led, mqtt_client.clone());
+    tokio::pin!(frozen_fut);
+
+    let mut results = OpenSleepInitResults {
+        reset_performed: true,
+        reset_ok,
+        device_label: device_label.clone(),
+        frozen_uart_requested: FROZEN_UART_PATH.to_string(),
+        ..Default::default()
+    };
+
+    // Distinguish "the port opened" from "a task was merely started" (item 6's requirement applied
+    // here to Frozen too, for the same reason): race the manager's future against
+    // `UART_OPEN_SETTLE` -- see that constant's doc comment for why this window reliably
+    // distinguishes an immediate open failure (the exact `Serial Io(NotFound)` this override
+    // exists to fix) from a real, successful open.
+    tokio::select! {
+        biased;
+        res = &mut frozen_fut => {
+            log::error!(
+                "Frozen manager exited immediately after starting -- {FROZEN_UART_PATH} likely failed to open: {res:?}"
+            );
+            results.frozen_uart_opened = false;
+            results.frozen_manager_task_running = false;
+            return (finish(args, results, StopReason::PreflightRefused, 20), 20);
+        }
+        _ = tokio::time::sleep(UART_OPEN_SETTLE) => {
+            log::info!("Frozen manager still running after {UART_OPEN_SETTLE:?}: {FROZEN_UART_PATH} opened successfully");
+            results.frozen_uart_opened = true;
+        }
+    }
+
+    #[derive(Debug, Clone, Copy, PartialEq)]
+    enum Phase {
+        WaitingForFirmware,
+        Settling,
+        Observing,
+    }
+
+    let wake_deadline = Instant::now() + WAKE_TIMEOUT;
+    let mut settle_until = Instant::now();
+    let mut observe_deadline = Instant::now();
+    let mut scanned_up_to = checkpoint_before_frozen;
+    let mut phase = Phase::WaitingForFirmware;
+    let mut frozen_task_crashed = false;
+
+    // Steps 9-13, all driven by one loop so `frozen_fut` is polled continuously throughout: let
+    // the real, unmodified manager perform its own Ping/JumpToFirmware/wake sequence and obtain
+    // hardware information (item 9), wait for startup messages to settle, refuse to send Prime if
+    // capwater is unavailable, then observe the real scheduler's single Prime send -- which only
+    // ever fires once the manager's own `state.is_awake()` is true, i.e. application firmware has
+    // demonstrably been reached (item 10) -- for up to the firmware-reported priming duration.
+    let stop_reason = 'main: loop {
+        tokio::select! {
+            biased;
+            reason = wait_for_termination_signal() => break 'main reason,
+            res = &mut frozen_fut => {
+                log::error!("Frozen task unexpectedly exited: {res:?}");
+                frozen_task_crashed = true;
+                break 'main StopReason::UartReadFailure;
+            }
+            _ = tokio::time::sleep(LOG_POLL_INTERVAL) => match phase {
+                Phase::WaitingForFirmware => {
+                    let reached = log_tap::contains_exact(checkpoint_before_frozen, "opensleep::frozen::state", "Device mode: Unknown -> Firmware")
+                        || log_tap::contains_exact(checkpoint_before_frozen, "opensleep::frozen::state", "Device mode: Bootloader -> Firmware");
+                    if reached {
+                        log::info!("Frozen answered Pong(true); waiting {STARTUP_SETTLE:?} for startup messages to settle");
+                        results.frozen_reached_firmware = true;
+                        settle_until = Instant::now() + STARTUP_SETTLE;
+                        phase = Phase::Settling;
+                    } else if Instant::now() >= wake_deadline {
+                        log::error!("refusing to send Prime: Frozen did not answer Pong(true) within {WAKE_TIMEOUT:?}");
+                        break 'main StopReason::PreflightRefused;
+                    }
+                }
+                Phase::Settling => {
+                    if Instant::now() >= settle_until {
+                        let capwater_unavailable = log_tap::contains_exact(checkpoint_before_frozen, "opensleep::frozen::state", "Message: FW: [capwater] sensor unavailable");
+                        let flowrate_unavailable = log_tap::contains_exact(checkpoint_before_frozen, "opensleep::frozen::state", "Message: FW: [flowrate] sensor unavailable");
+                        log::info!("[capwater] sensor unavailable observed: {capwater_unavailable}");
+                        log::info!("[flowrate] sensor unavailable observed: {flowrate_unavailable}");
+                        results.capwater_unavailable_observed = capwater_unavailable;
+                        results.flowrate_unavailable_observed = flowrate_unavailable;
+                        if capwater_unavailable {
+                            log::error!("refusing to send Prime: [capwater] sensor unavailable as a result of this run's own initialization");
+                            log::error!("initialization sequence and subsystem state that produced this:");
+                            log::error!("  subsystem reset performed: {} (ok: {reset_ok})", results.reset_performed);
+                            log::error!("  Frozen UART requested: {}", results.frozen_uart_requested);
+                            log::error!("  Frozen UART opened: {}", results.frozen_uart_opened);
+                            log::error!("  Frozen reached application firmware: true");
+                            log::error!("  [flowrate] sensor unavailable observed: {flowrate_unavailable}");
+                            for line in log_tap::since(checkpoint_before_frozen) {
+                                log::error!("  [{}] {}", line.target, line.message);
+                            }
+                            break 'main StopReason::PreflightRefused;
+                        }
+                        scanned_up_to = log_tap::checkpoint();
+                        observe_deadline = Instant::now() + FIRMWARE_PRIMING_DURATION;
+                        phase = Phase::Observing;
+                    }
+                }
+                Phase::Observing => {
+                    let lines = log_tap::since(scanned_up_to);
+                    scanned_up_to += lines.len();
+                    for line in &lines {
+                        if line.target.starts_with("opensleep::frozen::manager") && line.message == " -> Prime" {
+                            results.prime_sent_count += 1;
+                            results.prime_sent = true;
+                        }
+                        if line.target.starts_with("opensleep::frozen::state") {
+                            // Step 11: do not stop immediately after "start" -- only "done"/"done
+                            // because empty" (exact match, never a substring check) end observation.
+                            if line.message == "Priming Message: done" {
+                                results.normal_done_observed = true;
+                                break 'main StopReason::PrimingCompleted;
+                            }
+                            if line.message == "Priming Message: done because empty" {
+                                results.done_because_empty_observed = true;
+                                break 'main StopReason::PrimingCompleted;
+                            }
+                            if is_pump_fault_message(&line.message) {
+                                break 'main StopReason::PumpFault;
+                            }
+                        }
+                    }
+                    if Instant::now() >= observe_deadline {
+                        break 'main StopReason::DurationExpired;
+                    }
+                }
+            }
+        }
+    };
+
+    results.frozen_manager_task_running = !frozen_task_crashed;
+
+    let prime_outcome = if results.normal_done_observed {
+        PrimeOutcome::Success
+    } else if results.done_because_empty_observed {
+        PrimeOutcome::IncompleteReservoirEmpty
+    } else if results.prime_sent_count > 0 {
+        PrimeOutcome::NotObservedWithinWindow
+    } else {
+        PrimeOutcome::NotSent
+    };
+    results.prime_outcome = prime_outcome;
+
+    // Steps 13/14: never assert the global reset on normal completion or "done because empty".
+    // Only a genuine firmware-reported pump fault gets the emergency backstop (this diagnostic's
+    // own, already-audited assert_reset -- not upstream's reset sequence; see module docs).
+    let emergency_reset_asserted = if matches!(stop_reason, StopReason::PumpFault) {
+        log::error!("firmware-reported pump fault observed: asserting emergency subsystem reset");
+        assert_emergency_reset().await
+    } else {
+        false
+    };
+    results.emergency_reset_asserted = emergency_reset_asserted;
+
+    if matches!(stop_reason, StopReason::CtrlC | StopReason::Sigterm | StopReason::Sighup) {
+        eprintln!("--frozen-prime-opensleep-init: stop requested.");
+        eprintln!("Shutting down through the normal OpenSleep manager path (no subsystem reset performed).");
+        eprintln!("If priming does not stop, reboot the Hub or disconnect Hub power.");
+        eprintln!(
+            "Temperature targets were never enabled during this run (the configured profile has no \
+             temperatures, which the real scheduler always treats as disabled -- see module docs), so \
+             there is nothing further to disable."
+        );
+    }
+
+    // Preflight-style refusals (never reached firmware, or capwater unavailable) use this binary's
+    // usual exit code 30 for a refused run; once past both checks this is a normal active-test
+    // outcome (0 on success, 1 otherwise). `frozen_fut` is dropped here, cancelling it -- the same
+    // drop-based shutdown real main.rs's own select! already uses.
+    let exit_code = if !results.frozen_reached_firmware || results.capwater_unavailable_observed {
+        30
+    } else if prime_outcome == PrimeOutcome::Success {
+        0
+    } else {
+        1
+    };
+    (finish(args, results, stop_reason, exit_code), exit_code)
+}
+
+/// Narrow, evidence-gated pump-fault detection: "pump" plus a fault word, distinct from a normal
+/// `pump[<side>] ... @ V A` telemetry line. Mirrors `prime_test::is_pump_fault_message`.
+fn is_pump_fault_message(msg: &str) -> bool {
+    let lower = msg.to_lowercase();
+    lower.contains("pump") && (lower.contains("fault") || lower.contains("locked")) && !lower.contains('@')
+}
+
+/// Emergency-only backstop, used solely for a genuine firmware-reported pump fault (never for
+/// normal completion, "done because empty", or Ctrl+C -- see module docs). Reuses this
+/// diagnostic's own, already-audited `i2c::assert_reset` primitive -- a single, minimal write this
+/// tool has always used as its safety backstop across every mode -- not a reimplementation of
+/// upstream's reset sequence.
+async fn assert_emergency_reset() -> bool {
+    match crate::i2c::RealI2c::open("/dev/i2c-1") {
+        Ok(mut dev) => {
+            let step = crate::i2c::assert_reset(&mut dev).await;
+            if step.success {
+                log::warn!("emergency subsystem reset asserted (0x20 reg 0x02 <- 0xFF); left asserted");
+            } else {
+                log::error!("FAILED to assert emergency subsystem reset: errno {:?}", step.os_error);
+            }
+            step.success
+        }
+        Err(e) => {
+            log::error!("could not open I2C device for emergency reset: {e}");
+            false
+        }
+    }
+}
+
+fn finish(args: &PrimeOpenSleepInitArgs, results: OpenSleepInitResults, stop_reason: StopReason, exit_code: u8) -> Report {
+    let overall_pass = results.prime_outcome == PrimeOutcome::Success;
+    let mut report = base_report(args, false);
+    report.confirmations = Confirmations {
+        cover_hydraulics_connected_declared: Some(args.confirm_cover_hydraulics_connected),
+        water_loop_filled_declared: Some(args.confirm_reservoir_filled),
+        no_visible_leaks_declared: Some(args.confirm_no_visible_leaks),
+        active_test_confirmed_flag: Some(args.confirm_active_test),
+        interactive_phrase_confirmed: Some(true),
+        final_start_phrase_confirmed: Some(true),
+    };
+    report.i2c_bus_open = true;
+    report.subsystem_reset_performed = results.reset_performed;
+    report.subsystem_reset_ok = results.reset_ok;
+    report.frozen_port = results.frozen_uart_requested.clone();
+    report.frozen_uart_opened = results.frozen_uart_opened;
+    report.frozen_firmware_ping = Some(results.frozen_reached_firmware);
+    report.prime_command_count = results.prime_sent_count;
+    report.priming_done_observed = results.normal_done_observed || results.done_because_empty_observed;
+    report.priming_done_because_empty = results.done_because_empty_observed;
+    report.stop_reason = stop_reason.to_string();
+    report.opensleep_init_results = Some(results);
+    report.overall_pass = overall_pass;
+    report.exit_code = exit_code;
+
+    if let Some(path) = &args.json_output
+        && let Err(e) = report.write_json(path)
+    {
+        log::error!("failed to write JSON output to {path}: {e}");
+    }
+    report.print_table();
+    report
+}
+
+fn dry_run_report(args: &PrimeOpenSleepInitArgs) -> Report {
+    let mut report = base_report(args, true);
+    report.confirmations = Confirmations {
+        cover_hydraulics_connected_declared: Some(args.confirm_cover_hydraulics_connected),
+        water_loop_filled_declared: Some(args.confirm_reservoir_filled),
+        no_visible_leaks_declared: Some(args.confirm_no_visible_leaks),
+        active_test_confirmed_flag: Some(args.confirm_active_test),
+        interactive_phrase_confirmed: Some(true),
+        final_start_phrase_confirmed: Some(true),
+    };
+    report.stop_reason = "dry run: real initialization skipped entirely".to_string();
+    report.opensleep_init_results = Some(OpenSleepInitResults::default());
+    report.exit_code = 0;
+
+    if let Some(path) = &args.json_output
+        && let Err(e) = report.write_json(path)
+    {
+        log::error!("failed to write JSON output to {path}: {e}");
+    }
+    report.print_table();
+    report
+}
+
+fn refused_report(args: &PrimeOpenSleepInitArgs, dry_run: bool, reason: &str) -> Report {
+    let mut report = base_report(args, dry_run);
+    report.confirmations = Confirmations {
+        cover_hydraulics_connected_declared: Some(args.confirm_cover_hydraulics_connected),
+        water_loop_filled_declared: Some(args.confirm_reservoir_filled),
+        no_visible_leaks_declared: Some(args.confirm_no_visible_leaks),
+        active_test_confirmed_flag: Some(args.confirm_active_test),
+        interactive_phrase_confirmed: Some(false),
+        final_start_phrase_confirmed: Some(false),
+    };
+    report.stop_reason = reason.to_string();
+    report.exit_code = 30;
+    report
+}
+
+fn base_report(_args: &PrimeOpenSleepInitArgs, dry_run: bool) -> Report {
+    Report {
+        program_version: DIAGNOSTIC_VERSION.to_string(),
+        opensleep_base_version: opensleep::VERSION.to_string(),
+        opensleep_source_commit: source_commit().to_string(),
+        kernel: kernel_release(),
+        arch: std::env::consts::ARCH.to_string(),
+        mode: "frozen-prime-opensleep-init".to_string(),
+        dry_run,
+        confirmations: Confirmations::default(),
+        i2c_device: "/dev/i2c-1".to_string(),
+        i2c_bus_open: false,
+        reset_expander_probe_ok: false,
+        reset_expander_value: None,
+        led_controller_probe_ok: false,
+        subsystem_reset_performed: false,
+        subsystem_reset_ok: false,
+        frozen_port: FROZEN_UART_PATH.to_string(),
+        frozen_uart_opened: false,
+        frozen_bootloader_ping: None,
+        frozen_firmware_ping: None,
+        frozen_hardware_info: None,
+        firmware_version_or_hash: None,
+        frozen_firmware_probed: false,
+        detected_initial_mode: None,
+        firmware_jump_sent: false,
+        outgoing_commands: Vec::new(),
+        enabled_target_command_count: 0,
+        prime_command_count: 0,
+        random_command_count: 0,
+        safety_off_commands_sent: 0,
+        rejected_command_count: 0,
+        prime_frame_hex: None,
+        telemetry_samples: Vec::new(),
+        raw_packets_decoded: 0,
+        malformed_windows: 0,
+        communication_timeouts: 0,
+        unsolicited_telemetry_seen: false,
+        firmware_messages: Vec::new(),
+        pump_samples: Vec::new(),
+        solenoid_valve_messages: Vec::new(),
+        reservoir_transition_messages: Vec::new(),
+        other_decoded_packets: Vec::new(),
+        raw_io_events: Vec::new(),
+        priming_start_observed: false,
+        priming_done_observed: false,
+        priming_done_because_empty: false,
+        operator_observations: None,
+        prime_operator_observations: None,
+        stop_reason: String::new(),
+        safe_stop: None,
+        component_results: None,
+        prime_results: None,
+        opensleep_init_results: None,
