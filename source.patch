+    }
+
+    pub fn write_csv(&self, path: &str) -> std::io::Result<()> {
+        let mut w = std::fs::File::create(path)?;
+        // Renamed from the original "status_code" header: that name was inaccurate.
+        // `TemperatureUpdate.error` is a control-loop error term in degrees C, not a status/fault
+        // code -- see `telemetry::TemperatureSample::control_error_c`'s doc comment for evidence.
+        writeln!(w, "elapsed_ms,left_water_c,right_water_c,heatsink_c,control_error_c")?;
+        for s in &self.telemetry_samples {
+            writeln!(
+                w,
+                "{},{},{},{},{}",
+                s.elapsed_ms,
+                s.left_water_c.map(|v| v.to_string()).unwrap_or_default(),
+                s.right_water_c.map(|v| v.to_string()).unwrap_or_default(),
+                s.heatsink_c.map(|v| v.to_string()).unwrap_or_default(),
+                s.control_error_c.map(|v| v.to_string()).unwrap_or_default(),
+            )?;
+        }
+        // `cool_test_results` is a scalar summary, not a per-sample time series, so it doesn't fit
+        // the row shape above -- appended as a separate field,value block after a blank line
+        // (common practice for a trailing metadata section in an otherwise tabular CSV export).
+        if let Some(ct) = &self.cool_test_results {
+            writeln!(w)?;
+            writeln!(w, "field,value")?;
+            macro_rules! csv_field {
+                ($name:literal, $val:expr) => {
+                    writeln!(w, "{},{}", $name, $val)?;
+                };
+            }
+            csv_field!("requested_duration_seconds", ct.requested_duration_seconds);
+            csv_field!("actual_active_duration_seconds", ct.actual_active_duration_seconds);
+            csv_field!("extended_test_confirmation_received", ct.extended_test_confirmation_received);
+            csv_field!("stop_reason", ct.stop_reason);
+            csv_field!("stop_reason_code", ct.stop_reason_code);
+            csv_field!("target_reached", ct.target_reached);
+            csv_field!("time_to_target_seconds", ct.time_to_target_seconds.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("baseline_left_c", ct.baseline_left_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("baseline_right_c", ct.baseline_right_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("baseline_heatsink_c", ct.baseline_heatsink_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("minimum_left_c", ct.minimum_left_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("minimum_right_c", ct.minimum_right_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("maximum_heatsink_c", ct.maximum_heatsink_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("final_left_c", ct.final_left_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("final_right_c", ct.final_right_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!("final_heatsink_c", ct.final_heatsink_c.map(|v| v.to_string()).unwrap_or_default());
+            csv_field!(
+                "selected_side_temperature_change_c",
+                ct.selected_side_temperature_change_c.map(|v| v.to_string()).unwrap_or_default()
+            );
+            csv_field!(
+                "opposite_side_temperature_change_c",
+                ct.opposite_side_temperature_change_c.map(|v| v.to_string()).unwrap_or_default()
+            );
+            csv_field!(
+                "heatsink_temperature_change_c",
+                ct.heatsink_temperature_change_c.map(|v| v.to_string()).unwrap_or_default()
+            );
+            csv_field!("selected_tec_safety_passed", ct.selected_tec_safety_passed);
+            csv_field!("selected_tec_unlocking_observed", ct.selected_tec_unlocking_observed);
+            csv_field!("selected_tec_activity_observed", ct.selected_tec_activity_observed);
+            csv_field!("selected_pump_activity_observed", ct.selected_pump_activity_observed);
+            csv_field!(
