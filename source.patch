+        )
+        .await
+        .expect("probe must terminate within its bounded window");
+
+        // ~0, 100, 200, 300ms => at least 3 attempts, never reopening the port (there is only
+        // ever the one `client`/`device` pair for this whole test).
+        assert!(
+            result.attempts >= 3,
+            "expected multiple retries within a 350ms/100ms window, got {}",
+            result.attempts
