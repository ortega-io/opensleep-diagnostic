+    fn get_temperature_27byte_frame(left: u16, right: u16, heatsink: u16) -> Vec<u8> {
+        let mut payload = vec![
+            0xC1,
+            0x00,
+            0x01,
+            (left >> 8) as u8,
+            left as u8,
+            0x02,
+            (right >> 8) as u8,
+            right as u8,
+            0x03,
+            0x00,
+            0x00,
+            0x04,
+            (heatsink >> 8) as u8,
+            heatsink as u8,
+        ];
+        payload.resize(27, 0);
+        payload
+    }
