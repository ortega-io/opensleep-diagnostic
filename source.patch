+        );
+    }
+
+    let mut active_left_c: Vec<f64> = Vec::new();
+    let mut active_right_c: Vec<f64> = Vec::new();
+    let mut min_left_c: Option<f64> = None;
+    let mut min_right_c: Option<f64> = None;
+    let mut final_left_c: Option<f64> = None;
+    let mut final_right_c: Option<f64> = None;
+    let mut final_heatsink_c: Option<f64> = None;
+    let mut max_heatsink_c: Option<f64> = None;
+    let mut left_target_reached = false;
+    let mut right_target_reached = false;
+    let mut left_time_to_target_seconds: Option<f64> = None;
+    let mut right_time_to_target_seconds: Option<f64> = None;
+    let mut left_pump_command_observed = false;
+    let mut right_pump_command_observed = false;
+    let mut left_pump_current_observed = false;
+    let mut right_pump_current_observed = false;
+    let mut left_pump_activity_observed = false;
+    let mut right_pump_activity_observed = false;
+    let mut left_tec_current_observed = false;
+    let mut right_tec_current_observed = false;
+    let mut left_tec_activity_seen = false;
+    let mut right_tec_activity_seen = false;
+    let mut left_tec_safety_passed = false;
+    let mut right_tec_safety_passed = false;
+    let left_tec_fault_observed = false;
+    let right_tec_fault_observed = false;
+    let mut left_tec_current_first_a: Option<f64> = None;
+    let mut left_tec_current_min_a: Option<f64> = None;
+    let mut left_tec_current_max_a: Option<f64> = None;
+    let mut left_tec_current_last_a: Option<f64> = None;
+    let mut left_tec_current_samples: u64 = 0;
+    let mut right_tec_current_first_a: Option<f64> = None;
+    let mut right_tec_current_min_a: Option<f64> = None;
+    let mut right_tec_current_max_a: Option<f64> = None;
+    let mut right_tec_current_last_a: Option<f64> = None;
+    let mut right_tec_current_samples: u64 = 0;
+    let mut temperature_reads_failed: Option<u64> = None;
+    let mut temperature_reads_total: Option<u64> = None;
+    let mut top_fan_activity_observed = false;
+    let mut top_fan_latest_duty: Option<f64> = None;
+    let mut top_fan_latest_rpm: Option<f64> = None;
+    let mut top_fan_max_rpm: Option<f64> = None;
+    let mut bottom_fan_activity_observed = false;
+    let mut bottom_fan_latest_duty: Option<f64> = None;
+    let mut bottom_fan_latest_rpm: Option<f64> = None;
+    let mut bottom_fan_max_rpm: Option<f64> = None;
+    let mut telemetry_warning_count: u64 = 0;
+    let mut fan_seen = false;
+
+    if both_confirmed {
+        log::info!("firmware-authoritative (both): both sides confirmed enabled; entering observation");
+
+        let mut last_any_valid_rx_at = Instant::now();
+        let mut last_temperature_poll_at: Option<Instant> = None;
+        let mut last_heartbeat_sent_at: Option<Instant> = None;
+        let mut last_progress_logged_at: Option<Instant> = None;
+
+        'fa_active: loop {
