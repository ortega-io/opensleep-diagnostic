+    /// Set as soon as a `"FW: [priming] done"` or `"FW: [priming] done because empty"` message is
+    /// observed -- the only completion signal that exists in the reused protocol; there is no
+    /// binary "priming complete" packet. `frozen-prime-test` only.
+    pub priming_done_observed: bool,
