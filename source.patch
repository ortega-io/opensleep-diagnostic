+/// No longer an interactive post-run questionnaire (removed entirely -- a physical condition
+/// this binary cannot verify electronically is reported as "not collected", never left to block
+/// on operator input or to make the run look like it failed merely because nobody answered).
+/// `--operator-note` is the one optional, never-prompted-for way to attach free text.
+const OPERATOR_OBSERVATION_NOT_COLLECTED: &str = "not collected";
+
+fn build_operator_observations(args: &CoolTestArgs) -> Option<OperatorObservations> {
+    Some(OperatorObservations {
+        pump_heard_or_felt: Some(OPERATOR_OBSERVATION_NOT_COLLECTED.to_string()),
+        fan_seen_or_heard: Some(OPERATOR_OBSERVATION_NOT_COLLECTED.to_string()),
+        airflow_felt: Some(OPERATOR_OBSERVATION_NOT_COLLECTED.to_string()),
+        leak_observed: None,
+        unusual_smell_or_noise: None,
+        notes: args.operator_note.clone(),
+    })
+}
