+                            }
+                            None => {
+                                operator_abort_rx = None;
+                            }
+                        }
+                    }
+                    outcome = link.recv(remaining) => {
+                        match outcome {
+                            Ok(PacketOutcome::Received(pkt)) => {
+                                last_any_valid_rx_at = Instant::now();
+                                match pkt {
+                                    FrozenPacket::TemperatureUpdate(u) => {
+                                        stats.record(&FrozenPacket::TemperatureUpdate(u.clone()));
+                                        let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                        samples.push((&sample_from_temperature_update(elapsed_ms, jiff::Timestamp::now().to_string(), &u)).into());
+                                        record_dual_temperature_sample(
+                                            u.left_temp, u.right_temp, u.heatsink_temp, left_target_centideg,
+                                            right_target_centideg, left_enabled_at, right_enabled_at,
+                                            &mut active_left_c, &mut active_right_c, &mut min_left_c, &mut min_right_c,
+                                            &mut max_heatsink_c, &mut final_left_c, &mut final_right_c,
+                                            &mut final_heatsink_c, &mut left_target_reached, &mut right_target_reached,
+                                            &mut left_time_to_target_seconds, &mut right_time_to_target_seconds,
+                                        );
+                                    }
+                                    FrozenPacket::GetTemperature(g) => {
+                                        stats.record(&FrozenPacket::GetTemperature(g.clone()));
+                                        let elapsed_ms = active_start.elapsed().as_millis() as u64;
+                                        samples.push((&sample_from_get_temperature(elapsed_ms, jiff::Timestamp::now().to_string(), &g)).into());
+                                        record_dual_temperature_sample(
+                                            g.left_temp, g.right_temp, g.heatsink_temp, left_target_centideg,
+                                            right_target_centideg, left_enabled_at, right_enabled_at,
+                                            &mut active_left_c, &mut active_right_c, &mut min_left_c, &mut min_right_c,
+                                            &mut max_heatsink_c, &mut final_left_c, &mut final_right_c,
+                                            &mut final_heatsink_c, &mut left_target_reached, &mut right_target_reached,
+                                            &mut left_time_to_target_seconds, &mut right_time_to_target_seconds,
+                                        );
+                                    }
+                                    FrozenPacket::Message(m) => {
+                                        stats.record(&FrozenPacket::Message(m.clone()));
+                                        if parse_pump_report(&m, "left").is_some() || is_pump_command_event(&m, "left") {
+                                            left_pump_command_observed = true;
+                                        }
+                                        if parse_pump_report(&m, "right").is_some() || is_pump_command_event(&m, "right") {
+                                            right_pump_command_observed = true;
+                                        }
+                                        if parse_pump_report(&m, "left") == Some(true) {
+                                            left_pump_activity_observed = true;
+                                        }
+                                        if parse_pump_report(&m, "right") == Some(true) {
+                                            right_pump_activity_observed = true;
+                                        }
+                                        if parse_pump_current(&m, "left").is_some() {
+                                            left_pump_current_observed = true;
+                                        }
+                                        if parse_pump_current(&m, "right").is_some() {
+                                            right_pump_current_observed = true;
+                                        }
+                                        if let Some(amps) = parse_tec_current(&m, "left") {
+                                            left_tec_current_samples += 1;
+                                            left_tec_current_first_a.get_or_insert(amps);
+                                            left_tec_current_min_a = Some(left_tec_current_min_a.map_or(amps, |v: f64| v.min(amps)));
+                                            left_tec_current_max_a = Some(left_tec_current_max_a.map_or(amps, |v: f64| v.max(amps)));
+                                            left_tec_current_last_a = Some(amps);
+                                            left_tec_current_observed = true;
+                                            left_tec_activity_seen = true;
+                                        } else if let Some(state) = parse_tec_safety_state(&m, "left") {
+                                            match state {
+                                                TecSafetyState::Locked => {
+                                                    log::error!("firmware-authoritative (both): firmware reported the left TEC locked: {m:?}");
+                                                    stop_reason = StopReason::LeftTecLocked;
+                                                    telemetry_ok = false;
+                                                    break 'fa_active;
+                                                }
+                                                TecSafetyState::UnsafeLocking => {
+                                                    log::error!("firmware-authoritative (both): firmware reported the left TEC transitioning unsafe (locking): {m:?}");
+                                                    stop_reason = StopReason::LeftTecUnsafeLocking;
+                                                    telemetry_ok = false;
+                                                    break 'fa_active;
+                                                }
+                                                TecSafetyState::SafeUnlocking | TecSafetyState::Unlocked => {
+                                                    left_tec_safety_passed = true;
+                                                    left_tec_activity_seen = true;
+                                                }
+                                                TecSafetyState::Unknown => {
+                                                    log::info!("firmware-authoritative (both): unrecognized left TEC safety-state message (not treated as a fault): {m:?}");
+                                                }
+                                            }
+                                        }
+                                        if let Some(amps) = parse_tec_current(&m, "right") {
+                                            right_tec_current_samples += 1;
+                                            right_tec_current_first_a.get_or_insert(amps);
+                                            right_tec_current_min_a = Some(right_tec_current_min_a.map_or(amps, |v: f64| v.min(amps)));
+                                            right_tec_current_max_a = Some(right_tec_current_max_a.map_or(amps, |v: f64| v.max(amps)));
+                                            right_tec_current_last_a = Some(amps);
+                                            right_tec_current_observed = true;
+                                            right_tec_activity_seen = true;
+                                        } else if let Some(state) = parse_tec_safety_state(&m, "right") {
+                                            match state {
+                                                TecSafetyState::Locked => {
+                                                    log::error!("firmware-authoritative (both): firmware reported the right TEC locked: {m:?}");
+                                                    stop_reason = StopReason::RightTecLocked;
+                                                    telemetry_ok = false;
+                                                    break 'fa_active;
+                                                }
+                                                TecSafetyState::UnsafeLocking => {
+                                                    log::error!("firmware-authoritative (both): firmware reported the right TEC transitioning unsafe (locking): {m:?}");
+                                                    stop_reason = StopReason::RightTecUnsafeLocking;
+                                                    telemetry_ok = false;
+                                                    break 'fa_active;
+                                                }
+                                                TecSafetyState::SafeUnlocking | TecSafetyState::Unlocked => {
+                                                    right_tec_safety_passed = true;
+                                                    right_tec_activity_seen = true;
+                                                }
+                                                TecSafetyState::Unknown => {
+                                                    log::info!("firmware-authoritative (both): unrecognized right TEC safety-state message (not treated as a fault): {m:?}");
+                                                }
+                                            }
+                                        }
+                                        if let Some((failed, total)) = parse_temps_health_report(&m) {
+                                            temperature_reads_failed = Some(failed);
+                                            temperature_reads_total = Some(total);
+                                        }
+                                        if let Some((duty, rpm)) = parse_fan_report(&m, "top-fan") {
+                                            top_fan_activity_observed = true;
+                                            top_fan_latest_duty = Some(duty);
+                                            top_fan_latest_rpm = Some(rpm);
+                                            top_fan_max_rpm = Some(top_fan_max_rpm.map_or(rpm, |v: f64| v.max(rpm)));
+                                        }
+                                        if let Some((duty, rpm)) = parse_fan_report(&m, "bottom-fan") {
+                                            bottom_fan_activity_observed = true;
+                                            bottom_fan_latest_duty = Some(duty);
+                                            bottom_fan_latest_rpm = Some(rpm);
+                                            bottom_fan_max_rpm = Some(bottom_fan_max_rpm.map_or(rpm, |v: f64| v.max(rpm)));
+                                        }
+                                        if is_known_nonfatal_sensor_message(&m) {
+                                            log::warn!("firmware-authoritative (both): firmware sensor-unavailable message (non-fatal): {m:?}");
+                                            telemetry_warning_count += 1;
+                                        }
+                                    }
