+        stats.record(&FrozenPacket::GetTemperature(GetTemperature {
+            left_temp: 2500,
+            right_temp: 2500,
+            unknown_temp: 0,
+            heatsink_temp: 2300,
+        }));
+        assert!(!stats.unsolicited_telemetry_seen);
+    }
+}
