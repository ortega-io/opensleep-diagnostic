+++ b/src/bin/opensleep-diagnostic/telemetry.rs
@@ -0,0 +1,160 @@
+//! Telemetry decoding and unit conversion for `FrozenPacket`.
+//!
+//! Unit evidence: `frozen/packet.rs` documents `FrozenTarget::temp`, `TemperatureUpdate`'s three
+//! temperature fields, and `GetTemperature`'s four temperature fields as "centidegrees celcius"
+//! (source doc comments, unchanged). `frozen/command.rs`'s own `test_temp` unit test constructs a
+//! target of `temp: 3600` and asserts its serialized bytes are `0E 10` (3600 decimal), consistent
+//! with 36.00 C as a plausible heating-pad setpoint. Both facts agree: divide the raw `u16` by
+//! 100 to get degrees Celsius. If this evidence were ever absent for a field, this module would
+//! leave it unconverted and labeled unknown rather than guess -- see `control_error_c` below.
+
+use opensleep::frozen::FrozenPacket;
+use opensleep::frozen::packet::{GetTemperature, TemperatureUpdate};
+
+/// Converts a raw centidegrees-Celsius field to degrees Celsius. See module docs for evidence.
+pub fn centideg_to_celsius(raw: u16) -> f64 {
+    f64::from(raw) / 100.0
+}
+
+#[derive(Debug, Clone)]
+pub struct TemperatureSample {
+    pub elapsed_ms: u64,
+    pub timestamp: String,
+    pub source: SampleSource,
+    pub left_water_c: Option<f64>,
+    pub right_water_c: Option<f64>,
+    pub heatsink_c: Option<f64>,
+    /// `TemperatureUpdate.error`: per the source doc comment this is "error in deg celcius" (a
+    /// control-loop error term, in degrees C, NOT a fault/status code). Evidence: the captured
+    /// firmware log in `frozen/command.rs` shows "Temperature update ... Error: 8" logged
+    /// alongside PID-loop debug output during normal pump operation, and real passive telemetry
+    /// captured from this hardware consistently reports a value of 9 with no other sign of a
+    /// fault. Never used to gate pass/fail/abort decisions -- a nonzero value here is expected
+    /// and does not by itself indicate a problem.
+    pub control_error_c: Option<u8>,
+    pub raw_left: Option<u16>,
+    pub raw_right: Option<u16>,
+    pub raw_heatsink: Option<u16>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SampleSource {
+    /// Response to our own `GetTemperatures` command (opcode 0x41 -> reply 0xC1).
+    Solicited,
+    /// `FrozenPacket::TemperatureUpdate`, opcode 0x41 seen directly (not as a `+0x80` reply to
+    /// anything we sent) -- Frozen pushing telemetry on its own schedule.
+    Unsolicited,
+}
+
+pub fn sample_from_get_temperature(elapsed_ms: u64, timestamp: String, g: &GetTemperature) -> TemperatureSample {
+    TemperatureSample {
+        elapsed_ms,
+        timestamp,
+        source: SampleSource::Solicited,
+        left_water_c: Some(centideg_to_celsius(g.left_temp)),
+        right_water_c: Some(centideg_to_celsius(g.right_temp)),
+        heatsink_c: Some(centideg_to_celsius(g.heatsink_temp)),
+        control_error_c: None,
+        raw_left: Some(g.left_temp),
+        raw_right: Some(g.right_temp),
+        raw_heatsink: Some(g.heatsink_temp),
+    }
+}
+
+pub fn sample_from_temperature_update(
+    elapsed_ms: u64,
+    timestamp: String,
+    u: &TemperatureUpdate,
+) -> TemperatureSample {
+    TemperatureSample {
+        elapsed_ms,
+        timestamp,
+        source: SampleSource::Unsolicited,
+        left_water_c: Some(centideg_to_celsius(u.left_temp)),
+        right_water_c: Some(centideg_to_celsius(u.right_temp)),
+        heatsink_c: Some(centideg_to_celsius(u.heatsink_temp)),
+        control_error_c: Some(u.error),
+        raw_left: Some(u.left_temp),
+        raw_right: Some(u.right_temp),
+        raw_heatsink: Some(u.heatsink_temp),
+    }
+}
+
+/// Raw/malformed/timeout counters kept across a whole run. "Malformed" is a conservative proxy,
+/// not an invented one: `PacketCodec::decode` (reused unmodified) already discards bad-checksum
+/// or unparseable frames internally via `log::error!`/`continue`, without ever surfacing an `Err`
+/// item to callers of `Framed::next()`. This binary cannot see a per-frame decode failure through
+/// that API, so it reports "bytes arrived during a poll window but zero packets decoded from it"
+/// as the closest honest signal, and relies on the library's own `log::error!` output (visible
+/// because `env_logger` is initialized before any I/O) to show the human operator what happened.
+#[derive(Debug, Clone, Default)]
+pub struct PacketStats {
+    pub raw_packets_decoded: u64,
+    /// Always 0 in the current build: see the struct-level doc comment above. Kept as a named,
+    /// reported field (rather than omitted) so the JSON/CSV schema has a stable place for it if a
+    /// future `opensleep` revision exposes real per-frame decode errors.
+    pub malformed_windows: u64,
+    pub timeouts: u64,
+    pub unsolicited_telemetry_seen: bool,
+    pub messages: Vec<String>,
+}
+
+impl PacketStats {
+    pub fn record(&mut self, packet: &FrozenPacket) {
+        self.raw_packets_decoded += 1;
+        match packet {
+            FrozenPacket::TemperatureUpdate(_) => self.unsolicited_telemetry_seen = true,
+            FrozenPacket::Message(m) => self.messages.push(m.clone()),
+            FrozenPacket::GetTemperature(_)
+            | FrozenPacket::Pong(_)
+            | FrozenPacket::HardwareInfo(_)
+            | FrozenPacket::JumpingToFirmware(_)
+            | FrozenPacket::TargetUpdate(_)
+            | FrozenPacket::Heartbeat(_, _)
+            | FrozenPacket::PrimingStarted
+            | FrozenPacket::GetFirmware => {}
+        }
+    }
+
+    pub fn record_timeout(&mut self) {
+        self.timeouts += 1;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn conversion_matches_source_documented_unit() {
+        assert_eq!(centideg_to_celsius(3600), 36.0);
+        assert_eq!(centideg_to_celsius(2482), 24.82);
+        assert_eq!(centideg_to_celsius(0), 0.0);
+    }
+
+    #[test]
+    fn temperature_update_marks_unsolicited_flag() {
+        let mut stats = PacketStats::default();
+        stats.record(&FrozenPacket::TemperatureUpdate(TemperatureUpdate {
+            left_temp: 2500,
+            right_temp: 2500,
+            heatsink_temp: 2300,
+            error: 3,
+            count: 1,
+        }));
+        assert!(stats.unsolicited_telemetry_seen);
